    pub(super) fn trace(&self, seq: Option<u64>) -> Result<Json, Refusal> {
        let latest = self
            .runtime()
            .store()
            .commit_seq()
            .map_err(|error| Refusal::from_runtime(&error))?;
        // @ref LLP 1016#d6--the-operator-seat-ad-hoc-programs-and-rehearsal — a refusal has no commit; retain its attempted trace until another commit supersedes it.
        if seq.is_none()
            && let Some(rejected) = &self.operator_rejection
            && rejected["seq"].as_u64() == Some(latest)
        {
            return Ok(rejected.clone());
        }
        let wanted = seq.unwrap_or(latest);
        let commit = self
            .runtime()
            .store()
            .commits_since(wanted.saturating_sub(1), 1)
            .map_err(|error| Refusal::from_runtime(&error))?
            .into_iter()
            .find(|commit| commit.seq == wanted)
            .ok_or_else(|| {
                Refusal::new(
                    "E_INPUT_TRACE_UNKNOWN",
                    "input",
                    format!("commit {wanted} is not retained"),
                    "pass latest or a retained commit seq",
                    "input/trace",
        Ok(execution)
    }

    pub(super) fn operator_why(
        &mut self,
        op: String,
        args: Json,
        by: String,
        query_only: bool,
    ) -> Result<Json, Refusal> {
        self.operation_kind(&op, query_only.then_some(ProgramKind::Query))?;
        let execution = self.operator_execution(&op, args, by.clone())?;
        let certificate = &self.runtime().generation().programs()[&op].1;
        Ok(json!({
            "op": op, "principal": "system", "by": by,
            "certificatePlanHash": certificate.plan_hash,
            "result": operator_json(&execution), "trace": execution.trace,
            "subscriptions": [],
        }))
    }
}
