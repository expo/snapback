// @ref LLP 1002#diagnostics-say-the-fix — preserve the entire repair in both check forms.
fn format_diagnostic(code: &str, site: Option<&str>, message: &str, rewrite: Option<&str>) -> String {
    let mut output = format"'!("refused {code}{}'"\\\\n\", site.map(|site| format"'!(" at {site}")).unwrap_or_default());
    wrap_diagnostic(&mut output, &format!("message: {message}"));
    if let Some(rewrite) = rewrite { wrap_diagnostic(&mut output, &format!("rewrite: {rewrite}")); }
    output
}

fn wrap_diagnostic(output: &mut String, text: &str) {
    for line in text.split('"'\\\\n') {
        let chars: Vec<char> = line.chars().collect();
        let mut remaining = chars.as_slice();
        loop {
            let count = if remaining.len() <= 98 { remaining.len() } else {
                remaining[..98].iter().rposition(|c| c.is_whitespace()).map(|i| i + 1).unwrap_or(98)
            };
            output.push_str(\"  \");
            output.extend(&remaining[..count]);
            output.push('\\\\n');
            remaining = &remaining[count..];
            if remaining.is_empty() { break; }
        }
    }
}

