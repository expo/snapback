import type { Expr, QuarryCode, QuarryDiagnostic, Site } from "./ast";

export class QuarryError extends Error {
  readonly diagnostic: QuarryDiagnostic;

  constructor(site: Site, message: string, code: QuarryCode = "E_QUARRY_UNKNOWN", rewrite = message, guide = guideFor(code), executableRewrite = false) {
    const expanded = site.expandedFrom;
    const contextualMessage = expanded
      ? `${message} (from a shape, fn, or proc used at ${expanded.file}:${expanded.line}:${expanded.col})`
      : message;
    super(contextualMessage);
    this.diagnostic = { ...site, code, message: contextualMessage, rewrite, guide, executableRewrite };
  }
}

export function refuse(site: Site, message: string, rewrite?: string, executableRewrite = false): never {
  throw new QuarryError(site, message, "E_QUARRY_UNKNOWN", rewrite ?? message, undefined, executableRewrite);
}

export function syntax(site: Site, message: string, rewrite = "fix this Quarry declaration and rerun snapback2 check"): never {
  throw new QuarryError(site, message, "E_QUARRY_SYNTAX", rewrite);
}

export function unsupported(site: Site, construct: string, alternative: string): never {
  throw new QuarryError(
    site,
    `${construct} is not part of the Snapback 2 platform`,
    "E_QUARRY_UNSUPPORTED",
    alternative,
  );
}

export function ambiguous(site: Site, message: string, rewrite: string): never {
  throw new QuarryError(site, message, "E_QUARRY_AMBIGUOUS", rewrite);
}

export function placement(site: Site, message: string, rewrite: string): never {
  throw new QuarryError(site, message, "E_QUARRY_PLACEMENT", rewrite);
}

export function typeError(site: Site, message: string, rewrite: string): never {
  throw new QuarryError(site, message, "E_QUARRY_TYPE", rewrite);
}

export function decimalScale(site: Site, message: string, rewrite: string): never {
  throw new QuarryError(site, message, "E_DECIMAL_SCALE", rewrite);
}

export function opaque(site: Site, message: string, rewrite: string): never {
  throw new QuarryError(site, message, "E_OPAQUE", rewrite);
}

export function retention(site: Site, message: string): never {
  throw new QuarryError(
    site,
    message,
    "E_QUARRY_RETAIN",
    "retain until-revoked  -- alternatively: retain delivered-history",
  );
}

export function tombstone(site: Site, message: string, rewrite: string): never {
  throw new QuarryError(site, message, "E_QUARRY_TOMBSTONE", rewrite);
}

export function formatDiagnostic(item: QuarryDiagnostic): string {
  return `${item.file}:${item.line}:${item.col} — ${item.message}`;
}

function guideFor(code: QuarryCode): string {
  if (code === "E_DECIMAL_SCALE") return "programs/types";
  if (code === "E_EMIT_IN_QUERY") return "effects/authoring";
  if (code === "E_OPAQUE") return "programs/refusals";
  if (code === "E_OP_RESERVED") return "programs/refusals";
  if (code === "E_UNBOUND_LOOP") return "bound/loop";
  if (code === "E_QUARRY_SYNTAX") return "quarry/grammar";
  if (code === "E_QUARRY_AMBIGUOUS") return "quarry/indexes";
  if (code === "E_QUARRY_UNSUPPORTED") return "quarry/refusals";
  if (code === "E_QUARRY_PLACEMENT") return "quarry/projects";
  if (code === "E_QUARRY_TYPE") return "quarry/types";
  if (code === "E_QUARRY_RETAIN" || code === "E_QUARRY_TOMBSTONE") return "quarry/grammar";
  return "quarry/names";
}

// @ref LLP 1016#d1--the-system-principal-is-the-stores-owner — removed rule word; no compatibility grant.
export function currentRule(expr: Expr): Expr {
  if (expr.kind === "name" && expr.name === "system") {
    throw new QuarryError(expr.site, "the system principal never consults rules; `deny` is what this meant", "E_QUARRY_UNSUPPORTED", "deny");
  }
  if (expr.kind === "unary") currentRule(expr.value);
  if (expr.kind === "binary") {
    currentRule(expr.left); currentRule(expr.right);
  }
  if (expr.kind === "member") currentRule(expr.base);
  if (expr.kind === "exists" || expr.kind === "created") currentRule(expr.read);
  if (expr.kind === "read") for (const key of expr.keys) currentRule(key.value);
  return expr;
}
## 3. The compiler worker and the project JSON

Protocol, JSON lines on stdin/stdout, one request in flight:

```
→ { "id": 0, "op": "probe", "root": "/abs/project" }
← { "id": 0, "ok": true, "protocol": "snapback2/compiler-worker/v1", "operations": ["compile", "seed", "journeys"] }
← { "id": 0, "ok": false, "protocol": "snapback2/compiler-worker/v1", "operations": ["compile", "seed", "journeys"], "dependency": "compiler-core.mjs" | "typescript" }
→ { "id": 1, "op": "compile", "root": "/abs/project" }
← { "id": 1, "ok": true, "project": <ProjectJson>, "sources": { "todos.list": { "file": "snapback/todos.q", "line": 14, "col": 14 } }, "apiDts": "<text>", "ms": 212 }
← { "id": 1, "ok": false, "diagnostics": [ <Refusal> ] }        // ALL diagnostics, one per module at least
→ { "id": 2, "op": "seed", "root": "…" }  ← { "id": 2, "ok": true, "seed": { "personas": [...], "rows": {...} } }
→ { "id": 3, "op": "journeys", "root": "…" }  ← { "id": 3, "ok": true, "files": ["snapback/tests/todos.test.ts"] }
```

`probe` is the lightweight `doctor` handshake. It verifies the fixed compiler
chunk and the TypeScript dependency before returning the exact protocol token;
the binary also requires the matching request id and exact lowering-operation
set. The worker lazily loads that heavy compiler chunk for `compile`, `seed`,
and `journeys`. A missing closure leaf becomes stable `E_OWNER_NO_COMPILER`
guidance; it is not disguised as an operation refusal. The blocking compiler
and isolated-package tests execute every advertised lowering operation.

`ProjectJson` is LLP 1001 §4's serde shape, with `programs[].name` qualified
(`todos.list`) and `schema.effects` listing the effect names. The compiler's
`rule.system()` lowering consumes the core-owned
`snapback2-core/ir-contract.json` token rather than spelling a second copy.
`effects[] = { name, grants, source, then }` (LLP 1003). `Refusal` is §4's
envelope. Diagnostics are collected per operation and per project up to a
bound (20 per operation, 50 per project); when a bound truncates, the last
entry is `E_DIAG_TRUNCATED` ("…and N more") — never a silent slice (review
ruling 2026-08-30). The one-shot form `node compiler.mjs --project <root>` prints the
same response and exits 0/1, so `check` works without the binary and the
compiler's own tests need no spawn. The binary's IR-file form is
`snapback2 check --ir <project.json>` (stdin when omitted) — `--project` on
the binary always means the §6 verb over a project directory. The compiler is bundled by esbuild into
`packages/snapback2/dist/compiler.mjs` and runs under Node ≥ 20 (no `Bun.*`).

Quarry naming refusals derive candidate indexes, key columns, and nominal types
from the catalog. A wrong key reports expected and actual types. An unambiguous
replacement expression survives the Quarry diagnostic remap as executable
`rewrite` text; guidance without a concrete edit remains a comment (Clique L2,
GPT-6 Astra, 2026-09-05).
A bare `refuse()` uses its message as the rewrite; unexpected caught failures do likewise.
Recoverable Quarry statement failures retain independent bound statements for
diagnostics only. Failed statements roll back their bound output, fresh-name
counters, and only the local names that statement could publish; valid programs
do not copy their accumulated scope per statement. Uses of failed bindings
suppress dependent cascades. A fresh argument, binding, loop or match binder
clears failure only in its lexical environment, after its initializer or domain
has been validated. Merge discovery is bound in the outer scope before dependent
lane prefixes, and that bound expression is lowered once, including guards and
ID allocation. Parser and schema failures stay outside statement recovery. Any
recovered typed refusal returns the complete bounded diagnostic envelope before
effect lowering, program IR, API declarations or inspection artifacts can escape.
Presence advice comes from bound source and contextual destination types:
`! else CODE` is offered only when removing absence repairs the mismatch or
dereference. A text assigned to a Boolean still needs `true` or `false`; a
null-only value needs a value. These cause facts are part of direct typed value
comparison and add no wire fields. The diagnostic recovery controls are
registered in `src/quarry-diagnostic-checks.ts`.
The registered Quarry language checks live in `src/quarry-language-checks.ts`, keeping `src/test.ts` within the source line cap.

`api.d.ts` (written to `.snapback/build/api.d.ts`, never committed) augments
the client's `Api` interface with every op's argument and result types, emitted
from the same bound Quarry facts used for program IR. Row aliases contain
concrete field types; they do not depend on TypeScript data descriptors.
Insert and merge regressions consume the emitted augmentation through the
complete SDK with the Expo config, checking exact Boolean fields and
rejecting numeric assignments even with `skipLibCheck`:

```ts
declare module 'snapback2/client' { interface Api { todos: { list: Op<{ take?: number }, Todo[]>; add: Op<{ title: string }, { id: string }> } } }
```

## 8. `why`, `trace`, `guide`

- `why <query> --as p`: re-runs the read; prints, per examined row, the rule
  verdict and the rule inputs it touched (from `rule_inputs`); the read sites
  examined against the certificate's (take, examined, hoisted); and, if a live
  subscription for that op+args exists, its last delivery `seq` and whether
  the latest commit touched it.
  Denied read sites also carry local `E_RULE` diagnostics with a site,
  rewrite, and `auth` recipe pointer: mutation lookups obey the same read
  authority, and write permission does not elevate them. These diagnostics
  never enter served execution envelopes; hidden and missing point reads
  retain the same ordinary result. To inspect a mutation lookup without
  writes, use a query containing that lookup. `why` refuses mutation names
  with `E_OP_KIND` before execution: the CLI sends `queryOnly: true`, checked
  against the active operation by the owner, so hot successors cannot turn
  inspection into a write. The protected `/control/why` harness retains its
  mutation execution for collecting authoritative offline-replay traces.
- `trace <seq>`: the commit record (program, principal, writes, touched
  keys), the outbox rows it emitted and their real states, and the
  subscriptions it invalidated with their delivery seqs — intent → commit →
  invalidation → delivery — read from the owner's bounded per-commit ledger
  (last 1,000 commits, per owner lifetime — a commit older than the current
  owner's start reports `ledger: unavailable (owner restarted at <ts>)`, never
  empty arrays) and the store's `_outbox`, never reconstructed from program
  syntax or the current subscription set (review rulings 2026-08-30).
- `guide`: `grammar` (one screen, hand-written, in the package), `app`
  (tables, rules, ops with bounds, channels, personas — from the generation),
  `<symbol>` (the JSDoc on the `snapback2` module's declaration), `<E_CODE>`
  (the family's wrong/right pair), `<recipe>` (`auth`, `live-query`,
  `effects`, `offline`, `personas`, `operator`, `job`, `schedule`, `quarry`,
  `testing` — budgeted Markdown files shipped in the package). After page, refusal,
  and symbol lookup, `<keyword>` serves its grammar line and defining paragraph
  from an index generated at package build time from
  the existing guide pages; a matching symbol keeps its declaration and gains that
  excerpt under one header. The same build adds package README H2 topics, keyed by
  lowercase headings with non-letter/digit runs replaced by hyphens (trimmed at the
  ends), with the first prose paragraph before any subheading and a pointer to the
  full packaged README section. README remains authoritative; H3 headings are not
  topics, and existing constructs or earlier topics win key collisions.
  Missing, unreadable, or invalid keyword indexes never
  suppress a symbol hit. A keyword-only lookup with a missing index is unknown;
  unreadable or invalid indexes return `E_OWNER_GUIDE` only when keyword help is
  needed. Unknown-name guidance includes index keys when readable. `--json` keeps
  `{ page, content }`; no pages are scanned at lookup time.
  `guide init`, `guide dev`, and `guide check` serve the corresponding built-in
  command help before symbol lookup, keeping the same `{ page, content }` envelope.
  The remaining guide bytes are served from the package, not embedded in the binary.
  The app guide uses the same certified operation map as `certificates.json`.
  Schedule bindings are certified internal programs (LLP 1016 D5), excluded
  from both; their names do not decide whether a program is an operation.
  Missing or mismatched operation certificates and invalid seed facts refuse
  with `E_GUIDE_STALE` and `run snapback2 check`, without repairing the cache
  or substituting invented bounds.

# Testing

The static seed is one system commit before derived checks and journeys:

```ts
    profiles: [
      { id: "profile-alice", principal: "dev:alice", displayName: "Alice", handle: "alice", avatarUrl: "https://example.com/alice.png", bio: "", location: "", link: null },
      { id: "profile-bob", principal: "dev:bob", displayName: "Bob", handle: "bob", avatarUrl: "https://example.com/bob.png", bio: "", location: "", link: null },
    ],
    conversations: [
      { id: "conversation-1", title: "General", creatorId: "dev:alice" },
      { id: "conversation-2", title: "Side room", creatorId: "dev:alice" },
    ],
    memberships: [
      { id: "membership-1", conversationId: "conversation-1", principal: "dev:alice", role: "admin", joinedAt: 0 },
      { id: "membership-2", conversationId: "conversation-1", principal: "dev:bob", role: "member", joinedAt: 0 },
      { id: "membership-3", conversationId: "conversation-2", principal: "dev:alice", role: "admin", joinedAt: 0 },
      { id: "membership-4", conversationId: "conversation-2", principal: "dev:charlie", role: "member", joinedAt: 0 },
    ],
    messages: [
      { id: "message-1", conversationId: "conversation-1", authorId: "dev:alice", body: "Welcome", at: 1 },
      { id: "message-2", conversationId: "conversation-2", authorId: "dev:alice", body: "Side note", at: 1 },
    ],
```

Here `profile-alice` is an application row id while `dev:alice` is the persona
Principal used by creator, membership, and author columns. Identity email and
password hashes are deliberately absent from application seed rows. These
`avatarUrl` strings are external URLs, not uploads; asset values are deliberately
absent because seeds cannot mint asset ledger rows (LLP 1006 §2a). The chat
fixture also keeps `charlie` as an account/persona without a profile so the
idempotent post-auth profile-creation path has a real absent-row proof.

Write journeys with `journey(name, async ({ as, tick, url }) => …)`. The test
verb starts a fresh isolated owner, runs all six derived check families, runs
every journey through the headless wire client, removes the test store, and
writes `.snapback/receipts/<timestamp>.json`. Zero checks cannot pass. Use
`snapback2 test --blocked "reason"` for an honest blocked receipt.

Select: `snapback2 test --journey "todos round trip"`.
Literals: `--journey=--help` or `--journey=-h`, not just quotes.
Duplicates run; scope is `scope.journey`. Focused processes compare
names/body source/order/count; registration drift fails before a wrong body.
Keep captured state stable: source identity cannot inspect it. Unsuccessful
runner exits fail. Skips other journeys and top-level derived checks;
embedded offline checks remain. Unknown names fail with available names;
compile/load failures remain. Five-second deadlines and isolation remain.
Cannot combine with `--derived-only` or `--blocked` or infer affected coverage.
Plain `snapback2 test` runs the full suite.

Projects with scoped memberships also run the canonical `live-revocation`,
`successor-policy-fence`, and `grant-incarnation-aba` authorization proofs.
They bind revocation delivery, active-generation policy, and immutable grant
incarnation to the served loop rather than treating lower-level unit coverage
as the acceptance result.

Derived checks use a small representative seed, not a load-test dataset.
Rules compare every stored row for every seed persona, within a 16,384-probe
budget; oversized tables block with the counts and a smaller-seed rewrite.
Invalidation witnesses each query's distinct certificate-intersection groups
and concrete-disjoint silence, rather than testing every query/mutation pair.
The receipt names the candidate groups and actual physical attempts. Mutation
search uses the first two scopes and six personas; if no committing witness is
found within the limit, the check blocks. Replay still covers every generic
mutation independently. Put operation-specific behavior and larger scenarios
in authored journeys, and keep useful admitted and excluded personas and scopes
near the start of the seed.

