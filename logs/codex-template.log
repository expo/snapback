}

pub(super) fn prepare_policy_successor(
    base: &ProjectJson,
    protected_table: &str,
) -> Result<PreparedPolicySuccessor, String> {
    let mut project = base.clone();
    project
        .schema
        .tables
        .get_mut(protected_table)
        .ok_or_else(|| format!("protected table {protected_table} disappeared"))?
        .rules
