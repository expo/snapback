fn visit_expr(expression: &mut Expr, table: &str, retired: &mut usize) {
    match expression {
        Expr::Field { base, .. } | Expr::Unary { value: base, .. } => {
            visit_expr(base, table, retired)
        }
        Expr::Binary { left, right, .. } => {
            visit_expr(left, table, retired);
            visit_expr(right, table, retired);
        }
        Expr::Array(values) | Expr::Builtin { args: values, .. } => {
            values
                .iter_mut()
                .for_each(|value| visit_expr(value, table, retired));
        }
        Expr::Object(values) => values
            .values_mut()
            .for_each(|value| visit_expr(value, table, retired)),
        Expr::Get(read) | Expr::Exists(read) => read
            .key
            .iter_mut()
            .for_each(|value| visit_expr(value, table, retired)),
        Expr::Scan(scan) => visit_scan(scan, table, retired),
        Expr::Merge(merge) => {
            if merge
                .held_search
                .as_ref()
                .is_some_and(|held| held.table == table)
            {
                merge.held_search = None;
                *retired += 1;
            }
            for lane in &mut merge.lanes {
                visit_statements(&mut lane.setup, table, retired);
                visit_scan(&mut lane.scan, table, retired);
                if let Some(source) = &mut lane.source {
                    visit_scan(source, table, retired);
                }
            }
        }
        Expr::Literal(_) | Expr::Variable(_) | Expr::Input(_) => {}
    }
}

fn visit_scan(scan: &mut Scan, table: &str, retired: &mut usize) {
    for prefix in &mut scan.prefix {
        match prefix {
            IndexKeyExpr::Scalar(value) | IndexKeyExpr::WordPrefix { source: value, .. } => {
                visit_expr(value, table, retired)
            }
        }
    }
    [scan.after.as_deref_mut(), scan.before.as_deref_mut()]
        .into_iter()
        .flatten()
        .for_each(|value| visit_expr(value, table, retired));
    if let Some(range) = &mut scan.range {
        [
            range.gt.as_deref_mut(),
            range.gte.as_deref_mut(),
            range.lt.as_deref_mut(),
            range.lte.as_deref_mut(),
        ]
        .into_iter()
        .flatten()
        .for_each(|value| visit_expr(value, table, retired));
    }
}

// A delivery-log projection keeps its own readable metadata when the protected
// table becomes denied. Only complete nested row images are eligible for this proof.
pub(super) fn projected_policy_data(
    data: &serde_json::Value,
    table: &snapback2_core::Table,
) -> Result<serde_json::Value, String> {
    use serde_json::Value as Json;
    let Some(rows) = data.as_array() else { return Err("protected projection is not a page".into()); };
    let mut expected = rows.clone();
    let mut found = false;
    for row in &mut expected {
        let Some(fields) = row.as_object_mut() else { return Err("protected projection row is not an object".into()); };
        for value in fields.values_mut() {
            if let Some(image) = value.as_object() {
                if image.len() != table.columns.len() || !table.columns.keys().all(|key| image.contains_key(key)) {
                    return Err("protected projection contains an unrecognized nested image".into());
                }
                *value = Json::Null;
                found = true;
            }
        }
    }
    if !found { return Err("protected projection has no visible complete row image".into()); }
    Ok(Json::Array(expected))
}
        }

        Ok(json!({
            "promoteMutation": plan.promote_mutation,
            "removeMutation": plan.remove_mutation,
            "addMutation": plan.add_mutation,
            "as": plan.admin_persona,
            "principal": plan.admin_principal,
            "memberAs": plan.member_persona,
            "memberPrincipal": plan.member_principal,
            "membership": { "table": recipe.membership_table, "capturedId": plan.membership_id },
            "scope": plan.scope,
            "replacementId": replacement_id,
            "idReused": false,
            "staleReplayState": stale_replay["state"],
            "staleReplayCode": stale_replay["code"],
            "successorProbePrincipal": plan.probe_principal,
            "successorAuthorityState": successor_probe["state"],
            "successorAuthorityCode": successor_probe["code"],
            "successorRole": "member",
            "transport": "served mutation API",
        }))
    })();
    let cleanup = reset(owner);
    match (attempt, cleanup) {
        (Ok(detail), Ok(())) => Ok(detail),
        (Err(error), Ok(())) => Err(error),
        (Ok(_), Err(error)) => Err(format!("proof passed but seed reset failed: {error}")),
        (Err(error), Err(cleanup)) => Err(format!("{error}; seed reset also failed: {cleanup}")),
    }
}

fn served_mutation(
    owner: &OwnerInfo,
    persona: &str,
    operation: &str,
    args: Json,
) -> Result<Json, String> {
    let response = client::api(
        owner,
        "POST",
        "/api/mutation",
        &[("X-Snapback-As", persona)],
        json!({ "op": operation, "args": args }),
    )
    .map_err(|error| format!("{operation} request failed: {error:?}"))?;
    if response.status != 200 {
        return Err(format!(
            "{operation} returned HTTP {}: {}",
            response.status, response.body
        ));
    }
    Ok(response.body)
}

fn require_mutation_state(response: &Json, state: &str, subject: &str) -> Result<(), String> {
    if response["state"].as_str() == Some(state) {
        Ok(())
    } else {
        Err(format!("{subject} was not {state}: {response}"))
    }
}

fn successor_policy_attempt(
    owner: &OwnerInfo,
    compiled: &CompiledProject,
    plan: &QueryPlan,
) -> Result<Json, String> {
    reset(owner)?;
    let prepared_policy = prepare_policy_successor(&compiled.project, &plan.protected_table)?;
    let mut program_successor = compiled.project.clone();
    let program_denial = format!("{SUCCESSOR_DENIAL_PREFIX}{}", compiled.generation.hash());
    program_successor
        .programs
        .iter_mut()
        .find(|program| program.name == plan.query)
        .ok_or_else(|| format!("query {} disappeared", plan.query))?
        .body
        .insert(
            0,
            Stmt::Require {
                condition: Expr::Literal(Value::Bool(false)),
                code: program_denial.clone(),
            },
        );

    let attempt = successor_attempt(
        owner,
        compiled,
        plan,
        &prepared_policy.project,
        &program_successor,
        &program_denial,
        prepared_policy.retired_held_search,
        prepared_policy.stale_held_search_refused,
    );
    let restore = restore_generation(owner, compiled);
    let reset = reset(owner);
    match (attempt, restore, reset) {
        (Ok(detail), Ok(()), Ok(())) => Ok(detail),
        (result, restored, reset) => {
            "{operation}: {bounds}"
        );
    }
    for execution in executions
        .iter()
        .filter(|execution| execution["op"] == "messages.thread")
    {
        let admitted = execution["as"] != "charlie";
        assert_eq!(
            execution["examined"],
            serde_json::json!({ "actual": if admitted { 2 } else { 0 }, "ceiling": 53 })
        );
        assert_eq!(
            execution["ruleProbes"],
            serde_json::json!({ "actual": if admitted { 2 } else { 0 }, "ceiling": 4 })
        );
        assert_eq!(
            execution["steps"],
            serde_json::json!({ "actual": if admitted { 14 } else { 10 }, "ceiling": 278 })
        );
        assert_eq!(execution["readSites"].as_array().unwrap().len(), 2);
        assert_eq!(
            execution["readSites"][0]["calls"],
            serde_json::json!({
                "actual": 1,
                "ceiling": 1,
            })
        );
        assert_eq!(execution["readSites"][0]["take"], 1);
        assert_eq!(
            execution["readSites"][1]["calls"],
            serde_json::json!({
                "actual": if admitted { 1 } else { 0 },
                "ceiling": 1,
            })
        );
        assert_eq!(execution["readSites"][1]["take"], 50);
    }
    assert_eq!(
        checks
            .iter()
            .filter(|check| check["kind"] == "journey")
            .count(),
        15
    );
    for name in [
        "alice posts to the room and a non-member cannot",
        "bob replies and alice's live log thread updates",
        "profile ownership, uniqueness, and live public reads",
        "unfollow changes Following selection but not Global authorization",
        "group creation bootstraps one creator admin atomically",
        "conversation metadata stays inside membership",
        "scoped roles reject non-admin and stale membership authority",
        "alice sends and reads back a JPEG photo and synthesized MP4 clip",
        "offline drain removes an unsent body and survives a cold restart",
        "viewed photos render from the byte cache offline; a view-once photo and an unsent row do not",

