fn maintained_message_counts_schema() -> Schema {
    Schema {
        maintains: vec![Maintain {
            kind: MaintainKind::Count,
            source: "messages".to_owned(),
            by: vec!["conversationId".to_owned()],
            target: "messageCounts".to_owned(),
            readable: None,
        }],
        ..Schema::default()
    }
}

