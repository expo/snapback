fn owner_path(root: &Path) -> PathBuf {
    root.join(".snapback/owner.json")
}

fn print_url(info: &OwnerInfo, json_output: bool) {
    if json_output {
        println!(
            "{}",
            json!({ "url": info.url, "generation": info.generation, "pid": info.pid })
        );
    } else {
        println!("SNAPBACK_URL={}", info.url);
    }
}

