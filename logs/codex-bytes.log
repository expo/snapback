  const snapshotPath = resolve(snapshot);
  const workspaceRelative = relative(workspace, snapshotPath);
  if (!workspaceRelative
    || workspaceRelative === ".."
    || workspaceRelative.startsWith(`..${sep}`)
    || isAbsolute(workspaceRelative)) {
