export type StaleView<Result> = {
  state: "stale";
  live: false;
  since: number;
  data?: Result;
  seq?: number;
  next?: Cursor | null;
  outcome?: "complete" | "capped" | "partial" | "denied";
  reason?: string;
  rule?: string;
