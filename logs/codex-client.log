  maxAssetBytes?: number;
}

/** A client has exactly one authority source: a dev persona or bearer custody. */
export type CreateClientOptions = ClientLocationOptions & (
  | { as: string; token?: never; tokenStore?: never }
  | { as?: never; token?: string; tokenStore?: AuthTokenStore }
);

// @ref LLP 1012#7-writes-offline — the outbox is readable before the first
// request, so a queued message is on screen at cold start.
export type OutboxSettlement = { stopped: false | "fence" | "transport" | "authority" | "offline" | "pending" | "writer-unresponsive"; remaining: number };

export interface OutboxStatus {
  ready: boolean;
  /**
   * A follower tab reports `forwarding` (ready: its writes are admitted by the
   * tab that holds the partition), `writer-unresponsive` (still ready; the
   * writer has not admitted its oldest row for five seconds), `inbox-full`, or
   * `follower` (no route to the partition's inbox) (LLP 1018.004 §3).
   */
  reason: "ready" | "sealed" | "grant-missing" | "grant-expired" | "ids-exhausted" | "program-missing"
    | "follower" | "forwarding" | "inbox-full" | "writer-unresponsive";
  action: "none" | "login" | "resume" | "load-program";
  /** Number of queued intents, including a follower's unadmitted rows; settled entries are excluded. */
  remaining: number;
  fence: "inside" | "past";
  /** The partition writer is actively replaying; a connected read cannot establish this. */
  draining?: true;
}

export interface OutboxApi {
  /** Every durable intent of the open partition, FIFO; empty without a store. */
  entries(): Promise<OutboxEntry[]>;
  /** Lazy client-owned snapshot; one read per revision and distinct operation. */
  observe<Args = unknown, Result = unknown>(op?: Op<Args, Result>): ObservedOutbox;
  /** Drops one settled entry; queued intents cannot be dismissed. */
  dismiss(intent: string): Promise<void>;
  /** Observes the outbox; called with the current entries at once and after every change. */
  subscribe(listener: (entries: OutboxEntry[]) => void): () => void;
  /**
   * Without an op, true when a write will not refuse `E_OFFLINE_ID_BLOCK` for
   * want of a replay grant: no partition is open (today's bytes), or the open
   * partition holds a current, unexpired grant — minted by a login, a guest
   * call, or the first drain reaching its watermark. The fence gates replay and
   * prediction, not this (see `fence`). With an op, also means this write would
   * not refuse `E_OFFLINE_ID_BLOCK` for want of a known bound or capacity for
   * `1 + maxNewIds`. Grant, bound, fence, and expiry changes are observable
   * through `subscribe` even when the entries are unchanged (LLP 1012 §7).
   */
  ready<Args = unknown, Result = unknown>(op?: Op<Args, Result>): Promise<boolean>;
  /** Actionable admission state, using the same checks as enqueue. */
  status<Args = unknown, Result = unknown>(op?: Op<Args, Result>): Promise<OutboxStatus>;
  /** Past means replay waits for this partition's successful resume; enqueue remains ready. */
  fence(): Promise<"inside" | "past">;
  /** Replays FIFO; reports the stop reason and queued count without discarding work. */
  drain(): Promise<OutboxSettlement>;
  /**
   * Resolves once the in-flight replay, if any, emptied the queue or a retryable
   * transport failure stopped it; returns the stop reason and queued count,
   * and rejects with a non-retryable refusal that stopped it.
   */
  settled(): Promise<OutboxSettlement>;
}

export interface OutboxSnapshot {
  readonly entries: OutboxEntry[];
  readonly status: OutboxStatus;
  /** On a follower: the writer's announced ledger status, beside this tab's own (LLP 1018.004 §3). */
  readonly writer?: OutboxStatus;
}
export interface ObservedOutbox {
  getSnapshot(): OutboxSnapshot;
  subscribe(notify: () => void): () => void;
}

export interface SnapbackClient {
  readonly auth: AuthApi;
  readonly outbox: OutboxApi;
  /** Settles only after explicit token restoration and any initial persistence. */
  readonly ready: Promise<void>;
  readonly snapshot: ClientSnapshot;
  query<Args, Result>(ref: Op<Args, Result>, args: NoInfer<Args>): Promise<QueryResult<Result>>;
  /** A lazy shared query snapshot. The first listener opens it; the last releases it. */
  observe<Args, Result, Row extends ItemRow, Draft, HistoryArgs, History>(
    ref: Op<Args, Result>, args: NoInfer<Args>,
    options: { live?: false; drain?: boolean; items: ItemsWithHistory<Args, Result, Row, Draft, HistoryArgs, History> },
  ): ObservedQuery<Result, HistorySnapshot<Result, Row, Draft, History>>;
  observe<Args, Result, Row extends ItemRow, Draft>(
    ref: Op<Args, Result>, args: NoInfer<Args>,
    options: { live?: false; drain?: boolean; items: Items<Args, Result, Row, Draft> },
  ): ObservedQuery<Result, ItemSnapshot<Result, Row, Draft>>;
  observe<Args, Result>(
    ref: Op<Args, Result>,
    args: NoInfer<Args>,
    options?: { live?: false; drain?: boolean; items?: undefined },
  ): ObservedQuery<Result>;
  /** Diagnostic count of consumers attached to one shared observed-query identity. */
  sharedConsumers<Args, Result>(ref: Op<Args, Result>, args: NoInfer<Args>, drain?: boolean): number;
  mutation<Args, Result>(ref: Op<Args, Result>, args: NoInfer<AssetInput<Args>>): Promise<MutationResult<Result>>;
  /** Uploads one browser File or Expo URI-backed File and returns its closed asset record. */
  upload(source: AssetUploadSource, options: AssetUploadOptions & { readonly kind: "image" }): Promise<ImageAsset>;
  upload(source: AssetUploadSource, options: AssetUploadOptions & { readonly kind: "video" }): Promise<VideoAsset>;
  upload(source: AssetUploadSource, options?: AssetUploadOptions): Promise<AssetRecord>;
  /** Lists this account's unclaimed uploads, at most 100 per page, including after restart. */
  listUploads(options?: { after?: string }): Promise<UploadListing>;
  /** Discards own unclaimed bytes; running finalizers retain quota until closed. Missing/foreign ids return false. */
  discardUpload(id: string): Promise<boolean>;
  assetUrl(asset: AssetRecord | null | undefined, options?: AssetUrlOptions): Promise<string | undefined>;
  assetUrl(assets: readonly AssetRecord[], options?: AssetUrlOptions): Promise<string[]>;
  /** Authentication headers for a native image source; carriers stay reserved for players/downloads. */
  assetHeaders(): Promise<Record<string, string>>;
  /** Fetches a client-issued asset URL: the byte cache under the row's lease first, then the network with the header credential. */
  assetBlob(url: string, options?: AssetFetchOptions): Promise<Blob>;
  /** Native byte path: cache first, then an authenticated ArrayBuffer response; no Blob. */
  assetBytes(url: string, options?: AssetFetchOptions): Promise<import("./store/byte-cache.js").AssetBytes>;
  /** The partition's byte cache when the client has an offline store; components read it before the network. */
  readonly assetCache: AssetCache | undefined;
  /** Delivers validated query receipt states with `live: true`; transport loss is client-made `stale`. */
  /** Drain follows an ascending append log (after c first N, N <= 50), then watches its tail.
   * Each event is one page. Unsupported returned-page shapes refuse E_OFFLINE_RESUME;
   * use an ordinary c:null subscription for newest-first data and fetch older pages separately. */
  subscribe<Args, Result>(
    ref: Op<Args, Result>,
    args: NoInfer<Args>,
    callback: (delivery: SubscriptionDelivery<Result>) => void,
    options?: { drain?: boolean },
  ): Subscription<SubscriptionDelivery<Result>>;
  channel<Args, Value>(ref: ChannelRef<Args, Value>, args: NoInfer<Args>): ChannelHandle<Value>;
  manifest(): Promise<Manifest>;
  subscribeStatus(callback: (snapshot: ClientSnapshot) => void): () => void;
  /** Cut only this client's transport; the owner remains running. */
  offline(): Promise<void>;
  /** Restore transport and perform resume before new subscription opens. */
  /** Re-authorizes held data and replays writes; rejects unsupported saved logs without dropping them. */
  online(): Promise<void>;
  /** Close and reopen this logical device on the same durable partition. */
  restart(): Promise<SnapbackClient>;
  /** Resolves when the offline carrier is quiet; safe to remove the store after. */
  close(): Promise<void>;
}

type ViewFacts = {
  live: boolean;
  /** Whose certified evaluation produced this answer: the owner's receipt, or the twin over held rows (LLP 1018.003 §1). */
  source?: ReceiptSource;
  stale?: { since: number };
  retained?: boolean;
  caughtUp?: boolean;
  watermark?: Cursor | null;
  predicted?: PredictedRow[];
  /** A local partial's uncovered sites, as the twin published them (LLP 1012 §6). */
  site?: string;
  sites?: Array<{ site: string; reason: "never-held" | "evicted" | "computed-key" }>;
};
/** A stale view keeps the last receipt's outcome and facts beside `since` (LLP 1018.003 §2, transition invariants). */
export type StaleView<Result> = {
  state: "stale";
  live: false;
  since: number;
  data?: Result;
  seq?: number;
  next?: Cursor | null;
  outcome?: "complete" | "capped" | "partial" | "denied";
  reason?: string;
  rule?: string;
} & Omit<ViewFacts, "live" | "stale">;
export type QueryView<Result> =
  | (QueryHeld<Result> & ViewFacts)
  | (QueryComplete<Result> & ViewFacts)
  | (QueryCapped<Result> & ViewFacts)
  | (QueryPartial<Result> & ViewFacts & RetainedContinuation)
  | (QueryDenied & ViewFacts)
  | { state: "refused"; live: false; refusal: RefusalEnvelope }
  | StaleView<Result>
  /** `offline`: the twin had nothing held for this query (LLP 1012 §6), as opposed to the first render. */
  | { state: "hydrating"; live: false; offline?: true };
export type QueryMachineEvent<Result> = QueryResult<Result> | SubscriptionDelivery<Result>;
export interface ObservedQuery<Result, Value extends Snapshot<Result> = Snapshot<Result>> {
  /** Referentially stable and recursively frozen until the shared query publishes a different view. */
  getSnapshot(): Value;
  /** Observes snapshot identity changes; read the value with `getSnapshot()`. */
  subscribe(notify: () => void): () => void;
}

export function initialQueryState<Result>(): QueryView<Result> {
  return { state: "hydrating", live: false };
}

export { canonical as stableSerialize };

const LOCAL_FACT_KEYS = ["retained", "caughtUp", "watermark", "predicted", "site", "sites"] as const;
const VIEW_FACT_KEYS = ["stale", ...LOCAL_FACT_KEYS] as const;
const RECEIPT_FACT_KEYS = ["source", "next", "reason", "rule", ...LOCAL_FACT_KEYS] as const;
const REFUSAL_FACT_KEYS = ["site", "rule", "rewrite", "reason", "op", "shape", "which", "cap"] as const;

/** Copy only present facts; an omitted fact stays omitted across every projection. */
function defined(source: Record<string, any>, keys: readonly string[]): Record<string, any> {
  const result: Record<string, any> = {};
  for (const key of keys) if (source[key] !== undefined) result[key] = source[key];
  return result;
}

// @ref LLP 1002#9-the-client-snapback2client-snapback2react-snapback2test — React preserves data identity while exposing every receipt-backed state.
// @ref LLP 1018.003#2-derive-never-add — the transition invariants: a stale
// event keeps the last receipt and never scrubs delivered data; denial,
// refusal, and reset scrub; the provenance axis records who evaluated.
export function reduceQueryState<Result>(
  current: QueryView<Result>,
  event: QueryMachineEvent<Result>,
): QueryView<Result> {
  const eventData = "data" in event ? event.data : undefined;
  const currentData = "data" in current ? current.data : undefined;
  const data = canonical(eventData) === canonical(currentData) ? currentData : eventData;
  const live = "live" in event ? event.live : false;
  const offline = "connection" in event && event.connection === "offline";
  const source: ReceiptSource = "source" in event && event.source !== undefined ? event.source : offline ? "twin" : "server";
  const facts = defined(event, VIEW_FACT_KEYS);
  let next: QueryView<Result>;
  switch (event.state) {
    case "complete":
    case "held":
    case "capped":
      next = { state: event.state, live, source, data: data as Result, seq: event.seq, next: event.next, ...facts };
      break;
    case "partial":
      next = { state: "partial", live, source, ...(data === undefined ? {} : { data: data as Result }),
        seq: event.seq, reason: event.reason, ...facts,
        ...("retained" in event && event.retained === true && "next" in event ? { next: event.next } : {}) };
      break;
    case "denied":
      next = { state: "denied", live, source, rule: event.rule, seq: event.seq, ...facts };
      break;
    case "hydrating":
      next = offline ? { state: "hydrating", live: false, offline: true } : { state: "hydrating", live: false };
      break;
    case "refused": {
      const refusal: RefusalEnvelope = {
        code: event.code, family: event.family, message: event.message, guide: event.guide,
        ...defined(event, REFUSAL_FACT_KEYS),
      };
      next = { state: "refused", live: false, refusal };
      break;
    }
    case "stale": {
      // The last receipt survives only when the stale event names no other
      // sequence: a different seq means the event's data is held data the
      // receipt does not describe. A kept denial keeps no data.
      const previous = current;
      const receipted = current.state === "complete" || current.state === "capped" || current.state === "partial" || current.state === "denied"
        ? current : undefined;
      const outcome = receipted !== undefined ? receipted.state : current.state === "stale" ? current.outcome : undefined;
      const receiptSeq = "seq" in current ? current.seq : undefined;
      const keep = outcome !== undefined && (event.seq === undefined || event.seq === receiptSeq);
      const staleData = keep && outcome === "denied" ? undefined : data !== undefined ? data : currentData;
      const seq = keep ? receiptSeq : event.seq !== undefined ? event.seq : receiptSeq;
      const stale: StaleView<Result> = { state: "stale", live: false, since: event.since };
      if (staleData !== undefined) stale.data = staleData;
      if (seq !== undefined) stale.seq = seq;
      if (keep) {
        stale.outcome = outcome;
        Object.assign(stale, defined(previous, RECEIPT_FACT_KEYS));
      }
      next = stale;
      break;
    }
  }
  return canonical(current) === canonical(next) ? current : next;
}
// @ref LLP 1018.003#2-derive-never-add — a summary is a projection of facts,
// never a fact: `summarize` and `readiness` are the only places a screen's
// three-way status and one-sentence reason come from, and every fact they
// project stays on the record one property down.
import type {
  ConnectionState,
  Cursor,
  OutboxEntry,
  OutboxStatus,
  PredictedRow,
  QueryView,
  RefusalEnvelope,
  ReceiptSource,
} from "./types.js";

export type ReceiptOutcome = "complete" | "capped" | "partial" | "denied";
export type SnapshotStatus = "loading" | "ready" | "unavailable";
export type SnapshotReasonCode = "refused" | "denied" | "partial" | "stale" | "offline" | "predicted" | "held";

/** One observed query, as a screen reads it (LLP 1018.003 §1). */
export type Snapshot<T> = {
  data: T | undefined;
  /** What a certified evaluation said about this value, and whose evaluation it was. */
  receipt?: {
    outcome: ReceiptOutcome;
    source: ReceiptSource;
    seq: number;
    next: Cursor | null;
    reason?: string;
    rule?: string;
    /** A local partial's uncovered sites (LLP 1012 §6). */
    sites?: readonly { site: string; reason: string }[];
  };
  /** How current it is. Transport truth, independent of the receipt. */
  freshness: { live: boolean; staleSince?: number; connection: ConnectionState };
  /** What this device added. Offline truth. */
  local: {
    /** Rows a queued intent predicted, each with the intent that minted it; match `id` against the rows you render. */
    predicted: readonly PredictedRow[];
    retained: boolean;
    caughtUp?: boolean;
    watermark?: Cursor | null;
  };
  refusal?: RefusalEnvelope;
  /** Derived, never stored: `ready` means readable data, not server confirmation or a usable composite. */
  status: SnapshotStatus;
  /** `detail` carries the rule a denial named or the reason a partial gave; the sentence stays generic. */
  reason?: { code: SnapshotReasonCode; message: string; detail?: string };
};

/** The sentences behind `reason.message`, keyed by code; switch on `code` to supply your own. */
export const reasonMessages: Readonly<Record<Exclude<SnapshotReasonCode, "refused">, string>> = Object.freeze({
  denied: "Not visible to this account.",
  partial: "Some data is not downloaded.",
  stale: "Showing downloaded data.",
  offline: "Offline, and nothing is downloaded yet.",
  predicted: "Includes changes the server has not confirmed.",
  held: "Showing downloaded data that the server has not checked yet.",
});

const EMPTY_PREDICTED: readonly PredictedRow[] = Object.freeze([]);

function receiptOf<T>(view: QueryView<T>): Snapshot<T>["receipt"] | undefined {
  if (view.state === "complete" || view.state === "capped") {
    return { outcome: view.state, source: view.source ?? "server", seq: view.seq, next: view.next };
  }
  if (view.state === "partial") {
    return { outcome: "partial", source: view.source ?? "server", seq: view.seq,
      next: view.retained === true ? view.next ?? null : null, reason: view.reason, ...(view.sites === undefined ? {} : { sites: view.sites }) };
  }
  if (view.state === "denied") {
    return { outcome: "denied", source: view.source ?? "server", seq: view.seq, next: null, rule: view.rule };
  }
  if (view.state === "stale" && view.outcome !== undefined && view.seq !== undefined) {
    return {
      outcome: view.outcome,
      source: view.source ?? "server",
      seq: view.seq,
      next: view.next ?? null,
      ...(view.reason === undefined ? {} : { reason: view.reason }),
      ...(view.rule === undefined ? {} : { rule: view.rule }),
      ...(view.sites === undefined ? {} : { sites: view.sites }),
    };
  }
  return undefined;
}

/**
 * The whole summary contract, as one table (LLP 1018.003 §2). Pure: the same
 * view and connection always summarize the same way, and nothing here is a
 * fact the view did not already carry.
 */
export function summarize<T>(view: QueryView<T>, connection: ConnectionState): Snapshot<T> {
  const data = "data" in view ? view.data : undefined;
  const receipt = receiptOf(view);
  const staleSince = view.state === "stale" ? view.since : "stale" in view ? view.stale?.since : undefined;
  const local: Snapshot<T>["local"] = {
    predicted: "predicted" in view && view.predicted !== undefined ? view.predicted : EMPTY_PREDICTED,
    retained: "retained" in view && view.retained === true,
    ...("caughtUp" in view && view.caughtUp !== undefined ? { caughtUp: view.caughtUp } : {}),
    ...("watermark" in view && view.watermark !== undefined ? { watermark: view.watermark } : {}),
  };
  const base = {
    data,
    ...(receipt === undefined ? {} : { receipt }),
    freshness: { live: view.live, ...(staleSince === undefined ? {} : { staleSince }), connection },
    local,
  };
  if (view.state === "refused") {
    const { refusal } = view;
    return { ...base, refusal, status: "unavailable", reason: { code: "refused", message: refusal.rewrite ?? refusal.message } };
  }
  const detail = (value: string | undefined) => (value === undefined ? {} : { detail: value });
  if (receipt?.outcome === "denied") {
    return { ...base, status: "unavailable", reason: { code: "denied", message: reasonMessages.denied, ...detail(receipt.rule) } };
  }
  if (receipt?.outcome === "partial" && data === undefined) {
    return { ...base, status: "unavailable", reason: { code: "partial", message: reasonMessages.partial, ...detail(receipt.reason) } };
  }
  if (data !== undefined && receipt !== undefined) {
    const code: SnapshotReasonCode | undefined = receipt.outcome === "partial" ? "partial"
      : staleSince !== undefined ? "stale"
        : local.predicted.length > 0 ? "predicted"
          : undefined;
    return {
      ...base,
      status: "ready",
      ...(code === undefined ? {} : { reason: { code, message: reasonMessages[code], ...(code === "partial" ? detail(receipt.reason) : {}) } }),
    };
  }
  if (data !== undefined) {
    return { ...base, status: "ready", reason: { code: "held", message: reasonMessages.held } };
  }
  // The twin reported nothing held while the device is not connected: nothing
  // will arrive until it is. The same marker with a live connection is a fetch
  // in flight, so it stays loading.
  if (view.state === "hydrating" && view.offline === true && connection !== "connected") {
    return { ...base, status: "unavailable", reason: { code: "offline", message: reasonMessages.offline } };
  }
  return { ...base, status: "loading" };
}

export type ReadinessAction = "sign-in" | "connect" | "other-tab" | "wait";
export type ReadinessCode = OutboxStatus["reason"] | "fence" | "pending" | (string & {});
/** Whether a write can be accepted now, and what the user can do if not (LLP 1018.003 §2). */
export type Readiness = {
  send: boolean;
  action?: ReadinessAction;
  reason?: { code: ReadinessCode; message: string };
};

/** The sentences behind `can.reason.message`, keyed by code; `pending` is composed from the queue and connection. */
export const readinessMessages: Readonly<Record<string, string>> = Object.freeze({
  sealed: "Sign in again to send your saved messages.",
  "grant-missing": "Connect to enable sending. Queued messages stay saved.",
  "grant-expired": "Reconnect to enable new messages. Queued messages stay saved.",
  "ids-exhausted": "Reconnect to continue sending. Queued messages stay saved.",
  "program-missing": "Connect to download this conversation before sending.",
  follower: "Another tab holds this account and this one cannot reach it. Send from that tab, or close it to send here.",
  fence: "Queued until the next sync.",
  forwarding: "Another tab sends for this account. Messages are saved here first.",
  "inbox-full": "This device holds as many unsent messages as it can. Wait for the sending tab.",
  "writer-unresponsive": "The sending tab is not responding. Your message stays saved.",
});

/**
 * `queued` is the op-scoped count the hook computes, not the partition-wide
 * `remaining`; active replay decides whether waiting is useful on the writer.
 * `connect` offers `client.online()`: a connected read alone replays nothing.
 */
export function readiness(status: OutboxStatus, connection: ConnectionState, queued: number): Readiness {
  const reason = status.reason as string;
  const message = (code: string) => readinessMessages[code] ?? `Sending is unavailable (${code}).`;
  if (reason === "follower") return { send: false, action: "other-tab", reason: { code: reason, message: message(reason) } };
  if (reason === "sealed") return { send: false, action: "sign-in", reason: { code: reason, message: message(reason) } };
  if (!status.ready) {
    return { send: false, action: reason === "inbox-full" ? "wait" : "connect", reason: { code: reason, message: message(reason) } };
  }
  // @ref LLP 1018.004#3-readiness-on-a-follower — a follower's rows are durable
  // and FIFO: an unresponsive writer is a reason on a sendable status, and the
  // pending sentence names the sending tab rather than the server.
  if (reason === "writer-unresponsive") return { send: true, action: "wait", reason: { code: reason, message: message(reason) } };
  if (status.fence === "past") return { send: true, action: "connect", reason: { code: "fence", message: message("fence") } };
  if (queued > 0) {
    const waiting = reason === "forwarding" ? "Waiting for the sending tab."
      : status.draining ? "Waiting for the server."
        : connection === "connected" ? "Sync to resume delivery." : "Waiting for connection.";
    return { send: true, action: reason === "forwarding" || status.draining ? "wait" : "connect",
      reason: { code: "pending", message: `${queued} queued · ${waiting}` } };
  }
  return { send: true };
}

/** The label a queued or settled intent shows; never a client clock (LLP 1012 §7). */
export function intentLabel(entry: OutboxEntry): string {
  switch (entry.state) {
    case "queued": return entry.reason === "fence" ? "Will be checked by the server"
      : entry.predicted ? "Sending… · Preview" : "Sending… · Awaiting confirmation";
    case "committed": return "Sent";
    case "expired": return "Expired";
    case "rejected": {
      const response = entry.response as { reason?: string; code?: string; rewrite?: string; message?: string } | undefined;
      // A trace conflict, or a recipe's own compare-and-set (`require msg.body = baseBody else CONFLICT`), reads the same.
      if (response?.reason === "conflict" || response?.code === "CONFLICT") return "Not sent · Message changed";
      return `Not sent · ${response?.rewrite ?? response?.message ?? response?.code ?? "refused"}`;
    }
    default: return String((entry as { state: string }).state);
  }
}
import React, {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
  useSyncExternalStore,
  type ReactNode,
} from "react";
import { createClient, isSnapbackRefusal, type SnapbackRefusal } from "./client.js";
import { viewedAssetIds } from "./client-assets.js";
import { referenceName, type Channel as ChannelRef, type Op } from "./api.js";
import { readiness, type Readiness, type Snapshot } from "./snapshot.js";
import type { HistorySnapshot, ItemRow, Items, ItemSnapshot, ItemsWithHistory } from "./client-items.js";
import {
  stableSerialize,
  type AuthApi,
  type AuthSnapshot,
  type AssetRecord,
  type AssetInput,
  type AssetUrlOptions,
  type ChannelHandle,
  type ChannelSnapshot,
  type ChannelWriteResult,
  type ClientSnapshot,
  type ConnectionState,
  type CreateClientOptions,
  type MutationResult,
  type OfflineClientOptions,
  type OutboxEntry,
  type OutboxStatus,
  type Principal,
  type RefusalEnvelope,
  type SnapbackClient,
} from "./types.js";

export { initialQueryState, reduceQueryState } from "./types.js";
export type { QueryView } from "./types.js";
export { intentLabel, readiness, readinessMessages, reasonMessages, summarize } from "./snapshot.js";
export type { Readiness, ReadinessAction, ReadinessCode, Snapshot, SnapshotReasonCode, SnapshotStatus } from "./snapshot.js";

interface ProviderValue {
  client: SnapbackClient;
  snapshot: ClientSnapshot;
}

const Context = createContext<ProviderValue | null>(null);

export type SnapbackProviderProps = (
  | (CreateClientOptions & { client?: never })
  | { client: SnapbackClient; url?: never; as?: never; token?: never; tokenStore?: never; fetch?: never; offline?: never }
) & { children: ReactNode };

/**
 * The offline options by value: the carrier factory by identity, the numbers
 * by value. A parent that renders an inline `offline={{ store, … }}` allocates
 * a new object every render; that must not allocate a new lock-holding client,
 * so the options are compared by their parts (`sameOffline`).
 */
function sameOffline(left: OfflineClientOptions | undefined, right: OfflineClientOptions | undefined): boolean {
  if (left === right) return true;
  if (!left || !right) return false;
  return left.store === right.store
    && left.fenceDays === right.fenceDays
    && left.maxAssetBytes === right.maxAssetBytes;
}

/** The options the client is created with: the parts the client reads, by value. */
function offlineByValue(options: OfflineClientOptions): OfflineClientOptions {
  return {
    store: options.store,
    ...(options.fenceDays === undefined ? {} : { fenceDays: options.fenceDays }),
    ...(options.maxAssetBytes === undefined ? {} : { maxAssetBytes: options.maxAssetBytes }),
  };
}

// @ref LLP 1002#9-the-client-snapback2client-snapback2react-snapback2test — React web is the first arm over the shared headless client.
export function SnapbackProvider({ client: supplied, url, as, token, tokenStore, fetch, offline, children }: SnapbackProviderProps): React.ReactElement {
  if (as !== undefined && (token !== undefined || tokenStore !== undefined)) {
    throw new TypeError("SnapbackProvider cannot combine dev persona `as` with bearer token custody");
  }
  // A client opens its offline partition (and takes the principal's Web Lock)
  // the moment it is created, so it must be created exactly once per identity.
  // StrictMode double-invokes memo factories and discards one result, which
  // would leak a lock-holding client; a ref survives the re-render untouched,
  // and the identity compares `offline` by its values, not its reference.
  const identity = [supplied, url, as, token, tokenStore, fetch] as const;
  const held = useRef<{ identity: readonly unknown[]; offline: OfflineClientOptions | undefined; client: SnapbackClient }>(undefined);
  if (!held.current
    || held.current.identity.some((item, index) => item !== identity[index])
    || !sameOffline(held.current.offline, offline)) {
    const stable = offline === undefined ? undefined : offlineByValue(offline);
    held.current = {
      identity,
      offline,
      client: supplied ?? createClient(as !== undefined ? { url: url!, as, fetch, offline: stable } : { url: url!, token, tokenStore, fetch, offline: stable }),
    };
  }
  const client = held.current.client;
  const [status, setStatus] = useState({ client, snapshot: client.snapshot });
  const snapshot = status.client === client ? status.snapshot : client.snapshot;
  const pendingClose = useRef<{ client: SnapbackClient; timer: ReturnType<typeof setTimeout> } | undefined>(undefined);

  useEffect(() => {
    // StrictMode unmounts and remounts synchronously; a close deferred by one
    // tick is cancelled by the remount and still runs on a real unmount.
    if (pendingClose.current?.client === client) {
      clearTimeout(pendingClose.current.timer);
      pendingClose.current = undefined;
    }
    let active = true;
    const unsubscribe = client.subscribeStatus((snapshot) => { if (active) setStatus({ client, snapshot }); });
    setStatus({ client, snapshot: client.snapshot });
    void client.manifest().catch(() => undefined);
    return () => {
      active = false;
      unsubscribe();
      // Supplied clients belong to the caller and may outlive this provider.
      if (!supplied) pendingClose.current = { client, timer: setTimeout(() => client.close(), 0) };
    };
  }, [client, supplied]);

  return <Context.Provider value={{ client, snapshot }}>{children}</Context.Provider>;
}

function provider(): ProviderValue {
  const value = useContext(Context);
  if (!value) throw new Error("Snapback hooks require <SnapbackProvider>");
  return value;
}

/** The provider-owned client, for first-party platform components and custom transports. */
export function useSnapbackClient(): SnapbackClient {
  return provider().client;
}

export function useSnapbackSnapshot(): ClientSnapshot {
  return provider().snapshot;
}

export function useConnection(): ConnectionState {
  return provider().snapshot.connection;
}

/**
 * Reads a receipt-backed query. It subscribes by default; pass `{ live: false }`
 * for a one-shot read. Receipt state stays `complete`, `capped`, `partial`, or
 * `denied`; `live` and `connection` report the subscription transport separately.
 */
/** drain requires an ascending append log (after c first N, N <= 50); emits each page, then its tail.
 * Unsupported returned-page shapes remain refused. For newest-first data subscribe normally at c:null. */
export function useQuery<Args, Result, Row extends ItemRow, Draft, HistoryArgs, History>(
  ref: Op<Args, Result>, args: NoInfer<Args>,
  options: { live?: false; drain?: boolean; items: ItemsWithHistory<Args, Result, Row, Draft, HistoryArgs, History> },
): HistorySnapshot<Result, Row, Draft, History>;
export function useQuery<Args, Result, Row extends ItemRow, Draft>(
  ref: Op<Args, Result>, args: NoInfer<Args>,
  options: { live?: false; drain?: boolean; items: Items<Args, Result, Row, Draft> },
): ItemSnapshot<Result, Row, Draft>;
export function useQuery<Args, Result>(
  ref: Op<Args, Result>, args: NoInfer<Args>, options?: { live?: false; drain?: boolean; items?: undefined },
): Snapshot<Result>;
export function useQuery<Args, Result, Row extends ItemRow, Draft>(
  ref: Op<Args, Result>,
  args: NoInfer<Args>,
  options: { live?: false; drain?: boolean; items?: Items<Args, Result, Row, Draft> } = {},
): Snapshot<Result> {
  const { client, snapshot } = provider();
  const argsKey = stableSerialize(args);
  const stableArgs = useMemo(() => args, [argsKey]);
  const live = options.live !== false;
  if (!live && options.drain) throw new TypeError("useQuery drain requires a live subscription");
  const operation = referenceName(ref);
  const restoring = !!snapshot.token && snapshot.auth.state === "hydrating";
  const observed = useMemo(
    () => client.observe(ref, stableArgs, { ...options } as { live?: false; drain?: boolean; items: Items<Args, Result, Row, Draft> }),
    [client, snapshot.authGeneration, operation, argsKey, live, options.drain, options.items, restoring],
  );
  const state = useSyncExternalStore(observed.subscribe, observed.getSnapshot, observed.getSnapshot);
  return state;
}

export function useSubscription<Args, Result>(
  ref: Op<Args, Result>,
  args: NoInfer<Args>,
): Snapshot<Result> {
  return useQuery(ref, args);
}

export interface UseMutationResult<Args, Result> {
  run(args: AssetInput<Args>): Promise<MutationResult<Result>>;
  /** A `run()` is awaiting the owner right now. */
  inFlight: boolean;
  /** Whether `run()` can be accepted now, and what the user can do if not (LLP 1018.003 §2). */
  can: Readiness;
  /** This op's intents still queued in the durable outbox, FIFO (LLP 1012 §7). */
  pending: OutboxEntry[];
  last: MutationResult<Result> | undefined;
  /** The mechanism behind `can`: the full outbox status, the last retryable transport refusal, and on a follower the writer's announced status. */
  detail: { status: OutboxStatus; transport?: SnapbackRefusal; writer?: OutboxStatus };
}

/** The durable outbox of the open partition, FIFO, with `dismiss` for settled intents. */
export interface UseOutboxResult {
  entries: OutboxEntry[];
  /** Grant-present readiness: no particular write bound is implied. */
  can: Readiness;
  detail: { status: OutboxStatus; writer?: OutboxStatus };
  dismiss(intent: string): Promise<void>;
}

// @ref LLP 1012#7-writes-offline — the outbox opens before the first request,
// so a queued message is on screen at cold start before the network is tried.
// @ref LLP 1018.003#4-pending-rows-attribution-settlement-and-failure — the runtime
// exposes terminal history until explicit dismissal. Query items independently
// resolve their indicators from the displayed target's observation evidence.
function useOutboxState(op?: Op<any, any>): UseOutboxResult {
  const { client, snapshot } = provider();
  const operation = op === undefined ? undefined : referenceName(op);
  const identity = useMemo(() => ({}), [client, snapshot.authGeneration, operation]);
  const observed = useMemo(() => client.outbox.observe(op), [identity]);
  const { entries, status, writer } = useSyncExternalStore(observed.subscribe, observed.getSnapshot, observed.getSnapshot);
  const dismiss = useCallback((intent: string) => client.outbox.dismiss(intent), [client]);
  const queued = useMemo(
    () => entries.filter((entry) => entry.state === "queued" && (operation === undefined || entry.op === operation)).length,
    [entries, operation],
  );
  const can = useMemo(() => readiness(status, snapshot.connection, queued), [status, snapshot.connection, queued]);
  return useMemo(() => ({ entries, can, detail: { status, ...(writer === undefined ? {} : { writer }) }, dismiss }), [entries, can, status, writer, dismiss]);
}

export function useOutbox(): UseOutboxResult {
  return useOutboxState();
}

export function useMutation<Args, Result>(ref: Op<Args, Result>): UseMutationResult<Args, Result> {
  const { client, snapshot } = provider();
  const operation = referenceName(ref);
  const identity = useMemo(() => ({ client, generation: snapshot.authGeneration, operation }), [client, snapshot.authGeneration, operation]);
  const activeIdentity = useRef(identity);
  activeIdentity.current = identity;
  const { entries, can, detail } = useOutboxState(ref);
  const pending = useMemo(
    () => entries.filter((entry) => entry.op === operation && entry.state === "queued"),
    [entries, operation],
  );
  const [machine, setMachine] = useState<{
    identity: typeof identity;
    pending: number;
    last?: MutationResult<Result>;
    transport?: SnapbackRefusal;
  }>({ identity, pending: 0 });
  const visible = machine.identity === identity
    ? machine
    : { identity, pending: 0 };
  const run = useCallback(async (args: AssetInput<Args>) => {
    const active = () => activeIdentity.current === identity && client.snapshot.authGeneration === identity.generation;
    if (!active()) return client.mutation(ref, args);
    setMachine((current) => current.identity === identity
      ? { ...current, pending: current.pending + 1 }
      : { identity, pending: 1 });
    try {
      const result = await client.mutation(ref, args);
      if (active()) setMachine((current) => ({
        identity,
        pending: current.identity === identity ? current.pending : 0,
        last: result,
      }));
      return result;
    } catch (error) {
      if (active() && isSnapbackRefusal(error) && error.retryable) {
        setMachine((current) => current.identity === identity
          ? { ...current, transport: error }
          : { identity, pending: 0, transport: error });
      }
      throw error;
    } finally {
      if (active()) setMachine((current) => current.identity === identity
        ? { ...current, pending: Math.max(0, current.pending - 1) }
        : current);
    }
  }, [identity, ref]);
  const fullDetail = useMemo(
    () => ({ status: detail.status, ...(visible.transport === undefined ? {} : { transport: visible.transport }),
      ...(detail.writer === undefined ? {} : { writer: detail.writer }) }),
    [detail.status, detail.writer, visible.transport],
  );
  return useMemo(
    () => ({ run, inFlight: visible.pending > 0, can, pending, last: visible.last, detail: fullDetail }),
    [run, visible.pending, can, pending, visible.last, fullDetail],
  );
}

export type AuthHookState = AuthSnapshot["state"];
export interface UseAuthResult extends AuthSnapshot, AuthApi { token?: string }

export function useAuth(): UseAuthResult {
  const { client, snapshot } = provider();
  // Bearer restoration starts in the client. A persona or a client with no
  // stored token keeps the lazy owner check; every hook joins that same flight.
  useEffect(() => {
    let active = true;
    void client.ready.then(() => {
      if (active && !client.snapshot.token && client.snapshot.auth.state === "hydrating") return client.auth.me();
    }).catch(() => undefined);
    return () => { active = false; };
  }, [client]);
  return { ...snapshot.auth, token: snapshot.token, ...client.auth };
}

export interface UseChannelResult<Value> extends ChannelSnapshot<Value> {
  set(value: Value): Promise<ChannelWriteResult>;
  clear(): Promise<ChannelWriteResult>;
}

export function useChannel<Args, Value>(ref: ChannelRef<Args, Value>, args: NoInfer<Args>): UseChannelResult<Value> {
  const { client, snapshot } = provider();
  const argsKey = stableSerialize(args);
  const room = useMemo(
    () => client.channel<Args, Value>(ref, args),
    [client, snapshot.authGeneration, referenceName(ref), argsKey],
  );
  const pendingClose = useRef<{ room: ChannelHandle<Value>; timer: ReturnType<typeof setTimeout> } | undefined>(undefined);
  useEffect(() => {
    if (pendingClose.current?.room === room) {
      clearTimeout(pendingClose.current.timer);
      pendingClose.current = undefined;
    }
    return () => { pendingClose.current = { room, timer: setTimeout(() => room.close(), 0) }; };
  }, [room]);
  const subscribe = useCallback((notify: () => void) => {
    const observation = room.subscribe(notify);
    return () => observation.close();
  }, [room]);
  const state = useSyncExternalStore(subscribe, room.getSnapshot, room.getSnapshot);
  return useMemo(() => ({ ...state, set: room.set, clear: room.clear }), [state, room]);
}

type AssetUrlValue = string | (string | undefined)[] | undefined;

/**
 * Resolves records without putting authority in image URLs. A carrier is minted
 * only when explicitly requested for a player/download that cannot send headers.
 */
// @ref LLP 1006#2b-the-session-carrier-author-ruling-2026-09-03 — refreshes
// affect newly resolved URLs only; an already returned player src is immutable.
export function useAssetUrl(asset: AssetRecord | null | undefined, options?: AssetUrlOptions): string | undefined;
export function useAssetUrl(assets: readonly AssetRecord[], options?: AssetUrlOptions): (string | undefined)[] | undefined;
export function useAssetUrl(
  assetOrList: AssetRecord | readonly AssetRecord[] | null | undefined,
  options: AssetUrlOptions = {},
): AssetUrlValue {
  const { client, snapshot } = provider();
  // A blob: URL belongs to one client identity on one partition: a new client or an
  // auth transition (login, logout, expiry) re-runs the effect, which revokes and re-mints.
  const key = stableSerialize({
    assets: Array.isArray(assetOrList)
      ? assetOrList.map((asset) => asset.id)
      : assetOrList == null ? null : (assetOrList as AssetRecord).id,
    width: options.width,
    carrier: options.carrier === true,
    download: options.download === true,
    authGeneration: snapshot.authGeneration,
  });
  const stableAsset = useMemo(() => assetOrList, [key]);
  const identity = useMemo(() => ({ client, key }), [client, key]);
  const [resolved, setResolved] = useState<{ identity: typeof identity; value?: AssetUrlValue }>({ identity });
  const value = resolved.identity === identity ? resolved.value : undefined;
  useEffect(() => {
    let active = true;
    const created: string[] = [];
    const list: readonly AssetRecord[] = Array.isArray(stableAsset)
      ? stableAsset
      : stableAsset == null ? [] : [stableAsset as AssetRecord];
    // @ref LLP 1012#9-asset-bytes-on-the-device — a rendition the byte cache holds
    // answers as a blob: URL before any network URL or carrier is minted, and a viewed
    // view-once row gets no URL at all: the guard is the one `assetBlob` applies.
    void (async () => {
      await client.ready;
      const cache = client.assetCache;
      const objectUrls = typeof URL.createObjectURL === "function";
      const held = await Promise.all(list.map((asset) => objectUrls ? cache?.get(asset.id, options.width ?? null) : undefined));
      const missing = list.filter((_asset, index) => held[index] === undefined);
      const viewed = await viewedAssetIds(cache, missing.map((asset) => asset.id));
      const mintable = missing.filter((asset) => !viewed.has(asset.id));
      // A viewed guard can drop an entry during minting; preserve each asset's position.
      const minted = await Promise.all(mintable.map((asset) => client.assetUrl(asset, options)));
      const mintedById = new Map(mintable.map((asset, index) => [asset.id, minted[index]]));
      const urls = list.map((asset, index) => {
        const blob = held[index];
        if (!blob) return mintedById.get(asset.id);
        const url = URL.createObjectURL(blob);
        created.push(url);
        return url;
      });
      if (!active) {
        for (const url of created) URL.revokeObjectURL(url);
        return;
      }
      setResolved({ identity, value: Array.isArray(stableAsset) ? urls : urls[0] });
    })().catch(() => undefined);
    return () => {
      active = false;
      for (const url of created) URL.revokeObjectURL(url);
    };
  }, [identity, stableAsset, options.width, options.carrier, options.download]);
  return value;
}

