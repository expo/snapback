import { createExpoClient, SnapbackProvider } from "snapback2/expo";
import type { SnapbackClient } from "snapback2/client";
import { Text } from "react-native";
import { Chat } from "./src/Chat";
// @ref LLP 1018.003#3-tombstones-are-declared-certified-and-shared — eviction follows the schema's `tombstones` line.
const chatOffline = {};

const url = process.env.EXPO_PUBLIC_SNAPBACK_URL ?? "http://127.0.0.1:3210";
// Metro inlines this in app source, never at simctl launch or inside node_modules.
const witnessUrl = process.env.EXPO_PUBLIC_SNAPBACK_WITNESS;

const Witness = witnessUrl ? lazy(() => import("./src/Witness")) : undefined;

export function NormalApp() {
  const [client, setClient] = useState<SnapbackClient>();
  const [error, setError] = useState<string>();
  useEffect(() => {
    const client = createExpoClient({ url, as: "alice", offline: chatOffline });
    setClient(client);
    void client.ready.catch((error) => setError(String(error)));
    return () => { void client.close(); };
  }, []);
  if (!client || error) return <Text accessibilityLiveRegion="polite">{error ?? "Connecting…"}</Text>;
  return <SnapbackProvider client={client}><Chat /></SnapbackProvider>;
}

export default function App() {
  return witnessUrl && Witness ? <Suspense fallback={<Text>Loading witness…</Text>}><Witness url={url} controlUrl={witnessUrl} /></Suspense> : <NormalApp />;
}
import { api, defineItems, mutationTarget, withHistory } from "snapback2/client";

// @ref LLP 1018.003.001#3-semantic-mutation-targets — one certified domain binding, independent of insert order and query membership.
export const messageWrites = {
  create: mutationTarget(api.deliveries.post, "messages"),
  update: mutationTarget(api.deliveries.edit, "messages"),
  remove: mutationTarget(api.deliveries.unsend, "messages"),
};
const messageItems = {
  table: "messages",
  order: "reverse" as const,
  update: { target: messageWrites.update },
  remove: { target: messageWrites.remove },
};
export const threadItems = defineItems(api.deliveries.thread, {
  ...messageItems,
  select: delivery => delivery.message,
  create: {
    target: messageWrites.create,
    belongs: (args, query) => query.c === null && args.conversationId === query.conversationId,
    draft: args => ({ body: args.body }),
  },
});

// @ref LLP 1018.006#1-the-declaration — under partial custody the composite's
// rows come from the independently authorized thread page; declared once here,
// the SDK opens and closes that history for both platform arms.
export const conversationItems = withHistory(defineItems(api.deliveries.conversationView, {
  ...messageItems,
