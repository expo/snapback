+            ("present", "byOwner", Expr::Input(Input::Viewer), KeyProvenance::Viewer),
+            ("absent", "byId", var("other"), KeyProvenance::Arg),
+        ] {
+            let binding = format!("{label}Row");
+            body.extend([
+                Stmt::Let { name: binding.clone(), value: Expr::Get(Read {
