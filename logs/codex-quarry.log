  const site = { file: documents[0]?.file ?? "snapback/schema.q", line: 1, col: 1 };
  const declaration: TableDecl = {
    name: "connected", site,
    columns: [
      { name: "principal", type: { kind: "principal", optional: false }, site },
      { name: "value", type: { kind: "int", optional: false }, site },
