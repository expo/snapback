+      assert(diagnostic?.code === "E_QUARRY_SYNTAX" && diagnostic.site === "snapback/schema.q:5:3"
+        && diagnostic.family === "quarry" && diagnostic.guide === "quarry/grammar", JSON.stringify(result));
+      deepStrictEqual(diagnostic.rewrite, rewrite);
