const PRECEDENCE = new Map<string, number>([
  ["??", 1], ["or", 2], ["and", 3],
  ["=", 4], ["!=", 4], ["<", 4], ["<=", 4], [">", 4], [">=", 4],
  ["+", 5], ["-", 5], ["*", 6], ["/", 6], ["%", 6],
