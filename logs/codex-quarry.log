export type QuarryCode = "E_SCHEMA_ASSET_MAINTAIN" | "E_SCHEMA_CONSTRAINT" | "E_SCHEMA_INDEX_COLUMN"
  | "E_SCHEDULE_COLUMN" | "E_SCHEDULE_TARGET" | "E_SCHEDULE_DURATION"
