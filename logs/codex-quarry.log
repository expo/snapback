+        ]))));
+        let program = Program { name: name.into(), kind,
+            args: BTreeMap::from([("other".into(), ArgType::Ref { table: "counts".into() })]),
+            read_time_granularity_ms: None, body };
+        let expected = row([("present", Value::Int(present)), ("absent", Value::Int(0))]);
