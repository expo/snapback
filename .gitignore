# Prebuilt Linux Hermes bundle staged for the remote-drill Docker build; the
# drill receipt pins its identity + sha256 (never committed as bytes).
/demos/competitive-checkpoint/acceptance/drill/hermes/
# Exact Linux release binaries staged for the low-memory Fly image assembler.
# The prebuilt Dockerfile verifies their source revision and every checksum;
# qualification receipts retain the deployed image/source identity.
/demos/competitive-checkpoint/acceptance/drill/prebuilt/

# LLP 0276 repository-root rule: orchestration outputs belong under the
# gitignored runs/<date>-<slug>/ hierarchy, never loose at the repository root.
/*.log
/runs/

# compile-fail fixture build artifacts (regenerated; never committed)
tests/fixtures/*/target/
