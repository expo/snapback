/target/
/.snapback/
/.llp/ship-runs/
**/.snapback/codegen-cache/
/.snapback.snapback.restore.lock
node_modules/
.agent-local-secrets.md
.env.local

# Maintained demo backends commit the deterministic review manifest, not the
# regenerable materialized graph. Codegen and bundler/runtime resolvers consume
# the digest-bound graph from each app's .snapback/codegen-cache.
demos/*/snapback/generated/*
!demos/*/snapback/generated/artifacts.json
!demos/competitive-checkpoint/snapback/generated/api.d.ts
!demos/competitive-checkpoint/snapback/generated/api.mjs
!demos/partiful-matrix/snapback/generated/api.mjs
demos/todo-v2/snapback/generated-remote-service/*
!demos/todo-v2/snapback/generated-remote-service/artifacts.json
demos/all-aboard/tests/egress-probe/generated/*
!demos/all-aboard/tests/egress-probe/generated/artifacts.json
*.swp
/cloudflare/.wrangler/
/dist-publish/
/.eas-artifacts/
# Prebuilt Linux Hermes bundle staged for the remote-drill Docker build; the
# drill receipt pins its identity + sha256 (never committed as bytes).
/demos/competitive-checkpoint/acceptance/drill/hermes/
# Exact Linux release binaries staged for the low-memory Fly image assembler.
# The prebuilt Dockerfile verifies their source revision and every checksum;
# qualification receipts retain the deployed image/source identity.
/demos/competitive-checkpoint/acceptance/drill/prebuilt/
