{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/verify-receipt.v1.json",
  "title": "Snapback verify receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "ok",
    "status",
    "startedAtMs",
    "finishedAtMs",
    "durationMs",
    "profileSet",
    "context",
    "stages",
    "acceptanceProfiles",
    "next",
    "nonclaims"
  ],
  "properties": {
    "artifactKind": { "const": "snapbackVerifyReceipt" },
    "schemaVersion": { "const": "snapback.verify-receipt.v1" },
    "ok": { "type": "boolean" },
    "status": { "enum": ["passed", "failed"] },
    "startedAtMs": { "type": "integer", "minimum": 0 },
    "finishedAtMs": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "profileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "identity", "testBytes"],
      "properties": {
        "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "identity": { "$ref": "#/$defs/sha256" },
        "testBytes": { "$ref": "#/$defs/testBytes" }
      }
    },
    "context": { "$ref": "#/$defs/context" },
    "stages": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/artifactStage" },
        { "$ref": "#/$defs/runtimeStage" },
        { "$ref": "#/$defs/admissionStage" },
        { "$ref": "#/$defs/capabilityStage" },
        { "$ref": "#/$defs/acceptanceStage" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "acceptanceProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profileResult" }
    },
    "next": { "type": "array", "items": { "$ref": "#/$defs/next" } },
    "recommendedNext": { "$ref": "#/$defs/next" },
    "nonclaims": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "required": ["recommendedNext"] },
      "then": { "properties": { "next": { "minItems": 1, "maxItems": 1 } } }
    },
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": {
        "properties": {
          "status": { "const": "passed" },
          "next": { "maxItems": 0 },
          "stages": { "items": { "properties": { "status": { "const": "passed" } } } }
        }
      },
      "else": { "properties": { "status": { "const": "failed" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "subsystem", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "subsystem": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": true
      }
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "testBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256", "bytes", "files"],
      "properties": {
        "algorithm": { "const": "sha256-path-length-content.v1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileDigest" } }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "identity": { "type": ["string", "null"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "data", "authority", "seed"],
      "properties": {
        "target": { "$ref": "#/$defs/identity" },
        "data": { "$ref": "#/$defs/identity" },
        "seed": { "$ref": "#/$defs/identity" },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity", "principalClass"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "identity": { "type": ["string", "null"] },
            "principalClass": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "diagnostics", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "evidence": true
      }
    },
    "artifactStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "artifact-freshness" } } }] },
    "runtimeStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "runtime-readiness" } } }] },
    "admissionStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "admission-and-conformance" } } }] },
    "capabilityStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "capability-resolution" } } }] },
    "acceptanceStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "acceptance-profiles" } } }] },
    "profileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "title", "status", "startedAtMs", "finishedAtMs", "durationMs", "testBytes", "context", "conformance", "diagnostics"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "startedAtMs": { "type": "integer", "minimum": 0 },
        "finishedAtMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "testBytes": { "$ref": "#/$defs/testBytes" },
        "context": { "$ref": "#/$defs/context" },
        "conformance": { "type": "array" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "command", "reason"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
