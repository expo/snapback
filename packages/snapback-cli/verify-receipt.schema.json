{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/verify-receipt.v1.json",
  "title": "Snapback verify receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "ok",
    "status",
    "startedAtMs",
    "finishedAtMs",
    "durationMs",
    "profileSet",
    "context",
    "stages",
    "acceptanceProfiles",
    "next",
    "nonclaims"
  ],
  "properties": {
    "artifactKind": { "const": "snapbackVerifyReceipt" },
    "schemaVersion": { "const": "snapback.verify-receipt.v1" },
    "ok": { "type": "boolean" },
    "status": { "enum": ["passed", "passed-without-acceptance", "failed"] },
    "startedAtMs": { "type": "integer", "minimum": 0 },
    "finishedAtMs": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "profileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "identity", "testBytes"],
      "properties": {
        "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "identity": { "$ref": "#/$defs/sha256" },
        "testBytes": { "$ref": "#/$defs/testBytes" }
      }
    },
    "context": { "$ref": "#/$defs/context" },
    "stages": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/artifactStage" },
        { "$ref": "#/$defs/runtimeStage" },
        { "$ref": "#/$defs/admissionStage" },
        { "$ref": "#/$defs/capabilityStage" },
        { "$ref": "#/$defs/acceptanceStage" }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "acceptanceProfiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profileResult" }
    },
    "next": { "type": "array", "items": { "$ref": "#/$defs/next" } },
    "recommendedNext": { "$ref": "#/$defs/next" },
    "nonclaims": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "required": ["recommendedNext"] },
      "then": { "properties": { "next": { "type": "array", "minItems": 1, "maxItems": 1 } } }
    },
    {
      "type": "object",
      "if": { "type": "object", "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": {
        "type": "object",
        "properties": {
          "status": { "enum": ["passed", "passed-without-acceptance"] },
          "next": { "type": "array", "maxItems": 0 },
          "stages": { "type": "array", "items": { "type": "object", "properties": { "status": { "const": "passed" } } } }
        }
      },
      "else": { "type": "object", "properties": { "status": { "const": "failed" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "subsystem", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^SNAPBACK_[A-Z0-9_]+$" },
        "severity": { "type": "string", "minLength": 1 },
        "subsystem": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": true
      }
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "testBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256", "bytes", "files"],
      "properties": {
        "algorithm": { "const": "sha256-path-length-content.v1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileDigest" } }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "identity": { "type": ["string", "null"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "data", "authority", "seed"],
      "properties": {
        "target": { "$ref": "#/$defs/identity" },
        "data": { "$ref": "#/$defs/identity" },
        "seed": { "$ref": "#/$defs/identity" },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity", "principalClass"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "identity": { "type": ["string", "null"] },
            "principalClass": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "diagnostics", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "evidence": true
      }
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "conformanceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingReads", "missingWrites", "extraReads", "extraWrites",
        "readProvenance", "writeProvenance"
      ],
      "properties": {
        "missingReads": { "$ref": "#/$defs/stringSet" },
        "missingWrites": { "$ref": "#/$defs/stringSet" },
        "extraReads": { "$ref": "#/$defs/stringSet" },
        "extraWrites": { "$ref": "#/$defs/stringSet" },
        "readProvenance": { "enum": ["complete", "incomplete", "unsupported"] },
        "writeProvenance": { "enum": ["complete", "incomplete", "unsupported"] }
      }
    },
    "conformancePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId", "id", "kind", "targetProfileId", "functionId", "status", "report"
      ],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["success", "failure", "action", "relational", "search", "snapshot-bundle"] },
        "targetProfileId": { "type": "string", "minLength": 1 },
        "functionId": { "type": ["string", "null"], "minLength": 1 },
        "status": { "enum": ["authoritative", "incomplete", "unsupported"] },
        "report": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/conformanceReport" }
          ]
        }
      }
    },
    "underDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "pathId", "functionId", "missingReads", "missingWrites"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "pathId": { "type": "string", "minLength": 1 },
        "functionId": { "type": ["string", "null"], "minLength": 1 },
        "missingReads": { "$ref": "#/$defs/stringSet" },
        "missingWrites": { "$ref": "#/$defs/stringSet" }
      }
    },
    "overDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functionId", "completeObservedPaths", "extraReads", "extraWrites", "severity"],
      "properties": {
        "functionId": { "type": "string", "minLength": 1 },
        "completeObservedPaths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reads", "writes"],
          "properties": {
            "reads": { "type": "integer", "minimum": 0 },
            "writes": { "type": "integer", "minimum": 0 }
          }
        },
        "extraReads": { "$ref": "#/$defs/stringSet" },
        "extraWrites": { "$ref": "#/$defs/stringSet" },
        "severity": { "const": "warning" }
      }
    },
    "conformanceAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "disposition", "scope", "limitationReason", "complete",
        "expectedPaths", "observedPaths", "pathEvidence", "underDeclarations",
        "overDeclarations", "diagnostics"
      ],
      "properties": {
        "status": { "enum": ["passed", "partial", "failed", "not-claimed", "blocked"] },
        "disposition": { "type": "string", "minLength": 1 },
        "scope": { "const": "explicitly-registered-paths-only" },
        "limitationReason": { "type": "string", "minLength": 1 },
        "complete": { "type": "boolean" },
        "expectedPaths": { "type": "integer", "minimum": 0 },
        "observedPaths": { "type": "integer", "minimum": 0 },
        "authoritativePaths": { "type": "integer", "minimum": 0 },
        "partialPaths": { "type": "integer", "minimum": 0 },
        "pathEvidence": { "type": "array", "items": { "$ref": "#/$defs/conformancePath" } },
        "underDeclarations": { "type": "array", "items": { "$ref": "#/$defs/underDeclaration" } },
        "overDeclarations": { "type": "array", "items": { "$ref": "#/$defs/overDeclaration" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      },
      "allOf": [
        {
          "if": { "properties": { "expectedPaths": { "const": 0 } }, "required": ["expectedPaths"] },
          "then": {
            "properties": {
              "status": { "const": "not-claimed" },
              "complete": { "const": false },
              "observedPaths": { "const": 0 },
              "pathEvidence": { "maxItems": 0 },
              "underDeclarations": { "maxItems": 0 },
              "overDeclarations": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not-claimed" } }, "required": ["status"] },
          "then": { "properties": { "expectedPaths": { "const": 0 } } }
        }
      ]
    },
    "admissionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissionMode", "conformance"],
      "properties": {
        "admissionMode": { "type": ["string", "null"] },
        "conformance": { "$ref": "#/$defs/conformanceAggregate" }
      }
    },
    "artifactStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "artifact-freshness" } } }] },
    "runtimeStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "runtime-readiness" } } }] },
    "admissionStage": {
      "allOf": [
        { "$ref": "#/$defs/stage" },
        {
          "properties": {
            "id": { "const": "admission-and-conformance" },
            "evidence": { "$ref": "#/$defs/admissionEvidence" }
          }
        }
      ]
    },
    "capabilityStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "capability-resolution" } } }] },
    "acceptanceStage": { "allOf": [{ "$ref": "#/$defs/stage" }, { "properties": { "id": { "const": "acceptance-profiles" } } }] },
    "profileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "title", "status", "startedAtMs", "finishedAtMs", "durationMs", "testBytes", "context", "conformance", "diagnostics"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "startedAtMs": { "type": "integer", "minimum": 0 },
        "finishedAtMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "testBytes": { "$ref": "#/$defs/testBytes" },
        "context": { "$ref": "#/$defs/context" },
        "conformance": { "type": "array" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "command", "instruction", "reason"],
      "properties": {
        "code": { "type": "string", "pattern": "^SNAPBACK_[A-Z0-9_]+$" },
        "command": { "type": ["string", "null"], "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
