{
  "name": "@snapback/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Installable Snapback developer loop and native server launcher.",
  "files": [
    "cli.mjs",
    "comparator-profile.mjs",
    "comparator-receipt.schema.json",
    "deployment-control.mjs",
    "hosted-admission-producer.mjs",
    "index.mjs",
    "mcp-control.mjs",
    "runtime-recovery.mjs",
    "fixtures/comparator/green.config.mjs",
    "fixtures/comparator/app/snapback",
    "templates"
  ],
  "bin": {
    "snapback": "./cli.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./comparator": "./comparator-profile.mjs",
    "./comparator-receipt.schema.json": "./comparator-receipt.schema.json",
    "./deployment-control": "./deployment-control.mjs",
    "./hosted-admission-producer": "./hosted-admission-producer.mjs",
    "./runtime-recovery": "./runtime-recovery.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@snapback/client": "workspace:*",
    "@snapback/codegen": "workspace:*",
    "@snapback/contract": "workspace:*"
  },
  "optionalDependencies": {
    "@snapback/runtime-darwin-arm64": "workspace:*",
    "@snapback/runtime-linux-x64": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node load-generated.test.mjs && node sessions-dev-loop.test.mjs && node comparator-profile.test.mjs && node hosted-admission-producer.test.mjs && node mcp-control.test.mjs && node dev-loop.test.mjs && node adapters/fly-machines-vm-driver.test.mjs"
  }
}
