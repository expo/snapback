{
  "name": "@expo/snapback-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Installable Snapback developer loop and native server launcher.",
  "files": [
    "adapters/fly-machines-vm-driver.mjs",
    "cli.mjs",
    "comparator-profile.d.mts",
    "comparator-profile.mjs",
    "comparator-receipt.schema.json",
    "deployment-control.d.mts",
    "deployment-control.mjs",
    "fixtures/comparator/app/snapback",
    "fixtures/comparator/green.config.mjs",
    "hosted-admission-producer.d.mts",
    "hosted-admission-producer.mjs",
    "hosted-control.d.mts",
    "hosted-control.mjs",
    "hosted-schemas",
    "index.d.mts",
    "index.mjs",
    "mcp-control.mjs",
    "runtime-readiness.d.mts",
    "runtime-readiness.mjs",
    "runtime-recovery.d.mts",
    "runtime-recovery.mjs",
    "templates"
  ],
  "bin": {
    "snapback": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./comparator": {
      "types": "./comparator-profile.d.mts",
      "default": "./comparator-profile.mjs"
    },
    "./comparator-receipt.schema.json": "./comparator-receipt.schema.json",
    "./deployment-control": {
      "types": "./deployment-control.d.mts",
      "default": "./deployment-control.mjs"
    },
    "./hosted-control": {
      "types": "./hosted-control.d.mts",
      "default": "./hosted-control.mjs"
    },
    "./hosted-admission-producer": {
      "types": "./hosted-admission-producer.d.mts",
      "default": "./hosted-admission-producer.mjs"
    },
    "./runtime-recovery": {
      "types": "./runtime-recovery.d.mts",
      "default": "./runtime-recovery.mjs"
    },
    "./runtime-readiness": {
      "types": "./runtime-readiness.d.mts",
      "default": "./runtime-readiness.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@expo/snapback-client": "workspace:*",
    "@expo/snapback-codegen": "workspace:*",
    "@expo/snapback-contract": "workspace:*"
  },
  "optionalDependencies": {
    "@expo/snapback-runtime-darwin-arm64": "workspace:*",
    "@expo/snapback-runtime-linux-x64": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node hosted-control.test.mjs && node load-generated.test.mjs && node sessions-dev-loop.test.mjs && node comparator-profile.test.mjs && node hosted-admission-producer.test.mjs && node mcp-control.test.mjs && node dev-loop.test.mjs && node adapters/fly-machines-vm-driver.test.mjs"
  }
}
