{
  "name": "@snapback/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Installable Snapback developer loop and native server launcher.",
  "files": [
    "cli.mjs",
    "index.mjs",
    "mcp-control.mjs",
    "templates"
  ],
  "bin": {
    "snapback": "./cli.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@snapback/codegen": "workspace:*"
  },
  "optionalDependencies": {
    "@snapback/runtime-darwin-arm64": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node mcp-control.test.mjs"
  }
}
