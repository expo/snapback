{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/comparator-receipt.v1.json",
  "title": "Snapback comparator acceptance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "title",
    "status",
    "exitCode",
    "startedAtMs",
    "finishedAtMs",
    "durationMs",
    "executorPackages",
    "identity",
    "expectedChecks",
    "checks",
    "capabilityGaps",
    "cleanup",
    "nonclaims",
    "diagnostic"
  ],
  "properties": {
    "schemaVersion": { "const": "snapback.comparator-receipt.v1" },
    "profileId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["passed", "failed", "unsupported", "infrastructure-error"]
    },
    "exitCode": { "enum": [0, 1, 2] },
    "startedAtMs": { "type": "integer", "minimum": 0 },
    "finishedAtMs": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "executorPackages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "client"],
      "properties": {
        "cli": { "$ref": "#/$defs/executorPackage" },
        "client": { "$ref": "#/$defs/executorPackage" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "artifact", "binary"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "kind", "profileId", "serverUrl", "databaseMode", "managed"],
          "properties": {
            "available": { "type": "boolean" },
            "kind": { "type": "string", "minLength": 1 },
            "profileId": { "type": "string", "minLength": 1 },
            "serverUrl": { "type": ["string", "null"] },
            "databaseMode": { "type": "string", "minLength": 1 },
            "managed": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "available": { "const": true } },
                "required": ["available"]
              },
              "then": {
                "properties": {
                  "serverUrl": { "type": "string", "minLength": 1 }
                }
              },
              "else": {
                "properties": { "serverUrl": { "type": "null" } }
              }
            }
          ]
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "appId", "bundleHash", "inputsHash", "schemaHash"],
          "properties": {
            "available": { "type": "boolean" },
            "appId": { "type": ["string", "null"] },
            "bundleHash": { "type": ["string", "null"] },
            "inputsHash": { "type": ["string", "null"] },
            "schemaHash": { "type": ["string", "null"] }
          },
          "allOf": [
            {
              "if": {
                "properties": { "available": { "const": true } },
                "required": ["available"]
              },
              "then": {
                "properties": {
                  "appId": { "type": "string", "minLength": 1 },
                  "bundleHash": { "type": "string", "minLength": 1 },
                  "inputsHash": { "type": "string", "minLength": 1 },
                  "schemaHash": { "type": "string", "minLength": 1 }
                }
              },
              "else": {
                "properties": {
                  "appId": { "type": "null" },
                  "bundleHash": { "type": "null" },
                  "inputsHash": { "type": "null" },
                  "schemaHash": { "type": "null" }
                }
              }
            }
          ]
        },
        "binary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "available",
            "sha256",
            "crateVersion",
            "gitCommit",
            "gitDirty",
            "buildProfile",
            "startupNonce"
          ],
          "properties": {
            "available": { "type": "boolean" },
            "path": { "type": ["string", "null"] },
            "sha256": {
              "anyOf": [
                { "type": "null" },
                { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              ]
            },
            "crateVersion": { "type": ["string", "null"] },
            "gitCommit": { "type": ["string", "null"] },
            "gitDirty": { "type": ["boolean", "null"] },
            "buildProfile": { "type": ["string", "null"] },
            "startupNonce": { "type": ["string", "null"] }
          },
          "allOf": [
            {
              "if": {
                "properties": { "available": { "const": true } },
                "required": ["available"]
              },
              "then": {
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "crateVersion": { "type": "string", "minLength": 1 },
                  "gitCommit": { "type": "string", "minLength": 1 },
                  "gitDirty": { "type": "boolean" },
                  "buildProfile": { "type": "string", "minLength": 1 }
                }
              },
              "else": {
                "properties": {
                  "path": { "type": ["string", "null"] },
                  "sha256": { "type": "null" },
                  "crateVersion": { "type": "null" },
                  "gitCommit": { "type": "null" },
                  "gitDirty": { "type": "null" },
                  "buildProfile": { "type": "null" },
                  "startupNonce": { "type": "null" }
                }
              }
            }
          ]
        }
      }
    },
    "expectedChecks": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/checkDefinition" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkResult" }
    },
    "capabilityGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityGap" }
    },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "diagnostic": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/diagnostic" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exitCode": { "const": 0 },
          "checks": {
            "type": "array",
            "minItems": 5,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/checkResult" },
                { "type": "object", "properties": { "status": { "const": "passed" }, "diagnostic": { "type": "null" } } }
              ]
            }
          },
          "capabilityGaps": { "type": "array", "maxItems": 0 },
          "cleanup": {
            "allOf": [
              { "$ref": "#/$defs/cleanup" },
              { "type": "object", "properties": { "attempted": { "const": true }, "ok": { "const": true } } }
            ]
          },
          "diagnostic": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exitCode": { "const": 1 },
          "checks": {
            "type": "array",
            "minItems": 5,
            "contains": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] },
            "items": {
              "allOf": [
                { "$ref": "#/$defs/checkResult" },
                { "type": "object", "properties": { "status": { "enum": ["passed", "failed"] } } }
              ]
            }
          },
          "capabilityGaps": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/capabilityGap" },
                { "type": "object", "properties": { "blocking": { "const": false } } }
              ]
            }
          },
          "cleanup": {
            "allOf": [
              { "$ref": "#/$defs/cleanup" },
              { "type": "object", "properties": { "attempted": { "const": true }, "ok": { "const": true } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "unsupported" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exitCode": { "const": 1 },
          "checks": { "type": "array", "maxItems": 0 },
          "capabilityGaps": {
            "type": "array",
            "minItems": 1,
            "contains": { "type": "object", "properties": { "blocking": { "const": true } }, "required": ["blocking"] }
          },
          "cleanup": {
            "allOf": [
              { "$ref": "#/$defs/cleanup" },
              { "type": "object", "properties": { "attempted": { "const": true }, "ok": { "const": true } } }
            ]
          },
          "diagnostic": {
            "allOf": [
              { "$ref": "#/$defs/diagnostic" },
              { "type": "object", "properties": { "code": { "const": "SNAPBACK_COMPARATOR_CAPABILITY_GAP" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "infrastructure-error" } }, "required": ["status"] },
      "then": {
        "properties": {
          "exitCode": { "const": 2 },
          "capabilityGaps": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/capabilityGap" },
                { "type": "object", "properties": { "blocking": { "const": false } } }
              ]
            }
          },
          "diagnostic": {
            "allOf": [
              { "$ref": "#/$defs/diagnostic" },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "SNAPBACK_COMPARATOR_CHECK_TIMEOUT",
                      "SNAPBACK_COMPARATOR_SERVER_DEAD",
                      "SNAPBACK_COMPARATOR_SETUP_FAILED",
                      "SNAPBACK_COMPARATOR_CLEANUP_FAILED",
                      "SNAPBACK_COMPARATOR_IDENTITY_MISMATCH"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "executorPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "algorithm", "files", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "algorithm": {
          "const": "sha256-package-files-path-length-content.v1"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "checkDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "startedAtMs",
        "finishedAtMs",
        "durationMs",
        "details",
        "diagnostic"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "infrastructure-error"] },
        "startedAtMs": { "type": "integer", "minimum": 0 },
        "finishedAtMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "details": {},
        "diagnostic": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/diagnostic" }
          ]
        }
      }
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blocking", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "source": {
          "enum": ["target-gap", "target-capability-manifest"]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "ok",
        "managed",
        "leaderExited",
        "temporaryStateRemoved",
        "errors"
      ],
      "properties": {
        "attempted": { "type": "boolean" },
        "ok": { "type": "boolean" },
        "managed": { "type": "boolean" },
        "leaderExited": { "type": ["boolean", "null"] },
        "temporaryStateRemoved": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    }
  }
}
