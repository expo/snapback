      "runtime": {
        "IbexModule": {
          "export": "createProject",
          "source": "globalThis.__snapbackHandlers = { \"createProject\": (async (ctx, args) => {\n    const projectKey = ctx.runtime.id();\n    await ctx.db.insert('projects', { ...args, projectKey, updatedAt: ctx.runtime.now() });\n    return projectKey;\n  }) };\n"
        }
      },
