      "runtime": {
        "IbexModule": {
          "export": "deleteProject",
          "source": "globalThis.__snapbackHandlers = { \"deleteProject\": (async (ctx, { projectKey }) => {\n    const row = await ctx.db.query('projects').withIndex('by_key').eq('projectKey', projectKey).first();\n    if (!row) throw new Error('project not found');\n    await ctx.db.delete('projects', row._id);\n    return true;\n  }) };\n"
        }
      },
