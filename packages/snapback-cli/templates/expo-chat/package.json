{
  "name": "snapback-expo-chat",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "generate": "snapback generate snapback",
    "dev": "snapback dev snapback --expo --expo-platform web",
    "dev:native-refusal": "snapback dev snapback --expo --expo-platform ios",
    "start": "expo start",
    "web": "expo start --web",
    "carry:headless": "node carrier.mjs headless",
    "carry:web-browser": "node carrier.mjs web-browser",
    "carry:native-simulator": "node carrier.mjs native-simulator",
    "carry:self-check": "node carrier.mjs --self-check --json",
    "typecheck": "tsc --noEmit",
    "prove": "snapback verify snapback --config ./snapback.verify.config.mjs --receipt ./.snapback/verify-receipt.json --json",
    "test": "node acceptance.mjs",
    "test:static": "node acceptance.static.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/snapback-cli": "__SNAPBACK_VERSION__",
    "@expo/snapback-client": "__SNAPBACK_VERSION__",
    "@expo/snapback-codegen": "__SNAPBACK_VERSION__",
    "@expo/snapback-expo": "__SNAPBACK_VERSION__",
    "@expo/snapback-react": "__SNAPBACK_VERSION__",
    "expo": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.3"
  }
}
