{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/codegen/handler-typescript-profile/v1.schema.json",
  "title": "Snapback bounded handler TypeScript profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "sourceProfile",
    "transformVersion",
    "compiler",
    "effectiveOptions",
    "moduleExtensions",
    "diagnosticRules"
  ],
  "properties": {
    "artifactKind": { "const": "handlerTypeScriptProfile" },
    "schemaVersion": { "const": 1 },
    "sourceProfile": { "const": "bounded-handler-typescript-v1" },
    "transformVersion": { "const": "snapback-typescript-syntax-erasure-v1" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "integrity"],
      "properties": {
        "package": { "const": "typescript" },
        "version": { "const": "5.9.3" },
        "integrity": { "const": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==" }
      }
    },
    "effectiveOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowJs",
        "allowSyntheticDefaultImports",
        "alwaysStrict",
        "checkJs",
        "customTransformers",
        "emitDecoratorMetadata",
        "erasableSyntaxOnly",
        "experimentalDecorators",
        "importHelpers",
        "inlineSourceMap",
        "inlineSources",
        "isolatedModules",
        "jsx",
        "module",
        "moduleDetection",
        "moduleResolution",
        "noEmitHelpers",
        "noImplicitAny",
        "plugins",
        "preserveConstEnums",
        "rewriteRelativeImportExtensions",
        "sourceMap",
        "strict",
        "target",
        "useDefineForClassFields",
        "verbatimModuleSyntax"
      ],
      "properties": {
        "allowJs": { "const": false },
        "allowSyntheticDefaultImports": { "const": false },
        "alwaysStrict": { "const": false },
        "checkJs": { "const": false },
        "customTransformers": { "const": false },
        "emitDecoratorMetadata": { "const": false },
        "erasableSyntaxOnly": { "const": true },
        "experimentalDecorators": { "const": false },
        "importHelpers": { "const": false },
        "inlineSourceMap": { "const": false },
        "inlineSources": { "const": true },
        "isolatedModules": { "const": true },
        "jsx": { "const": false },
        "module": { "const": "ESNext" },
        "moduleDetection": { "const": "auto" },
        "moduleResolution": { "const": "Bundler" },
        "noEmitHelpers": { "const": true },
        "noImplicitAny": { "const": false },
        "plugins": { "const": false },
        "preserveConstEnums": { "const": true },
        "rewriteRelativeImportExtensions": { "const": true },
        "sourceMap": { "const": true },
        "strict": { "const": true },
        "target": { "const": "ES2022" },
        "useDefineForClassFields": { "const": true },
        "verbatimModuleSyntax": { "const": true }
      }
    },
    "moduleExtensions": {
      "const": { ".ts": ".js", ".mts": ".mjs" }
    },
    "diagnosticRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bareImport",
        "commonJs",
        "compilerMismatch",
        "constEnum",
        "declarationFile",
        "decorator",
        "dynamicImport",
        "emitHelper",
        "enum",
        "extensionInference",
        "namespace",
        "nodeImport",
        "nonErasableSyntax",
        "parameterProperty",
        "pathAlias",
        "sourceMapFailed",
        "transformFailed",
        "tsx",
        "typecheckFailed",
        "unsupportedExtension"
      ],
      "properties": {
        "bareImport": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_BARE_IMPORT" },
        "commonJs": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_COMMONJS" },
        "compilerMismatch": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_COMPILER_MISMATCH" },
        "constEnum": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_CONST_ENUM" },
        "declarationFile": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_DECLARATION_FILE" },
        "decorator": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_DECORATOR" },
        "dynamicImport": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_DYNAMIC_IMPORT" },
        "emitHelper": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_EMIT_HELPER" },
        "enum": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_ENUM" },
        "extensionInference": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_EXTENSION_INFERENCE" },
        "namespace": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_NAMESPACE" },
        "nodeImport": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_NODE_IMPORT" },
        "nonErasableSyntax": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_NON_ERASABLE_SYNTAX" },
        "parameterProperty": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_PARAMETER_PROPERTY" },
        "pathAlias": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_PATH_ALIAS" },
        "sourceMapFailed": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_SOURCE_MAP_FAILED" },
        "transformFailed": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_TRANSFORM_FAILED" },
        "tsx": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_TSX" },
        "typecheckFailed": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_TYPECHECK_FAILED" },
        "unsupportedExtension": { "const": "SNAPBACK_CODEGEN_TYPESCRIPT_UNSUPPORTED_EXTENSION" }
      }
    }
  }
}
