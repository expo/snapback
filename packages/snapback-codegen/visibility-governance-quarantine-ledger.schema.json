{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/visibility-governance-quarantine-ledger.v1.json",
  "title": "Snapback append-only visibility quarantine ledger v1",
  "type": "object",
  "required": ["schemaVersion", "records", "retiredIds", "headDigest"],
  "properties": {
    "schemaVersion": { "const": "snapback.visibility-governance-quarantine-ledger.v1" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quarantineId", "governedRecordId", "path", "digest"],
        "properties": {
          "quarantineId": { "type": "string", "minLength": 1 },
          "governedRecordId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "retiredIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "headDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
