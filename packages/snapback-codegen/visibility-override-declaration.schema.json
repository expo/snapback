{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/visibility-override-declaration.v1.json",
  "title": "Snapback visibility override declaration v1",
  "type": "object",
  "required": ["schemaVersion", "id", "owner", "authority", "reads", "operations", "justification", "lifecycleClass", "approval", "approvalSeparationReceipt", "acceptance"],
  "properties": {
    "schemaVersion": { "const": "snapback.visibility-override-declaration.v1" },
    "id": { "$ref": "#/$defs/id" },
    "owner": { "$ref": "#/$defs/id" },
    "authority": { "$ref": "#/$defs/authority" },
    "reads": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/rowScope" } },
    "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "justification": { "type": "string", "minLength": 1 },
    "lifecycleClass": { "enum": ["production", "fixture"] },
    "issuedOn": { "type": "string", "format": "date-time" },
    "expiresOn": { "type": "string", "format": "date" },
    "fixtureProfile": { "$ref": "visibility-fixture-profile.v1.json" },
    "approval": { "type": "string", "minLength": 1 },
    "approvalSeparationReceipt": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "object",
      "required": ["id", "path", "resultDigest"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "resultDigest": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "patternDerivation": {
      "type": "object",
      "required": ["patternId", "constructorVersion", "constructorDigest", "derivationDigest"],
      "properties": {
        "patternId": { "$ref": "#/$defs/id" },
        "constructorVersion": { "$ref": "#/$defs/id" },
        "constructorDigest": { "$ref": "#/$defs/digest" },
        "derivationDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "rekey": {
      "type": "object",
      "required": ["oldScopeDigestVersion", "oldScopeDigest", "newScopeDigestVersion", "newScopeDigest", "toolChange", "predecessorApproval", "substantiveProvenance"],
      "properties": {
        "oldScopeDigestVersion": { "$ref": "#/$defs/id" },
        "oldScopeDigest": { "$ref": "#/$defs/digest" },
        "newScopeDigestVersion": { "$ref": "#/$defs/id" },
        "newScopeDigest": { "$ref": "#/$defs/digest" },
        "toolChange": { "type": "string", "minLength": 1 },
        "predecessorApproval": { "type": "string", "minLength": 1 },
        "substantiveProvenance": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    { "if": { "properties": { "lifecycleClass": { "const": "production" } } }, "then": { "required": ["issuedOn", "expiresOn"], "not": { "required": ["fixtureProfile"] } } },
    { "if": { "properties": { "lifecycleClass": { "const": "fixture" } } }, "then": { "required": ["fixtureProfile"], "not": { "anyOf": [{ "required": ["issuedOn"] }, { "required": ["expiresOn"] }] } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "policyLeaf": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "public-read" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "field"], "properties": { "kind": { "const": "owner" }, "field": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "declaration", "resourceField"], "properties": { "kind": { "const": "membership" }, "declaration": { "$ref": "#/$defs/id" }, "resourceField": { "$ref": "#/$defs/id" }, "roles": { "$ref": "#/$defs/stringSet" } }, "additionalProperties": false }
      ]
    },
    "policy": {
      "oneOf": [
        { "$ref": "#/$defs/policyLeaf" },
        { "type": "object", "required": ["kind", "arms"], "properties": { "kind": { "const": "any-of" }, "arms": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/policyLeaf" } } }, "additionalProperties": false }
      ]
    },
    "authority": {
      "oneOf": [
        { "type": "object", "required": ["mode", "operations", "admissionPolicy"], "properties": { "mode": { "const": "principal" }, "operations": { "$ref": "#/$defs/stringSet" }, "admissionPolicy": { "$ref": "#/$defs/policy" } }, "additionalProperties": false },
        { "type": "object", "required": ["mode", "entrypoint"], "properties": { "mode": { "const": "system" }, "entrypoint": { "$ref": "#/$defs/id" }, "calls": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }, "additionalProperties": false },
        { "type": "object", "required": ["mode", "issuanceProfile", "operations", "maximumTtlMs"], "properties": { "mode": { "const": "capturedGrant" }, "issuanceProfile": { "$ref": "#/$defs/id" }, "operations": { "$ref": "#/$defs/stringSet" }, "maximumTtlMs": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
      ]
    },
    "rowScope": {
      "oneOf": [
        { "type": "object", "required": ["allRows"], "properties": { "allRows": { "const": true } }, "additionalProperties": false },
        { "$ref": "#/$defs/policy" },
        { "type": "object", "required": ["field", "op", "value"], "properties": { "field": { "$ref": "#/$defs/id" }, "op": { "const": "Eq" }, "value": {} }, "additionalProperties": false }
      ]
    }
  }
}
