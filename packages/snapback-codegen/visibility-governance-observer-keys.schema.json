{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/visibility-governance-observer-keys.v1.json",
  "title": "Snapback visibility governance observer key registry v1",
  "type": "object",
  "required": ["schemaVersion", "activeEpoch", "keys"],
  "properties": {
    "schemaVersion": { "const": "snapback.visibility-governance-observer-keys.v1" },
    "activeEpoch": { "type": "string", "minLength": 1 },
    "keys": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["epoch", "publicKeyPem", "keyDigest", "revoked"],
        "properties": {
          "epoch": { "type": "string", "minLength": 1 },
          "publicKeyPem": { "type": "string", "minLength": 1 },
          "keyDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "revoked": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
