{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/authorization-review.v2.json",
  "title": "Snapback authorization review projection",
  "type": "object",
  "required": [
    "schemaVersion", "appId", "authMode", "inputsHash", "operations",
    "tablePolicies", "authorizationTables", "authorityProfiles", "sectionSchemas",
    "fieldPolicies", "visibilityOverrides", "tablePolicyTransitions", "quarantines",
    "elevatedReadSites", "writePolicyChecks"
  ],
  "properties": {
    "schemaVersion": { "const": "snapback.authorization-review.v2" },
    "appId": { "type": "string", "minLength": 1 },
    "authMode": { "type": "string", "minLength": 1 },
    "inputsHash": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "kind", "runtimeClass", "handlerForm", "authRequirement",
          "authorityIndependent", "authorizationDependence", "readSetSummary",
          "writeSetSummary", "authorizationPredicates", "effectCeiling", "standardPattern",
          "effectiveTablePolicies", "uncomposedReadSurfaces", "elevatedDatabase",
          "authorityProfileIdentities", "fieldBoundary", "maskedFieldUses"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["Query", "LiveQuery", "Mutation", "Action"] },
          "runtimeClass": { "enum": ["host-plan", "javascript-handler"] },
          "handlerForm": { "type": "string", "minLength": 1 },
          "authRequirement": {
            "type": "object",
            "required": ["value", "origin"],
            "properties": {
              "value": { "enum": ["public", "optional-user", "authenticated"] },
              "origin": { "enum": ["explicit", "derived", "legacy-default"] }
            },
            "additionalProperties": false
          },
          "authorityIndependent": { "type": "boolean" },
          "authorizationDependence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "readSetSummary": { "type": "object" },
          "writeSetSummary": { "type": "object" },
          "authorizationPredicates": {
            "oneOf": [
              { "const": "opaque" },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "table"],
                  "properties": {
                    "kind": { "enum": ["filter", "membership"] },
                    "table": { "type": "string" },
                    "field": { "type": "string" },
                    "operator": { "type": "string" },
                    "input": {},
                    "declaration": { "type": "string" },
                    "resource": { "type": "object" },
                    "roles": { "type": ["array", "null"], "items": { "type": "string" }, "uniqueItems": true }
                  },
                  "additionalProperties": false
                }
              }
            ]
          },
          "effectCeiling": { "type": "object" },
          "standardPattern": { "type": ["object", "string", "null"] },
          "effectiveTablePolicies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["table", "surface", "origin", "composition", "policy"],
              "properties": {
                "table": { "type": "string" },
                "surface": { "enum": ["host-plan.single-table", "handler.ctx.db"] },
                "origin": { "enum": ["declared", "legacy-default"] },
                "composition": { "enum": ["schema-rederived", "ordinary-default"] },
                "policy": { "$ref": "#/$defs/tablePolicy" }
              },
              "additionalProperties": false
            }
          },
          "uncomposedReadSurfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["surface", "table", "declaredPolicy", "analysisLimit"],
              "properties": {
                "surface": { "type": "string" },
                "table": { "type": "string" },
                "declaredPolicy": { "$ref": "#/$defs/tablePolicy" },
                "analysisLimit": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "elevatedDatabase": {
            "type": "object",
            "required": ["available", "captureCompleteness", "uses"],
            "properties": {
              "available": { "type": "boolean" },
              "captureCompleteness": { "enum": ["direct-static-sites-in-admitted-handler-graph", "direct-static-sites-in-selected-module-handler", "not-applicable"] },
              "uses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["member", "table", "source", "capture"],
                  "properties": {
                    "member": { "enum": ["query", "get", "getMany", "uniqueMany"] },
                    "table": { "type": ["string", "null"] },
                    "source": {
                      "type": ["object", "null"],
                      "properties": {
                        "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 }, "column": { "type": "integer", "minimum": 1 }
                      },
                      "required": ["path", "line", "column"],
                      "additionalProperties": false
                    },
                    "capture": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "authorityProfileIdentities": {
            "type": "array",
            "items": { "$ref": "#/$defs/profileIdentity" }
          },
          "fieldBoundary": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["enforcement", "fields", "condition"],
                "properties": {
                  "enforcement": { "const": "handler-residual" },
                  "fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "condition": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          },
          "maskedFieldUses": { "type": "array", "maxItems": 0 }
        },
        "additionalProperties": false
      }
    },
    "tablePolicies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "origin", "policy"],
        "properties": {
          "table": { "type": "string" },
          "origin": { "enum": ["declared", "legacy-default"] },
          "policy": { "$ref": "#/$defs/tablePolicy" }
        },
        "additionalProperties": false
      }
    },
    "authorizationTables": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "id", "table", "definition"],
            "properties": {
              "kind": { "const": "membership" }, "id": { "type": "string" },
              "table": { "type": "string" }, "definition": { "type": "object" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "id", "table", "fields"],
            "properties": {
              "kind": { "const": "permission-backing" }, "id": { "type": "string" },
              "table": { "type": "string" },
              "fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "authorityProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "generation", "roleLattice"],
        "properties": {
          "id": { "type": "string" },
          "generation": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "roleLattice": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "implies"],
              "properties": {
                "role": { "type": "string" },
                "implies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "sectionSchemas": {
      "type": "object",
      "required": ["fieldPolicies", "maskedFieldUses", "tablePolicyTransitions", "visibilityOverrides", "writePolicyChecks"],
      "properties": {
        "fieldPolicies": { "const": "snapback.authorization-review.field-policies.reserved.v1" },
        "maskedFieldUses": { "const": "snapback.authorization-review.masked-field-uses.reserved.v1" },
        "tablePolicyTransitions": { "const": "snapback.authorization-review.table-policy-transitions.v1" },
        "visibilityOverrides": { "const": "snapback.authorization-review.visibility-overrides.v1" },
        "writePolicyChecks": { "const": "snapback.authorization-review.write-policy-checks.v2" }
      },
      "additionalProperties": false
    },
    "fieldPolicies": { "type": "array", "maxItems": 0 },
    "visibilityOverrides": { "type": "array", "items": { "type": "object" } },
    "tablePolicyTransitions": { "type": "array", "items": { "type": "object" } },
    "quarantines": { "type": "array", "items": { "type": "object" } },
    "elevatedReadSites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "readForm", "siteEvidence", "tables", "capabilityId", "capabilityDigest"],
        "properties": {
          "operation": { "type": "string", "minLength": 1 },
          "readForm": { "enum": ["get", "getMany", "uniqueMany", "query"] },
          "siteEvidence": { "enum": ["static-inline", "opaque-module"] },
          "sourcePath": { "type": "string" },
          "sourceSpanId": { "type": "string" },
          "modulePath": { "type": "string" },
          "moduleDigest": { "type": "string" },
          "declaredForm": { "type": "string" },
          "tables": { "oneOf": [{ "const": "opaque" }, { "type": "array", "items": { "type": "string" }, "uniqueItems": true }] },
          "capabilityId": { "type": "string", "minLength": 1 },
          "capabilityDigest": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "writePolicyChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/writePolicyCheck" }
    }
  },
  "$defs": {
    "writePolicyCheck": {
      "type": "object",
      "required": [
        "id", "siteId", "siteResolution", "operation", "runtimeClass", "surface",
        "writeForm", "writeFormCeiling", "table", "tableResolution",
        "declaredTableCeiling", "policyKind", "policyDigest", "declarationOrigin",
        "ownerField", "ownerFieldResolution", "genericWriteDisposition",
        "principalSource", "ownerInputDisposition", "preflightChecks",
        "authoritativeChecks", "absentDisposition", "absentDispositionDigest",
        "uniqueConflictDisposition", "authorityTableClass", "writeElevation",
        "resultEgress", "sourceEvidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "siteId": { "type": ["string", "null"] },
        "siteResolution": { "enum": ["exact-static", "exact-plan-step", "runtime-ceiling-member", "opaque-module", "migration-pending-declared-write-set"] },
        "operation": { "type": "string", "minLength": 1 },
        "runtimeClass": { "enum": ["javascript-handler", "host-plan"] },
        "surface": { "enum": ["ctx-db", "host-plan"] },
        "writeForm": { "enum": ["insert", "insert-each", "patch", "delete", "delete-where", "opaque"] },
        "writeFormCeiling": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "enum": ["insert", "patch", "delete"] }, "uniqueItems": true }
          ]
        },
        "table": { "type": ["string", "null"] },
        "tableResolution": { "enum": ["exact", "runtime-ceiling-member", "opaque-module"] },
        "declaredTableCeiling": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          ]
        },
        "policyKind": { "enum": ["owner", "public-read", "membership", "any-of", "undeclared", "runtime-resolved"] },
        "policyDigest": { "type": ["string", "null"] },
        "declarationOrigin": { "enum": ["declared", "legacy-default", "runtime-resolved"] },
        "ownerField": { "type": ["string", "null"] },
        "ownerFieldResolution": { "enum": ["exact", "not-applicable", "runtime-resolved"] },
        "genericWriteDisposition": { "enum": ["owner-policy", "generic-refused", "migration-pending", "legacy-undeclared", "runtime-resolved"] },
        "principalSource": { "enum": ["auth.userId", "none", "not-applicable", "runtime-resolved"] },
        "ownerInputDisposition": { "enum": ["host-stamped", "sealed-auth-user-id-marker", "refused", "not-applicable", "runtime-resolved"] },
        "preflightChecks": { "type": "array", "items": { "type": "string" } },
        "authoritativeChecks": { "type": "array", "items": { "type": "string" } },
        "absentDisposition": { "enum": ["ctx-db-false", "host-plan-no-effect", "declared-refusal", "not-applicable", "runtime-resolved"] },
        "absentDispositionDigest": { "type": ["string", "null"] },
        "uniqueConflictDisposition": {
          "type": "object",
          "required": ["kind", "constraints"],
          "properties": {
            "kind": { "enum": ["owner-partitioned", "declared-disclosure", "not-applicable", "runtime-resolved"] },
            "constraints": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "authorityTableClass": { "enum": ["ordinary", "membership", "permission-backing", "runtime-resolved"] },
        "writeElevation": { "const": "unavailable" },
        "resultEgress": { "const": "separate-phase-not-covered" },
        "sourceEvidence": { "type": "object" }
      },
      "additionalProperties": false
    },
    "profileIdentity": {
      "type": "object",
      "required": ["id", "generation"],
      "properties": {
        "id": { "type": "string" },
        "generation": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "tablePolicy": {
      "oneOf": [
        {
          "type": "object", "required": ["kind"],
          "properties": { "kind": { "const": "public-read" } }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["kind", "field"],
          "properties": { "kind": { "const": "owner" }, "field": { "type": "string" } }, "additionalProperties": false
        },
        {
          "type": "object", "required": ["kind", "declaration", "resourceField"],
          "properties": {
            "kind": { "const": "membership" }, "declaration": { "type": "string" },
            "resourceField": { "type": "string" }, "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["kind", "arms"],
          "properties": {
            "kind": { "const": "any-of" }, "arms": { "type": "array", "items": { "$ref": "#/$defs/tablePolicy" } }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
