{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/client-lifecycle/v1.schema.json",
  "$comment": "@ref LLP 0247#d5-generated-lifecycle-metadata-owns-normalization-and-failure-tables — origin schema; LLP 0238 D7 may extend this artifact later.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "appId",
    "inputsHash",
    "authoredSourceHash",
    "targetProfile",
    "custody",
    "surfaceFamilies",
    "referenceKinds",
    "handleStates",
    "mutationSettlement",
    "resourceIdentity",
    "diagnostics",
    "compatibilityAliases",
    "futureClassM",
    "operations",
    "commands",
    "rows"
  ],
  "properties": {
    "artifactKind": { "const": "clientLifecycleManifest" },
    "schemaVersion": { "const": "snapback.client-lifecycle.v1" },
    "appId": { "type": "string", "minLength": 1 },
    "inputsHash": { "type": "string", "minLength": 1 },
    "authoredSourceHash": { "type": "string", "minLength": 1 },
    "targetProfile": { "type": "string", "minLength": 1 },
    "custody": { "$ref": "#/$defs/custody" },
    "surfaceFamilies": {
      "type": "array",
      "items": { "enum": ["query", "liveQuery", "mutate", "action", "commands"] },
      "uniqueItems": true
    },
    "referenceKinds": { "type": "array", "items": { "$ref": "#/$defs/referenceKind" } },
    "handleStates": { "$ref": "#/$defs/handleStates" },
    "mutationSettlement": { "$ref": "#/$defs/mutationSettlement" },
    "resourceIdentity": { "$ref": "#/$defs/resourceIdentity" },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/lifecycleDiagnostic" } },
    "compatibilityAliases": { "type": "array", "items": { "$ref": "#/$defs/compatibilityAlias" } },
    "futureClassM": { "$ref": "#/$defs/futureClassM" },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argumentNormalization",
        "authBootstrapPolicy",
        "authBootstrapState",
        "authCustodyPlatforms",
        "authEntryMechanisms",
        "authOwnership",
        "authRecoveryLifecycle",
        "authSupervisedPrecedence",
        "authAnchors",
        "authorityAdmission",
        "presenceLifecycle",
        "primaryFailureCarrier",
        "anchors"
      ],
      "properties": {
        "authBootstrapPolicy": { "$ref": "#/$defs/authBootstrapPolicy" },
        "authBootstrapState": { "$ref": "#/$defs/authBootstrapState" },
        "authCustodyPlatforms": { "$ref": "#/$defs/authCustodyPlatforms" },
        "authEntryMechanisms": { "$ref": "#/$defs/authEntryMechanisms" },
        "authOwnership": { "$ref": "#/$defs/authOwnership" },
        "authRecoveryLifecycle": { "$ref": "#/$defs/authRecoveryLifecycle" },
        "authSupervisedPrecedence": { "$ref": "#/$defs/authSupervisedPrecedence" },
        "authAnchors": { "$ref": "#/$defs/authAnchors" },
        "argumentNormalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "operations"],
          "properties": {
            "version": { "const": "snapback.argument-normalization.v1" },
            "operations": {
              "type": "array",
              "items": { "$ref": "#/$defs/operationNormalization" }
            }
          }
        },
        "authorityAdmission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations"],
          "properties": {
            "operations": {
              "type": "array",
              "items": { "$ref": "#/$defs/authorityOperation" }
            }
          }
        },
        "presenceLifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stopAction",
            "disposeAction",
            "neverPublishedAction",
            "authorityLossBarrierOwner",
            "collections"
          ],
          "properties": {
            "stopAction": { "const": "fenced-withdrawal" },
            "disposeAction": { "const": "fenced-withdrawal" },
            "neverPublishedAction": { "const": "none" },
            "authorityLossBarrierOwner": { "const": "server-connection-cleanup" },
            "collections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["collection", "withdrawalVisibilityDeadlineMs"],
                "properties": {
                  "collection": { "type": "string", "minLength": 1 },
                  "withdrawalVisibilityDeadlineMs": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "primaryFailureCarrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicErrorType", "verbs"],
          "properties": {
            "publicErrorType": { "const": "SnapbackDiagnosticError" },
            "verbs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["verb", "operationKind", "carrier"],
                "properties": {
                  "verb": { "type": "string", "minLength": 1 },
                  "operationKind": { "enum": ["Query", "LiveQuery", "Mutation", "Action"] },
                  "carrier": {
                    "enum": [
                      "throw",
                      "throw-immediate",
                      "raw-envelope-deprecated",
                      "resolved-queued-union"
                    ]
                  }
                }
              }
            }
          }
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guide", "diagnostics"],
          "properties": {
            "guide": { "$ref": "#/$defs/stringList" },
            "diagnostics": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    }
  },
  "$defs": {
    "authBootstrapPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "fields", "sourceFields", "profiles"],
      "properties": {
        "configured": { "type": "boolean" },
        "fields": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "derivation", "semanticIdentityEffect", "familiarDisposition", "value"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "derivation": { "type": "string", "minLength": 1 },
              "semanticIdentityEffect": { "type": "string", "minLength": 1 },
              "familiarDisposition": { "$ref": "#/$defs/familiarDisposition" },
              "value": true
            }
          }
        },
        "sourceFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "disposition", "bootstrapProjection", "semanticIdentityEffect", "familiarDisposition"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "disposition": { "type": "string", "minLength": 1 },
              "bootstrapProjection": { "$ref": "#/$defs/stringList" },
              "semanticIdentityEffect": { "const": "included-in-normalized-auth-program" },
              "familiarDisposition": { "$ref": "#/$defs/familiarDisposition" }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "selected", "disposition"],
            "properties": {
              "profile": { "enum": ["snapback-explicit-v1", "snapback-familiar-ts-v1"] },
              "selected": { "type": "boolean" },
              "disposition": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "authMethodOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "clientMethod",
        "clientNamespaceMethod",
        "applicationFacadeMethod",
        "facadeOwner",
        "facadeMethod",
        "predecessor",
        "resultType",
        "recoveryProjection"
      ],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "clientMethod": { "type": "string", "minLength": 1 },
        "clientNamespaceMethod": { "type": ["string", "null"] },
        "applicationFacadeMethod": { "type": ["string", "null"] },
        "facadeOwner": { "type": ["string", "null"] },
        "facadeMethod": { "type": ["string", "null"] },
        "predecessor": { "type": "string", "minLength": 1 },
        "resultType": { "type": "string", "minLength": 1 },
        "recoveryProjection": { "enum": ["none", "one-time-response"] },
        "collisionContract": { "type": "string", "minLength": 1 },
        "facadeDisposition": { "type": "string", "minLength": 1 },
        "targetCapability": { "type": "string", "minLength": 1 }
      }
    },
    "authEntryMechanisms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMechanisms", "entries"],
      "properties": {
        "sourceMechanisms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "entryMechanism", "disposition"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "entryMechanism": { "type": ["string", "null"] },
              "disposition": { "type": "string", "minLength": 1 }
            }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "configured", "phase", "targetCapability", "reactHook", "familiarHook", "operations"],
            "properties": {
              "mechanism": { "type": "string", "minLength": 1 },
              "configured": { "type": "boolean" },
              "phase": { "type": "string", "minLength": 1 },
              "targetCapability": { "type": ["string", "null"] },
              "reactHook": { "type": ["string", "null"] },
              "familiarHook": { "type": ["string", "null"] },
              "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authMethodOperation" } }
            }
          }
        }
      }
    },
    "authRecoveryLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceField", "policy", "operations"],
      "properties": {
        "sourceField": { "const": "recoveryPolicy" },
        "policy": { "type": ["object", "null"] },
        "operations": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/authMethodOperation" },
              {
                "type": "object",
                "required": ["facadeDisposition", "targetCapability"],
                "properties": {
                  "facadeDisposition": { "type": "string", "minLength": 1 },
                  "targetCapability": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "authCustodyPlatforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPolicy", "platforms"],
      "properties": {
        "selectedPolicy": { "type": ["string", "null"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "runtimePlatformKind", "adapter", "carriers", "grade", "policy", "disposition", "refusalCode"],
            "properties": {
              "platform": { "type": "string", "minLength": 1 },
              "runtimePlatformKind": { "type": ["string", "null"] },
              "adapter": { "type": "string", "minLength": 1 },
              "carriers": { "$ref": "#/$defs/stringList" },
              "grade": { "type": "string", "minLength": 1 },
              "policy": { "type": "string", "minLength": 1 },
              "disposition": { "type": "string", "minLength": 1 },
              "refusalCode": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "authBootstrapState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "states", "advisories", "diagnostics", "remediations"],
      "properties": {
        "stages": { "$ref": "#/$defs/stringList" },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "fields"],
            "properties": {
              "status": { "enum": ["starting", "ready", "authority-required", "blocked", "unsupported", "error"] },
              "fields": { "$ref": "#/$defs/stringList" }
            }
          }
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["diagnosticCode", "state", "authorityEffect"],
            "properties": {
              "diagnosticCode": { "const": "SNAPBACK_AUTH_SUPERVISED_PRINCIPAL_CONFLICT" },
              "state": { "const": "ready" },
              "authorityEffect": { "const": "non-authoritative" }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "state", "remediations", "codes"],
            "properties": {
              "class": { "type": "string", "minLength": 1 },
              "state": { "enum": ["ready", "authority-required", "blocked", "unsupported", "error"] },
              "remediations": { "$ref": "#/$defs/stringList" },
              "codes": { "$ref": "#/$defs/stringList" }
            }
          }
        },
        "remediations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/authRemediation" }
        }
      }
    },
    "authOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinaryOwner", "ordinaryForms", "advancedForms", "exclusive", "duplicateRefusalCode", "sameOwnerKeyDisposition", "conflictingOwnerKeyDisposition"],
      "properties": {
        "ordinaryOwner": { "const": "createSnapbackAppClient" },
        "ordinaryForms": { "$ref": "#/$defs/stringList" },
        "advancedForms": { "$ref": "#/$defs/stringList" },
        "exclusive": { "const": true },
        "duplicateRefusalCode": { "const": "SNAPBACK_AUTH_BOOTSTRAP_INPUT_INVALID" },
        "sameOwnerKeyDisposition": { "type": "string", "minLength": 1 },
        "conflictingOwnerKeyDisposition": { "type": "string", "minLength": 1 }
      }
    },
    "authSupervisedPrecedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "events", "replacementRule", "protectedRule", "midEntryRule", "conflictDiagnostic", "conflictState"],
      "properties": {
        "order": { "$ref": "#/$defs/stringList" },
        "events": { "$ref": "#/$defs/stringList" },
        "replacementRule": { "type": "string", "minLength": 1 },
        "protectedRule": { "type": "string", "minLength": 1 },
        "midEntryRule": { "type": "string", "minLength": 1 },
        "conflictDiagnostic": { "const": "SNAPBACK_AUTH_SUPERVISED_PRINCIPAL_CONFLICT" },
        "conflictState": { "const": "ready-advisory" }
      }
    },
    "authAnchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityIndex", "guide"],
      "properties": {
        "capabilityIndex": { "$ref": "#/$defs/stringList" },
        "guide": { "$ref": "#/$defs/stringList" }
      }
    },
    "familiarDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "route"],
      "properties": {
        "disposition": { "type": "integer", "minimum": 1, "maximum": 4 },
        "route": { "type": "string", "minLength": 1 }
      }
    },
    "authRemediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "publicType", "riskClass", "machineApplicable", "requiresApproval", "authorityEffect"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "publicType": { "const": "SnapbackAuthRemediation" },
        "riskClass": { "type": "string", "minLength": 1 },
        "machineApplicable": {
          "oneOf": [
            { "type": "boolean" },
            { "const": "context-dependent" }
          ]
        },
        "requiresApproval": { "type": "boolean" },
        "authorityEffect": { "type": "string", "minLength": 1 }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "storageClass", "committedProjectionRequired", "rationale"],
      "properties": {
        "consumer": { "const": "developer-tooling" },
        "storageClass": { "const": "regenerable-cache" },
        "committedProjectionRequired": { "const": false },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "referenceKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "runtimeDiscriminant", "acceptedBy", "correctVerb", "auth",
        "freshness", "retention", "stateCarrier", "guideAnchor"
      ],
      "properties": {
        "kind": { "enum": ["Query", "LiveQuery", "Mutation", "Action", "Command"] },
        "runtimeDiscriminant": { "type": "string", "minLength": 1 },
        "acceptedBy": { "$ref": "#/$defs/stringList" },
        "correctVerb": { "type": "string", "minLength": 1 },
        "auth": { "type": "string", "minLength": 1 },
        "freshness": { "type": "string", "minLength": 1 },
        "retention": { "type": "string", "minLength": 1 },
        "stateCarrier": { "type": "string", "minLength": 1 },
        "guideAnchor": { "type": "string", "minLength": 1 }
      }
    },
    "handleStates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveQueryHandle", "commandTask"],
      "properties": {
        "liveQueryHandle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nonterminalConnection", "terminalConnection", "disposalMeaning"],
          "properties": {
            "nonterminalConnection": { "$ref": "#/$defs/stringList" },
            "terminalConnection": { "$ref": "#/$defs/stringList" },
            "disposalMeaning": { "type": "string", "minLength": 1 }
          }
        },
        "commandTask": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nonterminal", "terminal"],
          "properties": {
            "nonterminal": { "$ref": "#/$defs/stringList" },
            "terminal": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    },
    "mutationSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispositions", "dispatch", "settlement", "terminal", "nonterminal"],
      "properties": {
        "dispositions": { "$ref": "#/$defs/stringList" },
        "dispatch": { "type": "string", "minLength": 1 },
        "settlement": { "type": "string", "minLength": 1 },
        "terminal": { "$ref": "#/$defs/stringList" },
        "nonterminal": { "$ref": "#/$defs/stringList" }
      }
    },
    "resourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ingredients"],
      "properties": {
        "version": { "const": "snapback.client-resource-key.v1" },
        "ingredients": { "$ref": "#/$defs/stringList" }
      }
    },
    "lifecycleDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "receivedField", "acceptedField", "remediationField", "guideAnchor"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "receivedField": { "type": "string", "minLength": 1 },
        "acceptedField": { "type": "string", "minLength": 1 },
        "remediationField": { "type": "string", "minLength": 1 },
        "guideAnchor": { "type": "string", "minLength": 1 }
      }
    },
    "compatibilityAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "plannedCanonical", "emittedInRollout1", "removalEpoch"],
      "properties": {
        "current": { "type": "string", "minLength": 1 },
        "plannedCanonical": { "type": "string", "minLength": 1 },
        "emittedInRollout1": { "type": "boolean" },
        "removalEpoch": { "type": "string", "minLength": 1 }
      }
    },
    "futureClassM": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shippedInRollout1", "snapshotVersionMeaning", "forbiddenMeaning", "note"],
      "properties": {
        "shippedInRollout1": { "type": "boolean" },
        "snapshotVersionMeaning": { "type": "string", "minLength": 1 },
        "forbiddenMeaning": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticIdentity", "name", "kind", "runtimeDiscriminant", "implementationHash",
        "argsContractHash", "resultContractHash", "authRequirement", "requiredCapabilities",
        "legalVerbs", "correctVerb", "freshness", "retention", "delivery", "states", "guideAnchor"
      ],
      "properties": {
        "semanticIdentity": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["Query", "LiveQuery", "Mutation", "Action"] },
        "runtimeDiscriminant": { "type": "string", "minLength": 1 },
        "implementationHash": { "type": "string", "minLength": 1 },
        "argsContractHash": { "type": "string", "minLength": 1 },
        "resultContractHash": { "type": "string", "minLength": 1 },
        "authRequirement": { "type": "string", "minLength": 1 },
        "requiredCapabilities": { "$ref": "#/$defs/stringList" },
        "legalVerbs": { "$ref": "#/$defs/stringList" },
        "correctVerb": { "type": "string", "minLength": 1 },
        "freshness": { "type": "string", "minLength": 1 },
        "retention": { "type": "string", "minLength": 1 },
        "delivery": { "enum": ["read", "live", "mutation", "action"] },
        "states": { "$ref": "#/$defs/stringList" },
        "guideAnchor": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticIdentity", "name", "kind", "runtimeDiscriminant", "mutationIdentity",
        "implementationHash", "authRequirement", "requiredCapabilities", "legalVerbs",
        "correctVerb", "freshness", "retention", "states", "guideAnchor"
      ],
      "properties": {
        "semanticIdentity": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "const": "Command" },
        "runtimeDiscriminant": { "const": "asset-bearing-command.v1" },
        "mutationIdentity": { "type": ["string", "null"] },
        "implementationHash": { "type": ["string", "null"] },
        "authRequirement": { "type": "string", "minLength": 1 },
        "requiredCapabilities": { "$ref": "#/$defs/stringList" },
        "legalVerbs": { "$ref": "#/$defs/stringList" },
        "correctVerb": { "type": "string", "minLength": 1 },
        "freshness": { "type": "string", "minLength": 1 },
        "retention": { "type": "string", "minLength": 1 },
        "states": { "$ref": "#/$defs/stringList" },
        "guideAnchor": { "type": "string", "minLength": 1 }
      }
    },
    "functionIdentity": {
      "type": "object",
      "required": ["functionId", "name", "kind", "verb"],
      "properties": {
        "functionId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["Query", "LiveQuery", "Mutation", "Action"] },
        "verb": { "enum": ["query", "liveQuery", "mutate", "run"] }
      }
    },
    "operationNormalization": {
      "allOf": [
        { "$ref": "#/$defs/functionIdentity" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["functionId", "name", "kind", "verb", "optionalPropertyPaths"],
          "properties": {
            "functionId": true,
            "name": true,
            "kind": true,
            "verb": true,
            "optionalPropertyPaths": { "$ref": "#/$defs/stringList" }
          }
        }
      ]
    },
    "authorityOperation": {
      "allOf": [
        { "$ref": "#/$defs/functionIdentity" },
        {
