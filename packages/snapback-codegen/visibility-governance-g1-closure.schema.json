{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/visibility-governance-g1-closure.v1.json",
  "title": "Snapback one-time visibility governance G1/G2 closure receipt v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "closureId",
    "predecessorOid",
    "phases",
    "approvedBy",
    "approvedOn",
    "ruling",
    "codegenSourceDigest",
    "completionTestSourceDigest",
    "backends",
    "publicTables",
    "sourceRevisionDigest",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "snapback.visibility-governance-g1-closure.v1" },
    "closureId": { "type": "string", "minLength": 1 },
    "predecessorOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "phases": {
      "type": "array",
      "prefixItems": [{ "const": "G1" }, { "const": "G2" }],
      "minItems": 2,
      "maxItems": 2
    },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "ruling": { "type": "string", "minLength": 1 },
    "codegenSourceDigest": { "$ref": "#/$defs/digest" },
    "completionTestSourceDigest": { "$ref": "#/$defs/digest" },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "backendPath",
          "authorizationReviewInputsHash",
          "ownerMapDigest",
          "policyBaselineDigest",
          "transitionLedgerDigest"
        ],
        "properties": {
          "backendPath": { "type": "string", "minLength": 1 },
          "authorizationReviewInputsHash": { "type": "string", "minLength": 1 },
          "ownerMapDigest": { "$ref": "#/$defs/digest" },
          "policyBaselineDigest": { "$ref": "#/$defs/digest" },
          "transitionLedgerDigest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "publicTables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backendPath", "tableId", "policyDigest"],
        "properties": {
          "backendPath": { "type": "string", "minLength": 1 },
          "tableId": { "type": "string", "minLength": 1 },
          "policyDigest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "sourceRevisionDigest": { "$ref": "#/$defs/digest" },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
