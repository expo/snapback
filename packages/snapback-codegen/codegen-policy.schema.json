{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/codegen-policy.v1.json",
  "title": "Snapback codegen custody policy",
  "type": "object",
  "required": ["schemaVersion", "committedProjections"],
  "properties": {
    "schemaVersion": { "const": "snapback.codegen-policy.v1" },
    "committedProjections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*\\\\).+$"
      }
    },
    "authoringProfile": {
      "enum": ["snapback-explicit-v1", "snapback-familiar-ts-v1"],
      "description": "Select the source adapter; omission resolves to snapback-explicit-v1."
    },
    "contractMetadata": {
      "const": "exact",
      "description": "Emit Exact-dependent .contract-meta.ts sidecars in addition to Contract-neutral bindings."
    },
    "hostedDevelopmentTargets": {
      "type": "array",
      "uniqueItems": true,
      "description": "Closed hosted HTTPS origins and their already-admitted receipt identities. Codegen derives the application identity tuple and emits the immutable client admission record.",
      "items": {
        "type": "object",
        "required": ["origin", "hostedTargetReceipt"],
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^https://[^/]+$"
          },
          "hostedTargetReceipt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
