{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/table-visibility-policy-transition-ledger.v1.json",
  "title": "Snapback append-only table policy transition ledger v1",
  "type": "object",
  "required": ["schemaVersion", "nodes", "heads", "ledgerDigest"],
  "properties": {
    "schemaVersion": { "const": "snapback.table-visibility-policy-transition-ledger.v1" },
    "nodes": { "type": "array", "items": { "$ref": "table-visibility-policy-transition.v1.json" } },
    "heads": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "ledgerDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
