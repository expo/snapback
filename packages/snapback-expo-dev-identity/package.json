{
  "name": "@expo/snapback-expo-dev-identity",
  "version": "0.1.0",
  "description": "First-party native launch checkout reader for supervised Snapback Expo development clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/snapback.git",
    "directory": "packages/snapback-expo-dev-identity"
  },
  "homepage": "https://github.com/expo/snapback#readme",
  "bugs": {
    "url": "https://github.com/expo/snapback/issues"
  },
  "keywords": ["snapback", "expo", "react-native", "development-client"],
  "main": "index.mjs",
  "types": "index.d.mts",
  "files": [
    "README.md",
    "index.d.mts",
    "index.mjs",
    "install-core.mjs",
    "install.d.mts",
    "install.mjs",
    "install.native.mjs",
    "app.plugin.js",
    "config-plugin.cjs",
    "config-plugin.d.mts",
    "expo-module.config.json",
    "ios",
    "android"
  ],
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./install": {
      "types": "./install.d.mts",
      "browser": "./install.mjs",
      "react-native": "./install.native.mjs",
      "import": "./install.mjs",
      "default": "./install.mjs"
    },
    "./app.plugin": {
      "types": "./config-plugin.d.mts",
      "require": "./app.plugin.js",
      "default": "./app.plugin.js"
    },
    "./config-plugin": {
      "types": "./config-plugin.d.mts",
      "require": "./config-plugin.cjs",
      "default": "./config-plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "expo": ">=57.0.0 <58.0.0",
    "react-native": ">=0.86.0 <0.87.0"
  },
  "peerDependenciesMeta": {
    "expo": { "optional": true },
    "react-native": { "optional": true }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node install.test.mjs && node config-plugin.test.mjs"
  }
}
