{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/publication-authority-transition-receipt.v2.json",
  "title": "PublicationAuthorityTransitionReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityInstallationId",
    "authorityOrigin",
    "signingKeyId",
    "authorityGeneration",
    "operationId",
    "publicationEpoch",
    "publisherInstanceId",
    "leaseSha256",
    "outcome",
    "publicationLedgerSha256",
    "vectorSha256",
    "closed",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "snapback.publication-authority-transition-receipt.v2"
    },
    "authorityInstallationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,160}$"
    },
    "authorityOrigin": {
      "oneOf": [
        { "type": "string", "pattern": "^https://[^/@?#]+$" },
        {
          "type": "string",
          "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::\\d+)?$"
        }
      ]
    },
    "signingKeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorityGeneration": { "type": "integer", "minimum": 1 },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$" },
    "publicationEpoch": { "type": "integer", "minimum": 1 },
    "publisherInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,160}$"
    },
    "leaseSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["acquired", "promoted", "rolled-back"] },
    "publicationLedgerSha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "vectorSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "closed": { "type": "boolean" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "acquired" } } },
      "then": {
        "properties": {
          "closed": { "const": false },
          "publicationLedgerSha256": { "type": "null" }
        }
      },
      "else": {
        "properties": { "closed": { "const": true } }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "promoted" } } },
      "then": {
        "properties": {
          "publicationLedgerSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": { "publicationLedgerSha256": { "type": "null" } }
      }
    }
  ]
}
