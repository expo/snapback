{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/publication-authority-error.v1.json",
  "title": "PublicationAuthorityErrorV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "code", "message"],
  "properties": {
    "schemaVersion": { "const": "snapback.publication-authority-error.v1" },
    "code": {
      "type": "string",
      "pattern": "^SNAPBACK_PUBLICATION_[A-Z0-9_]+$"
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
