{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/authorized-publication-lease.v4.json",
  "title": "AuthorizedPublicationLeaseV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityInstallationId",
    "authorityOrigin",
    "signingKeyId",
    "operationId",
    "publisherInstanceId",
    "publicationEpoch",
    "candidateLedgerSha256",
    "candidateTag",
    "defaultTag",
    "priorDefaultClosureReceiptSha256",
    "issuedAt",
    "expiresAt",
    "packages",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "snapback.authorized-publication-lease.v4" },
    "authorityInstallationId": { "$ref": "#/$defs/id" },
    "authorityOrigin": {
      "oneOf": [
        { "type": "string", "pattern": "^https://[^/@?#]+$" },
        {
          "type": "string",
          "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::\\d+)?$"
        }
      ]
    },
    "signingKeyId": { "$ref": "#/$defs/sha256" },
    "operationId": { "$ref": "#/$defs/id" },
    "publisherInstanceId": { "$ref": "#/$defs/id" },
    "publicationEpoch": { "type": "integer", "minimum": 1 },
    "candidateLedgerSha256": { "$ref": "#/$defs/sha256" },
    "candidateTag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,159}$" },
    "defaultTag": { "const": "latest" },
    "priorDefaultClosureReceiptSha256": { "$ref": "#/$defs/sha256" },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "packages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-runtime-darwin-arm64" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-runtime-linux-x64" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-contract" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-client" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-codegen" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-vite" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-react" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-expo" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-app-cli" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "@expo/snapback-cli" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/package" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "create-snapback-app" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expectedPriorVersion", "newVersion"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?:@expo/snapback(?:-[a-z0-9-]+)?|create-snapback-app)$"
        },
        "expectedPriorVersion": {
          "oneOf": [{ "$ref": "#/$defs/semver" }, { "type": "null" }]
        },
        "newVersion": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
