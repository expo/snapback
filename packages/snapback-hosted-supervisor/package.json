{
  "name": "@expo/snapback-hosted-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fail-closed single-writer supervisor for Snapback hosted targets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/snapback.git",
    "directory": "packages/snapback-hosted-supervisor"
  },
  "homepage": "https://github.com/expo/snapback#readme",
  "bugs": {
    "url": "https://github.com/expo/snapback/issues"
  },
  "keywords": ["snapback", "backend", "hosting", "supervisor"],
  "files": [
    "bootstrap.mjs",
    "cli.mjs",
    "Dockerfile",
    "fly.supervisor.toml",
    "service.mjs",
    "external-store.mjs",
    "hosted-edge-admission.mjs",
    "internal/",
    "index.d.mts",
    "index.mjs",
    "operator-authority.d.mts",
    "operator-authority.mjs",
    "operator-authority-transaction.d.mts",
    "operator-authority-transaction.mjs",
    "operator-service.d.mts",
    "operator-service.mjs",
    "provider-credentials.d.mts",
    "provider-credentials.mjs",
    "provider-executor.d.mts",
    "provider-executor.mjs",
    "supervisor-response.d.mts",
    "supervisor-response.mjs",
    "target-onboarding.d.mts",
    "target-onboarding.mjs"
  ],
  "bin": {
    "snapback-hosted-supervisor": "./cli.mjs",
    "snapback-hosted-supervisor-bootstrap": "./bootstrap.mjs",
    "snapback-hosted-target-onboarding": "./target-onboarding.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./operator-authority": {
      "types": "./operator-authority.d.mts",
      "default": "./operator-authority.mjs"
    },
    "./operator-authority-transaction": {
      "types": "./operator-authority-transaction.d.mts",
      "default": "./operator-authority-transaction.mjs"
    },
    "./operator-service": {
      "types": "./operator-service.d.mts",
      "default": "./operator-service.mjs"
    },
    "./provider-credentials": {
      "types": "./provider-credentials.d.mts",
      "default": "./provider-credentials.mjs"
    },
    "./provider-executor": {
      "types": "./provider-executor.d.mts",
      "default": "./provider-executor.mjs"
    },
    "./supervisor-response": {
      "types": "./supervisor-response.d.mts",
      "default": "./supervisor-response.mjs"
    },
    "./target-onboarding": {
      "types": "./target-onboarding.d.mts",
      "default": "./target-onboarding.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node index.test.mjs && node operator-authority.test.mjs && node operator-authority-transaction.test.mjs && node supervisor-response.test.mjs && node provider-credentials.test.mjs && node provider-executor.test.mjs && node operator-service.test.mjs && node external-store.test.mjs && node bootstrap.test.mjs && node hosted-edge-admission.test.mjs && node target-onboarding.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "3.1096.0",
    "@aws-sdk/client-s3": "3.1096.0"
  }
}
