{
  "name": "@snapback/hosted-supervisor",
  "version": "0.1.0",
  "type": "module",
  "description": "Fail-closed single-writer supervisor for Snapback hosted targets.",
  "files": [
    "bootstrap.mjs",
    "cli.mjs",
    "Dockerfile",
    "fly.supervisor.toml",
    "service.mjs",
    "external-store.mjs",
    "hosted-edge-admission.mjs",
    "index.mjs",
    "target-onboarding.mjs"
  ],
  "bin": {
    "snapback-hosted-supervisor": "./cli.mjs",
    "snapback-hosted-supervisor-bootstrap": "./bootstrap.mjs",
    "snapback-hosted-target-onboarding": "./target-onboarding.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./target-onboarding": "./target-onboarding.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node index.test.mjs && node external-store.test.mjs && node bootstrap.test.mjs && node hosted-edge-admission.test.mjs && node target-onboarding.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "3.1096.0",
    "@aws-sdk/client-s3": "3.1096.0"
  }
}
