{
  "name": "@expo/snapback",
  "version": "0.1.0",
  "type": "module",
  "description": "Experimental familiar authoring entrypoints for Snapback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/snapback.git",
    "directory": "packages/snapback-umbrella"
  },
  "homepage": "https://github.com/expo/snapback#readme",
  "bugs": {
    "url": "https://github.com/expo/snapback/issues"
  },
  "keywords": ["snapback", "backend", "experimental", "react"],
  "files": [
    "README.md",
    "data.d.mts",
    "data.mjs",
    "react.d.mts",
    "react-data.d.mts",
    "react-data.mjs",
    "react.mjs",
    "server.d.mts",
    "server.mjs",
    "values.d.mts",
    "values.mjs"
  ],
  "exports": {
    "./server": {
      "types": "./server.d.mts",
      "import": "./server.mjs"
    },
    "./values": {
      "types": "./values.d.mts",
      "import": "./values.mjs"
    },
    "./data": {
      "types": "./data.d.mts",
      "import": "./data.mjs"
    },
    "./react": {
      "types": "./react.d.mts",
      "import": "./react.mjs"
    },
    "./react/data": {
      "types": "./react-data.d.mts",
      "import": "./react-data.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@expo/snapback-client": "workspace:*",
    "@expo/snapback-codegen": "workspace:*",
    "@expo/snapback-react": "workspace:*"
  },
  "peerDependencies": {
    "@expo/snapback-client": ">=0.1.0 <0.2.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "snapback": {
    "maturity": "Experimental",
    "authoringProfile": "snapback-familiar-ts-v1"
  },
  "scripts": {
    "test": "node package.test.mjs"
  }
}
