{
  "name": "@expo/snapback-expo",
  "version": "0.1.0",
  "description": "Zero-configuration Expo binding, provider, lifecycle, and config plugin for Snapback applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/snapback.git",
    "directory": "packages/snapback-expo"
  },
  "homepage": "https://github.com/expo/snapback#readme",
  "bugs": {
    "url": "https://github.com/expo/snapback/issues"
  },
  "keywords": ["snapback", "backend", "expo", "react-native"],
  "files": [
    "README.md",
    "app-binding.d.mts",
    "app-binding.mjs",
    "app-binding.schema.json",
    "app-state.mjs",
    "app-state.native.mjs",
    "app-state.web.mjs",
    "activity-presence.d.mts",
    "activity-presence.mjs",
    "asset-source.d.mts",
    "asset-source.mjs",
    "app.plugin.js",
    "config-plugin.cjs",
    "config-plugin.d.mts",
    "data.d.mts",
    "data.mjs",
    "index.d.mts",
    "index.mjs",
    "lifecycle-source.mjs",
    "provider.mjs",
    "supervised-binding-cache.mjs",
    "supervised-environment.d.mts",
    "supervised-environment.mjs"
  ],
  "imports": {
    "#app-state": {
      "browser": "./app-state.web.mjs",
      "react-native": "./app-state.native.mjs",
      "default": "./app-state.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "require": "./app.plugin.js",
      "default": "./index.mjs"
    },
    "./app-binding": {
      "types": "./app-binding.d.mts",
      "import": "./app-binding.mjs"
    },
    "./app-binding.schema.json": "./app-binding.schema.json",
    "./asset-source": {
      "types": "./asset-source.d.mts",
      "import": "./asset-source.mjs"
    },
    "./data": {
      "types": "./data.d.mts",
      "import": "./data.mjs"
    },
    "./app.plugin": {
      "types": "./config-plugin.d.mts",
      "require": "./app.plugin.js",
      "default": "./app.plugin.js"
    },
    "./config-plugin": {
      "types": "./config-plugin.d.mts",
      "require": "./config-plugin.cjs",
      "default": "./config-plugin.cjs"
    },
    "./supervised-environment": {
      "types": "./supervised-environment.d.mts",
      "import": "./supervised-environment.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@expo/snapback-client": "workspace:*",
    "@expo/snapback-react": "workspace:*"
  },
  "peerDependencies": {
    "expo": ">=57.0.0 <58.0.0",
    "expo-file-system": ">=57.0.0 <58.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "react-native": ">=0.86.0 <0.87.0",
    "react-native-web": ">=0.21.0 <0.22.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node ../../scripts/ensure-workspace-hoist.mjs && node app-binding.test.mjs && node asset-source.test.mjs && node config-plugin.test.mjs && node provider.test.mjs && node provider-auth-bootstrap.test.mjs && node supervised-environment.test.mjs && node supervised-offline-fallback.test.mjs && node release-export-vocabulary.test.mjs && node activity-presence.test.mjs && node package.test.mjs && node package-closure.test.mjs && ../../node_modules/.bin/tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler types.fixture.ts"
  }
}
