{
  "name": "@snapback/app-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Artifact-driven local Snapback application CLI for agent journeys.",
  "files": [
    "cli.mjs",
    "index.mjs"
  ],
  "bin": {
    "snapback-app": "./cli.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@snapback/client": "workspace:*",
    "@snapback/codegen": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node attribution.test.mjs"
  }
}
