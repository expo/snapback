{
  "name": "@expo/snapback-app-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Artifact-driven local Snapback application CLI for agent journeys.",
  "files": [
    "cli.mjs",
    "index.d.mts",
    "index.mjs",
    "result-core.mjs"
  ],
  "bin": {
    "snapback-app": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@expo/snapback-client": "workspace:*",
    "@expo/snapback-codegen": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node attribution.test.mjs && node result-core.test.mjs"
  }
}
