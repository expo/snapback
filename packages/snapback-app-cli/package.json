{
  "name": "@expo/snapback-app-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Artifact-driven local Snapback application CLI for agent journeys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/snapback.git",
    "directory": "packages/snapback-app-cli"
  },
  "homepage": "https://github.com/expo/snapback#readme",
  "bugs": {
    "url": "https://github.com/expo/snapback/issues"
  },
  "keywords": ["snapback", "backend", "cli", "app-data"],
  "files": [
    "cli.mjs",
    "arguments.mjs",
    "agent-digest.schema.json",
    "auth.mjs",
    "oauth.mjs",
    "code-mode-child.mjs",
    "code-mode-ibex.mjs",
    "code-mode.mjs",
    "ibex-bundle.mjs",
    "schema-interpreter.mjs",
    "digest.d.mts",
    "digest.mjs",
    "envelope.mjs",
    "index.d.mts",
    "index.mjs",
    "result-core.mjs"
  ],
  "bin": {
    "snapback-app": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./agent-digest.schema.json": "./agent-digest.schema.json",
    "./digest": {
      "types": "./digest.d.mts",
      "default": "./digest.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@expo/snapback-client": "workspace:*",
    "@expo/snapback-codegen": "workspace:*",
    "ajv": "^8.20.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node package.test.mjs && node auth.test.mjs && node code-mode.test.mjs && node code-mode-ibex.test.mjs && node schema-interpreter.test.mjs && node ibex-bundle.test.mjs && node cli.test.mjs && node digest.test.mjs && node attribution.test.mjs && node result-core.test.mjs && node envelope.test.mjs"
  }
}
