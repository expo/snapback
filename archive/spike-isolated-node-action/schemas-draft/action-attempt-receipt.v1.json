{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.snapback.dev/draft/action-attempt-receipt.v1.json",
  "title": "ActionAttemptReceiptV1",
  "description": "Draft privacy-bounded isolated action receipt: identity, effect certainty, terminal cause, retry disposition, and diagnostics; never args, result values, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "attemptId", "attemptToken", "actionId", "generationId", "bundleId", "executableId", "workerSessionId", "idempotencyKeyDigest", "effectClass", "deadlineMs", "startedAtMs", "settledAtMs", "outcome", "initiationState", "effectMayHaveExecuted", "settledBy", "retryDisposition", "resultDigest", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "action-attempt-receipt.v1" },
    "attemptId": { "type": "string", "minLength": 1 },
    "attemptToken": { "type": "string", "minLength": 16 },
    "actionId": { "type": "string", "minLength": 1 },
    "generationId": { "$ref": "#/$defs/digest" },
    "bundleId": { "$ref": "#/$defs/digest" },
    "executableId": { "$ref": "#/$defs/digest" },
    "workerSessionId": { "type": "string", "minLength": 16 },
    "idempotencyKeyDigest": { "$ref": "#/$defs/digest" },
    "effectClass": { "type": "string", "minLength": 1 },
    "deadlineMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "startedAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "settledAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "outcome": { "enum": ["succeeded", "failed", "cancelled", "timed_out", "ambiguous", "invalid_result"] },
    "initiationState": { "enum": ["definitely_not_initiated", "initiation_possible", "response_observed"] },
    "effectMayHaveExecuted": { "type": "boolean" },
    "settledBy": { "enum": ["worker", "terminalizer"] },
    "retryDisposition": { "enum": ["not_needed", "safe", "provider_lookup_required", "unsafe", "exhausted"] },
    "resultDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "diagnostics": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^SNAPBACK_" } }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "ambiguous" } }, "required": ["outcome"] },
      "then": { "properties": { "effectMayHaveExecuted": { "const": true }, "retryDisposition": { "enum": ["provider_lookup_required", "unsafe"] }, "resultDigest": { "type": "null" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "succeeded" } }, "required": ["outcome"] },
      "then": { "properties": { "resultDigest": { "$ref": "#/$defs/digest" }, "retryDisposition": { "const": "not_needed" } } }
    }
  ],
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}

