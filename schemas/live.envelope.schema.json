{
  "$defs": {
    "AuthorizationInvalidationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "type": "string"
        },
        "rows": {
          "items": true,
          "type": "array"
        },
        "subscriptionId": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "subscriptionId",
        "function",
        "version",
        "rows"
      ],
      "type": "object"
    },
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "CompositeWitness": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataWitness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authorization"
      ],
      "type": "object"
    },
    "DataWitness": {
      "additionalProperties": false,
      "properties": {
        "minCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "minCommitVersion"
      ],
      "type": "object"
    },
    "InvalidationDisposition": {
      "enum": [
        "retain",
        "quarantine",
        "delete"
      ],
      "type": "string"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    },
    "LiveDeltaOpKind": {
      "enum": [
        "add",
        "update",
        "remove"
      ],
      "type": "string"
    },
    "LiveDeltaWireOp": {
      "description": "One `live_delta` op: the row is present for add/update and absent for\nremove.",
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/LiveDeltaOpKind"
        },
        "row": true
      },
      "required": [
        "op",
        "id"
      ],
      "type": "object"
    },
    "QueryNamespace": {
      "additionalProperties": false,
      "properties": {
        "clientStoreId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        }
      },
      "required": [
        "clientStoreId",
        "queryKey",
        "queryInstanceId"
      ],
      "type": "object"
    },
    "ResolutionKind": {
      "enum": [
        "snapshot",
        "terminalDelete"
      ],
      "type": "string"
    },
    "ResolutionTicket": {
      "additionalProperties": false,
      "properties": {
        "ackToken": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolutionKind"
        },
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "kind",
        "scopeId",
        "revision",
        "witness",
        "maxDisposition",
        "ackToken"
      ],
      "type": "object"
    },
    "ResumeMeta": {
      "description": "Clear advisory copy of the token's identity fields (LLP 0091 §0B.1). The\nclient's digest-kind signal is `content_digest`'s self-describing prefix.",
      "properties": {
        "app": {
          "type": "string"
        },
        "argsHash": {
          "type": "string"
        },
        "contentDigest": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "queryArtifact": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "version",
        "contentDigest",
        "generation",
        "versionStream",
        "queryArtifact",
        "argsHash"
      ],
      "type": "object"
    },
    "ResumeWire": {
      "description": "The RQS resume object (LLP 0091 §0B.1): the opaque server-authenticated\ntoken plus its clear, client-advisory `meta` copy. `meta` repeats every\nidentity field the LLP 0090 D3 channel arbitration compares and is never\nan admission input — admission decodes the token itself. Exported as\n`live.resume-token.schema.json`, named distinctly from the reattach\noperation's `live.resume.*` schemas (LLP 0091 §0B.4).",
      "properties": {
        "meta": {
          "$ref": "#/$defs/ResumeMeta"
        },
        "token": {
          "description": "`tokenWire` (`sbrt1.` envelope, ≤ 1 KiB — LLP 0091 §0A.1).",
          "type": "string"
        }
      },
      "required": [
        "token",
        "meta"
      ],
      "type": "object"
    },
    "ResyncObligation": {
      "additionalProperties": false,
      "properties": {
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "description": "Cleanup ownership for the client-side pending token. This is not part\nof scope/revision identity; retirement may finish only after this exact\ncontinuity ends (except an already-applied terminal delete).",
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retryEpisodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "scopeId",
        "revision",
        "maxDisposition",
        "witness"
      ],
      "type": "object"
    },
    "ScopeId": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            },
            "scopeSequence": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "subscriptionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "namespace",
            "scopeSequence",
            "connectionGeneration",
            "subscriptionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "connectionGeneration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "clientQuery",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            }
          },
          "required": [
            "kind",
            "namespace"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A durable-lane fan-out envelope: what a live-query subscriber receives,\nunwrapped, on the WebSocket (and wrapped in [`RealtimeEnvelope::Durable`]\nbytes on the HTTP polling drain).\n\n`live_replace` is the wire default (whole-result refresh); every row's\nsystem `_id` member is its durable identity and occupies the same string\nspace as [`LiveDeltaWireOp::id`]. `live_delta` is the DK-3 op-log fast path\nfor the analyzable unordered subset;\n`resync_required` tells the client its subscription (or, connection-wide,\nits whole outbox) can no longer be trusted and it must re-snapshot.",
  "oneOf": [
    {
      "description": "Whole-result refresh for one subscription.",
      "properties": {
        "function": {
          "type": "string"
        },
        "kind": {
          "const": "live_replace",
          "type": "string"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResumeWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refreshed resume token for `rqsEligible` subscriptions — an\nignorable optional addition (old decoders drop it; LLP 0091 §0B.2)."
        },
        "rows": {
          "items": true,
          "type": "array"
        },
        "subscription_id": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "subscription_id",
        "function",
        "version",
        "rows"
      ],
      "type": "object"
    },
    {
      "description": "Op-log delta (DK-3 / LLP 0008): only the rows that entered/left/changed\nthe subscription's result. Unordered by contract — ordered queries fall\nback to `live_replace`.",
      "properties": {
        "function": {
          "type": "string"
        },
        "kind": {
          "const": "live_delta",
          "type": "string"
        },
        "ops": {
          "items": {
            "$ref": "#/$defs/LiveDeltaWireOp"
          },
          "type": "array"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResumeWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refreshed resume token for `rqsEligible` subscriptions — an\nignorable optional addition (old decoders drop it; LLP 0091 §0B.2)."
        },
        "subscription_id": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "subscription_id",
        "function",
        "version",
        "ops"
      ],
      "type": "object"
    },
    {
      "description": "Rung-1 answer to a `resumeFromToken` subscribe (LLP 0090 D1.3, LLP\n0091 §0B.2): \"your held rows are current as of `version`\". The client\nadopts the mandatory fresh token and advances its version without\ntouching rows. Sent only to a subscriber that presented\n`resumeFromToken`, so decode ability is implied by the request — no\ncapability negotiation.",
      "properties": {
        "function": {
          "type": "string"
        },
        "kind": {
          "const": "current_as_of",
          "type": "string"
        },
        "resume": {
          "$ref": "#/$defs/ResumeWire",
          "description": "Fresh token minted at `version` — the variant exists to advance it."
        },
        "subscription_id": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "subscription_id",
        "function",
        "version",
        "resume"
      ],
      "type": "object"
    },
    {
      "description": "Level-triggered authorization invalidation for one auth-scoped live\nquery. The optional snapshot and resolution are one atomic wire frame;\ntheir presence never discharges the server obligation. Only the exact\npost-commit ACK token does that.",
      "properties": {
        "kind": {
          "const": "authorization_invalidation",
          "type": "string"
        },
        "obligation": {
          "$ref": "#/$defs/ResyncObligation"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionTicket"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationInvalidationSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "obligation"
      ],
      "type": "object"
    },
    {
      "description": "The subscription (or the whole connection, when `subscription_id` is\nabsent — outbox overflow) must re-snapshot. Known reasons today:\n`reset`, `auth_deployment_activated`, `outbox_overflow`, `permission_epoch_changed`,\n`live_delta_failed`, `live_refresh_failed`, `live_serialize_failed`,\n`permission_resync_serialize_failed`. A string, not an enum: the\nrecovery is identical for every reason and new reasons must not break\ndeployed decoders.",
      "properties": {
        "clear_retained": {
          "type": "boolean"
        },
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "const": "resync_required",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "subscription_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "reason",
        "clear_retained"
      ],
      "type": "object"
    }
  ],
  "title": "LiveEnvelope"
}
