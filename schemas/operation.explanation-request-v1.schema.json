{
  "$defs": {
    "AuthInput": {
      "properties": {
        "principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AuthorityDescriptor": {
      "additionalProperties": false,
      "description": "Opaque server-issued consistency descriptor for one queued mutation.\nPossession grants no authority; the invocation gate first resolves a live\ncredential and only then compares this value with its prepared authority.\n\n@ref LLP 0039#replay-parity-and-the-authority-instance-id — this is a\n  dedicated MutationRequest channel, never a ctx-answer-ledger member.",
      "properties": {
        "authorityInstanceId": {
          "pattern": "^(?:[a-z][a-z0-9]{0,11}_[0-9a-hjkmnp-tv-z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
          "type": "string"
        },
        "descriptorVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sessionGeneration": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "descriptorVersion",
        "authorityInstanceId",
        "sessionGeneration"
      ],
      "type": "object"
    },
    "OperationBoundFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "functionOrCommand": {
          "type": "string"
        },
        "inputFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationKind": {
          "type": "string"
        },
        "principalFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "audience",
        "principalFingerprint",
        "authorityInstanceId",
        "operationKind",
        "functionOrCommand",
        "inputFingerprint"
      ],
      "type": "object"
    },
    "OperationIdentityV1": {
      "additionalProperties": false,
      "description": "`operationId` widens the shipped client-mutation id; this struct preserves\nevery bound fact the existing collision check already owns.",
      "properties": {
        "boundFacts": {
          "$ref": "#/$defs/OperationBoundFactsV1"
        },
        "issuance": {
          "$ref": "#/$defs/OperationIssuanceV1"
        },
        "key": {
          "$ref": "#/$defs/OperationKeyV1"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "issuance",
        "boundFacts"
      ],
      "type": "object"
    },
    "OperationIssuanceV1": {
      "description": "Issuance facts are structurally disjoint across client and host namespaces.\nThe authenticator is represented by its non-secret digest; admission later\nverifies the underlying server-issued artifact before constructing this\nvalue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "clientRange",
              "type": "string"
            },
            "range_end_exclusive": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "range_start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "counter",
            "range_start",
            "range_end_exclusive",
            "authority_authenticator_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "commit_ordinal": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "hostIncarnation",
              "type": "string"
            },
            "upstream_identity": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "upstream_identity",
            "commit_ordinal",
            "authority_authenticator_digest"
          ],
          "type": "object"
        }
      ]
    },
    "OperationKeyV1": {
      "additionalProperties": false,
      "description": "The physical key for suppression and envelope storage. Audience and all\nother semantic facts are compared facts, never key components.",
      "properties": {
        "operationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "type": "string"
        },
        "originatorClass": {
          "$ref": "#/$defs/OperationOriginatorClassV1"
        },
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "originatorClass",
        "operationId"
      ],
      "type": "object"
    },
    "OperationOriginatorClassV1": {
      "enum": [
        "client",
        "host"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/operation.explanation-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact-operation public/admin explanation request. Public transport resolves\n`auth` through the normal app-auth middleware; admin transport ignores the\nlegacy body auth and requires the independent admin credential.",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthInput",
      "default": {
        "principal": null,
        "session_id": null,
        "user_id": null
      }
    },
    "authorityDescriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorityDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "$ref": "#/$defs/OperationIdentityV1"
    },
    "schemaVersion": {
      "default": 1,
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "identity"
  ],
  "title": "OperationExplanationRequestV1",
  "type": "object"
}
