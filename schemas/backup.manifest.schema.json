{
  "$defs": {
    "BackupComponent": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "objects": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "sha256",
        "bytes",
        "objects",
        "verified"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/backup.manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-free, read-back-verified backup identity. Required secret names and\ngenerations may be recorded by a later prepared-release artifact, but\ncredential values and control-plane handles never enter this manifest.",
  "properties": {
    "backupId": {
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/BackupComponent"
      },
      "type": "array"
    },
    "createdAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "databaseId": {
      "type": "string"
    },
    "deploymentId": {
      "type": "string"
    },
    "encryptionClass": {
      "type": "string"
    },
    "excludedSecretClasses": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "operationId": {
      "type": "string"
    },
    "releaseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "retentionPolicy": {
      "type": "string"
    },
    "schemaIdentitySha256": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "storageClass": {
      "type": "string"
    },
    "streamIncarnation": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "verifiedAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "backupId",
    "operationId",
    "targetId",
    "deploymentId",
    "databaseId",
    "streamIncarnation",
    "schemaIdentitySha256",
    "encryptionClass",
    "storageClass",
    "retentionPolicy",
    "components",
    "excludedSecretClasses",
    "createdAtMs",
    "verifiedAtMs"
  ],
  "title": "BackupManifest",
  "type": "object"
}
