{
  "$defs": {
    "PasswordAttemptAdminRecord": {
      "additionalProperties": false,
      "properties": {
        "canonicalIdentifier": {
          "type": "string"
        },
        "failedCount": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "locked": {
          "type": "boolean"
        },
        "lockedUntilMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "windowStartMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "canonicalIdentifier",
        "windowStartMs",
        "failedCount",
        "locked"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.password-attempt-admin.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "anyOf": [
        {
          "$ref": "#/$defs/PasswordAttemptAdminRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "failureThreshold": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "failureWindowMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "lockDurationMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "failureThreshold",
    "failureWindowMs",
    "lockDurationMs"
  ],
  "title": "PasswordAttemptAdminResponse",
  "type": "object"
}
