{
  "$defs": {
    "AppBindingCapabilitiesV1": {
      "additionalProperties": false,
      "properties": {
        "offered": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "offered"
      ],
      "type": "object"
    },
    "AppBindingIntegrityV1": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string"
        }
      },
      "required": [
        "channel"
      ],
      "type": "object"
    },
    "AppBindingProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "type": "string"
        },
        "issuedAt": {
          "type": "string"
        },
        "supervisorGeneration": {
          "type": "string"
        }
      },
      "required": [
        "supervisorGeneration",
        "issuedAt",
        "expiresAt"
      ],
      "type": "object"
    },
    "AppBindingTargetV1": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string"
        },
        "functions": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "schema",
        "functions",
        "origin",
        "routing"
      ],
      "type": "object"
    },
    "AppBindingV1": {
      "additionalProperties": false,
      "description": "Bearer-free client admission issued by the lifecycle owner. The\napplication-ready receipt embeds the closed binding rather than pointing\nat a launcher-private environment or log line.",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/AppBindingCapabilitiesV1"
        },
        "descriptorIdentity": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "integrity": {
          "$ref": "#/$defs/AppBindingIntegrityV1"
        },
        "provenance": {
          "$ref": "#/$defs/AppBindingProvenanceV1"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/AppBindingTargetV1"
        }
      },
      "required": [
        "format",
        "source",
        "descriptorIdentity",
        "target",
        "capabilities",
        "provenance",
        "integrity"
      ],
      "type": "object"
    },
    "AppDataAvailability": {
      "enum": [
        "available",
        "refusedPending"
      ],
      "type": "string"
    },
    "ApplicationIdentityV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "deployment": {
              "$ref": "#/$defs/DeploymentIdentity"
            },
            "mode": {
              "const": "dev-generated",
              "type": "string"
            },
            "obligationsDigest": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "deployment",
            "obligationsDigest"
          ],
          "type": "object"
        }
      ]
    },
    "ApplicationReadyAuthV1": {
      "additionalProperties": false,
      "properties": {
        "activeMode": {
          "$ref": "#/$defs/AuthMode"
        },
        "appDataAvailability": {
          "$ref": "#/$defs/AppDataAvailability"
        },
        "desiredMode": {
          "$ref": "#/$defs/AuthMode"
        },
        "modeState": {
          "$ref": "#/$defs/AuthModeStatus"
        },
        "sessionActivationReady": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "activeMode",
        "desiredMode",
        "modeState",
        "appDataAvailability"
      ],
      "type": "object"
    },
    "ApplicationReadyRuntimeIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "qualifiedBinary": {
          "$ref": "#/$defs/QualifiedBinaryIdentityV1"
        },
        "wrapper": {
          "$ref": "#/$defs/CliWrapperIdentityV1"
        }
      },
      "required": [
        "qualifiedBinary",
        "wrapper"
      ],
      "type": "object"
    },
    "AuthMode": {
      "description": "The authority mode declared by a schema artifact. The enum is deliberately\nclosed: a mode changes who is allowed to supply invocation authority and an\nunknown spelling therefore cannot be treated as an additive field.\n\n@ref LLP 0058#closed-auth-mode — auth mode is a must-understand closed value.",
      "enum": [
        "dev",
        "sessions"
      ],
      "type": "string"
    },
    "AuthModeStatus": {
      "enum": [
        "settled",
        "pendingRestart",
        "quarantined"
      ],
      "type": "string"
    },
    "CliWrapperIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "type": "object"
    },
    "DeploymentIdentity": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "authMode": {
              "const": "dev"
            },
            "bundleHash": {
              "not": {
                "pattern": "^snapback\\.v1:"
              }
            },
            "inputsHash": {
              "not": {
                "pattern": "^snapback\\.v1:"
              }
            },
            "schemaHash": {
              "not": {
                "pattern": "^snapback\\.v1:"
              }
            },
            "schemaVersion": {
              "const": "snapback.v0"
            }
          }
        },
        {
          "properties": {
            "authMode": {
              "const": "sessions"
            },
            "bundleHash": {
              "pattern": "^snapback\\.v1:sessions:function:sha256:[0-9a-f]{64}$"
            },
            "inputsHash": {
              "pattern": "^snapback\\.v1:sessions:inputs:sha256:[0-9a-f]{64}$"
            },
            "schemaHash": {
              "pattern": "^snapback\\.v1:sessions:schema:sha256:[0-9a-f]{64}$"
            },
            "schemaVersion": {
              "const": "snapback.v1"
            }
          }
        }
      ],
      "properties": {
        "appId": {
          "minLength": 1,
          "type": "string"
        },
        "authMode": {
          "$ref": "#/$defs/AuthMode"
        },
        "bundleHash": {
          "minLength": 1,
          "type": "string"
        },
        "inputsHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "authMode",
        "appId",
        "schemaHash",
        "bundleHash",
        "inputsHash"
      ],
      "type": "object"
    },
    "HostOpsArtifacts": {
      "additionalProperties": false,
      "properties": {
        "bundleHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "databaseVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "schemaHash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "QualifiedBinaryIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "buildIdentity": {
          "$ref": "#/$defs/RuntimeBuildIdentityV1"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/RuntimeQualificationIdentityV1"
        },
        "sha256": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "source",
        "platform",
        "bytes",
        "sha256",
        "buildIdentity",
        "qualification"
      ],
      "type": "object"
    },
    "RuntimeBuildIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "buildProfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "crateVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "gitCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "gitDirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeQualificationIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "string"
        },
        "receiptPath": {
          "type": "string"
        },
        "receiptSchemaVersion": {
          "type": "string"
        }
      },
      "required": [
        "receiptSchemaVersion",
        "receiptPath",
        "probe"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/application-ready.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed attach authority for one settled application lifecycle.\n\nThe 2026-08-21 D0.1 amendment deliberately extended this same v1 closed\ncarrier with must-understand binding, admission, and runtime facts. It is\nfail-closed rather than additive-compatible: pre-amendment readers reject\namended receipts and amended readers reject pre-amendment receipts. A live\ndevelopment owner must reissue the receipt across that tool upgrade.",
  "properties": {
    "application": {
      "$ref": "#/$defs/ApplicationIdentityV1"
    },
    "artifacts": {
      "$ref": "#/$defs/HostOpsArtifacts"
    },
    "auth": {
      "$ref": "#/$defs/ApplicationReadyAuthV1"
    },
    "binding": {
      "$ref": "#/$defs/AppBindingV1"
    },
    "capabilityManifestDigest": {
      "type": "string"
    },
    "clientOrigins": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "formatVersion": {
      "type": "string"
    },
    "hostReadyDescriptorDigest": {
      "type": "string"
    },
    "networkProfile": {
      "type": "string"
    },
    "runtimeIdentity": {
      "$ref": "#/$defs/ApplicationReadyRuntimeIdentityV1"
    },
    "settledAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "startupNonce": {
      "type": "string"
    },
    "targetProfile": {
      "type": "string"
    }
  },
  "required": [
    "formatVersion",
    "startupNonce",
    "hostReadyDescriptorDigest",
    "application",
    "targetProfile",
    "artifacts",
    "auth",
    "binding",
    "clientOrigins",
    "runtimeIdentity",
    "capabilityManifestDigest",
    "networkProfile",
    "settledAtMs"
  ],
  "title": "ApplicationReadyReceiptV1",
  "type": "object"
}
