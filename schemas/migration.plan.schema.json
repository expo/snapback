        "rollbackBoundaryStep": {
          "description": "Last step still inside the rollback window; absent = the whole plan.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MigrationCeilings": {
      "additionalProperties": false,
      "description": "Approval-relevant resource ceilings — canonical body fields and\nbarrier-time admission preconditions (LLP 0081 §2).",
      "properties": {
        "maxAffectedRows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxBarrierDowntimeMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxWrites": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maxAffectedRows",
        "maxBytes",
        "maxWrites",
        "maxBarrierDowntimeMs"
      ],
      "type": "object"
    },
    "MigrationConstants": {
      "additionalProperties": false,
      "description": "The complete explicit constants object (LLP 0081 §2): migration constants\nare inputs, not ambient values; apply creates none.",
      "properties": {
        "publicationTimestampMs": {
          "description": "The approved publication timestamp; carries the 48 UUIDv7 time bits\nof every synthesized ID. Validation refuses values at or above\n`2^48` ms with `SNAPBACK_MIGRATION_PLAN_INVALID`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rollbackTimestampMs": {
          "description": "The explicit rollback timestamp (LLP 0081 §6): required to execute\nthe fast rollback; admission requires it to be at least\n`publicationTimestampMs` (and the restamp maximum), the same\nmonotonicity rule as forward publication. Absent bytes keep older\nplan digests stable.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "values": {
          "additionalProperties": true,
          "description": "Named literal constants backfill expressions may read via `Arg`.",
          "type": "object"
        }
      },
      "required": [
        "publicationTimestampMs"
      ],
      "type": "object"
    },
    "MigrationExecutionStrategy": {
      "enum": [
        "single-transaction",
