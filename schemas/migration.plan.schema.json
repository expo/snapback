    "MigrationPlanBody": {
      "additionalProperties": false,
      "description": "The canonical plan body. Everything approval-relevant lives here, inside\nthe digest; target observations that do not authorize execution live in\nthe separately digested [`MigrationPreviewObservationV1`].",
      "properties": {
