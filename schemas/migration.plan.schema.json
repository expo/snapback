        "app",
        "instance",
        "targetProfileId",
        "predecessorSchemaHash",
        "successorSchemaHash",
        "predecessorGeneration",
        "steps",
        "executionStrategy",
        "proof",
        "ceilings",
        "compatibilityPosture",
        "retainedWorkPosture",
        "backup",
        "expectedOutput",
        "constants"
      ],
      "type": "object"
    },
    "MigrationPrecondition": {
      "description": "The v1-admitted per-step precondition vocabulary of this slice. Closed\nand deliberately small; later waves widen it by version, never by\nloosening.",
      "oneOf": [
