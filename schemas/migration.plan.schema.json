        },
        "schemaVersion": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/MigrationStepRecord"
          },
          "type": "array"
        },
        "successorSchemaHash": {
          "type": "string"
        },
        "targetProfileId": {
          "type": "string"
        }
      },
      "required": [
