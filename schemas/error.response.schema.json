{
  "$defs": {
    "Diagnostic": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subsystem": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subsystem",
        "message",
        "details"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    },
    "FunctionAttribution": {
      "description": "Server-derived, bearer-free attribution for one app-data function\nresponse. Wrappers may copy this value, but cannot synthesize attribution\nauthority when the invocation gate did not produce it.\n\n@ref LLP 0055#audit — every resolved service-principal function response\ncarries the same actor/effective/grant attribution and v1 has no agent\ndry-run surface.",
      "properties": {
        "actorUserId": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "effectiveUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantId": {
          "type": "string"
        }
      },
      "required": [
        "actorUserId",
        "grantId",
        "dryRun"
      ],
      "type": "object"
    },
    "MutationReceiptOutcome": {
      "enum": [
        "confirmed",
        "rejected"
      ],
      "type": "string"
    },
    "Receipt": {
      "description": "A retention-ring receipt (LLP 0034 §3.2): connectionless facts about\nmutations and subscription lifecycle, served by the receipts snapshot and\nechoed in live-subscribe/unsubscribe outputs. Privacy (§3.3): receipts\ncarry opaque ids, versions, table names, and reasons — never row data or\nargument values.",
      "oneOf": [
        {
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "snapshotVersion": {
                    "type": "integer"
                  }
                }
              }
            }
          ],
          "description": "One mutation invocation: confirmed or rejected, with the write\nsurface that fan-out used.",
          "properties": {
            "affectedTables": {
              "description": "`null` means EXPLICITLY unknown (an IbexModule handler without a\ndeclared write set) — distinct from `[]`, no tables.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "correlation": {
              "description": "Adapter-supplied opaque correlation, echoed verbatim (capped)."
            },
            "kind": {
              "const": "mutation",
              "type": "string"
            },
            "mutation": {
              "type": "string"
            },
            "mutationId": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/MutationReceiptOutcome"
            },
            "receivedAtMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "rollbackReason": {
              "description": "The diagnostic CODE only — messages may embed argument values\n(§3.3 privacy). `null` on confirmed mutations.",
              "type": [
                "string",
                "null"
              ]
            },
            "snapshotVersion": {
              "description": "`null` only when the rejected invocation could not safely read the\ndurable cursor; never fabricate zero from a storage failure.",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "transport": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mutationId",
            "mutation",
            "outcome",
            "snapshotVersion",
            "transport",
            "correlation",
            "receivedAtMs"
          ],
          "type": "object"
        },
        {
          "description": "Subscription lifecycle: established / disposed, on both the durable\nlive-query lane and the ephemeral room lane (`lane: \"ephemeral\"`,\nwhich carries `bindingId`/`collection` instead of `subscriptionId`).",
          "properties": {
            "bindingId": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection": {
              "type": [
                "string",
                "null"
              ]
            },
            "correlation": true,
            "event": {
              "$ref": "#/$defs/SubscriptionReceiptEvent"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "lane": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "receivedAtMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "removed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "scope": {
              "description": "The subscription's routing/scope args (REQUIRED — LLP 0034 §3.2)."
            },
            "snapshotVersion": {
              "description": "`null` when no storage read is safe at the emission site (the\ndisconnect teardown path) — the honest \"unknown at death\" value.",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "subscriptionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersededBy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "event",
            "scope",
            "receivedAtMs"
          ],
          "type": "object"
        }
      ]
    },
    "SubscriptionReceiptEvent": {
      "enum": [
        "established",
        "disposed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/error.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionAttribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic": {
      "$ref": "#/$defs/Diagnostic"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present only when a mutation reached the provider receipt boundary."
    }
  },
  "required": [
    "diagnostic"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
