{
  "$defs": {
    "Diagnostic": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subsystem": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subsystem",
        "message",
        "details"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/error.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "diagnostic": {
      "$ref": "#/$defs/Diagnostic"
    }
  },
  "required": [
    "diagnostic"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
