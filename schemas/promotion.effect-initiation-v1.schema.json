{
  "$defs": {
    "BranchId": {
      "description": "Stable identity of an ephemeral branch within one logical app.",
      "type": "string"
    },
    "CapturedEffectStateV1": {
      "enum": [
        "captured",
        "canonicalPending",
        "initiated",
        "succeeded",
        "rejected",
        "ambiguousExternalEffect",
        "authorityRefused"
      ],
      "type": "string"
    },
    "EffectSettlementCapabilityV1": {
      "enum": [
        "providerIdempotent",
        "providerQueryable",
        "inherentlyAmbiguous"
      ],
      "type": "string"
    },
    "PromotedEffectIntentV1": {
      "additionalProperties": false,
      "properties": {
        "authorityFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "branchId": {
          "$ref": "#/$defs/BranchId"
        },
        "capturedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "effectOrdinal": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "egressClass": {
          "type": "string"
        },
        "grantId": {
          "type": "string"
        },
        "idempotencyKey": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "initiatedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "intentId": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "settledAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "settlementCapability": {
          "$ref": "#/$defs/EffectSettlementCapabilityV1"
        },
        "sourceOperationId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CapturedEffectStateV1"
        },
        "terminalFactDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "ticketId": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "ticketId",
        "intentId",
        "branchId",
        "sourceOperationId",
        "effectOrdinal",
        "egressClass",
        "settlementCapability",
        "idempotencyKey",
        "principalId",
        "grantId",
        "authorityFingerprint",
        "state",
        "capturedAtMs"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/promotion.effect-initiation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alreadyInitiated": {
      "type": "boolean"
    },
    "intent": {
      "$ref": "#/$defs/PromotedEffectIntentV1"
    }
  },
  "required": [
    "intent",
    "alreadyInitiated"
  ],
  "title": "EffectInitiationV1",
  "type": "object"
}
