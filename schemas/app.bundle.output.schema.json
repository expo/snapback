{
  "$defs": {
    "AuthenticatedBootIssuer": {
      "additionalProperties": false,
      "properties": {
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "keyId": {
          "type": "string"
        },
        "mac": {
          "type": "string"
        }
      },
      "required": [
        "issuerId",
        "keyId",
        "mac"
      ],
      "type": "object"
    },
    "AuthorizationInvalidationConnection": {
      "additionalProperties": false,
      "description": "The connection-visible negotiated expectation. The authenticated\ndescriptor remains server-held; once startup has verified it, the client\nreceives the exact issuer id over the authenticated connection bootstrap.",
      "properties": {
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion",
          "description": "Closed initial client expectation. A clean subscription with no\npending projection must never invent epoch zero."
        },
        "connectionGeneration": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "issuerRetirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssuerRetirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "issuerId",
        "connectionGeneration",
        "authorization",
        "versionStream"
      ],
      "type": "object"
    },
    "AuthorizationInvalidationProjection": {
      "additionalProperties": false,
      "description": "One level-triggered live projection. Delivery is only a hint; the exact\nobligation remains authoritative until the optional resolution ticket is\nacknowledged after the client commits its local transition.",
      "properties": {
        "obligation": {
          "$ref": "#/$defs/ResyncObligation"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionTicket"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "obligation"
      ],
      "type": "object"
    },
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "BundleAuthorization": {
      "additionalProperties": false,
      "description": "The exact LLP 0053 authorization projection adopted with a registered\nchild. Keeping this typed and closed prevents bundle boot from becoming a\nlooser wire dialect than ordinary live subscribe.",
      "properties": {
        "invalidation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationInvalidationProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/ScopeId"
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    "BundleConnection": {
      "additionalProperties": false,
      "description": "Register-mode connection mint (LLP 0092 §0D.1/§0D.4).",
      "properties": {
        "attachDeadline": {
          "description": "Absolute server-clock ms deadline for socket attach.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "authorizationInvalidation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizationInvalidationConnection"
            },
            {
              "type": "null"
            }
          ],
          "description": "The same negotiated authorization-invalidation connection descriptor\nreturned by an ordinary connection open. Register-mode adoption needs\nit to install LLP 0053's authenticated expectation before the bundle\nrows become observable.\n\n@ref LLP 0112#registered-boot — auth-scoped registered children adopt\nthe complete connection and per-child authorization projections."
        },
        "connectionId": {
          "type": "string"
        },
        "grant": {
          "description": "The connection-grant secret (`[secret]` response sensitivity).",
          "type": "string"
        }
      },
      "required": [
        "connectionId",
        "grant",
        "attachDeadline"
      ],
      "type": "object"
    },
    "BundleEntry": {
      "additionalProperties": false,
      "description": "Per-entry closed union (LLP 0092 §0D.1): `resume` is present iff the\nquery is `rqsEligible` and explicitly `null` otherwise, in BOTH modes;\n`subscriptionId` appears in register mode only; `authorization` appears\nfor register-mode auth-scoped entries only.",
      "properties": {
        "args": {
          "description": "Fully substituted, validated args."
        },
        "authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleAuthorization"
            },
            {
              "type": "null"
            }
          ],
          "description": "LLP 0053 scope/invalidation projections for register-mode auth-scoped\nentries."
        },
        "delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/MixedBundleDeliveryV2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present exactly on format 2. This is the per-child delivery claim;\nrows alone never imply liveness."
        },
        "function": {
          "type": "string"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResumeWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Always serialized (`null` for non-eligible entries) — the closed\nunion's discriminating field."
        },
        "rows": {
          "items": true,
          "type": "array"
        },
        "subscriptionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "function",
        "args",
        "rows"
      ],
      "type": "object"
    },
    "CompositeWitness": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataWitness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authorization"
      ],
      "type": "object"
    },
    "DataWitness": {
      "additionalProperties": false,
      "properties": {
        "minCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "minCommitVersion"
      ],
      "type": "object"
    },
    "InvalidationDisposition": {
      "enum": [
        "retain",
        "quarantine",
        "delete"
      ],
      "type": "string"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    },
    "IssuerRetirement": {
      "additionalProperties": false,
      "description": "Server-authenticated proof that every live scope issued by an older boot in\nthe same authorization incarnation is extinct. It cannot release retained\nbytes by itself; a current fresh snapshot must still satisfy their witness.",
      "properties": {
        "authorizationExpectation": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "currentIssuer": {
          "$ref": "#/$defs/AuthenticatedBootIssuer"
        },
        "mac": {
          "type": "string"
        },
        "retireThroughBootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "currentIssuer",
        "retireThroughBootSequence",
        "authorizationExpectation",
        "mac"
      ],
      "type": "object"
    },
    "MixedBundleAggregateV2": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "liveChildren": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "readOnlyChildren": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "weakest": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "weakest",
        "liveChildren",
        "readOnlyChildren"
      ],
      "type": "object"
    },
    "MixedBundleDeliveryV2": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "registered-live",
              "type": "string"
            },
            "nodePlanHash": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodePlanHash"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "read-only",
              "type": "string"
            },
            "nodePlanHash": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodePlanHash"
          ],
          "type": "object"
        }
      ]
    },
    "QueryNamespace": {
      "additionalProperties": false,
      "properties": {
        "clientStoreId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        }
      },
      "required": [
        "clientStoreId",
        "queryKey",
        "queryInstanceId"
      ],
      "type": "object"
    },
    "ResolutionKind": {
      "enum": [
        "snapshot",
        "terminalDelete"
      ],
      "type": "string"
    },
    "ResolutionTicket": {
      "additionalProperties": false,
      "properties": {
        "ackToken": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolutionKind"
        },
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "kind",
        "scopeId",
        "revision",
        "witness",
        "maxDisposition",
        "ackToken"
      ],
      "type": "object"
    },
    "ResumeMeta": {
      "description": "Clear advisory copy of the token's identity fields (LLP 0091 §0B.1). The\nclient's digest-kind signal is `content_digest`'s self-describing prefix.",
      "properties": {
        "app": {
          "type": "string"
        },
        "argsHash": {
          "type": "string"
        },
        "contentDigest": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "queryArtifact": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "version",
        "contentDigest",
        "generation",
        "versionStream",
        "queryArtifact",
        "argsHash"
      ],
      "type": "object"
    },
    "ResumeWire": {
      "description": "The RQS resume object (LLP 0091 §0B.1): the opaque server-authenticated\ntoken plus its clear, client-advisory `meta` copy. `meta` repeats every\nidentity field the LLP 0090 D3 channel arbitration compares and is never\nan admission input — admission decodes the token itself. Exported as\n`live.resume-token.schema.json`, named distinctly from the reattach\noperation's `live.resume.*` schemas (LLP 0091 §0B.4).",
      "properties": {
        "meta": {
          "$ref": "#/$defs/ResumeMeta"
        },
        "token": {
          "description": "`tokenWire` (`sbrt1.` envelope, ≤ 1 KiB — LLP 0091 §0A.1).",
          "type": "string"
        }
      },
      "required": [
        "token",
        "meta"
      ],
      "type": "object"
    },
    "ResyncObligation": {
      "additionalProperties": false,
      "properties": {
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "description": "Cleanup ownership for the client-side pending token. This is not part\nof scope/revision identity; retirement may finish only after this exact\ncontinuity ends (except an already-applied terminal delete).",
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retryEpisodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "scopeId",
        "revision",
        "maxDisposition",
        "witness"
      ],
      "type": "object"
    },
    "ScopeId": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            },
            "scopeSequence": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "subscriptionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "namespace",
            "scopeSequence",
            "connectionGeneration",
            "subscriptionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "connectionGeneration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "clientQuery",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            }
          },
          "required": [
            "kind",
            "namespace"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/app.bundle.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`POST /app/bundle` response (LLP 0092 §0D.1).",
  "properties": {
    "aggregate": {
      "anyOf": [
        {
          "$ref": "#/$defs/MixedBundleAggregateV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "commitVersion": {
      "description": "Single shared commit version — every entry was evaluated at this cut.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "connection": {
      "anyOf": [
        {
          "$ref": "#/$defs/BundleConnection"
        },
        {
          "type": "null"
        }
      ],
      "description": "Register mode only."
    },
    "entries": {
      "description": "One per `querySpec`, manifest order.",
      "items": {
        "$ref": "#/$defs/BundleEntry"
      },
      "type": "array"
    },
    "formatVersion": {
      "description": "Present exactly on the mixed successor wire; absent keeps format 1\nbyte-compatible with LLP 0112.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "generation": {
      "type": "string"
    },
    "planHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "versionStream": {
      "type": "string"
    }
  },
  "required": [
    "commitVersion",
    "generation",
    "versionStream",
    "entries"
  ],
  "title": "BundleResponse",
  "type": "object"
}
