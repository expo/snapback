{
  "$defs": {
    "ArtifactGeneration": {
      "additionalProperties": false,
      "description": "Content-derived identity of one coherent schema/function artifact pair.\nIt deliberately excludes the process-local publication counter: callers\nlearn these values from generated artifacts and can refetch them after a\ndeployment race.",
      "properties": {
        "appId": {
          "minLength": 1,
          "type": "string"
        },
        "bundleHash": {
          "minLength": 1,
          "type": "string"
        },
        "inputsHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "appId",
        "schemaHash",
        "bundleHash",
        "inputsHash"
      ],
      "type": "object"
    },
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "AuthorizationWitnessRecordV1": {
      "additionalProperties": false,
      "properties": {
        "compositeWitness": {
          "$ref": "#/$defs/CompositeWitness"
        },
        "format": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "format",
        "queryInstanceId",
        "compositeWitness"
      ],
      "type": "object"
    },
    "AuthorizedLease": {
      "additionalProperties": false,
      "description": "Exact server-issued envelope.  `deny_unknown_fields` makes protocol v1\nclosed in both directions; additive fields require a new version.",
      "properties": {
        "activationHash": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "authorizedUntilServerMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "clientStoreId": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/AuthorizedLeaseData"
        },
        "issuedAtServerMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "keyId": {
          "description": "Opaque to the client; resolved against the server keyring, where an\nunknown key fails closed.",
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "leaseRequestId": {
          "type": "string"
        },
        "mac": {
          "description": "Server-keyed HMAC-SHA-256 over every field plus target/app identity.\nThe schema pins only the canonical 256-bit base64url FORM — exactly\nwhat client custody validation checks; cryptographic validity is the\nserver verifier's (LLP 0053 §The lease, verification locus).",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "providerKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerNotAfterMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        },
        "sessionIdAtIssue": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionNotAfterMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "leaseId",
        "leaseRequestId",
        "issuerId",
        "clientStoreId",
        "queryKey",
        "queryInstanceId",
        "principalId",
        "authorization",
        "data",
        "activationHash",
        "issuedAtServerMs",
        "authorizedUntilServerMs",
        "keyId",
        "mac"
      ],
      "type": "object"
    },
    "AuthorizedLeaseData": {
      "additionalProperties": false,
      "properties": {
        "snapshotCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "snapshotCommitVersion"
      ],
      "type": "object"
    },
    "CompletenessProofV1": {
      "additionalProperties": false,
      "properties": {
        "activationHash": {
          "type": "string"
        },
        "authorizationWitnessDigest": {
          "type": "string"
        },
        "batchIdentity": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "materializationKey": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ProofNodeIdentityV1"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PageIdentityV1"
        },
        "planHash": {
          "type": "string"
        },
        "proofKeyId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resultDigest": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/ProofVersionV1"
        }
      },
      "required": [
        "format",
        "materializationKey",
        "queryInstanceId",
        "activationHash",
        "planHash",
        "version",
        "authorizationWitnessDigest",
        "page",
        "nodes",
        "batchIdentity",
        "resultDigest",
        "proofKeyId",
        "signature"
      ],
      "type": "object"
    },
    "CompositeWitness": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataWitness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authorization"
      ],
      "type": "object"
    },
    "CursorEndV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "first",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "const": "cursor",
              "type": "string"
            },
            "profileId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "profileId",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "DataWitness": {
      "additionalProperties": false,
      "properties": {
        "minCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "minCommitVersion"
      ],
      "type": "object"
    },
    "FunctionInvocationFacts": {
      "additionalProperties": false,
      "description": "Server-derived successful-invocation facts. Keeping the generation under\na named `facts` block leaves room for additive call facts without mixing\nthem into handler-owned result values.",
      "properties": {
        "activeGeneration": {
          "$ref": "#/$defs/ArtifactGeneration"
        }
      },
      "required": [
        "activeGeneration"
      ],
      "type": "object"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    },
    "PageIdentityV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/CursorEndV1"
            },
            "kind": {
              "const": "sealed-terminal",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/CursorEndV1"
            }
          },
          "required": [
            "kind",
            "input",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "boundaryVectorDigest": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/CursorEndV1"
            },
            "kind": {
              "const": "visible",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/CursorEndV1"
            }
          },
          "required": [
            "kind",
            "input",
            "boundaryVectorDigest",
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "ProofNodeIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "classId": {
          "type": "string"
        },
        "classVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "nodePlanHash": {
          "type": "string"
        },
        "position": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "position",
        "classId",
        "classVersion",
        "nodePlanHash"
      ],
      "type": "object"
    },
    "ProofVersionV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "commit"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/authorized-lease.query.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query rows and their authorization proof are one response boundary. The\nclient must commit both together or delete the attempted retained result.",
  "properties": {
    "authorizationWitness": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationWitnessRecordV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizedLease": {
      "$ref": "#/$defs/AuthorizedLease"
    },
    "completenessProof": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompletenessProofV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionInvocationFacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "items": true,
      "type": "array"
    },
    "version": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "rows",
    "authorizedLease"
  ],
  "title": "AuthorizedLeaseQueryResponse",
  "type": "object"
}
