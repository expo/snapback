{
  "$defs": {
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "AuthorizedLease": {
      "additionalProperties": false,
      "description": "Exact server-issued envelope.  `deny_unknown_fields` makes protocol v1\nclosed in both directions; additive fields require a new version.",
      "properties": {
        "activationHash": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "authorizedUntilServerMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "clientStoreId": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/AuthorizedLeaseData"
        },
        "issuedAtServerMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "keyId": {
          "description": "Opaque to the client; resolved against the server keyring, where an\nunknown key fails closed.",
          "type": "string"
        },
        "leaseId": {
          "type": "string"
        },
        "leaseRequestId": {
          "type": "string"
        },
        "mac": {
          "description": "Server-keyed HMAC-SHA-256 over every field plus target/app identity.\nThe schema pins only the canonical 256-bit base64url FORM — exactly\nwhat client custody validation checks; cryptographic validity is the\nserver verifier's (LLP 0053 §The lease, verification locus).",
          "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "providerKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerNotAfterMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        },
        "sessionIdAtIssue": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionNotAfterMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "leaseId",
        "leaseRequestId",
        "issuerId",
        "clientStoreId",
        "queryKey",
        "queryInstanceId",
        "principalId",
        "authorization",
        "data",
        "activationHash",
        "issuedAtServerMs",
        "authorizedUntilServerMs",
        "keyId",
        "mac"
      ],
      "type": "object"
    },
    "AuthorizedLeaseData": {
      "additionalProperties": false,
      "properties": {
        "snapshotCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "snapshotCommitVersion"
      ],
      "type": "object"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/authorized-lease.query.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query rows and their authorization proof are one response boundary. The\nclient must commit both together or delete the attempted retained result.",
  "properties": {
    "authorizedLease": {
      "$ref": "#/$defs/AuthorizedLease"
    },
    "rows": {
      "items": true,
      "type": "array"
    },
    "version": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "rows",
    "authorizedLease"
  ],
  "title": "AuthorizedLeaseQueryResponse",
  "type": "object"
}
