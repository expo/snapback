{
  "$defs": {
    "AuthContext": {
      "properties": {
        "permissions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream_initiator": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamInitiator"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "permissions"
      ],
      "type": "object"
    },
    "DeleteRequest": {
      "properties": {
        "auth": {
          "$ref": "#/$defs/AuthContext"
        },
        "collection": {
          "type": "string"
        },
        "connection_id": {
          "type": "string"
        },
        "custom_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_entry_generation": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_scope_epoch": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "collection",
        "scope",
        "connection_id",
        "auth"
      ],
      "type": "object"
    },
    "PublishRequest": {
      "properties": {
        "auth": {
          "$ref": "#/$defs/AuthContext"
        },
        "collection": {
          "type": "string"
        },
        "connection_id": {
          "type": "string"
        },
        "custom_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ttl_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "collection",
        "scope",
        "connection_id",
        "value",
        "auth"
      ],
      "type": "object"
    },
    "StreamInitiator": {
      "description": "Stable privacy identity for a streaming action. Session reconnects compare\nthe user id, service reconnects the credential id, while anonymous access\nremains connection-bound.\n\n@ref LLP 0204#d91--streaming-conversations — possession of a\nroom key is never stream read authority.",
      "oneOf": [
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "session_user",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "service_credential",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "anonymous_connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        }
      ]
    },
    "SubscribeRequest": {
      "properties": {
        "auth": {
          "$ref": "#/$defs/AuthContext"
        },
        "collection": {
          "type": "string"
        },
        "connection_id": {
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "sinceChunk": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "collection",
        "scope",
        "connection_id",
        "auth"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.socket-client.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A message a client sends on the live WebSocket. Tagged with `type` (not\n`kind`) — the client→server family predates the typed wire and deployed\nclients send it this way.\n\nThe exhaustive registration of these variants as app-data operations is\nenforced by `live_socket_operation_name` in `src/server.rs`.\n\n@ref LLP 0031#enforcement — every accepted socket variant must be a\n  registered app-data operation.",
  "oneOf": [
    {
      "properties": {
        "request": {
          "$ref": "#/$defs/SubscribeRequest"
        },
        "requestId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "ephemeral_subscribe",
          "type": "string"
        }
      },
      "required": [
        "type",
        "request"
      ],
      "type": "object"
    },
    {
      "properties": {
        "request": {
          "$ref": "#/$defs/PublishRequest"
        },
        "requestId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "ephemeral_publish",
          "type": "string"
        }
      },
      "required": [
        "type",
        "request"
      ],
      "type": "object"
    },
    {
      "properties": {
        "request": {
          "$ref": "#/$defs/DeleteRequest"
        },
        "requestId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "ephemeral_delete",
          "type": "string"
        }
      },
      "required": [
        "type",
        "request"
      ],
      "type": "object"
    },
    {
      "description": "Stop observing a room (ENG-22527 item 3 / SECURITY). Carried over the\nshared live socket rather than a public HTTP route so the socket's\nconnection identity binds the requester: a participant cannot evict\nanother connection's subscription by asserting its id.",
      "properties": {
        "request": {
          "$ref": "#/$defs/SubscribeRequest"
        },
        "requestId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "ephemeral_unsubscribe",
          "type": "string"
        }
      },
      "required": [
        "type",
        "request"
      ],
      "type": "object"
    },
    {
      "description": "Application-level liveness probe (LLP 0034 D1, Exact LLP 0284 §2.2).\nStateless: no connection state is read or touched.",
      "properties": {
        "requestId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "ping",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "LiveSocketClientMessage"
}
