{
  "$defs": {
    "ResourceLimit": {
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResourceLimitStatus"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "ResourceLimitStatus": {
      "enum": [
        "Enforced",
        "Advisory",
        "Missing"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifactKind": {
      "default": "capabilityManifest",
      "type": "string"
    },
    "assetUpload": {
      "type": "boolean"
    },
    "authImpersonation": {
      "type": "boolean"
    },
    "capabilityGaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cron": {
      "type": "boolean"
    },
    "ephemeralHostedAdapter": {
      "default": false,
      "type": "boolean"
    },
    "ephemeralLocalRoomAuthority": {
      "default": false,
      "type": "boolean"
    },
    "ephemeralRealtime": {
      "default": false,
      "type": "boolean"
    },
    "ephemeralWebSocketPublish": {
      "default": false,
      "type": "boolean"
    },
    "liveSubscriptions": {
      "type": "boolean"
    },
    "localServerLifecycle": {
      "type": "boolean"
    },
    "mutationIsolationMode": {
      "type": "string"
    },
    "notifications": {
      "type": "boolean"
    },
    "offlineRetention": {
      "type": "boolean"
    },
    "onlineOnlyQueries": {
      "type": "boolean"
    },
    "optimisticReplay": {
      "type": "boolean"
    },
    "outboundActions": {
      "type": "boolean"
    },
    "permissionDiagnostics": {
      "type": "boolean"
    },
    "portabilityOptOuts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "replaceOnlyQueries": {
      "type": "boolean"
    },
    "resourceLimits": {
      "items": {
        "$ref": "#/$defs/ResourceLimit"
      },
      "type": "array"
    },
    "runtimeEngine": {
      "type": "string"
    },
    "schemaVersion": {
      "default": "snapback.v0",
      "type": "string"
    },
    "storageEngine": {
      "type": "string"
    },
    "supportedQueryForms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "syncableLiveQueries": {
      "type": "boolean"
    },
    "targetProfileId": {
      "type": "string"
    },
    "vmLifecycle": {
      "default": "fresh-per-invocation",
      "description": "VM lifecycle for handler execution: `\"fresh-per-invocation\"` (the\ndurable default and the only hosted posture) or `\"warm-pooled-reset\"`\n(the DK-4 trusted-local optimization — VM reuse per bundle behind a\nverified per-invocation reset). Surfaced so LLP 0012's honesty rule\nholds: an agent can see which execution semantics are in force.\n\n@ref LLP 0009#dk-4-as-built--the-warm-vm-pool-and-its-per-invocation-reset-2026-07-02 — capability flag.",
      "type": "string"
    }
  },
  "required": [
    "targetProfileId",
    "storageEngine",
    "runtimeEngine",
    "localServerLifecycle",
    "liveSubscriptions",
    "syncableLiveQueries",
    "onlineOnlyQueries",
    "replaceOnlyQueries",
    "offlineRetention",
    "optimisticReplay",
    "mutationIsolationMode",
    "authImpersonation",
    "permissionDiagnostics",
    "assetUpload",
    "outboundActions",
    "cron",
    "notifications",
    "supportedQueryForms",
    "portabilityOptOuts",
    "resourceLimits",
    "capabilityGaps"
  ],
  "title": "CapabilityManifest",
  "type": "object"
}
