{
  "$defs": {
    "ArtifactVersion": {
      "description": "A schema/function artifact version understood by the auth-aware receiver.\nCapability manifests report the dimensions separately for discovery, but\n[`SupportedArtifactAuthPair`] remains the actual compatibility authority.",
      "enum": [
        "snapback.v0",
        "snapback.v1"
      ],
      "type": "string"
    },
    "AuthMode": {
      "description": "The authority mode declared by a schema artifact. The enum is deliberately\nclosed: a mode changes who is allowed to supply invocation authority and an\nunknown spelling therefore cannot be treated as an additive field.\n\n@ref LLP 0058#closed-auth-mode — auth mode is a must-understand closed value.",
      "enum": [
        "dev",
        "sessions"
      ],
      "type": "string"
    },
    "AuthProtocols": {
      "additionalProperties": false,
      "description": "Version-1 auth protocol numbers reported by an auth-aware target.",
      "properties": {
        "bootstrap": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "invocation": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stagedMode": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "invocation",
        "stagedMode",
        "bootstrap"
      ],
      "type": "object"
    },
    "AuthenticationThrottle": {
      "enum": [
        "unavailable",
        "processLocal",
        "sharedEnforced"
      ],
      "type": "string"
    },
    "BrowserCredentialPosture": {
      "description": "The strongest browser credential claim the target can honestly advertise.\n\nA restrictive CSP does not upgrade bearer v1: app-origin script can still\nread or exercise the coordinator's IndexedDB/page-memory credential.",
      "enum": [
        "unavailable",
        "bearerV1XssExposed",
        "senderConstrainedV2"
      ],
      "type": "string"
    },
    "EffectiveSource": {
      "enum": [
        "unavailable",
        "trusted"
      ],
      "type": "string"
    },
    "ExternalTls": {
      "enum": [
        "unavailable",
        "enforced"
      ],
      "type": "string"
    },
    "HostedAuthCapabilities": {
      "additionalProperties": false,
      "description": "Closed hosted-auth capability descriptor authored by the serving target.\n\n@ref LLP 0060#d5-hosted-readiness-is-conjunctive — every deployment fact\nand the browser credential posture is independent and fail-closed.",
      "properties": {
        "authenticationThrottle": {
          "$ref": "#/$defs/AuthenticationThrottle"
        },
        "clientCredentialPosture": {
          "$ref": "#/$defs/BrowserCredentialPosture"
        },
        "effectiveSource": {
          "$ref": "#/$defs/EffectiveSource"
        },
        "externalTls": {
          "$ref": "#/$defs/ExternalTls"
        },
        "sessionInvalidation": {
          "$ref": "#/$defs/SessionInvalidation"
        }
      },
      "required": [
        "externalTls",
        "effectiveSource",
        "authenticationThrottle",
        "sessionInvalidation",
        "clientCredentialPosture"
      ],
      "type": "object"
    },
    "ResourceLimit": {
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResourceLimitStatus"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "ResourceLimitStatus": {
      "enum": [
        "Enforced",
        "Advisory",
        "Missing"
      ],
      "type": "string"
    },
    "SessionInvalidation": {
      "enum": [
        "unavailable",
        "singleProcess",
        "globallyFenced"
      ],
      "type": "string"
    },
    "SupportedArtifactAuthPair": {
      "additionalProperties": false,
      "description": "One explicitly supported schema/function-version and auth-mode tuple.\nSeparate version/mode arrays are dimension reports and never imply a\nCartesian-product authorization.\n\n@ref LLP 0058#the-two-admissible-tuples — exactly v0+dev and v1+sessions.",
      "properties": {
        "authMode": {
          "$ref": "#/$defs/AuthMode"
        },
        "schemaVersion": {
          "$ref": "#/$defs/ArtifactVersion"
        }
      },
      "required": [
        "schemaVersion",
        "authMode"
      ],
      "type": "object"
    },
    "TargetCapabilityId": {
      "description": "The exact target-capability vocabulary understood by paired-v1 manifests.\nApp artifacts retain string fields for v0 compatibility; every v1 string\nis parsed through this enum before target support is consulted.\n\n@ref LLP 0058#the-two-admissible-tuples — the v1 registry is closed to eight ids.",
      "enum": [
        "auth.sessions.v1",
        "cron",
        "cron_action_run_mutation",
        "host_plan_runtime",
        "ibex_ctx_db_host_bridge",
        "live_subscriptions",
        "mutation_read_set_validation",
        "permission_epoch_resync"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/capability.manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifactKind": {
      "default": "capabilityManifest",
      "type": "string"
    },
    "assetUpload": {
      "type": "boolean"
    },
    "authImpersonation": {
      "type": "boolean"
    },
    "authProtocols": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthProtocols"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilityGaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "cron": {
      "type": "boolean"
    },
    "ephemeralHostedAdapter": {
      "default": false,
      "type": "boolean"
    },
    "ephemeralLocalRoomAuthority": {
      "default": false,
      "type": "boolean"
    },
    "ephemeralRealtime": {
      "default": false,
      "type": "boolean"
    },
    "ephemeralWebSocketPublish": {
      "default": false,
      "type": "boolean"
    },
    "hostedAuth": {
      "$ref": "#/$defs/HostedAuthCapabilities",
      "default": {
        "authenticationThrottle": "processLocal",
        "clientCredentialPosture": "bearerV1XssExposed",
        "effectiveSource": "unavailable",
        "externalTls": "unavailable",
        "sessionInvalidation": "singleProcess"
      },
      "description": "Target-authored deployment and browser-security facts. App artifacts\nand operator input may consume this descriptor but cannot assert it.\n\n@ref LLP 0060#d5-hosted-readiness-is-conjunctive — hosted auth is an\nexact conjunction; local loopback and production profile are not facts."
    },
    "liveSubscriptions": {
      "type": "boolean"
    },
    "localServerLifecycle": {
      "type": "boolean"
    },
    "mutationIsolationMode": {
      "type": "string"
    },
    "notifications": {
      "type": "boolean"
    },
    "offlineRetention": {
      "type": "boolean"
    },
    "onlineOnlyQueries": {
      "type": "boolean"
    },
    "optimisticReplay": {
      "type": "boolean"
    },
    "outboundActions": {
      "type": "boolean"
    },
    "permissionDiagnostics": {
      "type": "boolean"
    },
    "portabilityOptOuts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "replaceOnlyQueries": {
      "type": "boolean"
    },
    "resourceLimits": {
      "items": {
        "$ref": "#/$defs/ResourceLimit"
      },
      "type": "array"
    },
    "runtimeEngine": {
      "type": "string"
    },
    "runtimeFacts": {
      "description": "Target-computed runtime facts (LLP 0048 §Single-sourced runtime flags,\nDK-5 capability truthfulness): the workerd release id, pinned\ncompatibility date and flags, kill-domain shape, and computed limit\nvalues. Absent on targets that assert their limits statically."
    },
    "schemaVersion": {
      "default": "snapback.v0",
      "type": "string"
    },
    "storageEngine": {
      "type": "string"
    },
    "supportedArtifactAuthPairs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SupportedArtifactAuthPair"
      },
      "type": "array"
    },
    "supportedArtifactVersions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactVersion"
      },
      "type": "array"
    },
    "supportedAuthModes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AuthMode"
      },
      "type": "array"
    },
    "supportedCapabilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TargetCapabilityId"
      },
      "type": "array"
    },
    "supportedQueryForms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "syncableLiveQueries": {
      "type": "boolean"
    },
    "targetProfileId": {
      "type": "string"
    },
    "vmLifecycle": {
      "default": "fresh-per-invocation",
      "description": "VM lifecycle for handler execution: `\"fresh-per-invocation\"` (the\ndurable default and the only hosted posture) or `\"warm-pooled-reset\"`\n(the DK-4 trusted-local optimization — VM reuse per bundle behind a\nverified per-invocation reset). Surfaced so LLP 0012's honesty rule\nholds: an agent can see which execution semantics are in force.\n\n@ref LLP 0009#dk-4-as-built--the-warm-vm-pool-and-its-per-invocation-reset-2026-07-02 — capability flag.",
      "type": "string"
    }
  },
  "required": [
    "targetProfileId",
    "storageEngine",
    "runtimeEngine",
    "localServerLifecycle",
    "liveSubscriptions",
    "syncableLiveQueries",
    "onlineOnlyQueries",
    "replaceOnlyQueries",
    "offlineRetention",
    "optimisticReplay",
    "mutationIsolationMode",
    "authImpersonation",
    "permissionDiagnostics",
    "assetUpload",
    "outboundActions",
    "cron",
    "notifications",
    "supportedQueryForms",
    "portabilityOptOuts",
    "resourceLimits",
    "capabilityGaps"
  ],
  "title": "CapabilityManifest",
  "type": "object"
}
