{
  "$defs": {
    "BranchGrantV1": {
      "additionalProperties": false,
      "properties": {
        "allowedFunctions": {
          "description": "Closed allowlists inherited from the creator's current grant. Empty\nmeans no authority, never wildcard authority.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audience": {
          "type": "string"
        },
        "authorityFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "expiresAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "grantId": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        }
      },
      "required": [
        "principalId",
        "grantId",
        "audience",
        "authorityFingerprint",
        "allowedFunctions",
        "allowedLanes",
        "expiresAtMs"
      ],
      "type": "object"
    },
    "BranchId": {
      "description": "Stable identity of an ephemeral branch within one logical app.",
      "type": "string"
    },
    "BranchLimitsV1": {
      "additionalProperties": false,
      "properties": {
        "maxDiffRows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxDigestWorkBytes": {
          "description": "Maximum canonical JSON bytes admitted to one exact-diff derivation.\nThis bounds the base/head oracle, retained journal, attribution, and\nnet-diff inputs before the receipt digest is computed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxLiveBranchesPerApp": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxLiveBranchesPerPrincipal": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxOperations": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxRetainedBytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "ttlMs": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "maxLiveBranchesPerPrincipal",
        "maxLiveBranchesPerApp",
        "maxOperations",
        "maxRetainedBytes",
        "maxDiffRows",
        "maxDigestWorkBytes",
        "ttlMs"
      ],
      "type": "object"
    },
    "BranchRecord": {
      "description": "A registered ephemeral branch.",
      "properties": {
        "base_stream": {
          "description": "Canonical data-version-stream identity the branch forked from.",
          "type": "string"
        },
        "base_version": {
          "description": "Canonical version the branch forked from — its compare-and-swap base for\npromotion.\n\n@ref LLP 0097#5 — v1\npromotion requires the canonical head to equal `base_version`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "branch_id": {
          "$ref": "#/$defs/BranchId"
        },
        "child_stream_id": {
          "$ref": "#/$defs/ChildStreamId"
        },
        "created_at_ms": {
          "description": "Server-clock creation time (caller-supplied; the store never reads a wall\nclock, per Snapback's injected-clock discipline).",
          "format": "int64",
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/BranchState"
        },
        "ttl_ms": {
          "description": "Optional TTL for ephemeral teardown (LLP 0097 §4). `None` = no TTL.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "branch_id",
        "child_stream_id",
        "base_version",
        "base_stream",
        "state",
        "created_at_ms"
      ],
      "type": "object"
    },
    "BranchState": {
      "description": "Lifecycle state of a branch.",
      "oneOf": [
        {
          "const": "Active",
          "description": "Live: divergent reads/writes resolve against the branch overlay.",
          "type": "string"
        },
        {
          "const": "TearingDown",
          "description": "Marked for teardown; admits no new work. Cleared by GC (LLP 0097 §4).",
          "type": "string"
        }
      ]
    },
    "ChildStreamId": {
      "description": "Identity of a branch's typed ephemeral **child version-stream**.\n\n@ref LLP 0097#1-the-branch-is-an-ephemeral-child-of-a-logical-app — the\nnormative amendment to LLP 0007/0018: a logical app owns one canonical stream\nplus zero-or-more typed ephemeral child streams. A child stream's versions are\nnever numerically comparable to the canonical stream; `base_version` is a fork\npointer, not a shared coordinate.",
      "type": "string"
    },
    "ForkCoverageV1": {
      "additionalProperties": false,
      "properties": {
        "assetsCovered": {
          "type": "boolean"
        },
        "coveredLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "effectsCovered": {
          "type": "boolean"
        },
        "schemaCovered": {
          "type": "boolean"
        },
        "systemFieldsCovered": {
          "type": "boolean"
        },
        "uncoveredLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "coveredLanes",
        "uncoveredLanes",
        "schemaCovered",
        "systemFieldsCovered",
        "assetsCovered",
        "effectsCovered"
      ],
      "type": "object"
    },
    "ForkEgressPolicyV1": {
      "enum": [
        "denyAll",
        "captureOnly"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/branch.receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch": {
      "$ref": "#/$defs/BranchRecord"
    },
    "coverage": {
      "$ref": "#/$defs/ForkCoverageV1"
    },
    "denyAllAttemptCount": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "egressPolicy": {
      "$ref": "#/$defs/ForkEgressPolicyV1"
    },
    "foreclosedByOperationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "grant": {
      "$ref": "#/$defs/BranchGrantV1"
    },
    "limits": {
      "$ref": "#/$defs/BranchLimitsV1"
    },
    "promotable": {
      "type": "boolean"
    },
    "retainedOperationBytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "retainedOperationCount": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "branch",
    "grant",
    "limits",
    "coverage",
    "egressPolicy",
    "promotable",
    "retainedOperationCount",
    "retainedOperationBytes",
    "denyAllAttemptCount"
  ],
  "title": "InAppBranchReceiptV1",
  "type": "object"
}
