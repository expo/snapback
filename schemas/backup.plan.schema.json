{
  "$defs": {
    "BackupPlanStep": {
      "enum": [
        "verifyIdentity",
        "acquireLease",
        "createVerifiedBackup",
        "releaseLease"
      ],
      "type": "string"
    },
    "ReleaseGap": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "blocking"
      ],
      "type": "object"
    },
    "TargetProductionClass": {
      "enum": [
        "preview",
        "production"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/backup.plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact proposal for creating and read-back-verifying one immutable backup.\n\n@ref LLP 0072#backup-and-restore — backup identity, consistency, component\nverification, secret exclusion, and retention are explicit control facts.",
  "properties": {
    "applyEligible": {
      "type": "boolean"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/ReleaseGap"
      },
      "type": "array"
    },
    "confirmation": {
      "type": "string"
    },
    "createdAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "databaseId": {
      "type": "string"
    },
    "deploymentId": {
      "type": "string"
    },
    "environmentId": {
      "type": "string"
    },
    "expiresAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "observedActivationGeneration": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "observedActiveReleaseId": {
      "type": "string"
    },
    "observedSchemaGeneration": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "operationId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "productionClass": {
      "$ref": "#/$defs/TargetProductionClass"
    },
    "projectId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "retentionPolicy": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/BackupPlanStep"
      },
      "type": "array"
    },
    "streamIncarnation": {
      "type": "string"
    },
    "targetDescriptorSha256": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "targetObservationSha256": {
      "type": "string"
    },
    "targetProfileId": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "operationId",
    "reason",
    "targetId",
    "projectId",
    "environmentId",
    "deploymentId",
    "databaseId",
    "streamIncarnation",
    "targetProfileId",
    "productionClass",
    "targetDescriptorSha256",
    "targetObservationSha256",
    "observedActivationGeneration",
    "observedActiveReleaseId",
    "observedSchemaGeneration",
    "retentionPolicy",
    "steps",
    "blockers",
    "applyEligible",
    "confirmation",
    "createdAtMs",
    "expiresAtMs"
  ],
  "title": "BackupPlan",
  "type": "object"
}
