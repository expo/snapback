{
  "$defs": {
    "ArtifactGeneration": {
      "additionalProperties": false,
      "description": "Content-derived identity of one coherent schema/function artifact pair.\nIt deliberately excludes the process-local publication counter: callers\nlearn these values from generated artifacts and can refetch them after a\ndeployment race.",
      "properties": {
        "appId": {
          "minLength": 1,
          "type": "string"
        },
        "bundleHash": {
          "minLength": 1,
          "type": "string"
        },
        "inputsHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "appId",
        "schemaHash",
        "bundleHash",
        "inputsHash"
      ],
      "type": "object"
    },
    "AuthInput": {
      "properties": {
        "principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CompletenessProofV1": {
      "additionalProperties": false,
      "properties": {
        "activationHash": {
          "type": "string"
        },
        "authorizationWitnessDigest": {
          "type": "string"
        },
        "batchIdentity": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "materializationKey": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ProofNodeIdentityV1"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PageIdentityV1"
        },
        "planHash": {
          "type": "string"
        },
        "proofKeyId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resultDigest": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/ProofVersionV1"
        }
      },
      "required": [
        "format",
        "materializationKey",
        "queryInstanceId",
        "activationHash",
        "planHash",
        "version",
        "authorizationWitnessDigest",
        "page",
        "nodes",
        "batchIdentity",
        "resultDigest",
        "proofKeyId",
        "signature"
      ],
      "type": "object"
    },
    "CtxAnswerLedger": {
      "description": "The ctx-answer ledger (LLP 0051 D1): the ordered answers the deterministic\nctx surface gave during one invocation. Record mode produces it; replay\nmode consumes it. Reads are never ledgered — `ctx.db` reads always\nre-evaluate against the executing tier's current view; the ledger pins\n*answers* only. This is LLP 0043 M2's captured replay environment as a\ndefined channel: LLP 0008 pins the client wire to exactly\n`{generatedIds, now}`; the auth fingerprint is server-retained and never\ncrosses the client wire.",
      "properties": {
        "auth_fingerprint": {
          "description": "Fingerprint of the resolved auth context the handler observed\n(LLP 0043 §Auth posture). Checked at replay when present: a mismatch\nsurfaces `SNAPBACK_AUTH_STALE_RESULT` rather than replaying under new\nauthority. Server-retained (D1 wire split) — record-mode outputs leave\nit unset on client-bound surfaces.",
          "type": [
            "string",
            "null"
          ]
        },
        "ids": {
          "default": [],
          "description": "Every host-generated id, in answer order (LLP 0008's `generatedIds`):\n`ctx.runtime.id()` answers and `ctx.db.insert` row-id generation share\none ordered sequence.",
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
            "type": "string"
          },
          "maxItems": 1024,
          "type": "array"
        },
        "now": {
          "default": 0,
          "description": "The frozen invocation clock every `ctx.runtime.now()` answered with.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "default": 1,
          "description": "Ledger format version, versioned alongside the shared data-tier\nprofile (LLP 0051 D5) so pre-extension ledgers stay replayable.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CursorEndV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "first",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "const": "cursor",
              "type": "string"
            },
            "profileId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "profileId",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "PageIdentityV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/CursorEndV1"
            },
            "kind": {
              "const": "sealed-terminal",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/CursorEndV1"
            }
          },
          "required": [
            "kind",
            "input",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "boundaryVectorDigest": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/CursorEndV1"
            },
            "kind": {
              "const": "visible",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/CursorEndV1"
            }
          },
          "required": [
            "kind",
            "input",
            "boundaryVectorDigest",
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "ProofNodeIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "classId": {
          "type": "string"
        },
        "classVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "nodePlanHash": {
          "type": "string"
        },
        "position": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "position",
        "classId",
        "classVersion",
        "nodePlanHash"
      ],
      "type": "object"
    },
    "ProofVersionV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "commit"
      ],
      "type": "object"
    },
    "QueryNamespace": {
      "additionalProperties": false,
      "properties": {
        "clientStoreId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        }
      },
      "required": [
        "clientStoreId",
        "queryKey",
        "queryInstanceId"
      ],
      "type": "object"
    },
    "ReadDependency": {
      "properties": {
        "id": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "table",
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/query.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ordinary finite-query request. The legacy function-call fields remain\nflattened; the optional completeness context is query-only and never\nwidens the action request family.",
  "properties": {
    "args": {
      "default": null
    },
    "auth": {
      "$ref": "#/$defs/AuthInput",
      "default": {
        "principal": null,
        "session_id": null,
        "user_id": null
      }
    },
    "completenessNamespace": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryNamespace"
        },
        {
          "type": "null"
        }
      ],
      "description": "Non-authorizing finite completeness namespace. Old callers omit it and\nreceive the pre-amendment response shape."
    },
    "correlation": {
      "description": "Opaque adapter-stitched correlation (LLP 0034 §3.2, ENG-22478): the\nExact adapter's join keys (`actionInvocationId`, `optimisticWaveId`,\n`rootId`, `bindingIds`) live inside. The provider echoes it verbatim\non receipts and never interprets it."
    },
    "ctx_ledger": {
      "anyOf": [
        {
          "$ref": "#/$defs/CtxAnswerLedger"
        },
        {
          "type": "null"
        }
      ],
      "description": "Replay ledger (LLP 0051 D1): when present, the invocation runs in\nREPLAY mode — `ctx.runtime.now()` answers `ledger.now` and every\nhost-generated id (`ctx.runtime.id()` and `ctx.db.insert` row ids)\nconsumes `ledger.ids` in order. Consuming past the end is a typed\ndivergence error. Additive: absent means record mode, today's\nbehavior. Queries and mutations only; actions never carry one."
    },
    "expectedGeneration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactGeneration"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional caller assertion checked only by sessions targets. Absence is\nthe backwards-compatible unchecked path.\n\n@ref LLP 0012#call-time-generation-binding — selection and generation\n  comparison are one server admission operation."
    },
    "priorCompletenessProofs": {
      "description": "Already-held ordered proofs used only to compose a terminal\nsnapshot-batch page-set manifest. Every entry is signature-verified\nbefore use; the server never treats the array as authority.",
      "items": {
        "$ref": "#/$defs/CompletenessProofV1"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "read_set": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReadDependency"
      },
      "type": "array"
    },
    "streamConnectionId": {
      "description": "Anonymous streaming actions bind their private room to an already-open\nconnection grant. Authenticated callers omit this: their resolved user\nor service credential is the reconnect-stable initiator identity.\n\n@ref LLP 0204#d91--streaming-conversations — anonymous\nstreams are connection-private rather than bearer-by-room-name.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "FiniteQueryRequest",
  "type": "object"
}
