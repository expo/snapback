{
  "$defs": {
    "ApiEnvelopeDeclarationsV1": {
      "additionalProperties": false,
      "description": "The app-only binding declarations the envelope publishes.\n\nDeliberately distinct from the local merged `types` output (LLP 0062\nround-10 residue #9): `appBindings` is the app's own generated surface,\ncarries no merged framework declarations, and is what a served consumer\nmaterializes. The merged local output stays a checkout-side artifact.",
      "properties": {
        "appBindings": {
          "type": "string"
        }
      },
      "required": [
        "appBindings"
      ],
      "type": "object"
    },
    "ApiEnvelopeOperationV1": {
      "additionalProperties": false,
      "description": "One operation's argument schema, keyed by the function's stable id.",
      "properties": {
        "argsSchema": true,
        "name": {
          "description": "The exported function name, for human-facing surfaces only. Selection\nis always by stable id.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "argsSchema"
      ],
      "type": "object"
    },
    "ApiEnvelopeTupleV1": {
      "additionalProperties": false,
      "description": "The artifact tuple this envelope belongs to (LLP 0012's closed set).",
      "properties": {
        "authMode": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "authMode"
      ],
      "type": "object"
    },
    "ApiFunctionApproval": {
      "description": "Approval posture for externally reachable durable effects.\n\n`required` gates every caller. `external` preserves direct first-party\nsession calls while gating service-principal, integration, and link lanes.",
      "enum": [
        "required",
        "external"
      ],
      "type": "string"
    },
    "ApiFunctionExposure": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiFunctionApproval"
            },
            {
              "type": "null"
            }
          ]
        },
        "expose": {
          "default": false,
          "type": "boolean"
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AuthRequirement": {
      "description": "Function-level requirement applied after caller authority has been resolved.\nAbsence in a legacy function is represented by\n[`FunctionDefinition::effective_auth_requirement`] as `optional-user`.\n\n@ref LLP 0058#closed-function-requirement — closed values fail at manifest parse.",
      "enum": [
        "public",
        "optional-user",
        "authenticated"
      ],
      "type": "string"
    },
    "AuthorityProfileIdentityV1": {
      "additionalProperties": false,
      "description": "Stable identity of one authority-profile generation. Function manifests\ncarry this beside their ordinary authorization dimensions so a role-field\nor transition edit is visible to dependent artifact review without\nchanging the evaluator's existing membership predicate shape.",
      "properties": {
        "generation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "generation"
      ],
      "type": "object"
    },
    "AuthorizationInputDimension": {
      "description": "Closed caller-authority dimensions that a query result may depend on.\nRetention v1 accepts `userId` plus the effective principal `kind`, which is\nan immutable function of that identity; spelling the rejected dimensions\nis still important because a manifest must describe why it is online-only\nrather than silently erasing actor/session/provider/opaque dependence.\n\n@ref LLP 0053#retained-and-offline-authorization — retained rows survive a\n  same-user session replacement, so every other authority dimension is\n  deliberately ineligible.",
      "enum": [
        "userId",
        "kind",
        "actorKind",
        "isDelegated",
        "sessionId",
        "provider",
        "roles",
        "isAuthenticated",
        "opaque"
      ],
      "type": "string"
    },
    "BoundedSkewDeclaration": {
      "additionalProperties": false,
      "description": "Capture-time identity of one proposed bounded-skew declaration. Ticket 05\nadds manifest admission and execution semantics; ticket 02 makes changes\nfail closed under a reused mutation id immediately.",
      "properties": {
        "field": {
          "type": "string"
        },
        "maxSkewMs": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "field",
        "maxSkewMs"
      ],
      "type": "object"
    },
