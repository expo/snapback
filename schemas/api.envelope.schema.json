  "$id": "https://schemas.snapback.dev/snapback.v0/api.envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The served API envelope.\n\nThe nested `functions` projection is exactly the server-derived\n`PublicFunctionManifest` — admission requires byte equality with the\nprojection of the manifest being activated, so a provisioner cannot smuggle\nan unknown source-bearing member through a passthrough path.",
  "properties": {
    "appId": {
      "type": "string"
    },
    "artifactKind": {
      "type": "string"
    },
    "bundleHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "declarations": {
      "$ref": "#/$defs/ApiEnvelopeDeclarationsV1"
    },
    "formatVersion": {
      "type": "string"
    },
    "functions": {
      "$ref": "#/$defs/PublicFunctionManifest",
      "description": "Kept as a received value, never round-tripped through the typed\nprojection: deserializing and re-serializing could normalize away a\nsmuggled member, which is precisely the disclosure hole the\nexact-equality admission rule closes."
    },
    "inputsHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "memberDigests": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Per-member digests keyed by stable id (`operation:<id>`,\n`declaration:appBindings`). Envelope-local digests prove internal\nconsistency; the independently carried provision-side map proves the\nmember belongs to *this* function — grammar bounds structure, the\ndigest map binds semantics.",
      "type": "object"
    },
    "operations": {
      "additionalProperties": {
        "$ref": "#/$defs/ApiEnvelopeOperationV1"
      },
      "description": "Operation argument schemas keyed by stable function id.",
      "type": "object"
    },
    "tuple": {
      "$ref": "#/$defs/ApiEnvelopeTupleV1"
    }
  },
  "required": [
    "artifactKind",
    "formatVersion",
    "appId",
    "tuple",
    "functions",
    "operations",
    "declarations",
    "memberDigests"
  ],
  "title": "ApiEnvelopeV1",
  "type": "object"
}
