  "$id": "https://schemas.snapback.dev/snapback.v0/inspect.public.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The public projection of [`InspectState`] served at the root `/inspect` and\n`/`. It is a typed allowlist: the `From<InspectState>` below destructures the\nfull struct, so a newly-added `InspectState` (or `StorageInfo`,\n`LiveSubscriptionInfo`) field is a compile error here rather than a silent\nleak. Three facts are deliberately dropped and live only in the gated\n`/_snapback/api/inspect` twin: `subscriptions[].connection_id` (the\nenumerate-and-disconnect vector — LLP 0031 D2/D3), the absolute\n`storage.sqlite_path` (an environment leak), and the executable handler\nbodies inside `functions` (`IbexModule.source` / `HandlerPlan` bodies — a\nsource disclosure, ENG-23441; see [`PublicFunctionManifest`]).\n\n@ref LLP 0031#resolved-decisions — D3: public `/inspect` is trimmed to an identity descriptor; the trim is guarded by a typed projection.",
  "properties": {
    "activeConnections": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "artifactKind": {
      "type": "string"
    },
    "capabilityGaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capabilityManifest": {
      "$ref": "#/$defs/CapabilityManifest"
    },
    "cron": {
      "$ref": "#/$defs/CronInspectState"
    },
    "ephemeral": {
      "$ref": "#/$defs/EphemeralDiagnostics"
    },
    "functions": {
      "$ref": "#/$defs/PublicFunctionManifest"
    },
    "liveDelivery": {
      "$ref": "#/$defs/LiveDeliveryStats"
    },
    "reapedConnections": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "recentDiagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeCapabilities"
    },
    "schema": {
      "$ref": "#/$defs/SchemaManifest"
    },
    "schemaVersion": {
      "type": "string"
    },
    "storage": {
      "$ref": "#/$defs/PublicStorageInfo"
    },
    "subscriptions": {
      "items": {
        "$ref": "#/$defs/PublicSubscriptionInfo"
      },
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "targetProfileId": {
      "type": "string"
    }
  },
