          "$ref": "#/$defs/DependencySummary"
        }
      },
      "required": [
        "name",
        "kind",
        "requiredCapabilities",
        "readSetSummary",
        "writeSetSummary",
        "permissionEpochBumps",
        "uses",
        "runtime"
      ],
      "type": "object"
    },
    "PublicFunctionManifest": {
      "description": "The public projection of [`FunctionManifest`] served inside the root\n`/inspect` identity descriptor. Like `PublicInspect` it is a typed\nallowlist: the `From` impls below destructure the full structs exhaustively,\nso a newly-added field is a compile error here rather than a silent leak.\n\nWhat it keeps: identity/compat and dependency facts — app id, bundle/inputs\nhashes, function names/kinds/capability summaries, read/write summaries,\ncron and config *declarations* (never values; secrets do not ride the\nmanifest — LLP 0036). What it drops: every executable handler body\n(`IbexModule.source`, `HandlerPlan` step bodies), every function/cron/config\n`sourceSpan` (a source-path leak), and free-form unsupported-dependency\ndiagnostic message/details. Full operational context stays only on the gated\n`/_snapback/api/inspect` twin.\n\n@ref LLP 0031#resolved-decisions — D3: public `/inspect` is an identity\n  descriptor; handler source and plan bodies are operational facts for the\n  gated twin only (ENG-23441).",
      "properties": {
        "appId": {
          "type": "string"
        },
        "artifactKind": {
          "type": "string"
        },
        "bundleHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "items": {
            "$ref": "#/$defs/PublicConfigEntryDefinition"
          },
          "type": "array"
        },
        "cronJobs": {
          "items": {
            "$ref": "#/$defs/PublicCronJobDefinition"
          },
          "type": "array"
        },
        "functions": {
          "items": {
            "$ref": "#/$defs/PublicFunctionDefinition"
          },
          "type": "array"
        },
        "generatedAt": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "inputsHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "schemaVersion": {
          "type": "string"
        },
