{
  "$defs": {
    "AccessPolicy": {
      "oneOf": [
        {
          "enum": [
            "AllowAll"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "RequireRoomPermission": {
              "properties": {
                "prefix": {
                  "type": "string"
                }
              },
              "required": [
                "prefix"
              ],
              "type": "object"
            }
          },
          "required": [
            "RequireRoomPermission"
          ],
          "type": "object"
        }
      ]
    },
    "AppIdentity": {
      "description": "Optional presentation identity for the loaded app: how the instance should\nintroduce itself to a human. Everything here is public by construction — it\nis rendered on the public root page and flows into the public inspect\nprojection — so apps must not put secrets in it. The icon/wordmark URLs are\nordinary app-served or absolute URLs; the root page renders them as plain\n`<img>` references with attribute escaping.\n\n@ref LLP 0017#instance-home-page — the root page renders this identity when\n  the manifest declares it; absent, the page is Snapback-branded only.",
      "properties": {
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "iconUrl": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "wordmarkUrl": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CapabilityManifest": {
      "properties": {
        "artifactKind": {
          "default": "capabilityManifest",
          "type": "string"
        },
        "assetUpload": {
          "type": "boolean"
        },
        "authImpersonation": {
          "type": "boolean"
        },
        "capabilityGaps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cron": {
          "type": "boolean"
        },
        "ephemeralHostedAdapter": {
          "default": false,
          "type": "boolean"
        },
        "ephemeralLocalRoomAuthority": {
          "default": false,
          "type": "boolean"
        },
        "ephemeralRealtime": {
          "default": false,
          "type": "boolean"
        },
        "ephemeralWebSocketPublish": {
          "default": false,
          "type": "boolean"
        },
        "liveSubscriptions": {
          "type": "boolean"
        },
        "localServerLifecycle": {
          "type": "boolean"
        },
        "mutationIsolationMode": {
          "type": "string"
        },
        "notifications": {
          "type": "boolean"
        },
        "offlineRetention": {
          "type": "boolean"
        },
        "onlineOnlyQueries": {
          "type": "boolean"
        },
        "optimisticReplay": {
          "type": "boolean"
        },
        "outboundActions": {
          "type": "boolean"
        },
        "permissionDiagnostics": {
          "type": "boolean"
        },
        "portabilityOptOuts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "replaceOnlyQueries": {
          "type": "boolean"
        },
        "resourceLimits": {
          "items": {
            "$ref": "#/$defs/ResourceLimit"
          },
          "type": "array"
        },
        "runtimeEngine": {
          "type": "string"
        },
        "runtimeFacts": {
          "description": "Target-computed runtime facts (LLP 0048 §Single-sourced runtime flags,\nDK-5 capability truthfulness): the workerd release id, pinned\ncompatibility date and flags, kill-domain shape, and computed limit\nvalues. Absent on targets that assert their limits statically."
        },
        "schemaVersion": {
          "default": "snapback.v0",
          "type": "string"
        },
        "storageEngine": {
          "type": "string"
        },
        "supportedQueryForms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "syncableLiveQueries": {
          "type": "boolean"
        },
        "targetProfileId": {
          "type": "string"
        },
        "vmLifecycle": {
          "default": "fresh-per-invocation",
          "description": "VM lifecycle for handler execution: `\"fresh-per-invocation\"` (the\ndurable default and the only hosted posture) or `\"warm-pooled-reset\"`\n(the DK-4 trusted-local optimization — VM reuse per bundle behind a\nverified per-invocation reset). Surfaced so LLP 0012's honesty rule\nholds: an agent can see which execution semantics are in force.\n\n@ref LLP 0009#dk-4-as-built--the-warm-vm-pool-and-its-per-invocation-reset-2026-07-02 — capability flag.",
          "type": "string"
        }
      },
      "required": [
        "targetProfileId",
        "storageEngine",
        "runtimeEngine",
        "localServerLifecycle",
        "liveSubscriptions",
        "syncableLiveQueries",
        "onlineOnlyQueries",
        "replaceOnlyQueries",
        "offlineRetention",
        "optimisticReplay",
        "mutationIsolationMode",
        "authImpersonation",
        "permissionDiagnostics",
        "assetUpload",
        "outboundActions",
        "cron",
        "notifications",
        "supportedQueryForms",
        "portabilityOptOuts",
        "resourceLimits",
        "capabilityGaps"
      ],
      "type": "object"
    },
    "CapabilityState": {
      "enum": [
        "Available",
        "Unavailable",
        "NotYetWired"
      ],
      "type": "string"
    },
    "CronActivationKind": {
      "enum": [
        "Always",
        "WhileLive"
      ],
      "type": "string"
    },
    "CronActivationPolicy": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/CronActivationKind"
        },
        "whileLive": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CronJitterPolicy": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxOffsetMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "maxOffsetMs"
      ],
      "type": "object"
    },
    "CronOverlapPolicy": {
      "enum": [
        "NoOverlap",
        "Allow"
      ],
      "type": "string"
    },
    "CronRetryMode": {
      "enum": [
        "NextTick",
        "Backoff"
      ],
      "type": "string"
    },
    "CronRetryPolicy": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/CronRetryMode"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "CronSchedule": {
      "properties": {
        "cron": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "everyMs": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CronTargetWakeup": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/CronTargetWakeupKind"
        },
        "needsDurableRunner": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CronTargetWakeupKind": {
      "enum": [
        "IntervalMs",
        "CronExpression",
        "DynamicAlarm"
      ],
      "type": "string"
    },
    "DependencySummary": {
      "properties": {
        "authScopeField": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "primaryTable": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tables": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    },
    "EphemeralCollection": {
      "properties": {
        "burst": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "defaultTtlMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dispatchMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hardMaxValueBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keyMode": {
          "$ref": "#/$defs/KeyMode"
        },
        "maxPendingEphemeralKeys": {
          "default": 1024,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maxTtlMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxValueBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "publish": {
          "$ref": "#/$defs/AccessPolicy"
        },
        "routingFields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scopeFields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subscribe": {
          "$ref": "#/$defs/AccessPolicy"
        },
        "sustainedHz": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "keyMode",
        "routingFields",
        "defaultTtlMs",
        "maxTtlMs",
        "maxValueBytes",
        "hardMaxValueBytes",
        "sustainedHz",
        "burst",
        "dispatchMs",
        "publish",
        "subscribe"
      ],
      "type": "object"
    },
    "FieldManifest": {
      "properties": {
        "field_type": {
          "$ref": "#/$defs/FieldType"
        },
        "name": {
          "type": "string"
        },
        "optional": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "field_type"
      ],
      "type": "object"
    },
    "FieldType": {
      "enum": [
        "String",
        "Boolean",
        "Integer",
        "Real",
        "Json"
      ],
      "type": "string"
    },
    "FunctionKind": {
      "enum": [
        "Query",
        "Mutation",
        "LiveQuery",
        "Action"
      ],
      "type": "string"
    },
    "IndexManifest": {
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "type": "object"
    },
    "KeyMode": {
      "enum": [
        "Connection",
        "Session",
        "User",
        "Custom"
      ],
      "type": "string"
    },
    "LiveDeliveryStats": {
      "properties": {
        "lastDeliveries": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "lastFailed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "lastFanoutSubscriptions": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "lastSkipped": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "totalDeliveries": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalFailed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalFanoutAttempts": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "totalSkipped": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "totalFanoutAttempts",
        "totalDeliveries",
        "totalSkipped",
        "totalFailed",
        "lastFanoutSubscriptions",
        "lastDeliveries",
        "lastSkipped",
        "lastFailed"
      ],
      "type": "object"
    },
    "PermissionScopeExpr": {
      "oneOf": [
        {
          "enum": [
            "AuthUser"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Arg": {
              "type": "string"
            }
          },
          "required": [
            "Arg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Literal": {
              "type": "string"
            }
          },
          "required": [
            "Literal"
          ],
          "type": "object"
        }
      ]
    },
    "PublicConfigEntryDefinition": {
      "description": "Public config declaration. Values never ride the manifest; the source span\nis additionally removed because it reveals local build paths.",
      "properties": {
        "acquisition": true,
        "default": true,
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "howToGet": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "pool": {
          "type": "boolean"
        },
        "probe": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "secret",
        "required",
        "pool"
      ],
      "type": "object"
    },
    "PublicCronInspectState": {
      "description": "Public cron posture: aggregate state only. Run records, result values,\nerror messages, diagnostic details, run ids, and slot/idempotency keys stay\non the gated administrative inspect surface because handler-controlled text\ncan contain credentials or application data.",
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "failedJobCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "inFlightJobCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "jobCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "required": [
        "artifactKind",
        "schemaVersion",
        "jobCount",
        "failedJobCount",
        "inFlightJobCount"
      ],
      "type": "object"
    },
    "PublicCronJobDefinition": {
      "description": "Public cron declaration: scheduling posture without its source path.",
      "properties": {
        "action": {
          "type": "string"
        },
        "activation": {
          "$ref": "#/$defs/CronActivationPolicy"
        },
        "enabled": {
          "type": "boolean"
        },
        "jitterPolicy": {
          "$ref": "#/$defs/CronJitterPolicy"
        },
        "name": {
          "type": "string"
        },
        "overlapPolicy": {
          "$ref": "#/$defs/CronOverlapPolicy"
        },
        "requiredCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retryPolicy": {
          "$ref": "#/$defs/CronRetryPolicy"
        },
        "schedule": {
          "$ref": "#/$defs/CronSchedule"
        },
        "targetWakeup": {
          "anyOf": [
            {
              "$ref": "#/$defs/CronTargetWakeup"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "schedule",
        "action",
        "enabled",
        "activation",
        "jitterPolicy",
        "overlapPolicy",
        "retryPolicy",
        "requiredCapabilities"
      ],
      "type": "object"
    },
    "PublicDiagnostic": {
      "description": "Public diagnostic identity. Messages and structured details can contain\nsource paths, handler text, arguments, or other operator-only context, so\nunauthenticated inspection exposes only the stable classification fields.",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subsystem": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subsystem"
      ],
      "type": "object"
    },
