        "entryCount",
        "subscriberCount",
        "valueBytes",
        "retainedBytes",
        "outboxRetainedBytes",
        "pendingEphemeralKeys",
        "pendingDurableMessages",
        "pendingResyncMessages",
        "rejectedPublishes",
        "rateLimitedPublishes",
        "oversizedPublishes",
        "unauthorizedRequests",
        "metadataRejections",
        "expiredEntries",
        "disconnectedEntries",
        "coalescedUpdates",
        "resyncRequired",
        "outboxOverflows",
        "limitRejections"
      ],
      "type": "object"
    },
    "PublicFunctionDefinition": {
      "description": "Public projection of [`FunctionDefinition`]: everything except the\nexecutable runtime body and the source span.",
      "properties": {
        "authRequirement": {
          "type": [
            "string",
            "null"
          ]
        },
        "bundleEntrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "exportedName": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/FunctionKind"
        },
        "name": {
          "type": "string"
        },
        "permissionEpochBumps": {
          "items": {
            "$ref": "#/$defs/PermissionScopeExpr"
          },
