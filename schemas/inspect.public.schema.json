    "artifactKind",
    "schemaVersion",
    "targetProfileId",
    "target",
    "storage",
    "runtime",
    "schema",
    "functions",
    "capabilityManifest",
    "subscriptions",
    "activeConnections",
    "reapedConnections",
    "liveDelivery",
    "ephemeral",
    "cron",
    "recentDiagnostics",
    "capabilityGaps"
  ],
  "title": "PublicInspect",
  "type": "object"
