      "properties": {
        "coalescedUpdates": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "disconnectedEntries": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "entryCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "expiredEntries": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "limitRejections": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "metadataRejections": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outboxOverflows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outboxRetainedBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "oversizedPublishes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pendingDurableMessages": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pendingEphemeralKeys": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pendingResyncMessages": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rateLimitedPublishes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rejectedPublishes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resyncRequired": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retainedBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "roomCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "subscriberCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unauthorizedRequests": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "valueBytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
