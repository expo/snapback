  "$id": "https://schemas.snapback.dev/snapback.v0/inspect.public.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The public projection of [`InspectState`] served at the root `/inspect` and\n`/`. It is a typed allowlist: the `From<InspectState>` below destructures the\nfull struct, so a newly-added `InspectState` (or `StorageInfo`,\n`LiveSubscriptionInfo`) field is a compile error here rather than a silent\nleak. Sensitive facts are deliberately dropped and live only in the gated\n`/_snapback/api/inspect` twin: `subscriptions[].connection_id` (the\nenumerate-and-disconnect vector — LLP 0031 D2/D3), the absolute\n`storage.sqlite_path` and runtime executable/submodule paths (environment\nleaks), per-room ephemeral identities, mutation-retention internals, and the\nexecutable handler bodies inside `functions` (`IbexModule.source` /\n`HandlerPlan` bodies — a source disclosure, ENG-23441; see\n[`PublicFunctionManifest`]). Free-form diagnostic message/details and cron\nrun results are also gated because producers may include source paths or\napplication values.\n\n@ref LLP 0031#resolved-decisions — D3: public `/inspect` is trimmed to an identity descriptor; the trim is guarded by a typed projection.\n@ref LLP 0036#runtime-exposure-d5-d8 — secret-like runtime diagnostics are redacted before retention and never projected anonymously as raw text.",
  "properties": {
    "activeConnections": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "artifactKind": {
      "type": "string"
    },
    "capabilityGaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "capabilityManifest": {
      "$ref": "#/$defs/CapabilityManifest"
    },
    "cron": {
      "$ref": "#/$defs/PublicCronInspectState"
    },
    "ephemeral": {
      "$ref": "#/$defs/PublicEphemeralDiagnostics"
    },
    "functions": {
      "$ref": "#/$defs/PublicFunctionManifest"
    },
    "liveDelivery": {
      "$ref": "#/$defs/LiveDeliveryStats"
    },
    "reapedConnections": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "recentDiagnostics": {
      "items": {
        "$ref": "#/$defs/PublicDiagnostic"
      },
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/PublicRuntimeCapabilities"
    },
    "schema": {
      "$ref": "#/$defs/PublicSchemaManifest"
    },
    "schemaVersion": {
      "type": "string"
    },
    "storage": {
      "$ref": "#/$defs/PublicStorageInfo"
    },
    "subscriptions": {
      "items": {
        "$ref": "#/$defs/PublicSubscriptionInfo"
      },
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "targetProfileId": {
      "type": "string"
    }
  },
  "required": [
    "artifactKind",
    "schemaVersion",
    "targetProfileId",
    "target",
    "storage",
    "runtime",
    "schema",
    "functions",
    "capabilityManifest",
    "subscriptions",
    "activeConnections",
    "reapedConnections",
    "liveDelivery",
    "ephemeral",
    "cron",
    "recentDiagnostics",
    "capabilityGaps"
  ],
  "title": "PublicInspect",
  "type": "object"
