{
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.rescue-colliding-table.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalogCollisionCleared": {
      "type": "boolean"
    },
    "copiedExplicitIndexCount": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "copiedRowCount": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "manifestUpdated": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    }
  },
  "required": [
    "source",
    "target",
    "copiedRowCount",
    "copiedExplicitIndexCount",
    "manifestUpdated",
    "catalogCollisionCleared"
  ],
  "title": "CollisionRescueResult",
  "type": "object"
}
