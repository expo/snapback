{
  "$defs": {
    "ArtifactGeneration": {
      "additionalProperties": false,
      "description": "Content-derived identity of one coherent schema/function artifact pair.\nIt deliberately excludes the process-local publication counter: callers\nlearn these values from generated artifacts and can refetch them after a\ndeployment race.",
      "properties": {
        "appId": {
          "minLength": 1,
          "type": "string"
        },
        "bundleHash": {
          "minLength": 1,
          "type": "string"
        },
        "inputsHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "appId",
        "schemaHash",
        "bundleHash",
        "inputsHash"
      ],
      "type": "object"
    },
    "AuthorizationInvalidationProjection": {
      "additionalProperties": false,
      "description": "One level-triggered live projection. Delivery is only a hint; the exact\nobligation remains authoritative until the optional resolution ticket is\nacknowledged after the client commits its local transition.",
      "properties": {
        "obligation": {
          "$ref": "#/$defs/ResyncObligation"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionTicket"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "obligation"
      ],
      "type": "object"
    },
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "AuthorizationWitnessRecordV1": {
      "additionalProperties": false,
      "description": "The authorization-witness record named by a completeness proof. The shape\nlives here with [`CompositeWitness`] so sync-engine consumers never import\nupward; construction/digest logic stays in `crate::completeness` with the\nproof issuance coordinator (LLP 0199 worklist item 7).",
      "properties": {
        "compositeWitness": {
          "$ref": "#/$defs/CompositeWitness"
        },
        "format": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "format",
        "queryInstanceId",
        "compositeWitness"
      ],
      "type": "object"
    },
    "CompletenessProofV1": {
      "additionalProperties": false,
      "properties": {
        "activationHash": {
          "type": "string"
        },
        "authorizationWitnessDigest": {
          "type": "string"
        },
        "batchIdentity": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "materializationKey": {
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ProofNodeIdentityV1"
          },
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PageIdentityV1"
        },
        "planHash": {
          "type": "string"
        },
        "proofKeyId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resultDigest": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/ProofVersionV1"
        }
      },
      "required": [
        "format",
        "materializationKey",
        "queryInstanceId",
        "activationHash",
        "planHash",
        "version",
        "authorizationWitnessDigest",
        "page",
        "nodes",
        "batchIdentity",
        "resultDigest",
        "proofKeyId",
        "signature"
      ],
      "type": "object"
    },
    "CompositeWitness": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataWitness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authorization"
      ],
      "type": "object"
    },
    "CursorEndV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "first",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "const": "cursor",
              "type": "string"
            },
            "profileId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "profileId",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "DataWitness": {
      "additionalProperties": false,
      "properties": {
        "minCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "minCommitVersion"
      ],
      "type": "object"
    },
    "FunctionAttribution": {
      "description": "Server-derived, bearer-free attribution for one app-data function\nresponse. Wrappers may copy this value, but cannot synthesize attribution\nauthority when the invocation gate did not produce it.\n\n@ref LLP 0055#audit — every resolved service-principal function response\ncarries the same actor/effective/grant attribution and v1 has no agent\ndry-run surface.",
      "properties": {
        "actorUserId": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "effectiveUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantId": {
          "type": "string"
        }
      },
      "required": [
        "actorUserId",
        "grantId",
        "dryRun"
      ],
      "type": "object"
    },
    "FunctionInvocationFacts": {
      "additionalProperties": false,
      "description": "Server-derived successful-invocation facts. Keeping the generation under\na named `facts` block leaves room for additive call facts without mixing\nthem into handler-owned result values.",
      "properties": {
        "activeGeneration": {
          "$ref": "#/$defs/ArtifactGeneration"
        }
      },
      "required": [
        "activeGeneration"
      ],
      "type": "object"
    },
    "InvalidationDisposition": {
      "enum": [
        "retain",
        "quarantine",
        "delete"
      ],
      "type": "string"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    },
    "JobEnqueueFact": {
      "description": "The bounded per-enqueue fact echoed on the producing mutation's receipt —\nthe mutation-side half of the association (jobId/action/availableAt only;\nnever argument values).",
      "properties": {
        "action": {
          "type": "string"
        },
        "availableAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "jobId": {
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "action",
        "availableAtMs"
      ],
      "type": "object"
    },
    "MutationReceiptOutcome": {
      "enum": [
        "confirmed",
        "rejected"
      ],
      "type": "string"
    },
    "PageIdentityV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/CursorEndV1"
            },
            "kind": {
              "const": "sealed-terminal",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/CursorEndV1"
            }
          },
          "required": [
            "kind",
            "input",
            "output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "boundaryVectorDigest": {
              "type": "string"
            },
            "input": {
              "$ref": "#/$defs/CursorEndV1"
            },
            "kind": {
              "const": "visible",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/CursorEndV1"
            }
          },
          "required": [
            "kind",
            "input",
            "boundaryVectorDigest",
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "ProofNodeIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "classId": {
          "type": "string"
        },
        "classVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "nodePlanHash": {
          "type": "string"
        },
        "position": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "position",
        "classId",
        "classVersion",
        "nodePlanHash"
      ],
      "type": "object"
    },
    "ProofVersionV1": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "commit"
      ],
      "type": "object"
    },
    "PublishedScopeRetirement": {
      "$ref": "#/$defs/ScopeRetirement",
      "description": "Opaque evidence that a scope-retirement proof was released by the same\nregistry mutation that removed the covered live scope. The inner wire\nrecord remains cloneable/deserializable for protocol inspection, but only\na successful registry commit can wrap it for a server publication.\n\n@ref LLP 0303#s-a-compile-fail-witness-proves-a-spelling-is-gone-not-a-capability —\nevery client-visible retirement consumer requires this effect-bound\ncarrier, so reconstructing the public wire record does not recreate the\npublication capability."
    },
    "QueryNamespace": {
      "additionalProperties": false,
      "properties": {
        "clientStoreId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        }
      },
      "required": [
        "clientStoreId",
        "queryKey",
        "queryInstanceId"
      ],
      "type": "object"
    },
    "QueryOutput": {
      "properties": {
        "cursor": {
          "description": "Relational continuation cursor (LLP 0080 §2): present exactly when a\n`root-window-v1` page consumed its full `take` of authorized roots.\nOpaque and versioned; presenting it back as the `cursor` argument\nresumes from the last consumed root. Absent for every non-relational\nquery and for terminal pages.",
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "items": true,
          "type": "array"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "rows"
      ],
      "type": "object"
    },
    "Receipt": {
      "description": "A retention-ring receipt (LLP 0034 §3.2): connectionless facts about\nmutations and subscription lifecycle, served by the receipts snapshot and\nechoed in live-subscribe/unsubscribe outputs. Privacy (§3.3): receipts\ncarry opaque ids, versions, table names, and reasons — never row data or\nargument values.",
      "oneOf": [
        {
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "snapshotVersion": {
                    "type": "integer"
                  }
                }
              }
            }
          ],
          "description": "One mutation invocation: confirmed or rejected, with the write\nsurface that fan-out used.",
          "properties": {
            "affectedTables": {
              "description": "`null` means EXPLICITLY unknown (an IbexModule handler without a\ndeclared write set) — distinct from `[]`, no tables.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "claimLedger": {
              "description": "Private settlement evidence. `None` is the fan-out projection;\nthe submitting authority's direct response always carries `Some`.",
              "items": {
                "$ref": "#/$defs/SettlementClaim"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "correlation": {
              "description": "Adapter-supplied opaque correlation, echoed verbatim (capped)."
            },
            "enqueues": {
              "description": "Jobs this confirmed mutation durably enqueued in its own\ntransaction (LLP 0070 first slice; 0127 decision 7's\nmutation-side association). Bounded facts only — jobId, action,\navailableAtMs; never argument values. Omitted when empty, and a\nrejected mutation never carries one: the receipt proves what was\nscheduled with the write, and its absence on a rejection is the\ninspectable rollback-schedules-nothing evidence.",
              "items": {
                "$ref": "#/$defs/JobEnqueueFact"
              },
              "type": "array"
            },
            "idMap": {
              "description": "Private lane-L id reconciliation. `Some([])` is the explicit\nno-mints map; `None` means this is lane Q or a fan-out projection.",
              "items": {
                "$ref": "#/$defs/SettlementIdMapEntry"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "const": "mutation",
              "type": "string"
            },
            "mutation": {
              "type": "string"
            },
            "mutationId": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/MutationReceiptOutcome"
            },
            "receivedAtMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "rollbackReason": {
              "description": "The diagnostic CODE only — messages may embed argument values\n(§3.3 privacy). `null` on confirmed mutations.",
              "type": [
                "string",
                "null"
              ]
            },
            "sequenceAllocations": {
              "description": "Private sequence evidence for the submitting authority. The value\ndiscloses prior allocation count, so fan-out projection strips it.\n@ref LLP 0135#17-allocation-authority-and-information-flow — effect\n  receipts carry the full counter/scope/incarnation/value tuple\n  only on the submitter's receipt.",
              "items": {
                "$ref": "#/$defs/SequenceAllocationFact"
              },
              "type": "array"
            },
            "settlementLane": {
              "$ref": "#/$defs/SettlementLane",
              "default": "replay-accept",
              "description": "Server-observed settlement policy. Safe to retain in fan-out."
            },
            "snapshotVersion": {
              "description": "`null` only when the rejected invocation could not safely read the\ndurable cursor; never fabricate zero from a storage failure.",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "transport": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mutationId",
            "mutation",
            "outcome",
            "snapshotVersion",
            "transport",
            "correlation",
            "receivedAtMs"
          ],
          "type": "object"
        },
        {
          "description": "Subscription lifecycle: established / disposed, on both the durable\nlive-query lane and the ephemeral room lane (`lane: \"ephemeral\"`,\nwhich carries `bindingId`/`collection` instead of `subscriptionId`).",
          "properties": {
            "bindingId": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection": {
              "type": [
                "string",
                "null"
              ]
            },
            "correlation": true,
            "event": {
              "$ref": "#/$defs/SubscriptionReceiptEvent"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "lane": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "receivedAtMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "removed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "scope": {
              "description": "The subscription's routing/scope args (REQUIRED — LLP 0034 §3.2)."
            },
            "snapshotVersion": {
              "description": "`null` when no storage read is safe at the emission site (the\ndisconnect teardown path) — the honest \"unknown at death\" value.",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "subscriptionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersededBy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "event",
            "scope",
            "receivedAtMs"
          ],
          "type": "object"
        }
      ]
    },
    "ResolutionKind": {
      "enum": [
        "snapshot",
        "terminalDelete"
      ],
      "type": "string"
    },
    "ResolutionTicket": {
      "additionalProperties": false,
      "properties": {
        "ackToken": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolutionKind"
        },
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "kind",
        "scopeId",
        "revision",
        "witness",
        "maxDisposition",
        "ackToken"
      ],
      "type": "object"
    },
    "ResumeMeta": {
      "description": "Clear advisory copy of the token's identity fields (LLP 0091 §0B.1). The\nclient's digest-kind signal is `content_digest`'s self-describing prefix.",
      "properties": {
        "app": {
          "type": "string"
        },
        "argsHash": {
          "type": "string"
        },
        "contentDigest": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "queryArtifact": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "version",
        "contentDigest",
        "generation",
        "versionStream",
        "queryArtifact",
        "argsHash"
      ],
      "type": "object"
    },
    "ResumeWire": {
      "description": "The RQS resume object (LLP 0091 §0B.1): the opaque server-authenticated\ntoken plus its clear, client-advisory `meta` copy. `meta` repeats every\nidentity field the LLP 0090 D3 channel arbitration compares and is never\nan admission input — admission decodes the token itself. Exported as\n`live.resume-token.schema.json`, named distinctly from the reattach\noperation's `live.resume.*` schemas (LLP 0091 §0B.4).",
      "properties": {
        "meta": {
          "$ref": "#/$defs/ResumeMeta"
        },
        "token": {
          "description": "`tokenWire` (`sbrt1.` envelope, ≤ 1 KiB — LLP 0091 §0A.1).",
          "type": "string"
        }
      },
      "required": [
        "token",
        "meta"
      ],
      "type": "object"
    },
    "ResyncObligation": {
      "additionalProperties": false,
      "properties": {
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "description": "Cleanup ownership for the client-side pending token. This is not part\nof scope/revision identity; retirement may finish only after this exact\ncontinuity ends (except an already-applied terminal delete).",
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retryEpisodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "scopeId",
        "revision",
        "maxDisposition",
        "witness"
      ],
      "type": "object"
    },
    "ScopeId": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            },
            "scopeSequence": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "subscriptionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "namespace",
            "scopeSequence",
            "connectionGeneration",
            "subscriptionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "connectionGeneration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "clientQuery",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            }
          },
          "required": [
            "kind",
            "namespace"
          ],
          "type": "object"
        }
      ]
    },
    "ScopeRetirement": {
      "additionalProperties": false,
      "description": "Server-authenticated proof that one current-issuer namespace has no live or\nunresolved scope at or below a contiguous scope-sequence prefix. The proof\nis a cleanup/fencing fact only; accepting it never stands in for a result\nsnapshot, a resolution ACK, or a release proof.",
      "properties": {
        "authorizationExpectation": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "mac": {
          "type": "string"
        },
        "namespace": {
          "$ref": "#/$defs/QueryNamespace"
        },
        "retireThroughScopeSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "issuerId",
        "namespace",
        "retireThroughScopeSequence",
        "authorizationExpectation",
        "mac"
      ],
      "type": "object"
    },
    "SequenceAllocationFact": {
      "additionalProperties": false,
      "description": "One tentative sequence value. It is returned during handler execution but\nbecomes a fact only if this exact identity/value transition commits.\n\n@ref LLP 0135#13-allocation-versus-commit-ordering-and-gap-semantics — the\n  counter advance is buffered and commits or rolls back with app writes.",
      "properties": {
        "counter": {
          "type": "string"
        },
        "scopeIncarnation": {
          "type": "string"
        },
        "scopeRowId": {
          "type": "string"
        },
        "scopeTable": {
          "type": "string"
        },
        "value": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "counter",
        "scopeTable",
        "scopeRowId",
        "scopeIncarnation",
        "value"
      ],
      "type": "object"
    },
    "SettlementClaim": {
      "additionalProperties": false,
      "properties": {
        "authoritative": true,
        "claimed": true,
        "disposition": {
          "$ref": "#/$defs/SettlementClaimDisposition"
        },
        "fieldOrSlot": {
          "type": "string"
        },
        "skewMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "fieldOrSlot",
        "claimed",
        "authoritative",
        "disposition"
      ],
      "type": "object"
    },
    "SettlementClaimDisposition": {
      "description": "How settlement treated one client-captured application value. Divergence\nremains visible in the claimed/authoritative pair rather than becoming a\nfourth disposition.\n\n@ref LLP 0133#receipts — settlement receipts carry labeled claims, while\n  fan-out projections omit their values entirely.",
      "enum": [
        "accepted",
        "accepted-bounded-skew",
        "re-derived"
      ],
      "type": "string"
    },
    "SettlementIdMapDisposition": {
      "enum": [
        "mapped",
        "unmapped"
      ],
      "type": "string"
    },
    "SettlementIdMapEntry": {
      "additionalProperties": false,
      "properties": {
        "authoritative": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/SettlementIdMapDisposition"
        },
        "occurrence": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "site": {
          "type": "string"
        },
        "speculative": {
          "type": "string"
        }
      },
      "required": [
        "speculative",
        "site",
        "occurrence",
        "disposition"
      ],
      "type": "object"
    },
    "SettlementLane": {
      "description": "Settle-time trust policy selected by an ordinary client-attested mutation\nlabel. The default preserves the pre-0133 queued replay contract for older\nrequest and retained-artifact decoders.\n\n@ref LLP 0133#the-two-settlement-lanes — the label selects replay acceptance\n  or server re-derivation without granting authority.",
      "enum": [
        "replay-accept",
        "re-derive"
      ],
      "type": "string"
    },
    "SubscriptionReceiptEvent": {
      "enum": [
        "established",
        "disposed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.subscribe.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionAttribution"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-derived attribution for the authority that established this\nsubscription (LLP 0055 §Audit): present exactly when a service\nprincipal resolved, absent otherwise. It is immutable subscription\nmetadata — a renewal resubscribe answers with this same block, and a\nwrapper that did not receive it carries no attribution authority.\n\n@ref LLP 0094#0c6-response-shape-divergences-audited-at-137dee8c-defects-not-contract — the live establishment/renewal seam admits\n  `attribution` explicitly, like the mutation envelope's item-4\n  convergence; hosted (which refuses `servicePrincipal`) never emits\n  it and never synthesizes one."
    },
    "authorizationInvalidation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationInvalidationProjection"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationWitness": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationWitnessRecordV1"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact owner-produced preimage named by `completenessProof`'s witness\ndigest. This additive member is transported beside the signed proof so\na client can validate the authorization fence before installing result\nbytes; it is never accepted as a trust root on its own."
    },
    "completenessProof": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompletenessProofV1"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional additive carrier on the open LLP 0094 LiveSubscribeOutput\nfamily. The proof's signed preimage is the closed LLP 0157 record; this\nenvelope member conveys it without changing those semantic bytes."
    },
    "facts": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionInvocationFacts"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-derived active sessions artifact identity. Absent on dev, even\nwhen a generated v0 reference carried an ignored assertion."
    },
    "permission_epochs": {
      "additionalProperties": {
        "format": "uint64",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "default": {},
      "type": "object"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server half of the 'established' receipt (LLP 0034 §3.2, ENG-22478)."
    },
    "resume": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResumeWire"
        },
        {
          "type": "null"
        }
      ],
      "description": "Fresh resume token for `rqsEligible` subscriptions answered with rows\n(the \"initial `LiveReplace`\" mint of LLP 0091 §0A.5 on this arm)."
    },
    "resumeRefusal": {
      "description": "Per-cause `SNAPBACK_RESUME_*` code when a presented token was refused\n(LLP 0091 §0B.6) — an observability fact; the subscribe itself\nsucceeded with rung 3.",
      "type": [
        "string",
        "null"
      ]
    },
    "scopeRetirements": {
      "items": {
        "$ref": "#/$defs/PublishedScopeRetirement"
      },
      "type": "array"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryOutput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Absent exactly when the subscribe was answered without rows (LLP 0090\nD1.3): rung-1 `CurrentAsOf` (held rows are current) or rung-2 delta\nreplay (the witness verified). The answer rides the durable lane —\nthe `current_as_of` or replay `live_delta` envelope carries the fresh\ntoken. Only a resume-capable caller can receive the absent form."
    },
    "subscription_id": {
      "type": "string"
    },
    "superseded": {
      "description": "Response witness for a successful explicit `supersedes` request. The\nexact predecessor id is echoed only after that subscription was\ndisposed; clients must not infer disposal from subscribe success alone.",
      "type": [
        "string",
        "null"
      ]
    },
    "supersessionRefusal": {
      "description": "Response witness for a presented `supersedes` id that was already\nabsent. Together with `superseded`, this makes every presented\nsupersession observable on the open subscribe-output family.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "subscription_id"
  ],
  "title": "LiveSubscribeOutput",
  "type": "object"
}
