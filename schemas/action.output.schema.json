{
  "$defs": {
    "ArtifactGeneration": {
      "additionalProperties": false,
      "description": "Content-derived identity of one coherent schema/function artifact pair.\nIt deliberately excludes the process-local publication counter: callers\nlearn these values from generated artifacts and can refetch them after a\ndeployment race.",
      "properties": {
        "appId": {
          "minLength": 1,
          "type": "string"
        },
        "bundleHash": {
          "minLength": 1,
          "type": "string"
        },
        "inputsHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "appId",
        "schemaHash",
        "bundleHash",
        "inputsHash"
      ],
      "type": "object"
    },
    "BinaryOp": {
      "enum": [
        "Add",
        "Sub",
        "Mul",
        "Div",
        "Mod",
        "Eq",
        "Ne",
        "Lt",
        "Lte",
        "Gt",
        "Gte",
        "And",
        "Or"
      ],
      "type": "string"
    },
    "CapturedReadDependency": {
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "graph"
              ]
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "graphNode"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "graph"
            ]
          }
        }
      ],
      "properties": {
        "boundary": true,
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph": {
          "$ref": "#/$defs/GraphCapturedReadV1",
          "description": "Additive graph-specific dependency detail. Required exactly for\n`GraphNode` and absent for every shipped read kind.\n\n@ref LLP 0209#51-captured-vocabulary-by-normalized-node — graph reads\ncarry one closed node-specific payload beside the shared top-level kind."
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/CapturedReadKind"
        },
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "order": true,
        "predicate": true,
        "result_count": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true,
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CapturedReadKind": {
      "enum": [
        "row",
        "missingRow",
        "query",
        "auth",
        "permission",
        "graphNode"
      ],
      "type": "string"
    },
    "CapturedWriteDependency": {
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/ChangeOp"
        },
        "table": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "id",
        "op"
      ],
      "type": "object"
    },
    "ChangeOp": {
      "enum": [
        "Insert",
        "Update",
        "Delete"
      ],
      "type": "string"
    },
    "DeclarationConformance": {
      "description": "The per-invocation D1 conformance report: four class-tagged deltas plus\nper-class provenance. Emission is unconditional — an invocation with no\ncapture is exactly the case the provenance vocabulary exists to report.\n\nTables are application tables only (present in the active schema manifest);\nauth/permission dependencies and reserved `_snapback_*` projections are out\nof scope by construction.",
      "properties": {
        "extraReads": {
          "description": "Declared reads unwitnessed by this invocation. Data, not a verdict:\na conditionally-read table is unwitnessed on every invocation that\nskips its branch, so over-declaration is only judgeable in aggregate\n(D2 coverage).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extraWrites": {
          "description": "Declared writes unwitnessed by this invocation. Data, not a verdict.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "missingReads": {
          "description": "Captured reads absent from the declaration — authoritative when\n`readProvenance` is `complete`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "missingWrites": {
          "description": "Captured writes absent from the declaration — authoritative when\n`writeProvenance` is `complete`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readProvenance": {
          "$ref": "#/$defs/DependencyProvenance"
        },
        "writeProvenance": {
          "$ref": "#/$defs/DependencyProvenance"
        }
      },
      "required": [
        "missingReads",
        "missingWrites",
        "extraReads",
        "extraWrites",
        "readProvenance",
        "writeProvenance"
      ],
      "type": "object"
    },
    "DependencyProvenance": {
      "description": "How authoritative one dependency class's captured evidence is for this\ninvocation.\n\n`Complete` — the runtime captured this class on a supported path; the\nmatching delta fields are authoritative. `Incomplete` — the invocation\nfailed, was refused before handler completion, or ran on a seam that\ndiscards the capture; deltas are data, not verdicts. `Unsupported` — the\npath constructs no capture by design (actions), so no conformant verdict\ncan exist.",
      "enum": [
        "complete",
        "incomplete",
        "unsupported"
      ],
      "type": "string"
    },
    "Diagnostic": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subsystem": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subsystem",
        "message",
        "details"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    },
    "FilterExpr": {
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "value": {
          "$ref": "#/$defs/ValueExpr"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "Eq",
        "In",
        "Lt",
        "Lte",
        "Gt",
        "Gte"
      ],
      "type": "string"
    },
    "FunctionAttribution": {
      "description": "Server-derived, bearer-free attribution for one app-data function\nresponse. Wrappers may copy this value, but cannot synthesize attribution\nauthority when the invocation gate did not produce it.\n\n@ref LLP 0055#audit — every resolved service-principal function response\ncarries the same actor/effective/grant attribution and v1 has no agent\ndry-run surface.",
      "properties": {
        "actorUserId": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "effectiveUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantId": {
          "type": "string"
        }
      },
      "required": [
        "actorUserId",
        "grantId",
        "dryRun"
      ],
      "type": "object"
    },
    "FunctionInvocationFacts": {
      "additionalProperties": false,
      "description": "Server-derived successful-invocation facts. Keeping the generation under\na named `facts` block leaves room for additive call facts without mixing\nthem into handler-owned result values.",
      "properties": {
        "activeGeneration": {
          "$ref": "#/$defs/ArtifactGeneration"
        }
      },
      "required": [
        "activeGeneration"
      ],
      "type": "object"
    },
    "FunctionKind": {
      "enum": [
        "Query",
        "Mutation",
        "LiveQuery",
        "Action"
      ],
      "type": "string"
    },
    "GraphAuthorityClassV1": {
      "description": "The closed numerical authority classes: independent, partition-scoped,\nand principal-scoped.",
      "format": "uint8",
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
