    "GraphCapturedReadV1": {
      "additionalProperties": false,
      "description": "Additive graph-specific captured-read payload. It is carried only beside\n`CapturedReadKind::GraphNode`; G0 registers and validates the vocabulary\nbut does not consume it in matching.\n\n@ref LLP 0209#51-captured-vocabulary-by-normalized-node — one top-level\ngraph read kind contains the closed per-node dependency union.",
      "properties": {
        "authorityClass": {
          "$ref": "#/$defs/GraphAuthorityClassV1"
        },
        "dependency": {
          "$ref": "#/$defs/GraphCapturedDependencyV1"
        },
        "format": {
          "const": "snapback.graph-captured-read.v1",
          "type": "string"
        },
        "graphPlanHash": {
          "$ref": "#/$defs/Sha256V1"
        },
        "instanceHash": {
          "$ref": "#/$defs/Sha256V1"
        },
        "nodeId": {
          "type": "string"
        },
        "nodeKind": {
          "$ref": "#/$defs/GraphNodeKindV1"
        }
      },
      "required": [
        "format",
        "graphPlanHash",
        "instanceHash",
        "nodeId",
        "nodeKind",
        "authorityClass",
        "dependency"
      ],
      "type": "object"
    },
