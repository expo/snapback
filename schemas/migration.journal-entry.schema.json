{
  "$defs": {
    "CleanupTerminal": {
      "enum": [
        "released",
        "rolled-back"
      ],
      "type": "string"
    },
    "ContentDigestAccumulatorV1": {
      "additionalProperties": false,
      "description": "The serialized SHA-256 chaining state plus counters — exactly what\nLLP 0081 §5 pins into the migration journal's batch checkpoint.",
      "properties": {
        "buffer": {
          "description": "Base64url of the unprocessed tail (< 64 bytes).",
          "type": "string"
        },
        "lengthBytes": {
          "description": "Message bytes absorbed so far.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Row frames absorbed so far (bound by the trailer frame).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "description": "The eight SHA-256 working words.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "state",
        "lengthBytes",
        "buffer",
        "rows"
      ],
      "type": "object"
    },
    "KeysetAfter": {
      "description": "A `root-window-v1` keyset boundary: the order-key values and `_id` of the\nlast consumed root. `entries` aligns 1:1 with the plan's `order` fields —\na `Value::Null` entry marks a null/absent component, which sorts last\nunder either direction (`NULLS LAST`). The same shape serves both roles:\nthe verified boundary a presented cursor decodes to, and the continuation\nthe executor reports for the next mint.\n\n@ref LLP 0080#2-portable-evaluation-semantics — continuation follows the\n  root order key from the last consumed root, including roots omitted by\n  an inner join; boundary keys may include fields the projection does not\n  expose.",
      "properties": {
        "entries": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              true
            ],
            "type": "array"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "entries",
        "id"
      ],
      "type": "object"
    },
    "MigrationExecState": {
      "description": "§4's closed durable state set, spelled exactly as the RFC names them.",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "admitted",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "barriered",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "batch": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "executing",
              "type": "string"
            },
            "step": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "step",
            "batch"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "verifying",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "published-held",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "released",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "rolling-back",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "rolled-back",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "cancel_requested",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "aborting",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "abandoned",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "cleanup-pending",
              "type": "string"
            },
            "terminal": {
              "$ref": "#/$defs/CleanupTerminal"
            }
          },
          "required": [
            "state",
            "terminal"
          ],
          "type": "object"
        }
      ]
    },
    "MigrationKeysetScanCheckpointV1": {
      "additionalProperties": false,
      "description": "The serializable batch checkpoint the Wave-2 executor persists in its\njournal: identity of the scan, the keyset boundary, cumulative\ncounters, resumable validator states, and the digest accumulators\n(SHA-256 chaining state + counters, LLP 0081 §5).",
      "properties": {
        "boundary": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeysetAfter"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytesScanned": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "type": [
            "string",
            "null"
          ]
        },
        "logicalDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigestAccumulatorV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "rowsScanned": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "systemDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentDigestAccumulatorV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "table": {
          "type": "string"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/MigrationScanValidatorStateV1"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "table",
        "rowsScanned",
        "bytesScanned"
      ],
      "type": "object"
    },
    "MigrationScanValidatorStateV1": {
      "description": "Resumable per-validator state, persisted with the batch checkpoint.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "nonNull": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "samples": {
                  "description": "First offending row ids (bounded sample for actionability).",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "violations": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "field",
                "violations",
                "samples"
              ],
              "type": "object"
            }
          },
          "required": [
            "nonNull"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "unique": {
              "properties": {
                "additional_fields": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "duplicates": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "field": {
                  "type": "string"
                },
                "last": {
                  "description": "The previous participating key at the batch boundary — adjacency\ncarries across batches through this. A compound key is represented\nas a JSON array; the single-field legacy shape remains scalar."
                },
                "samples": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "whereApplicable": {
                  "type": "boolean"
                }
              },
              "required": [
                "field",
                "duplicates",
                "samples"
              ],
              "type": "object"
            }
          },
          "required": [
            "unique"
          ],
          "type": "object"
        }
      ]
    },
    "OperationBoundFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "functionOrCommand": {
          "type": "string"
        },
        "inputFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationKind": {
          "type": "string"
        },
        "principalFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "audience",
        "principalFingerprint",
        "authorityInstanceId",
        "operationKind",
        "functionOrCommand",
        "inputFingerprint"
      ],
      "type": "object"
    },
    "OperationIdentityV1": {
      "additionalProperties": false,
      "description": "`operationId` widens the shipped client-mutation id; this struct preserves\nevery bound fact the existing collision check already owns.",
      "properties": {
        "boundFacts": {
          "$ref": "#/$defs/OperationBoundFactsV1"
        },
        "issuance": {
          "$ref": "#/$defs/OperationIssuanceV1"
        },
        "key": {
          "$ref": "#/$defs/OperationKeyV1"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "issuance",
        "boundFacts"
      ],
      "type": "object"
    },
    "OperationIssuanceV1": {
      "description": "Issuance facts are structurally disjoint across client and host namespaces.\nThe authenticator is represented by its non-secret digest; admission later\nverifies the underlying server-issued artifact before constructing this\nvalue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "clientRange",
              "type": "string"
            },
            "range_end_exclusive": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "range_start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "counter",
            "range_start",
            "range_end_exclusive",
            "authority_authenticator_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "commit_ordinal": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "hostIncarnation",
              "type": "string"
            },
            "upstream_identity": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "upstream_identity",
            "commit_ordinal",
            "authority_authenticator_digest"
          ],
          "type": "object"
        }
      ]
    },
    "OperationKeyV1": {
      "additionalProperties": false,
      "description": "The physical key for suppression and envelope storage. Audience and all\nother semantic facts are compared facts, never key components.",
      "properties": {
        "operationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "type": "string"
        },
        "originatorClass": {
          "$ref": "#/$defs/OperationOriginatorClassV1"
        },
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "originatorClass",
        "operationId"
      ],
      "type": "object"
    },
    "OperationOriginatorClassV1": {
      "enum": [
        "client",
        "host"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/migration.journal-entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One durable journal entry: identity, state, progress, and the fencing\ntoken, exactly §4's field list for the local profile.",
  "properties": {
    "atMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "attempt": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "backfillAfterId": {
      "description": "In-place backfill batches checkpoint a bare keyset boundary.",
      "type": [
        "string",
        "null"
      ]
    },
    "barrierElapsedMs": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/MigrationKeysetScanCheckpointV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "hostOperationIdentity": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationIdentityV1"
        },
        {
          "type": "null"
        }
      ],
      "description": "Authenticated host identity of the physical SQLite transaction that\nappended this row. Legacy entries remain readable without one; a new\ntransaction shares one value across every row it appends."
    },
    "inputVersion": {
      "description": "Predecessor head at admission (the input generation identity).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "leaseEpoch": {
      "description": "The fencing token: the lease epoch this executor instance holds.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "operationId": {
      "type": "string"
    },
    "outputVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "planId": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/MigrationExecState"
    },
    "stepId": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification": true,
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "operationId",
    "planId",
    "attempt",
    "state",
    "inputVersion",
    "leaseEpoch",
    "atMs"
  ],
  "title": "MigrationJournalEntryV1",
  "type": "object"
}
