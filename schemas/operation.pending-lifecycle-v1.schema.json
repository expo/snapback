{
  "$defs": {
    "OperationBoundFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "functionOrCommand": {
          "type": "string"
        },
        "inputFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationKind": {
          "type": "string"
        },
        "principalFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "audience",
        "principalFingerprint",
        "authorityInstanceId",
        "operationKind",
        "functionOrCommand",
        "inputFingerprint"
      ],
      "type": "object"
    },
    "OperationIdentityV1": {
      "additionalProperties": false,
      "description": "`operationId` widens the shipped client-mutation id; this struct preserves\nevery bound fact the existing collision check already owns.",
      "properties": {
        "boundFacts": {
          "$ref": "#/$defs/OperationBoundFactsV1"
        },
        "issuance": {
          "$ref": "#/$defs/OperationIssuanceV1"
        },
        "key": {
          "$ref": "#/$defs/OperationKeyV1"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "issuance",
        "boundFacts"
      ],
      "type": "object"
    },
    "OperationIssuanceV1": {
      "description": "Issuance facts are structurally disjoint across client and host namespaces.\nThe authenticator is represented by its non-secret digest; admission later\nverifies the underlying server-issued artifact before constructing this\nvalue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "clientRange",
              "type": "string"
            },
            "range_end_exclusive": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "range_start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "counter",
            "range_start",
            "range_end_exclusive",
            "authority_authenticator_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "commit_ordinal": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "hostIncarnation",
              "type": "string"
            },
            "upstream_identity": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "upstream_identity",
            "commit_ordinal",
            "authority_authenticator_digest"
          ],
          "type": "object"
        }
      ]
    },
    "OperationKeyV1": {
      "additionalProperties": false,
      "description": "The physical key for suppression and envelope storage. Audience and all\nother semantic facts are compared facts, never key components.",
      "properties": {
        "operationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "type": "string"
        },
        "originatorClass": {
          "$ref": "#/$defs/OperationOriginatorClassV1"
        },
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "originatorClass",
        "operationId"
      ],
      "type": "object"
    },
    "OperationOriginatorClassV1": {
      "enum": [
        "client",
        "host"
      ],
      "type": "string"
    },
    "SnapshotAssociationKindV1": {
      "enum": [
        "producedCommit",
        "observedSnapshot"
      ],
      "type": "string"
    },
    "StreamQualifiedVersionV1": {
      "additionalProperties": false,
      "properties": {
        "association": {
          "$ref": "#/$defs/SnapshotAssociationKindV1"
        },
        "streamId": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "streamId",
        "version",
        "association"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/operation.pending-lifecycle-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable P-side lifecycle row for an operation whose application-visible\npublication precedes its terminal settlement. `CommitEnvelopeV1` already\nhas a truthful Pending receipt state; this companion owns the exact lookup\nposture without widening or rewriting that v1 envelope.\n\n@ref LLP 0163#implementation-record-2026-08-04-migration-aggregate-settlement-tail\n  — migration publication retains its original pending truth and terminal\n  settlement appends a digest-linked supplement.",
  "properties": {
    "identity": {
      "$ref": "#/$defs/OperationIdentityV1"
    },
    "lane": {
      "type": "string"
    },
    "pendingAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "pendingPayload": true,
    "pendingReceiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/StreamQualifiedVersionV1"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "lane",
    "identity",
    "publication",
    "pendingReceiptDigest",
    "pendingPayload",
    "pendingAtMs"
  ],
  "title": "PendingOperationLifecycleV1",
  "type": "object"
}
