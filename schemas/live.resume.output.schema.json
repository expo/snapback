{
  "$defs": {
    "AuthorizationInvalidationProjection": {
      "additionalProperties": false,
      "description": "One level-triggered live projection. Delivery is only a hint; the exact\nobligation remains authoritative until the optional resolution ticket is\nacknowledged after the client commits its local transition.",
      "properties": {
        "obligation": {
          "$ref": "#/$defs/ResyncObligation"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionTicket"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "obligation"
      ],
      "type": "object"
    },
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "CompositeWitness": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataWitness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authorization"
      ],
      "type": "object"
    },
    "DataWitness": {
      "additionalProperties": false,
      "properties": {
        "minCommitVersion": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "versionStream": {
          "type": "string"
        }
      },
      "required": [
        "versionStream",
        "minCommitVersion"
      ],
      "type": "object"
    },
    "FunctionAttribution": {
      "description": "Server-derived, bearer-free attribution for one app-data function\nresponse. Wrappers may copy this value, but cannot synthesize attribution\nauthority when the invocation gate did not produce it.\n\n@ref LLP 0055#audit — every resolved service-principal function response\ncarries the same actor/effective/grant attribution and v1 has no agent\ndry-run surface.",
      "properties": {
        "actorUserId": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "effectiveUserId": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantId": {
          "type": "string"
        }
      },
      "required": [
        "actorUserId",
        "grantId",
        "dryRun"
      ],
      "type": "object"
    },
    "InvalidationDisposition": {
      "enum": [
        "retain",
        "quarantine",
        "delete"
      ],
      "type": "string"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    },
    "QueryNamespace": {
      "additionalProperties": false,
      "properties": {
        "clientStoreId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        }
      },
      "required": [
        "clientStoreId",
        "queryKey",
        "queryInstanceId"
      ],
      "type": "object"
    },
    "QueryOutput": {
      "properties": {
        "cursor": {
          "description": "Opaque continuation cursor. Relational `root-window-v1` uses its\nestablished cursor family; data-lowered list members use DataCursorV1\n(LLP 0255 S3.4/S5.3). It is absent for terminal pages and for every\nquery profile that does not explicitly admit continuation.",
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "items": true,
          "type": "array"
        },
        "version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "rows"
      ],
      "type": "object"
    },
    "ResolutionKind": {
      "enum": [
        "snapshot",
        "terminalDelete"
      ],
      "type": "string"
    },
    "ResolutionTicket": {
      "additionalProperties": false,
      "properties": {
        "ackToken": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolutionKind"
        },
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "kind",
        "scopeId",
        "revision",
        "witness",
        "maxDisposition",
        "ackToken"
      ],
      "type": "object"
    },
    "ResyncObligation": {
      "additionalProperties": false,
      "properties": {
        "maxDisposition": {
          "$ref": "#/$defs/InvalidationDisposition"
        },
        "ownerContinuityId": {
          "description": "Cleanup ownership for the client-side pending token. This is not part\nof scope/revision identity; retirement may finish only after this exact\ncontinuity ends (except an already-applied terminal delete).",
          "type": [
            "string",
            "null"
          ]
        },
        "protocolVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retryEpisodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeId"
        },
        "witness": {
          "$ref": "#/$defs/CompositeWitness"
        }
      },
      "required": [
        "protocolVersion",
        "scopeId",
        "revision",
        "maxDisposition",
        "witness"
      ],
      "type": "object"
    },
    "ScopeId": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            },
            "scopeSequence": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "subscriptionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "namespace",
            "scopeSequence",
            "connectionGeneration",
            "subscriptionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "connectionGeneration": {
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "issuerId": {
              "$ref": "#/$defs/IssuerId"
            },
            "kind": {
              "const": "connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issuerId",
            "connectionGeneration"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "clientQuery",
              "type": "string"
            },
            "namespace": {
              "$ref": "#/$defs/QueryNamespace"
            }
          },
          "required": [
            "kind",
            "namespace"
          ],
          "type": "object"
        }
      ]
    },
    "ScopeRetirement": {
      "additionalProperties": false,
      "description": "Server-authenticated proof that one current-issuer namespace has no live or\nunresolved scope at or below a contiguous scope-sequence prefix. The proof\nis a cleanup/fencing fact only; accepting it never stands in for a result\nsnapshot, a resolution ACK, or a release proof.",
      "properties": {
        "authorizationExpectation": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "mac": {
          "type": "string"
        },
        "namespace": {
          "$ref": "#/$defs/QueryNamespace"
        },
        "retireThroughScopeSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "issuerId",
        "namespace",
        "retireThroughScopeSequence",
        "authorizationExpectation",
        "mac"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.resume.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionAttribution"
        },
        {
          "type": "null"
        }
      ],
      "description": "The establishment attribution block, carried unchanged across\nrenew/resubscribe (see [`LiveSubscribeOutput::attribution`]). Derived\nfrom the subscription's retained establishment authority, never from\nthe caller presenting the resume."
    },
    "authorizationInvalidation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationInvalidationProjection"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizationScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string"
    },
    "permission_epochs": {
      "additionalProperties": {
        "format": "uint64",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "default": {},
      "type": "object"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopeRetirements": {
      "items": {
        "$ref": "#/$defs/ScopeRetirement"
      },
      "type": "array"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "subscription_id",
    "mode"
  ],
  "title": "LiveResumeOutput",
  "type": "object"
}
