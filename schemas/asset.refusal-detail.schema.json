        "integer",
        "null"
      ]
    },
    "limit": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "observed": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
