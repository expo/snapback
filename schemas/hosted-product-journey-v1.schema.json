      "properties": {
        "applicationConsistentBackup": {
          "$ref": "#/$defs/HostedJourneyBackupV1"
        },
        "isolatedRestore": {
          "$ref": "#/$defs/HostedJourneyIsolatedRestoreV1"
        },
        "packedLifecycle": {
          "$ref": "#/$defs/HostedJourneyPackedLifecycleV1"
