          "type": "string"
        }
      },
      "required": [
        "id",
        "providerState",
        "absentFromLiveRoster"
      ],
      "type": "object"
    },
    "HostedJourneyDeletedObjectV1": {
      "additionalProperties": false,
      "properties": {
