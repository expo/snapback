          "$ref": "#/$defs/HostedJourneyStatus"
        },
        "volumeEncrypted": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "helperMachineId",
        "helperVolumeId",
        "helperProductionServices",
        "volumeEncrypted",
        "sqliteIntegrity",
        "sqliteTableCount",
        "activated"
      ],
      "type": "object"
    },
