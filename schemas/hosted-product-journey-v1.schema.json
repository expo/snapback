        "status": {
          "$ref": "#/$defs/HostedJourneyStatus"
        }
      },
      "required": [
        "status",
        "objectKey",
        "bytes",
        "backupSha256",
        "readbackSha256"
      ],
      "type": "object"
    },
    "HostedJourneyClaimBoundaryV1": {
      "additionalProperties": false,
      "properties": {
        "hostedEphemeralCapabilityAdvertised": {
          "type": "boolean"
        },
        "hostedProductJourneyPassed": {
          "type": "boolean"
        },
        "isolatedBackupRestoreDrillPassed": {
          "type": "boolean"
        },
        "supervisorInstallationReady": {
          "type": "boolean"
        }
      },
      "required": [
        "supervisorInstallationReady",
        "isolatedBackupRestoreDrillPassed",
        "hostedProductJourneyPassed",
        "hostedEphemeralCapabilityAdvertised"
