    "claimBoundary": {
      "$ref": "#/$defs/HostedJourneyClaimBoundaryV1"
    },
    "cleanup": {
      "$ref": "#/$defs/HostedJourneyCleanupV1"
    },
    "comparator": {
      "$ref": "#/$defs/HostedJourneyComparatorV1"
    },
    "observedAt": {
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/HostedJourneyProviderV1"
    },
    "rows": {
      "$ref": "#/$defs/HostedJourneyRowsV1"
    },
    "schemaVersion": {
      "$ref": "#/$defs/HostedProductJourneyVersion"
    },
    "status": {
      "$ref": "#/$defs/HostedJourneyStatus"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "observedAt",
    "comparator",
    "provider",
    "rows",
    "cleanup",
    "claimBoundary"
  ],
  "title": "HostedProductJourneyV1",
  "type": "object"
}
