      "required": [
        "singleProductionRoute",
        "applicationConsistentBackup",
        "isolatedRestore",
        "publicServedPath",
        "packedLifecycle"
      ],
      "type": "object"
    },
    "HostedJourneyServedPathV1": {
      "additionalProperties": false,
      "properties": {
        "diagnosticCode": {
          "type": "string"
        },
        "httpStatus": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HostedJourneyStatus"
        }
      },
      "required": [
        "status",
        "httpStatus",
        "diagnosticCode",
        "reason"
