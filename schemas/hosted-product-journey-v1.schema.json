          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temporaryBackupObject": {
          "$ref": "#/$defs/HostedJourneyDeletedObjectV1"
        },
        "temporaryMachine": {
          "$ref": "#/$defs/HostedJourneyDeletedMachineV1"
        },
        "temporaryVolume": {
          "$ref": "#/$defs/HostedJourneyDeletedVolumeV1"
        }
      },
      "required": [
        "temporaryMachine",
        "temporaryVolume",
        "temporaryBackupObject",
        "liveRosterAfterCleanup",
        "liveVolumesAfterCleanup"
