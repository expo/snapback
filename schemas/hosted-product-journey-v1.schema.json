      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "predecessorMachineId": {
          "type": "string"
        },
        "predecessorVolumeId": {
          "type": "string"
        },
        "publicOrigin": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "releaseImageDigest": {
          "type": "string"
        }
