{
  "$id": "https://schemas.snapback.dev/snapback.v0/vector.item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "distance": {
      "format": "double",
      "type": "number"
    },
    "fields": {
      "additionalProperties": true,
