{
  "$defs": {
    "EffectEgressFamilyV1": {
      "enum": [
        "fetch",
        "notification",
        "payment",
        "cron",
        "outbox",
        "uses"
      ],
      "type": "string"
    },
    "EffectSettlementCapabilityV1": {
      "enum": [
        "transactional",
        "provider-idempotent",
        "provider-queryable",
        "compensatable",
        "inherently-ambiguous"
      ],
      "type": "string"
    },
    "EnvelopeAuthorityFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "fencingTokenOrEpoch": {
          "$ref": "#/$defs/LaneFactV1"
        },
        "grantOrPolicyIdentity": {
          "$ref": "#/$defs/LaneFactV1"
        }
      },
      "required": [
        "audience",
        "grantOrPolicyIdentity",
        "fencingTokenOrEpoch"
      ],
      "type": "object"
    },
    "EnvelopeCoverageV1": {
      "additionalProperties": false,
      "properties": {
        "coverageDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "coveredLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "uncoveredLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "coveredLanes",
        "uncoveredLanes",
        "coverageDigest"
      ],
      "type": "object"
    },
    "EnvelopeEffectFactsV1": {
      "additionalProperties": false,
      "properties": {
        "egressFamilies": {
          "items": {
            "$ref": "#/$defs/EffectEgressFamilyV1"
          },
          "type": "array"
        },
        "facts": {
          "$ref": "#/$defs/EnvelopeFactSetV1"
        },
        "settlementCapabilities": {
          "items": {
            "$ref": "#/$defs/EffectSettlementCapabilityV1"
          },
          "type": "array"
        }
      },
      "required": [
        "facts",
        "egressFamilies",
        "settlementCapabilities"
      ],
      "type": "object"
    },
    "EnvelopeFactSetV1": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "detail": {
          "$ref": "#/$defs/RetainedEnvelopeDetailV1"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/FactProvenanceV1"
        }
      },
      "required": [
        "digest",
        "count",
        "provenance",
        "detail"
      ],
      "type": "object"
    },
    "FactProvenanceV1": {
      "enum": [
        "serverCaptured",
        "clientSuppliedValidated",
        "serverEvaluatedConditional"
      ],
      "type": "string"
    },
    "LaneFactV1": {
      "description": "Fields that exist only on a lane make non-applicability explicit instead of\noverloading `null` or omission.",
      "oneOf": [
        {
          "properties": {
            "applicability": {
              "const": "notDefinedForLane",
              "type": "string"
            }
          },
          "required": [
            "applicability"
          ],
          "type": "object"
        },
        {
          "properties": {
            "applicability": {
              "const": "defined",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "applicability",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "LaneFactV12": {
      "description": "Fields that exist only on a lane make non-applicability explicit instead of\noverloading `null` or omission.",
      "oneOf": [
        {
          "properties": {
            "applicability": {
              "const": "notDefinedForLane",
              "type": "string"
            }
          },
          "required": [
            "applicability"
          ],
          "type": "object"
        },
        {
          "properties": {
            "applicability": {
              "const": "defined",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/StreamQualifiedVersionV1"
            }
          },
          "required": [
            "applicability",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "OperationBoundFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "functionOrCommand": {
          "type": "string"
        },
        "inputFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationKind": {
          "type": "string"
        },
        "principalFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "audience",
        "principalFingerprint",
        "authorityInstanceId",
        "operationKind",
        "functionOrCommand",
        "inputFingerprint"
      ],
      "type": "object"
    },
    "OperationIdentityV1": {
      "additionalProperties": false,
      "description": "`operationId` widens the shipped client-mutation id; this struct preserves\nevery bound fact the existing collision check already owns.",
      "properties": {
        "boundFacts": {
          "$ref": "#/$defs/OperationBoundFactsV1"
        },
        "issuance": {
          "$ref": "#/$defs/OperationIssuanceV1"
        },
        "key": {
          "$ref": "#/$defs/OperationKeyV1"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "issuance",
        "boundFacts"
      ],
      "type": "object"
    },
    "OperationIssuanceV1": {
      "description": "Issuance facts are structurally disjoint across client and host namespaces.\nThe authenticator is represented by its non-secret digest; admission later\nverifies the underlying server-issued artifact before constructing this\nvalue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "clientRange",
              "type": "string"
            },
            "range_end_exclusive": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "range_start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "counter",
            "range_start",
            "range_end_exclusive",
            "authority_authenticator_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "commit_ordinal": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "hostIncarnation",
              "type": "string"
            },
            "upstream_identity": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "upstream_identity",
            "commit_ordinal",
            "authority_authenticator_digest"
          ],
          "type": "object"
        }
      ]
    },
    "OperationKeyV1": {
      "additionalProperties": false,
      "description": "The physical key for suppression and envelope storage. Audience and all\nother semantic facts are compared facts, never key components.",
      "properties": {
        "operationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "type": "string"
        },
        "originatorClass": {
          "$ref": "#/$defs/OperationOriginatorClassV1"
        },
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "originatorClass",
        "operationId"
      ],
      "type": "object"
    },
    "OperationOriginatorClassV1": {
      "enum": [
        "client",
        "host"
      ],
      "type": "string"
    },
    "OperationReceiptStateV1": {
      "enum": [
        "pending",
        "committed",
        "refused"
      ],
      "type": "string"
    },
    "OperationReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/RetainedEnvelopeDetailV1"
        },
        "receiptDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/OperationReceiptStateV1"
        }
      },
      "required": [
        "state",
        "receiptDigest",
        "payload"
      ],
      "type": "object"
    },
    "RetainedEnvelopeDetailV1": {
      "description": "Bounded detail never becomes an ambiguous empty fact set: truncation and\nexpiry are first-class states, and secret-bearing material is an opaque\nprotected-lane reference rather than inline cleartext.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "detail": true,
            "retention": {
              "const": "inlineRedacted",
              "type": "string"
            }
          },
          "required": [
            "retention",
            "detail"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "custody_reference": {
              "type": "string"
            },
            "payload_bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "payload_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "retention": {
              "const": "protectedLane",
              "type": "string"
            }
          },
          "required": [
            "retention",
            "custody_reference",
            "payload_digest",
            "payload_bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "retention": {
              "const": "truncated",
              "type": "string"
            }
          },
          "required": [
            "retention"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "retention": {
              "const": "expired",
              "type": "string"
            }
          },
          "required": [
            "retention"
          ],
          "type": "object"
        }
      ]
    },
    "SnapshotAssociationKindV1": {
      "enum": [
        "producedCommit",
        "observedSnapshot"
      ],
      "type": "string"
    },
    "StreamQualifiedVersionV1": {
      "additionalProperties": false,
      "properties": {
        "association": {
          "$ref": "#/$defs/SnapshotAssociationKindV1"
        },
        "streamId": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "streamId",
        "version",
        "association"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/commit.envelope-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argumentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "authority": {
      "$ref": "#/$defs/EnvelopeAuthorityFactsV1"
    },
    "baseVersion": {
      "$ref": "#/$defs/LaneFactV12"
    },
    "coverage": {
      "$ref": "#/$defs/EnvelopeCoverageV1"
    },
    "ctxAnswers": {
      "$ref": "#/$defs/EnvelopeFactSetV1"
    },
    "effects": {
      "$ref": "#/$defs/EnvelopeEffectFactsV1"
    },
    "executableArtifactDigest": {
      "$ref": "#/$defs/LaneFactV1"
    },
    "identity": {
      "$ref": "#/$defs/OperationIdentityV1"
    },
    "planDigest": {
      "$ref": "#/$defs/LaneFactV1"
    },
    "principalSessionOrInvocationId": {
      "type": "string"
    },
    "readSet": {
      "$ref": "#/$defs/EnvelopeFactSetV1"
    },
    "receipt": {
      "$ref": "#/$defs/OperationReceiptV1"
    },
    "recordedAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "snapshot": {
      "$ref": "#/$defs/StreamQualifiedVersionV1"
    },
    "writeSet": {
      "$ref": "#/$defs/EnvelopeFactSetV1"
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "snapshot",
    "principalSessionOrInvocationId",
    "authority",
    "executableArtifactDigest",
    "argumentDigest",
    "planDigest",
    "baseVersion",
    "readSet",
    "writeSet",
    "ctxAnswers",
    "effects",
    "receipt",
    "coverage",
    "recordedAtMs"
  ],
  "title": "CommitEnvelopeV1",
  "type": "object"
}
