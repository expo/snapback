{
  "$defs": {
    "SearchClauseV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Term": {
              "$ref": "#/$defs/SearchTermV1"
            }
          },
          "required": [
            "Term"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Phrase": {
              "$ref": "#/$defs/SearchPhraseV1"
            }
          },
          "required": [
            "Phrase"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Prefix": {
              "$ref": "#/$defs/SearchTermV1"
            }
          },
          "required": [
            "Prefix"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Any": {
              "items": {
                "$ref": "#/$defs/SearchMatchAtomV1"
              },
              "type": "array"
            }
          },
          "required": [
            "Any"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Not": {
              "$ref": "#/$defs/SearchMatchAtomV1"
            }
          },
          "required": [
            "Not"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Filter": {
              "$ref": "#/$defs/SearchFilterV1"
            }
          },
          "required": [
            "Filter"
          ],
          "type": "object"
        }
      ]
    },
    "SearchFilterOpV1": {
      "description": "The one filter operator the v1 parser profile admits. A closed enum rather\nthan a free string so the deserialization grammar, the exported request\nschema, and the published client typings admit exactly the same set — a new\noperator is a new parser profile, not a wider string.\n\n@ref LLP 0131#the-search-fixture-cv-5 — every carrier of the AST grammar\nderives from or verifies against the one exported request schema.",
      "enum": [
        "eq"
      ],
      "type": "string"
    },
    "SearchFilterV1": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/SearchFilterOpV1"
        },
        "value": {
          "$ref": "#/$defs/SearchFilterValueV1"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "type": "object"
    },
    "SearchFilterValueV1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "The closed scalar vocabulary for equality-filter values. Previously this\nfield was an open `serde_json::Value` whose non-scalar shapes were refused\nlater by semantic validation; closing it at the deserialization grammar\nkeeps the accepted query set identical while letting every schema carrier\nstate the same admissible set."
    },
    "SearchMatchAtomV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Term": {
              "$ref": "#/$defs/SearchTermV1"
            }
          },
          "required": [
            "Term"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Phrase": {
              "$ref": "#/$defs/SearchPhraseV1"
            }
          },
          "required": [
            "Phrase"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Prefix": {
              "$ref": "#/$defs/SearchTermV1"
            }
          },
          "required": [
            "Prefix"
          ],
          "type": "object"
        }
      ]
    },
    "SearchPhraseV1": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    },
    "SearchQueryAstV1": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/SearchClauseV1"
          },
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "type": "object"
    },
    "SearchTermV1": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/search.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "query": {
      "$ref": "#/$defs/SearchQueryAstV1"
    }
  },
  "required": [
    "query"
  ],
  "title": "SearchRequestV1",
  "type": "object"
}
