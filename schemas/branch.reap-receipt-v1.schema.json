{
  "$defs": {
    "BranchId": {
      "description": "Stable identity of an ephemeral branch within one logical app.",
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/branch.reap-receipt-v1.schema.json",
