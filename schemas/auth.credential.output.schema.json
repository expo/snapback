{
  "$defs": {
    "AuthTokenType": {
      "enum": [
        "Bearer"
      ],
      "type": "string"
    },
    "SessionResponse": {
      "additionalProperties": false,
      "properties": {
        "absoluteExpiresAt": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expiresAt": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "provider",
        "createdAt",
        "expiresAt",
        "absoluteExpiresAt"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.credential.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A freshly issued session credential. The token is intentionally private:\ncallers may return the complete response, but cannot pluck the bearer into\nan arbitrary serializable structure.",
  "properties": {
    "refreshAfter": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/SessionResponse"
    },
    "token": {
      "type": "string"
    },
    "tokenType": {
      "$ref": "#/$defs/AuthTokenType"
    }
  },
  "required": [
    "token",
    "tokenType",
    "refreshAfter",
    "session"
  ],
  "title": "AuthCredentialResponse",
  "type": "object"
}
