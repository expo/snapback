{
  "$defs": {
    "AuthTokenType": {
      "enum": [
        "Bearer"
      ],
      "type": "string"
    },
    "AuthorityDescriptor": {
      "additionalProperties": false,
      "description": "Opaque server-issued consistency descriptor for one queued mutation.\nPossession grants no authority; the invocation gate first resolves a live\ncredential and only then compares this value with its prepared authority.\n\n@ref LLP 0039#replay-parity-and-the-authority-instance-id — this is a\n  dedicated MutationRequest channel, never a ctx-answer-ledger member.",
      "properties": {
        "authorityInstanceId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "descriptorVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sessionGeneration": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "descriptorVersion",
        "authorityInstanceId",
        "sessionGeneration"
      ],
      "type": "object"
    },
    "SessionResponse": {
      "additionalProperties": false,
      "properties": {
        "absoluteExpiresAt": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "expiresAt": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "provider",
        "createdAt",
        "expiresAt",
        "absoluteExpiresAt"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.credential.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A freshly issued session credential. The token is intentionally private:\ncallers may return the complete response, but cannot pluck the bearer into\nan arbitrary serializable structure.",
  "properties": {
    "authorityDescriptor": {
      "$ref": "#/$defs/AuthorityDescriptor"
    },
    "refreshAfter": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/SessionResponse"
    },
    "token": {
      "type": "string"
    },
    "tokenType": {
      "$ref": "#/$defs/AuthTokenType"
    }
  },
  "required": [
    "token",
    "tokenType",
    "refreshAfter",
    "session",
    "authorityDescriptor"
  ],
  "title": "AuthCredentialResponse",
  "type": "object"
}
