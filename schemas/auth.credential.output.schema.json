{
  "$defs": {
    "AuthTokenType": {
      "enum": [
        "Bearer"
      ],
      "type": "string"
    },
    "CredentialAuthorityDescriptorSchema": {
      "additionalProperties": false,
      "description": "Credential issuance always describes a live session, so unlike the shared\nhandshake descriptor (where zero is the anonymous sentinel) its generation\nis strictly positive.",
      "properties": {
        "authorityInstanceId": {
          "pattern": "^(?:[a-z][a-z0-9]{0,11}_[0-9a-hjkmnp-tv-z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
          "type": "string"
        },
        "descriptorVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "sessionGeneration": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "descriptorVersion",
        "authorityInstanceId",
        "sessionGeneration"
      ],
      "type": "object"
    },
    "SessionResponse": {
      "additionalProperties": false,
      "properties": {
        "absoluteExpiresAt": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "expiresAt": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "provider",
        "createdAt",
        "expiresAt",
        "absoluteExpiresAt"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.credential.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A freshly issued session credential. The token is intentionally private:\ncallers may return the complete response, but cannot pluck the bearer into\nan arbitrary serializable structure.",
  "properties": {
    "authorityDescriptor": {
      "$ref": "#/$defs/CredentialAuthorityDescriptorSchema"
    },
    "recoveryCodes": {
      "description": "One-time recovery custody. Ordinary exchange/signin/reset/refresh\nresponses omit this member byte-for-byte; signup and recovery consume\nattach it to this same credential DTO rather than minting a parallel\ncredential response shape.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "refreshAfter": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/SessionResponse"
    },
    "token": {
      "type": "string"
    },
    "tokenType": {
      "$ref": "#/$defs/AuthTokenType"
    }
  },
  "required": [
    "token",
    "tokenType",
    "refreshAfter",
    "session",
    "authorityDescriptor"
  ],
  "title": "AuthCredentialResponse",
  "type": "object"
}
