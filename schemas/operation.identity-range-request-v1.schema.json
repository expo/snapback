{
  "$defs": {
    "AuthInput": {
      "properties": {
        "principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AuthorityDescriptor": {
      "additionalProperties": false,
      "description": "Opaque server-issued consistency descriptor for one queued mutation.\nPossession grants no authority; the invocation gate first resolves a live\ncredential and only then compares this value with its prepared authority.\n\n@ref LLP 0039#replay-parity-and-the-authority-instance-id — this is a\n  dedicated MutationRequest channel, never a ctx-answer-ledger member.",
      "properties": {
        "authorityInstanceId": {
          "pattern": "^(?:[a-z][a-z0-9]{0,11}_[0-9a-hjkmnp-tv-z]{26}|[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
          "type": "string"
        },
        "descriptorVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sessionGeneration": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "descriptorVersion",
        "authorityInstanceId",
        "sessionGeneration"
      ],
      "type": "object"
    },
    "ClientIdentityRangeV1": {
      "additionalProperties": false,
      "description": "Server-issued finite client range. The authenticator is a digest in this\npublic projection; the issuing service retains/verifies the secret-bearing\nartifact outside application data.",
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityAuthenticatorDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "epochId": {
          "type": "string"
        },
        "epochSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expiresAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "issuedAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rangeEndExclusive": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rangeStart": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "audience",
        "authorityInstanceId",
        "epochId",
        "epochSequence",
        "rangeStart",
        "rangeEndExclusive",
        "issuedAtMs",
        "expiresAtMs",
        "authorityAuthenticatorDigest"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/operation.identity-range-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public issue/refresh request for the finite client identity range. The\nlive credential remains the authority; the optional descriptor and prior\nrange are non-authorizing continuity assertions checked against the\nserver-derived authority before any range is minted.\n\n@ref LLP 0163#contract-summary-normative-details-per-llp-0162-0-2 — range\n  issuance is bound to the authority incarnation and never grants caller-\n  selected host namespace access.",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthInput",
      "default": {
        "principal": null,
        "session_id": null,
        "user_id": null
      }
    },
    "authorityDescriptor": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorityDescriptor"
        },
        {
          "type": "null"
        }
      ]
    },
    "clientAudienceId": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "type": "string"
    },
    "previousRange": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientIdentityRangeV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "default": 1,
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "clientAudienceId"
  ],
  "title": "OperationIdentityRangeRequestV1",
  "type": "object"
}
