{
  "$defs": {
    "PasswordRotateRequest": {
      "additionalProperties": false,
      "properties": {
        "currentPassword": {
          "type": "string"
        },
        "newPassword": {
          "type": "string"
        }
      },
      "required": [
        "currentPassword",
        "newPassword"
      ],
      "type": "object"
    },
    "PasswordSetRequest": {
      "additionalProperties": false,
      "properties": {
        "currentPassword": {
          "description": "Must be present and null; omission is rejected by serde.",
          "type": "null"
        },
        "newPassword": {
          "type": "string"
        },
        "stepUp": {
          "$ref": "#/$defs/PasswordSetStepUpRequest"
        }
      },
      "required": [
        "currentPassword",
        "newPassword",
        "stepUp"
      ],
      "type": "object"
    },
    "PasswordSetStepUpRequest": {
      "additionalProperties": false,
      "properties": {
        "challengeId": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "challengeId",
        "code"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.password-change.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/PasswordRotateRequest"
    },
    {
      "$ref": "#/$defs/PasswordSetRequest"
    }
  ],
  "description": "The tag is the presence/null value of `currentPassword`: a string selects\nrotation, while an explicit null selects first-set and requires step-up.\nThe custom visitor is provided by serde's untagged enum while each member\nremains independently closed.",
  "title": "PasswordChangeRequest"
}
