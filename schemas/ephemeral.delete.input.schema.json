{
  "$defs": {
    "AuthContext": {
      "properties": {
        "permissions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stream_initiator": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamInitiator"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "permissions"
      ],
      "type": "object"
    },
    "StreamInitiator": {
      "description": "Stable privacy identity for a streaming action. Session reconnects compare\nthe user id, service reconnects the credential id, while anonymous access\nremains connection-bound.\n\n@ref LLP 0204#d91--streaming-conversations — possession of a\nroom key is never stream read authority.",
      "oneOf": [
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "session_user",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "service_credential",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "anonymous_connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/ephemeral.delete.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "auth": {
      "$ref": "#/$defs/AuthContext"
    },
    "collection": {
      "type": "string"
    },
    "connection_id": {
      "type": "string"
    },
    "custom_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_entry_generation": {
      "default": null,
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "expected_scope_epoch": {
      "default": null,
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "scope": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "collection",
    "scope",
    "connection_id",
    "auth"
  ],
  "title": "DeleteRequest",
  "type": "object"
}
