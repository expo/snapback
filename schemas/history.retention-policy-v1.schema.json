{
  "$id": "https://schemas.snapback.dev/snapback.v0/history.retention-policy-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "maxRows": {
      "description": "Legacy v1 table-wide row bound. Schema-declared per-record retention is\nprojected into the distinct durable v2 policy table and never changes\nthis committed `maxRows` meaning.",
      "format": "uint64",
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "retainMs": {
      "format": "uint64",
      "maximum": 2592000000,
      "minimum": 1,
      "type": "integer"
    },
    "table": {
      "type": "string"
    }
  },
  "required": [
    "table",
    "retainMs",
    "maxRows"
  ],
  "title": "HistoryRetentionPolicyV1",
  "type": "object"
}
