{
  "$defs": {
    "ApprovedOperationFactsV1": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/ForkCoverageV1"
        },
        "ctxAnswers": true,
        "decision": true,
        "effects": {
          "items": true,
          "type": "array"
        },
        "readFacts": true,
        "result": true,
        "writes": {
          "items": {
            "$ref": "#/$defs/LogicalWriteFactV1"
          },
          "type": "array"
        }
      },
      "required": [
        "readFacts",
        "ctxAnswers",
        "decision",
        "result",
        "writes",
        "effects",
        "coverage"
      ],
      "type": "object"
    },
    "BranchId": {
      "description": "Stable identity of an ephemeral branch within one logical app.",
      "type": "string"
    },
    "ForkCoverageV1": {
      "additionalProperties": false,
      "properties": {
        "assetsCovered": {
          "type": "boolean"
        },
        "coveredLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "effectsCovered": {
          "type": "boolean"
        },
        "schemaCovered": {
          "type": "boolean"
        },
        "systemFieldsCovered": {
          "type": "boolean"
        },
        "uncoveredLanes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "coveredLanes",
        "uncoveredLanes",
        "schemaCovered",
        "systemFieldsCovered",
        "assetsCovered",
        "effectsCovered"
      ],
      "type": "object"
    },
    "LogicalWriteFactV1": {
      "additionalProperties": false,
      "properties": {
        "after": true,
        "rowId": {
          "type": "string"
        },
        "tableName": {
          "type": "string"
        }
      },
      "required": [
        "tableName",
        "rowId"
      ],
      "type": "object"
    },
    "OperationBoundFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "functionOrCommand": {
          "type": "string"
        },
        "inputFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationKind": {
          "type": "string"
        },
        "principalFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "audience",
        "principalFingerprint",
        "authorityInstanceId",
        "operationKind",
        "functionOrCommand",
        "inputFingerprint"
      ],
      "type": "object"
    },
    "OperationIdentityV1": {
      "additionalProperties": false,
      "description": "`operationId` widens the shipped client-mutation id; this struct preserves\nevery bound fact the existing collision check already owns.",
      "properties": {
        "boundFacts": {
          "$ref": "#/$defs/OperationBoundFactsV1"
        },
        "issuance": {
          "$ref": "#/$defs/OperationIssuanceV1"
        },
        "key": {
          "$ref": "#/$defs/OperationKeyV1"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "issuance",
        "boundFacts"
      ],
      "type": "object"
    },
    "OperationIssuanceV1": {
      "description": "Issuance facts are structurally disjoint across client and host namespaces.\nThe authenticator is represented by its non-secret digest; admission later\nverifies the underlying server-issued artifact before constructing this\nvalue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "clientRange",
              "type": "string"
            },
            "range_end_exclusive": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "range_start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "counter",
            "range_start",
            "range_end_exclusive",
            "authority_authenticator_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "commit_ordinal": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "hostIncarnation",
              "type": "string"
            },
            "upstream_identity": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "upstream_identity",
            "commit_ordinal",
            "authority_authenticator_digest"
          ],
          "type": "object"
        }
      ]
    },
    "OperationKeyV1": {
      "additionalProperties": false,
      "description": "The physical key for suppression and envelope storage. Audience and all\nother semantic facts are compared facts, never key components.",
      "properties": {
        "operationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "type": "string"
        },
        "originatorClass": {
          "$ref": "#/$defs/OperationOriginatorClassV1"
        },
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "originatorClass",
        "operationId"
      ],
      "type": "object"
    },
    "OperationOriginatorClassV1": {
      "enum": [
        "client",
        "host"
      ],
      "type": "string"
    },
    "ReplayCustodyClassV1": {
      "enum": [
        "inlineRedacted",
        "protectedReference",
        "unretainable"
      ],
      "type": "string"
    },
    "RetainedReplayInputV1": {
      "additionalProperties": false,
      "properties": {
        "custody": {
          "$ref": "#/$defs/ReplayCustodyClassV1"
        },
        "name": {
          "type": "string"
        },
        "value": true
      },
      "required": [
        "name",
        "custody",
        "value"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/branch.operation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvedFacts": {
      "$ref": "#/$defs/ApprovedOperationFactsV1"
    },
    "approvedFactsDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "artifactIdentity": {
      "type": "string"
    },
    "branchId": {
      "$ref": "#/$defs/BranchId"
    },
    "canonicalArguments": true,
    "causalPredecessors": {
      "items": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "childVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "functionOrCommand": {
      "type": "string"
    },
    "grantId": {
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/OperationIdentityV1"
    },
    "principalId": {
      "type": "string"
    },
    "readBaseline": true,
    "recordedAtMs": {
      "format": "int64",
      "type": "integer"
    },
    "replayInputs": {
      "items": {
        "$ref": "#/$defs/RetainedReplayInputV1"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "branchId",
    "childVersion",
    "identity",
    "artifactIdentity",
    "functionOrCommand",
    "canonicalArguments",
    "principalId",
    "grantId",
    "readBaseline",
    "replayInputs",
    "causalPredecessors",
    "approvedFacts",
    "approvedFactsDigest",
    "recordedAtMs"
  ],
  "title": "BranchOperationV1",
  "type": "object"
}
