    },
    "CheckpointSubstrateV1": {
      "enum": [
        "materialized",
        "receiptOnly"
      ],
      "type": "string"
    },
    "ProofClassV1": {
      "enum": [
        "inventory",
        "verifiedCopyFidelity",
        "independentBoundaryProof"
      ],
      "type": "string"
    }
