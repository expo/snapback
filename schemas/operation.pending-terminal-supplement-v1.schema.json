{
  "$defs": {
    "OperationBoundFactsV1": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "functionOrCommand": {
          "type": "string"
        },
        "inputFingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "operationKind": {
          "type": "string"
        },
        "principalFingerprint": {
          "type": "string"
        }
      },
      "required": [
        "audience",
        "principalFingerprint",
        "authorityInstanceId",
        "operationKind",
        "functionOrCommand",
        "inputFingerprint"
      ],
      "type": "object"
    },
    "OperationIdentityV1": {
      "additionalProperties": false,
      "description": "`operationId` widens the shipped client-mutation id; this struct preserves\nevery bound fact the existing collision check already owns.",
      "properties": {
        "boundFacts": {
          "$ref": "#/$defs/OperationBoundFactsV1"
        },
        "issuance": {
          "$ref": "#/$defs/OperationIssuanceV1"
        },
        "key": {
          "$ref": "#/$defs/OperationKeyV1"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "key",
        "issuance",
        "boundFacts"
      ],
      "type": "object"
    },
    "OperationIssuanceV1": {
      "description": "Issuance facts are structurally disjoint across client and host namespaces.\nThe authenticator is represented by its non-secret digest; admission later\nverifies the underlying server-issued artifact before constructing this\nvalue.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "counter": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "clientRange",
              "type": "string"
            },
            "range_end_exclusive": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "range_start": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "counter",
            "range_start",
            "range_end_exclusive",
            "authority_authenticator_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_authenticator_digest": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "commit_ordinal": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "epoch_id": {
              "type": "string"
            },
            "kind": {
              "const": "hostIncarnation",
              "type": "string"
            },
            "upstream_identity": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "epoch_id",
            "upstream_identity",
            "commit_ordinal",
            "authority_authenticator_digest"
          ],
          "type": "object"
        }
      ]
    },
    "OperationKeyV1": {
      "additionalProperties": false,
      "description": "The physical key for suppression and envelope storage. Audience and all\nother semantic facts are compared facts, never key components.",
      "properties": {
        "operationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
          "type": "string"
        },
        "originatorClass": {
          "$ref": "#/$defs/OperationOriginatorClassV1"
        },
        "streamId": {
          "type": "string"
        }
      },
      "required": [
        "streamId",
        "originatorClass",
        "operationId"
      ],
      "type": "object"
    },
    "OperationOriginatorClassV1": {
      "enum": [
        "client",
        "host"
      ],
      "type": "string"
    },
    "PendingOperationTerminalOutcomeV1": {
      "description": "Terminal outcomes for an operation whose truthful v1 publication receipt\nwas Pending. This additive carrier deliberately does not widen\n`OperationTerminalOutcomeV1`, whose existing suppression/tombstone wire\ncontract remains unchanged.",
      "enum": [
        "committed",
        "rolled-back"
      ],
      "type": "string"
    },
    "SnapshotAssociationKindV1": {
      "enum": [
        "producedCommit",
        "observedSnapshot"
      ],
      "type": "string"
    },
    "StreamQualifiedVersionV1": {
      "additionalProperties": false,
      "properties": {
        "association": {
          "$ref": "#/$defs/SnapshotAssociationKindV1"
        },
        "streamId": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "streamId",
        "version",
        "association"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/operation.pending-terminal-supplement-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Terminal supplement for a pending v1 envelope. The transition digest binds\nthe exact identity, publication P, pending receipt digest, terminal outcome,\nand terminal receipt digest, so a finalizer can be replayed exactly but can\nnever silently rewrite what publication said.",
  "properties": {
    "identity": {
      "$ref": "#/$defs/OperationIdentityV1"
    },
    "pendingReceiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/StreamQualifiedVersionV1"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "terminalAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "terminalOutcome": {
      "$ref": "#/$defs/PendingOperationTerminalOutcomeV1"
    },
    "terminalReceiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "terminalWriteSetCount": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "terminalWriteSetDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "transitionDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "identity",
    "publication",
    "pendingReceiptDigest",
    "terminalOutcome",
    "terminalReceiptDigest",
    "terminalWriteSetDigest",
    "terminalWriteSetCount",
    "terminalAtMs",
    "transitionDigest"
  ],
  "title": "PendingOperationTerminalSupplementV1",
  "type": "object"
}
