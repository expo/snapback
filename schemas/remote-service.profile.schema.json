{
  "$defs": {
    "PublishedArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "RemoteEndpointPolicy": {
      "additionalProperties": false,
      "properties": {
        "allowAmbientProxy": {
          "type": "boolean"
        },
        "allowRedirects": {
          "type": "boolean"
        },
        "authority": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "valueInArguments": {
          "type": "boolean"
        },
        "valueInArtifacts": {
          "type": "boolean"
        },
        "valueInEnvironment": {
          "type": "boolean"
        },
        "valueInInfoPlist": {
          "type": "boolean"
        }
      },
      "required": [
        "scheme",
        "authority",
        "valueInArtifacts",
        "valueInArguments",
        "valueInEnvironment",
        "valueInInfoPlist",
        "allowRedirects",
        "allowAmbientProxy"
      ],
      "type": "object"
    },
    "RemoteServiceDataTierIdentity": {
      "additionalProperties": false,
      "properties": {
        "caseCount": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "corpus": {
          "type": "string"
        },
        "corpusFormatVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "corpusManifest": {
          "$ref": "#/$defs/PublishedArtifactRef"
        },
        "ledgerVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "profile": {
          "$ref": "#/$defs/PublishedArtifactRef"
        },
        "profileVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "corpus",
        "profileVersion",
        "corpusFormatVersion",
        "ledgerVersion",
        "caseCount",
        "profile",
        "corpusManifest"
      ],
      "type": "object"
    },
    "RemoteServiceGitPublication": {
      "additionalProperties": false,
      "properties": {
        "addressing": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "profilePath": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "addressing",
        "repository",
        "profilePath"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/remote-service.profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appId": {
      "type": "string"
    },
    "artifactKind": {
      "type": "string"
    },
    "authCapabilityManifest": {
      "$ref": "#/$defs/PublishedArtifactRef"
    },
    "dataCapabilityManifest": {
      "$ref": "#/$defs/PublishedArtifactRef"
    },
    "dataTier": {
      "$ref": "#/$defs/RemoteServiceDataTierIdentity"
    },
    "endpointPolicy": {
      "$ref": "#/$defs/RemoteEndpointPolicy"
    },
    "localServerLifecycle": {
      "type": "boolean"
    },
    "profileId": {
      "type": "string"
    },
    "profileVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "publication": {
      "$ref": "#/$defs/RemoteServiceGitPublication"
    },
    "schemaVersion": {
      "type": "string"
    },
    "serverCapabilityManifest": {
      "$ref": "#/$defs/PublishedArtifactRef"
    },
    "targetProfileId": {
      "type": "string"
    }
  },
  "required": [
    "artifactKind",
    "schemaVersion",
    "profileVersion",
    "profileId",
    "appId",
    "targetProfileId",
    "localServerLifecycle",
    "publication",
    "endpointPolicy",
    "serverCapabilityManifest",
    "authCapabilityManifest",
    "dataCapabilityManifest",
    "dataTier"
  ],
  "title": "RemoteServiceProfile",
  "type": "object"
}
