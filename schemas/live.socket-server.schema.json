{
  "$defs": {
    "Diagnostic": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subsystem": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subsystem",
        "message",
        "details"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    },
    "EphemeralEntry": {
      "properties": {
        "entry_version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "received_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scope_epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "key",
        "value",
        "received_at_ms",
        "expires_at_ms",
        "scope_epoch",
        "entry_version"
      ],
      "type": "object"
    },
    "EphemeralError": {
      "properties": {
        "code": {
          "$ref": "#/$defs/EphemeralErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "EphemeralErrorCode": {
      "oneOf": [
        {
          "enum": [
            "UnknownCollection",
            "Unauthorized",
            "InvalidScope",
            "MissingKey",
            "MissingOwner",
            "InvalidTtl",
            "ValueTooLarge",
            "RateLimited",
            "IncompatibleCollectionDefinition"
          ],
          "type": "string"
        },
        {
          "const": "RoomLimitExceeded",
          "description": "A hard room/store limit (active rooms, entries per room, subscribers\nper room, aggregate room bytes) rejected the operation. The limits are\ncapability facts; hitting one is a structured rejection, never a\nsilent eviction of live entries.\n\n@ref LLP 0013#room-store-model — memory pressure must be explicit.",
          "type": "string"
        }
      ]
    },
    "EphemeralMessage": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Snapshot": {
              "properties": {
                "entries": {
                  "items": {
                    "$ref": "#/$defs/EphemeralEntry"
                  },
                  "type": "array"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "scope_epoch": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "scope_epoch",
                "entries"
              ],
              "type": "object"
            }
          },
          "required": [
            "Snapshot"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Upsert": {
              "properties": {
                "entry": {
                  "$ref": "#/$defs/EphemeralEntry"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                }
              },
              "required": [
                "room",
                "entry"
              ],
              "type": "object"
            }
          },
          "required": [
            "Upsert"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Remove": {
              "properties": {
                "entry_version": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "key": {
                  "type": "string"
                },
                "reason": {
                  "$ref": "#/$defs/RemoveReason"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "scope_epoch": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "key",
                "scope_epoch",
                "entry_version",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "Remove"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ResyncRequired": {
              "properties": {
                "reason": {
                  "$ref": "#/$defs/ResyncReason"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "scope_epoch": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "scope_epoch",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "ResyncRequired"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Error": {
              "properties": {
                "error": {
                  "$ref": "#/$defs/EphemeralError"
                },
                "room": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/RoomId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          },
          "required": [
            "Error"
          ],
          "type": "object"
        }
      ]
    },
    "RemoveReason": {
      "description": "Why an entry was removed. `AuthRevoked` was removed 2026-07-02: durable\npermission-change revocation is not integrated yet (LLP 0026 §Auth and\nrevocation), so the variant was unreachable vocabulary. Reintroduce it with\nthe event that owns it.\n\n@ref LLP 0026#finding-scope-epoch-machinery-was-dead-code-recorded-2026-07-02 — live-or-removed resolution.",
      "enum": [
        "Deleted",
        "Disconnected",
        "Expired"
      ],
      "type": "string"
    },
    "ResyncReason": {
      "description": "Why a subscriber must resnapshot. `Restarted` is sent when an explicit\nruntime reset discards room state under live connections; `EpochChanged`\nwhen a destructive definition replacement retires room epochs (the\nENG-22478 review-fix-D reasons, ratified upstream and adopted by the\nsharded authority); `Disconnected` when a server-side disconnect (the L2\nreaper, or the admin route) wiped the connection's room registrations\nwhile its socket was still open and registered (ENG-23427). `AuthChanged`\nwas removed 2026-07-02: auth revocation is not integrated, so it was\nunreachable vocabulary.\n\n@ref LLP 0026#finding-scope-epoch-machinery-was-dead-code-recorded-2026-07-02 — live-or-removed resolution.",
      "enum": [
        "QueueOverflow",
        "EpochChanged",
        "Restarted",
        "Disconnected"
      ],
      "type": "string"
    },
    "RoomId": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "routing_key": {
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "collection",
        "scope",
        "routing_key"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.socket-server.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A control-lane frame the server sends on the live WebSocket (the durable\nlane's [`LiveEnvelope`] payloads arrive on the same socket, unwrapped —\na socket client dispatches on `kind` across both families).",
  "oneOf": [
    {
      "description": "Answer to a client `ping` (LLP 0034 D1 liveness probe).",
      "properties": {
        "kind": {
          "const": "pong",
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "serverTimeMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "serverTimeMs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "description": "Success acknowledgment for a socket-carried ephemeral operation. The\noperation-specific result body (`message`, `outcome`, `removed`, ...)\nis flattened alongside the envelope fields.",
      "properties": {
        "kind": {
          "const": "ephemeral_ack",
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "operation"
      ],
      "type": "object"
    },
    {
      "description": "Failure for a socket-carried operation (including undecodable frames,\nwhere `request_id` is unknown and `operation` is `decode`).",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic"
        },
        "kind": {
          "const": "ephemeral_error",
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "diagnostic"
      ],
      "type": "object"
    },
    {
      "description": "An ephemeral-lane room message (presence/cursors), wrapped so the\nsocket dispatch stays on `kind`.",
      "properties": {
        "kind": {
          "const": "ephemeral",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/EphemeralMessage"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "Fallback for a durable payload that was not valid UTF-8 (should not\nhappen — durable payloads are serialized JSON — but the lane must\nnever drop a message silently).",
      "properties": {
        "kind": {
          "const": "durable_bytes",
          "type": "string"
        },
        "payload": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    }
  ],
  "title": "LiveSocketServerFrame"
}
