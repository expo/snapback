{
  "$defs": {
    "Diagnostic": {
      "properties": {
        "code": {
          "type": "string"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subsystem": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "subsystem",
        "message",
        "details"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ],
      "type": "string"
    },
    "EphemeralEntry": {
      "properties": {
        "entry_version": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "received_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scope_epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "key",
        "value",
        "received_at_ms",
        "expires_at_ms",
        "scope_epoch",
        "entry_version"
      ],
      "type": "object"
    },
    "EphemeralError": {
      "properties": {
        "code": {
          "$ref": "#/$defs/EphemeralErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "EphemeralErrorCode": {
      "oneOf": [
        {
          "enum": [
            "UnknownCollection",
            "RoomNotFound",
            "EntryNotFound",
            "StaleScopeEpoch",
            "StaleEntryGeneration",
            "Unauthorized",
            "InvalidScope",
            "MissingKey",
            "MissingOwner",
            "InvalidTtl",
            "ValueTooLarge",
            "MetadataTooLarge",
            "RateLimited",
            "IncompatibleCollectionDefinition"
          ],
          "type": "string"
        },
        {
          "const": "RoomLimitExceeded",
          "description": "A hard room/store limit (active rooms, entries per room, subscribers\nper room, aggregate room bytes) rejected the operation. The limits are\ncapability facts; hitting one is a structured rejection, never a\nsilent eviction of live entries.\n\n@ref LLP 0013#room-store-model — memory pressure must be explicit.",
          "type": "string"
        },
        {
          "const": "GenerationExhausted",
          "description": "A client-visible room, entry, or delivery identity reached the final\nexact plain-JSON integer. Reuse would create an ABA, so the operation\nis refused without mutating predecessor state.",
          "type": "string"
        },
        {
          "const": "AuthorityPending",
          "description": "A permission-changing transaction installed the room's precommit\nauthority barrier. No protected sink may act until exact finalization\nand fresh reauthorization complete.",
          "type": "string"
        },
        {
          "const": "PermissionDenied",
          "description": "Trusted server-side durable membership denial. Unlike the legacy\n`Unauthorized` code, this is safe for the client auth coordinator to\ntreat as an authorization-loss transition.",
          "type": "string"
        }
      ]
    },
    "EphemeralMessage": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Snapshot": {
              "properties": {
                "entries": {
                  "items": {
                    "$ref": "#/$defs/EphemeralEntry"
                  },
                  "type": "array"
                },
                "ephemeral_authority_instance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "high_water_version": {
                  "description": "Authoritative room cursor at the instant the snapshot and\nsubscriber registration became one operation. This remains valid\neven when `entries` is empty or the newest event was a delete.",
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "room_authority_generation": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "scope_epoch": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "scope_epoch",
                "room_authority_generation",
                "high_water_version",
                "entries"
              ],
              "type": "object"
            }
          },
          "required": [
            "Snapshot"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Upsert": {
              "properties": {
                "entry": {
                  "$ref": "#/$defs/EphemeralEntry"
                },
                "ephemeral_authority_instance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "room_authority_generation": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "room_authority_generation",
                "entry"
              ],
              "type": "object"
            }
          },
          "required": [
            "Upsert"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Remove": {
              "properties": {
                "entry_version": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "ephemeral_authority_instance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "key": {
                  "type": "string"
                },
                "reason": {
                  "$ref": "#/$defs/RemoveReason"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "room_authority_generation": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "scope_epoch": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "key",
                "scope_epoch",
                "room_authority_generation",
                "entry_version",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "Remove"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ResyncRequired": {
              "properties": {
                "ephemeral_authority_instance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "$ref": "#/$defs/ResyncReason"
                },
                "room": {
                  "$ref": "#/$defs/RoomId"
                },
                "room_authority_generation": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "scope_epoch": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "room",
                "scope_epoch",
                "room_authority_generation",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "ResyncRequired"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Error": {
              "properties": {
                "ephemeral_authority_instance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "error": {
                  "$ref": "#/$defs/EphemeralError"
                },
                "room": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/RoomId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "room_authority_generation": {
                  "format": "uint64",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          },
          "required": [
            "Error"
          ],
          "type": "object"
        }
      ]
    },
    "LiveAuthErrorCode": {
      "description": "Closed terminal classes understood by item-5 clients. Later invalidation\ndispositions must revise the schema instead of smuggling new strings into\nthis family.",
      "enum": [
        "SNAPBACK_AUTH_SESSION_EXPIRED",
        "SNAPBACK_AUTH_STREAM_RESET",
        "SNAPBACK_AUTH_MODE_PENDING",
        "SNAPBACK_AUTH_SCOPED_TOKEN_INVALID"
      ],
      "type": "string"
    },
    "LiveAuthErrorReason": {
      "enum": [
        "expired",
        "revoked",
        "reset",
        "restore",
        "downgrade",
        "mode_transition"
      ],
      "type": "string"
    },
    "LiveAuthorityDisposition": {
      "description": "Whether a terminal frame ends only the presented carrier or reflects a\ndurable authority deletion. Clients may replace an expired/evicted carrier,\nbut must delete local durable authority state after `durableDelete`.",
      "enum": [
        "carrier",
        "durableDelete"
      ],
      "type": "string"
    },
    "RemoveReason": {
      "description": "Why an entry was removed. `AuthRevoked` was removed 2026-07-02: durable\npermission-change revocation is not integrated yet (LLP 0026 §Auth and\nrevocation), so the variant was unreachable vocabulary. Reintroduce it with\nthe event that owns it.\n\n@ref LLP 0026#finding-scope-epoch-machinery-was-dead-code-recorded-2026-07-02 — live-or-removed resolution.",
      "enum": [
        "Deleted",
        "Disconnected",
        "Expired",
        "AuthRevoked"
      ],
      "type": "string"
    },
    "ResyncReason": {
      "description": "Why a subscriber must resnapshot. `Restarted` is sent when an explicit\nruntime reset discards room state under live connections; `EpochChanged`\nwhen a destructive definition replacement retires room epochs (the\nENG-22478 review-fix-D reasons, ratified upstream and adopted by the\nsharded authority); `Disconnected` when a server-side disconnect (the L2\nreaper, or the admin route) wiped the connection's room registrations\nwhile its socket was still open and registered (ENG-23427). `AuthChanged`\nwas removed 2026-07-02: auth revocation is not integrated, so it was\nunreachable vocabulary.\n\n@ref LLP 0026#finding-scope-epoch-machinery-was-dead-code-recorded-2026-07-02 — live-or-removed resolution.",
      "enum": [
        "QueueOverflow",
        "EpochChanged",
        "Restarted",
        "Disconnected",
        "AuthChanged"
      ],
      "type": "string"
    },
    "RoomId": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "routing_key": {
          "type": "string"
        },
        "scope": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "collection",
        "scope",
        "routing_key"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.socket-server.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A control-lane frame the server sends on the live WebSocket (the durable\nlane's [`LiveEnvelope`] payloads arrive on the same socket, unwrapped —\na socket client dispatches on `kind` across both families).",
  "oneOf": [
    {
      "description": "First successful frame on a sender-constrained browser socket. Browser\ncode cannot read the upgrade response headers, so this repeats the\nalready-committed successor nonce in-band before application delivery.\n\n@ref LLP 0077#author-decisions--2026-07-23 — the custody queue releases\nonly after this observable successor is durably installed.",
      "properties": {
        "kind": {
          "const": "sender_nonce",
          "type": "string"
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "nonce"
      ],
      "type": "object"
    },
    {
      "description": "Terminal authority loss for the exact socket/grant generation. The\nframe intentionally carries no authority identifier; a client applies\nit only to the capture that owns this socket and then treats close code\n4401 as terminal rather than reconnectable.\n\n@ref LLP 0059#typed-terminal-auth-error — terminal live closure is a\n  closed, identifier-free wire event.",
      "properties": {
        "authorityDisposition": {
          "$ref": "#/$defs/LiveAuthorityDisposition"
        },
        "code": {
          "$ref": "#/$defs/LiveAuthErrorCode"
        },
        "kind": {
          "const": "auth_error",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/LiveAuthErrorReason"
        }
      },
      "required": [
        "kind",
        "code",
        "reason",
        "authorityDisposition"
      ],
      "type": "object"
    },
    {
      "description": "Answer to a client `ping` (LLP 0034 D1 liveness probe).",
      "properties": {
        "kind": {
          "const": "pong",
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "serverTimeMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "serverTimeMs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "description": "Success acknowledgment for a socket-carried ephemeral operation. The\noperation-specific result body (`message`, `outcome`, `removed`, ...)\nis flattened alongside the envelope fields.",
      "properties": {
        "kind": {
          "const": "ephemeral_ack",
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "operation"
      ],
      "type": "object"
    },
    {
      "description": "Failure for a socket-carried operation (including undecodable frames,\nwhere `request_id` is unknown and `operation` is `decode`).",
      "properties": {
        "diagnostic": {
          "$ref": "#/$defs/Diagnostic"
        },
        "kind": {
          "const": "ephemeral_error",
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "diagnostic"
      ],
      "type": "object"
    },
    {
      "description": "An ephemeral-lane room message (presence/cursors), wrapped so the\nsocket dispatch stays on `kind`.",
      "properties": {
        "kind": {
          "const": "ephemeral",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/EphemeralMessage"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "Fallback for a durable payload that was not valid UTF-8 (should not\nhappen — durable payloads are serialized JSON — but the lane must\nnever drop a message silently).",
      "properties": {
        "kind": {
          "const": "durable_bytes",
          "type": "string"
        },
        "payload": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "type": "object"
    }
  ],
  "title": "LiveSocketServerFrame"
}
