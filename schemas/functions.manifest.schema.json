          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "IbexModule": {
              "$ref": "#/$defs/IbexModule"
            }
          },
          "required": [
            "IbexModule"
          ],
          "type": "object"
        }
      ]
    },
    "HandlerPlan": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Query": {
              "$ref": "#/$defs/QueryPlan"
            }
          },
          "required": [
            "Query"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Mutation": {
              "$ref": "#/$defs/MutationPlan"
            }
          },
          "required": [
            "Mutation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Action": {
              "$ref": "#/$defs/ActionPlan"
            }
          },
          "required": [
            "Action"
          ],
          "type": "object"
        }
      ]
    },
    "IbexModule": {
      "properties": {
        "export": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "export"
      ],
      "type": "object"
    },
    "MembershipPredicate": {
      "additionalProperties": false,
      "description": "A declaration-bound membership semi-join: the structured-filter IR node the\n`eventMembers.memberOf(resourceRef)` / `eventMembers.hasRole(resourceRef,\n…)` rule helpers lower to. There is deliberately **no** global\n`memberOf`/`hasRole` resolver — two declarations can target the same\nresource type, and that ambiguity is an authorization bug factory\n(LLP 0056 §Rule helpers), so every predicate names its declaration.\n\nSemantics: the predicate holds for the effective principal iff a membership\nrow exists in the bound declaration whose `principal` axis is that\nprincipal, whose `resource` axis equals the resolved `resource` reference,\nand whose `role` is one of the effective roles. A null effective principal\n(unauthenticated) matches no rows — fail-closed.\n\nThe node is **authoritative-only**: it is evaluated by a non-recursive\nstorage semi-join that deliberately bypasses the membership table's own\nrow-visibility rules (a locked-down roster must not break role evaluation\nfor guests), never by the pure/optimistic `ValueExpr` evaluator — which has\nno storage and no business consulting membership facts.\n\n@ref LLP 0056#rule-helpers — declaration-bound; `memberOf` excludes\n  `pendingRoles`; `hasRole` names roles explicitly; `resourceRef` is a row\n  field of the queried table or a query argument of the declared resource\n  type.\n@ref LLP 0053#agent-auth-protected-query-inputs-amended-2026-07-14-eng-24906 —\n  admitted `DatabaseCaptured` declarative expression kind, snapshot-bound,\n  with the pinned empty-result capture.",
      "properties": {
        "declaration": {
          "description": "The stable declaration id this predicate binds to\n(`MembershipManifest::effective_id`).",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/MembershipResourceRef",
          "description": "Where the `resource` axis value is read from."
        },
        "roles": {
          "description": "The satisfying roles. `None` is `memberOf` — every **non-pending** role\nof the declaration. `Some(list)` is `hasRole` with exactly the named\nroles (which may name pending roles explicitly).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "declaration",
        "resource"
      ],
      "type": "object"
    },
    "MembershipResourceRef": {
      "description": "Where a [`MembershipPredicate`] reads its `resource` axis value from. Both\nforms are analyzable at subscribe time; anything else — a computed\nexpression, a different resource type, a join through a third table — is a\nload-time error (LLP 0056 §Rule helpers).\n\n@ref LLP 0056#rule-helpers — the two analyzable resource-reference forms.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A column of the queried (primary) table whose type is the declared\nresource reference. The per-row semi-join; v1 captures a **conservative\ntable-level** dependency for it (coarse wake = re-query cost; the\nreverse choice would be a correctness loss).",
          "properties": {
            "rowField": {
              "type": "string"
            }
          },
          "required": [
            "rowField"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A query argument (dotted path) of the declared resource type. The\nresource is fixed for the whole query, so v1 captures the fine-grained\n`(principal, resource)` index-range dependency, including the\nempty-result form.",
          "properties": {
            "arg": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Dotted query-argument path evaluated at invocation time.",
                  "type": "string"
                },
                "resourceTable": {
                  "description": "Nominal resource type proven by codegen. Resource-scoped\ndeclarations require their exact `resourceTable`; app-scoped\ndeclarations require `null` and the closed synthetic path. Carrying\nthis provenance in the installed artifact keeps a hand-written\nmanifest from silently degrading an `Id<table>` to a bare string.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          },
          "required": [
            "arg"
          ],
          "type": "object"
        }
      ]
    },
    "MutationPlan": {
      "properties": {
        "return_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReturnValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MutationStep"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "MutationStep": {
      "description": "The data-tier v1 mutation step set (LLP 0051 D2). Two families:\nunconditional writes (`Insert`/`Patch`/`Delete`, the original plan forms)\nand the v1 extension — reads and guards (`Get`/`Guard`/`Let`, evaluated\ninside the commit transaction with reads captured server-side) plus the\ntwo closed set-oriented forms (`DeleteWhere`/`InsertEach`). General\niteration, recursion, and data-dependent cross-step control flow stay out\nof the profile permanently.",
