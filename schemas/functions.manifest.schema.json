      "enum": [
        "IntervalMs",
        "CronExpression",
        "DynamicAlarm"
      ],
      "type": "string"
    },
    "DependencySummary": {
      "properties": {
        "authScopeField": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "primaryTable": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tables": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
