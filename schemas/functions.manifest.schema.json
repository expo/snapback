{
  "$defs": {
    "ActionPlan": {
      "properties": {
        "returnValue": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionReturnValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionStep"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ActionReturnValue": {
      "oneOf": [
        {
          "enum": [
            "LastMutationResult",
            "ChangedCount"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Literal": true
          },
          "required": [
            "Literal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Binding": {
              "type": "string"
            }
          },
          "required": [
            "Binding"
          ],
          "type": "object"
        }
      ]
    },
    "ActionStep": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "RunMutation": {
              "properties": {
                "args": {
                  "additionalProperties": {
                    "$ref": "#/$defs/ValueExpr"
                  },
                  "default": {},
                  "type": "object"
                },
                "bindResultAs": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "RunMutation"
          ],
          "type": "object"
        }
      ]
    },
    "AuthRequirement": {
      "description": "Function-level requirement applied after caller authority has been resolved.\nAbsence in a legacy function is represented by\n[`FunctionDefinition::effective_auth_requirement`] as `optional-user`.\n\n@ref LLP 0058#closed-function-requirement — closed values fail at manifest parse.",
      "enum": [
        "public",
        "optional-user",
        "authenticated"
      ],
      "type": "string"
    },
    "AuthorizationInputDimension": {
      "description": "Closed caller-authority dimensions that a query result may depend on.\nRetention v1 accepts `userId` plus the effective principal `kind`, which is\nan immutable function of that identity; spelling the rejected dimensions\nis still important because a manifest must describe why it is online-only\nrather than silently erasing actor/session/provider/opaque dependence.\n\n@ref LLP 0053#retained-and-offline-authorization — retained rows survive a\n  same-user session replacement, so every other authority dimension is\n  deliberately ineligible.",
      "enum": [
        "userId",
        "kind",
        "actorKind",
        "isDelegated",
        "sessionId",
        "provider",
        "roles",
        "isAuthenticated",
        "opaque"
      ],
      "type": "string"
    },
    "BinaryOp": {
      "enum": [
        "Add",
        "Sub",
        "Mul",
        "Div",
        "Mod",
        "Eq",
        "Ne",
        "Lt",
        "Lte",
        "Gt",
        "Gte",
        "And",
        "Or"
      ],
      "type": "string"
    },
    "ConfigEntryDefinition": {
      "description": "@ref LLP 0036#declared-configuration-in-the-manifest — one declared config\nentry: names, purposes, and acquisition metadata are app source (public by\nconstruction); values never appear in any manifest.",
      "properties": {
        "acquisition": {
          "description": "Structured, agent-readable acquisition metadata (LLP 0036 D6). The host\ncarries it verbatim to status/wizard consumers; v1 does not interpret it."
        },
        "default": {
          "description": "Non-secret entries only; carried for forward compatibility. v1 rejects\nnon-secret entries at manifest validation, so this is always absent in\nan accepted manifest."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "howToGet": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "pool": {
          "default": false,
          "description": "The entry holds an ordered pool of values rotated across invocations.",
          "type": "boolean"
        },
        "probe": {
          "description": "Name of a declared action that test-calls the value (`config.verify`).",
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "secret": {
          "default": true,
          "description": "Default **true**: misclassification fails safe — forgetting the flag\nmakes a value more protected, never less (LLP 0036 D5).",
          "type": "boolean"
        },
        "sourceSpan": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "CronActivationKind": {
      "enum": [
        "Always",
        "WhileLive"
      ],
      "type": "string"
    },
    "CronActivationPolicy": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/CronActivationKind"
        },
        "whileLive": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CronJitterPolicy": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxOffsetMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "maxOffsetMs"
      ],
      "type": "object"
    },
    "CronJobDefinition": {
      "description": "@ref LLP 0028#cron-job-definition — generated function manifests carry\nsource-authored cron jobs beside query/mutation/action handlers.",
      "properties": {
        "action": {
          "type": "string"
        },
        "activation": {
          "$ref": "#/$defs/CronActivationPolicy",
          "default": {
            "kind": "Always",
            "whileLive": []
          }
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "jitterPolicy": {
          "$ref": "#/$defs/CronJitterPolicy",
          "default": {
            "enabled": true,
            "maxOffsetMs": 0
          }
        },
        "name": {
          "type": "string"
        },
        "overlapPolicy": {
          "$ref": "#/$defs/CronOverlapPolicy",
          "default": "NoOverlap"
        },
        "requiredCapabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retryPolicy": {
          "$ref": "#/$defs/CronRetryPolicy",
          "default": {
            "mode": "NextTick"
          }
        },
        "schedule": {
          "$ref": "#/$defs/CronSchedule"
        },
        "sourceSpan": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "targetWakeup": {
          "anyOf": [
            {
              "$ref": "#/$defs/CronTargetWakeup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "schedule",
        "action"
      ],
      "type": "object"
    },
    "CronOverlapPolicy": {
      "enum": [
        "NoOverlap",
        "Allow"
      ],
      "type": "string"
    },
    "CronRetryMode": {
      "enum": [
        "NextTick",
        "Backoff"
      ],
      "type": "string"
    },
    "CronRetryPolicy": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/CronRetryMode"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "CronSchedule": {
      "properties": {
        "cron": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "everyMs": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
