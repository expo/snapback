    },
    "EffectCeiling": {
      "additionalProperties": false,
      "description": "EffectCeilingV1 (LLP 0065 §1): the versioned conservative effect ceiling —\noperations, tables, index ranges, host operations, and authorization\ndependencies — recorded per generated function. `basis` is `\"static\"`\nwhen the ceiling was proved by codegen's total default-deny traversal of\nthe closed plan vocabulary and `\"declared\"` when it restates author\ndeclarations for an opaque handler.",
      "properties": {
        "authorizationInputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "basis": {
          "type": "string"
        },
        "hostOperations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reads": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EffectCeilingRead"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        },
        "writes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EffectCeilingWrite"
          },
          "type": "array"
        }
      },
      "required": [
        "version",
        "basis"
      ],
      "type": "object"
    },
    "EffectCeilingRead": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "description": "`\"point\"` or `\"query\"`.",
          "type": "string"
        },
        "index": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "access"
      ],
      "type": "object"
    },
    "EffectCeilingWrite": {
      "additionalProperties": false,
      "properties": {
        "operations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "table": {
          "type": "string"
        }
      },
      "required": [
        "table",
        "operations"
      ],
      "type": "object"
    },
    "FilterExpr": {
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/FilterOp"
        },
        "value": {
          "$ref": "#/$defs/ValueExpr"
        }
      },
      "required": [
        "field",
        "op",
        "value"
      ],
      "type": "object"
    },
    "FilterOp": {
      "enum": [
        "Eq",
        "In",
        "Lt",
        "Lte",
        "Gt",
        "Gte"
      ],
      "type": "string"
    },
    "FunctionDefinition": {
      "additionalProperties": false,
      "properties": {
        "authRequirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthRequirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "authorityCreating": {
          "description": "This entry point may reach a durable permission-backing write. The\nmarker is part of delegated consent: changing it terminally invalidates\nscopes minted against the prior function basis.\n\n@ref LLP 0055#grants — authority-creating functions require explicit,\n  displayed consent and never join a delegated tier expansion.",
          "type": "boolean"
        },
        "authorityIndependent": {
          "type": "boolean"
        },
        "authorizationDependence": {
          "description": "Closed authority dimensions used by this result. Codegen derives the\nHostPlan value from `AuthUserId`/`authScopeField`; opaque JavaScript is\nnever upgraded merely because an author writes `userId` here.",
          "items": {
            "$ref": "#/$defs/AuthorizationInputDimension"
          },
          "type": "array"
        },
        "bundleEntrypoint": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "effectCeiling": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectCeiling"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The versioned conservative effect ceiling. Codegen computes it by a\ntotal default-deny traversal of the closed plan vocabulary for\nHostPlans (`basis: \"static\"`) and records author declarations for\nopaque handlers (`basis: \"declared\"`). Optional so pre-ceiling\nmanifests keep loading; enforcement remains the runtime subset check.\n@ref LLP 0065#1-fact-classes — EffectCeilingV1."
        },
        "exportedName": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "default": "",
          "description": "Required stable identity for grants and consent. Deserialization\ntolerates an absent field (empty string) so the refusal is a typed\nload-time diagnostic rather than an opaque parse error, but\n[`FunctionManifest::validate_artifact`] rejects a manifest whose\nfunction lacks a non-empty id before it can install.\n\n@ref LLP 0012#v0-function-manifest — function ids are required and\n  stable; a missing id fails load with a typed diagnostic because\n  scoped grants and consent are keyed by this identity.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FunctionKind"
        },
        "name": {
          "type": "string"
        },
        "permissionEpochBumps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionScopeExpr"
          },
          "type": "array"
        },
        "readSetSummary": {
          "$ref": "#/$defs/DependencySummary",
          "default": {
            "authScopeField": null,
            "mode": null,
            "primaryTable": null,
            "tables": []
          }
        },
        "requiredCapabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retainable": {
          "description": "Results may be durably retained only when the item-8 admission profile\nvalidates this declaration and the complete read summary.\n\n@ref LLP 0053#retained-and-offline-authorization — retainability is an\n  explicit capability, never inferred from live/callable status.",
          "type": "boolean"
        },
        "runtime": {
          "$ref": "#/$defs/FunctionRuntime"
        },
        "sourceSpan": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "standardPattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardPatternIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable versioned standard-pattern identity — which generated helper\nand visibility profile produced this function (e.g. `owned-crud.v1`,\n`owner.v1`). Absent on free-form definitions.\n@ref LLP 0065#3-common-pattern-contracts — versioned identifiers."
        },
        "syncabilityClass": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "uses": {
          "default": [],
          "description": "@ref LLP 0036#declared-configuration-in-the-manifest — D8: the config\nentries this function may receive. Declaring an entry makes it exist;\nonly functions that name it here are granted it at runtime.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "writeSetSummary": {
          "$ref": "#/$defs/DependencySummary",
          "default": {
            "authScopeField": null,
            "mode": null,
            "primaryTable": null,
            "tables": []
          }
        }
      },
      "required": [
        "name",
        "kind",
        "runtime"
      ],
      "type": "object"
    },
    "FunctionKind": {
      "enum": [
        "Query",
        "Mutation",
        "LiveQuery",
        "Action"
      ],
      "type": "string"
    },
    "FunctionRuntime": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "HostPlan": {
              "$ref": "#/$defs/HandlerPlan"
            }
