          "description": "Strict arg lookup by dotted path; a missing arg is a typed error.",
          "properties": {
            "Arg": {
              "type": "string"
            }
          },
          "required": [
            "Arg"
          ],
          "type": "object"
        },
        {
          "const": "Args",
          "description": "The whole args object — the null-safe base for optional-arg access\nvia `Field` (missing keys propagate null instead of failing).",
          "type": "string"
        },
        {
          "const": "AuthKind",
          "description": "Effective principal kind in the sealed authorization projection.",
          "type": "string"
        },
        {
          "const": "AuthActorKind",
          "description": "Actor kind for delegated authority; null for direct and autonomous use.",
          "type": "string"
        },
        {
          "const": "AuthIsDelegated",
          "description": "True only when an actor is exercising authority for another principal.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
