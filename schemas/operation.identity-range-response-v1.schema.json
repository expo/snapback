{
  "$defs": {
    "ClientIdentityRangeV1": {
      "additionalProperties": false,
      "description": "Server-issued finite client range. The authenticator is a digest in this\npublic projection; the issuing service retains/verifies the secret-bearing\nartifact outside application data.",
      "properties": {
        "audience": {
          "type": "string"
        },
        "authorityAuthenticatorDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "authorityInstanceId": {
          "type": "string"
        },
        "epochId": {
          "type": "string"
        },
        "epochSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expiresAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "issuedAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rangeEndExclusive": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rangeStart": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "audience",
        "authorityInstanceId",
        "epochId",
        "epochSequence",
        "rangeStart",
        "rangeEndExclusive",
        "issuedAtMs",
        "expiresAtMs",
        "authorityAuthenticatorDigest"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/operation.identity-range-response-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "range": {
      "$ref": "#/$defs/ClientIdentityRangeV1"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "range"
  ],
  "title": "OperationIdentityRangeResponseV1",
  "type": "object"
}
