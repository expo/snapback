    },
    "release": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "since": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorsIssueStateV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subsystem": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "toMs": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    }
