{
  "$defs": {
    "DeployPlanArtifactKind": {
      "enum": [
        "deployPlan"
      ],
      "type": "string"
    },
    "DeployPlanStep": {
      "enum": [
        "verifyIdentity",
        "acquireLease",
        "uploadImmutableRelease",
        "provisionInactive",
        "compatibilityPreflight",
        "createVerifiedBackup",
        "stageRelease",
        "activateGeneration",
        "verifyServedPath",
        "releaseLease",
        "rollbackOnFailure"
      ],
      "type": "string"
    },
    "DeployPlanVersion": {
      "enum": [
        "snapback.deploy-plan.v1"
      ],
      "type": "string"
    },
    "ReleaseGap": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "blocking"
      ],
      "type": "object"
    },
    "TargetProductionClass": {
      "enum": [
        "preview",
        "production"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/deploy.plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed, non-mutating deployment proposal. `apply_eligible` is a\nderived fact; a plan retaining any blocker cannot be applied.\n\n@ref LLP 0072#cli-and-automation-contract — production and destructive\noperations consume an immutable plan digest and exact confirmation.",
  "properties": {
    "applyEligible": {
      "type": "boolean"
    },
    "artifactKind": {
      "$ref": "#/$defs/DeployPlanArtifactKind"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/ReleaseGap"
      },
      "type": "array"
    },
    "confirmation": {
      "type": "string"
    },
    "createdAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "databaseId": {
      "type": "string"
    },
    "deploymentId": {
      "type": "string"
    },
    "environmentId": {
      "type": "string"
    },
    "expiresAtMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "observedActivationGeneration": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "observedActiveReleaseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "operationId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "preparedReleaseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "preparedReleaseManifestSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "productionClass": {
      "$ref": "#/$defs/TargetProductionClass"
    },
    "projectId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "releaseId": {
      "type": "string"
    },
    "releaseManifestSha256": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "#/$defs/DeployPlanVersion"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/DeployPlanStep"
      },
      "type": "array"
    },
    "streamIncarnation": {
      "type": "string"
    },
    "targetDescriptorSha256": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "targetObservationSha256": {
      "type": "string"
    },
    "targetProfileId": {
      "type": "string"
    }
  },
  "required": [
    "artifactKind",
    "schemaVersion",
    "planId",
    "operationId",
    "reason",
    "targetId",
    "projectId",
    "environmentId",
    "deploymentId",
    "databaseId",
    "streamIncarnation",
    "targetProfileId",
    "productionClass",
    "targetDescriptorSha256",
    "targetObservationSha256",
    "observedActivationGeneration",
    "releaseId",
    "releaseManifestSha256",
    "steps",
    "blockers",
    "applyEligible",
    "confirmation",
    "createdAtMs",
    "expiresAtMs"
  ],
  "title": "DeployPlan",
  "type": "object"
}
