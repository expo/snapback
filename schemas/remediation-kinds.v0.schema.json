{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/remediation-kinds.v0.schema.json",
  "$comment": "DRAFT / PENDING LLP 0146 OQ6. This validates registry data only. It is not a wire, diagnostic, MCP, or ControlCatalog remediation carrier and must not be consumed as one until the LLP 0094/0095 family rules OQ6.",
  "title": "Snapback draft remediation-kind registry v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryKind", "status", "kinds"],
  "properties": {
    "$comment": { "type": "string" },
    "schemaVersion": { "const": "snapback.remediation-kinds.v0" },
    "registryKind": { "const": "remediationKindRegistry" },
    "status": { "const": "draft-pending-oq6" },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kind" }
    }
  },
  "$defs": {
    "preconditionShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "properties", "additionalProperties"],
      "properties": {
        "type": {
          "enum": ["artifact-hash", "grantable-scope", "principal-available"]
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["artifactHash", "grantableScope", "principalAvailable"]
          }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object"
          }
        },
        "additionalProperties": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "artifact-hash" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "required": { "const": ["artifactHash"] },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifactHash"],
                "properties": {
                  "artifactHash": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "pattern"],
                    "properties": {
                      "type": { "const": "string" },
                      "pattern": { "const": "^sha256:[0-9a-f]{64}$" }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "grantable-scope" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "required": { "const": ["grantableScope"] },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["grantableScope"],
                "properties": {
                  "grantableScope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": { "type": { "const": "string" } }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "principal-available" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "required": { "const": ["principalAvailable"] },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["principalAvailable"],
                "properties": {
                  "principalAvailable": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": { "type": { "const": "string" } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "riskClass",
        "machineApplicable",
        "requiresApproval",
        "authorityEffect",
        "precondition"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "riskClass": {
          "enum": ["mechanical", "authority-widening", "authority-sensitive"]
        },
        "machineApplicable": { "type": "boolean" },
        "requiresApproval": { "type": "boolean" },
        "authorityEffect": {
          "enum": ["none", "widens", "changes-effective-principal"]
        },
        "precondition": { "$ref": "#/$defs/preconditionShape" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "machineApplicable": { "const": true } },
            "required": ["machineApplicable"]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": ["fixTypo", "replaceIdentifier", "regenerateArtifacts"]
              },
              "riskClass": { "const": "mechanical" },
              "requiresApproval": { "const": false },
              "authorityEffect": { "const": "none" },
              "precondition": {
                "properties": {
                  "type": { "const": "artifact-hash" },
                  "required": { "contains": { "const": "artifactHash" } },
                  "properties": {
                    "required": ["artifactHash"],
                    "properties": {
                      "artifactHash": {
                        "type": "object",
                        "properties": {
                          "type": { "const": "string" },
                          "pattern": { "const": "^sha256:[0-9a-f]{64}$" }
                        },
                        "required": ["type", "pattern"]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["fixTypo", "replaceIdentifier", "regenerateArtifacts"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": { "machineApplicable": { "const": true } }
          }
        },
        {
          "if": {
            "properties": {
              "authorityEffect": { "const": "changes-effective-principal" }
            },
            "required": ["authorityEffect"]
          },
          "then": {
            "properties": { "requiresApproval": { "const": true } }
          }
        },
        {
          "if": {
            "properties": { "authorityEffect": { "const": "widens" } },
            "required": ["authorityEffect"]
          },
          "then": {
            "properties": { "requiresApproval": { "const": true } }
          }
        }
      ]
    }
  }
}

