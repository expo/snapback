{
  "$defs": {
    "AppDataAvailability": {
      "enum": [
        "available",
        "refusedPending"
      ],
      "type": "string"
    },
    "AuthMode": {
      "description": "The authority mode declared by a schema artifact. The enum is deliberately\nclosed: a mode changes who is allowed to supply invocation authority and an\nunknown spelling therefore cannot be treated as an additive field.\n\n@ref LLP 0058#closed-auth-mode — auth mode is a must-understand closed value.",
      "enum": [
        "dev",
        "sessions"
      ],
      "type": "string"
    },
    "AuthModeStatus": {
      "enum": [
        "settled",
        "pendingRestart",
        "quarantined"
      ],
      "type": "string"
    },
    "AuthScopedLiveAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "minimumAuthInvalidationProtocol": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "minimumAuthInvalidationProtocol",
        "reason"
      ],
      "type": "object"
    },
    "AuthSessionAuthority": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "sessionId": {
            "type": "null"
          },
          "userId": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "isAuthenticated": {
            "const": true
          }
        }
      },
      "properties": {
        "isAuthenticated": {
          "type": "boolean"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "userId",
        "sessionId",
        "isAuthenticated"
      ],
      "then": {
        "properties": {
          "sessionId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "userId": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        }
      },
      "type": "object"
    },
    "AuthSessionAuthorityDescriptor": {
      "additionalProperties": false,
      "description": "Handshake-specific descriptor closure. Mutation inputs retain their own\ndiagnostic surface; the bootstrap schema pins protocol-v1 and canonical\nUUIDv7 independently so the server schema and executable kit agree.",
      "properties": {
        "authorityInstanceId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "descriptorVersion": {
          "format": "uint64",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "sessionGeneration": {
          "description": "Zero is the anonymous/no-session sentinel; authenticated session\ndescriptors are positive and every value stays JavaScript-safe.",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "descriptorVersion",
        "authorityInstanceId",
        "sessionGeneration"
      ],
      "type": "object"
    },
    "AuthSessionAvailability": {
      "additionalProperties": false,
      "properties": {
        "authScopedLive": {
          "$ref": "#/$defs/AuthScopedLiveAvailability"
        },
        "onlineRequestResponse": {
          "$ref": "#/$defs/OnlineAvailability"
        },
        "queuedReplay": {
          "$ref": "#/$defs/QueuedReplayAvailability"
        },
        "retainedReads": {
          "$ref": "#/$defs/RetainedReadAvailability"
        }
      },
      "required": [
        "onlineRequestResponse",
        "authScopedLive",
        "retainedReads",
        "queuedReplay"
      ],
      "type": "object"
    },
    "AuthSessionProvider": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "key": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "key",
        "available"
      ],
      "type": "object"
    },
    "AuthorizedLeaseFacts": {
      "additionalProperties": false,
      "description": "Capability/runtime facts projected by the bootstrap handshake.\n\nEvery member except `configuredMs` is a v1 protocol constant pinned by\nLLP 0053's capability report; the schema publishes them as `const` so a\ntarget advertising different lease semantics fails conformance instead of\npassing a shape check the executable kit validator would reject.",
      "properties": {
        "clamps": {
          "const": [
            "session",
            "provider"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "clockRollback": {
          "const": "delete-before-read",
          "type": "string"
        },
        "configuredMs": {
          "format": "uint64",
          "maximum": 86400000,
          "minimum": 1,
          "type": "integer"
        },
        "defaultMs": {
          "const": 86400000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hardMaxMs": {
          "const": 86400000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "protocolVersion": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "renewal": {
          "const": "full-revalidation",
          "type": "string"
        },
        "timeBasis": {
          "const": "server-absolute+client-request-elapsed",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "defaultMs",
        "hardMaxMs",
        "configuredMs",
        "clamps",
        "renewal",
        "timeBasis",
        "clockRollback"
      ],
      "type": "object"
    },
    "ClientProtocols": {
      "additionalProperties": false,
      "properties": {
        "authClient": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "authInvalidation": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "authorityDescriptor": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "authorizedLease": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "authClient",
        "authInvalidation",
        "authorityDescriptor",
        "authorizedLease"
      ],
      "type": "object"
    },
    "DeploymentIdentity": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "authMode": {
              "const": "dev"
            },
            "bundleHash": {
              "not": {
                "pattern": "^snapback\\.v1:"
              }
            },
            "inputsHash": {
              "not": {
                "pattern": "^snapback\\.v1:"
              }
            },
            "schemaHash": {
              "not": {
                "pattern": "^snapback\\.v1:"
              }
            },
            "schemaVersion": {
              "const": "snapback.v0"
            }
          }
        },
        {
          "properties": {
            "authMode": {
              "const": "sessions"
            },
            "bundleHash": {
              "pattern": "^snapback\\.v1:sessions:function:sha256:[0-9a-f]{64}$"
            },
            "inputsHash": {
              "pattern": "^snapback\\.v1:sessions:inputs:sha256:[0-9a-f]{64}$"
            },
            "schemaHash": {
              "pattern": "^snapback\\.v1:sessions:schema:sha256:[0-9a-f]{64}$"
            },
            "schemaVersion": {
              "const": "snapback.v1"
            }
          }
        }
      ],
      "properties": {
        "appId": {
          "minLength": 1,
          "type": "string"
        },
        "authMode": {
          "$ref": "#/$defs/AuthMode"
        },
        "bundleHash": {
          "minLength": 1,
          "type": "string"
        },
        "inputsHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaHash": {
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "authMode",
        "appId",
        "schemaHash",
        "bundleHash",
        "inputsHash"
      ],
      "type": "object"
    },
    "OnlineAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "reason"
      ],
      "type": "object"
    },
    "QueuedReplayAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "minimumAuthorityDescriptorProtocol": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "minimumAuthorityDescriptorProtocol",
        "reason"
      ],
      "type": "object"
    },
    "RetainedReadAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "minimumAuthInvalidationProtocol": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minimumAuthorizedLeaseProtocol": {
          "enum": [
            1,
            null
          ],
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "minimumAuthInvalidationProtocol",
        "minimumAuthorizedLeaseProtocol",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/auth.session.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activeMode": {
      "$ref": "#/$defs/AuthMode"
    },
    "appDataAvailability": {
      "$ref": "#/$defs/AppDataAvailability"
    },
    "authority": {
      "$ref": "#/$defs/AuthSessionAuthority"
    },
    "authorityDescriptor": {
      "$ref": "#/$defs/AuthSessionAuthorityDescriptor",
      "description": "Consistency only: possession never authorizes an invocation."
    },
    "authorizationStreamIncarnation": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "authorizedLease": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizedLeaseFacts"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact lease capability facts appear only when this binary's full\nissuance/store/service implementation is ready. A client offer alone\ncan never manufacture support. Always present: null means \"not\nsupported\", never omission."
    },
    "availability": {
      "$ref": "#/$defs/AuthSessionAvailability"
    },
    "clientProtocols": {
      "$ref": "#/$defs/ClientProtocols"
    },
    "deploymentIdentity": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeploymentIdentity"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server-proven artifact identity. Sessions mode requires a non-null\nvalue; legacy dev databases may not yet have one."
    },
    "desiredMode": {
      "$ref": "#/$defs/AuthMode"
    },
    "modeState": {
      "$ref": "#/$defs/AuthModeStatus"
    },
    "protocolVersion": {
      "const": 1,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "provider": {
      "$ref": "#/$defs/AuthSessionProvider"
    },
    "quarantineCode": {
      "description": "Always present: null means \"not quarantined\", never omission.",
      "type": [
        "string",
        "null"
      ]
    },
    "serverStartupNonce": {
      "minLength": 1,
      "type": "string"
    },
    "transitionGeneration": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "transports": {
      "items": {
        "const": "bearer"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "protocolVersion",
    "serverStartupNonce",
    "authorizationStreamIncarnation",
    "transitionGeneration",
    "activeMode",
    "desiredMode",
    "modeState",
    "appDataAvailability",
    "quarantineCode",
    "clientProtocols",
    "availability",
    "provider",
    "transports",
    "authority",
    "authorityDescriptor",
    "deploymentIdentity",
    "authorizedLease"
  ],
  "title": "AuthSessionResponse",
  "type": "object"
}
