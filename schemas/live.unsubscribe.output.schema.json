{
  "$defs": {
    "AuthorizationVersion": {
      "description": "The one durable authorization-stream witness. The incarnation closes reset\nand restore ABA; the JS-safe epoch advances for ordinary authorization\nevents within that stream.\n\n@ref LLP 0053#the-authorization-version — v1 has one global durable pair.",
      "properties": {
        "epoch": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "incarnation": {
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "epoch"
      ],
      "type": "object"
    },
    "IssuerId": {
      "additionalProperties": false,
      "description": "A boot identity is never reused, even when process-local counters restart.",
      "properties": {
        "authorizationIncarnation": {
          "type": "string"
        },
        "bootNonce": {
          "type": "string"
        },
        "bootSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "authorizationIncarnation",
        "bootSequence",
        "bootNonce"
      ],
      "type": "object"
    },
    "MutationReceiptOutcome": {
      "enum": [
        "confirmed",
        "rejected"
      ],
      "type": "string"
    },
    "QueryNamespace": {
      "additionalProperties": false,
      "properties": {
        "clientStoreId": {
          "type": "string"
        },
        "queryInstanceId": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "queryKey": {
          "type": "string"
        }
      },
      "required": [
        "clientStoreId",
        "queryKey",
        "queryInstanceId"
      ],
      "type": "object"
    },
    "Receipt": {
      "description": "A retention-ring receipt (LLP 0034 §3.2): connectionless facts about\nmutations and subscription lifecycle, served by the receipts snapshot and\nechoed in live-subscribe/unsubscribe outputs. Privacy (§3.3): receipts\ncarry opaque ids, versions, table names, and reasons — never row data or\nargument values.",
      "oneOf": [
        {
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "snapshotVersion": {
                    "type": "integer"
                  }
                }
              }
            }
          ],
          "description": "One mutation invocation: confirmed or rejected, with the write\nsurface that fan-out used.",
          "properties": {
            "affectedTables": {
              "description": "`null` means EXPLICITLY unknown (an IbexModule handler without a\ndeclared write set) — distinct from `[]`, no tables.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "correlation": {
              "description": "Adapter-supplied opaque correlation, echoed verbatim (capped)."
            },
            "kind": {
              "const": "mutation",
              "type": "string"
            },
            "mutation": {
              "type": "string"
            },
            "mutationId": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/MutationReceiptOutcome"
            },
            "receivedAtMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "rollbackReason": {
              "description": "The diagnostic CODE only — messages may embed argument values\n(§3.3 privacy). `null` on confirmed mutations.",
              "type": [
                "string",
                "null"
              ]
            },
            "snapshotVersion": {
              "description": "`null` only when the rejected invocation could not safely read the\ndurable cursor; never fabricate zero from a storage failure.",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "transport": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mutationId",
            "mutation",
            "outcome",
            "snapshotVersion",
            "transport",
            "correlation",
            "receivedAtMs"
          ],
          "type": "object"
        },
        {
          "description": "Subscription lifecycle: established / disposed, on both the durable\nlive-query lane and the ephemeral room lane (`lane: \"ephemeral\"`,\nwhich carries `bindingId`/`collection` instead of `subscriptionId`).",
          "properties": {
            "bindingId": {
              "type": [
                "string",
                "null"
              ]
            },
            "collection": {
              "type": [
                "string",
                "null"
              ]
            },
            "correlation": true,
            "event": {
              "$ref": "#/$defs/SubscriptionReceiptEvent"
            },
            "kind": {
              "const": "subscription",
              "type": "string"
            },
            "lane": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "receivedAtMs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "removed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "scope": {
              "description": "The subscription's routing/scope args (REQUIRED — LLP 0034 §3.2)."
            },
            "snapshotVersion": {
              "description": "`null` when no storage read is safe at the emission site (the\ndisconnect teardown path) — the honest \"unknown at death\" value.",
              "format": "uint64",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "subscriptionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersededBy": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "event",
            "scope",
            "receivedAtMs"
          ],
          "type": "object"
        }
      ]
    },
    "ScopeRetirement": {
      "additionalProperties": false,
      "description": "Server-authenticated proof that one current-issuer namespace has no live or\nunresolved scope at or below a contiguous scope-sequence prefix. The proof\nis a cleanup/fencing fact only; accepting it never stands in for a result\nsnapshot, a resolution ACK, or a release proof.",
      "properties": {
        "authorizationExpectation": {
          "$ref": "#/$defs/AuthorizationVersion"
        },
        "issuerId": {
          "$ref": "#/$defs/IssuerId"
        },
        "mac": {
          "type": "string"
        },
        "namespace": {
          "$ref": "#/$defs/QueryNamespace"
        },
        "retireThroughScopeSequence": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "issuerId",
        "namespace",
        "retireThroughScopeSequence",
        "authorizationExpectation",
        "mac"
      ],
      "type": "object"
    },
    "SubscriptionReceiptEvent": {
      "enum": [
        "established",
        "disposed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/live.unsubscribe.output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "disposed": {
      "type": "boolean"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "scopeRetirement": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeRetirement"
        },
        {
          "type": "null"
        }
      ]
    },
    "subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "subscription_id",
    "disposed"
  ],
  "title": "LiveUnsubscribeOutput",
  "type": "object"
}
