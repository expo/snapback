{
  "$defs": {
    "AdapterLifecycleOperationV2": {
      "enum": [
        "acquireLease",
        "renewLease",
        "uploadImmutableRelease",
        "provisionInactive",
        "compatibilityPreflight",
        "createVerifiedBackup",
        "stageRelease",
        "activateGeneration",
        "verifyServedPath",
        "rollback",
        "fenceExternalEffects",
        "restoreBackupInactive",
        "verifyRestoredComponents",
        "verifyRestoredApplication",
        "activateRestoredGeneration",
        "reconcileEffect",
        "releaseLease"
      ],
      "type": "string"
    },
    "AdapterLifecycleResponseV2Version": {
      "enum": [
        "snapback.vm-adapter-lifecycle-response.v2"
      ],
      "type": "string"
    },
    "AdapterSafeDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "HostedControlHeadV2": {
      "additionalProperties": false,
      "properties": {
        "activationGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "activeReleaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "admissionGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bindingSha256": {
          "type": "string"
        },
        "cleanupFloor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "committedAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "journalRootSha256": {
          "type": "string"
        },
        "predecessorSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "replayFloor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schemaVersion": {
          "$ref": "#/$defs/HostedControlHeadVersion"
        },
        "spendFloor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "supervisorIncarnation": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "targetId",
        "generation",
        "bindingSha256",
        "activationGeneration",
        "journalRootSha256",
        "admissionGeneration",
        "spendFloor",
        "cleanupFloor",
        "replayFloor",
        "supervisorIncarnation",
        "committedAtMs"
      ],
      "type": "object"
    },
    "HostedControlHeadVersion": {
      "enum": [
        "snapback.hosted-control-head.v2"
      ],
      "type": "string"
    },
    "ProviderEffectObservationV1": {
      "additionalProperties": false,
      "properties": {
        "observedAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "providerRequestSha256": {
          "type": "string"
        },
        "providerRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerUri": {
          "type": "string"
        },
        "schemaVersion": {
          "$ref": "#/$defs/ProviderEffectObservationVersion"
        },
        "semanticEffectId": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "semanticEffectId",
        "providerRequestSha256",
        "providerUri",
        "observedAtMs"
      ],
      "type": "object"
    },
    "ProviderEffectObservationVersion": {
      "enum": [
        "snapback.provider-effect-observation.v1"
      ],
      "type": "string"
    },
    "ProviderEffectTerminalOutcome": {
      "enum": [
        "notApplied",
        "applied",
        "commitUncertain"
      ],
      "type": "string"
    },
    "ProviderEffectTerminalV1": {
      "additionalProperties": false,
      "description": "Immutable terminal for one original effect attempt. Reconciliation appends\na separate `ProviderEffectReconciliationV1`; it never edits this record.",
      "properties": {
        "lastObservationSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ProviderEffectTerminalOutcome"
        },
        "providerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordedAtMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recoveryClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "redactedEvidenceSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "retainedResultSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "schemaVersion": {
          "$ref": "#/$defs/ProviderEffectTerminalVersion"
        },
        "semanticEffectId": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "semanticEffectId",
        "outcome",
        "recordedAtMs"
      ],
      "type": "object"
    },
    "ProviderEffectTerminalVersion": {
      "enum": [
        "snapback.provider-effect-terminal.v1"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/vm-adapter.lifecycle-response-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controlHead": {
      "$ref": "#/$defs/HostedControlHeadV2"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/AdapterSafeDiagnostic"
      },
      "type": "array"
    },
    "idempotentReplay": {
      "type": "boolean"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderEffectObservationV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "operation": {
      "$ref": "#/$defs/AdapterLifecycleOperationV2"
    },
    "operationId": {
      "type": "string"
    },
    "remoteEvidence": {
      "type": "boolean"
    },
    "requestSha256": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "#/$defs/AdapterLifecycleResponseV2Version"
    },
    "terminal": {
      "$ref": "#/$defs/ProviderEffectTerminalV1"
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "operationId",
    "ok",
    "idempotentReplay",
    "remoteEvidence",
    "requestSha256",
    "terminal",
    "controlHead",
    "diagnostics"
  ],
  "title": "AdapterLifecycleResponseV2",
  "type": "object"
}
