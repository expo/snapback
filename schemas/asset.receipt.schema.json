{
  "$defs": {
    "AssetReceiptEventV1": {
      "description": "Semantic receipt events (LLP 0044 §Receipts) — never per-chunk noise.",
      "oneOf": [
        {
          "enum": [
            "asset-reserved",
            "attempt-created",
            "attempt-completed",
            "attempt-cancelled",
            "attempt-expired",
            "attempt-failed",
            "bytes-verified",
            "bytes-rejected",
            "staging-cleaned",
            "blob-reused",
            "blob-created",
            "asset-ready",
            "asset-rejected",
            "asset-deleted",
            "rendition-produced",
            "rendition-failed",
            "rendition-superseded",
            "delivery-admitted",
            "attachment-denied",
            "attachment-committed",
            "reference-removed",
            "publication-repaired",
            "migration-verified",
            "gc-reclaimed",
            "work-claimed",
            "work-completed",
            "work-retrying",
            "work-exhausted",
            "work-cancelled",
            "work-lease-reclaimed",
            "work-ambiguous"
          ],
          "type": "string"
        },
        {
          "const": "intent-artifact-reclaimed",
          "description": "A superseded intent generation's retained authorizer artifact was\nreclaimed after its last open attempt terminated (intent-scoped;\nno `asset_id`).",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://schemas.snapback.dev/snapback.v0/asset.receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assetId": {
      "description": "Present on every asset-scoped event; `None` only for intent-scoped\nbookkeeping events (`IntentArtifactReclaimed`), whose subject lives in\n`details`.",
      "type": [
        "string",
        "null"
      ]
    },
    "atMs": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "attemptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "description": "Safe structured facts only: identity, generation, policy, capability,\ndiagnostics — no secrets, byte samples, staging keys, or bearer URLs."
    },
    "event": {
      "$ref": "#/$defs/AssetReceiptEventV1"
    },
    "operationLineage": {
      "description": "Shared lineage so inspection renders one lifecycle, not unrelated\ntop-level artifacts.",
      "type": "string"
    },
    "receiptId": {
      "type": "string"
    }
  },
  "required": [
    "receiptId",
    "operationLineage",
    "event",
    "atMs",
    "details"
  ],
  "title": "AssetReceiptV1",
  "type": "object"
}
