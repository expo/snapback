{
  "name": "snapback3",
  "version": "0.0.1-experimental.0",
  "private": true,
  "description": "Experimental Snapback 3 compiler, client, and local application server",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "files": ["dist", "LICENSE"],
  "bin": { "snapback3": "dist/cli.mjs" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./compiler": {
      "types": "./dist/compiler-api.d.ts",
      "import": "./dist/compiler-api.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.mjs"
    }
  },
  "peerDependencies": {
    "expo": ">=57.0.0 <58.0.0",
    "expo-crypto": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "expo": { "optional": true },
    "expo-crypto": { "optional": true },
    "expo-sqlite": { "optional": true },
    "react": { "optional": true }
  },
  "dependencies": {
    "ses": "2.3.0",
    "typescript": "5.9.2"
  },
  "scripts": { "build": "node ../../build.mjs" }
}
