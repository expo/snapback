--- a/snapback/schema.q
+++ b/snapback/schema.q
@@ -12,7 +12,7 @@ table appSettings:
   immutable key
   public 'window and digest configuration is product policy'
   insert <- deny
-  update <- deny
+  update <- exists profiles[viewer]
   delete <- deny

 table profiles:
@@ -351,7 +351,7 @@ table periodUnread:
   membershipId: memberships
   periodStart: time
   unique byMessageRecipient: messageId, recipient
-  by byRecipientConversationMembership: recipient, conversationId, membershipId, messageId
+  by byRecipientConversationMembership: recipient, conversationId, membershipId, messageId, id
   by byPeriod: periodStart, id
   cap 50 by recipient, conversationId, membershipId
   cap 50 by messageId
--- /dev/null
+++ b/snapback/owner-inspection.q
@@ -0,0 +1,30 @@
+fn isMember from access
+proc bumpUnread from access
+
+query periodUnreadRow(messageId: messages, recipient: principal):
+  return periodUnread[messageId, recipient]
+
+query messageRow(messageId: messages):
+  return messages[messageId]
+
+query pollRow(messageId: id):
+  return polls[messageId]
+
+mutation deletePollForTest(messageId: messages):
+  poll = polls[messageId] ! else NOT_FOUND
+  delete polls[poll]
+  return null
+
+query myPeriodUnread(conversationId: conversations, c: cursor ?):
+  require exists memberships[conversationId, viewer] else MEMBERSHIP_REQUIRED
+  return periodUnread[viewer, conversationId] after c first 50 by byRecipientConversationMembership
+
+mutation sendAtForTest(conversationId: conversations, recipient: principal, messageId: id, deliveryId: id, body: text <=2000, at: time):
+  require isMember(conversationId, viewer) else NOT_MEMBER
+  require exists memberships[conversationId, recipient] else RECIPIENT_REQUIRED
+  insert messages { id: messageId, conversationId, authorId: viewer, body, expiresAt: null, status: 'ok', at }
+  insert deliveries { id: deliveryId, recipient, conversationId, messageId, kind: 'message', at }
+  insert pendingDelivered { messageId, recipient, conversationId }
+  insert pendingRead { messageId, recipient, conversationId, periodStart: null }
+  bumpUnread(conversationId, recipient)
+  return { id: messageId }
