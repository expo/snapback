# Build context filter for the single-instance-container-vm.v1 remote drill
# images (Dockerfile and Dockerfile.prebuilt under the drill directory).
# Whitelist style: exclude everything, then admit exactly what the release
# server build, opt-in qualification instrument, and image staging need.
*

# Rust crate inputs. build.rs embeds the checked guide corpus into every
# binary, so guide/ is a build input.
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!build.rs
!src/
!guide/
# The vector-scale qualification is packaged as the crate's release-mode lib
# test binary. Its test-only modules compile committed corpora from tests/.
!tests/
# The lib embeds harness/client/contract JS and brand assets via include_str.
!packages/
!brand/

# Vendored ibex-runtime crate (path dependency). The heavy per-platform
# runtime payloads are excluded; the Linux Hermes runtime arrives as the
# checksum-pinned prebuilt bundle staged under the drill directory.
!vendor/
vendor/llp/
vendor/ccheever-skills/
vendor/cdcstack/
vendor/ibex/ios/
vendor/ibex/node_modules/
vendor/ibex/target/
vendor/ibex/dist/
vendor/ibex/.git

# Drill assets and the generated artifact pair shipped in-image.
!demos/
demos/*
!demos/competitive-checkpoint/
demos/competitive-checkpoint/*
!demos/competitive-checkpoint/acceptance/
demos/competitive-checkpoint/acceptance/*
!demos/competitive-checkpoint/acceptance/drill/
# LLP 0098 hosted-edge image: entrypoint, Caddyfile, and the adapter
# configuration carrying the control-plane PUBLIC key.
!demos/competitive-checkpoint/acceptance/hosted-edge/
!demos/competitive-checkpoint/snapback/
# Release-mode lib-test compilation embeds the two generated schema fixtures
# used by storage/seed tests even when only the vector qualification executes.
!demos/todo/
demos/todo/*
!demos/todo/snapback/
demos/todo/snapback/*
!demos/todo/snapback/generated/
!demos/rbac/
demos/rbac/*
!demos/rbac/snapback/
demos/rbac/snapback/*
!demos/rbac/snapback/generated/

# Never ship credentials or scratch state.
.agent-local-secrets.md
**/.snapback/
**/target/
**/node_modules/
