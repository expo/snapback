+// RT-A LOCAL DIAGNOSTIC ONLY: not part of the product landing.
+fn rt_a_trace(conn: &Connection) {
+    if std::env::var_os("RT_A_TRACE").is_some() {
+        conn.trace_v2(rusqlite::trace::TraceEventCodes::SQLITE_TRACE_STMT, Some(|event| {
+            if let rusqlite::trace::TraceEvent::Stmt(_, sql) = event {
+                eprintln!("RT_A {}", serde_json::json!({"kind":"sqlite", "thread":format!("{:?}",std::thread::current().id()), "ns":std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos().to_string(),"sql":sql}));
+            }
+        }));
+    }
+}
