sa":"PBXResourcesBuildPhase","buildActionMask":"2147483647","files":["BB2F792D24A3F905000567C9","13B07FBF1A68108700A75B9A","3E461D99554A48A4959DE609","C2E470639E9A11A0B397E07D"],"runOnlyForDeploymentPostprocessing":"0"},"7B57F36802F24AFB8471535C":{"inputPaths":[],"buildActionMask":"2147483647","shellPath":"\/bin\/sh","isa":"PBXShellScriptBuildPhase","runOnlyForDeploymentPostprocessing":"0","outputPaths":[],"shellScript":"# Strip dev-launcher-specific local network permission keys from non-Debug builds\n# This only removes _expo._tcp Bonjour services and the dev-launcher usage description.\n# Other Bonjour services and custom descriptions are preserved for production use.\n\nif [ \"$CONFIGURATION\" != \"Debug\" ]; then\n  PLIST_PATH=\"${TARGET_BUILD_DIR}\/${INFOPLIST_PATH}\"\n  if [ -f \"$PLIST_PATH\" ]; then\n    # Check if NSBonjourServices exists\n    if \/usr\/libexec\/PlistBuddy -c \"Print :NSBonjourServices\" \"$PLIST_PATH\" >\/dev\/null 2>&1; then\n      # Get the count of services\n      COUNT=$(\/usr\/libexec\/PlistBuddy -c \"Print :NSBonjourServices\" \"$PLIST_PATH\" 2>\/dev\/null | grep \"^    \" | wc -l | tr -d ' ')\n\n      # Remove _expo._tcp\n      for ((i=COUNT-1; i>=0; i--)); do\n        SERVICE=$(\/usr\/libexec\/PlistBuddy -c \"Print :NSBonjourServices:$i\" \"$PLIST_PATH\" 2>\/dev\/null || echo \"\")\n        if echo \"$SERVICE\" | grep -q \"_expo._tcp\"; then\n          \/usr\/libexec\/PlistBuddy -c \"Delete :NSBonjourServices:$i\" \"$PLIST_PATH\" 2>\/dev\/null || true\n        fi\n      done\n\n      # If the array is now empty, remove it entirely\n      REMAINING=$(\/usr\/libexec\/PlistBuddy -c \"Print :NSBonjourServices\" \"$PLIST_PATH\" 2>\/dev\/null | grep \"^    \" | wc -l | tr -d ' ')\n      if [ \"$REMAINING\" -eq \"0\" ]; then\n        \/usr\/libexec\/PlistBuddy -c \"Delete :NSBonjourServices\" \"$PLIST_PATH\" 2>\/dev\/null || true\n      fi\n    fi\n\n    # Only delete the description if it matches the dev-launcher default text\n    DESC=$(\/usr\/libexec\/PlistBuddy -c \"Print :NSLocalNetworkUsageDescription\" \"$PLIST_PATH\" 2>\/dev\/null || echo \"\")\n    if echo \"$DESC\" | grep -q \"Expo Dev Launcher\"; then\n      \/usr\/libexec\/PlistBuddy -c \"Delete :NSLocalNetworkUsageDescription\" \"$PLIST_PATH\" 2>\/dev\/null || true\n    fi\n  fi\nfi\n","files":[],"name":"[Expo Dev Launcher] Strip Local Network Keys for Release"},"13B07F951A680F5B00A75B9A":{"baseConfigurationReference":"92E6B6B55FB37B6038297099","isa":"XCBuildConfiguration","buildSettings":{"LD_RUNPATH_SEARCH_PATHS":["$(inherited)","@executable_path\/Frameworks"],"PRODUCT_NAME":"Smallsocial","SWIFT_VERSION":"5.0","MARKETING_VERSION":"1.0","CLANG_ENABLE_MODULES":"YES","INFOPLIST_FILE":"Smallsocial\/Info.plist","TARGETED_DEVICE_FAMILY":"1","MACOSX_DEPLOYMENT_TARGET":"13.4","VERSIONING_SYSTEM":"apple-generic","SWIFT_OBJC_BRIDGING_HEADER":"Smallsocial\/Smallsocial-Bridging-Header.h","OTHER_SWIFT_FLAGS":"$(inherited) -D EXPO_CONFIGURATION_RELEASE","CODE_SIGN_ENTITLEMENTS":"Smallsocial\/Smallsocial.entitlements","ASSETCATALOG_COMPILER_APPICON_NAME":"AppIcon","OTHER_LDFLAGS":["$(inherited)","-ObjC","-lc++"],"IPHONEOS_DEPLOYMENT_TARGET":"16.4","PRODUCT_BUNDLE_IDENTIFIER":"dev.snapback4.social","CURRENT_PROJECT_VERSION":"1"},"name":"Release"},"832341AE1AAA6A7D00B99B32":{"isa":"PBXGroup","name":"Libraries","children":[],"sourceTree":"<group>"},"BB2F792C24A3F905000567C9":{"path":"Expo.plist","isa":"PBXFileReference","sourceTree":"<group>","fileEncoding":"4","lastKnownFileType":"text.plist.xml"},"83CBBA211A601CBA00E9B192":{"isa":"XCBuildConfiguration","buildSettings":{"CLANG_WARN_SUSPICIOUS_MOVE":"YES","CLANG_CXX_LIBRARY":"libc++","CLANG_ENABLE_OBJC_ARC":"YES","CLANG_WARN_DIRECT_OBJC_ISA_USAGE":"YES_ERROR","GCC_WARN_UNDECLARED_SELECTOR":"YES","CLANG_WARN__DUPLICATE_METHOD_MATCH":"YES","IPHONEOS_DEPLOYMENT_TARGET":"16.4","CLANG_WARN_INFINITE_RECURSION":"YES","CODE_SIGN_IDENTITY[sdk=iphoneos*]":"iPhone Developer","SDKROOT":"iphoneos","CLANG_CXX_LANGU