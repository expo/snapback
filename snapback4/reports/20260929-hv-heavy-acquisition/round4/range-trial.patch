+// Clip boundary pages once; share one traversal across every store caller.
+// @ref LLP 3000.007#20.4 — compact index ranges keep full byte ordering.
+pub(super) struct Entries<'a> {
+    pages: std::slice::Iter<'a, (Key, Vec<Entry>)>,
+    front: std::slice::Iter<'a, Entry>,
+    back: std::slice::Iter<'a, Entry>,
+}
+impl<'a> Iterator for Entries<'a> {
+    type Item = (&'a Key, &'a Rc<str>);
+    #[inline(never)]
+    fn next(&mut self) -> Option<Self::Item> {
+        loop {
+            if let Some((key, value)) = self.front.next() { return Some((key, value)); }
+            match self.pages.next() {
+                Some((_, page)) => self.front = page.iter(),
+                None => return self.back.next().map(|(key, value)| (key, value)),
+            }
+        }
+    }
+}
+impl DoubleEndedIterator for Entries<'_> {
+    #[inline(never)]
+    fn next_back(&mut self) -> Option<Self::Item> {
+        loop {
+            if let Some((key, value)) = self.back.next_back() { return Some((key, value)); }
+            match self.pages.next_back() {
+                Some((_, page)) => self.back = page.iter(),
+                None => return self.front.next_back().map(|(key, value)| (key, value)),
+            }
+        }
     }
