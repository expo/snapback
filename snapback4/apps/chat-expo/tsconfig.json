{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "src/**/*",
    "scripts/**/*"
  ]
}
