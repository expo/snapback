{
  "expo": {
    "name": "Snapback 4 chat",
    "slug": "snapback4-chat",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "snapback4chat",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.snapback4.chat",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.snapback4.chat"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar",
      "snapback4-expo/plugin"
    ]
  }
}
