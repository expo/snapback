{
  "name": "snapback4",
  "version": "0.4.14",
  "type": "module",
  "description": "Snapback 4: the card (contract), the online and local-first clients (IndexedDB, SQLite), React hooks, sign-in, a labelled mock, and the `snapback4` CLI. LLP 3000.",
  "bin": {
    "snapback4": "bin/snapback4.js"
  },
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./inspection": {
      "types": "./dist/inspection.d.ts",
      "import": "./dist/inspection.js"
    }
  },
  "imports": {
    "#fetch": {
      "types": "./dist/default-fetch.d.ts",
      "node": "./dist/node-fetch.js",
      "default": "./dist/default-fetch.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "SERVER.md",
    "CLIENT-AND-OPERATIONS.md",
    "FOLLOWING-ADOPTION.md"
  ],
  "optionalDependencies": {
    "snapback4-darwin-arm64": "0.4.14",
    "snapback4-linux-x64": "0.4.14"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "undici": "8.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/wasm && cp src/wasm/snapback4_device.js src/wasm/snapback4_device.d.ts src/wasm/snapback4_device_bg.wasm src/wasm/snapback4_device_bg.wasm.d.ts dist/wasm/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/snapback.git",
    "directory": "snapback4/packages/snapback4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
