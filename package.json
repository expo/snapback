{
  "name": "snapback-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "description": "Snapback workspace root (LLP 0032 P6). Product JS packages live under packages/*; demos and admin-ui manage and lock their own Exact package dependencies deliberately, not through the workspace.",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "scripts": {
    "preinstall": "node scripts/require-bun-package-manager.mjs",
    "check:artifacts": "scripts/check-generated-artifacts",
    "check:package-tests": "node scripts/check-package-test-inventory.mjs",
    "test:maturity": "node tests/capability-maturity.test.mjs && node tests/check-inventories.test.mjs",
    "check:export-types": "node scripts/check-package-export-types.mjs",
    "check:types": "scripts/check-generated-types",
    "check:surfaces": "scripts/check-demo-surfaces",
    "workout": "node scripts/run-workout-apps.mjs",
    "verify": "scripts/verify-local-proof",
    "cf:accept": "node cloudflare/test/local-suite.mjs",
    "cf:index-scaling": "node cloudflare/test/index-scaling.mjs",
    "cf:measure": "node cloudflare/test/measure.mjs",
    "cf:compat": "scripts/cf-check-compat",
    "cf:twin": "cargo run -p snapback-conformance --bin snapback-conformance-twin -- --out cloudflare/generated/conformance-twin-report.json"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "axe-core": "4.12.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "miniflare": "^4.20260701.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "5.9.3",
    "workerd": "^1.20260707.1",
    "wrangler": "^4.107.0"
  }
}
