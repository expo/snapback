{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapback-symbol-lifecycle.v1",
  "title": "Snapback authored public-symbol lifecycle facts",
  "$comment": "@ref LLP 0194#amendment-2026-08-09-authored-symbol-lifecycle-facts — lifecycle facts are authored at the change site.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "symbols"],
  "properties": {
    "$schema": {
      "const": "./lifecycle.schema.json"
    },
    "schemaVersion": {
      "const": "snapback-symbol-lifecycle.v1"
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity"],
        "properties": {
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "replaces": {
            "$ref": "#/$defs/identity"
          },
          "removedIn": {
            "$ref": "#/$defs/version"
          },
          "replacedBy": {
            "$ref": "#/$defs/identity"
          }
        },
        "anyOf": [
          { "required": ["replaces"] },
          { "required": ["removedIn"] },
          { "required": ["replacedBy"] }
        ]
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^npm:[^#]+#[^#]+$",
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
