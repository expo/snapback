+#[cfg(unix)]
+#[test]
+fn deploy_and_rollback_wait_before_admission_even_with_a_closing_listener_hint() {
+    use std::{thread,time::Duration,process::Stdio};
+    let app=App::new();fs::create_dir(app.0.join("snapback")).unwrap();
+    let source=app.0.join("snapback/schema.q");fs::write(&source,"query version():\n  return 1\n").unwrap();success(app.run(&["deploy","deployment"]));
+    fs::write(&source,"query version():\n  return 2\n").unwrap();success(app.run(&["deploy","deployment"]));
+    for (n,args) in [(3,vec!["rollback","deployment","--to","1"]),(4,vec!["deploy","deployment"])] {
+        fs::write(&source,format!("query version():\n  return {n}\n")).unwrap();
+        let database=app.0.join("deployment/store.sqlite");let lock=snapback4_core::private_fs::owner_file(&database).unwrap();lock.try_lock().unwrap();
+        // A TCP listener can still be open after its private control endpoint
+        // goes away. It is a hint, never permission to replay activation.
+        let listener=std::net::TcpListener::bind("127.0.0.1:0").unwrap();let address=listener.local_addr().unwrap();
+        fs::write(app.0.join("deployment/serve.lock"),format!("{}\nhttp://{address}\n",address.port())).unwrap();
+        let child=Command::new(BIN).current_dir(&app.0).args(args).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn().unwrap();
+        thread::sleep(Duration::from_millis(150));drop(lock);
+        let output=child.wait_with_output().unwrap();success(output);drop(listener);
+    }
+    let status:serde_json::Value=serde_json::from_str(&success(app.run(&["releases","deployment","--json"]))).unwrap();
+    assert_eq!(status["generation"],4); // exactly one activation per command
+}
pub(crate) fn request(dir: &Path, command: Command) -> Result<Value, String> {
    request_observed(dir,command, |_|{})
}

/// Submission remains in flight after a lost reply, even before history shows a commit.
// @ref LLP 3000.000.000#16-release-reactivation-and-rollback-foresight-rel5 — source cleanup needs either no submission or a definitive completed reply.
#[cfg(unix)]
pub(crate) fn request_observed(dir: &Path, command: Command, mut pending: impl FnMut(bool)) -> Result<Value, String> {
    let store = dir.join("store.sqlite");
    let unavailable = |reason: String| {
        let owner_path = store.canonicalize().unwrap_or_else(|_| store.clone());
        let detail = if reason.contains("No such file or directory") {
            "this deployment has no release control socket".to_owned()
        } else {
            reason
        };
        format!(
            "{}; release control unavailable: {detail}; stop `snapback4 serve {}`, rerun the exact command, then `snapback4 serve {}`",
            crate::store_owner::busy(&owner_path),
            dir.display(),
            dir.display()
        )
    };
    let path = address(dir, false).map_err(|e| unavailable(e.to_string()))?;
    let before = socket_entry(&path).map_err(|e| unavailable(e.to_string()))?;
    let mut stream = UnixStream::connect(&path).map_err(|e| unavailable(e.to_string()))?;
    peer(&stream).map_err(|e| unavailable(e.to_string()))?;
    let after = socket_entry(&path).map_err(|e| unavailable(e.to_string()))?;
    if (before.dev(), before.ino()) != (after.dev(), after.ino()) {
        return Err(unavailable(
            "release control socket changed before send".into(),
        ));
    }
    stream
        .set_read_timeout(Some(Duration::from_secs(120)))
        .map_err(|e| unavailable(e.to_string()))?;
    stream
        .set_write_timeout(Some(Duration::from_secs(5)))
        .map_err(|e| unavailable(e.to_string()))?;
    let bytes = serde_json::to_vec(&Envelope {
        identity: identity(&store)?,
        command,
    })
    .unwrap();
    if bytes.len() > INPUT {
        return Err("release control command exceeds 4096 bytes".into());
    }
    let ambiguous = |reason: io::Error| {
        format!(
            "release command result is unknown: {reason}; run `snapback4 releases {}` to inspect database authority; the server continues admitted work. Do not automatically deploy another release",
            dir.display()
        )
    };
    pending(true);
    stream.write_all(&bytes).map_err(ambiguous)?;
    stream
        .shutdown(std::net::Shutdown::Write)
        .map_err(ambiguous)?;
    let mut reply = Vec::new();
    stream
        .take((OUTPUT + 1) as u64)
        .read_to_end(&mut reply)
        .map_err(ambiguous)?;
    if reply.len() > OUTPUT {
        return Err("release reply too large; inspect releases before retrying".into());
    }
    let value: Value = serde_json::from_slice(&reply).map_err(|e| {
        format!(
            "release result is unknown ({e}); inspect `snapback4 releases {}` before retrying",
            dir.display()
        )
    })?;
    match (value.get("ok"),value.get("error").and_then(Value::as_str)) {
        (Some(value),_)=>{pending(false);Ok(value.clone())},
        (_,Some(error))=>{pending(false);Err(error.into())},
        _=>Err("release result is unknown (invalid reply); inspect releases before retrying".into()),
    }
}

#[cfg(not(unix))]
pub(crate) fn request(_: &Path, _: Command) -> Result<Value, String> {
    Err("local release control requires Unix".into())
//! Deployment purpose belongs to the store, never to application source or a seed plan.
use std::path::Path;
use crate::store_owner::Owner;

pub(super) const KEY: &str = "deployment_environment";
fn production() -> String {
    "E_STAGING: existing production/legacy stores cannot be relabelled; deploy --staging into a separate fresh directory".into()
}

// @ref LLP 3000.000.000.001#1-commission-and-boundary — classify only a fresh store under its existing exclusive owner.
pub(super) fn classify(dir: &Path, owner: Option<&Owner>, existed: bool, checking: bool) -> Result<(), String> {
    let path = dir.join("store.sqlite");
    if checking && !existed { return Ok(()); }
    if let Some(owner) = owner {
        let store = owner.open_store(std::time::Duration::from_secs(5)).map_err(|e|e.to_string())?;
        match store.meta(KEY).map_err(|e|e.to_string())?.as_deref() {
            Some("staging") => Ok(()),
            None if !existed && !checking => store.set_meta(KEY, "staging").map_err(|e|e.to_string()),
            _ => Err(production()),
        }
    } else {
