  if (!args.includes("--port")) args.push("--port", ports);
  const run = logged(resolveBinary(env), [verb, ...prefix, ...args], { ...options, env: { ...env, SNAPBACK4_PROOF_ID: id, SNAPBACK4_SUPERVISOR_PID: String(process.pid) } });
