// Node 24.18's bundled writer can throw setTypeOfService EINVAL outside the
// fetch promise on macOS (undici#5544). Keep the host Fetch API and pass a
// private fixed dispatcher, including through a host's fetch instrumentation.
import { createRequire } from "node:module";
import { channel } from "node:diagnostics_channel";
import type { Socket } from "node:net";
import type { Dispatcher } from "undici";
const require = createRequire(import.meta.url);
// Import the pinned implementation directly: undici's root import installs a
// process-wide dispatcher as a side effect. SDK requests need no global change.
const Agent: typeof import("undici").Agent = require("undici/lib/dispatcher/agent.js");
const Dispatcher1Wrapper: typeof import("undici").Dispatcher1Wrapper = require("undici/lib/dispatcher/dispatcher1-wrapper.js");
const Client: typeof import("undici").Client = require("undici/lib/dispatcher/client.js");
const Pool: typeof import("undici").Pool = require("undici/lib/dispatcher/pool.js");
// The pinned dispatcher's request owns this handler through queues and socket
// selection. Do not correlate by async context: a pool can drain a different
// caller's request on the completing caller's stack.
type Attempt = { socket?: Socket; read?: number; reused?: boolean; origin: string; path: string; sameTarget?: boolean; dispatches: number };
const attempts = new WeakMap<object, Attempt>();
const requests = new WeakMap<object, Attempt>();
const completed = new WeakSet<Socket>();
let creating: Attempt | undefined;
class TrackedClient extends Client {
  override dispatch(options: Dispatcher.DispatchOptions, handler: Dispatcher.DispatchHandler): boolean {
    const previous = creating;
    creating = attempts.get(handler);
    try { return super.dispatch(options, handler); }
    finally { creating = previous; }
  }
}
type Sent = { request: { origin: string; path: string }; socket: Socket };
channel("undici:request:create").subscribe(message => {
  if (creating) requests.set((message as Sent).request, creating);
});
channel("undici:client:sendHeaders").subscribe(message => {
  const { request, socket } = message as Sent;
  const attempt = requests.get(request);
  if (!attempt) return;
  attempt.socket = socket;
  attempt.read = socket.bytesRead;
  attempt.reused = completed.has(socket);
  attempt.sameTarget = String(request.origin) === attempt.origin && request.path === attempt.path;
});
channel("undici:request:trailers").subscribe(message => {
  const { request } = message as Sent;
  const socket = requests.get(request)?.socket;
  if (socket) completed.add(socket);
});

// @ref LLP 3000#http-overload-diagnostics — retire idle sockets well before the host's five seconds; held responses keep their independent deadlines.
const agent = new Agent({ keepAliveTimeout: 1000, keepAliveMaxTimeout: 1000, keepAliveTimeoutThreshold: 1000,
  factory: (origin, options) => new Pool(origin, { ...options, factory: (url, opts) => new TrackedClient(url, opts) }),
});

function repeatable(url: URL, init?: RequestInit): boolean {
  const method = (init?.method ?? "GET").toUpperCase();
  if (method === "GET") return /^\/(?:schema|probe|changes|write(?:\/[^/]+)?|api\.ts|native\.wasm)?$/.test(url.pathname);
  // Only replay materialized JSON. Request objects and streamed uploads keep
  // their existing single-dispatch behavior, as do one-view GETs and auth.
  if (method !== "POST" || typeof init?.body !== "string") return false;
  if (url.pathname.startsWith("/q/") || url.pathname === "/sync") return true;
  if (!url.pathname.startsWith("/m/")) return false;
  try {
    const body = JSON.parse(init.body);
    return body?.retry_write === true && typeof body.id === "string" && body.id.length > 0;
  } catch { return false; }
}

// @ref LLP 3000.030#14 — the witness must record even a transport-recovered failure; this private, per-call hook carries no remote text.
export const defaultFetch = async (input: Parameters<typeof fetch>[0], init?: RequestInit,
  { onRetry }: { onRetry?: () => void } = {}): Promise<Response> => {
  const url = typeof input === "string" || input instanceof URL ? new URL(input) : new URL(input.url);
  // Fetch snapshots mutable inputs at dispatch. A retry must keep that same
  // URL, write ID, body and authority even if the caller edits its options.
  const target = input instanceof URL ? url.href : input;
  const settings = { ...init };
  const headers = init?.headers === undefined ? undefined : Object.fromEntries(new Headers(init.headers));
  const send = (dispatcher: Dispatcher) => globalThis.fetch(target, {
    ...settings, ...(headers ? { headers: { ...headers } } : {}), dispatcher,
  } as RequestInit);
  const attempt: Attempt = { origin: url.origin, path: url.pathname + url.search, dispatches: 0 };
  const dispatcher = new Dispatcher1Wrapper(agent.compose(dispatch => (options, handler) => {
    attempt.dispatches++;
    attempts.set(handler, attempt);
    // No implicit pipeline replays (GET /assets can consume a view).
    return dispatch({ ...options, idempotent: false }, handler);
  }));
  try {
    return await send(dispatcher);
  } catch (error) {
    const code = (error as { cause?: { code?: string } })?.cause?.code;
    if (input instanceof Request || !repeatable(url, settings) || settings.signal?.aborted
      || attempt.dispatches !== 1 || !attempt.reused || !attempt.sameTarget || !attempt.socket || attempt.socket.bytesRead !== attempt.read
      || !["ECONNRESET", "EPIPE", "UND_ERR_SOCKET"].includes(code ?? "")) throw error;
    // Exactly one fresh-connection attempt. close() drains the response body;
    // destroying at fetch resolution would truncate a streaming /sync reply.
    const retry = new Agent({ pipelining: 0 });
    try {
      onRetry?.();
      return await send(new Dispatcher1Wrapper(retry));
    } finally { void retry.close().catch(() => {}); }
  }
};
//! HTTP identity admission. Password work owns a bounded KDF slot, never
//! the engine guard. Rate keys use the socket peer, never forwarded headers.
use crate::serve::{Shared, principal_of, refusal_json, respond_timed};
use serde_json::{Value as Json, json};
use sha2::{Digest, Sha256};
use snapback4_core::error::Refusal;
use snapback4_core::{RuntimeError, identity};
use std::collections::HashMap;
use std::sync::{
    Mutex,
    atomic::{AtomicUsize, Ordering},
};
use std::time::{Duration, Instant};
use tiny_http::Request;

pub const BODY_CEILING: usize = 4096;
const WINDOW: Duration = Duration::from_secs(60);
const KEYS: usize = 4096;

pub struct Admission {
    attempts: Mutex<HashMap<String, (Instant, u32)>>,
    kdfs: AtomicUsize,
    dev_kdf_slots: usize,
}
impl Default for Admission {
    fn default() -> Self {
        // @ref LLP 3000.007#14 — ruling 9: dev loopback KDF work fits the host, bounded at 2–16 slots
        let dev_kdf_slots = std::thread::available_parallelism().map(|n| n.get().clamp(2, 16)).unwrap_or(2);
        Self { attempts: Mutex::new(HashMap::new()), kdfs: AtomicUsize::new(0), dev_kdf_slots }
    }
}
impl Admission {
    pub fn kdf_slots(&self, dev_loopback: bool) -> usize {
        if dev_loopback { self.dev_kdf_slots } else { 2 }
    }

    fn attempt(&self, peer: &str, email: Option<&str>, now: Instant) -> bool {
        let mut attempts = self.attempts.lock().unwrap();
        attempts.retain(|_, (start, _)| now.duration_since(*start) < WINDOW);
        let mut keys = vec![(format!("ip:{peer}"), 30)];
        if let Some(email) = email {
            keys.push((format!("email:{}", identity::normalized_email(email)), 10));
        }
        // Charge every attempt, including denials. A full table refuses new
        // keys until expiry rather than evicting a key under attack.
        let mut admitted = true;
        for (key, limit) in keys {
            // A peer that is already over budget may charge existing email
            // keys, but cannot fill the shared map by rotating fresh emails.
            if !admitted && !attempts.contains_key(&key) {
                continue;
            }
            if !attempts.contains_key(&key) && attempts.len() >= KEYS {
                admitted = false;
                continue;
            }
            let (_, count) = attempts.entry(key).or_insert((now, 0));
            *count = count.saturating_add(1);
            admitted &= *count <= limit;
        }
        admitted
    }
    fn kdf(&self, dev_loopback: bool) -> Option<Kdf<'_>> {
        let slots = self.kdf_slots(dev_loopback);
        self.kdfs
            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
                (n < slots).then_some(n + 1)
            })
            .ok()?;
        Some(Kdf(&self.kdfs))
    }
}
struct Kdf<'a>(&'a AtomicUsize);
impl Drop for Kdf<'_> {
    fn drop(&mut self) {
        self.0.fetch_sub(1, Ordering::Release);
    }
}
fn limited(request: Request, shared: &Shared) {
    let mut refusal = Refusal::new(
        "E_RATE_LIMIT",
        "auth",
        "too many identity requests; honor Retry-After/retryAfterMs. Scripted staging setup should use seedAccounts, which waits. Local dev loopback has no per-minute identity cap; serialize password requests to stay within its bounded KDF slots. Production/staging keep their real limits (30 attempts/peer/minute, 10/email/minute)",
    )
    .guide("personas");
    refusal.retryable = true;
    let mut denied=refusal_json(&refusal);
    denied["retryAfterMs"]=json!(WINDOW.as_millis() as u64);
    crate::serve::respond_with_headers(request, shared, 429, json!({ "denied": denied }),vec![
        tiny_http::Header::from_bytes("Retry-After",WINDOW.as_secs().to_string()).unwrap(),
        tiny_http::Header::from_bytes("Access-Control-Expose-Headers","Retry-After").unwrap(),
    ]);
}

pub fn handle(request: Request, shared: &Shared, path: &str, body: &str) {
    let payload: Json = match serde_json::from_str(if body.is_empty() { "{}" } else { body }) {
        Ok(value) => value,
        Err(_) => {
            return respond_timed(request, shared,
                400,
                json!({ "denied": Refusal::new("E_INPUT", "input", "identity takes a JSON object") }),
            );
        }
    };
    let email = payload.get("email").and_then(Json::as_str).unwrap_or("");
    let password = payload.get("password").and_then(Json::as_str).unwrap_or("");
    let password_route = matches!(path, "/auth/login" | "/auth/signup");
    let peer = request
        .remote_addr()
        .map(|a| a.ip().to_string())
        .unwrap_or_else(|| "unknown".into());
    let rate_route = matches!(path, "/auth/login" | "/auth/signup" | "/auth/guest");
    // @ref LLP 3000.007#8 — dev loopback has no minute counters; KDF slots remain
    let dev_loopback = shared.personas && request.remote_addr().is_some_and(|peer| peer.ip().is_loopback());
    if rate_route && !dev_loopback
        && !shared
            .auth
            .attempt(&peer, password_route.then_some(email), Instant::now())
    {
        return limited(request, shared);
    }
    let kdf = if password_route {
        match shared.auth.kdf(dev_loopback) {
            Some(permit) => Some(permit),
            None => return limited(request, shared),
        }
    } else {
        None
    };
    let scope = match payload.get("scope") {
        None => Ok(identity::SessionScope::Full),
        Some(Json::String(value)) if value == "full" => Ok(identity::SessionScope::Full),
        Some(Json::String(value)) if value == "read" => Ok(identity::SessionScope::Read),
        _ => Err(RuntimeError::Input("scope must be full or read".into())),
    };
    let outcome = scope.and_then(|scope| perform(&request, shared, path, email, password, scope));
    drop(kdf);
    match outcome {
        Ok(Outcome::Refused(why)) => respond_refused(request, shared, why),
        Ok(Outcome::SupervisedRefresh) => respond_timed(request, shared, 403, json!({ "denied": refusal_json(&Refusal::new(
            "E_WORKER_REFRESH", "auth", "supervised worker tokens are rotated by the supervisor; keep using the injected token",
        ).guide("effects")) })),
        Ok(Outcome::Logout) => respond_timed(request, shared, 200, json!({ "ok": true })),
        Ok(Outcome::LogoutAll(revoked)) => {
            respond_timed(request, shared, 200, json!({ "ok": true, "revoked": revoked }))
        }
        Ok(Outcome::Session(session)) => {
            let mut wire = json!({ "principal": session.principal, "kind": session.kind, "token": session.token, "expiresAt": session.expires_at, "scope": session.scope });
            if let Some(cap) = session.cap_expires_at { wire["capExpiresAt"] = json!(cap); }
            respond_timed(request, shared, 200, json!({ "session": wire }));
        },
        Err(error) => {
            if matches!(path, "/auth/logout" | "/auth/narrow" | "/auth/refresh" | "/auth/logout-all")
                && let RuntimeError::Auth(message) = &error {
                return respond_refused(request, shared, Refusal::new("E_AUTH", "auth", message).guide("personas"));
            }
            let status = error_status(&error);
            respond_timed(request, shared, status, json!({ "denied": refusal_json(&error.refusal()) }));
        }
    }
}

enum Outcome {
    Refused(Refusal),
    Session(identity::Session),
    SupervisedRefresh,
    Logout,
    LogoutAll(u64),
}

pub(crate) fn error_status(error: &RuntimeError) -> u16 {
    if matches!(error, RuntimeError::Auth(_)) { 401 }
    else if error.is_refusal() { 200 } else { 503 }
}

// @ref LLP 3000.007#20.2 — identity operations preserve the same refusal envelope as data doors.
fn respond_refused(request: Request, shared: &Shared, why: Refusal) {
    respond_timed(request, shared, if why.retryable { 503 } else { 401 }, json!({ "denied": refusal_json(&why) }));
}

//! Immutable source releases with a database-authoritative activation pointer.
use super::*;
use crate::store_owner::Owner;
use std::path::{Path, PathBuf};
#[path = "staging.rs"]
mod staging;
struct Stage(PathBuf);
impl Drop for Stage {fn drop(&mut self){let _=std::fs::remove_dir_all(&self.0);}}

fn directory(options: &Options) -> Result<PathBuf, String> {
    options
        .positionals
        .first()
        .map(PathBuf::from)
        .ok_or_else(|| "a deployment directory is required".into())
}

// @ref LLP 3000.000.000#5.1 — deployment aliases share ownership, control and worker paths.
fn canonical_directory(options: &Options) -> Result<PathBuf, String> {
    let requested = directory(options)?;
    if !requested.exists() {
        snapback4_core::private_fs::directory(&requested).map_err(|e| e.to_string())?;
    }
    let dir = requested.canonicalize().map_err(|e| e.to_string())?;
    snapback4_core::private_fs::directory(&dir).map_err(|e| e.to_string())?;
    Ok(dir)
}

// @ref LLP 3000.000.000.000.000#8 — validate before any writable ownership or command lock.
pub(crate) fn existing_deployment(requested: &Path) -> Result<PathBuf, String> {
    let missing = || format!("no current release in {}; run `snapback4 deploy {}` first", requested.display(), requested.display());
    if !requested.join("store.sqlite").is_file() { return Err(missing()); }
    let dir = requested.canonicalize().map_err(|e| e.to_string())?;
    inspect_current(&dir)?;
    Ok(dir)
}

// SQLite READONLY can create WAL sidecars. A stopped store's existing owner
// lock makes immutable inspection safe; a live host supplies its own status.
fn inspect_current(dir: &Path) -> Result<u64, String> {
    use rusqlite::{Connection, OpenFlags, OptionalExtension};
    let database = dir.join("store.sqlite").canonicalize().map_err(|e| e.to_string())?;
    let missing = || format!("no current release in {}; run `snapback4 deploy {}` first", dir.display(), dir.display());
    let owner = match snapback4_core::private_fs::auxiliary_file(&database,
        &snapback4_core::private_fs::owner_path(&database), false, 0) {
        Ok(owner) => owner,
        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
            // Relocated/legacy deployments may not yet have a sidecar beside
            // the resolved DB. Establish a complete current source first; only
            // a known deployment may let SQLite create its ordinary WAL files.
            return pointer_current(dir, &database);
        },
        Err(error) => return Err(format!("{}; existing ownership sidecar unavailable: {error}", missing())),
    };
    match owner.try_lock() {
        Ok(()) => {},
        Err(std::fs::TryLockError::WouldBlock) => {
            match crate::release_control::request(dir, crate::release_control::Command::Status {after:0, items_after:None, event:None}) {
                Ok(status) => return status["release"].as_u64().filter(|n|*n>0).ok_or_else(missing),
                Err(error) => {
                    // A killed host's watchdogs retain ownership during their
                    // bounded cleanup. Preserve serve's existing restart wait.
                    if !crate::store_owner::stopped_host(&database) {
                        // A second source directory may alias the same DB. Its
                        // source cannot control this host, but its token still
                        // belongs to the resolved database. Establish current
                        // source before permitting ordinary read-only WAL work.
                        return pointer_current(dir, &database).map_err(|_| format!("{}; {error}",missing()));
                    }
                    let deadline=std::time::Instant::now()+std::time::Duration::from_secs(5);
                    loop {
                        match owner.try_lock() {
                            Ok(()) => break,
                            Err(std::fs::TryLockError::WouldBlock) if std::time::Instant::now()<deadline => std::thread::sleep(std::time::Duration::from_millis(25)),
                            _ => return Err(format!("{}; {error}",missing())),
                        }
                    }
                }
            }
        },
        Err(error) => return Err(error.to_string()),
    }
    if !snapback4_core::private_fs::owner_is_named(&database, &owner) {
        return Err("store ownership changed during release inspection; retry".into());
    }
    #[cfg(unix)]
    let bytes = { use std::os::unix::ffi::OsStrExt; database.as_os_str().as_bytes() };
    #[cfg(not(unix))]
    let bytes = database.to_str().ok_or("invalid store path")?.as_bytes();
    let mut uri = String::from("file:");
    for byte in bytes {
        if byte.is_ascii_alphanumeric() || b"/._-".contains(byte) { uri.push(*byte as char); }
        else { uri.push_str(&format!("%{byte:02X}")); }
    }
    let mut wal = database.as_os_str().to_os_string(); wal.push("-wal"); let wal = PathBuf::from(wal);
    let mut shm = database.as_os_str().to_os_string(); shm.push("-shm"); let shm = PathBuf::from(shm);
    let has_wal = match std::fs::metadata(&wal) {
        Ok(meta) => meta.len() > 0,
        Err(e) if e.kind() == std::io::ErrorKind::NotFound => false,
        Err(e) => return Err(e.to_string()),
    };
    if has_wal && !shm.is_file() { return Err("store has a WAL without its shared-memory sidecar; run deploy on this stopped deployment to recover it before inspection".into()); }
    // Immutable SQLite omits WAL reads: use it only for the checkpointed main
    // image. Existing WAL+SHM can be read normally under the same exclusion.
    uri.push_str(if has_wal { "?mode=ro" } else { "?mode=ro&immutable=1" });
    let conn = Connection::open_with_flags(uri, OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_URI).map_err(|e|e.to_string())?;
    let release: Option<String> = conn.query_row("SELECT value FROM _meta WHERE key='release'", [], |row|row.get(0)).optional().map_err(|e|e.to_string())?;
    let release = match release {
        Some(value) => value,
        None => std::fs::read_to_string(dir.join("current")).map_err(|_| missing())?,
    };
    release.trim().parse::<u64>().ok().filter(|n|*n>0).ok_or_else(missing)
}

fn pointer_current(dir: &Path, database: &Path) -> Result<u64, String> {
    let missing = || format!("no current release in {}; deploy first", dir.display());
    let pointer = std::fs::read_to_string(dir.join("current")).map_err(|_| missing())?;
    let pointer = pointer.trim().parse::<u64>().ok().filter(|n|*n>0).ok_or_else(missing)?;
    bound_at(dir.join("releases").join(pointer.to_string()))?;
    let store = snapback4_core::Store::open_read_only(database).map_err(|e|e.to_string())?;
    match store.meta("release").map_err(|e|e.to_string())? {
        Some(value) => value.parse::<u64>().ok().filter(|n|*n>0).ok_or_else(missing),
        None => Ok(pointer),
    }
}

