snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:35:["0c09fe43b2321c9e77e2388815c8f0fc4aa31a77093272355715dfa5804e8250",[["schema.q","use identity guests\n\ntable privateProducts:\n  ownerId: principal\n  sku: text 1..40\n  category: text 1..20\n  price: int\n  title: text <=200\n  revision: int\n  unique byOwnerSku: ownerId, sku\n  unique byOwnerCategoryPrice: ownerId, category, price, sku\n  immutable ownerId, sku, category, price, title\n  read <- .ownerId = viewer\n  insert <- deny\n  update <- .ownerId = viewer\n  delete <- deny\n\nquery point(sku: text 1..40):\n  return privateProducts[viewer, sku] by byOwnerSku { sku, category, price, title, revision }\n\nquery category(category: text 1..20, c: cursor ?):\n  return privateProducts[viewer, category] after c first 50 by byOwnerCategoryPrice\n    { sku, category, price, title, revision }\n\nquery all(c: cursor ?):\n  return privateProducts[viewer] after c first 1000 by byOwnerSku\n    { sku, category, price, title, revision }\n\nmutation bump(sku: text 1..40):\n  row = privateProducts[viewer, sku] by byOwnerSku ! else NOT_FOUND\n  update privateProducts[row] { revision: row.revision + 1 }\n  return { sku: row.sku, revision: row.revision + 1 }\n\nquery version():\n  return 1\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:77:["187f905db1779d53020743248e928a107a2f82d8ecca6fd2e031fd14f72c4aaa",[["timeline.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: timeline.nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:101:["207c067a54a32133f9b137646bed304673dad5020c15be3058d70eb8f2c8112d",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\njob rescore(): native                    -- the body is snapback/native/, in Rust\nschedule rescoreEvery every 5m: rescore  -- fired like any job\nquery personalize(first: int): native    -- a read: on the server as the viewer, on a device over its rows\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:109:["237961c1fd6ea3bfd5df2d20a9b3ec262555e7434b5965bc91bb8bfa44a06486",[["schema.q","use identity guests\nuse personas alice\ntable items:\n  body: text <=100\n  read <- allow\n  insert <- allow\n  sync public\nmutation add():\n  return insert items {body: 'kept'}\nquery q():\n  return 3\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:154:["330a96f1bf0890987f64d5f3e6d4cdfcacb64b934958633f20eb8b1a62ce3945",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\nmutation recentPass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:160:["34fcc5cfaea48081ee42ea99c1acdfd83cc34b2ea0c5b4a5d301a8bf133311e1",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\nshape brief = { id, body, author: .authorId }                        -- a named shape: bare columns, and `.` for the row\n\nquery shapeForms(roomId: rooms, messageId: messages, c: cursor ?):\n  page = messages[roomId] after c last 20 by byRoomTime { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- over a page: `*` spreads every column; a point read inside is null for a hidden row\n  row = rooms[roomId] { id, name, tagCount: count(.tags) }           -- over a row: an object; over a nullable row: null when the row is\n  named = messages[messageId] brief                                  -- a named shape by its name\n  nested = rooms[roomId] { ...card, extra: 1 }                        -- `...name` spreads a named shape's fields\n  return { page, row, named, nested }\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:208:["42911cc29af9f60cc833f10ff8144676a7d3bd2b0b6d57c98efaaae2b8b65804",[["schema.q","use identity guests\nuse personas alice\ntable items:\n  body: text <=100\n  read <- allow\n  insert <- allow\n  sync public\nmutation add():\n  return insert items {body: 'kept'}\nquery q():\n  return 1\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:245:["4f8300541cb0efc6a73e7c03f1e1c121531611751a171659fc4b15073923ba21",[["schema.q","use identity guests\n\ntable privateProducts:\n  ownerId: principal\n  sku: text 1..40\n  category: text 1..20\n  price: int\n  title: text <=200\n  revision: int\n  unique byOwnerSku: ownerId, sku\n  unique byOwnerCategoryPrice: ownerId, category, price, sku\n  immutable ownerId, sku, category, price, title\n  read <- .ownerId = viewer\n  insert <- deny\n  update <- .ownerId = viewer\n  delete <- deny\n\nquery point(sku: text 1..40):\n  return privateProducts[viewer, sku] by byOwnerSku { sku, category, price, title, revision }\n\nquery category(category: text 1..20, c: cursor ?):\n  return privateProducts[viewer, category] after c first 50 by byOwnerCategoryPrice\n    { sku, category, price, title, revision }\n\nquery all(c: cursor ?):\n  return privateProducts[viewer] after c first 1000 by byOwnerSku\n    { sku, category, price, title, revision }\n\nmutation bump(sku: text 1..40):\n  row = privateProducts[viewer, sku] by byOwnerSku ! else NOT_FOUND\n  update privateProducts[row] { revision: row.revision + 1 }\n  return { sku: row.sku, revision: row.revision + 1 }\n\nquery version():\n  return 2\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:259:["56b57bca0fb142113c08ec242639506fccbcaccdb50dcf48ee3282e03527a476",[["schema.q","use identity guests\nuse personas alice\ntable items:\n  body: text <=100\n  read <- allow\n  insert <- allow\n  update <- allow\n  sync public\nmutation add():\n  return insert items {body: 'kept'}\nquery q():\n  return 1\njob sweep():\n  chunk row in items first 1 by byId:\n    update items[row.id] { body: row.body }\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:340:["768c3d9cab8a0e58e947f8d2cfb72779bc29866746ec95be493cc9bd3b3b4302",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\naction invite(email: text <=200)                  -- any signed-in principal\naction refreshModel() <- viewer = 'service:ranker'\naction paused() <- deny\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:350:["78857a3ec87cfc8e73056c409dcc0bb4b9ebb424a10f21d119e01cbb1ca2e437",[["schema.q","use identity guests\nuse personas alice\ntable items:\n  body: text <=100\n  read <- allow\n  insert <- allow\n  sync public\nmutation add():\n  return insert items {body: 'kept'}\nquery q():\n  return 9\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:425:["92bc2b2640bd55a919647f317bc186987a0d28f17c015684d169563ce97853b3",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\naction invite(email: text <=200)\naction refreshModel() <- viewer = 'service:ranker'\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:472:["9fc3dd50b6a5589d1871ffe655074d89ae3f325ecd892664f25568fdba3b833a",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\nquery readForms(roomId: rooms, messageId: messages, c: cursor ?):\n  one = messages[messageId]                                  -- one row by a unique key: null if absent or hidden\n  must = messages[messageId] ! else NOT_FOUND                 -- the row, or refuse with the code\n  member = exists members[roomId, viewer]                    -- true or false; positional keys match the index columns\n  admin = exists members[roomId = roomId, principal = viewer, role = 'admin']   -- named keys; `by` names the index when two match\n  oldest = messages[roomId, at < must.at] last 20 by byRoomTime           -- the nearest earlier rows\n  newest = messages[roomId] after c last 20 by byRoomTime where .body != null    -- a page, descending, from a cursor\n  everyone = profiles first 50 by byHandle                   -- the whole table's page: the empty prefix, spelled without brackets\n  merged = merge posts last 20 by byAuthorTime:              -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  chain = walk rooms[roomId] up .parentId depth 8            -- the row, its parent, and so on: at most 8 rows\n  return { one, must, member, admin, newest, chain }\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:540:["b790f3cfaa721b54a0b7fc01578a7bea121714b52fc7d1f969eeb216cbbf7bf1",[["schema.q","use identity guests\nuse personas alice\ntable items:\n  body: text <=200\n  read <- allow\n  insert <- allow\n  sync public\nmutation add():\n  return insert items {body: 'kept'}\nquery q():\n  return 1\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:568:["c16598406bf884289c650d14c8aa70545617439bd7043e145b9a75c895823279",[["schema.q","use identity guests\nuse personas alice\ntable items:\n  body: text <=100\n  read <- allow\n  insert <- allow\n  sync public\nmutation add():\n  return insert items {body: 'kept'}\nquery q():\n  return 1\n"],["extra.q","query old():\n  return 2\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:585:["c737d0391569533ddc2a66c802893b93a08e2069ca67b612c3d39a8bbb77ba1a",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\nquery connections(p: principal):\n  return connected[p]                    -- an int; `exists connected[p]` is the bool\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:606:["cec52c07ac37a5948d46269047d9744818ab1977298d4c4b04d6972c68c94b90",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n"]]]
snapback4/crates/snapback4-lang/tests/lowering/r1p-sources.jsonl:635:["d8391d0e4c8e9e74b572f4a4c44770941810f07244dbbc80133da0acc57950de",[["schema.q","use identity                          -- guests and password accounts; `use identity guests` or `use identity password` admits one kind\nuse personas alice, bob, carol        -- a development cast: `--as alice` and the persona header act as dev:alice\neffect notify                         -- a name a mutation or job may `emit` under; a worker with a service token performs it (guide effects)\n\ntable rooms:\n  name: text 1..80                    -- text <=N | text M..N, either with `format handle` or `format url`\n  ownerId: principal                  -- principal | id | <table> (a reference to its row) | int | time (milliseconds) | bool\n  kind: enum('open', 'closed')        -- enum('a', 'b') | decimal S | money CUR [S] | json <=N | bytes <=N | image <=N [once] | video <=N\n  tags: [text <=20] <=8               -- [type] <=N: a bounded list\n  parentId: rooms ?                   -- `?` makes a column optional: null when absent. Every table has an implicit `id` and a unique `byId`\n  createdAt: time default now          -- omitted on insert; evaluated on the writing host\n  by byOwner: ownerId, createdAt, id  -- `by` orders; a scan pins the leading columns and pages along the rest\n  read <- exists members[.id, viewer]                                     -- rules: allow | deny | public ['why'] | .col = viewer | .col != 'x' | exists t[..] | created t[..] | and | or | not\n  insert <- .ownerId = viewer\n  update (old, next) <- old.ownerId = viewer and next.ownerId = viewer   -- an update rule may name both images\n  delete <- deny\n  after insert <- exists members[roomId = .id, principal = .ownerId, role = 'admin']                 -- a row that must exist by the end of the mutation that inserted this one\n  sync to members[.id]                -- each row reaches every principal with a members row whose roomId is this row's id\n\ntable members:\n  roomId: rooms\n  principal: principal\n  role: enum('member', 'admin')\n  joinedAt: time\n  unique byRoomPrincipal: roomId, principal            -- `unique` orders and constrains\n  by byRoomPrincipalRole: roomId, principal, role\n  by byPrincipalRoom: principal, roomId, id\n  cap 100 by roomId                                    -- at most N rows per group; needs an index leading with the group\n  immutable roomId, principal                          -- columns no update may change\n  read <- exists members[.roomId, viewer]\n  insert <- exists members[roomId = .roomId, principal = viewer, role = 'admin'] or created rooms[.roomId]   -- created: this mutation inserted the probed row\n  delete <- .principal = viewer or exists members[roomId = .roomId, principal = viewer, role = 'admin']\n  sync to members[.roomId]\n\ntable messages:\n  roomId: rooms\n  authorId: principal\n  body: text <=4000 ?\n  photo: image <=10000000 ?           -- an upload the row holds (guide assets); `once` after the bound serves one view per principal\n  clip: video <=50000000 ?\n  editedAt: time ?\n  expiresAt: time ?\n  at: time\n  by byRoomTime: roomId, at, id\n  by byRoomWords: roomId, words(body), at, id   -- a words index: one entry per distinct word of the text columns; read with `matching` (guide search)\n  by byExpiresAt: expiresAt\n  immutable roomId, authorId\n  read <- exists members[.roomId, viewer]\n  insert <- .authorId = viewer and exists members[.roomId, viewer]\n  update <- .authorId = viewer\n  delete <- .authorId = viewer\n  retain delivered-history            -- a device keeps what it was given after it leaves the group; `until-revoked` (the default) drops it\n  expire at .expiresAt                -- a row past that time is absent everywhere at once, then swept; a null time never expires\n  sync last 500 by byRoomTime     -- the horizon: a device acquires the newest N per group; older rows are online-only\n\ntable posts:\n  authorId: principal\n  body: text <=500\n  score: int\n  at: time\n  by byAuthorTime: authorId, at, id\n  by byTime: at, id\n  public 'posts are public'           -- the read rule as a table line, with its reason\n  insert <- .authorId = viewer\n  update <- deny\n  delete <- .authorId = viewer\n  sync public last 200 by byTime      -- everyone holds the same rows\n\ntable follows:\n  followerId: principal\n  followedId: principal\n  unique byPair: followerId, followedId\n  by byFollowed: followedId, followerId\n  cap 1000 by followerId\n  read <- .followerId = viewer        -- exactly the audience of the sync line below\n  insert <- .followerId = viewer\n  delete <- .followerId = viewer\n  sync to .followerId                 -- each row reaches the principal in the column\n\ntable reactions:\n  postId: posts\n  principal: principal\n  direction: int\n  unique byPostPrincipal: postId, principal\n  by byPrincipal: principal, id\n  read <- .principal = viewer\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- .principal = viewer\n  sync to .principal last 500 by byPrincipal\n\ntable profiles:\n  principal: principal\n  handle: text 3..20 format handle    -- a text format is checked on every write\n  site: text <=200 format url ?\n  unique byPrincipal: principal\n  unique byHandle: handle\n  public 'profiles are public'\n  insert <- .principal = viewer\n  update <- .principal = viewer\n  delete <- deny\n  online only                         -- optional; no sync line has the same meaning\n\ntable ledger:\n  ownerId: principal\n  amount: money USD                   -- money CUR [scale] (2 unless given) and decimal S hold integer minor units\n  weight: decimal 2\n  note: json <=2000 ?\n  at: time\n  by byOwnerTime: ownerId, at, id\n  read <- .ownerId = viewer\n  insert <- .ownerId = viewer\n  update <- deny\n  delete <- deny\n\nmaintain messageCounts: count messages by roomId       -- an aggregate the engine keeps: read it by group and get the number, 0 when the group has no row\n  read <- exists members[.roomId, viewer]\nmaintain scoreTotals: sum posts of score by authorId   -- count, or sum of an int, decimal or money column\n  read <- allow\n  online only                         -- opt out of inheriting public sync\n\nshape card = { id, name, owner: .ownerId, tagCount: count(.tags) }   -- a named shape: `.` is the row; `row card` and `page card` use it\nfn messageBody(m: messages): m.body                                  -- a row argument keeps its fields at this call site\nfn messageById(m: messages): (messages[m] ! else NOT_FOUND).body      -- a reference argument stays a reference\nfn isBrief(ttl: int ?): ttl != null                                  -- a helper expression, expanded where it is called\nfn stamp(roomId: rooms):                                             -- a helper body, expanded with its caller's write authority\n  update rooms[roomId] { createdAt: now }\n  return\nfn tally(n: int):\n  total = 0\n  for i in range(0, 1 + 1):\n    total = total + n\n  return total\n\nquery room(roomId: rooms):            -- a query reads; its result type is inferred onto api.ts\n  return rooms[roomId] card           -- one row by a unique key: null when absent or hidden; then the named shape\n\nquery helperRows(messageId: messages):\n  m = messages[messageId] ! else NOT_FOUND\n  return { body: messageBody(m), byId: messageById(messageId) }\n\nquery thread(roomId: rooms, c: cursor ?):                            -- `cursor ?` is the page argument; an omitted optional argument is null\n  require exists members[roomId, viewer] else NOT_MEMBER              -- a refusal with the program's own code\n  return messages[roomId] after c last 50 by byRoomTime where .body != null and exists members[.roomId, viewer] { *, room: rooms[.roomId], count: messageCounts[.roomId] }   -- a page from a cursor, shaped: `*` spreads the row; a point read inside is null for a hidden row\n\nquery inbox(c: cursor ?):\n  return members[viewer] after c first 50 by byPrincipalRoom { roomId, room: rooms[.roomId], unread: messageCounts[.roomId] }\n\nquery following(c: cursor ?):\n  page = merge posts after c last 20 by byAuthorTime:               -- one ordered page over several prefixes of one index\n    [viewer]\n    [f.followedId] for f in follows[viewer] first 20 by byPair\n  return page { *, author: profiles[principal = .authorId], mine: reactions[.id, viewer] }\n\nquery ancestors(roomId: rooms):\n  chain = walk rooms[roomId] up .parentId depth 8                   -- the row, its parent, and so on: at most `depth` rows\n  return chain { id, name }\n\nquery digest(roomId: rooms):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  page = messages[roomId, at >= now - 86400000] last 100 by byRoomTime                     -- a page bound to a name; count, sum, slice, sort and shapes take it\n  (weeks, days) = divmod(count(page), 7)                             -- divmod binds quotient and remainder at once\n  (lo, hi) = sorted(weeks, days)                                     -- two values in order\n  counter = 0\n  for message in page:\n    counter = counter + 1                                           -- a local can carry a counter across iterations\n  offsets = []\n  for i in range(0, 3):\n    if i = 2:\n      continue                                                      -- advances the nearest for or chunk\n    else if i < 0:\n      break                                                         -- else if is a nested conditional\n    offsets = offsets + [i]                                         -- append in place, under the heap meter\n  label = lower(trim(' DIGEST ')) + ': ' + join(['room', 'messages'], ' / ')\n  quotient = counter / 7\n  doubled = tally(counter)                                          -- a helper body also yields a value in an expression\n  remainder = counter % 7                                          -- the same Euclidean parts as divmod; zero refuses E_DIV_ZERO\n  head = first(page)\n  if head != null and head.body != null:\n    bodySize = count(head.body)                                     -- a null guard narrows the snapshot field through the rest of this block\n  sum = sum(page, .at)\n  grouped = group(page, 'authorId') { author: .key, count: count(.items) }\n  return { sum, grouped, first: first(page), last: last(page), at: at(page, 1), total: messageCounts[roomId], counter, offsets, label, labelSize: count(label), doubled, quotient, remainder, weeks, days, lo, hi, brief: isBrief(null), oldest: sort(slice(page, 0, 10), 'at') { id, at }, smaller: min(weeks, days), larger: max(weeks, days) }\n\nquery mentions(body: text <=4000):\n  return tokens(body)                 -- the @mentions in a text, without the @, at most 64: a bounded list\n\nquery search(roomId: rooms, q: text <=100, c: cursor ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  return messages[roomId] matching q after c last 50 by byRoomWords   -- word-prefix search: every term a prefix of some word of the row, newest first\n\nquery everywhere(q: text <=100, c: cursor ?):\n  return merge messages matching q after c last 50 by byRoomWords:\n    [m.roomId] for m in members[viewer] first 50 by byPrincipalRoom\n\nquery online(p: principal):\n  return connected[p]                 -- how many connections the principal holds open on the server; `exists connected[p]` tests (guide presence)\n\nmutation pagePass(roomId: rooms): server\n  n = 0\n  for row in members[roomId] first 10 by byRoomPrincipal:\n    n = n + 1\n  return n\n\nmutation createRoom(name: text 1..80, kind: enum('open', 'closed'), tags: [text <=20] <=8):\n  room = insert rooms { id: new, name, ownerId: viewer, kind, tags }   -- `new` mints an id; omit `id` and one is minted anyway\n  insert members { roomId: room.id, principal: viewer, role: 'admin', joinedAt: now }\n  upsert rooms[room.id] { createdAt: now }                            -- patches the existing room; name, owner, kind and tags stay\n  return room card\n\nmutation sendBrief(roomId: rooms, body: text <=4000 ?, ttl: int ?):\n  require exists members[roomId, viewer] else NOT_MEMBER\n  row = insert messages { roomId, authorId: viewer, body, at: now, expiresAt: now + ttl if ttl != null else null }   -- a conditional value: the arm not taken never runs, and `ttl` is present in the taken one\n  for m in members[roomId] first 100 by byRoomPrincipal:\n    if m.principal != viewer and not exists connected[m.principal]:\n      emit notify { targetUserId: m.principal, roomId, preview: slice(body ?? '', 0, 80) }   -- kept in this commit; a worker claims and settles it (guide effects)\n  return { id: row.id, brief: isBrief(ttl), mentions: count(tokens(body ?? '')) }                                 -- `??` is the value when the left is null\n\nmutation edit(messageId: messages, body: text <=4000, expected: text <=4000 ?):\n  msg = messages[messageId] ! else NOT_FOUND                         -- the row, or refuse with the code; `msg` is present from here on\n  require msg.authorId = viewer else NOT_AUTHOR\n  update messages[msg] { body, editedAt: now } if .body = expected    -- a row as the key; `if` makes the update conditional: E_CONFLICT with the current row when false\n  return null                                                        -- a bare `return` is the same\n\nmutation join(roomId: rooms, principal: principal):\n  require exists members[roomId = roomId, principal = viewer, role = 'admin'] by byRoomPrincipalRole else NOT_ADMIN\n  return insert members { roomId, principal, role: 'member', joinedAt: now } if absent   -- the row, or null on a unique clash\n\nmutation leave(roomId: rooms):\n  delete members[roomId = roomId, principal = viewer]                -- a key may name its columns; a full unique key names one row, NOT_FOUND when it is missing\n  return null\n\nmutation react(postId: posts, direction: int):\n  require direction = 1 or direction = -1 else BAD_DIRECTION         -- =, !=, <, <=, >, >=, +, -, *, unary -, not, and, or\n  upsert reactions[postId, viewer] { direction }                     -- insert or patch; the key names the row; a final write is the implicit return\n\nmutation post(bodies: [text <=500] <=10):\n  for body in bodies:                                                -- a loop over a bounded list; `for row in page:` and `for i in range(0, 10):` are the other domains\n    insert posts { authorId: viewer, body, score: 0, at: now }\n  return count(bodies)\n\nmutation split(total: int, people: [principal] <=8):\n  insert ledger { ownerId: viewer, amount: share(total, people, viewer), weight: 1, at: now }   -- share: one person's part of an amount split evenly, deterministically\n\njob nightly(periodStart: time, periodEnd: time):                    -- the server's own work: sweeps as the system principal, one page per commit\n  end = periodEnd                                                   -- the prelude runs again at the start of every chunk, under that chunk's meter\n  chunk r in rooms first 100 by byId:                                -- the index's columns are id or immutable, so nothing moves under the cursor\n    if r.createdAt >= end:\n      break                                                          -- ends this sweep; `return` ends the job\n    stamp(r.id)\n  chunk p in posts first 100 by byId:\n    for i in range(0, 2):                                            -- int expressions, under the step meter\n      update posts[p.id] { score: p.score + i }\nschedule everyNight every 1d at 03:00: nightly                       -- once per period boundary of the server's clock: every 2m | 1h | 1d [at HH:MM]\njob rescoreNative(): native                                          -- a job whose body is the app's own Rust in snapback/native/, hosted as wasm (guide native)\nquery personalizeNative(first: int): native                          -- a read in the same module: on the server as the viewer, on a device over its rows\n\nquery programForms(roomId: rooms):                             -- reads only; the last expression, or `return`, is the result, typed onto api.ts\n  rooms[roomId] card\n\nmutation programWrites(roomId: rooms, title: text 1..80):     -- reads and writes in one transaction, at most once per client-minted id\n  room = rooms[roomId] ! else NOT_FOUND\n  require room.ownerId = viewer else NOT_OWNER\n  update rooms[room] { name: title }                           -- a final write is the implicit return\n"]]]
