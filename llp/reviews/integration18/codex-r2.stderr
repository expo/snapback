     1	use snapback4_lang::{compile,security};
     2	use snapback4_core::{Engine,Value};
     3	const SOURCE:&str="use personas alice, bob\ntable roles:\n  principal: principal\n  role: enum('inspector', 'member')\n  unique principal\n  read <- allow\n  insert <- viewer = 'service:ops'\n  update <- viewer = 'service:ops'\n  online only\ntable grants:\n  principal: principal\n  unique principal\n  read <- allow\n  insert <- viewer = 'service:ops'\n  online only\ntable reports:\n  body: text <=80\n  read <- exists grants[viewer]\n  online only\nmutation grant(who: principal):\n  return insert grants { principal: who }\nmutation demote(who: principal):\n  update roles[who] { role: 'member' }\n  return null\ninvariant reports.read only exists roles[viewer, role = 'inspector']\nquery inspect(report: reports):\n  return reports[report]\n";
     4	fn row(fields:&[(&str,Value)])->Value{Value::Row(fields.iter().map(|(n,v)|(n.to_string(),v.clone())).collect())}
     5	#[test]
     6	fn actual_grant_demotion_and_read_has_a_replayable_trace(){
     7	 for fixed in [false,true]{
     8	  let source=if fixed{SOURCE.replace("read <- exists grants[viewer]","read <- exists grants[viewer] and exists roles[viewer, role = 'inspector']")}else{SOURCE.into()};
     9	  let b=compile(&[("schema.q".into(),source)]);assert!(b.diagnostics.is_empty(),"{:?}",b.diagnostics);
    10	  let mut fixture=Engine::memory(b.schema.clone(),b.programs.iter().map(|p|p.program.clone())).unwrap();
    11	  fixture.seed_at(vec![("roles".into(),row(&[("id",Value::Id("role-a".into())),("principal",Value::Id("dev:security-a".into())),("role",Value::String("inspector".into()))])),
    12	   ("reports".into(),row(&[("id",Value::Id("report".into())),("body",Value::String("private".into()))]))],1_800_000_000_000).unwrap();
    13	  let mut c=security::challenges::Campaign::default();security::challenges::operations(&b,&fixture,&mut c);
    14	  assert!(c.sequences>0);assert_eq!(c.violations.is_empty(),fixed,"{c:?}");
    15	  if !fixed{assert!(c.violations.iter().any(|v|v.history.iter().any(|s|s.operation=="grant")&&v.history.iter().any(|s|s.operation=="demote")),"{c:?}");}
    16	 }
    17	}
