    26	    pub(crate) fn check(&self, conn: &rusqlite::Connection) -> Result<(), RuntimeError> {
    27	        let actual: Option<String> = conn
    28	            .query_row("SELECT value FROM _meta WHERE key='release'", [], |r| {
    29	                r.get(0)
    30	            })
    31	            .optional()?;
    32	        if actual
    33	            .as_ref()
    34	            .is_some_and(|s| s.parse::<u64>().ok() != self.expected_previous)
    35	        {
    36	            return Err(RuntimeError::Generation("current release changed; run `snapback4 releases <dir>` and retry the selected release".into()));
    37	        }
    38	        let revision: Option<String> = conn
    39	            .query_row(
    40	                "SELECT value FROM _meta WHERE key='release_revision'",
    41	                [],
    42	                |r| r.get(0),
    43	            )
    44	            .optional()?;
    45	        let revision = revision.and_then(|v| v.parse::<u64>().ok()).unwrap_or(0);
    46	        if self.expected_revision.is_some_and(|n| n != revision) {
    47	            return Err(RuntimeError::Generation("activation revision changed (including rollback/equal-content activation); run `snapback4 releases <dir>` and retry".into()));
    48	        }
    49	        Ok(())
    50	    }
    51	}
