   163	            ledger: file,
   164	        };
   165	        writeln!(prepared.ledger, "{release}")
   166	            .and_then(|_| prepared.ledger.sync_all())
   167	            .map_err(|e| e.to_string())?;
   168	        prepared.ledger = fs::OpenOptions::new()
   169	            .create(true)
   170	            .append(true)
   171	            .open(dir.join("releases.jsonl"))
   172	            .map_err(|e| e.to_string())?;
   173	        writeln!(prepared.ledger,"{}",serde_json::json!({"at":snapback4_core::now_ms(),"release":release,"previous":previous,"rollback":rollback,"state":"prepared"})).and_then(|_|prepared.ledger.sync_all()).map_err(|e|e.to_string())?;
   174	        Ok(prepared)
   175	    }
   176	    pub(crate) fn finish(&mut self, generation: u64) -> Result<(), String> {
   177	        fs::rename(&self.staged,self.dir.join("current")).and_then(|_|fs::File::open(&self.dir)?.sync_all()).map_err(|e|format!("release {} committed in database, but current copy failed: {e}; inspect `snapback4 releases {}`",self.release,self.dir.display()))?;
