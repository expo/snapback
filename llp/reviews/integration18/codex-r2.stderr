     8	export function resolveBinary(env: Record<string, string | undefined> = process.env): string {
     9	  const here = dirname(fileURLToPath(import.meta.url));
    10	  const require = createRequire(import.meta.url);
    11	  // @ref LLP 3000.021#3.3 — the installed platform package precedes checkout fallbacks
    12	  const platform = `snapback4-${process.platform}-${process.arch}`;
    13	  const candidates: string[] = [];
    14	  if (env.SNAPBACK4_BIN) candidates.push(resolve(env.SNAPBACK4_BIN));
    15	  try { candidates.push(join(dirname(require.resolve(`${platform}/package.json`)), "snapback4")); } catch { /* not installed for this platform */ }
    16	  candidates.push(resolve(here, "../../../target/release/snapback4"), resolve(here, "../../../target/debug/snapback4"));
    17	  const binary = candidates.find((path) => existsSync(path));
    18	  if (!binary) throw new Error(`snapback4: no binary for ${process.platform}-${process.arch}. Packages exist for darwin-arm64 and linux-x64; elsewhere, build with \`cargo build --release -p snapback4\` and set SNAPBACK4_BIN.`);
    19	  return binary;
    20	}

