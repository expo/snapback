     1	//! Owner-mediated release publication in the running HTTP process.
     2	use super::*;
     3	use crate::release_control::Command;
     4	#[cfg(unix)]
     5	use crate::release_control::Listener;
     6	use snapback4_core::engine::release::ReleaseActivation;
     7	
     8	#[cfg(unix)]
     9	pub(super) fn start(
    10	    shared: Arc<Shared>,
    11	    dir: std::path::PathBuf,
    12	) -> Result<std::thread::JoinHandle<()>, String> {
    13	    let store = shared
    14	        .owner
    15	        .as_ref()
    16	        .ok_or("release control requires a persisted owner")?
    17	        .path()
    18	        .map_err(|e| e.to_string())?;
    19	    let listener = Listener::bind(&dir, store)?;
    20	    crate::lifecycle::managed_cleanup();
    21	    crate::lifecycle::background("release-control", move || {
    22	        listener.run(|command| apply(&shared, &dir, command))
    23	    })
    24	}
    25	
    26	// @ref LLP 3000.000.000#5-hot-activation-and-ownership — only assignments and committed rebind follow the database commit.
    27	pub(super) fn apply(
    28	    shared: &Shared,
    29	    dir: &std::path::Path,
    30	    command: Command,
    31	) -> Result<Json, String> {
    32	    match command {
    33	        Command::Status {
    34	            after,
    35	            items_after,
    36	            event,
    37	        } => {
    38	            let mut engine=lock(&shared.engine);
    39	            let mut status=engine.store_mut().release_status(after,items_after.as_deref(),event).map_err(|e|e.to_string())?;
    40	            status["clock"]=json!({"now":shared.now(),"offsetMs":lock(&shared.clock).offset()});
    41	            Ok(status)
    42	        },
    43	        Command::Prune {
    44	            confirm,
    45	            expected_revision,
    46	        } => {
    47	            let mut result = lock(&shared.engine)
    48	                .store_mut()
    49	                .prune_dormant(confirm, Some(expected_revision))
    50	                .map_err(|e| e.to_string())?;
    51	            if let Some(items) = result["items"].as_array_mut() {
    52	                items.truncate(16);
    53	            }
    54	            result["items_after"] = result["items"]
    55	                .as_array()
    56	                .and_then(|items| items.last())
    57	                .map(|i| i["key"].clone())
    58	                .unwrap_or(Json::Null);
    59	            Ok(result)
    60	        }
    61	        Command::Activate {
    62	            release,
    63	            expected_release,
    64	            expected_revision,
    65	            digest,
    66	            rollback,
    67	            restore_dormant,
    68	            allow_feed_adoption,
    69	        } => {
    70	            if release == 0 {
    71	                return Err("release id must be positive".into());
    72	            }
    73	            let project = Project {
    74	                root: dir.join("releases").join(release.to_string()),
    75	            };
    76	            if !std::fs::symlink_metadata(&project.root)
    77	                .is_ok_and(|m| m.is_dir() && !m.file_type().is_symlink())
    78	            {
    79	                return Err(format!(
    80	                    "release {release} is not an immutable release directory"
    81	                ));
    82	            }
    83	            if crate::release_files::digest(&project.root)? != digest {
    84	                return Err("staged release content changed; redeploy its exact source".into());
    85	            }
    86	            if project.sources().map_err(|e| e.to_string())?.is_empty() {
    87	                return Err(format!(
    88	                    "release {release} has no Quarry source; select a complete immutable release"
    89	                ));
    90	            }
    91	            let bound = project.compile().map_err(|e| e.to_string())?;
    92	            if !bound.diagnostics.is_empty() {
    93	                return Err(bound
    94	                    .diagnostics
    95	                    .iter()
    96	                    .map(ToString::to_string)
    97	                    .collect::<Vec<_>>()
    98	                    .join("\n"));
    99	            }
   100	            let prepared = crate::native::prepare(&project, &bound).map_err(|e| e.to_string())?;
   101	            crate::dev_worker::prepare_release(&project, &bound.schema)?;
   102	            crate::release_files::link_store(&project.root)?;
   103	            if crate::release_files::digest(&project.root)? != digest {
   104	                return Err("release artifacts changed during preparation; retry after inspecting immutable source".into());
   105	            }
   106	            crate::release_files::durable(&project.root)?;
   107	            let mut pointer =
   108	                crate::release_files::Pointer::prepare(dir, release, expected_release, rollback)?;
   109	            let options = ReleaseActivation {
   110	                release,
   111	                expected_previous: expected_release,
   112	                expected_revision: Some(expected_revision),
   113	                restore_dormant,
   114	                native_digest: prepared.installed.as_ref().map(|m| m.digest.clone()),
   115	                operation: if rollback { "rollback" } else { "deploy" }.into(),
   116	            };
   117	            let _requests=shared.release_requests.write();
   118	            let mut engine = lock(&shared.engine);
   119	            lock(&shared.readers).begin_adoption(&bound);
   120	            let generation = match engine.adopt_release_at(
   121	                bound.schema.clone(),
   122	                bound.programs.iter().map(|p| p.program.clone()),
   123	                &options,
   124	                allow_feed_adoption,
   125	                shared.now(),
   126	            ) {
   127	                Ok(generation) => generation,
   128	                Err(error) => {
   129	                    lock(&shared.readers).finish_adoption();
   130	                    return Err(error.to_string());
   131	                }
   132	            };
   133	            #[cfg(test)]
   134	            test_work(&shared.release_committed);
   135	            engine.set_prepared_native(prepared.module);
   136	            engine.set_presence(Some(shared.presence.clone()));
   137	            shared.refresh_time_audience_clock(&engine, shared.now());
   138	            lock(&shared.readers).replace(&engine, &bound.refusal_sites);
   139	            {
   140	                let mut active = lock(&shared.bound);
   141	                let mut advertised = lock(&shared.generation);
   142	                let mut native = lock(&shared.native);
   143	                shared.latency.adopt(&bound);
   144	                *active = bound;
   145	                *advertised = generation;
   146	                *native = prepared.installed;
   147	                let mut root = lock(&shared.release_root);
   148	                *root = Some(project.root);
   149	                shared.worker_revision.fetch_add(1, Ordering::Release);
   150	            }
   151	            crate::lifecycle::generation(generation);
   152	            shared.publish_engine(&engine);
   153	            // Completion I/O can fail, but never abandons the new runtime.
   154	            pointer.finish(generation)?;
   155	            snapback4_core::diagnostic!(
   156	                "snapback4 serve: release {release} activated without restart as generation {generation}"
   157	            );
   158	            Ok(
   159	                json!({"release":release,"generation":generation,"revision":expected_revision+1,"hot":true,"adoption":engine.store().adoption_report.compact(),"details":engine.store().adoption_report.summary(),"backfills":engine.store().adoption_report.backfills}),
   160	            )
   161	        }
   162	    }
   163	}
