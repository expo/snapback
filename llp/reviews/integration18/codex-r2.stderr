    50	#[cfg(unix)]
    51	pub(crate) fn identity(store: &Path) -> Result<String, String> {
    52	    let path = store.canonicalize().map_err(|e| e.to_string())?;
    53	    let m = snapback4_core::private_fs::database_metadata(&path)
    54	        .map_err(|e| e.to_string())?
