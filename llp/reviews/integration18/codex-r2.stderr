    61	#[cfg(unix)]
    62	fn peer(stream: &UnixStream) -> io::Result<()> {
    63	    use std::os::fd::AsRawFd;
    64	    #[cfg(target_os = "linux")]
    65	    let uid = {
    66	        let mut credentials = std::mem::MaybeUninit::<libc::ucred>::uninit();
    67	        let mut size = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
    68	        if unsafe {
    69	            libc::getsockopt(
    70	                stream.as_raw_fd(),
    71	                libc::SOL_SOCKET,
    72	                libc::SO_PEERCRED,
    73	                credentials.as_mut_ptr().cast(),
    74	                &mut size,
    75	            )
    76	        } != 0
    77	        {
    78	            return Err(io::Error::last_os_error());
    79	        }
    80	        if size as usize != std::mem::size_of::<libc::ucred>() {
    81	            return Err(io::Error::other("invalid peer credentials"));
    82	        }
    83	        unsafe { credentials.assume_init() }.uid
    84	    };
