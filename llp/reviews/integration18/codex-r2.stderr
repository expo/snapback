   149	        rollback: bool,
   150	    ) -> Result<Self, String> {
   151	        let pointer = dir.join("current");
   152	        if pointer.exists() && !pointer.is_file() {
   153	            return Err("current must be a regular release pointer file".into());
   154	        }
   155	        let staged = dir.join(format!(".current-{}-{release}", std::process::id()));
   156	        let file = snapback4_core::private_fs::file(&staged, true).map_err(|e| e.to_string())?;
   157	        let mut prepared = Self {
