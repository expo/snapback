    38	#[test]
    39	fn populated_media_maintained_and_expiring_fixtures_replay_without_reseeding(){
    40	 const NOW:i64=1_800_000_000_000;
    41	 let source=SOURCE.replace("  body: text <=80", "  body: text <=80\n  photo: image <=5000\n  until: time\n  expire at .until")+"\nview reportTotal: count reports\n";
    42	 let b=compile(&[("schema.q".into(),source)]);assert!(b.diagnostics.is_empty(),"{:?}",b.diagnostics);
    43	 let mut fixture=Engine::new_at(snapback4_core::Store::memory().unwrap(),b.schema.clone(),b.programs.iter().map(|p|p.program.clone()),NOW).unwrap();
    44	 let png=[137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82,0,0,0,1,0,0,0,1];
    45	 let photo=fixture.store_asset("service:ops",&png,NOW).unwrap().column_value();
    46	 fixture.seed_at([
    47	  ("roles".into(),row(&[("id",Value::Id("role-a".into())),("principal",Value::Id("dev:fixture-only".into())),("role",Value::String("inspector".into()))])),
    48	  ("grants".into(),row(&[("id",Value::Id("grant-a".into())),("principal",Value::Id("dev:fixture-only".into()))])),
    49	  ("reports".into(),row(&[("id",Value::Id("report".into())),("body",Value::String("private".into())),("photo",photo.clone()),("until",Value::Int(NOW+100_000))]))
    50	 ],NOW).unwrap();
    51	 let before=fixture.store().rows("reports").unwrap();let derived=fixture.store().rows("reportTotal").unwrap();
    52	 let fork=fixture.store().fork_memory().unwrap();let directory=fork.assets_dir().to_path_buf();
    53	 assert_eq!(fork.rows("reportTotal").unwrap(),derived);assert_eq!(fork.rows("reports").unwrap(),before);assert!(directory.exists());drop(fork);assert!(!directory.exists(),"fork assets must clean up");
    54	 let mut c=security::challenges::Campaign::default();security::challenges::operations(&b,&fixture,&mut c);
    55	 assert!(c.sequences>0,"{c:?}");assert!(c.operations.contains_key("inspect"));
    56	 assert!(c.violations.iter().any(|v|v.viewer=="dev:fixture-only"&&v.history.iter().any(|s|s.operation=="demote")),"{c:?}");
    57	 assert!(!c.unsupported.iter().any(|s|s.contains("maintained aggregate; write")||s.contains("E_RECORDED_FIELD")),"{c:?}");
    58	 assert_eq!(fixture.store().rows("reports").unwrap(),before);assert_eq!(fixture.store().rows("reportTotal").unwrap(),derived);
    59	}
