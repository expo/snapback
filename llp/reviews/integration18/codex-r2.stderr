    62	  deadline(graceMs, 5000);
    63	  if (child && "url" in child && typeof child.url === "string" && typeof child.stop === "function") {
    64	    await bounded(Promise.resolve().then(() => child.stop()), graceMs + 5000, "host stop"); return;
    65	  }
    66	  if (!child || !("kill" in child) || typeof child.kill !== "function" || typeof child.once !== "function"
