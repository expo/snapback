   106	#[cfg(unix)]
   107	fn socket_entry(path: &Path) -> io::Result<fs::Metadata> {
   108	    let m = fs::symlink_metadata(path)?;
   109	    if !m.file_type().is_socket()
   110	        || m.uid() != unsafe { libc::geteuid() }
   111	        || m.permissions().mode() & 0o7777 != 0o600
   112	    {
   113	        return Err(io::Error::other(
   114	            "release control must be a same-owner 0600 socket, never a symlink or regular file",
   115	        ));
   116	    }
   117	    Ok(m)
   118	}
