    10	fn files(root: &Path, path: &Path, out: &mut Vec<PathBuf>) -> Result<(), String> {
    11	    let mut entries = fs::read_dir(path)
    12	        .map_err(|e| e.to_string())?
    13	        .map(|e| e.map(|e| e.path()).map_err(|e| e.to_string()))
    14	        .collect::<Result<Vec<_>, _>>()?;
    15	    entries.sort();
    16	    for path in entries {
    17	        let relative = path.strip_prefix(root).map_err(|e| e.to_string())?;
    18	        if relative
    19	            .components()
    20	            .next()
    21	            .is_some_and(|c| c.as_os_str() == ".snapback4")
    22	        {
    23	            continue;
    24	        }
    25	        let m = fs::symlink_metadata(&path).map_err(|e| e.to_string())?;
    26	        if m.is_dir() {
    27	            files(root, &path, out)?;
    28	        } else if m.is_file() {
    29	            out.push(path);
    30	        } else {
    31	            return Err(format!(
    32	                "immutable release artifact must be a real directory or regular file: {}",
    33	                path.display()
    34	            ));
    35	        }
    36	    }
    37	    Ok(())
    38	}
    39	pub(crate) fn digest(root: &Path) -> Result<String, String> {
    40	    bundle_digest(root, false)
    41	}
    42	pub(crate) fn executable_digest(root: &Path) -> Result<String, String> {
    43	    bundle_digest(root, true)
    44	}
    45	fn bundle_digest(root: &Path, executable: bool) -> Result<String, String> {
    46	    let mut paths = Vec::new();
    47	    files(root, root, &mut paths)?;
    48	    let mut hash = Sha256::new();
    49	    for path in paths {
    50	        let name = path.strip_prefix(root).unwrap().to_string_lossy();
    51	        // @ref LLP 3000.000.000.000.000#4-cli-surface-contracts — metadata does not change executable release identity.
    52	        if name == ".pending-adoption" || name == "provenance.json" {continue;}
    53	        // @ref LLP 3000.000.000#16-release-reactivation-and-rollback-foresight-rel5 — the compiler version in this report is not executable content.
    54	        // Keep the full report in control-request integrity; only release identity
    55	        // ignores it. Activation recompiles and checks the retained source normally.
    56	        if executable && name == "device-compatibility.json" {continue;}
    57	        hash.update((name.len() as u64).to_le_bytes());
    58	        hash.update(name.as_bytes());
    59	        #[cfg(unix)]
    60	        use std::os::unix::fs::OpenOptionsExt;
    61	        let mut options = fs::OpenOptions::new();
    62	        options.read(true);
    63	        #[cfg(unix)]
    64	        options.custom_flags(libc::O_NOFOLLOW);
    65	        let mut file = options.open(&path).map_err(|e| e.to_string())?;
    66	        hash.update(
    67	            file.metadata()
    68	                .map_err(|e| e.to_string())?
    69	                .len()
    70	                .to_le_bytes(),
    71	        );
    72	        let mut buffer = [0u8; 16384];
    73	        loop {
    74	            let n = file.read(&mut buffer).map_err(|e| e.to_string())?;
    75	            if n == 0 {
    76	                break;
    77	            }
    78	            hash.update(&buffer[..n]);
    79	        }
    80	    }
    81	    Ok(format!("{:x}", hash.finalize()))
    82	}
    83	pub(crate) fn durable(root: &Path) -> Result<(), String> {
    84	    let mut paths = Vec::new();
    85	    files(root, root, &mut paths)?;
    86	    for path in paths {
    87	        fs::File::open(path)
    88	            .and_then(|f| f.sync_all())
    89	            .map_err(|e| e.to_string())?;
    90	    }
    91	    fn dirs(path: &Path) -> Result<(), String> {
    92	        for e in fs::read_dir(path).map_err(|e| e.to_string())? {
    93	            let e = e.map_err(|e| e.to_string())?;
    94	            if e.file_type().map_err(|e| e.to_string())?.is_dir() {
    95	                dirs(&e.path())?;
    96	            }
    97	        }
    98	        fs::File::open(path)
    99	            .and_then(|f| f.sync_all())
   100	            .map_err(|e| e.to_string())
   101	    }
   102	    dirs(root)
   103	}
