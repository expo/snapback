    69	#[test]
    70	fn future_policy_probes_are_not_live_and_authored_deletes_are_checked(){
    71	 let source="table bans:\n  principal: principal\n  starts: time\n  unique principal\n  not before .starts\n  read <- allow\n  online only\ntable notes:\n  body: text <=80\n  read <- not exists bans[viewer]\n  delete <- allow\n  online only\ninvariant notes.body read only not exists bans[viewer]\ninvariant notes.delete only viewer = 'service:ops'\nquery inspect(note: notes):\n  return notes[note]\nmutation remove(note: notes):\n  delete notes[note]\n  return null\n";
    72	 let b=compile(&[("schema.q".into(),source.into())]);assert!(b.diagnostics.is_empty(),"{:?}",b.diagnostics);
    73	 let now=1_800_000_000_000;let mut fixture=Engine::new_at(snapback4_core::Store::memory().unwrap(),b.schema.clone(),b.programs.iter().map(|p|p.program.clone()),now).unwrap();
    74	 fixture.seed_at([("notes".into(),row(&[("id",Value::Id("n".into())),("body",Value::String("secret".into()))])),("bans".into(),row(&[("id",Value::Id("b".into())),("principal",Value::Id("dev:fixture-only".into())),("starts",Value::Int(now+100_000))]))],now).unwrap();
    75	 let mut c=security::challenges::Campaign::default();security::challenges::operations(&b,&fixture,&mut c);
    76	 assert!(!c.violations.iter().any(|v|v.effect=="column read observation"),"{c:?}");
    77	 assert!(c.violations.iter().any(|v|v.effect=="delete"&&v.reachability==security::challenges::Reachability::AuthoredFixtureTrace),"{c:?}");
    78	}
