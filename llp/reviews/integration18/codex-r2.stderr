//! The host owns its declared workers and only stops the children it started.
use crate::{
    project::Project,
    serve::{Shared, lock},
};
use sha2::{Digest, Sha256};
use snapback4_core::{RuntimeError, Store, identity};
use std::{
    path::PathBuf,
    process::{Child, Command, Stdio},
    sync::Arc,
    time::{Duration, Instant},
};

#[path = "worker_environment.rs"]
mod environment;
pub(crate) use environment::validate_environment;
#[path = "worker_declarations.rs"]
mod declarations;
#[path = "worker_process.rs"]
pub(crate) mod process;
pub(crate) use declarations::{package, package_entry, link_dependencies, private_scope};
pub(crate) fn declared(
    project: &Project,
) -> Result<std::collections::BTreeMap<String, PathBuf>, String> {
    declarations::declared(project)
}

// @ref LLP 3000.000.000#5-hot-activation-and-ownership — static worker prerequisites precede activation; spawn remains recoverable post-commit work.
pub(crate) fn prepare_release(
    project: &Project,
    schema: &snapback4_core::schema::Schema,
) -> Result<(), String> {
    let entries = declared(project)?;
    if entries.is_empty() {
        return Ok(());
    }
    let secrets=environment::values(schema)?;
    let version = command(&node())
        .arg("--version")
        .output()
        .map_err(|e| e.to_string())?;
    if !version.status.success()
        || !String::from_utf8_lossy(&version.stdout)
            .trim()
            .starts_with("v24.")
    {
        return Err("release workers require Node 24; select SNAPBACK_NODE before serving".into());
    }
    for name in entries.keys() {
        let prepared = declarations::Snapshot::new(project, name)?;
        environment::for_entry(&prepared.entry,&secrets).map_err(|error|format!("worker {name}: {error}; remove the selection or declare the secret in an action/effect/route, then `snapback4 deploy <dir>`"))?;
    }
    Ok(())
}

const CHILD_WINDOW: Duration = Duration::from_secs(24 * 60 * 60);

// Called only while the host holds the store's deployment lock. A previous
// supervisor cannot still own this store; revoke its child's whole refresh
// family, including an orphan left behind by SIGKILL. Manual seats survive.
pub(crate) fn clear_child_session(store: &Store) -> Result<(), RuntimeError> {
    let tx = store.conn().unchecked_transaction()?;
    tx.execute("DELETE FROM _sessions WHERE principal = 'service:worker' AND COALESCE(family, token_digest) = (SELECT value FROM _meta WHERE key = 'worker:session-family')", [])?;
    tx.execute(
        "DELETE FROM _meta WHERE key IN ('worker:session-family', 'worker:session-revision')",
        [],
    )?;
