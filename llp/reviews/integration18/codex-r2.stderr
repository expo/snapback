   212	#[cfg(test)]
   213	mod candidate_tests {
   214	    use super::*;
   215	    #[test]
   216	    fn cleanup_removes_only_definitively_uncommitted_candidates() {
   217	        let root=std::env::temp_dir().join(format!("sb4-candidate-custody-{}-{}",std::process::id(),snapback4_core::now_ms()));
   218	        fs::create_dir_all(root.join("releases")).unwrap();
   219	        struct Cleanup(PathBuf);
   220	        impl Drop for Cleanup {fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}}
   221	        let _cleanup=Cleanup(root.clone());
   222	        let store=snapback4_core::Store::open(&root.join("store.sqlite")).unwrap();
   223	        store.conn().execute_batch("CREATE TABLE _release_events(release INTEGER,previous INTEGER)").unwrap();
   224	        for n in 1..=3 {fs::create_dir(root.join("releases").join(n.to_string())).unwrap();}
   225	        drop(Candidate::new(&root,1));
   226	        assert!(!root.join("releases/1").exists());
   227	        // A server may commit after this history read. No observed row is not a completed refusal.
   228	        let mut flight=Candidate::new(&root,2);flight.pending=true;drop(flight);
   229	        assert!(root.join("releases/2").is_dir());
   230	        store.conn().execute("INSERT INTO _release_events VALUES(3,NULL)",[]).unwrap();
   231	        drop(Candidate::new(&root,3));
   232	        assert!(root.join("releases/3").is_dir());
   233	    }
   234	}
