    41	/** @throws deadline expires; work rejection propagates. */
    42	export async function bounded<T>(work: Promise<T>, ms: number, label: string): Promise<T> {
    43	  let timer: ReturnType<typeof setTimeout> | undefined;
    44	  try {
    45	    return await Promise.race([work, new Promise<never>((_, reject) => {
    46	      timer = setTimeout(() => reject(Error(`${label} timed out after ${ms} ms`)), ms);
    47	    })]);
    48	  } finally { clearTimeout(timer); }
