   189	// @ref LLP 3000.000.000#16-release-reactivation-and-rollback-foresight-rel5 — deletion requires a definitive non-commit, never a lost reply.
   190	pub(crate) struct Candidate { dir: PathBuf, release: u64, pub committed: bool, pub pending: bool }
   191	impl Candidate {
   192	    pub(crate) fn new(dir: &Path, release: u64) -> Self { Self {dir:dir.into(),release,committed:false,pending:false} }
   193	}
   194	impl Drop for Candidate {
   195	    fn drop(&mut self) {
   196	        if self.committed { return; }
   197	        if self.pending {eprintln!("release {} result remains unknown; retained source while the server may still commit; inspect releases",self.release);return;}
   198	        let probe=(|| -> Result<bool,String> {
   199	            let store=snapback4_core::Store::open_read_only(&self.dir.join("store.sqlite")).map_err(|e|e.to_string())?;
   200	            let history:bool=store.conn().query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE type='table' AND name='_release_events')",[],|r|r.get(0)).map_err(|e|e.to_string())?;
   201	            if !history {return Ok(false);}
   202	            store.conn().query_row("SELECT EXISTS(SELECT 1 FROM _release_events WHERE release=?1 OR previous=?1)",[self.release as i64],|r|r.get(0)).map_err(|e|e.to_string())
   203	        })();
   204	        match probe {
   205	            Ok(false)=>if let Err(e)=fs::remove_dir_all(self.dir.join("releases").join(self.release.to_string())) {eprintln!("uncommitted release {} cleanup failed: {e}",self.release);},
   206	            Ok(true)=>{},
   207	            Err(e)=>eprintln!("release {} outcome unknown; retained source for recovery; inspect releases: {e}",self.release),
   208	        }
   209	    }
   210	}
