   105	pub(crate) fn link_store(root: &Path) -> Result<(), String> {
   106	    let project = crate::project::Project { root: root.into() };
   107	    snapback4_core::private_fs::directory(&project.data_dir()).map_err(|e| e.to_string())?;
   108	    let path = project.store_path();
   109	    #[cfg(unix)]
   110	    {
   111	        let target = Path::new("../../../store.sqlite");
   112	        match fs::symlink_metadata(&path) {
   113	            Ok(m) if m.file_type().is_symlink() => {
   114	                if fs::read_link(&path).map_err(|e| e.to_string())? != target {
   115	                    fs::remove_file(&path).map_err(|e| e.to_string())?;
   116	                    std::os::unix::fs::symlink(target, &path).map_err(|e| e.to_string())?;
   117	                }
   118	            }
   119	            Ok(_) => {
   120	                return Err(format!(
   121	                    "release store path must be a symbolic link: {}",
   122	                    path.display()
   123	                ));
   124	            }
   125	            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
   126	                std::os::unix::fs::symlink(target, &path).map_err(|e| e.to_string())?
   127	            }
   128	            Err(e) => return Err(e.to_string()),
   129	        }
   130	        Ok(())
   131	    }
   132	    #[cfg(not(unix))]
   133	    Err("serving shared releases requires Unix symbolic links".into())
