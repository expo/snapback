   121	        if name.is_empty() || name.len() > 64 || !name.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_')) {
   122	            return Err(io::Error::other(format!("worker {name}: use 1–64 ASCII letters, digits, '-' or '_' for the service name")));
   123	        }
   124	        if workers.insert(name.clone(), stage.unwrap_or(&project.root).join("snapback/workers").join(path)).is_some() { return Err(io::Error::other(format!("worker {name}: declare only one entry extension"))); }
   125	        Ok(())
   126	    }).map_err(|e| format!("workers: {e}"))?;
