   179	export function testSource(source: string, options: TestSourceOptions = {}): Promise<TestSourceResult> {
   180	  if (typeof source !== "string" || !source) throw Error(`proof testSource requires an explicit saved source file or directory; got ${JSON.stringify(source) ?? String(source)}: pass versions/v1`);
   181	  const { fixtureOnly = false, ...proofOptions } = options;
   182	  return successful(["test", "--source", source, ...(fixtureOnly ? ["--fixture-only"] : []), ...(proofOptions.args ?? [])], proofOptions).then(result => {
