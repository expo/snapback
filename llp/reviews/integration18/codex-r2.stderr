   236	#[cfg(test)]
   237	mod identity_tests {
   238	    use super::*;
   239	    #[test]
   240	    fn compiler_reports_do_not_change_release_identity_but_remain_integrity_bound() {
   241	        struct Scratch(PathBuf);
   242	        impl Drop for Scratch { fn drop(&mut self) {let _=fs::remove_dir_all(&self.0);} }
   243	        let id=snapback4_core::ids::mint(snapback4_core::now_ms(),&mut snapback4_core::ids::Mint::default()).unwrap();
   244	        let root=Scratch(std::env::temp_dir().join(format!("sb4-release-identity-{id}")));
   245	        let a=root.0.join("old");let b=root.0.join("new");
   246	        for dir in [&a,&b] {
   247	            fs::create_dir_all(dir.join("snapback")).unwrap();
   248	            fs::write(dir.join("snapback/schema.q"),"query q():\n  return 1\n").unwrap();
   249	        }
   250	        fs::write(a.join("device-compatibility.json"),r#"{"server_version":"0.4.33"}"#).unwrap();
   251	        fs::write(b.join("device-compatibility.json"),r#"{"server_version":"0.4.34"}"#).unwrap();
   252	        assert_eq!(executable_digest(&a).unwrap(),executable_digest(&b).unwrap());
   253	        assert_ne!(digest(&a).unwrap(),digest(&b).unwrap(),"control integrity still covers the captured report");
   254	        for file in ["snapback/schema.q","snapback/generated/native.wasm","worker.mjs"] {
   255	            let path=b.join(file);fs::create_dir_all(path.parent().unwrap()).unwrap();fs::write(&path,b"changed executable").unwrap();
   256	            assert_ne!(executable_digest(&a).unwrap(),executable_digest(&b).unwrap(),"{file}");
   257	            if file=="snapback/schema.q" {fs::write(path,"query q():\n  return 1\n").unwrap();}else{fs::remove_file(path).unwrap();}
   258	        }
   259	    }
   260	}

