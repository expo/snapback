    15	impl ReleaseActivation {
    16	    pub fn new(release: u64, expected_previous: Option<u64>) -> Self {
    17	        Self {
    18	            release,
    19	            expected_previous,
    20	            expected_revision: None,
    21	            restore_dormant: true,
    22	            native_digest: None,
    23	            operation: "activate".into(),
    24	        }
