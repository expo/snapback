    50	/** Attempts every cleanup, even if a preceding step fails or stalls. */
    51	/** @throws AggregateError after every cleanup was attempted; each step has a 10-second bound. */
    52	export async function cleanup(...steps: Array<(() => unknown | Promise<unknown>) | undefined>): Promise<void> {
    53	  const errors: unknown[] = [];
    54	  for (const step of steps) if (step) {
    55	    try { await bounded(Promise.resolve().then(step), 10_000, "proof cleanup"); }
    56	    catch (error) { errors.push(error); }
    57	  }
    58	  if (errors.length) throw new AggregateError(errors, "proof cleanup failed");
    59	}
    60	/** @throws invalid handle/deadline, host stop failure or TERM/KILL reap deadline. */
