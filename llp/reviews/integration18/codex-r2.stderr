   105	fn collect(project: &Project, stage: Option<&Path>, link_dependencies: bool) -> Result<BTreeMap<String, PathBuf>, String> {
   106	    let mut workers = BTreeMap::new();
   107	    let Some(dir) = root(project).map_err(|e| format!("workers: {e}"))? else { return Ok(workers); };
   108	    let source_root = project.root.join("snapback/workers");
   109	    let target_root = stage.map(|stage| stage.join("snapback/workers"));
   110	    let dependencies = target_root.as_deref().filter(|_| link_dependencies).map(|target| (source_root.as_path(), target));
   111	    walk(&dir, Path::new(""), dependencies, &mut |path, source| {
   112	        if let Some(stage) = stage {
   113	            let target = stage.join("snapback/workers").join(path);
   114	            std::fs::create_dir_all(target.parent().unwrap())?;
   115	            let mut output = File::options().write(true).create_new(true).open(target)?;
   116	            io::copy(source, &mut output)?;
   117	            output.set_permissions(source.metadata()?.permissions())?;
   118	        }
   119	        if path.components().count() != 1 || !matches!(path.extension().and_then(|s| s.to_str()), Some("mjs" | "mts" | "ts")) { return Ok(()); }
