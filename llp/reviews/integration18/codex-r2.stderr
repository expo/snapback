    94	#[test]
    95	fn aliases_defaults_and_deprecated_inputs_preserve_column_challenges_and_audit() {
    96	 // @ref LLP 3000.036.004#121-column-read-intent — compatibility forms keep the same disclosure obligations.
    97	 for fixed in [false, true] {
    98	  let source = SOURCE.replace("invariant reports.read only", "invariant reports.body read only")
    99	   .replace("query inspect(report: reports):", "query inspect(report: reports, enabled: bool default true, old: text <=20 deprecated):")
   100	   .replace("  return reports[report]", "  require enabled else DISABLED\n  return reports[report]")
   101	   + "alias legacyInspect = inspect\n";
   102	  let source = if fixed { source.replace("read <- exists grants[viewer]", "read <- exists grants[viewer] and exists roles[viewer, role = 'inspector']") } else { source };
   103	  let b=compile(&[("schema.q".into(), source)]);assert!(b.diagnostics.is_empty(),"{:?}",b.diagnostics);
   104	  let report=security::analyze(&b);
   105	  let exposure=report.exposures.iter().find(|e|e.table=="reports").unwrap();
   106	  for name in ["inspect (query)", "legacyInspect (query)"] { assert!(exposure.operations.iter().any(|op|op==name),"{exposure:?}"); }
   107	  let now=1_800_000_000_000;
   108	  let mut fixture=Engine::new_at(snapback4_core::Store::memory().unwrap(),b.schema.clone(),b.programs.iter().map(|p|p.program.clone()),now).unwrap();
   109	  fixture.seed_at([
   110	   ("roles".into(),row(&[("id",Value::Id("role".into())),("principal",Value::Id("dev:fixture-only".into())),("role",Value::String("inspector".into()))])),
   111	   ("grants".into(),row(&[("id",Value::Id("grant".into())),("principal",Value::Id("dev:fixture-only".into()))])),
   112	   ("reports".into(),row(&[("id",Value::Id("report".into())),("body",Value::String("private".into()))]))
   113	  ],now).unwrap();
   114	  let mut campaign=security::challenges::Campaign::default();security::challenges::operations(&b,&fixture,&mut campaign);
   115	  for name in ["inspect", "legacyInspect"] {assert!(campaign.operations.contains_key(name),"{campaign:?}");}
   116	  assert_eq!(campaign.violations.is_empty(),fixed,"{campaign:?}");
   117	  let args=std::collections::BTreeMap::from([("report".into(),Value::Id("report".into())),("old".into(),Value::String("old caller".into()))]);
   118	  let mut context=snapback4_core::Context::new("dev:fixture-only",args);context.now=Some(now);
   119	  let demote=std::collections::BTreeMap::from([("who".into(),Value::Id("dev:fixture-only".into()))]);
   120	  let mut operator=snapback4_core::Context::new("service:ops",demote);operator.now=Some(now);
   121	  fixture.mutate("demote",None,operator).unwrap();
   122	  for name in ["inspect", "legacyInspect"] {
   123	   let observed=fixture.query(name,context.clone()).unwrap();
   124	   assert_eq!(observed.data==Value::Null,fixed,"{name}: {observed:?}");
   125	  }
   126	 }
   127	}
