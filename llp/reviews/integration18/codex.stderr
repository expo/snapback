 -        Expr::Literal(value) => value != &Value::Null,
 -        Expr::Input(Input::Viewer | Input::Now | Input::NewId | Input::ReadTime) => true,
 -        Expr::Variable(name) => bound.program.args.get(name).is_some_and(|ty| !ty.is_optional()),
 -        _ => false,
 -    }
 -}
