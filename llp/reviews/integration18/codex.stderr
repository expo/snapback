 -            let live=if &text[start..end]=="$readThroughLive" {" live"}else{""};
 -            let spelled = format!("read through{live} .{reference}");
 -            text.replace_range(start..end + close + 1, &spelled);
 -            from = start + spelled.len();
 -        } else {
 -            text.remove(start);
 -            from = start;
 -        }
 -    }
 -    text
 -}
