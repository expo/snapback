 -    if position < scan.prefix.len() { return scan.prefix[position].scalar(); }
 -    if position == scan.prefix.len() && let Some(range) = &scan.range
 -        && range.gt.is_none() && range.lt.is_none() && range.gte == range.lte {
 -        return range.gte.as_deref();
 -    }
 -    None
 -}
