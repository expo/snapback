//! The host owns its declared workers and only stops the children it started.
use crate::{
    project::Project,
    serve::{Shared, lock},
};
use sha2::{Digest, Sha256};
use snapback4_core::{RuntimeError, Store, identity};
use std::{
    path::PathBuf,
    process::{Child, Command, Stdio},
    sync::Arc,
    time::{Duration, Instant},
};

#[path = "worker_environment.rs"]
mod environment;
pub(crate) use environment::validate_environment;
#[path = "worker_declarations.rs"]
mod declarations;
#[path = "worker_process.rs"]
pub(crate) mod process;
pub(crate) use declarations::{package, package_entry, link_dependencies, private_scope};
pub(crate) fn declared(
    project: &Project,
) -> Result<std::collections::BTreeMap<String, PathBuf>, String> {
    declarations::declared(project)
}

// @ref LLP 3000.000.000#5-hot-activation-and-ownership — static worker prerequisites precede activation; spawn remains recoverable post-commit work.
pub(crate) fn prepare_release(
    project: &Project,
    schema: &snapback4_core::schema::Schema,
) -> Result<(), String> {
    let entries = declared(project)?;
    if entries.is_empty() {
        return Ok(());
    }
    let secrets=environment::values(schema)?;
    let version = command(&node())
        .arg("--version")
        .output()
        .map_err(|e| e.to_string())?;
    if !version.status.success()
        || !String::from_utf8_lossy(&version.stdout)
            .trim()
            .starts_with("v24.")
    {
        return Err("release workers require Node 24; select SNAPBACK_NODE before serving".into());
    }
    for name in entries.keys() {
        let prepared = declarations::Snapshot::new(project, name)?;
        environment::for_entry(&prepared.entry,&secrets).map_err(|error|format!("worker {name}: {error}; remove the selection or declare the secret in an action/effect/route, then `snapback4 deploy <dir>`"))?;
    }
    Ok(())
}

const CHILD_WINDOW: Duration = Duration::from_secs(24 * 60 * 60);

// Called only while the host holds the store's deployment lock. A previous
// supervisor cannot still own this store; revoke its child's whole refresh
// family, including an orphan left behind by SIGKILL. Manual seats survive.
pub(crate) fn clear_child_session(store: &Store) -> Result<(), RuntimeError> {
    let tx = store.conn().unchecked_transaction()?;
    tx.execute("DELETE FROM _sessions WHERE principal = 'service:worker' AND COALESCE(family, token_digest) = (SELECT value FROM _meta WHERE key = 'worker:session-family')", [])?;
    tx.execute(
        "DELETE FROM _meta WHERE key IN ('worker:session-family', 'worker:session-revision')",
        [],
    )?;
    tx.execute("DELETE FROM _sessions WHERE COALESCE(family, token_digest) IN (SELECT substr(key, 15) FROM _meta WHERE key LIKE 'worker:family:%')", [])?;
    tx.execute("DELETE FROM _meta WHERE key LIKE 'worker:family:%'", [])?;
    // The next supervisor owns fresh reports; a removed declaration must not
    // inherit a running row from the host whose credentials just retired.
    tx.execute(
        "DELETE FROM _meta WHERE key = 'worker:status' OR key LIKE 'worker:status:%'",
        [],
    )?;
    tx.commit()?;
    Ok(())
}

pub(crate) fn child_session(
    store: &Store,
    now: i64,
    revision: usize,
) -> Result<identity::Session, RuntimeError> {
    // Credential and ownership marker commit together, so a crash cannot
    // strand a credential that the next supervisor cannot identify.
    let tx = store.conn().unchecked_transaction()?;
    let session = identity::service_session(store, "worker", now, 1)?;
    let digest = format!("{:x}", Sha256::digest(session.token.as_bytes()));
    store.set_meta("worker:session-family", &digest)?;
    store.set_meta("worker:session-revision", &revision.to_string())?;
    tx.commit()?;
    Ok(session)
}

pub(crate) fn source(project: &Project) -> Option<PathBuf> {
    server_source(project).or_else(|| {
        [
            "snapback/worker.ts",
            "snapback/worker.mts",
            "snapback/worker.mjs",
        ]
        .into_iter()
        .map(|p| project.root.join(p))
        .find(|p| p.is_file())
    })
}

pub(crate) fn server_source(project: &Project) -> Option<PathBuf> {
    project.server_source()
}

pub(crate) fn node() -> PathBuf {
    crate::project::node()
}

// @ref LLP 3000.019#3.6 — worker status and revocation may wait for adoption; HTTP admission must not.
pub(crate) struct Supervisor {
    stop: Arc<std::sync::atomic::AtomicBool>,
    thread: Option<std::thread::JoinHandle<()>>,
}

impl Supervisor {
    #[cfg(test)]
    pub(crate) fn idle_for_test() -> Self {
        Self { stop: Arc::new(std::sync::atomic::AtomicBool::new(false)), thread: None }
    }

    pub(crate) fn start(
        mut project: Project,
        shared: Arc<Shared>,
        url: String,
        dev: bool,
        mut worker: Option<DevWorker>,
    ) -> Result<Self, String> {
        let mut named = Self::named(&project, &shared, &url, dev)?;
        let mut pending = std::collections::BTreeMap::new();
        let stop = Arc::new(std::sync::atomic::AtomicBool::new(false));
        let stopping = stop.clone();
        let mut revision = shared
            .worker_revision
            .load(std::sync::atomic::Ordering::Acquire);
        let thread = crate::lifecycle::background("worker", move || {
            // This thread owns DevWorker, including its durable revocation and
            // child cleanup on every return or unwind. The host joins it on exit.
            while !stopping.load(std::sync::atomic::Ordering::Acquire)
                && !crate::lifecycle::stopping()
            {
                let next = shared
                    .worker_revision
                    .load(std::sync::atomic::Ordering::Acquire);
                let changed = next != revision;
                if !dev && changed {
                    if let Some(root) = lock(&shared.release_root).clone() {
                        project.root = root;
                    }
                }
                if changed {
                    revision = next;
                    match declared(&project) {
                        Ok(entries) => {
                            pending.retain(|name, _| entries.contains_key(name));
                            for (name, worker) in &mut named {
                                worker.retiring = !entries.contains_key(name);
                                if worker.retiring {
                                    worker.begin_stop();
                                }
                            }
                            for (name, source) in entries {
                                if let Some(worker) = named.get_mut(&name) {
                                    worker.source = source;
                                    worker.project = Project {
                                        root: project.root.clone(),
                                    };
                                } else {
                                    match DevWorker::start_named(
                                        &project,
                                        shared.clone(),
                                        url.clone(),
                                        source,
                                        !dev,
                                        name.clone(),
                                    ) {
                                        Ok(worker) => {
                                            named.insert(name, worker);
                                        }
                                        Err(error) => {
                                            snapback4_core::diagnostic!(
                                                "snapback4 worker: {error}; declaration will retry"
                                            );
                                            pending.insert(
                                                name,
                                                (
                                                    Instant::now() + Duration::from_millis(250),
                                                    Duration::from_millis(250),
                                                ),
                                            );
                                        }
                                    }
                                }
                            }
                        }
                        Err(error) => snapback4_core::diagnostic!("snapback4 worker: {error}"),
                    }
                }
                if worker.is_none() && changed {
                    match DevWorker::start(&project, shared.clone(), url.clone()) {
                        Ok(next) => worker = next,
                        Err(error) => snapback4_core::diagnostic!("snapback4 worker: {error}"),
//! Native jobs on disk (LLP 3000.005): `snapback/native/` is the app's
//! crate; `check` builds it to `snapback/generated/native.wasm` and writes
//! the schema's Rust types beside it; every verb that opens an engine
//! installs the module and checks the declared jobs against it.

use crate::project::Project;
use snapback4_core::Engine;
use snapback4_lang::Bound;
use std::collections::BTreeSet;
use std::path::PathBuf;
use std::process::Command;
use std::time::Instant;

/// A refusal in the diagnostic's shape: code, message, the line to paste.
#[derive(Debug)]
pub struct Problem {
    pub code: &'static str,
    pub message: String,
    pub rewrite: String,
}

impl std::fmt::Display for Problem {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(
            f,
            "{}: {}\n  rewrite: {}\n  guide: native",
            self.code, self.message, self.rewrite
        )
    }
}

const TARGET: &str = "wasm32-unknown-unknown";

/// What `check` says about the native module once built.
pub struct Built {
    pub path: PathBuf,
    pub bytes: u64,
    pub jobs: Vec<String>,
    pub ms: u128,
}

/// The native programs the schema declares: jobs and reads.
pub fn declared(bound: &Bound) -> Vec<String> {
    bound
        .programs
        .iter()
        .filter(|p| p.program.native)
        .map(|p| p.program.name.clone())
        .collect()
}

fn declared_of(bound: &Bound, kind: snapback4_core::ProgramKind) -> Vec<String> {
    bound
        .programs
        .iter()
        .filter(|p| p.program.native && p.program.kind == kind)
        .map(|p| p.program.name.clone())
        .collect()
}

/// The module as the server serves it (`GET /native.wasm`) and names it in
/// `GET /schema`: its bytes, their digest, what it implements.
#[derive(Clone, Debug)]
pub struct Installed {
    pub bytes: Vec<u8>,
    pub digest: String,
    pub jobs: Vec<String>,
    pub reads: Vec<String>,
}

pub(crate) struct Prepared {
    pub module: Option<std::sync::Arc<snapback4_core::engine::native::Module>>,
    pub installed: Option<Installed>,
}

// @ref LLP 3000.000.000#5-hot-activation-and-ownership — compile and validate exact module bytes before committing a release.
pub(crate) fn prepare(project: &Project, bound: &Bound) -> Result<Prepared, Problem> {
    let jobs = declared_of(bound, snapback4_core::ProgramKind::Job);
    let reads = declared_of(bound, snapback4_core::ProgramKind::Query);
    if jobs.is_empty() && reads.is_empty() {
        return Ok(Prepared {
            module: None,
            installed: None,
        });
    }
    let path = project.native_module();
    snapback4_core::private_fs::existing_file(&path).map_err(|e| Problem {
        code: "E_NATIVE",
        message: format!("{}: {e}", path.display()),
        rewrite: "snapback4 check, then deploy the built native module".into(),
    })?;
    let bytes = std::fs::read(&path).map_err(|e| Problem {
        code: "E_NATIVE",
        message: e.to_string(),
        rewrite: "snapback4 check".into(),
    })?;
    let module = snapback4_core::engine::native::Module::compile(&bytes).map_err(|e| Problem {
        code: "E_NATIVE",
        message: e.to_string(),
        rewrite: "snapback4 check".into(),
    })?;
    check_implemented(&jobs, &reads, &module)?;
    let installed = Installed {
        digest: digest(&bytes),
        jobs: module.jobs().to_vec(),
        reads: module.reads().to_vec(),
        bytes,
    };
    Ok(Prepared {
        module: Some(std::sync::Arc::new(module)),
        installed: Some(installed),
    })
}

pub fn digest(bytes: &[u8]) -> String {
    use sha2::Digest;
    let hash = sha2::Sha256::digest(bytes);
    hash.iter().map(|b| format!("{b:02x}")).collect()
}

/// Every declared native job is one the module implements, and every
/// declared native read likewise; the message names the first that is not.
fn check_implemented(
    declared_jobs: &[String],
    declared_reads: &[String],
    module: &snapback4_core::engine::native::Module,
) -> Result<(), Problem> {
    let rewrite = format!(
        "snapback4_native::module! {{ jobs: [{}], reads: [{}] }}  -- in snapback/native/src/lib.rs",
        declared_jobs.join(", "),
        declared_reads.join(", ")
    );
    if let Some(missing) = declared_jobs
        .iter()
        .find(|job| !module.jobs().contains(job))
    {
        return Err(Problem {
            code: "E_NATIVE",
            message: format!(
                "job {missing} is declared native but the module implements {}",
                if module.jobs().is_empty() {
                    "no jobs".to_owned()
                } else {
                    format!("only {}", module.jobs().join(", "))
                }
            ),
            rewrite: format!(
