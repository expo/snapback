#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$root" ] || [ ! -f "$root/scripts/drift-prone-gates.mjs" ] \
  || [ ! -f "$root/scripts/check-visibility-governance.mjs" ]; then
  printf '[snapback-drift] REFUSED: repository root or drift gate runner is unavailable\n' >&2
  exit 2
fi

updates_file="$(mktemp "${TMPDIR:-/tmp}/snapback-pre-push-updates.XXXXXX")"
trap 'rm -f "$updates_file"' EXIT HUP INT TERM
tee "$updates_file" >/dev/null

pinned_node="$(tr -d '[:space:]' < "$root/.node-version")"
running_node="$(node -v 2>/dev/null || true)"
if [ "${running_node#v}" != "$pinned_node" ]; then
  volta_node_bin="${HOME:-}/.volta/tools/image/node/$pinned_node/bin"
  if [ -n "${HOME:-}" ] && [ -x "$volta_node_bin/node" ]; then
    PATH="$volta_node_bin:$PATH"
    export PATH
  elif command -v volta >/dev/null 2>&1; then
    resolved_node="$(volta run --node "$pinned_node" sh -c 'command -v node' 2>/dev/null || true)"
    if [ -n "$resolved_node" ] && [ -x "$resolved_node" ]; then
      PATH="$(dirname "$resolved_node"):$PATH"
      export PATH
    else
      printf '[snapback-drift] WARNING: could not resolve pinned Node %s via volta; using ambient %s\n' \
        "$pinned_node" "${running_node:-unavailable}" >&2
    fi
  else
    printf '[snapback-drift] WARNING: pinned Node %s is unavailable; using ambient %s\n' \
      "$pinned_node" "${running_node:-unavailable}" >&2
  fi
fi

# @ref LLP 0234#d3--widening-requires-a-remotely-prior-artifact-closed-approval-receipt
# the visibility-governance class observes the legacy drift bypass spelling but
# never treats it as authority; it still compares Git's exact advertised
# predecessor for every ref.
node "$root/scripts/check-visibility-governance.mjs" pre-push --root "$root" < "$updates_file"

# @ref LLP 0232#optimistic-landing-default-2026-08-13 — the tracked hook
# always delegates Git's exact ref-update stream for selection; ordinary
# pushes defer execution and SNAPBACK_DRIFT_GATES_STRICT=1 enforces it now.
node "$root/scripts/drift-prone-gates.mjs" pre-push --remote "$1" < "$updates_file"
