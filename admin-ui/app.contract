// Snapback admin — Contract console.
//
// A system app over the headless admin contract (/_snapback/api/*), authored in
// Contract and statically built (admin-ui/build.mjs + LLP 0017). App-shell
// layout: a fixed sidebar (brand, nav) beside a scrolling content pane. The
// single inspect read is a one-row collection, so the body
// renders inside `each s in rows`; all formatting lives in admin-boundary.mjs's
// `data.ui.*` view model — the template only reads flat, statically-named fields.
//
// @ref LLP 0017#console-surfaces — the console composes the headless admin
//   contract into views; the contract, not this file, is the source of truth.

use inspect from "./generated/contract/inspect.query.ts"
use refresh from "./generated/contract/refresh.mutation.ts"
use tableScan from "./generated/contract/tableScan.query.ts"
use loadTable from "./generated/contract/loadTable.mutation.ts"
use runResult from "./generated/contract/runResult.query.ts"
use runFunction from "./generated/contract/runFunction.mutation.ts"
use cleanup from "./generated/contract/cleanup.mutation.ts"
use verifyConfig from "./generated/contract/verifyConfig.mutation.ts"
use colors from "./theme.ts"
use fonts from "./theme.ts"
use navSections from "./theme.ts"
use initialTab from "./theme.ts"
use systemTheme from "./theme.ts"
use watchSystemTheme from "./theme.ts"
use snapbackMark from "./brand-mark.ts"

component AdminConsole
  state activeTab = initialTab()
  state theme = systemTheme()
  state dataTable = ""
  state dataOffset = 0
  state runName = ""
  state runArgs = "{}"
  state runUser = ""

  query state = inspect({})
  query scan = tableScan({})
  query runResultQ = runResult({})
  mutation reloadInspect = refresh
  mutation loadScan = loadTable
  mutation runMut = runFunction
  mutation cleanupMut = cleanup
  mutation verifyMut = verifyConfig

  derive c = colors(theme)
  derive f = fonts()
  derive nav = navSections()
  derive isOverview = activeTab == "Overview"
  derive isSchema = activeTab == "Schema"
  derive isData = activeTab == "Data"
  derive isFunctions = activeTab == "Functions"
  derive isSecrets = activeTab == "Secrets"
  derive isCapabilities = activeTab == "Capabilities"
  derive isRealtime = activeTab == "Realtime"
  derive isDiagnostics = activeTab == "Diagnostics"

  action reload mutates reloadInspect
    reloadInspect()
  action setTab(name) writes activeTab
    activeTab = name
  action syncSystemTheme(mode) writes theme
    theme = mode
  action openTable(name) writes dataTable, dataOffset mutates loadScan
    dataTable = name
    dataOffset = 0
    loadScan({ table: name, offset: 0 })
  action pageTo(offset) writes dataOffset mutates loadScan
    dataOffset = offset
    loadScan({ table: dataTable, offset: offset })
  action pickFn(name) writes runName
    runName = name
  action setArgs(value) writes runArgs
    runArgs = value
  action setUser(value) writes runUser
    runUser = value
  action runFn mutates runMut
    runMut({ name: runName, argsText: runArgs, userId: runUser })
  action cleanupNow mutates cleanupMut
    cleanupMut()
  action verifyEntry(name) mutates verifyMut
    verifyMut({ entry: name })

  task themeWatcher mount
    onCleanup(watchSystemTheme(syncSystemTheme))

  view
    row flex=1 width="100%" minHeight="100%" background=c.canvas

      column width=248 minHeight="100%" background=c.sidebar paddingTop=22 paddingBottom=20 paddingLeft=14 paddingRight=14 gap=22 boxShadow=c.shadowSidebar
        row gap=11 align="center" paddingLeft=8 paddingRight=8
          image svgSource=snapbackMark(c.markInk) alt="Snapback" width=62 height=20 testId="brand-mark"
          column gap=1 flex=1 minWidth=0
            text "Snapback" size=16 weight=700 color=c.text family=f.sans letterSpacing=-0.2
            text "ADMIN CONSOLE" size=9 weight=700 color=c.textFaint family=f.sans letterSpacing=1.4

        column gap=2 width="100%"
          each item in nav key=item.key
            button press=setTab(item.key) testId=`nav-${item.key}` width="100%" radius=8 borderWidth=0 paddingTop=9 paddingBottom=9 paddingLeft=12 paddingRight=12 background=activeTab == item.key ? c.accentSoft : "transparent"
              text item.label size=13 weight=activeTab == item.key ? 600 : 500 color=activeTab == item.key ? c.accentText : c.textMuted family=f.sans

        spacer

      scroll flex=1 minWidth=0 minHeight=0 background=c.canvas borderLeftWidth=1 borderLeftColor=c.border
        column padding=28 gap=18 width="100%" maxWidth=1180

          async state
            loading
              column align="center" paddingTop=90 gap=10 width="100%"
                text "Connecting to Snapback…" size=14 color=c.textMuted family=f.sans testId="loading"
            error err
              column paddingTop=40 width="100%"
                column gap=8 padding=20 radius=12 background=c.errSoft width="100%" maxWidth=560
                  text "Admin API unavailable" size=15 weight=700 color=c.err family=f.sans
                  text err.message size=13 color=c.err family=f.mono testId="error"
                  text "Reads are open on loopback; a non-loopback bind needs SNAPBACK_ADMIN_TOKEN." size=12 color=c.textMuted family=f.sans
            ready rows
              each s in rows key=s.id

                row align="center" gap=16 width="100%"
                  column gap=2 flex=1 minWidth=0
                    text activeTab size=22 weight=700 color=c.text family=f.sans testId="title"
                    text s.ui.target size=12 color=c.textFaint family=f.mono
                  row gap=10 align="center"
                    text s.ui.loadedAt size=12 color=c.textFaint family=f.sans
                    button press=reload testId="refresh" paddingTop=8 paddingBottom=8 paddingLeft=16 paddingRight=16 radius=8 background=c.accent borderWidth=0
                      text "Refresh" size=13 weight=600 color=c.onAccent family=f.sans

                row gap=8 wrap="wrap" align="center" width="100%"
                  Badge(c=c, label=s.ui.address, tone="default", mono=true)
                  Badge(c=c, label=s.ui.exposureLabel, tone=s.ui.exposureTone)
                  Badge(c=c, label=s.ui.storageLabel, tone="default")
                  Badge(c=c, label=s.ui.tokenLabel, tone=s.ui.tokenTone)
                  when s.ui.showConfigAlert
                    Badge(c=c, label=s.ui.configAlertLabel, tone="warn")
                when s.ui.hasInspectError
                  column gap=6 padding=14 radius=12 background=c.errSoft width="100%"
                    text "Inspect refresh failed" size=12 weight=700 color=c.err family=f.sans
                    text s.ui.inspectError size=12 color=c.err family=f.mono testId="inspect-error"

                column height=1 background=c.border width="100%"

                when isOverview
                  column gap=18 width="100%"
                    row gap=12 wrap="wrap" width="100%" minHeight=92
                      each t in s.ui.tiles key=t.key
                        StatTile(c=c, label=t.label, value=t.value, alert=t.alert)
                    row gap=14 wrap="wrap" align="stretch" width="100%" minHeight=176
                      Card(c=c, title="SERVER")
                        each kvi in s.ui.server key=kvi.key
                          Kv(c=c, k=kvi.k, v=kvi.v, tone=kvi.tone, mono=kvi.mono)
                      Card(c=c, title="STORAGE")
                        each kvi in s.ui.storage key=kvi.key
                          Kv(c=c, k=kvi.k, v=kvi.v, tone=kvi.tone, mono=kvi.mono)
                      Card(c=c, title="RUNTIME")
                        each kvi in s.ui.runtime key=kvi.key
                          Kv(c=c, k=kvi.k, v=kvi.v, tone=kvi.tone, mono=kvi.mono)
                    row gap=14 wrap="wrap" width="100%" minHeight=168
                      Card(c=c, title="ADMIN CAPABILITIES")
                        each cap in s.ui.adminCaps key=cap.key
                          Kv(c=c, k=cap.k, v=cap.on ? "yes" : "no", tone=cap.on ? "ok" : "faint")
                    when s.ui.hasGaps
                      column gap=10 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" minHeight=76 boxShadow=c.shadowCard
                        text "CAPABILITY GAPS" size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans
                        row gap=7 wrap="wrap"
                          each g in s.ui.gaps key=g.key
                            Badge(c=c, label=g.label, tone="warn", mono=true)

                when isSchema
                  column gap=14 width="100%"
                    row gap=8 align="center" wrap="wrap"
                      text s.ui.tableSummary size=13 color=c.textMuted family=f.sans
                      when s.ui.appId
                        Badge(c=c, label=s.ui.appId, tone="accent")
                      when s.ui.schemaHash
                        Badge(c=c, label=s.ui.schemaHash, tone="default", mono=true)
                    when s.ui.hasTables
                      column gap=12 width="100%"
                        each t in s.ui.tables key=t.name
                          column gap=0 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                            row align="center" gap=10 width="100%" paddingBottom=8
                              text t.name size=15 weight=700 color=c.text family=f.mono flex=1 minWidth=0
                              text t.fieldSummary size=12 color=c.textFaint family=f.sans
                              Badge(c=c, label=t.syncableLabel, tone=t.syncableTone)
                            column height=1 background=c.border width="100%" marginBottom=2
                            each fld in t.fields key=fld.key
                              FieldRow(c=c, name=fld.name, type=fld.type, req=fld.req, sys=fld.sys)
                            column height=1 background=c.border width="100%" marginTop=8 marginBottom=8
                            row gap=10 align="center" width="100%"
                              text "Indexes" size=12 color=c.textMuted family=f.sans flex=1 minWidth=0
                              text t.indexesLabel size=12 color=c.text family=f.mono textAlign="right"
                    else
                      column padding=28 align="center" radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                        text "No schema loaded. Apply a schema manifest to populate tables." size=13 color=c.textMuted family=f.sans

                when isData
                  column gap=14 width="100%"
                    text "Read-only, schema-aware row browsing through Snapback storage." size=13 color=c.textMuted family=f.sans
                    row gap=6 wrap="wrap" align="center" width="100%"
                      text "Table" size=12 color=c.textMuted family=f.sans
                      each t in s.ui.tableNames key=t.key
                        button press=openTable(t.name) testId=`pick-${t.name}` borderWidth=1 borderColor=c.border radius=8 paddingTop=6 paddingBottom=6 paddingLeft=12 paddingRight=12 background=dataTable == t.name ? c.accentSoft : c.surface
                          text t.name size=13 weight=dataTable == t.name ? 600 : 500 color=dataTable == t.name ? c.accentText : c.text family=f.mono
                    async scan
                      ready scanRows
                        each sv in scanRows key=sv.id
                          when sv.loaded
                            column gap=0 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                              row gap=10 align="center" width="100%" paddingTop=12 paddingBottom=12 paddingLeft=14 paddingRight=14
                                text sv.table size=13 weight=700 color=c.text family=f.mono flex=1 minWidth=0
                                text sv.rangeLabel size=12 color=c.textMuted family=f.sans
                                button press=pageTo(sv.prevOffset) testId="data-prev" paddingTop=5 paddingBottom=5 paddingLeft=11 paddingRight=11 radius=8 borderWidth=1 borderColor=c.border background=c.surface opacity=sv.prevDisabled ? 0.4 : 1 disabled=sv.prevDisabled
                                  text "‹ Prev" size=12 weight=600 color=c.textMuted family=f.sans
                                button press=pageTo(sv.nextOffset) testId="data-next" paddingTop=5 paddingBottom=5 paddingLeft=11 paddingRight=11 radius=8 borderWidth=1 borderColor=c.border background=c.surface opacity=sv.nextDisabled ? 0.4 : 1 disabled=sv.nextDisabled
                                  text "Next ›" size=12 weight=600 color=c.textMuted family=f.sans
                              when sv.error
                                column padding=16 width="100%"
                                  text sv.error size=12 color=c.err family=f.mono
                              when sv.empty
                                column padding=28 align="center" width="100%"
                                  text "No rows in this table." size=13 color=c.textMuted family=f.sans
                              else
                                column gap=0 width="100%"
                                  row gap=10 paddingTop=9 paddingBottom=9 paddingLeft=14 paddingRight=14 background=c.surfaceRaised width="100%" borderColor=c.border borderBottomWidth=1
                                    each col in sv.columns key=col
                                      text col size=11 weight=700 color=c.textMuted family=f.mono flex=1 minWidth=0 numberOfLines=1
                                  each drow in sv.rows key=drow.id
                                    row gap=10 paddingTop=8 paddingBottom=8 paddingLeft=14 paddingRight=14 width="100%" borderColor=c.border borderBottomWidth=1
                                      each cell in drow.cells key=cell.key
                                        text cell.text size=12 color=cell.sys ? c.textFaint : c.text family=f.mono flex=1 minWidth=0 numberOfLines=1
                          else
                            column padding=28 align="center" radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                              text "Select a table above to browse its rows." size=13 color=c.textMuted family=f.sans

                when isFunctions
                  column gap=16 width="100%"
                    text "Run generated queries and mutations through the same path as clients." size=13 color=c.textMuted family=f.sans
                    column gap=12 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                      row gap=8 align="center" wrap="wrap"
                        text "Run a function" size=13 weight=700 color=c.text family=f.sans flex=1 minWidth=0
                        text runName == "" ? "select a function below" : runName size=13 weight=600 color=runName == "" ? c.textFaint : c.accentText family=f.mono
                      input label="Arguments (JSON)" value=runArgs change=setArgs submit=runFn multiline=true testId="run-args" width="100%" minHeight=70 paddingTop=10 paddingBottom=10 paddingLeft=12 paddingRight=12 radius=8 borderWidth=1 borderColor=c.borderStrong background=c.surfaceRaised color=c.text size=13 family=f.mono
                      row gap=8 align="center" wrap="wrap" width="100%"
                        input label="auth user id" value=runUser change=setUser submit=runFn placeholder="auth user id (optional)" testId="run-user" flex=1 minWidth=200 paddingTop=9 paddingBottom=9 paddingLeft=12 paddingRight=12 radius=8 borderWidth=1 borderColor=c.borderStrong background=c.surface color=c.text size=13 family=f.sans
                        button press=runFn testId="run-btn" paddingTop=10 paddingBottom=10 paddingLeft=20 paddingRight=20 radius=8 background=c.accent borderWidth=0
                          text "Run" size=13 weight=600 color=c.onAccent family=f.sans
                      async runResultQ
                        ready runRows
                          each rr in runRows key=rr.id
                            when rr.ran
                              column gap=10 paddingTop=6 width="100%"
                                row gap=8 align="center" minHeight=24
                                  Badge(c=c, label=rr.statusLabel, tone=rr.ok ? "ok" : "err")
                                  when rr.kindLabel
                                    Badge(c=c, label=rr.kindLabel, tone="accent")
                                  text rr.facts size=12 color=c.textMuted family=f.sans
                                text rr.io size=12 color=c.textMuted family=f.mono
                                when rr.hasReads
                                  row gap=6 align="center" minHeight=24
                                    text "captured reads" size=11 color=c.textFaint family=f.sans
                                    each cr in rr.reads key=cr.key
                                      Badge(c=c, label=cr.label, tone="default", mono=true)
                                when rr.hasWrites
                                  row gap=6 align="center" minHeight=24
                                    text "captured writes" size=11 color=c.textFaint family=f.sans
                                    each cw in rr.writes key=cw.key
                                      Badge(c=c, label=cw.label, tone="warn", mono=true)
                                when rr.error
                                  column padding=12 radius=8 background=c.errSoft width="100%"
                                    text rr.error size=12 color=c.err family=f.mono
                                when rr.hasPayload
                                  scroll height=200 padding=12 radius=8 background=c.surfaceRaised borderWidth=1 borderColor=c.border width="100%"
                                    text rr.payload size=12 color=c.text family=f.mono
                    column gap=8 width="100%"
                      row gap=8 align="center" wrap="wrap"
                        text s.ui.functionSummary size=13 color=c.textMuted family=f.sans flex=1 minWidth=0
                        when s.ui.bundleHash
                          Badge(c=c, label=s.ui.bundleHash, tone="default", mono=true)
                      when s.ui.hasFunctions
                        column gap=8 width="100%"
                          each fn in s.ui.functions key=fn.name
                            column gap=0 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                              button press=pickFn(fn.name) testId=`fn-${fn.name}` width="100%" borderWidth=0 radius=12 background=runName == fn.name ? c.accentSoft : "transparent"
                                row gap=10 align="center" paddingTop=12 paddingBottom=12 paddingLeft=14 paddingRight=14 width="100%"
                                  Badge(c=c, label=fn.kindLabel, tone=fn.kindTone)
                                  text fn.name size=14 weight=600 color=c.text family=f.sans flex=1 minWidth=0 numberOfLines=1
                                  text fn.io size=12 color=c.textMuted family=f.mono numberOfLines=1
                              when runName == fn.name
                                column gap=12 paddingTop=2 paddingBottom=14 paddingLeft=14 paddingRight=14 width="100%"
                                  column height=1 background=c.border width="100%" marginBottom=2
                                  row gap=28 align="flex-start" width="100%" minHeight=42
                                    column gap=2
                                      text "AUTH" size=9 weight=700 color=c.textFaint family=f.sans letterSpacing=0.8
                                      text fn.auth size=13 color=c.text family=f.sans
                                    column gap=2
                                      text "SYNCABILITY" size=9 weight=700 color=c.textFaint family=f.sans letterSpacing=0.8
                                      text fn.syncability size=13 color=c.text family=f.sans
                                    column gap=2
                                      text "RUNTIME" size=9 weight=700 color=c.textFaint family=f.sans letterSpacing=0.8
                                      text fn.planLabel size=13 color=c.text family=f.sans
                                  column gap=3 width="100%"
                                    text "PLAN" size=9 weight=700 color=c.textFaint family=f.sans letterSpacing=0.8
                                    text fn.planSummary size=13 color=c.text family=f.mono
                                  when fn.hasCaps
                                    row gap=6 align="center" minHeight=24
                                      text "requires" size=11 color=c.textFaint family=f.sans
                                      each cap in fn.caps key=cap.key
                                        Badge(c=c, label=cap.label, tone="default", mono=true)
                                  when fn.hasGrants
                                    row gap=6 align="center" minHeight=24
                                      text "config grants" size=11 color=c.textFaint family=f.sans
                                      each g in fn.grants key=g.key
                                        Badge(c=c, label=g.label, tone="accent", mono=true)
                                  when fn.hasPlanJson
                                    scroll height=220 padding=12 radius=8 background=c.surfaceRaised borderWidth=1 borderColor=c.border width="100%"
                                      text fn.planJson size=11 color=c.textMuted family=f.mono
                                  when fn.isIbex
                                    scroll height=220 padding=12 radius=8 background=c.surfaceRaised borderWidth=1 borderColor=c.border width="100%"
                                      text fn.source size=11 color=c.text family=f.mono

                when isSecrets
                  column gap=16 width="100%"
                    text "Declared configuration and secrets — status only. Values are write-only and never readable here." size=13 color=c.textMuted family=f.sans
                    when s.ui.config.available
                      column gap=16 width="100%"
                        row gap=12 wrap="wrap" width="100%" minHeight=92
                          each t in s.ui.config.tiles key=t.key
                            StatTile(c=c, label=t.label, value=t.value, alert=t.alert)
                        row gap=8 wrap="wrap" align="center" width="100%"
                          Badge(c=c, label=s.ui.config.readyLabel, tone=s.ui.config.readyTone)
                          Badge(c=c, label=s.ui.config.backendClass, tone="default", mono=true)
                          Badge(c=c, label=s.ui.config.generationLabel, tone="default", mono=true)
                        when s.ui.config.missingLabel
                          column gap=6 padding=14 radius=12 background=c.warnSoft width="100%"
                            text "Missing required entries" size=12 weight=700 color=c.warn family=f.sans
                            text s.ui.config.missingLabel size=13 color=c.warn family=f.mono
                        row gap=12 align="center" padding=14 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                          column gap=2 flex=1 minWidth=0
                            text "Values are set in the setup wizard" size=13 weight=600 color=c.text family=f.sans
                            text "This page shows status and runs verification probes; paste or replace values there." size=12 color=c.textMuted family=f.sans
                          link href=s.ui.config.setupHref testId="open-setup"
                            text "Open setup wizard →" size=13 weight=600 color=c.accentText family=f.sans background=c.accentSoft radius=8 paddingTop=8 paddingBottom=8 paddingLeft=14 paddingRight=14
                        when s.ui.config.hasEntries
                          column gap=12 width="100%"
                            each e in s.ui.config.entries key=e.name
                              column gap=8 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                                row gap=8 align="center" wrap="wrap" width="100%"
                                  text e.name size=15 weight=700 color=c.text family=f.mono flex=1 minWidth=0
                                  Badge(c=c, label=e.secretLabel, tone=e.secretTone)
                                  Badge(c=c, label=e.requiredLabel, tone="default")
                                  when e.poolLabel
                                    Badge(c=c, label=e.poolLabel, tone="default", mono=true)
                                  when e.pendingLabel
                                    Badge(c=c, label=e.pendingLabel, tone="warn")
                                  Badge(c=c, label=e.setLabel, tone=e.setTone)
                                  when e.verifiedLabel
                                    Badge(c=c, label=e.verifiedLabel, tone=e.verifiedTone)
                                when e.description
                                  text e.description size=13 color=c.text family=f.sans
                                when e.purpose
                                  text e.purpose size=12 color=c.textMuted family=f.sans
                                when e.howToGet
                                  text e.howToGet size=12 color=c.textMuted family=f.sans lineHeight=17
                                when e.hasUsedBy
                                  row gap=6 align="center" wrap="wrap" minHeight=24
                                    text "used by" size=11 color=c.textFaint family=f.sans
                                    each u in e.usedBy key=u.key
                                      Badge(c=c, label=u.label, tone="default", mono=true)
                                when e.verifyDiagnostic
                                  column padding=12 radius=8 background=c.errSoft width="100%"
                                    text e.verifyDiagnostic size=12 color=c.err family=f.mono
                                row gap=10 align="center" wrap="wrap" width="100%" minHeight=30
                                  when e.changedLabel
                                    text e.changedLabel size=12 color=c.textFaint family=f.sans flex=1 minWidth=0
                                  else
                                    spacer
                                  when e.verifyRan
                                    Badge(c=c, label=e.verifyLabel, tone=e.verifyOk ? "ok" : "err")
                                  when e.canVerify
                                    button press=verifyEntry(e.name) testId=`verify-${e.name}` paddingTop=7 paddingBottom=7 paddingLeft=14 paddingRight=14 radius=8 borderWidth=1 borderColor=c.border background=c.surface
                                      text "Verify" size=12 weight=600 color=c.textMuted family=f.sans
                                when e.verifyDetail
                                  column padding=12 radius=8 background=e.verifyOk ? c.surfaceRaised : c.errSoft width="100%"
                                    text e.verifyDetail size=12 color=e.verifyOk ? c.textMuted : c.err family=f.mono
                        else
                          column gap=6 padding=28 align="center" radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                            text s.ui.config.emptyTitle size=13 weight=600 color=c.text family=f.sans
                            text s.ui.config.emptyMessage size=12 color=c.textMuted family=f.sans textAlign="center"
                    else
                      column gap=8 padding=20 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                        text "Config status is unavailable on this server." size=13 weight=600 color=c.text family=f.sans
                        when s.ui.config.error
                          text s.ui.config.error size=12 color=c.err family=f.mono

                when isCapabilities
                  column gap=14 width="100%"
                    text "What this target profile can and cannot do — the capability manifest." size=13 color=c.textMuted family=f.sans
                    row gap=14 wrap="wrap" align="stretch" width="100%"
                      Card(c=c, title="ENGINE")
                        Kv(c=c, k="Storage engine", v=s.ui.cap.storageEngine)
                        Kv(c=c, k="Runtime engine", v=s.ui.cap.runtimeEngine)
                        Kv(c=c, k="Mutation isolation", v=s.ui.cap.isolation)
                      Card(c=c, title="FEATURES")
                        each fl in s.ui.cap.flags key=fl.key
                          Kv(c=c, k=fl.label, v=fl.on ? "yes" : "no", tone=fl.on ? "ok" : "faint")
                    when s.ui.cap.hasForms
                      column gap=10 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                        text "SUPPORTED QUERY FORMS" size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans
                        row gap=7 wrap="wrap"
                          each q in s.ui.cap.queryForms key=q.key
                            Badge(c=c, label=q.label, tone="default", mono=true)
                    row gap=14 wrap="wrap" width="100%"
                      when s.ui.cap.hasLimits
                        Card(c=c, title="RESOURCE LIMITS")
                          each lim in s.ui.cap.limits key=lim.key
                            Kv(c=c, k=lim.name, v=lim.status, tone=lim.tone, mono=true)
                    when s.ui.cap.hasGaps
                      column gap=10 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                        text "CAPABILITY GAPS" size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans
                        row gap=7 wrap="wrap"
                          each g in s.ui.cap.gaps key=g.key
                            Badge(c=c, label=g.label, tone="warn", mono=true)

                when isRealtime
                  column gap=16 width="100%"
                    text "Durable subscriptions and process-local ephemeral state. Ephemeral clears on restart." size=13 color=c.textMuted family=f.sans
                    column gap=0 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                      row align="center" gap=8 paddingBottom=10 width="100%"
                        text "DURABLE SUBSCRIPTIONS" size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans flex=1 minWidth=0
                        Badge(c=c, label=s.ui.subCountLabel, tone="default")
                      when s.ui.hasSubs
                        column gap=0 width="100%"
                          each sub in s.ui.subscriptions key=sub.key
                            row gap=10 align="center" paddingTop=8 paddingBottom=8 width="100%" borderColor=c.border borderBottomWidth=1
                              text sub.function size=13 weight=500 color=c.text family=f.sans flex=1 minWidth=0
                              text sub.connection size=12 color=c.textFaint family=f.mono
                              text sub.id size=12 color=c.textFaint family=f.mono
                      else
                        text "No active subscriptions." size=13 color=c.textMuted family=f.sans
                    column gap=10 width="100%"
                      text "LIVE DELIVERY" size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans
                      row gap=12 wrap="wrap" width="100%"
                        each st in s.ui.delivery key=st.key
                          StatTile(c=c, label=st.label, value=st.value, alert=false)
                    column gap=10 width="100%"
                      row gap=8 align="center" width="100%"
                        text "EPHEMERAL ROOMS" size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans flex=1 minWidth=0
                        when s.ui.canCleanup
                          button press=cleanupNow testId="ephemeral-cleanup" paddingTop=7 paddingBottom=7 paddingLeft=14 paddingRight=14 radius=8 borderWidth=1 borderColor=c.border background=c.surface
                            text "Clean up expired" size=12 weight=600 color=c.textMuted family=f.sans
                      row gap=12 wrap="wrap" width="100%"
                        each st in s.ui.ephemeral key=st.key
                          StatTile(c=c, label=st.label, value=st.value, alert=st.alert)

                when isDiagnostics
                  column gap=14 width="100%"
                    text "Recent structured diagnostics emitted by the runtime." size=13 color=c.textMuted family=f.sans
                    when s.ui.hasDiags
                      column gap=0 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%" boxShadow=c.shadowCard
                        each d in s.ui.diagnostics key=d.key
                          DiagRow(c=c, d=d)
                    else
                      column padding=28 align="center" radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                        text "No recent diagnostics." size=13 color=c.textMuted family=f.sans

component Card
  props
    c: object
    title: string
  derive f = fonts()
  view
    column gap=0 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border flex=1 minWidth=260 boxShadow=c.shadowCard
      text title size=11 weight=700 letterSpacing=0.5 color=c.textMuted family=f.sans
      column gap=0 paddingTop=6 width="100%"
        children

component Kv
  props
    c: object
    k: string
    v: string
    tone: string = ""
    mono: boolean = false
  derive f = fonts()
  derive vColor = tone == "ok" ? c.ok : tone == "warn" ? c.warn : tone == "err" ? c.err : tone == "accent" ? c.accentText : tone == "faint" ? c.textFaint : c.text
  view
    row gap=12 align="center" paddingTop=7 paddingBottom=7 width="100%"
      text k size=13 color=c.textMuted family=f.sans flex=1 minWidth=0
      // value shares the row (flex=1 minWidth=0) so a long SQLite path wraps inside
      // the card instead of overflowing over the label and past the edge (ENG-22831)
      text v size=13 weight=500 color=vColor family=mono ? f.mono : f.sans textAlign="right" flex=1 minWidth=0

component StatTile
  props
    c: object
    label: string
    value: string
    alert: boolean = false
  derive f = fonts()
  view
    column gap=4 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border flex=1 minWidth=150 boxShadow=c.shadowCard
      text value size=26 weight=700 color=alert ? c.warn : c.text family=f.sans letterSpacing=-0.5
      text label size=12 weight=500 color=c.textMuted family=f.sans

component Badge
  props
    c: object
    label: string
    tone: string = "default"
    mono: boolean = false
  derive f = fonts()
  derive bg = tone == "ok" ? c.okSoft : tone == "warn" ? c.warnSoft : tone == "err" ? c.errSoft : tone == "accent" ? c.accentSoft : tone == "info" ? c.infoSoft : c.surfaceRaised
  derive fg = tone == "ok" ? c.ok : tone == "warn" ? c.warn : tone == "err" ? c.err : tone == "accent" ? c.accentText : tone == "info" ? c.info : c.textMuted
  view
    // A single text leaf (not a column > text): the Exact layout kernel measures
    // text nodes reliably, so badge-bearing rows get correct height even when the
    // content is published into a boundary after the initial render.
    text label size=12 weight=600 color=fg family=mono ? f.mono : f.sans background=bg radius=999 paddingTop=3 paddingBottom=3 paddingLeft=10 paddingRight=10

component FieldRow
  props
    c: object
    name: string
    type: string
    req: string
    sys: boolean
  derive f = fonts()
  view
    row gap=12 align="center" paddingTop=6 paddingBottom=6 width="100%"
      text name size=13 flex=1 minWidth=0 color=sys ? c.textFaint : c.text family=sys ? f.mono : f.sans numberOfLines=1
      text type size=12 color=c.textMuted family=f.mono
      text req size=11 color=c.textFaint family=f.sans

component DiagRow
  props
    c: object
    d: object
  derive f = fonts()
  derive dotColor = d.sevTone == "err" ? c.err : d.sevTone == "warn" ? c.warn : c.info
  view
    row gap=11 paddingTop=11 paddingBottom=11 paddingLeft=14 paddingRight=14 width="100%" align="flex-start" borderColor=c.border borderBottomWidth=1
      column width=8 height=8 radius=999 background=dotColor marginTop=5
      column gap=3 flex=1 minWidth=0
        row gap=8 align="center" wrap="wrap"
          text d.code size=13 weight=700 color=c.text family=f.mono
          Badge(c=c, label=d.subsystem, tone="default")
          Badge(c=c, label=d.sevLabel, tone=d.sevTone)
        text d.message size=13 color=c.textMuted family=f.sans lineHeight=18
        when d.hasDetails
          scroll height=150 padding=10 radius=8 background=c.surfaceRaised borderWidth=1 borderColor=c.border width="100%" marginTop=2
            text d.details size=11 color=c.textMuted family=f.mono
