// Snapback admin — Contract console.
//
// A system app over the headless admin contract (/_snapback/api/*), authored in
// Contract and statically built (see admin-ui/build.mjs + LLP 0017). Tabbed
// inspector built from reusable components and `when` panels keyed off
// `activeTab`. The single inspect read is a one-row collection, so the body
// renders inside `each s in rows` over that row; formatting lives in
// admin-boundary.mjs's `data.ui.*` view model.

use inspect from "./generated/contract/inspect.query.ts"
use refresh from "./generated/contract/refresh.mutation.ts"
use tableScan from "./generated/contract/tableScan.query.ts"
use loadTable from "./generated/contract/loadTable.mutation.ts"
use runResult from "./generated/contract/runResult.query.ts"
use runFunction from "./generated/contract/runFunction.mutation.ts"
use colors from "./theme.ts"
use fonts from "./theme.ts"
use tabNames from "./theme.ts"
use initialTab from "./theme.ts"

component AdminConsole
  state activeTab = initialTab()
  state dataTable = ""
  state dataOffset = 0
  state runName = ""
  state runArgs = "{}"
  state runUser = ""

  query state = inspect({})
  query scan = tableScan({})
  query runResultQ = runResult({})
  mutation reloadInspect = refresh
  mutation loadScan = loadTable
  mutation runMut = runFunction

  derive c = colors()
  derive f = fonts()
  derive tabs = tabNames()
  derive isOverview = activeTab == "Overview"
  derive isSchema = activeTab == "Schema"
  derive isData = activeTab == "Data"
  derive isFunctions = activeTab == "Functions"
  derive isRealtime = activeTab == "Realtime"
  derive isDiagnostics = activeTab == "Diagnostics"

  action reload mutates reloadInspect
    reloadInspect()
  action setTab(name) writes activeTab
    activeTab = name
  action openTable(name) writes dataTable, dataOffset mutates loadScan
    dataTable = name
    dataOffset = 0
    loadScan({ table: name, offset: 0 })
  action pageBy(delta) writes dataOffset mutates loadScan
    dataOffset = dataOffset + delta
    loadScan({ table: dataTable, offset: dataOffset })
  action selectFn(name) writes runName
    runName = name
  action setArgs(value) writes runArgs
    runArgs = value
  action setUser(value) writes runUser
    runUser = value
  action runFn mutates runMut
    runMut({ name: runName, argsText: runArgs, userId: runUser })

  view
    column align="center" padding=20 background=c.bg minHeight="100vh" width="100%"
      column gap=14 width="100%" maxWidth=980
        row align="center" gap=12 width="100%"
          column gap=2 flex=1 minWidth=0
            text "Snapback admin" size=22 weight=800 color=c.text family=f.sans testId="title"
            text "Contract console" size=12 color=c.textMuted family=f.sans
          button press=reload testId="refresh" paddingTop=8 paddingBottom=8 paddingLeft=16 paddingRight=16 radius=8 background=c.accent borderWidth=0
            text "Refresh" size=13 weight=600 color="#ffffff" family=f.sans

        row gap=4 wrap="wrap" width="100%"
          each name in tabs key=name
            button press=setTab(name) testId=`tab-${name}` paddingTop=7 paddingBottom=7 paddingLeft=13 paddingRight=13 radius=8 borderWidth=0 background=activeTab == name ? c.accentSoft : "transparent"
              text name size=13 color=activeTab == name ? c.accentText : c.textMuted family=f.sans weight=activeTab == name ? 700 : 500

        async state
          loading
            text "Connecting to Snapback…" size=14 color=c.textMuted family=f.sans testId="loading"
          error err
            text err.message size=14 color=c.err family=f.sans testId="error"
          ready rows
            each s in rows key=s.id

              when isOverview
                column gap=14 width="100%"
                  row gap=14 wrap="wrap" width="100%" align="stretch"
                    Card(title="SERVER", testId="card-server")
                      Kv(k="Target", v=s.ui.target)
                      Kv(k="Address", v=s.ui.address)
                      Kv(k="Exposure", v=s.ui.exposure)
                      Kv(k="Uptime", v=s.ui.uptime)
                      Kv(k="PID", v=s.ui.pid)
                    Card(title="STORAGE", testId="card-storage")
                      Kv(k="Mode", v=s.ui.storageMode)
                      Kv(k="SQLite path", v=s.ui.sqlitePath)
                      Kv(k="Data version", v=s.ui.dataVersion)
                      Kv(k="Schema hash", v=s.ui.schemaHash)
                    Card(title="RUNTIME", testId="card-runtime")
                      Kv(k="Engine", v=s.ui.engine)
                      Kv(k="Ibex CLI", v=s.ui.ibex)
                      Kv(k="Writes need token", v=s.ui.writesRequireToken)
                  column gap=8 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                    text "Capability gaps" size=13 weight=700 color=c.text family=f.sans
                    row gap=7 wrap="wrap"
                      each g in s.ui.gaps key=g
                        Chip(label=g, tone="warn")

              when isSchema
                column gap=10 width="100%"
                  each t in s.ui.tables key=t.name
                    Card(title=t.name, testId=`table-${t.name}`)
                      each fld in t.fields key=fld.name
                        FieldRow(name=fld.name, type=fld.type, sys=fld.sys)
                      Kv(k="Indexes", v=t.indexes)

              when isData
                column gap=12 width="100%"
                  row gap=6 wrap="wrap" align="center"
                    text "Table" size=12 color=c.textMuted family=f.sans
                    each t in s.ui.tables key=t.name
                      button press=openTable(t.name) testId=`pick-${t.name}` paddingTop=6 paddingBottom=6 paddingLeft=12 paddingRight=12 radius=8 borderWidth=1 borderColor=c.border background=dataTable == t.name ? c.accentSoft : c.surface
                        text t.name size=13 color=dataTable == t.name ? c.accentText : c.text family=f.sans weight=dataTable == t.name ? 700 : 500
                  async scan
                    ready scanRows
                      each sv in scanRows key=sv.id
                        when sv.loaded
                          column gap=8 padding=12 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                            row gap=10 align="center" width="100%"
                              text sv.rangeLabel size=12 color=c.textMuted family=f.sans flex=1 minWidth=0
                              when sv.canPrev
                                button press=pageBy(-50) testId="data-prev" paddingTop=5 paddingBottom=5 paddingLeft=11 paddingRight=11 radius=8 borderWidth=1 borderColor=c.border background=c.surface
                                  text "‹ Prev" size=12 weight=600 color=c.textMuted family=f.sans
                              when sv.canNext
                                button press=pageBy(50) testId="data-next" paddingTop=5 paddingBottom=5 paddingLeft=11 paddingRight=11 radius=8 borderWidth=1 borderColor=c.border background=c.surface
                                  text "Next ›" size=12 weight=600 color=c.textMuted family=f.sans
                            row gap=8 paddingBottom=6 width="100%"
                              each col in sv.columns key=col
                                text col size=11 weight=700 color=c.textMuted family=f.mono flex=1 minWidth=0 numberOfLines=1
                            each drow in sv.rows key=drow.id
                              row gap=8 paddingTop=6 paddingBottom=6 width="100%"
                                each cell in drow.cells key=cell.key
                                  text cell.text size=12 color=cell.sys ? c.textFaint : c.text family=f.mono flex=1 minWidth=0 numberOfLines=1
                        else
                          column gap=4 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                            text "Select a table to browse rows." size=13 color=c.textMuted family=f.sans

              when isFunctions
                column gap=12 width="100%"
                  column gap=10 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                    text "Run a function" size=13 weight=700 color=c.text family=f.sans
                    row gap=8 align="center" wrap="wrap"
                      text "Function" size=12 color=c.textMuted family=f.sans
                      text runName == "" ? "select one below" : runName size=13 weight=600 color=runName == "" ? c.textFaint : c.accentText family=f.mono
                    input label="Arguments (JSON)" value=runArgs change=setArgs submit=runFn testId="run-args" width="100%" paddingTop=8 paddingBottom=8 paddingLeft=10 paddingRight=10 radius=8 borderWidth=1 borderColor=c.border background=c.surface color=c.text size=13 family=f.mono
                    row gap=8 align="center" wrap="wrap" width="100%"
                      input label="auth user id (optional)" value=runUser change=setUser submit=runFn testId="run-user" flex=1 minWidth=200 paddingTop=8 paddingBottom=8 paddingLeft=10 paddingRight=10 radius=8 borderWidth=1 borderColor=c.border background=c.surface color=c.text size=13 family=f.sans
                      button press=runFn testId="run-btn" paddingTop=8 paddingBottom=8 paddingLeft=18 paddingRight=18 radius=8 background=c.accent borderWidth=0
                        text "Run" size=13 weight=600 color="#ffffff" family=f.sans
                    async runResultQ
                      ready runRows
                        each rr in runRows key=rr.id
                          when rr.ran
                            column gap=6 paddingTop=4 width="100%"
                              row gap=8 align="center" wrap="wrap"
                                Chip(label=rr.ok ? "ok" : "failed", tone=rr.ok ? "ok" : "warn")
                                text rr.io size=12 color=c.textMuted family=f.mono
                              when rr.facts
                                text rr.facts size=12 color=c.textMuted family=f.sans
                              when rr.error
                                text rr.error size=12 color=c.err family=f.mono
                              when rr.payload
                                column padding=12 radius=8 background=c.surfaceRaised borderWidth=1 borderColor=c.border width="100%"
                                  text rr.payload size=12 color=c.text family=f.mono
                  column gap=0 padding=4 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                    each fn in s.ui.functions key=fn.name
                      button press=selectFn(fn.name) testId=`fn-${fn.name}` width="100%" borderWidth=0 radius=8 background=runName == fn.name ? c.accentSoft : "transparent"
                        FnRow(fn=fn)

              when isRealtime
                column gap=14 width="100%"
                  Card(title="EPHEMERAL ROOMS", testId="card-ephemeral")
                    Kv(k="Rooms", v=s.ui.eph.rooms)
                    Kv(k="Entries", v=s.ui.eph.entries)
                    Kv(k="Subscribers", v=s.ui.eph.subscribers)
                    Kv(k="Resync required", v=s.ui.eph.resync)
                  text "Process-local memory, cleared on restart." size=12 color=c.textMuted family=f.sans

              when isDiagnostics
                column gap=0 padding=4 radius=12 background=c.surface borderWidth=1 borderColor=c.border width="100%"
                  each d in s.ui.diagnostics key=d.id
                    DiagRow(d=d)

component Card
  props
    title: string
    testId: string = null

  derive c = colors()
  derive f = fonts()

  view
    column gap=2 padding=16 radius=12 background=c.surface borderWidth=1 borderColor=c.border flex=1 minWidth=240 testId=testId
      text title size=11 weight=700 letterSpacing=0.4 color=c.textMuted family=f.sans
      column gap=0 paddingTop=4 width="100%"
        children

component Kv
  props
    k: string
    v: string

  derive c = colors()
  derive f = fonts()

  view
    row gap=12 paddingTop=6 paddingBottom=6 width="100%"
      text k size=13 color=c.textMuted family=f.sans flex=1 minWidth=0
      text v size=13 weight=500 color=c.text family=f.sans

component Chip
  props
    label: string
    tone: string = "default"

  derive c = colors()
  derive f = fonts()
  derive bg = tone == "warn" ? c.warnSoft : tone == "accent" ? c.accentSoft : tone == "ok" ? c.okSoft : c.surfaceRaised
  derive fg = tone == "warn" ? c.warn : tone == "accent" ? c.accentText : tone == "ok" ? c.ok : c.textMuted

  view
    column paddingTop=2 paddingBottom=2 paddingLeft=9 paddingRight=9 radius=999 background=bg
      text label size=12 weight=600 color=fg family=f.mono

component FieldRow
  props
    name: string
    type: string
    sys: bool

  derive c = colors()
  derive f = fonts()

  view
    row gap=12 paddingTop=5 paddingBottom=5 width="100%"
      text name size=13 flex=1 minWidth=0 color=sys ? c.textFaint : c.text family=sys ? f.mono : f.sans
      text type size=13 color=c.textMuted family=f.sans

component FnRow
  props
    fn: object

  derive c = colors()
  derive f = fonts()

  view
    row gap=10 align="center" paddingTop=9 paddingBottom=9 paddingLeft=12 paddingRight=12 width="100%"
      text fn.kindLabel size=11 weight=600 color=c.accentText family=f.mono width=76
      text fn.name size=13 weight=600 color=c.text family=f.sans flex=1 minWidth=0
      text fn.io size=12 color=c.textMuted family=f.mono

component DiagRow
  props
    d: object

  derive c = colors()
  derive f = fonts()

  view
    column gap=2 paddingTop=9 paddingBottom=9 paddingLeft=12 paddingRight=12 width="100%"
      row gap=8 align="center"
        text d.code size=12 weight=700 color=c.text family=f.mono
        text d.subsystem size=11 color=c.textMuted family=f.sans
      text d.message size=12 color=c.textMuted family=f.sans
