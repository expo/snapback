{
  "name": "snapback-website",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "assemble": "node scripts/assemble-docs.mjs",
    "check:docs": "node scripts/assemble-docs.mjs --check",
    "export": "expo export -p web",
    "deploy": "npm run check:docs && npm run assemble && npm run cap && npm run export && eas deploy --prod",
    "cap": "node ../brand/cap/build.mjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-router": "~6.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.0",
    "@expo/metro-runtime": "~6.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  }
}
