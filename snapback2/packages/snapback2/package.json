{
  "name": "snapback2",
  "version": "0.0.1",
  "description": "Snapback 2 CLI (the platform binary ships in snapback2-<os>-<arch>).",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs"
    },
    "./react": {
      "react-native": {
        "types": "./dist/react-native.d.ts",
        "import": "./dist/react-native.mjs"
      },
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.mjs"
    }
  },
  "bin": {
    "snapback2": "bin/snapback2.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "node build.mjs && env -u SNAPBACK_URL node --test --test-timeout=120000 tests/"
  },
  "dependencies": {
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "expo": ">=54",
    "expo-file-system": ">=19",
    "expo-video": ">=2",
    "react-native": ">=0.75",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "expo": { "optional": true },
    "expo-file-system": { "optional": true },
    "expo-video": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "esbuild": "0.25.9",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-test-renderer": "^19.1.1"
  },
  "optionalDependencies": {
    "snapback2-darwin-arm64": "0.0.1",
    "snapback2-linux-x64": "0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/snapback.git",
    "directory": "snapback2/packages/snapback2"
  }
}
