{
  "name": "snapback2-evaluator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../snapback2/build.mjs --unicode-only && esbuild src/evaluator.ts --bundle --format=esm --platform=neutral --target=es2020 --minify --outfile=dist/evaluator.mjs && esbuild src/run-corpus.ts --bundle --format=iife --platform=neutral --target=es2020 --outfile=dist/corpus-runner.js",
    "test": "bun src/test.ts",
    "corpus:node": "node dist/corpus-runner.js"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  }
}
