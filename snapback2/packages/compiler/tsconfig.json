{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "expo-file-system": [
        "../snapback2/src/native-modules.d.ts"
      ],
      "expo/fetch": [
        "../snapback2/src/native-modules.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
