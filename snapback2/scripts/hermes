#!/usr/bin/env bash
# Build with the Ibex 2 Hermes runtime for effects. hermes-lean-sys downloads,
# verifies, and caches the pinned engine bundle; HERMES_LEAN_SYS_DIR may point
# at a compatible local install instead. The default build needs no engine.
set -euo pipefail
cd "$(dirname "$0")/.."
# @ref LLP 1003#4-in-the-owner — published binaries use the engine-bearing build on every supported host.
command="${1:-build}"
if [ "$#" -gt 0 ]; then shift; fi
# Hermes-featured builds get their own target dir so they never invalidate the default build.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target/hermes}"
exec cargo "$command" --features hermes "$@"
