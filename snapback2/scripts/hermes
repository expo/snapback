#!/usr/bin/env bash
# Build the binary WITH the JS engine (Ibex 2 over vanilla Hermes) for effects.
# The default build never needs this. Ibex 2 looks for vanilla Hermes at
# IBEX2_VANILLA_HERMES_DIR; build it once with expo/ibex's scripts/build-hermes.sh --vanilla.
set -euo pipefail
cd "$(dirname "$0")/.."
# @ref LLP 1003#4-in-the-owner — published binaries use the engine-bearing build on every supported host.
case "$(uname -s)" in
  Darwin) platform=macos; platform_dir=ios; build_script=build-hermes.sh ;;
  Linux) platform=linux; platform_dir=linux; build_script=build-hermes-linux.sh ;;
  *) platform=unsupported; platform_dir=unsupported; build_script=build-hermes.sh ;;
esac
default_dir="${HOME}/projects/ibex/${platform_dir}/Frameworks-vanilla"
export IBEX2_VANILLA_HERMES_DIR="${IBEX2_VANILLA_HERMES_DIR:-$default_dir}"
if [ ! -d "$IBEX2_VANILLA_HERMES_DIR" ]; then
  echo "snapback2/scripts/hermes: no vanilla Hermes at $IBEX2_VANILLA_HERMES_DIR" >&2
  echo "  clone https://github.com/expo/ibex and run ./scripts/$build_script --vanilla, or set IBEX2_VANILLA_HERMES_DIR" >&2
  exit 2
fi
arch="$(uname -m)"; case "$arch" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x64 ;;
  *) arch=unsupported ;;
esac
default_hermesc="${HOME}/projects/ibex/tools/hermes-vanilla/hermesc-${platform}-${arch}"
export IBEX2_HERMESC="${IBEX2_HERMESC:-$default_hermesc}"
if [ ! -x "$IBEX2_HERMESC" ]; then
  echo "snapback2/scripts/hermes: no vanilla hermesc at $IBEX2_HERMESC (Ibex 2 compiles its bindings to bytecode at build time)" >&2
  echo "  build it with expo/ibex ./scripts/$build_script --vanilla, or set IBEX2_HERMESC" >&2
  exit 2
fi
command="${1:-build}"
if [ "$#" -gt 0 ]; then shift; fi
# Hermes-featured builds get their own target dir so they never invalidate the default build.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target/hermes}"
exec cargo "$command" --features hermes "$@"
