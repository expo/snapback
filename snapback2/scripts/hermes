#!/usr/bin/env bash
# Build the binary WITH the JS engine (Ibex 2 over vanilla Hermes) for effects.
# The default build never needs this. Ibex 2 looks for vanilla Hermes at
# IBEX2_VANILLA_HERMES_DIR; build it once with expo/ibex's scripts/build-hermes.sh --vanilla.
set -euo pipefail
cd "$(dirname "$0")/.."
default_dir="${HOME}/projects/ibex/ios/Frameworks-vanilla"
export IBEX2_VANILLA_HERMES_DIR="${IBEX2_VANILLA_HERMES_DIR:-$default_dir}"
if [ ! -d "$IBEX2_VANILLA_HERMES_DIR" ]; then
  echo "snapback2/scripts/hermes: no vanilla Hermes at $IBEX2_VANILLA_HERMES_DIR" >&2
  echo "  clone https://github.com/expo/ibex and run ./scripts/build-hermes.sh --vanilla, or set IBEX2_VANILLA_HERMES_DIR" >&2
  exit 2
fi
arch="$(uname -m)"; case "$arch" in arm64|aarch64) arch=arm64;; *) arch=x64;; esac
default_hermesc="${HOME}/projects/ibex/tools/hermes-vanilla/hermesc-macos-${arch}"
export IBEX2_HERMESC="${IBEX2_HERMESC:-$default_hermesc}"
if [ ! -x "$IBEX2_HERMESC" ]; then
  echo "snapback2/scripts/hermes: no vanilla hermesc at $IBEX2_HERMESC (Ibex 2 compiles its bindings to bytecode at build time)" >&2
  echo "  build it with expo/ibex ./scripts/build-hermes.sh --vanilla, or set IBEX2_HERMESC" >&2
  exit 2
fi
exec cargo "${1:-build}" -p snapback2 --features hermes "${@:2}"
