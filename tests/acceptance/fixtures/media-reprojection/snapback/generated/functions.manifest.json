      "runtime": {
        "IbexModule": {
          "export": "returnStoredProfile",
          "source": "globalThis.__snapbackHandlers = { \"returnStoredProfile\": (async (ctx, args) => {\n    const profile = await ctx.db\n      .query('profiles')\n      .withIndex('by_owner')\n      .eq('ownerId', ctx.auth.userId)\n      .first();\n    await ctx.db.patch('profiles', profile._id, { displayName: args.displayName });\n    return ctx.db.get('profiles', profile._id);\n  }) };\n"
        }
