  "uncertainAssignments": {
    "crates/snapback/src/agent_safe_publication.rs": "Publication is generation-adjacent, but its final extracted owner may differ from generation activation.",
    "crates/snapback/src/ask.rs": "Near-data AI provider execution is an application service; its current SecretRedactor import from generation-adjacent config is frozen residue pending a lower shared redaction shape.",
    "crates/snapback/src/auth/admission.rs": "Admission epochs fence live work so they sit with the sync engine, though they also gate batch services.",
    "crates/snapback/src/auth/deployment.rs": "Only generation/deployment activation behavior is assigned here; the remaining auth owner map is intentionally unresolved.",
    "crates/snapback/src/auth/descriptor.rs": "A pure authority-descriptor type placed on the leaf; its admin/invocation type imports are frozen upward residue to invert by moving those shapes down.",
    "crates/snapback/src/auth/handshake.rs": "Pure wire/availability computation placed on the leaf; the lease-availability import is frozen residue pending a leaf-side availability shape.",
    "crates/snapback/src/auth/invocation.rs": "Per-request authority engine placed with the sync engine; storage guards still call up into it, which the owner-2 typed-operation program is expected to invert.",
    "crates/snapback/src/auth/lifecycle.rs": "Catalog activation/maintenance placed with background services; activation ordering is coordinator-adjacent and may migrate when owner 1 absorbs auth publication.",
    "crates/snapback/src/auth/mod.rs": "Namespace-only umbrella with zero dependency edges; assigned to the leaf so future re-export edges stay downward for every caller.",
    "crates/snapback/src/auth/provider.rs": "Session-family core placed with the sync engine to keep coordinator/fence/invocation edges same-owner; its maintenance lanes may later split toward background services.",
    "crates/snapback/src/auth/rehearsal.rs": "The closed auth-rehearsal wire vocabulary and carrier-validation grammar are contract-leaf concerns; its current ServerProfile conversion is frozen upward residue for a later leaf-side profile shape.",
    "crates/snapback/src/auth/runtime.rs": "Serve-time provider composition placed with transport adapters because only server/cli compose it; it is not itself a wire adapter.",
    "crates/snapback/src/bench.rs": "Bench harness placed with transport like the bin harnesses that drive it; telemetry_bench read into it is frozen residue.",
    "crates/snapback/src/conformance.rs": "Declared-vs-captured conformance placed with the kernel because every current edge is then downward; it reads like a diagnostics service more than kernel code.",
    "crates/snapback/src/data_tier.rs": "Treated as a contract/profile type leaf pending extraction of any behavior residue.",
    "crates/snapback/src/exec_guard.rs": "Imperative debug-build thread sanctions placed on the leaf purely for dependency direction; every layer including the kernel calls it.",
    "crates/snapback/src/live_wire.rs": "Treated as the language-neutral wire leaf even though its current file may retain sync-coupled behavior.",
    "crates/snapback/src/local.rs": "Mixed hub: generation-activation behavior is targeted for owner 1, but file-level analysis leaves the current module unassigned until extraction creates a real boundary.",
