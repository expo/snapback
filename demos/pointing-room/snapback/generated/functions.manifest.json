      "runtime": {
        "IbexModule": {
          "export": "startRound",
          "source": "globalThis.__snapbackHandlers = { \"startRound\": (async (ctx, args) => {\n    const topic = args.topic.trim();\n    if (!topic) ctx.refuse('TOPIC_REQUIRED');\n    const room = await ctx.db.get('rooms', args.roomId);\n    if (!room) ctx.refuse('ROOM_NOT_FOUND');\n    const prior = await ctx.db\n      .query('rounds')\n      .withIndex('by_room_sequence')\n      .eq('roomId', args.roomId)\n      .order('sequence', 'desc')\n      .take(1)\n      .collect();\n    return await ctx.db.insert('rounds', {\n      roomId: args.roomId,\n      topic,\n      sequence: (prior[0]?.sequence ?? 0) + 1,\n      revealed: false,\n    });\n  }) };\n"
        }
      },
