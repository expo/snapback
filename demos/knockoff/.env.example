# Client-visible configuration. OAuth client ids are public identifiers.
EXPO_PUBLIC_KNOCKOFF_DEPLOYMENT_PROFILE=development
EXPO_PUBLIC_KNOCKOFF_AUTH_ORIGIN=http://127.0.0.1:3777
EXPO_PUBLIC_KNOCKOFF_APPLE_CREDENTIALS=auto
EXPO_PUBLIC_KNOCKOFF_APPLE_NATIVE_CONFIGURED=0
EXPO_PUBLIC_KNOCKOFF_GOOGLE_CREDENTIALS=auto
EXPO_PUBLIC_KNOCKOFF_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_KNOCKOFF_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_KNOCKOFF_GOOGLE_ANDROID_CONFIGURED=0
EXPO_PUBLIC_KNOCKOFF_GOOGLE_SERVER_CLIENT_ID=
EXPO_PUBLIC_KNOCKOFF_GOOGLE_WEB_CLIENT_ID=

# Build-time native configuration. Rebuild after changing this value.
KNOCKOFF_GOOGLE_IOS_URL_SCHEME=

# Broker-only configuration. Never prefix the identity secret with EXPO_PUBLIC_.
SNAPBACK_KNOCKOFF_READY_FILE=.snapback/dev.ready.json
KNOCKOFF_AUTH_FIXTURES=1
KNOCKOFF_SHARED_AUTH=1
KNOCKOFF_DEPLOYMENT_PROFILE=development
KNOCKOFF_SHARED_RETURN_TARGETS=knockoff://auth/shared
KNOCKOFF_SHARED_USER_LIMIT=100
# Preview-only server admission. Both values are required outside local development.
KNOCKOFF_SHARED_PREVIEW_OWNER_AUTHORIZED=0
KNOCKOFF_SHARED_PREVIEW_EXPIRES_AT=
KNOCKOFF_AUTH_PORT=3777
KNOCKOFF_APPLE_CLIENT_ID=com.snapback.knockoff
KNOCKOFF_GOOGLE_CLIENT_ID=
KNOCKOFF_BROKER_IDENTITY_SECRET=replace-with-at-least-32-random-characters
