# Client-visible configuration. OAuth client ids are public identifiers.
EXPO_PUBLIC_KNOCKOFF_AUTH_MODE=fixture
EXPO_PUBLIC_KNOCKOFF_AUTH_ORIGIN=http://127.0.0.1:3777
EXPO_PUBLIC_KNOCKOFF_APPLE_NATIVE_CONFIGURED=0
EXPO_PUBLIC_KNOCKOFF_GOOGLE_CLIENT_ID=replace-with-app-owned-google-client-id

# Broker-only configuration. Never prefix the identity secret with EXPO_PUBLIC_.
SNAPBACK_KNOCKOFF_READY_FILE=.snapback/dev.ready.json
KNOCKOFF_AUTH_FIXTURES=1
KNOCKOFF_AUTH_PORT=3777
KNOCKOFF_APPLE_CLIENT_ID=com.snapback.knockoff
KNOCKOFF_GOOGLE_CLIENT_ID=replace-with-app-owned-google-client-id
KNOCKOFF_BROKER_IDENTITY_SECRET=replace-with-at-least-32-random-characters
