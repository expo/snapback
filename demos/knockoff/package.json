{
  "name": "snapback-knockoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "generate": "node ../../packages/snapback-codegen/index.mjs snapback",
    "broker": "node scripts/auth-broker.mjs",
    "ios": "expo run:ios",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/auth-broker-client.test.mjs && node tests/acceptance/social-auth.mjs"
  },
  "dependencies": {
    "@expo/snapback-client": "file:../../packages/snapback-client",
    "@expo/snapback-codegen": "file:../../packages/snapback-codegen",
    "@expo/snapback-contract": "file:../../packages/snapback-contract",
    "@expo/snapback-expo": "file:../../packages/snapback-expo",
    "@expo/snapback-expo-custody": "file:../../packages/snapback-expo-custody",
    "@expo/snapback-react": "file:../../packages/snapback-react",
    "expo": "~57.0.7",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "jose": "^6.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/snapback-client": "file:../../packages/snapback-client",
    "@expo/snapback-contract": "file:../../packages/snapback-contract",
    "@expo/snapback-expo": "file:../../packages/snapback-expo",
    "@expo/snapback-expo-custody": "file:../../packages/snapback-expo-custody",
    "@expo/snapback-react": "file:../../packages/snapback-react"
  }
}
