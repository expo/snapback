{
  "name": "coterie",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node ./scripts/link-exact.mjs",
    "dev": "bun run generate:routes && node node_modules/@exact/devtools/src/scripts/vite-cli.mjs --config vite.config.mjs",
    "build": "bun run generate:routes && bun run check:platform-splits && node node_modules/@exact/devtools/src/scripts/vite-cli.mjs build --config vite.config.mjs",
    "exact:web": "bun node_modules/@exact/server/src/cli.ts --config exact.web.config.mjs",
    "generate:provider": "bun run node_modules/@exact/devtools/src/scripts/provider-generate.ts src/data/coterie.provider.json --out src/data/generated --write",
    "check:provider": "bun run node_modules/@exact/devtools/src/scripts/provider-generate.ts src/data/coterie.provider.json --out src/data/generated --check",
    "generate:routes": "bun run node_modules/@exact/devtools/src/scripts/generate-route-registries.ts --source-root src",
    "check:platform-splits": "bun run node_modules/@exact/devtools/src/scripts/check-platform-splits.ts --source-root src",
    "typecheck": "bun run generate:routes && bun run check:platform-splits && tsc --noEmit",
    "test": "bun test tests",
    "test:snapback-provider": "COTERIE_SNAPBACK_INTEGRATION=1 bun test tests/snapback-provider.test.ts tests/snapback-provider.integration.test.ts",
    "accept:coterie": "bun run ./scripts/accept-coterie.mjs",
    "verify:coterie": "bun run check:provider && bun run typecheck && bun run test && bun run build",
    "setup-mcp": "bun run node_modules/@exact/devtools/src/scripts/setup-mcp.ts"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@exact/guide": "npm:@ccheever/exact-guide@0.1.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.0"
  }
}
