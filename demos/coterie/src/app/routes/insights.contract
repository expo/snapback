use navigate from "@exact/router/contract"
use theme from "@exact/facet-contract"
use CoterieAppHeader from "../../ui/app-header.contract"
use CoterieInsightDayRow from "../../ui/insights.contract"
use CoterieInsightsSummary from "../../ui/insights.contract"
use listInsights from "../../data/generated/coterie.bindings.ts"
use listProviderClaims from "../../data/generated/coterie.bindings.ts"
use listSession from "../../data/generated/coterie.bindings.ts"
use logout from "../../data/generated/coterie.bindings.ts"

component CoterieInsightsRoute
  query session = listSession({})
  query insights = listInsights({})
  query providerClaims = listProviderClaims({})
  derive canLogout = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "logout")
  mutation logoutMutation = logout

  action choosePrimary(next)
    if next == "feed"
      navigate("/")
    else if next == "chats"
      navigate("/chats")
    else if next == "search"
      navigate("/search")
    else
      navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action showProfile
    navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action signOut mutates logoutMutation
    await logoutMutation({})

  contract
    has node testId="coterie-root"
    has node testId="sm-insights-summary"

  view
    main width="100%" minHeight="100%" background=theme.color.background.subtle testId="coterie-root"
      async session
        loading
          skeleton width="100%" height=180
        error problem
          text `${problem}` size=13 color=theme.color.text.danger padding=16
        empty
          column width="100%" maxWidth=520 alignSelf="center" padding=24 gap=12
            text "Your backendless session ended." size=17 weight=600 color=theme.color.text.default
            link href="/" label="Return to sign in" testId="coterie-return-sign-in"
              text "Return to sign in" size=14 color=theme.color.text.link
        ready activeSessions
          column width="100%" maxWidth=760 flex=1 minHeight=0 alignSelf="center" background=theme.color.background.default borderWidth=1 borderColor=theme.color.border.default testId="coterie-shell"
            CoterieAppHeader(selected="profile", select=choosePrimary, canLogout=canLogout, logout=signOut)
            scroll flex=1 width="100%" background=theme.color.background.default
              column width="100%" gap=16 padding=18
                row width="100%" align="center" justify="space-between"
                  text "Insights" size=22 weight=700 color=theme.color.text.default
                  button "Profile" press=showProfile padding=8 radius=8 background="transparent" color=theme.color.text.link testId="coterie-insights-back"
                async insights
                  loading
                    skeleton width="100%" height=240
                  error problem
                    text `${problem}` size=13 color=theme.color.text.danger
                  empty
                    text "No insight data" size=13 color=theme.color.text.secondary
                  ready days
                    CoterieInsightsSummary(posts=days[0].totalPosts, likes=days[0].totalLikesReceived, reposts=days[0].totalRepostsReceived, replies=days[0].totalRepliesReceived, followers=days[0].totalFollowers, following=days[0].totalFollowing)
                    text "Trailing 7 UTC days" size=17 weight=600 color=theme.color.text.default
                    column width="100%" testId="sm-insights-bar-list"
                      each day in days key=day.id
                        CoterieInsightDayRow(day=day.day, posts=day.posts, likesReceived=day.likesReceived)
