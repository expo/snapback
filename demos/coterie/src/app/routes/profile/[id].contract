use navigate from "@exact/router/contract"
use CoterieAppHeader from "../../../ui/app-header.contract"
use CoterieFeedCard from "../../../ui/feed-card.contract"
use CoterieProfileCard from "../../../ui/profile-card.contract"
use editProfile from "../../../data/generated/coterie.bindings.ts"
use listProfilePosts from "../../../data/generated/coterie.bindings.ts"
use listProfiles from "../../../data/generated/coterie.bindings.ts"
use listSession from "../../../data/generated/coterie.bindings.ts"
use logout from "../../../data/generated/coterie.bindings.ts"
use setFollow from "../../../data/generated/coterie.bindings.ts"
use setLike from "../../../data/generated/coterie.bindings.ts"
use setRepost from "../../../data/generated/coterie.bindings.ts"

component CoterieProfileRoute
  props
    route: object

  derive profileId = route.params.id
  state profileEditing = false
  state profileName = "Alice Alvarez"
  state profileBio = "Coffee, cameras, and neighborhood walks."

  query session = listSession({})
  query profiles = listProfiles({})
  query profilePosts = listProfilePosts({ userId: profileId })
  mutation logoutMutation = logout
  mutation editProfileMutation = editProfile
  mutation setFollowMutation = setFollow
  mutation setLikeMutation = setLike
  mutation setRepostMutation = setRepost

  action choosePrimary(next)
    if next == "feed"
      navigate("/")
    else if next == "chats"
      navigate("/chats")
    else if next == "search"
      navigate("/search")
    else
      navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action followProfile(userId, followed) mutates setFollowMutation
    await setFollowMutation({ userId: userId, following: !followed, mutationId: `coterie-follow-${userId}-${now()}` })

  action likePost(postId, liked) mutates setLikeMutation
    await setLikeMutation({ postId: postId, liked: !liked, mutationId: `coterie-like-${postId}-${now()}` })

  action repostPost(postId, reposted) mutates setRepostMutation
    await setRepostMutation({ postId: postId, reposted: !reposted, mutationId: `coterie-repost-${postId}-${now()}` })

  action openProfile(userId)
    navigate({ to: "/profile/[id]", params: { id: userId } })

  action openThread(postId)
    navigate({ to: "/media/[id]", params: { id: postId } })

  action openMedia(postId)
    navigate({ to: "/media/[id]", params: { id: postId } })

  action beginProfileEdit(name, bio) writes profileEditing, profileName, profileBio
    profileEditing = true
    profileName = name
    profileBio = bio

  action setProfileName(value) writes profileName
    profileName = value

  action setProfileBio(value) writes profileBio
    profileBio = value

  action saveProfile writes profileEditing mutates editProfileMutation
    let result = await editProfileMutation({ displayName: profileName, bio: profileBio, handle: null, location: null, link: null })
    if result.ok
      profileEditing = false

  action showInsights
    navigate("/insights")

  action signOut mutates logoutMutation
    await logoutMutation({})

  contract
    has node testId="coterie-root"
    has node testId="sm-profile"

  view
    main width="100%" minHeight="100%" background="#F4F5F7" testId="coterie-root"
      async session
        loading
          skeleton width="100%" height=180
        error problem
          text `${problem}` size=13 color="#DC2626" padding=16
        empty
          column width="100%" maxWidth=520 alignSelf="center" padding=24 gap=12
            text "Your backendless session ended." size=17 weight=600 color="#17191C"
            link href="/" label="Return to sign in" testId="coterie-return-sign-in"
              text "Return to sign in" size=14 color="#4F46E5"
        ready activeSessions
          column width="100%" maxWidth=760 flex=1 minHeight=0 alignSelf="center" background="#FFFFFF" borderWidth=1 borderColor="#E2E4E8" testId="coterie-shell"
            CoterieAppHeader(selected="profile", select=choosePrimary, logout=signOut)
            scroll flex=1 width="100%" background="#FFFFFF"
              async profiles
                loading
                  skeleton width="100%" height=240
                error problem
                  text `${problem}` size=13 color="#DC2626" padding=16
                empty
                  text "Profile unavailable" size=13 color="#6B7280" padding=16
                ready profileRows
                  when profileRows.some((profile) => profile.id == profileId)
                    each profile in profileRows key=profile.id
                      when profile.id == profileId
                        CoterieProfileCard(id=profile.id, displayName=profile.displayName, handle=profile.handle, bio=profile.bio, avatarUrl=profile.avatarUrl, followers=profile.followers, following=profile.following, followedByMe=profile.followedByMe, isMe=profile.isMe, editing=profileEditing, draftName=profileName, draftBio=profileBio, changeName=setProfileName, changeBio=setProfileBio, pressEdit=beginProfileEdit, pressSave=saveProfile, pressFollow=followProfile)
                        when profile.isMe && !profileEditing
                          column paddingLeft=18 paddingRight=18 paddingBottom=18
                            button "View insights" press=showInsights padding=10 radius=8 borderWidth=1 borderColor="#4F46E5" background="#FFFFFF" color="#4F46E5" testId="coterie-profile-insights"
                        async profilePosts
                          loading
                            skeleton width="100%" height=180
                          error problem
                            text `${problem}` size=13 color="#DC2626" padding=16
                          empty
                            text "No posts yet" size=13 color="#6B7280" padding=16
                          ready posts
                            list width="100%" label=`Posts by ${profile.displayName}`
                              each post in posts key=post.id
                                listitem width="100%"
                                  CoterieFeedCard(id=post.id, postId=post.postId, authorId=post.authorId, authorName=post.authorName, authorHandle=post.authorHandle, avatarUrl=post.avatarUrl, body=post.body, createdAt=post.createdAt, likeCount=post.likeCount, liked=post.likedByMe, repostCount=post.repostCount, reposted=post.repostedByMe, replyCount=post.replyCount, repostedByName=null, mediaUrls=post.mediaUrls, mediaKind=post.mediaKind, pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost, pressReply=openThread, pressMedia=openMedia)
                  else
                    column gap=12 padding=18
                      text "This profile isn't available" size=15 weight=600 color="#17191C"
                      link href="/" label="Back to feed" testId="coterie-profile-not-found-back"
                        text "Back to feed" size=14 color="#4F46E5"
