use back from "@exact/router/contract"
use navigate from "@exact/router/contract"
use FacetButton from "@exact/facet-contract/components/button.contract"
use CoterieAppHeader from "../../../ui/app-header.contract"
use CoterieComposer from "../../../ui/composer.contract"
use CoterieMessageBubble from "../../../ui/message-bubble.contract"
use listChats from "../../../data/generated/coterie.bindings.ts"
use listMessages from "../../../data/generated/coterie.bindings.ts"
use listProviderClaims from "../../../data/generated/coterie.bindings.ts"
use listSession from "../../../data/generated/coterie.bindings.ts"
use logout from "../../../data/generated/coterie.bindings.ts"
use sendMessage from "../../../data/generated/coterie.bindings.ts"
use setMessageReaction from "../../../data/generated/coterie.bindings.ts"

component CoterieConversationRoute
  props
    route: object

  derive chatId = route.params.id
  state messageText = ""
  state messageResetFlip = false
  state quotedMessageId = null
  state quotedSenderName = null
  state quotedBodySnippet = null
  state reactionPickerMessageId = null
  state highlightedMessageId = null

  query session = listSession({})
  query chats = listChats({})
  query messages = listMessages({ chatId: chatId })
  query providerClaims = listProviderClaims({})
  mutation logoutMutation = logout
  mutation sendMessageMutation = sendMessage
  mutation setMessageReactionMutation = setMessageReaction

  derive canSendMessages = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "sendMessage")
  derive canQuoteMessages = canSendMessages
  derive canReactToMessages = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "setMessageReaction")
  derive canLogout = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "logout")

  action choosePrimary(next)
    if next == "feed"
      navigate("/")
    else if next == "chats"
      navigate("/chats")
    else if next == "search"
      navigate("/search")
    else
      navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action goBack
    back()

  action showSettings
    navigate({ to: "/chat/[id]/settings", params: { id: chatId } })

  action setMessageText(value) writes messageText
    messageText = value

  action beginReply(messageId, senderName, body) writes quotedMessageId, quotedSenderName, quotedBodySnippet
    quotedMessageId = messageId
    quotedSenderName = senderName
    quotedBodySnippet = body.length > 96 ? `${body.slice(0, 95)}…` : body

  action cancelReply writes quotedMessageId, quotedSenderName, quotedBodySnippet
    quotedMessageId = null
    quotedSenderName = null
    quotedBodySnippet = null

  action revealQuotedMessage(messageId) writes highlightedMessageId
    highlightedMessageId = messageId

  action toggleReactionPicker(messageId) writes reactionPickerMessageId
    reactionPickerMessageId = reactionPickerMessageId == messageId ? null : messageId

  action chooseMessageReaction(messageId, emoji, reactedByMe) writes reactionPickerMessageId mutates setMessageReactionMutation
    let result = await setMessageReactionMutation({ chatId: chatId, messageId: messageId, emoji: emoji, reacted: !reactedByMe, mutationId: `coterie-reaction-${messageId}-${now()}` })
    if result.ok
      reactionPickerMessageId = null

  action sendCurrentMessage writes messageText, messageResetFlip, quotedMessageId, quotedSenderName, quotedBodySnippet mutates sendMessageMutation
    let result = await sendMessageMutation({ chatId: chatId, body: messageText.trim(), quotedMessageId: quotedMessageId })
    if result.ok
      messageText = ""
      messageResetFlip = !messageResetFlip
      quotedMessageId = null
      quotedSenderName = null
      quotedBodySnippet = null

  action signOut mutates logoutMutation
    await logoutMutation({})

  contract
    has node testId="coterie-root"
    when canSendMessages then has node testId="sm-convo-input"
    when canSendMessages then has node testId="sm-convo-send"

  view
    main width="100%" minHeight="100%" background="#F4F5F7" testId="coterie-root"
      async session
        loading
          skeleton width="100%" height=180
        error problem
          text `${problem}` size=13 color="#DC2626" padding=16
        empty
          column width="100%" maxWidth=520 alignSelf="center" padding=24 gap=12
            text "Your backendless session ended." size=17 weight=600 color="#17191C"
            link href="/" label="Return to sign in" testId="coterie-return-sign-in"
              text "Return to sign in" size=14 color="#4F46E5"
        ready activeSessions
          column width="100%" maxWidth=760 flex=1 minHeight=0 alignSelf="center" background="#FFFFFF" borderWidth=1 borderColor="#E2E4E8" testId="coterie-shell"
            CoterieAppHeader(selected="chats", select=choosePrimary, logout=signOut, canLogout=canLogout)
            async chats
              loading
                skeleton width="100%" height=72
              error problem
                text `${problem}` size=13 color="#DC2626" padding=16
              empty
                text "Conversation unavailable" size=13 color="#6B7280" padding=16
              ready chatRows
                when chatRows.some((chat) => chat.id == chatId)
                  each chat in chatRows key=chat.id
                    when chat.id == chatId
                      column width="100%" flex=1 minHeight=0
                        row width="100%" align="center" justify="space-between" padding=12 borderBottomWidth=1 borderColor="#E2E4E8"
                          FacetButton(label="Back", variant="ghost", size="sm", press=goBack, testId="coterie-conversation-back")
                          text chat.title size=17 weight=700 color="#17191C"
                          FacetButton(label="Settings", variant="ghost", size="sm", press=showSettings, testId="sm-convo-settings")
                        scroll flex=1 width="100%" background="#FFFFFF"
                          async messages
                            loading
                              skeleton width="100%" height=240
                            error problem
                              text `${problem}` size=13 color="#DC2626" padding=16 testId="sm-convo-error"
                            empty
                              text "Start the conversation" size=13 color="#6B7280" padding=16
                            ready messageRows
                              list width="100%" label=`Messages in ${chat.title}`
                                each message in messageRows key=message.id
                                  CoterieMessageBubble(id=message.id, senderName=message.senderName, body=message.body, timestamp=message.createdAt, mine=message.mine, status=message.status, quotedMessageId=message.quotedMessageId, quotedSenderName=message.quotedSenderName, quotedBodySnippet=message.quotedBodySnippet, reactions=message.reactions, edited=message.edited, deleted=message.deleted, accentColor=chat.accentColor, canQuote=canQuoteMessages, canReact=canReactToMessages, reactionPickerOpen=reactionPickerMessageId == message.id, highlighted=highlightedMessageId == message.id, reply=beginReply, revealQuoteSource=revealQuotedMessage, toggleReactions=toggleReactionPicker, chooseReaction=chooseMessageReaction)
                        when canSendMessages
                          CoterieComposer(variant="message", value=messageText, resetFlip=messageResetFlip, quotedSenderName=quotedSenderName, quotedBodySnippet=quotedBodySnippet, change=setMessageText, send=sendCurrentMessage, cancelQuote=cancelReply)
                else
                  column gap=12 padding=18
                    text "This conversation isn't available" size=15 weight=600 color="#17191C"
                    FacetButton(label="Back to conversations", variant="secondary", size="sm", press=goBack, testId="coterie-conversation-not-found-back")
