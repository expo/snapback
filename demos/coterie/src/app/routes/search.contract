use navigate from "@exact/router/contract"
use FacetInput from "@exact/facet-contract/components/input.contract"
use CoterieAppHeader from "../../ui/app-header.contract"
use CoterieSearchResult from "../../ui/search-result.contract"
use listProviderClaims from "../../data/generated/coterie.bindings.ts"
use listSession from "../../data/generated/coterie.bindings.ts"
use logout from "../../data/generated/coterie.bindings.ts"
use searchSocial from "../../data/generated/coterie.bindings.ts"

component CoterieSearchRoute
  state searchText = ""
  query session = listSession({})
  query searchResults = searchSocial({ query: searchText })
  query providerClaims = listProviderClaims({})
  derive canLogout = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "logout")
  mutation logoutMutation = logout

  action choosePrimary(next)
    if next == "feed"
      navigate("/")
    else if next == "chats"
      navigate("/chats")
    else if next == "search"
      navigate("/search")
    else
      navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action setSearchText(value) writes searchText
    searchText = value

  action openResult(kind, id)
    if kind == "person"
      navigate({ to: "/profile/[id]", params: { id: id } })
    else
      navigate({ to: "/chat/[id]", params: { id: id } })

  action signOut mutates logoutMutation
    await logoutMutation({})

  contract
    has node testId="coterie-root"
    has node testId="sm-search-input"

  view
    main width="100%" minHeight="100%" background="#F4F5F7" testId="coterie-root"
      async session
        loading
          skeleton width="100%" height=180
        error problem
          text `${problem}` size=13 color="#DC2626" padding=16
        empty
          column width="100%" maxWidth=520 alignSelf="center" padding=24 gap=12
            text "Your backendless session ended." size=17 weight=600 color="#17191C"
            link href="/" label="Return to sign in" testId="coterie-return-sign-in"
              text "Return to sign in" size=14 color="#4F46E5"
        ready activeSessions
          column width="100%" maxWidth=760 flex=1 minHeight=0 alignSelf="center" background="#FFFFFF" borderWidth=1 borderColor="#E2E4E8" testId="coterie-shell"
            CoterieAppHeader(selected="search", select=choosePrimary, canLogout=canLogout, logout=signOut)
            column padding=12 background="#FFFFFF" borderBottomWidth=1 borderColor="#E2E4E8"
              FacetInput(value=searchText, placeholder="Search people and chats", label="Search", change=setSearchText, testId="sm-search-input")
            scroll flex=1 width="100%"
              async searchResults
                loading
                  skeleton width="100%" height=180
                error problem
                  text `${problem}` size=13 color="#DC2626" padding=16 testId="coterie-search-error"
                empty
                  text "No results" size=13 color="#6B7280" padding=16
                ready results
                  list width="100%" label="Search results"
                    each result in results key=result.id
                      CoterieSearchResult(id=result.id, title=result.title, subtitle=result.subtitle, kind=result.kind, avatarUrl=result.avatarUrl, press=openResult)
