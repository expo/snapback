// Coterie's backendless feed and sign-in route.
// @ref LLP 0266#d3-presentation-port-rule — this route preserves the shared
// social-messenger semantics while remaining Contract-native and provider-free.

use navigate from "@exact/router/contract"
use theme from "@exact/facet-contract"
use CoterieAppHeader from "../../ui/app-header.contract"
use CoterieAuthForm from "../../ui/auth-form.contract"
use CoterieComposer from "../../ui/composer.contract"
use CoterieFeedList from "../../ui/feed-list.contract"
use CoterieFeedTabs from "../../ui/feed-tabs.contract"
use createCoterieFeedState from "../../data/feed-pagination.ts"
use feedNextCursor from "../../data/feed-pagination.ts"
use reduceCoterieFeedState from "../../data/feed-pagination.ts"
use visibleFeedRows from "../../data/feed-pagination.ts"
use COTERIE_COMPOSER_MEDIA_OPTIONS from "../../data/coterie-fixtures.ts"
use createPost from "../../data/generated/coterie.bindings.ts"
use listFeed from "../../data/generated/coterie.bindings.ts"
use listProviderClaims from "../../data/generated/coterie.bindings.ts"
use listSession from "../../data/generated/coterie.bindings.ts"
use login from "../../data/generated/coterie.bindings.ts"
use logout from "../../data/generated/coterie.bindings.ts"
use setLike from "../../data/generated/coterie.bindings.ts"
use setRepost from "../../data/generated/coterie.bindings.ts"

component CoterieFeedRoute
  state feedState = createCoterieFeedState()

  derive feedMode = feedState.feedTab
  derive olderFeedCursor = feedState.cursor
  derive composerMediaOptions = COTERIE_COMPOSER_MEDIA_OPTIONS

  query session = listSession({})
  query feedHead = listFeed({ mode: feedMode, cursor: null })
  query olderFeed = listFeed({ mode: feedMode, cursor: olderFeedCursor }) once
  query providerClaims = listProviderClaims({})

  // @ref LLP 0266#d11-claims-driven-affordance-visibility — every mutation
  // affordance is absent until the active provider claims that mutation.
  derive canLogin = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "login")
  derive canLogout = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "logout")
  derive canCreatePost = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "createPost")
  derive canLikePosts = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "setLike")
  derive canRepostPosts = providerClaims.ready && providerClaims.value.some((claim) => claim.name == "setRepost")

  mutation loginMutation = login
  mutation logoutMutation = logout
  mutation createPostMutation = createPost
  mutation setLikeMutation = setLike
  mutation setRepostMutation = setRepost

  action choosePrimary(next)
    if next == "feed"
      navigate("/")
    else if next == "chats"
      navigate("/chats")
    else if next == "search"
      navigate("/search")
    else
      navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action chooseFeed(next) writes feedState
    let startedFeedGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "choose-feed", generation: startedFeedGeneration, feedTab: next })

  action commitLiveHead(startedFeedGeneration, posts) writes feedState
    feedState = reduceCoterieFeedState(feedState, { kind: "live-head-delivered", generation: startedFeedGeneration, rows: posts })

  action requestFirstOlderPage(startedFeedGeneration, requestedCursor) writes feedState
    feedState = reduceCoterieFeedState(feedState, { kind: "request-older-page", generation: startedFeedGeneration, requestedCursor: requestedCursor })

  action receiveOlderPage(startedFeedGeneration, requestedCursor, posts, nextCursor) writes feedState
    feedState = reduceCoterieFeedState(feedState, { kind: "older-page-delivered", generation: startedFeedGeneration, requestedCursor: requestedCursor, rows: posts, nextCursor: nextCursor })

  action commitOlderPage(startedFeedGeneration, requestedCursor) writes feedState
    feedState = reduceCoterieFeedState(feedState, { kind: "commit-older-page", generation: startedFeedGeneration, requestedCursor: requestedCursor })

  action discardOlderPage(startedFeedGeneration, requestedCursor) writes feedState
    feedState = reduceCoterieFeedState(feedState, { kind: "discard-older-page", generation: startedFeedGeneration, requestedCursor: requestedCursor })

  action setComposeText(value) writes feedState
    let startedFeedGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "set-compose-text", generation: startedFeedGeneration, value: value })

  action toggleComposeMedia(mediaRef, mediaKind) writes feedState
    let startedFeedGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "toggle-compose-media", generation: startedFeedGeneration, mediaRef: mediaRef, mediaKind: mediaKind })

  action removeComposeMedia(mediaRef, mediaKind) writes feedState
    let startedFeedGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "remove-compose-media", generation: startedFeedGeneration, mediaRef: mediaRef, mediaKind: mediaKind })

  action publishPost writes feedState mutates createPostMutation
    let body = feedState.composeText.trim()
    let imageRefs = feedState.composeImageRefs
    let videoRefs = feedState.composeVideoRefs
    let composeGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "publish-began", generation: composeGeneration })
    let startedFeedGeneration = feedState.generation
    let result = await createPostMutation({ body: body, imageRefs: imageRefs, videoRefs: videoRefs, parentId: null })
    feedState = reduceCoterieFeedState(feedState, { kind: "publish-settled", generation: startedFeedGeneration, ok: result.ok })

  action likePost(postId, liked) writes feedState mutates setLikeMutation
    let startedFeedGeneration = feedState.generation
    let nextLiked = !liked
    let result = await setLikeMutation({ postId: postId, liked: nextLiked, mutationId: `coterie-like-${postId}-${now()}` })
    feedState = reduceCoterieFeedState(feedState, { kind: "like-settled", generation: startedFeedGeneration, ok: result.ok, postId: postId, liked: nextLiked })

  action repostPost(viewerId, postId, reposted) writes feedState mutates setRepostMutation
    let startedFeedGeneration = feedState.generation
    let nextReposted = !reposted
    let result = await setRepostMutation({ postId: postId, reposted: nextReposted, mutationId: `coterie-repost-${postId}-${now()}` })
    feedState = reduceCoterieFeedState(feedState, { kind: "repost-settled", generation: startedFeedGeneration, ok: result.ok, postId: postId, reposted: nextReposted, viewerId: viewerId })

  action openProfile(userId)
    navigate({ to: "/profile/[id]", params: { id: userId } })

  action openMedia(postId)
    navigate({ to: "/media/[id]", params: { id: postId } })

  action openThread(postId)
    navigate({ to: "/media/[id]", params: { id: postId } })

  action setEmail(value) writes feedState
    let startedFeedGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "set-email", generation: startedFeedGeneration, value: value })

  action setPassword(value) writes feedState
    let startedFeedGeneration = feedState.generation
    feedState = reduceCoterieFeedState(feedState, { kind: "set-password", generation: startedFeedGeneration, value: value })

  action signIn writes feedState mutates loginMutation
    let startedFeedGeneration = feedState.generation
    let liveHeadDeliverySequenceAtBegin = feedState.liveHeadDeliverySequence
    let result = await loginMutation({ email: feedState.email, password: feedState.password })
    if result.ok
      feedState = reduceCoterieFeedState(feedState, { kind: "sign-in-settled", generation: startedFeedGeneration, ok: true, errorMessage: "", liveHeadDeliverySequenceAtBegin: liveHeadDeliverySequenceAtBegin })
    else
      feedState = reduceCoterieFeedState(feedState, { kind: "sign-in-settled", generation: startedFeedGeneration, ok: false, errorMessage: result.error.message, liveHeadDeliverySequenceAtBegin: liveHeadDeliverySequenceAtBegin })

  action signOut writes feedState mutates logoutMutation
    let startedFeedGeneration = feedState.generation
    let liveHeadDeliverySequenceAtBegin = feedState.liveHeadDeliverySequence
    let result = await logoutMutation({})
    feedState = reduceCoterieFeedState(feedState, { kind: "sign-out-settled", generation: startedFeedGeneration, ok: result.ok, liveHeadDeliverySequenceAtBegin: liveHeadDeliverySequenceAtBegin })

  task feedHeadDelivery when [feedHead]
    if feedHead.status == "ready"
      commitLiveHead(feedState.generation, feedHead.value)

  task feedHeadInitial mount
    if feedHead.status == "ready"
      commitLiveHead(feedState.generation, feedHead.value)

  task olderFeedDelivery when [olderFeed]
    if olderFeed.status == "ready"
      receiveOlderPage(feedState.generation, feedState.inFlightCursor, olderFeed.value, feedNextCursor(olderFeed.value))

  contract
    has node testId="coterie-root"
    when feedState.feedTab == "following" then has node testId="sm-feed-tab-following"
    when feedState.feedTab == "global" then has node testId="sm-feed-tab-global"

  view
    main width="100%" minHeight="100%" background=theme.color.background.subtle testId="coterie-root"
      async session
        loading
          column width="100%" maxWidth=760 alignSelf="center" padding=24 gap=12
            skeleton width="100%" height=120 radius=16 testId="coterie-loading"
        error problem
          column width="100%" maxWidth=520 alignSelf="center" padding=24 gap=12
            text "Coterie could not start" size=22 weight=700 color=theme.color.text.default
            text `${problem}` size=13 color=theme.color.text.danger testId="coterie-error"
        empty
          column width="100%" maxWidth=520 alignSelf="center" padding=24
            when canLogin
              CoterieAuthForm(email=feedState.email, password=feedState.password, errorText=feedState.authError, changeEmail=setEmail, changePassword=setPassword, submit=signIn)
            else
              text "Sign in is unavailable from this provider" size=13 color=theme.color.text.secondary
        ready activeSessions
          column width="100%" maxWidth=760 flex=1 minHeight=0 alignSelf="center" background=theme.color.background.default borderWidth=1 borderColor=theme.color.border.default safeArea={ regions: ["container", "keyboard"] } testId="coterie-shell"
            CoterieAppHeader(selected="feed", select=choosePrimary, canLogout=canLogout, logout=signOut)
            CoterieFeedTabs(selected=feedState.feedTab, select=chooseFeed)
            when canCreatePost
              CoterieComposer(variant="post", value=feedState.composeText, resetFlip=feedState.composeResetFlip, mediaOptions=composerMediaOptions, selectedImageRefs=feedState.composeImageRefs, selectedVideoRefs=feedState.composeVideoRefs, canAttach=true, change=setComposeText, selectMedia=toggleComposeMedia, removeMedia=removeComposeMedia, send=publishPost)
            async feedHead
              loading
                skeleton width="100%" height=220
              error problem
                text `${problem}` size=13 color=theme.color.text.danger padding=16
              stale posts
                text "Showing saved posts while the provider reconnects" size=12 color=theme.color.text.warning padding=10
              empty
                when feedState.accumulatedRows.length > 0
                  CoterieFeedList(posts=visibleFeedRows(feedState.liveHeadRows, feedState.accumulatedRows, [], feedState.patches), canLike=canLikePosts, canRepost=canRepostPosts, reachedEnd=requestFirstOlderPage(feedState.generation, null), pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost(activeSessions[0].userId), pressReply=openThread, pressMedia=openMedia)
                else
                  text "No posts yet" size=13 color=theme.color.text.secondary padding=16
              ready headPosts
                when feedState.cursor
                  async olderFeed
                    loading
                      CoterieFeedList(posts=visibleFeedRows(feedState.liveHeadRows, feedState.accumulatedRows, [], feedState.patches), canLike=canLikePosts, canRepost=canRepostPosts, reachedEnd=requestFirstOlderPage(feedState.generation, null), pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost(activeSessions[0].userId), pressReply=openThread, pressMedia=openMedia)
                    error olderProblem
                      column flex=1 minHeight=0
                        text `${olderProblem}` size=13 color=theme.color.text.danger padding=16
                        CoterieFeedList(posts=visibleFeedRows(feedState.liveHeadRows, feedState.accumulatedRows, [], feedState.patches), canLike=canLikePosts, canRepost=canRepostPosts, reachedEnd=requestFirstOlderPage(feedState.generation, null), pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost(activeSessions[0].userId), pressReply=openThread, pressMedia=openMedia)
                    stale olderPosts
                      text "Showing saved older posts while the provider reconnects" size=12 color=theme.color.text.warning padding=10
                    empty
                      CoterieFeedList(posts=visibleFeedRows(feedState.liveHeadRows, feedState.accumulatedRows, [], feedState.patches), canLike=canLikePosts, canRepost=canRepostPosts, reachedEnd=commitOlderPage(feedState.generation, feedState.readyPageCursor), pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost(activeSessions[0].userId), pressReply=openThread, pressMedia=openMedia)
                    ready olderPosts
                      CoterieFeedList(posts=visibleFeedRows(feedState.liveHeadRows, feedState.accumulatedRows, olderPosts, feedState.patches), canLike=canLikePosts, canRepost=canRepostPosts, reachedEnd=commitOlderPage(feedState.generation, feedState.readyPageCursor), pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost(activeSessions[0].userId), pressReply=openThread, pressMedia=openMedia)
                else
                  CoterieFeedList(posts=visibleFeedRows(feedState.liveHeadRows, feedState.accumulatedRows, [], feedState.patches), canLike=canLikePosts, canRepost=canRepostPosts, reachedEnd=requestFirstOlderPage(feedState.generation, feedNextCursor(headPosts)), pressAuthor=openProfile, pressLike=likePost, pressRepost=repostPost(activeSessions[0].userId), pressReply=openThread, pressMedia=openMedia)
