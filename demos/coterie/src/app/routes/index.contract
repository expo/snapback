// Coterie's backendless feed and sign-in route.
// @ref LLP 0266#d3-presentation-port-rule — this route preserves the shared
// social-messenger semantics while remaining Contract-native and provider-free.

use navigate from "@exact/router/contract"
use CoterieAppHeader from "../../ui/app-header.contract"
use CoterieAuthForm from "../../ui/auth-form.contract"
use CoterieComposer from "../../ui/composer.contract"
use CoterieFeedCard from "../../ui/feed-card.contract"
use CoterieFeedTabs from "../../ui/feed-tabs.contract"
use createPost from "../../data/generated/coterie.bindings.ts"
use listFeed from "../../data/generated/coterie.bindings.ts"
use listSession from "../../data/generated/coterie.bindings.ts"
use login from "../../data/generated/coterie.bindings.ts"
use logout from "../../data/generated/coterie.bindings.ts"
use setLike from "../../data/generated/coterie.bindings.ts"

component CoterieFeedRoute
  state feedTab = "following"
  state composeText = ""
  state composeResetFlip = false
  state email = "alice@example.com"
  state password = "Alice!Clique2026"
  state authError = ""

  query session = listSession({})
  query feed = listFeed({ mode: feedTab })

  mutation loginMutation = login
  mutation logoutMutation = logout
  mutation createPostMutation = createPost
  mutation setLikeMutation = setLike

  action choosePrimary(next)
    if next == "feed"
      navigate("/")
    else if next == "chats"
      navigate("/chats")
    else if next == "search"
      navigate("/search")
    else
      navigate({ to: "/profile/[id]", params: { id: "alice" } })

  action chooseFeed(next) writes feedTab
    feedTab = next

  action setComposeText(value) writes composeText
    composeText = value

  action publishPost writes composeText, composeResetFlip mutates createPostMutation
    let body = composeText.trim()
    composeText = ""
    composeResetFlip = !composeResetFlip
    await createPostMutation({ body: body })

  action likePost(postId, liked) mutates setLikeMutation
    await setLikeMutation({ postId: postId, liked: !liked, mutationId: `coterie-like-${postId}-${now()}` })

  action openProfile(userId)
    navigate({ to: "/profile/[id]", params: { id: userId } })

  action openMedia(postId)
    navigate({ to: "/media/[id]", params: { id: postId } })

  action setEmail(value) writes email
    email = value

  action setPassword(value) writes password
    password = value

  action signIn writes authError mutates loginMutation
    let result = await loginMutation({ email: email, password: password })
    if result.ok
      authError = ""
    else
      authError = result.error.message

  action signOut mutates logoutMutation
    await logoutMutation({})

  contract
    has node testId="coterie-root"
    when feedTab == "following" then has node testId="sm-feed-tab-following"
    when feedTab == "global" then has node testId="sm-feed-tab-global"

  view
    main width="100%" minHeight="100%" background="#F4F5F7" testId="coterie-root"
      async session
        loading
          column width="100%" maxWidth=760 alignSelf="center" padding=24 gap=12
            skeleton width="100%" height=120 radius=16 testId="coterie-loading"
        error problem
          column width="100%" maxWidth=520 alignSelf="center" padding=24 gap=12
            text "Coterie could not start" size=22 weight=700 color="#17191C"
            text `${problem}` size=13 color="#DC2626" testId="coterie-error"
        empty
          column width="100%" maxWidth=520 alignSelf="center" padding=24
            CoterieAuthForm(email=email, password=password, errorText=authError, changeEmail=setEmail, changePassword=setPassword, submit=signIn)
        ready activeSessions
          column width="100%" maxWidth=760 flex=1 minHeight=0 alignSelf="center" background="#FFFFFF" borderWidth=1 borderColor="#E2E4E8" safeArea={ regions: ["container", "keyboard"] } testId="coterie-shell"
            CoterieAppHeader(selected="feed", select=choosePrimary, logout=signOut)
            CoterieFeedTabs(selected=feedTab, select=chooseFeed)
            CoterieComposer(variant="post", value=composeText, resetFlip=composeResetFlip, change=setComposeText, send=publishPost)
            scroll flex=1 width="100%"
              async feed
                loading
                  skeleton width="100%" height=220
                error problem
                  text `${problem}` size=13 color="#DC2626" padding=16
                stale posts
                  text "Showing saved posts while the provider reconnects" size=12 color="#D97706" padding=10
                empty
                  text "No posts yet" size=13 color="#6B7280" padding=16
                ready posts
                  list width="100%" label="Feed posts"
                    each post in posts key=post.id
                      listitem width="100%"
                        CoterieFeedCard(id=post.id, authorId=post.authorId, authorName=post.authorName, authorHandle=post.authorHandle, avatarUrl=post.avatarUrl, body=post.body, createdAt=post.createdAt, likeCount=post.likeCount, liked=post.likedByMe, mediaUrl=post.mediaUrl, mediaKind=post.mediaKind, pressAuthor=openProfile, pressLike=likePost, pressMedia=openMedia)
