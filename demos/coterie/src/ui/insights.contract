use theme from "@exact/facet-contract"

component CoterieInsightsSummary
  props
    posts: number
    likes: number
    reposts: number
    replies: number
    followers: number
    following: number

  contract
    has node testId="sm-insights-summary"

  view
    column width="100%" gap=8 testId="sm-insights-summary"
      row width="100%" gap=8
        CoterieInsightTile(label="Posts", value=posts, testId="sm-insights-total-posts")
        CoterieInsightTile(label="Likes received", value=likes, testId="sm-insights-total-likes-received")
      row width="100%" gap=8
        CoterieInsightTile(label="Reposts received", value=reposts, testId="sm-insights-total-reposts-received")
        CoterieInsightTile(label="Replies received", value=replies, testId="sm-insights-total-replies-received")
      row width="100%" gap=8
        CoterieInsightTile(label="Followers", value=followers, testId="sm-insights-total-followers")
        CoterieInsightTile(label="Following", value=following, testId="sm-insights-total-following")

component CoterieInsightTile
  props
    label: string
    value: number
    testId: string

  view
    column flex=1 gap=3 padding=12 radius=10 background=theme.color.background.subtle testId=testId
      text `${value}` size=22 weight=700 color=theme.color.text.default
      text label size=12 color=theme.color.text.secondary

component CoterieInsightDayRow
  props
    day: string
    posts: number
    likesReceived: number

  derive postsWidth = `${Math.min(100, posts * 20)}%`
  derive likesWidth = `${Math.min(100, likesReceived * 20)}%`

  contract
    has node testId="sm-insights-day-row"
    has node testId="sm-insights-day-posts-bar"
    has node testId="sm-insights-day-likes-bar"

  view
    row width="100%" align="center" gap=10 paddingTop=10 paddingBottom=10 borderBottomWidth=1 borderColor=theme.color.border.default testId="sm-insights-day-row"
      text day size=13 weight=600 color=theme.color.text.default width=88
      column flex=1 gap=6
        row width="100%" align="center" gap=8
          text "Posts" size=12 color=theme.color.text.secondary width=82
          column flex=1 height=8 radius=999 background=theme.color.background.subtle overflow="hidden"
            column width=postsWidth height=8 radius=999 background=theme.color.button.primary.bg testId="sm-insights-day-posts-bar"
          text `${posts}` size=12 color=theme.color.text.secondary width=32
        row width="100%" align="center" gap=8
          text "Likes received" size=12 color=theme.color.text.secondary width=82
          column flex=1 height=8 radius=999 background=theme.color.background.subtle overflow="hidden"
            column width=likesWidth height=8 radius=999 background=theme.color.status.danger.fill testId="sm-insights-day-likes-bar"
          text `${likesReceived}` size=12 color=theme.color.text.secondary width=32
