use theme from "@exact/facet-contract"
use CoterieAvatar from "./avatar.contract"
use coterieAccentForeground from "./coterie-colors.ts"

component CoterieChatListRow
  props
    id: string
    title: string
    preview: string
    timestamp: string
    unreadCount: number = 0
    avatarUrl: string = null
    accentColor: string = "#4F46E5"
    typingHint: string = null
    receiptStatus: string = null
    press: (chatId) => void

  derive summary = typingHint ? typingHint : preview
  derive receiptMark = receiptStatus == "read" ? "✓✓" : receiptStatus == "delivered" ? "✓✓" : receiptStatus == "sent" ? "✓" : null
  derive accentForeground = coterieAccentForeground(accentColor, theme.scheme)

  contract
    has node testId="sm-chats-item"
    when unreadCount > 0 then has node testId="sm-chats-unread"

  view
    listitem width="100%"
      button press=press(id) label=`Open chat with ${title}` width="100%" background=theme.color.background.default color=theme.color.text.default padding=14 borderBottomWidth=1 borderColor=theme.color.border.default testId="sm-chats-item"
        row width="100%" align="center" gap=12
          CoterieAvatar(name=title, src=avatarUrl, size=48, accent=accentColor)
          column flex=1 minWidth=0 gap=4
            row width="100%" align="center" justify="space-between"
              text title size=17 weight=unreadCount > 0 ? 700 : 600 color=theme.color.text.default
              text timestamp size=12 color=theme.color.text.secondary
            row width="100%" align="center" justify="space-between" gap=8
              row flex=1 minWidth=0 gap=5 align="center"
                when receiptMark
                  text receiptMark size=12 color=receiptStatus == "read" ? theme.color.text.info : theme.color.text.secondary
                text summary size=13 color=typingHint ? accentForeground : unreadCount > 0 ? theme.color.text.default : theme.color.text.secondary numberOfLines=1 flex=1
              when unreadCount > 0
                column minWidth=22 height=22 paddingLeft=6 paddingRight=6 radius=11 background=theme.color.button.primary.bg align="center" justify="center" testId="sm-chats-unread"
                  text `${unreadCount}` size=12 weight=700 color=theme.color.button.primary.text
