use theme from "@exact/facet-contract"
use FacetButton from "@exact/facet-contract/components/button.contract"
use CoterieAvatar from "./avatar.contract"
use coterieAccentForeground from "./coterie-colors.ts"
use coterieMessageBubbleFill from "./coterie-colors.ts"

component CoterieMessageBubble
  props
    id: string
    senderName: string
    senderAvatarUrl: string = null
    body: string
    timestamp: string
    mine: boolean = false
    status: string = "sent"
    quotedMessageId: string = null
    quotedSenderName: string = null
    quotedBodySnippet: string = null
    reactions = []
    edited: boolean = false
    deleted: boolean = false
    accentColor: string = "#4F46E5"
    canQuote: boolean = false
    canReact: boolean = false
    reactionPickerOpen: boolean = false
    highlighted: boolean = false
    reply: (messageId, senderName, body) => void
    revealQuoteSource: (messageId) => void
    toggleReactions: (messageId) => void
    chooseReaction: (messageId, emoji, reactedByMe) => void

  derive bubbleRole = highlighted ? "highlighted" : mine ? "mine" : "theirs"
  derive bubbleColor = coterieMessageBubbleFill(bubbleRole, theme.scheme)
  derive accentForeground = coterieAccentForeground(accentColor, theme.scheme)
  derive reactionChoices = ["👍", "❤️", "😂", "😮", "😢", "🙏"]
  derive replyBody = deleted ? "This message was deleted" : body
  derive receiptMark = status == "read" ? "✓✓" : status == "delivered" ? "✓✓" : "✓"

  contract
    has node testId="sm-convo-bubble"
    when mine && !deleted then has node testId="sm-convo-receipt"
    when quotedMessageId then has node testId="sm-convo-quote-preview"
    when canQuote then has node testId="sm-convo-quote"
    when canReact then has node testId="sm-convo-react"
    when canReact && reactionPickerOpen then has node testId="sm-convo-reaction"

  view
    row width="100%" justify=mine ? "flex-end" : "flex-start" paddingLeft=12 paddingRight=12 paddingTop=3 paddingBottom=3
      when !mine
        CoterieAvatar(name=senderName, src=senderAvatarUrl, size=28, accent=accentColor)
      column maxWidth="78%" align=mine ? "flex-end" : "flex-start" gap=5
        column label=deleted ? "Deleted message" : highlighted ? `Quoted message from ${senderName}` : `Message from ${senderName}` background=bubbleColor radius=18 padding=10 gap=5 borderWidth=highlighted ? 2 : 0 borderColor=accentForeground nativeId=`sm-message-${id}` testId="sm-convo-bubble"
          column gap=4
            when !mine
              text senderName size=13 weight=600 color=accentForeground
            when quotedMessageId
              // @ref LLP 0266#d3-presentation-port-rule — press drives the portable highlight while href preserves the web fragment jump.
              link href=`#sm-message-${quotedMessageId}` press=revealQuoteSource(quotedMessageId) label=`Jump to quoted message from ${quotedSenderName}` testId="sm-convo-quote-preview"
                column borderLeftWidth=3 borderColor=accentForeground paddingLeft=8 gap=2
                  text quotedSenderName size=12 weight=600 color=accentForeground numberOfLines=1
                  text quotedBodySnippet size=12 color=theme.color.text.secondary numberOfLines=2
            when deleted
              text "This message was deleted" size=15 color=theme.color.text.secondary testId="sm-convo-tombstone"
            else
              text body size=15 color=theme.color.text.default
            row align="center" justify="flex-end" gap=4
              when edited && !deleted
                text "edited" size=12 color=theme.color.text.secondary
              text timestamp size=12 color=theme.color.text.secondary
              when mine && !deleted
                text receiptMark size=13 weight=700 color=status == "read" ? theme.color.text.info : theme.color.text.secondary testId="sm-convo-receipt"
          when canReact && reactions.length > 0
            row gap=4 wrap="wrap" justify=mine ? "flex-end" : "flex-start"
              each reaction in reactions key=reaction.emoji
                button `${reaction.emoji} ${reaction.count}` press=chooseReaction(id, reaction.emoji, reaction.reactedByMe) label=`${reaction.emoji} ${reaction.count}${reaction.reactedByMe ? ", including you" : ""}` accessibilitySelected=reaction.reactedByMe paddingLeft=8 paddingRight=8 paddingTop=4 paddingBottom=4 radius=14 borderWidth=1 borderColor=reaction.reactedByMe ? accentForeground : theme.color.border.default background=reaction.reactedByMe ? theme.color.background.selected : theme.color.background.default color=theme.color.text.default testId="sm-convo-reaction-chip"
          when canQuote || canReact
            row gap=4 justify=mine ? "flex-end" : "flex-start"
              when canQuote
                FacetButton(label="Reply", variant="ghost", size="sm", press=reply(id, senderName, replyBody), testId="sm-convo-quote")
              when canReact
                FacetButton(label="React", variant="ghost", size="sm", press=toggleReactions(id), testId="sm-convo-react")
          when canReact && reactionPickerOpen
            row gap=3 padding=4 radius=18 borderWidth=1 borderColor=theme.color.border.default background=theme.color.background.card testId="sm-reaction-picker"
              each emoji in reactionChoices key=emoji
                button emoji press=chooseReaction(id, emoji, reactions.some((reaction) => reaction.emoji == emoji && reaction.reactedByMe)) label=`React ${emoji}` accessibilitySelected=reactions.some((reaction) => reaction.emoji == emoji && reaction.reactedByMe) padding=7 radius=14 background=reactions.some((reaction) => reaction.emoji == emoji && reaction.reactedByMe) ? theme.color.background.selected : theme.color.background.default color=theme.color.text.default testId="sm-convo-reaction"
