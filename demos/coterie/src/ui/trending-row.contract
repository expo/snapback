component CoterieTrendingRow
  props
    rank: number
    label: string
    postCount: number
    press: () => void

  contract
    has node testId="sm-trending-row"
    has node testId="sm-trending-rank"

  view
    button press=press label=`Trending ${rank}: ${label}` width="100%" padding=14 background="#FFFFFF" borderBottomWidth=1 borderColor="#E2E4E8" testId="sm-trending-row"
      row width="100%" align="center" gap=12
        column width=34 height=34 radius=17 background="#EEF2FF" align="center" justify="center" testId="sm-trending-rank"
          text `${rank}` size=14 weight=700 color="#4F46E5"
        column flex=1 gap=3
          text label size=15 weight=600 color="#17191C"
          text `${postCount} posts` size=13 color="#6B7280"
