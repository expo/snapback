component CoterieAvatar
  props
    name: string
    src: string = null
    size: number = 40
    accent: string = "#4F46E5"
    testId: string = null

  derive initial = name.slice(0, 1).toUpperCase()

  contract
    has node
    when src then has node
    when !src then has text

  view
    column width=size height=size radius=size / 2 overflow="hidden" align="center" justify="center" background=src ? "#E8EAEE" : accent testId=testId
      when src
        image src=src alt=name width=size height=size objectFit="cover"
      else
        text initial size=size * 0.4 weight=700 color="#FFFFFF"
