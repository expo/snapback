component CoteriePollOption
  props
    id: string
    label: string
    votes: number
    selected: boolean = false
    press: (optionId) => void

  contract
    has node testId="sm-poll-option"
    has node testId="sm-poll-tally"

  view
    button press=press(id) label=`${label}, ${votes} votes` accessibilitySelected=selected width="100%" padding=10 radius=10 borderWidth=1 borderColor=selected ? "#4F46E5" : "#E2E4E8" background=selected ? "#EEF2FF" : "#FFFFFF" testId="sm-poll-option"
      row width="100%" justify="space-between" align="center" gap=8
        text label size=14 weight=selected ? 600 : 400 color="#17191C"
        text `${votes}` size=13 color="#6B7280" testId="sm-poll-tally"
