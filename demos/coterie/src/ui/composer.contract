use FacetButton from "@exact/facet-contract/components/button.contract"
use FacetInput from "@exact/facet-contract/components/input.contract"

component CoterieComposer
  props
    variant: "post" | "reply" | "message" = "post"
    value: string
    resetFlip: boolean = false
    change: (value) => void
    send: () => void

  derive isSocialPost = variant != "message"
  derive isReply = variant == "reply"
  derive inputId = isSocialPost ? "sm-compose-input" : "sm-convo-input"
  derive sendId = isSocialPost ? "sm-compose-submit" : "sm-convo-send"
  derive placeholder = isReply ? "Write a reply" : isSocialPost ? "What's happening?" : "Message"
  derive sendLabel = isReply ? "Reply" : isSocialPost ? "Post" : "Send"
  derive empty = value.trim() == ""

  contract
    has input

  view
    row width="100%" align="center" gap=8 padding=10 background="#FFFFFF" borderWidth=1 borderColor="#E2E4E8" safeArea={ regions: ["keyboard"] }
      column flex=1 minWidth=0 height=44 position="relative"
        column position="absolute" top=0 left=0 right=0 opacity=resetFlip ? 1 : 0 inert=!resetFlip
          FacetInput(value=value, placeholder=placeholder, label=placeholder, change=change, grow=1, disabled=!resetFlip, testId=resetFlip ? inputId : null)
        column position="absolute" top=0 left=0 right=0 opacity=resetFlip ? 0 : 1 inert=resetFlip
          FacetInput(value=value, placeholder=placeholder, label=placeholder, change=change, grow=1, disabled=resetFlip, testId=resetFlip ? null : inputId)
      FacetButton(label=sendLabel, press=send, disabled=empty, size="sm", testId=sendId)
