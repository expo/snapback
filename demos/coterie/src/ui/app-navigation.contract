use theme from "@exact/facet-contract"

component CoterieNavigation
  props
    selected: string
    select: (value) => void

  contract
    has node testId="coterie-nav"

  view
    nav label="Primary" width="100%" background=theme.color.background.card borderWidth=1 borderColor=theme.color.border.default radius=16 padding=6 testId="coterie-nav"
      row width="100%" gap=4
        button "Feed" press=select("feed") accessibilitySelected=selected == "feed" flex=1 padding=10 radius=10 background=selected == "feed" ? theme.color.background.selected : "transparent" color=theme.color.text.default testId="coterie-nav-feed"
        button "Chats" press=select("chats") accessibilitySelected=selected == "chats" flex=1 padding=10 radius=10 background=selected == "chats" ? theme.color.background.selected : "transparent" color=theme.color.text.default testId="coterie-nav-chats"
        button "Search" press=select("search") accessibilitySelected=selected == "search" flex=1 padding=10 radius=10 background=selected == "search" ? theme.color.background.selected : "transparent" color=theme.color.text.default testId="coterie-nav-search"
        button "Profile" press=select("profile") accessibilitySelected=selected == "profile" flex=1 padding=10 radius=10 background=selected == "profile" ? theme.color.background.selected : "transparent" color=theme.color.text.default testId="coterie-nav-profile"
