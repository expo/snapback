use theme from "@exact/facet-contract"
use CoterieAvatar from "./avatar.contract"

component CoterieSearchResult
  props
    id: string
    title: string
    subtitle: string
    kind: string
    avatarUrl: string = null
    press: (kind, id) => void

  contract
    has node testId="sm-search-result"

  view
    listitem width="100%"
      button press=press(kind, id) label=`Open ${title}` width="100%" padding=12 background=theme.color.background.default borderBottomWidth=1 borderColor=theme.color.border.default color=theme.color.text.default testId="sm-search-result"
        row width="100%" align="center" gap=12
          CoterieAvatar(name=title, src=avatarUrl, size=40, tone=kind)
          column flex=1 gap=3
            text title size=15 weight=600 color=theme.color.text.default
            text subtitle size=13 color=theme.color.text.secondary
          text kind size=12 color=theme.color.text.tertiary
