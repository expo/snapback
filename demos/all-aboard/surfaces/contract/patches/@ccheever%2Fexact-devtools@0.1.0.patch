+// ENG-23908: Vite's `vite:define` transform skips client-consumer
+// environments — on dev-web the configured `define` constants are instead
+// assigned onto `globalThis` by /@vite/client (clientInjectionsPlugin), so
+// free identifiers still resolve in the browser. The Exact native
+// environments are client-consumer too, but Hermes never loads
+// /@vite/client, so a configured define (e.g. Snapback's
+// `__SNAPBACK_API_ORIGIN__`) reached native module source as a free
+// identifier and threw ReferenceError before the app mounted. Inline the
+// environment's configured defines with esbuild's AST-aware `define`
+// (shadowed locals and string literals stay untouched), matching build
+// semantics on the native dev path. Serves both /__exact/module-bundle and
+// the startup artifact — they share these module records.
+export interface ExactNativeDefineReplacements {
+  define: Record<string, string>;
+  pattern: RegExp;
+}
+
+const exactNativeDefineReplacementsCache = new WeakMap<
+  object,
+  ExactNativeDefineReplacements | null
+>();
+
+const EXACT_NATIVE_DEFINE_KEY_PATTERN =
+  /^[A-Za-z_$][A-Za-z0-9_$]*(?:\.[A-Za-z_$][A-Za-z0-9_$]*)*$/;
+
+export function buildExactNativeDefineReplacements(
+  configuredDefine: Record<string, unknown> | undefined,
+): ExactNativeDefineReplacements | null {
+  const define: Record<string, string> = {};
+  for (const [key, value] of Object.entries(configuredDefine ?? {})) {
+    // Only identifier dot-chains are expressible as esbuild defines, and
+    // `import.meta.*` stays owned by Vite's own env handling.
+    if (
+      !EXACT_NATIVE_DEFINE_KEY_PATTERN.test(key) ||
+      key === 'import' ||
+      key.startsWith('import.')
+    ) {
+      continue;
+    }
+    // Same value handling as vite:define's handleDefineValue: strings are
+    // raw expressions, everything else serializes to a literal.
+    define[key] =
+      value === undefined
+        ? 'undefined'
+        : typeof value === 'string'
+          ? value
+          : JSON.stringify(value);
+  }
+  const keys = Object.keys(define);
+  if (keys.length === 0) {
+    return null;
+  }
+  // Same shape as vite:define's pattern gate: each dot may appear as an
+  // optional-chain access in authored source.
+  const pattern = new RegExp(
+    keys.map((key) => escapeRegExp(key).replace(/\\\./g, '\\??\\.')).join('|'),
+  );
+  return { define, pattern };
