// All Aboard — the Caltrain next-train Contract surface (LLP 0027).
//
// One .contract, rendered on web (DOM mirror) and native macOS/iOS (Rust kernel).
// Live Snapback data arrives through `query` bindings over the generated
// liveTrainStatus/feedState descriptors — server push over the shared live
// socket (LLP 0034 D1; Exact LLP 0284 §5.3), no hand-written pump, no store.
// The view derives from pure helpers in ./data.ts, passing the bound rows as
// arguments. A 1s `every` ticker advances nowMs so countdowns tick (UI clock,
// not transport). The delays region carries a `stale rows` arm (Exact LLP 0284
// §2.2 connection sugar): on a missed freshness budget the board keeps
// rendering last-known delays under a visible reconnecting note.
//
// Design: full-bleed poster-stylized station artwork (model.mjs stationPhoto —
// legibility scrims are baked into its SVG wrapper) with the departure board
// typeset directly on it: station identity at the top, the answer — a giant
// countdown — at the bottom where thumbs live. `heroOffset` walks the upcoming
// trains in the active direction.
//
// Interaction is gesture-first ON WEB via surface glue (gestures.ts): swipe
// left/right = adjacent station, swipe up/down = later/earlier train, bare tap
// = flip direction. Contract still has no swipe primitive (LLP 0027 gesture
// gap; LLP 0029 G1), so the glue drives the same press affordances declared
// here — edge chevrons, the ▲▼ train arrows, the flip pill — which stay
// visible, agent-checkable by testId, and identical on web and native.
//
// Composition: the root AllAboard component owns all state, derives, actions,
// and the contract block; the screen components below are presentational and
// take data plus root actions as ordinary callback props (`goToStation: (id)
// => void`, bound bare or curried at the use site as press=goToStation(s.id)).
// Threading actions through props is the existing mechanism the earlier
// one-component workaround missed; this split is the phase-1 evidence for the
// Exact repo's LLP 0280 action-threading proof (ENG-22417).
//
// Palette literals are inlined (as in demos/todo-v2) so the file compiles
// identically under the acceptance compiler and the browser Vite host.

use applyFeedTick from "../../snapback/generated/contract/applyFeedTick.mutation.ts"
use liveTrainStatus from "../../snapback/generated/contract/liveTrainStatus.query.ts"
use liveDepartures from "../../snapback/generated/contract/liveDepartures.query.ts"
use feedState from "../../snapback/generated/contract/feedState.query.ts"

use getSelectedStation from "./data.ts"
use searchStations from "./data.ts"
use adjacentStationId from "./data.ts"
use stationPhoto from "./data.ts"
use stationPhotoCredit from "./data.ts"
use locationHint from "./data.ts"
use activeDirection from "./data.ts"
use oppositeDirection from "./data.ts"
use directionTitle from "./data.ts"
use getDirectionBoard from "./data.ts"
use serviceFilterOptions from "./data.ts"
use boardTrains from "./data.ts"
use delayLabel from "./data.ts"
use delayColor from "./data.ts"
use shortHeadsign from "./data.ts"
use getTrainRun from "./data.ts"
use upcomingStops from "./data.ts"
use stopClockLabel from "./data.ts"
use formatClockTime from "./data.ts"
use formatCountdownMinutes from "./data.ts"
use serviceColor from "./data.ts"
use serviceTint from "./data.ts"
use etaModeLabel from "./data.ts"
use walkBikeSummary from "./data.ts"
use distanceLabel from "./data.ts"
use feedFreshness from "./data.ts"
use feedProblem from "./data.ts"
use feedSourceBadge from "./data.ts"
use positionFraction from "./data.ts"
use positionLabel from "./data.ts"
use fractionPercent from "./data.ts"

component AllAboard
  state nowMs = now()
  state stationId = null
  state directionOverride = null
  state screen = "home"
  state tripId = null
  state query = ""
  state heroOffset = 0
  state serviceFilter = "All"
  state etaMode = "walk"

  query delayRows = liveTrainStatus({})
  query departureRows = liveDepartures({})
  query feedRows = feedState({})

  derive station = getSelectedStation(stationId, nowMs)
  derive art = stationPhoto(station.id)
  derive photoCredit = stationPhotoCredit(station.id)
  derive locHint = locationHint(nowMs)
  derive activeDir = activeDirection(directionOverride, station)
  derive oppositeDir = oppositeDirection(activeDir)
  derive board = boardTrains(station.id, activeDir, nowMs, heroOffset, delayRows, departureRows, feedRows, serviceFilter)
  derive oppositeBoard = getDirectionBoard(station.id, oppositeDir, nowMs, 1, delayRows, departureRows, feedRows)
  derive prevStationId = adjacentStationId(station.id, -1)
  derive nextStationId = adjacentStationId(station.id, 1)
  derive walkBike = walkBikeSummary(station, etaMode, nowMs)
  derive freshness = feedFreshness(nowMs, feedRows)
  derive feedIssue = feedProblem(feedRows)
  derive feedSource = feedSourceBadge(feedRows, nowMs)
  derive matches = searchStations(query, nowMs)
  derive trip = tripId ? getTrainRun(tripId, nowMs, delayRows, departureRows) : null

  mutation refresh = applyFeedTick

  action tick writes nowMs
    nowMs = now()
  action goToStation(id) writes stationId, screen, query, heroOffset
    stationId = id
    screen = "home"
    query = ""
    heroOffset = 0
  action toggleDirection(next) writes directionOverride, heroOffset
    directionOverride = next
    heroOffset = 0
  action trainPrev writes heroOffset
    heroOffset = heroOffset > 0 ? heroOffset - 1 : 0
  action trainNext writes heroOffset
    heroOffset = heroOffset < 8 ? heroOffset + 1 : heroOffset
  action setServiceFilter(value) writes serviceFilter, heroOffset
    serviceFilter = value
    heroOffset = 0
  action toggleEtaMode writes etaMode
    etaMode = etaMode == "walk" ? "bike" : "walk"
  // The real geolocation re-request is web-surface glue (main.ts intercepts
  // the location-hint press, ENG-22795); the action re-stamps the clock so the
  // hint re-derives immediately once the glue updates the device location.
  action requestLocation writes nowMs
    nowMs = now()
  action openStations writes screen, query
    screen = "stations"
    query = ""
  action setQuery(value) writes query
    query = value
  action openTrip(id) writes tripId, screen
    tripId = id
    screen = "trip"
  action goHome writes screen, tripId
    screen = "home"
    tripId = null
  action doRefresh mutates refresh
    refresh({ trigger: "manual" })

  task ticker mount
    every(1000, tick)

  contract
    has button "Change station"
    when screen == "home" then has button "Flip direction"
    when screen == "home" then has node testId="service-filter"
    when screen == "home" then has node testId="data-source"
    when screen == "stations" then has input label="Search stations"

  view
    main background="#05070f" flex=1 width="100%" minHeight="100%" testId="all-aboard-main"
      stack flex=1 width="100%" minHeight="100%" overflow="hidden"

        // Full-bleed station artwork behind everything.
        when art == ""
          column position="absolute" top=0 left=0 right=0 bottom=0 background="#0b0e1a"
        else
          image svgSource=art alt=`${station.name} station artwork` position="absolute" top=0 left=0 right=0 bottom=0 width="100%" height="100%" objectFit="cover" testId="station-art"

        when screen == "home"
          column position="absolute" top=0 left=0 right=0 bottom=0 justify="space-between" testId="board-content"
            StationCard(station=station, walkBike=walkBike, locHint=locHint, etaMode=etaMode, openStations=openStations, toggleEtaMode=toggleEtaMode, requestLocation=requestLocation)
            // The delays region dispatches on the live binding: `stale` (Exact
            // LLP 0284 §2.2 sugar) wins over `ready` while the connection is
            // degraded — same board, last-known delays, a visible note.
            async delayRows
              loading
                column paddingLeft=20 paddingRight=20 paddingBottom=16 width="100%" maxWidth=620 alignSelf="center"
                  text "Connecting to live delays…" size=12 color="#ffffff73" testId="delays-loading"
              stale rows
                column gap=8 width="100%"
                  row justify="center" width="100%"
                    row radius=999 paddingLeft=12 paddingRight=12 paddingTop=5 paddingBottom=5 background="#fbbf2422" borderWidth=1 borderColor="#fbbf2447"
                      text "Reconnecting — showing last-known delays" size=11 weight=700 color="#fbbf24" testId="delays-stale"
                  DirectionBoard(stationId=station.id, nowMs=nowMs, activeDir=activeDir, oppositeDir=oppositeDir, board=board, oppositeBoard=oppositeBoard, serviceFilter=serviceFilter, freshness=freshness, feedIssue=feedIssue, feedSource=feedSource, photoCredit=photoCredit, delayRows=rows, departureRows=departureRows, toggleDirection=toggleDirection, openTrip=openTrip, trainPrev=trainPrev, trainNext=trainNext, setServiceFilter=setServiceFilter, doRefresh=doRefresh)
              ready rows
                DirectionBoard(stationId=station.id, nowMs=nowMs, activeDir=activeDir, oppositeDir=oppositeDir, board=board, oppositeBoard=oppositeBoard, serviceFilter=serviceFilter, freshness=freshness, feedIssue=feedIssue, feedSource=feedSource, photoCredit=photoCredit, delayRows=rows, departureRows=departureRows, toggleDirection=toggleDirection, openTrip=openTrip, trainPrev=trainPrev, trainNext=trainNext, setServiceFilter=setServiceFilter, doRefresh=doRefresh)
        else
          when screen == "stations"
            StationsPicker(query=query, matches=matches, nowMs=nowMs, currentStationId=station.id, etaMode=etaMode, setQuery=setQuery, goToStation=goToStation, goHome=goHome)
          else
            TripDetail(trip=trip, stationId=station.id, goHome=goHome)

        // Edge chevrons: the visible, pressable stand-in for the swipe.
        when screen == "home"
          button press=goToStation(prevStationId) label="Previous station" testId="prev-station" position="absolute" left=0 top="17%" bottom="58%" width=42 background="transparent" borderWidth=0 justify="center" align="center"
            text "‹" size=34 weight=700 color=prevStationId == station.id ? "#ffffff1f" : "#ffffff66"
          button press=goToStation(nextStationId) label="Next station" testId="next-station" position="absolute" right=0 top="17%" bottom="58%" width=42 background="transparent" borderWidth=0 justify="center" align="center"
            text "›" size=34 weight=700 color=nextStationId == station.id ? "#ffffff1f" : "#ffffff66"

// The station identity block, typeset on the artwork: wordmark + change-station
// pill, the station name, and the zone / walk / bike / location lines.
component StationCard
  props
    station: object
    walkBike: string
    locHint: string
    etaMode: string
    openStations: () => void
    toggleEtaMode: () => void
    requestLocation: () => void

  view
    column gap=4 paddingTop=20 paddingLeft=22 paddingRight=22 width="100%" maxWidth=620 alignSelf="center" testId="station-card"
      row justify="space-between" align="center" width="100%"
        text "CALTRAIN" size=12 weight=800 letterSpacing=2.6 color="#ffffffc9"
        button press=openStations label="Change station" testId="change-station" paddingTop=6 paddingBottom=6 paddingLeft=13 paddingRight=13 radius=999 background="#ffffff1c" borderWidth=1 borderColor="#ffffff24"
          text "Change station" size=12 weight=600 color="#ffffffe6"
      text station.name size=38 weight=800 lineHeight=42 color="#ffffff" testId="station-name" headingLevel=1
      // E4: the ETA mode control — the summary (and the stations-list rows)
      // follow the selected mode app-wide.
      row justify="space-between" align="center" width="100%"
        text `Zone ${station.zone} · ${walkBike}` size=13 color="#ffffffb8" testId="walk-bike"
        button press=toggleEtaMode label="Toggle ETA mode" testId="eta-mode" paddingTop=4 paddingBottom=4 paddingLeft=10 paddingRight=10 radius=999 background="#ffffff12" borderWidth=1 borderColor="#ffffff1a"
          text etaModeLabel(etaMode) size=11 weight=700 color="#ffffffe6"
      // A button, not bare text: pressing re-requests the geolocation prompt
      // from a user gesture (ENG-22795), and button-ness keeps the bare-tap
      // direction-flip gesture from also firing on this line (gestures.ts).
      button press=requestLocation label="Use my location" testId="location-hint" background="transparent" borderWidth=0 paddingTop=0 paddingBottom=0 paddingLeft=0 paddingRight=0
        text locHint size=12 color="#ffffff73"

// The board: direction row, the giant hero countdown expanded with its stops,
// the ▲▼ train-selection arrows, the three departures after it, the opposite
// direction line, and the freshness / refresh / credit footer.
component DirectionBoard
  props
    stationId: string
    nowMs: number
    activeDir: string
    oppositeDir: string
    board: object
    oppositeBoard: object
    serviceFilter: string
    freshness: string
    feedIssue: string
    feedSource: object
    photoCredit: string
    delayRows: object[]
    departureRows: object[]
    toggleDirection: (next) => void
    openTrip: (id) => void
    trainPrev: () => void
    trainNext: () => void
    setServiceFilter: (value) => void
    doRefresh: () => void

  view
    column gap=9 paddingLeft=20 paddingRight=20 paddingBottom=10 width="100%" maxWidth=620 alignSelf="center" testId="home-screen"
      row justify="space-between" align="center" width="100%" testId="direction-toggle"
        text directionTitle(activeDir) size=16 weight=800 letterSpacing=0.4 color="#ffffff" testId="active-direction"
        button press=toggleDirection(oppositeDir) label="Flip direction" testId="flip-direction" paddingTop=6 paddingBottom=6 paddingLeft=13 paddingRight=13 radius=999 background="#ffffff1c" borderWidth=1 borderColor="#ffffff24"
          text `⇄ ${directionTitle(oppositeDir)}` size=12 weight=700 color="#ffffffe6"

      // Service-filter chips (E3): the whole board — hero included — shows
      // only the selected service class; 'All' restores everything.
      row gap=6 width="100%" testId="service-filter"
        each f in serviceFilterOptions() key=f.id
          button press=setServiceFilter(f.id) label=`Show ${f.label} trains` testId=`service-filter-${f.label}` paddingTop=5 paddingBottom=5 paddingLeft=12 paddingRight=12 radius=999 background=serviceFilter == f.id ? "#ffffff2b" : "#ffffff12" borderWidth=1 borderColor=serviceFilter == f.id ? "#ffffff42" : "#ffffff1a"
            text f.label size=12 weight=serviceFilter == f.id ? 700 : 500 color=serviceFilter == f.id ? "#ffffff" : "#ffffffb8"

      when board.hero
        column gap=9 width="100%"
          row gap=12 align="center" width="100%"
            // Hero: the next train, expanded — tap opens its detail.
            button press=openTrip(board.hero.id) label="Open next train" testId="hero-departure" background="transparent" borderWidth=0 padding=0 flex=1
              column gap=7 width="100%" align="flex-start"
                row align="flex-end" gap=9 width="100%"
                  text `${formatCountdownMinutes(board.hero.predictedDepartureMs, nowMs)}` size=98 weight=800 lineHeight=92 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color="#ffffff" testId="hero-minutes"
                  text "min" size=17 weight=600 color="#ffffffa6" paddingBottom=12
                  spacer
                  column gap=6 align="flex-end" paddingBottom=10
                    row radius=999 paddingLeft=11 paddingRight=11 paddingTop=4 paddingBottom=4 background=serviceTint(board.hero.service)
                      text board.hero.service size=12 weight=700 color=serviceColor(board.hero.service) testId="hero-service"
                    text `${formatClockTime(board.hero.predictedDepartureMs)} · #${board.hero.trainNumber}` size=12 family="ui-monospace, Menlo, monospace" color="#ffffff96" testId="hero-meta"
                    text delayLabel(board.hero) size=12 weight=700 color=delayColor(board.hero)
                text `to ${board.hero.headsign}` size=15 weight=600 color="#ffffffd9"
                row gap=6 wrap="wrap" width="100%"
                  each stop in upcomingStops(board.hero.id, stationId, nowMs, 4, delayRows, departureRows) key=stop.id
                    row radius=999 paddingLeft=10 paddingRight=10 paddingTop=4 paddingBottom=4 background=stop.isBoarding ? "#ffffff2b" : "#ffffff14"
                      text `${stop.time} ${stop.name}` size=11 weight=stop.isBoarding ? 700 : 500 family="ui-monospace, Menlo, monospace" color=stop.isBoarding ? "#ffffff" : "#ffffffb8"
            // Walk the upcoming trains (swipe up/down drives these same arrows).
            column gap=8
              button press=trainPrev label="Earlier train" testId="train-prev" disabled=!board.hasPrev width=38 height=38 radius=19 background="#ffffff17" borderWidth=1 borderColor="#ffffff21" justify="center" align="center" opacity=board.hasPrev ? 1 : 0.35
                text "▲" size=12 weight=800 color="#ffffffd9"
              button press=trainNext label="Later train" testId="train-next" disabled=!board.hasNext width=38 height=38 radius=19 background="#ffffff17" borderWidth=1 borderColor="#ffffff21" justify="center" align="center" opacity=board.hasNext ? 1 : 0.35
                text "▼" size=12 weight=800 color="#ffffffd9"

          // The three departures after the hero.
          column gap=7 width="100%"
            each d in board.rest key=d.id
              button press=openTrip(d.id) label="Open train" testId=`departure-${d.id}` background="transparent" borderWidth=0 padding=0 width="100%"
                row justify="space-between" align="center" radius=14 paddingTop=10 paddingBottom=10 paddingLeft=14 paddingRight=14 background="#0d1322a8" borderWidth=1 borderColor="#ffffff12" width="100%"
                  row gap=8 align="center"
                    text `${formatCountdownMinutes(d.predictedDepartureMs, nowMs)}` size=17 weight=800 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color="#ffffff" width=36 textAlign="right"
                    text "min" size=11 color="#ffffff73"
                    row radius=999 paddingLeft=8 paddingRight=8 paddingTop=2 paddingBottom=2 background=serviceTint(d.service)
                      text d.service size=10 weight=700 color=serviceColor(d.service)
                  text `${formatClockTime(d.predictedDepartureMs)} · ${shortHeadsign(d)}` size=12 family="ui-monospace, Menlo, monospace" color="#ffffff8a"
      else
        column radius=16 padding=18 background="#0d1322b8" borderWidth=1 borderColor="#ffffff14"
          text "No more trains today in this direction." size=14 color="#ffffffb8" testId="no-trains"

      // Opposite direction, minimal — and itself a flip affordance.
      when oppositeBoard.primary
        button press=toggleDirection(oppositeDir) label=`Show ${directionTitle(oppositeDir)}` testId="opposite-line" background="transparent" borderWidth=0 padding=0 width="100%"
          row justify="space-between" align="center" radius=14 paddingTop=9 paddingBottom=9 paddingLeft=14 paddingRight=14 background="#0d13227d" borderWidth=1 borderColor="#ffffff0f" width="100%"
            row gap=8 align="center"
              text "⇅" size=13 color="#ffffff8a"
              text directionTitle(oppositeDir) size=13 weight=700 color="#ffffffb8"
            row gap=5 align="center"
              text `${formatCountdownMinutes(oppositeBoard.primary.predictedDepartureMs, nowMs)}` size=15 weight=800 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color="#ffffff"
              text "min" size=11 color="#ffffff73"

      row justify="space-between" align="center" width="100%" paddingTop=2
        // The data-source badge: amber "DEMO DATA" on the recorded/seed feed,
        // green "LIVE" only after a real 511 snapshot commits (lastSource).
        row gap=7 align="center"
          row radius=999 paddingLeft=8 paddingRight=8 paddingTop=3 paddingBottom=3 background=feedSource.tint borderWidth=1 borderColor=feedSource.border
            text feedSource.label size=10 weight=800 letterSpacing=1 color=feedSource.color testId="data-source"
          text freshness size=12 color="#ffffff73" testId="freshness"
        button press=doRefresh label="Refresh" testId="refresh" paddingTop=5 paddingBottom=5 paddingLeft=12 paddingRight=12 radius=999 background="#ffffff1c" borderWidth=1 borderColor="#ffffff24"
          text "Refresh" size=12 weight=700 color="#ffffffe6"
      // Why the board is on the recorded feed instead of live 511 — the
      // actionable lastError refreshFeed commits on fallback (ENG-22751).
      when feedIssue != ""
        text feedIssue size=11 color="#fbbf24" width="100%" testId="feed-problem"
      when photoCredit != ""
        text photoCredit size=10 color="#ffffff4d" textAlign="center" width="100%" testId="photo-credit"

// The stations screen: a dark sheet over the artwork — search, match rows
// (current station highlighted), Done.
component StationsPicker
  props
    query: string
    matches: object[]
    nowMs: number
    currentStationId: string
    etaMode: string
    setQuery: (value) => void
    goToStation: (id) => void
    goHome: () => void

  view
    scroll position="absolute" top=0 left=0 right=0 bottom=0 background="#05070fe6" testId="stations-screen"
      column gap=10 padding=20 paddingTop=22 maxWidth=620 alignSelf="center" width="100%"
        row justify="space-between" align="center" width="100%"
          text "Stations" size=24 weight=800 color="#ffffff" headingLevel=1
          button press=goHome label="Back" testId="stations-back" paddingTop=6 paddingBottom=6 paddingLeft=13 paddingRight=13 radius=999 background="#ffffff1c" borderWidth=1 borderColor="#ffffff24"
            text "Done" size=12 weight=700 color="#ffffffe6"
        input value=query change=setQuery placeholder="Search stations" label="Search stations" testId="station-search" padding=12 radius=12 background="#ffffff14" borderColor="#ffffff26" borderWidth=1 color="#ffffff" size=14
        column gap=2
          each s in matches key=s.id
            button press=goToStation(s.id) label=s.name testId=`station-${s.id}` background="transparent" borderWidth=0 padding=0 width="100%"
              row justify="space-between" align="center" gap=12 paddingTop=11 paddingBottom=11 paddingLeft=12 paddingRight=12 radius=12 background=s.id == currentStationId ? "#ffffff17" : "transparent" width="100%"
                column gap=2 align="flex-start"
                  text s.name size=15 weight=s.id == currentStationId ? 700 : 600 color="#ffffff"
                  text `Zone ${s.zone}` size=11.5 color="#ffffff73"
                text distanceLabel(s, etaMode, nowMs) size=12 family="ui-monospace, Menlo, monospace" color="#ffffff8a"

// The trip screen: a dark sheet over the artwork — service + train header,
// live position bar (service-colored), the ordered stop list with the boarding
// station highlighted, and Back.
component TripDetail
  props
    trip: object
    stationId: string
    goHome: () => void

  view
    scroll position="absolute" top=0 left=0 right=0 bottom=0 background="#05070fe6" testId="trip-screen"
      column gap=12 padding=20 paddingTop=22 maxWidth=620 alignSelf="center" width="100%"
        row justify="space-between" align="center" width="100%"
          button press=goHome label="Back" testId="trip-back" paddingTop=6 paddingBottom=6 paddingLeft=13 paddingRight=13 radius=999 background="#ffffff1c" borderWidth=1 borderColor="#ffffff24"
            text "‹ Board" size=12 weight=700 color="#ffffffe6"
          when trip
            row radius=999 paddingLeft=11 paddingRight=11 paddingTop=4 paddingBottom=4 background=serviceTint(trip.service)
              text trip.service size=12 weight=700 color=serviceColor(trip.service)
        when trip
          column gap=12 width="100%"
            column gap=3
              text `Train ${trip.trainNumber}` size=28 weight=800 color="#ffffff" headingLevel=1
              text `${trip.origin.name} → ${trip.destination.name}` size=14 color="#ffffffb8"
              text `${trip.durationMinutes} min · ${trip.stopCount} stops · ${delayLabel(trip)}` size=12 color="#ffffff8a"
            column gap=8 radius=16 padding=14 background="#0d1322b8" borderWidth=1 borderColor="#ffffff14"
              text positionLabel(trip) size=13 weight=600 color="#ffffffd9" testId="position-label"
              column height=6 radius=3 background="#ffffff1f" width="100%"
                column height=6 radius=3 background=serviceColor(trip.service) width=fractionPercent(positionFraction(trip)) testId="position-bar"
            column gap=0 radius=16 padding=8 background="#0d1322b8" borderWidth=1 borderColor="#ffffff14"
              each stop in trip.stops key=stop.station.id
                row gap=12 align="center" paddingTop=7 paddingBottom=7 paddingLeft=10 paddingRight=10 radius=10 background=stop.station.id == stationId ? "#ffffff14" : "transparent"
                  text stopClockLabel(stop) size=13 family="ui-monospace, Menlo, monospace" color="#ffffff8a" width=56
                  column width=8 height=8 radius=4 background=stop.station.id == stationId ? "#ffffff" : "#ffffff42"
                  text stop.station.name size=14 weight=stop.station.id == stationId ? 700 : 400 color=stop.station.id == stationId ? "#ffffff" : "#ffffffd9"
        else
          text "Train not found" size=14 color="#ffffffb8"
