// All Aboard — the Caltrain next-train Contract surface (LLP 0027; redesigned
// under ENG-23719; native-feeling paging + sticky footer under ENG-23795).
//
// One .contract, rendered on web (DOM mirror) and native macOS/iOS (Rust
// kernel). Live Snapback data arrives through `query` bindings over the
// generated liveTrainStatus/liveDepartures/feedState descriptors — server push
// over the shared live socket (LLP 0034 D1; Exact LLP 0284 §5.3), no
// hand-written pump, no store. The view derives from pure helpers in ./data.ts,
// passing bound rows and declared host values as arguments. Exact's single
// temporal authority schedules target-relative logic deadlines and terminal
// countdown/freshness bindings; an idle home board has no periodic app-dataflow
// wave. The delays region carries a
// `stale rows` arm (Exact LLP 0284 §2.2 connection sugar): on a missed
// freshness budget the board keeps rendering last-known delays under a visible
// reconnecting note.
//
// Design (ENG-23719 + ENG-23795): a white board under a Caltrain-red sticky
// header, over a sticky white footer. The header carries the station identity
// — the day's hand-drawn scene (ENG-23684, rotating by epoch day) beside the
// station name — and is the station-paging surface. Below it, a vertically
// scrolling departures board: compact rows for ALL sooner trains already
// paged past (they never vanish, however far the selection walks), the
// selected train as a highlighted card (countdown, service class, train
// number, delay, and stop chips: the boarding stop plus an ellipsis and the
// run's last two stops), and the trains after it. The sticky footer
// holds the live-status dot (green live / gray not, with the honest DEMO
// DATA / SCHEDULE / STALE label beside it when not live — ENG-23642), the
// location indicator (blue on a real device fix — the icon IS the location
// status; there is no hint text on the board), the direction switch
// ("Switch to" de-emphasized over the destination, with the opposite
// direction's own next-train countdown beside it), and stroke-icon refresh /
// settings buttons.
//
// PAGING (ENG-23795 / Exact LLP 0336 P1): both paging surfaces are declared
// framework-owned 3-cell pagers —
// prev/current/next station header cards, prev/current/next hero train cards
// — physically adjacent at left ±100% inside a clipped container, exactly the
// native contiguous-page model. On web the Contract runtime owns pointer and
// wheel recognition, claim arbitration, transforms, and arrow keys. The
// visible chevrons/rows remain the command witnesses and tap affordances.
//
// Composition: the root AllAboard component owns all state, derives, actions,
// and the contract block; the screen components below are presentational and
// take data plus root actions as ordinary callback props.
//
// THEME: the board respects the OS appearance. Every board-surface color
// comes from `host scheme = colorScheme()` plus `themePalette(scheme)` — light is the
// ENG-23719 palette (Caltrain red #C8102E on white; ink #1A1F27; secondary
// #57606C; warm hairline #E7E2DB), dark is the same relationships on a warm
// near-black board with a lifted red accent. The ONLY intentional literals left in this
// file are the brand surfaces that do not change with the scheme: the
// Caltrain-red headers / NEXT TRAIN pill and their white-on-red text.

use applyFeedTick from "../../snapback/generated/contract/applyFeedTick.mutation.ts"
use liveTrainStatus from "../../snapback/generated/contract/liveTrainStatus.query.ts"
use liveDepartures from "../../snapback/generated/contract/liveDepartures.query.ts"
use feedState from "../../snapback/generated/contract/feedState.query.ts"

use navigate from "@exact/router/contract"
use replace from "@exact/router/contract"
use back from "@exact/router/contract"
use setSearch from "@exact/router/contract"

use getSelectedStation from "./data.ts"
use searchStations from "./data.ts"
use adjacentStationId from "./data.ts"
use stationArt from "./data.ts"
use locationHint from "./data.ts"
use locationIndicatorColor from "./data.ts"
use locationIconSvg from "./data.ts"
use ticketIconSvg from "./data.ts"
use refreshIconSvg from "./data.ts"
use settingsIconSvg from "./data.ts"
use themePalette from "./data.ts"
use activeDirection from "./data.ts"
use oppositeDirection from "./data.ts"
use directionTitle from "./data.ts"
use getDirectionBoard from "./data.ts"
use boardTrains from "./data.ts"
use terminalHint from "./data.ts"
use delayLabel from "./data.ts"
use delayColor from "./data.ts"
use shortHeadsign from "./data.ts"
use getTrainRun from "./data.ts"
use boardingCall from "./data.ts"
use heroStops from "./data.ts"
use stopClockLabel from "./data.ts"
use formatClockTime from "./data.ts"
use countdownTemporal from "./data.ts"
use serviceColor from "./data.ts"
use serviceTint from "./data.ts"
use etaModeLabel from "./data.ts"
use effectiveEtaMode from "./data.ts"
use nextEtaMode from "./preferences.ts"
use loadEtaModePreference from "./preferences.ts"
use persistEtaModePreference from "./preferences.ts"
use walkBikeLine from "./data.ts"
use loadRouteEstimate from "./data.ts"
use routeEstimateRefreshDeadline from "./data.ts"
use directionsLabel from "./data.ts"
use stationAddress from "./data.ts"
use loadMapsAppPreference from "./preferences.ts"
use persistMapsAppPreference from "./preferences.ts"
use nextMapsApp from "./preferences.ts"
use mapsAppLabel from "./preferences.ts"
use distanceLabel from "./data.ts"
use feedFreshnessTemporal from "./data.ts"
use feedProblem from "./data.ts"
use feedSourceBadge from "./data.ts"
use feedStaleDeadline from "./data.ts"
use backendStatusNote from "./data.ts"
use emptyDelayRows from "./data.ts"
use nextDepartureExpiry from "./data.ts"
use nextUtcDayDeadline from "./data.ts"
use boardingCallDeadline from "./data.ts"
use positionFraction from "./data.ts"
use positionLabel from "./data.ts"
use fractionPercent from "./data.ts"
use requestGeolocationRefresh from "./data.ts"
use openDirectionsLink from "./data.ts"
use openClipperLink from "./data.ts"

component AllAboard
  props
    screen: string = "home"
    initialStationId: string = null
    initialEtaMode: string = "auto"
    routeTripId: string = null

  // @ref LLP 0052#d1--reactive-host-state-host-bindings — host inputs publish through typed, value-canonical reactive bindings instead of a clock cache-buster.
  host scheme = colorScheme()
  host insets = safeAreaInsets()
  host location = geolocation({ mode: "whenAvailable" })
  host backend = appGlue("backend", { default: { status: "connecting" } })

  state stationId = initialStationId
  state directionOverride = null
  state query = ""
  state heroOffset = 0
  state directionsOpen = false

  query delayRows = liveTrainStatus({})
  query departureRows = liveDepartures({})
  query feedRows = feedState({})

  derive station = getSelectedStation(stationId, location)
  derive matches = searchStations(query, location)
  // @ref LLP 0052#d2--time-as-a-host-concern — logic wakes at authored deadlines, never on a universal periodic ticker.
  derive boardNow = invalidateAt(nextDepartureExpiry(screen, station.id, matches, activeDir, now(), delayRows, departureRows, feedRows))
  derive artNow = invalidateAt(nextUtcDayDeadline(now()))
  derive feedNow = invalidateAt(feedStaleDeadline(feedRows, now()))
  derive art = stationArt(station.id, artNow)
  derive locHint = locationHint(location)
  derive locColor = locationIndicatorColor(location, scheme)
  derive theme = themePalette(scheme)
  // Router-preserved roots share the reactive application preference stores;
  // storage remains only a best-effort durable mirror.
  derive etaMode = loadEtaModePreference(initialEtaMode)
  derive mapsApp = loadMapsAppPreference()
  derive headerHeight = 106 + insets.top
  derive footerHeight = 64 + insets.bottom
  derive barHeight = 64 + insets.top
  derive activeDir = activeDirection(directionOverride, station)
  derive oppositeDir = oppositeDirection(activeDir)
  // @ref LLP 0052#d4--derive-memoization-semantics — keyed sharing preserves equal row and outer-record identity.
  derive board = boardTrains(station.id, activeDir, boardNow, heroOffset, delayRows, departureRows, feedRows) memoRows("id")
  derive oppositeBoard = getDirectionBoard(station.id, oppositeDir, boardNow, 1, delayRows, departureRows, feedRows) memoRows("id")
  derive prevStationId = adjacentStationId(station.id, -1)
  derive nextStationId = adjacentStationId(station.id, 1)
  derive prevStation = getSelectedStation(prevStationId, location)
  derive nextStation = getSelectedStation(nextStationId, location)
  derive prevArt = stationArt(prevStationId, artNow)
  derive nextArt = stationArt(nextStationId, artNow)
  resource routeEstimate = loadRouteEstimate(station, etaMode, location, backend, invalidateAt(routeEstimateRefreshDeadline(now())))
  derive walkBike = walkBikeLine(station, etaMode, location, routeEstimate.value)
  derive dirLabel = directionsLabel(station, etaMode, location)
  derive directionsMode = effectiveEtaMode(station, etaMode, location)
  derive feedIssue = feedProblem(feedRows)
  derive feedSource = feedSourceBadge(feedRows, feedNow, scheme)
  derive bootNote = backendStatusNote(backend)
  // Trip position is the one genuinely sampled client-time function. It is
  // active only on the trip route; departure state has its own exact deadline.
  derive tripSampleNow = screen == "trip" ? now("5s") : now()
  derive trip = routeTripId ? getTrainRun(routeTripId, tripSampleNow, delayRows, departureRows) : null
  derive tripNow = invalidateAt(boardingCallDeadline(trip, station.id))
  derive tripCall = trip ? boardingCall(trip, station.id, tripNow) : null

  mutation refresh = applyFeedTick

  action goToStation(id) writes stationId, query, heroOffset
    stationId = id
    query = ""
    heroOffset = 0
    replace({ to: "/", search: { station: id, eta: etaMode } })
  action toggleDirection(next) writes directionOverride, heroOffset
    directionOverride = next
    heroOffset = 0
  action selectTrain(offset) writes heroOffset
    heroOffset = offset < 0 ? 0 : offset
  action trainFirst writes heroOffset
    heroOffset = 0
  // Auto resolves per station (>18-min walk resolves to bike) and remains
  // reachable from the explicit Settings modes. Persistence is a named
  // capability so a router-owned presentation remount cannot lose the choice.
  action toggleEtaMode
    let next = nextEtaMode(etaMode)
    persistEtaModePreference(next)
    setSearch({ station: station.id, eta: next })
  action requestLocation
    requestGeolocationRefresh()
  action cycleMaps
    persistMapsAppPreference(nextMapsApp(mapsApp))
  action openClipper
    openClipperLink()
  action openPreferredDirections
    openDirectionsLink(station.id, mapsApp, directionsMode)
  action openDirections writes directionsOpen
    directionsOpen = true
  action openAppleDirections writes directionsOpen
    openDirectionsLink(station.id, "apple", directionsMode)
    directionsOpen = false
  action openGoogleDirections writes directionsOpen
    openDirectionsLink(station.id, "google", directionsMode)
    directionsOpen = false
  action closeDirections writes directionsOpen
    directionsOpen = false
  action openStations writes query
    query = ""
    navigate({ to: "/stations", search: { station: station.id, eta: etaMode } })
  action openSettings
    navigate({ to: "/settings", search: { station: station.id, eta: etaMode } })
  action setQuery(value) writes query
    query = value
  action openTrip(id)
    navigate({ to: "/trip/[tripId]", params: { tripId: id }, search: { station: station.id, eta: etaMode } })
  action goHome
    back()
  action doRefresh mutates refresh
    refresh({ trigger: "manual" })

  // Home-screen mnemonic bindings share the same actions and visible
  // witnesses as taps. They remain disabled when their witness is absent
  // (for example Enter when there is no hero departure).
  key "Enter" -> openTrip(board.hero.id) fallback="hero-departure"
  key "f" -> toggleDirection(oppositeDir) fallback="flip-direction"
  key "r" -> doRefresh fallback="refresh"
  key "s" -> openStations fallback="change-station"
  key "g" -> openSettings fallback="open-settings"

  contract
    has button "Change station"
    when screen == "home" then has button "Flip direction"
    when screen == "home" then has button "Settings"
    when screen == "home" then has node testId="sticky-footer"
    when screen == "home" then has node testId="data-source-dot"
    when screen == "stations" then has input label="Search stations"

  view
    main background=theme.bg flex=1 width="100%" minHeight="100%" testId="all-aboard-main"
      stack flex=1 width="100%" minHeight="100%" overflow="hidden" background=theme.bg

        when screen == "home"
          column position="absolute" top=0 left=0 right=0 bottom=0 background=theme.bg testId="station-screen"
            StationHeader(station=station, art=art, prevStation=prevStation, prevArt=prevArt, nextStation=nextStation, nextArt=nextArt, prevStationId=prevStationId, nextStationId=nextStationId, walkBike=walkBike, dirLabel=dirLabel, mapsApp=mapsApp, topInset=insets.top, headerHeight=headerHeight, goToStation=goToStation, openStations=openStations, openPreferredDirections=openPreferredDirections, openDirections=openDirections)

            scroll position="absolute" top=headerHeight left=0 right=0 bottom=footerHeight background=theme.bg testId="board-content"
              column gap=10 padding=18 paddingTop=14 paddingBottom=24 maxWidth=620 alignSelf="center" width="100%"
                // The delays region dispatches on the live binding: `stale`
                // (Exact LLP 0284 §2.2 sugar) wins over `ready` while the
                // connection is degraded — same board, last-known delays, a
                // visible note. The `loading` arm is the board too
                // (ENG-23727): first paint renders scheduled departures under
                // an honest status note — never a blocking "connecting"
                // placeholder — and the live arms replace it in place (same
                // DirectionBoard shape, no layout churn).
                async delayRows
                  loading
                    column gap=8 width="100%"
                      when bootNote != ""
                        row justify="center" width="100%"
                          row radius=999 paddingLeft=12 paddingRight=12 paddingTop=5 paddingBottom=5 background=theme.noteBg borderWidth=1 borderColor=theme.noteBorder
                            text bootNote size=11 weight=700 color=theme.noteText testId="delays-loading"
                      DirectionBoard(stationId=station.id, logicNow=boardNow, activeDir=activeDir, board=board, feedIssue=feedIssue, theme=theme, delayRows=emptyDelayRows(), departureRows=departureRows, openTrip=openTrip, selectTrain=selectTrain, trainFirst=trainFirst)
                  stale rows
                    column gap=8 width="100%"
                      row justify="center" width="100%"
                        row radius=999 paddingLeft=12 paddingRight=12 paddingTop=5 paddingBottom=5 background=theme.warnBg borderWidth=1 borderColor=theme.warnBorder
                          text "Reconnecting — showing last-known delays" size=11 weight=700 color=theme.warnText testId="delays-stale"
                      DirectionBoard(stationId=station.id, logicNow=boardNow, activeDir=activeDir, board=board, feedIssue=feedIssue, theme=theme, delayRows=rows, departureRows=departureRows, openTrip=openTrip, selectTrain=selectTrain, trainFirst=trainFirst)
                  ready rows
                    DirectionBoard(stationId=station.id, logicNow=boardNow, activeDir=activeDir, board=board, feedIssue=feedIssue, theme=theme, delayRows=rows, departureRows=departureRows, openTrip=openTrip, selectTrain=selectTrain, trainFirst=trainFirst)

            StickyFooter(feedSource=feedSource, feedRows=feedRows, backend=backend, oppositeDir=oppositeDir, oppositeBoard=oppositeBoard, locColor=locColor, theme=theme, footerHeight=footerHeight, bottomInset=insets.bottom, toggleDirection=toggleDirection, requestLocation=requestLocation, openClipper=openClipper, doRefresh=doRefresh, openSettings=openSettings)

            when directionsOpen
              DirectionsSheet(station=station, theme=theme, bottomInset=insets.bottom, openAppleDirections=openAppleDirections, openGoogleDirections=openGoogleDirections, closeDirections=closeDirections)
        else
          when screen == "stations"
            StationsPicker(query=query, matches=matches, logicNow=boardNow, location=location, currentStationId=station.id, etaMode=etaMode, activeDir=activeDir, theme=theme, topInset=insets.top, barHeight=barHeight, bottomInset=insets.bottom, delayRows=delayRows, departureRows=departureRows, feedRows=feedRows, setQuery=setQuery, goToStation=goToStation, goHome=goHome)
          else
            when screen == "settings"
              SettingsScreen(etaMode=etaMode, mapsApp=mapsApp, locHint=locHint, feedSource=feedSource, feedRows=feedRows, backend=backend, theme=theme, topInset=insets.top, barHeight=barHeight, bottomInset=insets.bottom, toggleEtaMode=toggleEtaMode, requestLocation=requestLocation, cycleMaps=cycleMaps, goHome=goHome)
            else
              TripDetail(trip=trip, tripCall=tripCall, stationId=station.id, theme=theme, topInset=insets.top, barHeight=barHeight, bottomInset=insets.bottom, goHome=goHome)

// One header identity block — art scene beside the CALTRAIN wordmark, station
// name, and a sub line. Used for the offscreen prev/next pager cells; the
// center cell composes the same pieces around its press affordances.
component HeaderIdentity
  props
    name: string
    art: string
    sub: string

  view
    row gap=12 align="center" width="100%" maxWidth=620 alignSelf="center" paddingLeft=40 paddingRight=40
      when art != ""
        column width=54 height=74 radius=10 overflow="hidden" borderWidth=2 borderColor="#ffffff59" background="#ffffff22"
          image svgSource=art alt=`${name} station scene` width="100%" height="100%" objectFit="cover"
      column gap=2 align="flex-start" flex=1
        text "CALTRAIN" size=10 weight=800 letterSpacing=2.4 color="#ffffffa6"
        text name size=23 weight=800 lineHeight=26 color="#ffffff"
        text sub size=12 color="#ffffffcc"

// The sticky station header (ENG-23719/ENG-23795): Caltrain red, the
// station-paging surface. Its pager owns a 3-cell strip — the adjacent
// stations' identity cards physically at ±100% — plus pointer/wheel/arrow
// recognition. The edge chevrons are the visible command witnesses and tap
// affordances. Pressing the identity block opens the stations
// sheet; the directions line under the name is its own affordance
// (ENG-23795): tap opens the preferred maps app (web glue), long-press — or
// plain press on hosts without the glue — opens the directions sheet.
component StationHeader
  props
    station: object
    art: string
    prevStation: object
    prevArt: string
    nextStation: object
    nextArt: string
    prevStationId: string
    nextStationId: string
    walkBike: string
    dirLabel: string
    mapsApp: string
    topInset: number
    headerHeight: number
    goToStation: action(id: string)
    openStations: () => void
    openPreferredDirections: () => void
    openDirections: () => void

  view
    // The red surface bleeds under the status bar (height includes the top
    // safe-area inset); the pager strip starts below the inset so the
    // station identity and chevrons stay clear of the notch/clock.
    column position="absolute" top=0 left=0 right=0 height=headerHeight background="#C8102E" overflow="hidden" testId="station-header"
      pager axis="horizontal" keys="vertical" claim="station-header" prev=goToStation(prevStationId) next=goToStation(nextStationId) fallbackPrev="prev-station" fallbackNext="next-station" position="absolute" top=topInset left=0 right=0 bottom=0 testId="station-pager"
        when prevStationId != station.id
          cell side="prev"
            column justify="center" height="100%" testId="header-cell-prev"
              HeaderIdentity(name=prevStation.name, art=prevArt, sub=`Zone ${prevStation.zone}`)
        cell side="current"
          column justify="center" height="100%"
            row align="center" width="100%" height="100%" maxWidth=620 alignSelf="center"
              button press=goToStation(prevStationId) label="Previous station" testId="prev-station" width=40 height="100%" background="transparent" borderWidth=0 justify="center" align="center" opacity=prevStationId == station.id ? 0.25 : 1
                text "‹" size=30 weight=700 color="#ffffff"
              row gap=12 align="center" flex=1
                when art != ""
                  button press=openStations label="Change station" background="transparent" borderWidth=0 paddingTop=0 paddingBottom=0 paddingLeft=0 paddingRight=0
                    column width=54 height=74 radius=10 overflow="hidden" borderWidth=2 borderColor="#ffffff59" background="#ffffff22"
                      image svgSource=art alt=`${station.name} station scene` width="100%" height="100%" objectFit="cover" testId="station-art"
                column gap=2 align="flex-start" flex=1
                  button press=openStations label="Change station" testId="change-station" background="transparent" borderWidth=0 paddingTop=0 paddingBottom=0 paddingLeft=0 paddingRight=0 align="flex-start"
                    column gap=2 align="flex-start"
                      text "CALTRAIN" size=10 weight=800 letterSpacing=2.4 color="#ffffffa6"
                      text station.name size=23 weight=800 lineHeight=26 color="#ffffff" testId="station-name" headingLevel=1
                  // Press opens the preferred app through Contract's named URL
                  // capability; long-press keeps the explicit app-choice sheet.
                  button press=openPreferredDirections longpress=openDirections label=`${dirLabel}; preferred app ${mapsAppLabel(mapsApp)}` testId=`station-directions-${station.id}` background="transparent" borderWidth=0 paddingTop=0 paddingBottom=0 paddingLeft=0 paddingRight=0 align="flex-start"
                    text `Zone ${station.zone} · ${walkBike}` size=12 color="#ffffffcc" testId="walk-bike"
              button press=goToStation(nextStationId) label="Next station" testId="next-station" width=40 height="100%" background="transparent" borderWidth=0 justify="center" align="center" opacity=nextStationId == station.id ? 0.25 : 1
                text "›" size=30 weight=700 color="#ffffff"
        when nextStationId != station.id
          cell side="next"
            column justify="center" height="100%" testId="header-cell-next"
              HeaderIdentity(name=nextStation.name, art=nextArt, sub=`Zone ${nextStation.zone}`)

// One train as the expanded highlighted card: countdown, service class,
// number, delay, headsign, and the stop chips — the boarding stop plus an
// ellipsis and the run's last two stops (arrival at the end of the line),
// not the next few intermediate stops. Presentational — used for the
// selected train and for the adjacent pager cells.
component HeroCard
  props
    dep: object
    stationId: string
    logicNow: number
    theme: object
    delayRows: object[]
    departureRows: object[]
    idPrefix: string

  view
    column gap=8 radius=20 padding=16 background=theme.heroBg borderWidth=1.5 borderColor=theme.heroBorder width="100%" align="flex-start"
      row align="flex-end" gap=8 width="100%" testId=`${idPrefix}-countdown-${dep.predictedDepartureMs}`
        text temporal(() => countdownTemporal(dep.predictedDepartureMs, now())) size=72 weight=800 lineHeight=68 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color=theme.ink testId=`${idPrefix}-minutes`
        text "min" size=16 weight=600 color=theme.secondary paddingBottom=8
        spacer
        column gap=5 align="flex-end" paddingBottom=4
          row radius=999 paddingLeft=11 paddingRight=11 paddingTop=4 paddingBottom=4 background=serviceTint(dep.service, theme.scheme) testId=`${idPrefix}-service-pill`
            text dep.service size=12 weight=700 color=serviceColor(dep.service) testId=`${idPrefix}-service`
          text `${formatClockTime(dep.predictedDepartureMs, timezoneGeneration())} · #${dep.trainNumber}` size=12 family="ui-monospace, Menlo, monospace" color=theme.secondary testId=`${idPrefix}-meta`
          text delayLabel(dep) size=12 weight=700 color=delayColor(dep, theme.scheme) testId=`${idPrefix}-delay`
      text `to ${dep.headsign}` size=15 weight=600 color=theme.body
      row gap=6 wrap="wrap" align="center" width="100%"
        each stop in heroStops(dep.id, stationId, logicNow, delayRows, departureRows, timezoneGeneration()) key=stop.id
          when stop.gap
            text "…" size=13 weight=700 color=theme.muted testId=`${idPrefix}-stop-gap`
          else
            row radius=999 paddingLeft=10 paddingRight=10 paddingTop=4 paddingBottom=4 background=stop.isBoarding ? theme.accentSoftBg : theme.chip borderWidth=1 borderColor=stop.isBoarding ? theme.accentSoftBorder : theme.hairline testId=`${idPrefix}-stop-${stop.id}`
              text `${stop.time} ${stop.name}` size=11 weight=stop.isBoarding ? 700 : 500 family="ui-monospace, Menlo, monospace" color=stop.isBoarding ? theme.accent : theme.secondary

// The board (ENG-23795 selection model): direction title, ALL the sooner
// trains already paged past in compact rows (they never vanish — walking far
// into the future just grows the list and the user scrolls; the primary use
// case is the next few trains anyway), the selected train as a clipped
// 3-cell paging strip, and the trains after it. Every compact/following row
// selects that train on press; the rows adjacent to the hero carry
// train-prev / train-next. Tapping the selected card opens its trip detail.
// The opposite direction lives in the sticky footer's switch (with its own
// next-train countdown), not on the board. The #1 job of this screen: when
// is the next train, and the couple after that (ENG-23719).
component DirectionBoard
  props
    stationId: string
    logicNow: number
    activeDir: string
    board: object
    feedIssue: string
    theme: object
    delayRows: object[]
    departureRows: object[]
    openTrip: (id) => void
    selectTrain: action(offset: number)
    trainFirst: () => void

  view
    column gap=10 width="100%" testId="home-screen"
      row justify="space-between" align="center" width="100%" testId="direction-toggle"
        text directionTitle(activeDir) size=20 weight=800 letterSpacing=0.2 color=theme.ink testId="active-direction"
        when board.hero
          when board.offset == 0
            row radius=999 paddingLeft=9 paddingRight=9 paddingTop=3 paddingBottom=3 background="#C8102E"
              text "NEXT TRAIN" size=10 weight=800 letterSpacing=1 color="#ffffff" testId="next-tag"
          else
            button press=trainFirst label="Back to next train" testId="train-first" paddingTop=3 paddingBottom=3 paddingLeft=9 paddingRight=9 radius=999 background=theme.chip borderWidth=1 borderColor=theme.hairline
              text `‹ next train (+${board.offset})` size=10 weight=700 color=theme.secondary

      when board.hero
        column gap=8 width="100%"
          // Sooner trains stay visible in compact form once paged past
          // (ENG-23795) — pressing one selects it again.
          when board.offset > 0
            column gap=5 width="100%" testId="earlier-trains"
              each d in board.before key=d.id
                button press=selectTrain(d.offset) label=`Show earlier train ${d.trainNumber}` testId=d.testId background="transparent" borderWidth=0 padding=0 width="100%"
                  row justify="space-between" align="center" radius=12 paddingTop=6 paddingBottom=6 paddingLeft=12 paddingRight=12 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%" opacity=0.85
                    row gap=7 align="center"
                      text temporal(() => countdownTemporal(d.predictedDepartureMs, now())) size=13 weight=800 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color=theme.secondary width=30 textAlign="right"
                      text "min" size=10 color=theme.muted
                      row radius=999 paddingLeft=7 paddingRight=7 paddingTop=1 paddingBottom=1 background=serviceTint(d.service, theme.scheme)
                        text d.service size=9 weight=700 color=serviceColor(d.service)
                    text `${formatClockTime(d.predictedDepartureMs, timezoneGeneration())} · #${d.trainNumber}` size=11 family="ui-monospace, Menlo, monospace" color=theme.muted

          // The selected train: a framework-owned clipped 3-cell pager.
          column width="100%" overflow="hidden" position="relative"
            pager axis="horizontal" keys="horizontal" claim="board-content" prev=selectTrain(board.offset - 1) next=selectTrain(board.offset + 1) fallbackPrev="train-prev" fallbackNext="train-next" width="100%" testId="hero-pager"
              when board.heroPrev
                cell side="prev"
                  column width="100%" testId="hero-cell-prev"
                    HeroCard(dep=board.heroPrev, stationId=stationId, logicNow=logicNow, theme=theme, delayRows=delayRows, departureRows=departureRows, idPrefix="hero-prev")
              cell side="current"
                button press=openTrip(board.hero.id) label="Open selected train" testId="hero-departure" background="transparent" borderWidth=0 padding=0 width="100%"
                  HeroCard(dep=board.hero, stationId=stationId, logicNow=logicNow, theme=theme, delayRows=delayRows, departureRows=departureRows, idPrefix="hero")
              when board.heroNext
                cell side="next"
                  column width="100%" testId="hero-cell-next"
                    HeroCard(dep=board.heroNext, stationId=stationId, logicNow=logicNow, theme=theme, delayRows=delayRows, departureRows=departureRows, idPrefix="hero-next")

          // Every remaining train for the rest of the day — pressing selects
          // (pages to) that train; the selected card is the affordance for
          // its detail. Rows more than three past the hero gradually fade
          // (d.fade) so the whole day is scannable without competing with
          // the next few departures.
          column gap=7 width="100%"
            each d in board.rest key=d.id
              button press=selectTrain(d.offset) label=`Show train ${d.trainNumber}` testId=d.testId background="transparent" borderWidth=0 padding=0 width="100%" opacity=d.fade
                row justify="space-between" align="center" radius=14 paddingTop=10 paddingBottom=10 paddingLeft=14 paddingRight=14 background=theme.card borderWidth=1 borderColor=theme.hairline width="100%"
                  row gap=8 align="center"
                    text temporal(() => countdownTemporal(d.predictedDepartureMs, now())) size=17 weight=800 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color=theme.ink width=36 textAlign="right"
                    text "min" size=11 color=theme.muted
                    row radius=999 paddingLeft=8 paddingRight=8 paddingTop=2 paddingBottom=2 background=serviceTint(d.service, theme.scheme)
                      text d.service size=10 weight=700 color=serviceColor(d.service)
                  text `${formatClockTime(d.predictedDepartureMs, timezoneGeneration())} · #${d.trainNumber} · ${shortHeadsign(d)}` size=12 family="ui-monospace, Menlo, monospace" color=theme.secondary
      else
        column radius=16 padding=18 background=theme.soft borderWidth=1 borderColor=theme.hairline
          text "No more trains today in this direction." size=14 color=theme.secondary testId="no-trains"

      // Why the board is on the recorded feed instead of live 511 — the
      // actionable lastError refreshFeed commits on fallback (ENG-22751).
      when feedIssue != ""
        text feedIssue size=11 color=theme.warnText width="100%" testId="feed-problem"

// The sticky footer (ENG-23795): live-status dot (green live / gray not —
// the honest DEMO DATA / SCHEDULE / STALE label stays beside it when not
// live, ENG-23642), the location indicator (blue on a real device fix), the
// direction switch, and system-style refresh / settings icon buttons.
component StickyFooter
  props
    feedSource: object
    feedRows: object[]
    backend: object
    oppositeDir: string
    oppositeBoard: object
    locColor: string
    theme: object
    footerHeight: number
    bottomInset: number
    toggleDirection: (next) => void
    requestLocation: () => void
    openClipper: () => void
    doRefresh: () => void
    openSettings: () => void

  view
    // The footer surface runs to the physical bottom edge; paddingBottom
    // keeps the controls above the home indicator / curved corners.
    column position="absolute" left=0 right=0 bottom=0 height=footerHeight paddingBottom=bottomInset background=theme.bg testId="sticky-footer"
      row height=1 background=theme.hairline width="100%"
      row flex=1 align="center" justify="space-between" width="100%" maxWidth=620 alignSelf="center" paddingLeft=16 paddingRight=12
        row gap=8 align="center"
          column width=10 height=10 radius=5 background=feedSource.dot testId="data-source-dot"
          column gap=1 align="flex-start"
            when feedSource.live == false
              text feedSource.label size=9 weight=800 letterSpacing=1 color=feedSource.color testId="data-source"
            text temporal(() => feedFreshnessTemporal(feedRows, backend, now())) size=10 color=theme.muted testId="freshness"
        // The direction switch also carries the opposite direction's own
        // next-train countdown — the board's teaser row is gone, so this is
        // where "when is the other way?" lives now. Deliberately gray, not
        // Caltrain red: red read as "this IS the current direction" when it
        // names the direction you would switch TO.
        button press=toggleDirection(oppositeDir) label="Flip direction" testId="flip-direction" background="transparent" borderWidth=0 paddingTop=6 paddingBottom=6 paddingLeft=10 paddingRight=10
          column align="center" gap=1
            text "Switch to" size=9 weight=600 letterSpacing=0.6 color=theme.muted
            row gap=5 align="center"
              text directionTitle(oppositeDir) size=14 weight=800 color=theme.secondary testId="switch-direction-name"
              when oppositeBoard.primary
                row gap=2 align="center" testId="switch-direction-time"
                  text temporal(() => countdownTemporal(oppositeBoard.primary.predictedDepartureMs, now())) size=11 weight=600 fontVariant="tabular-nums" color=theme.muted
                  text " min" size=11 weight=600 color=theme.muted
        row gap=8 align="center"
          button press=openClipper label="Get or refill your Clipper card" testId="clipper" width=36 height=36 radius=18 background=theme.iconBtn borderWidth=0 justify="center" align="center"
            image svgSource=ticketIconSvg(theme.secondary) alt="" width=17 height=17
          button press=requestLocation label="Use my location" testId="location-indicator" width=36 height=36 radius=18 background=theme.iconBtn borderWidth=0 justify="center" align="center"
            image svgSource=locationIconSvg(locColor) alt="" width=17 height=17
          button press=doRefresh label="Refresh departures" testId="refresh" width=36 height=36 radius=18 background=theme.iconBtn borderWidth=0 justify="center" align="center"
            image svgSource=refreshIconSvg(theme.secondary) alt="" width=17 height=17
          button press=openSettings label="Settings" testId="open-settings" width=36 height=36 radius=18 background=theme.iconBtn borderWidth=0 justify="center" align="center"
            image svgSource=settingsIconSvg(theme.secondary) alt="" width=17 height=17

// The directions bottom sheet (ENG-23795): reached by framework-delivered
// long-press on the header directions line. URL opening is a named Contract
// capability backed by Exact's native shell bridge and window.open on web;
// copying the station address remains browser-only glue.
// Layout: the sheet is centered through a full-width flex wrapper
// (align="center"), NOT alignSelf on an absolutely positioned node — the
// native kernel does not center absolute nodes that way, which left the
// sheet pinned to the left edge on macOS. The wrapper also insets the card
// so it floats above the bottom edge on every host.
component DirectionsSheet
  props
    station: object
    theme: object
    bottomInset: number
    openAppleDirections: () => void
    openGoogleDirections: () => void
    closeDirections: () => void

  view
    column position="absolute" top=0 left=0 right=0 bottom=0 accessibilityModal=true focusTrap=true dismiss=closeDirections testId="directions-overlay"
      button press=closeDirections label="Close directions" testId="directions-scrim" position="absolute" top=0 left=0 right=0 bottom=0 background=theme.scrim borderWidth=0 radius=0 padding=0
        column width="100%" height="100%"
      column position="absolute" left=0 right=0 bottom=0 align="center" padding=10 paddingBottom=10 + bottomInset
        column width="100%" maxWidth=600 background=theme.card radius=18 padding=16 gap=8 testId="directions-sheet"
          column gap=2 align="flex-start" width="100%"
            text `Directions to ${station.name}` size=16 weight=800 color=theme.ink
            text stationAddress(station.id) size=12 color=theme.secondary testId="station-address"
          button press=openAppleDirections label="Open in Apple Maps" testId="directions-apple" paddingTop=12 paddingBottom=12 paddingLeft=14 paddingRight=14 radius=12 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%" align="flex-start"
            text "Open in Apple Maps" size=14 weight=600 color=theme.ink
          button press=openGoogleDirections label="Open in Google Maps" testId="directions-google" paddingTop=12 paddingBottom=12 paddingLeft=14 paddingRight=14 radius=12 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%" align="flex-start"
            text "Open in Google Maps" size=14 weight=600 color=theme.ink
          button press=closeDirections label="Copy station address" testId="directions-copy" paddingTop=12 paddingBottom=12 paddingLeft=14 paddingRight=14 radius=12 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%" align="flex-start"
            text "Copy station address" size=14 weight=600 color=theme.ink
          button press=closeDirections label="Cancel" testId="directions-cancel" paddingTop=12 paddingBottom=12 paddingLeft=14 paddingRight=14 radius=12 background="transparent" borderWidth=0 width="100%" align="center"
            text "Cancel" size=14 weight=700 color=theme.accent

// The stations sheet: red header (Done), search, match rows with the current
// station highlighted. Each row carries the end-of-line hint (ENG-23795):
// "… San Francisco 8:42" — the next train's own final stop and arrival.
component StationsPicker
  props
    query: string
    matches: object[]
    logicNow: number
    location: object
    currentStationId: string
    etaMode: string
    activeDir: string
    theme: object
    topInset: number
    barHeight: number
    bottomInset: number
    delayRows: object[]
    departureRows: object[]
    feedRows: object[]
    setQuery: (value) => void
    goToStation: (id) => void
    goHome: () => void

  view
    column position="absolute" top=0 left=0 right=0 bottom=0 background=theme.bg testId="stations-screen"
      column position="absolute" top=0 left=0 right=0 height=barHeight paddingTop=topInset background="#C8102E" justify="center"
        row justify="space-between" align="center" width="100%" maxWidth=620 alignSelf="center" paddingLeft=18 paddingRight=18
          text "Stations" size=20 weight=800 color="#ffffff" headingLevel=1
          button press=goHome label="Back" testId="stations-back" paddingTop=6 paddingBottom=6 paddingLeft=13 paddingRight=13 radius=999 background="#ffffff26" borderWidth=1 borderColor="#ffffff40"
            text "Done" size=12 weight=700 color="#ffffff"
      scroll position="absolute" top=barHeight left=0 right=0 bottom=0 background=theme.bg
        column gap=10 padding=18 maxWidth=620 alignSelf="center" width="100%" paddingBottom=18 + bottomInset
          input value=query change=setQuery placeholder="Search stations" label="Search stations" testId="station-search" padding=12 radius=12 background=theme.soft borderColor=theme.hairline borderWidth=1 color=theme.ink size=14
          column gap=2
            each s in matches key=s.id
              button press=goToStation(s.id) label=s.name testId=`station-${s.id}` background="transparent" borderWidth=0 padding=0 width="100%"
                row justify="space-between" align="center" gap=12 paddingTop=11 paddingBottom=11 paddingLeft=12 paddingRight=12 radius=12 background=s.id == currentStationId ? theme.accentFaintBg : "transparent" borderWidth=1 borderColor=s.id == currentStationId ? theme.accentSoftBorder : "transparent" width="100%"
                  column gap=2 align="flex-start"
                    text s.name size=15 weight=s.id == currentStationId ? 700 : 600 color=theme.ink
                    text `Zone ${s.zone} ${terminalHint(s.id, activeDir, logicNow, delayRows, departureRows, feedRows, timezoneGeneration())}` size=11.5 color=theme.muted testId=`terminal-hint-${s.id}`
                  text distanceLabel(s, etaMode, location) size=12 family="ui-monospace, Menlo, monospace" color=theme.secondary

// The settings sheet (ENG-23719/ENG-23795): travel-time mode, default maps
// app, location, and what the app is showing — reachable from the footer
// gear, no bottom tabs.
component SettingsScreen
  props
    etaMode: string
    mapsApp: string
    locHint: string
    feedSource: object
    feedRows: object[]
    backend: object
    theme: object
    topInset: number
    barHeight: number
    bottomInset: number
    toggleEtaMode: () => void
    requestLocation: () => void
    cycleMaps: () => void
    goHome: () => void

  view
    column position="absolute" top=0 left=0 right=0 bottom=0 background=theme.bg testId="settings-screen"
      column position="absolute" top=0 left=0 right=0 height=barHeight paddingTop=topInset background="#C8102E" justify="center"
        row justify="space-between" align="center" width="100%" maxWidth=620 alignSelf="center" paddingLeft=18 paddingRight=18
          text "Settings" size=20 weight=800 color="#ffffff" headingLevel=1
          button press=goHome label="Back" testId="settings-back" paddingTop=6 paddingBottom=6 paddingLeft=13 paddingRight=13 radius=999 background="#ffffff26" borderWidth=1 borderColor="#ffffff40"
            text "Done" size=12 weight=700 color="#ffffff"
      scroll position="absolute" top=barHeight left=0 right=0 bottom=0 background=theme.bg
        column gap=12 padding=18 maxWidth=620 alignSelf="center" width="100%" paddingBottom=18 + bottomInset
          column gap=8 radius=16 padding=14 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%"
            row justify="space-between" align="center" width="100%"
              column gap=2 align="flex-start"
                text "Travel time to stations" size=14 weight=700 color=theme.ink
                text "Auto picks biking beyond an 18-minute walk" size=11.5 color=theme.muted
              button press=toggleEtaMode label="Toggle ETA mode" testId="eta-mode" paddingTop=5 paddingBottom=5 paddingLeft=12 paddingRight=12 radius=999 background=theme.accentFaintBg borderWidth=1 borderColor=theme.accentFaintBorder
                text etaModeLabel(etaMode) size=12 weight=700 color=theme.accent
          column gap=8 radius=16 padding=14 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%"
            row justify="space-between" align="center" width="100%"
              column gap=2 align="flex-start"
                text "Default maps app" size=14 weight=700 color=theme.ink
                text "Used when opening directions to a station" size=11.5 color=theme.muted
              button press=cycleMaps label="Choose maps app" testId="maps-app" paddingTop=5 paddingBottom=5 paddingLeft=12 paddingRight=12 radius=999 background=theme.accentFaintBg borderWidth=1 borderColor=theme.accentFaintBorder
                text mapsAppLabel(mapsApp) size=12 weight=700 color=theme.accent
          column gap=8 radius=16 padding=14 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%"
            text "Location" size=14 weight=700 color=theme.ink
            button press=requestLocation label="Use my location" testId="settings-location" background="transparent" borderWidth=0 paddingTop=0 paddingBottom=0 paddingLeft=0 paddingRight=0 align="flex-start"
              text locHint size=12 color=theme.secondary
          column gap=8 radius=16 padding=14 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%"
            text "Data" size=14 weight=700 color=theme.ink
            row gap=7 align="center"
              row radius=999 paddingLeft=8 paddingRight=8 paddingTop=3 paddingBottom=3 background=feedSource.tint borderWidth=1 borderColor=feedSource.border
                text feedSource.label size=10 weight=800 letterSpacing=1 color=feedSource.color
              text temporal(() => feedFreshnessTemporal(feedRows, backend, now())) size=12 color=theme.muted
            text "Live departures come from the 511.org SIRI StopMonitoring feed; when the live feed is unavailable the board falls back to a recorded demo schedule and says so." size=11.5 color=theme.secondary lineHeight=16
          column gap=4 radius=16 padding=14 background=theme.soft borderWidth=1 borderColor=theme.hairline width="100%"
            text "About" size=14 weight=700 color=theme.ink
            text "All Aboard is a Snapback + Exact Contract demo. Station scenes are original hand-drawn artwork by Claude (Fable 5) — a different scene every day." size=11.5 color=theme.secondary lineHeight=16

// The trip sheet (ENG-23795): a native-feeling plain back chevron in the red
// header, the service badge beside the train name (not the corner), the
// labeled live position bar, and the ordered stop list with the boarding
// station highlighted.
component TripDetail
  props
    trip: object
    tripCall: object
    stationId: string
    theme: object
    topInset: number
    barHeight: number
    bottomInset: number
    goHome: () => void

  view
    column position="absolute" top=0 left=0 right=0 bottom=0 background=theme.bg testId="trip-screen"
      column position="absolute" top=0 left=0 right=0 height=barHeight paddingTop=topInset background="#C8102E" justify="center"
        row justify="space-between" align="center" width="100%" maxWidth=620 alignSelf="center" paddingLeft=8 paddingRight=18
          button press=goHome label="Back" testId="trip-back" width=44 height=44 background="transparent" borderWidth=0 justify="center" align="center"
            text "‹" size=30 weight=700 color="#ffffff"
      scroll position="absolute" top=barHeight left=0 right=0 bottom=0 background=theme.bg
        column gap=12 padding=18 maxWidth=620 alignSelf="center" width="100%" paddingBottom=18 + bottomInset
          when trip
            column gap=12 width="100%"
              column gap=3
                row gap=10 align="center"
                  text `Train ${trip.trainNumber}` size=28 weight=800 color=theme.ink headingLevel=1
                  row radius=999 paddingLeft=11 paddingRight=11 paddingTop=4 paddingBottom=4 background=serviceTint(trip.service, theme.scheme)
                    text trip.service size=12 weight=700 color=serviceColor(trip.service) testId="trip-service"
                text `${trip.origin.name} → ${trip.destination.name}` size=14 color=theme.secondary
                text `${trip.durationMinutes} min · ${trip.stopCount} stops · ${delayLabel(trip)}` size=12 color=theme.muted
              // The headline number: minutes until this train reaches the
              // boarding station — the app's primary question, answered here
              // too, not just on the board. Once the train's own call at the
              // station has passed, an honest one-line "departed" note.
              when tripCall
                when tripCall.departed
                  text `Departed ${tripCall.name} · ${stopClockLabel(tripCall, timezoneGeneration())}` size=12 weight=600 color=theme.muted testId="trip-countdown-departed"
                else
                  row gap=8 align="flex-end" radius=16 padding=14 background=theme.heroBg borderWidth=1.5 borderColor=theme.heroBorder width="100%"
                    text temporal(() => countdownTemporal(tripCall.predictedTimeMs, now())) size=40 weight=800 lineHeight=38 family="ui-monospace, Menlo, monospace" fontVariant="tabular-nums" color=theme.ink testId="trip-countdown"
                    text "min" size=13 weight=600 color=theme.secondary paddingBottom=3
                    spacer
                    column gap=1 align="flex-end" paddingBottom=2
                      text `until it reaches ${tripCall.name}` size=12 weight=600 color=theme.body
                      text stopClockLabel(tripCall, timezoneGeneration()) size=11 family="ui-monospace, Menlo, monospace" color=theme.muted
              // The live corridor-position indicator, labeled so the bar
              // reads as progress, not decoration (ENG-23795).
              column gap=8 radius=16 padding=14 background=theme.soft borderWidth=1 borderColor=theme.hairline
                row justify="space-between" align="flex-end" width="100%"
                  text positionLabel(trip) size=13 weight=600 color=theme.body testId="position-label"
                  text "TRIP PROGRESS" size=9 weight=800 letterSpacing=1 color=theme.muted testId="position-caption"
                column height=6 radius=3 background=theme.hairline width="100%"
                  column height=6 radius=3 background=serviceColor(trip.service) width=fractionPercent(positionFraction(trip)) testId="position-bar"
              column gap=0 radius=16 padding=8 background=theme.card borderWidth=1 borderColor=theme.hairline
                each stop in trip.stops key=stop.station.id
                  row gap=12 align="center" paddingTop=7 paddingBottom=7 paddingLeft=10 paddingRight=10 radius=10 background=stop.station.id == stationId ? theme.accentFaintBg : "transparent"
                    text stopClockLabel(stop, timezoneGeneration()) size=13 family="ui-monospace, Menlo, monospace" color=theme.secondary width=56
                    column width=8 height=8 radius=4 background=stop.station.id == stationId ? theme.accent : theme.dotIdle
                    text stop.station.name size=14 weight=stop.station.id == stationId ? 700 : 400 color=stop.station.id == stationId ? theme.accent : theme.body
          else
            text "Train not found" size=14 color=theme.secondary
