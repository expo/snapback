{
  "app": "todo-v2",
  "formatVersion": 1,
  "routes": [
    {
      "queries": [
        {
          "args": {},
          "function": "listTodos"
        }
      ],
      "route": "/"
    },
    {
      "queries": [
        {
          "args": {},
          "function": "listTodos"
        },
        {
          "args": {
            "priority": {
              "$param": "priority"
            }
          },
          "function": "listTodosByPriority"
        }
      ],
      "route": "/priority/:priority"
    }
  ]
}
