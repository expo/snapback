{
  "name": "snapback-zerobugs-control",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "generate": "SNAPBACK_OUTBOUND_ACTIONS=1 snapback generate snapback",
    "dev": "snapback dev snapback --client . --client-command vite",
    "client:dev": "vite",
    "bind:actors": "bun scripts/bind-actors.mts",
    "test:fixture": "bun run generate && bun test tests/fixture-loader.test.mts",
    "test:lane2": "bun run generate && bun test tests/fixture-loader.test.mts tests/lane2-functions.test.mts",
    "test:lane2:live": "bun tests/acceptance/lane2-live.mts",
    "test:lane3": "bun run generate && bun test tests/fixture-loader.test.mts tests/lane2-functions.test.mts tests/lane3-list-engine.test.mts",
    "test:lane3:live": "bun tests/acceptance/lane3-live.mts",
    "test:lane4": "bun run generate && bun test tests/fixture-loader.test.mts && bun test tests/lane2-functions.test.mts && bun test tests/lane3-list-engine.test.mts && bun test tests/lane4-domain.test.mts",
    "test:lane4:live": "bun tests/acceptance/lane4-live.mts",
    "test:lane5": "bun run generate && bun test tests/lane5-token.test.mts tests/lane5-envelope.test.mts tests/lane5-payload.test.mts",
    "test:lane5:live": "bun tests/acceptance/lane5-live.mts",
    "test:lane6a": "bun test tests/lane6a-adapter.test.mts tests/lane6a-mutations.test.mts tests/lane6a-window.test.mts tests/lane6a-session.test.mts",
    "test:lane6a:live": "bun tests/acceptance/lane6a-live.mts",
    "test:lane6b": "bun test tests/lane6b-source-inventory.test.mts tests/lane6b-login-bootstrap.test.mts",
    "test:lane6b:live": "bun tests/acceptance/lane6b-live.mts",
    "build:composition": "bun build composition/server.mts composition/effects/deliver.mts --outdir .snapback/lane5-build --target bun",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:static": "bun run typecheck && bun run build && bun run build:composition"
  },
  "dependencies": {
    "@expo/snapback-cli": "file:../../../packages/snapback-cli",
    "@expo/snapback-client": "file:../../../packages/snapback-client",
    "@expo/snapback-codegen": "file:../../../packages/snapback-codegen",
    "@expo/snapback-contract": "file:../../../packages/snapback-contract",
    "@expo/snapback-react": "file:../../../packages/snapback-react",
    "@expo/snapback-runtime-darwin-arm64": "file:../../../packages/snapback-runtime-darwin-arm64",
    "@expo/snapback-runtime-linux-x64": "file:../../../packages/snapback-runtime-linux-x64",
    "@expo/snapback-vite": "file:../../../packages/snapback-vite",
    "@floating-ui/react": "0.26.28",
    "@headlessui/react": "2.2.10",
    "@schickling/fps-meter": "0.1.2",
    "@vitejs/plugin-react": "5.0.2",
    "classnames": "2.5.1",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "js-cookie": "3.0.7",
    "nanoid": "5.1.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "14.4.1",
    "react-markdown": "9.1.0",
    "react-textarea-autosize": "8.5.9",
    "react-toastify": "10.0.6",
    "rehype-video": "2.3.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "use-debounce": "10.1.1",
    "usehooks-ts": "3.1.1",
    "vite": "8.0.0",
    "wouter": "3.9.0"
  },
  "devDependencies": {
    "@types/hast": "3.0.4",
    "@types/js-cookie": "3.0.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.5.0",
    "postcss-preset-env": "7.8.3",
    "tailwindcss": "3.4.19",
    "vite-plugin-svgr": "5.2.0"
  },
  "overrides": {
    "@expo/snapback-cli": "file:../../../packages/snapback-cli",
    "@expo/snapback-client": "file:../../../packages/snapback-client",
    "@expo/snapback-codegen": "file:../../../packages/snapback-codegen",
    "@expo/snapback-contract": "file:../../../packages/snapback-contract",
    "@expo/snapback-runtime-darwin-arm64": "file:../../../packages/snapback-runtime-darwin-arm64",
    "@expo/snapback-runtime-linux-x64": "file:../../../packages/snapback-runtime-linux-x64"
  }
}
