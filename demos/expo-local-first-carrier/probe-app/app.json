    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.snapback.exposqlitecarrierprobe",
      "supportsTablet": false,
      "appleTeamId": "UD2ZVW5WU5"
    },
    "android": {
