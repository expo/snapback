{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@generated/*": ["./snapback/generated/*"],
      "@messenger/snapback-expo": ["../../packages/snapback-expo/index.d.mts"],
      "@messenger/snapback-react": ["../../packages/snapback-react/index.d.mts"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
