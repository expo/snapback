use eventDetails from "./data/provider.generated.ts"
use guestList from "./data/provider.generated.ts"
use eventWall from "./data/provider.generated.ts"
use rsvp from "./data/provider.generated.ts"
use postMessage from "./data/provider.generated.ts"
use fmtWhen from "./helpers.ts"
use statusLabel from "./helpers.ts"
use goingCount from "./helpers.ts"
use myStatus from "./helpers.ts"
use openFeed from "./helpers.ts"

component PartifulEvent
  props
    eventId: string
    userId: string
    userName: string = "Someone"
    backendName: string = "backend"

  state draft = ""
  query event = eventDetails({ eventId: eventId })
  query guests = guestList({ eventId: eventId })
  query wall = eventWall({ eventId: eventId })
  mutation rsvpMut = rsvp
  mutation postMut = postMessage
  derive canPost = draft.trim() != ""

  action back
    openFeed()
  action respond(status) mutates rsvpMut
    rsvpMut({ eventId: eventId, guestName: userName, status: status })
  action setDraft(value) writes draft
    draft = value
  action post writes draft mutates postMut
    postMut({ eventId: eventId, authorName: userName, message: draft.trim() })
    draft = ""

  contract
    has node testId="event-page"
    press button "← All plans" -> back
    action post writes draft

  view
    column width="100%" minHeight="100vh" padding=38 background="#f4f0e8" gap=0 testId="event-page"
      row align="center" paddingBottom=22
        button press=back testId="back" background="transparent" flex=1
          text "← All plans" size=11 color="#171512"
        text `CONTRACT · ${backendName}` size=10 color="#ff4d24" testId="matrix-label"
      async event
        loading
          text "Loading the plan…" size=14 color="#5f594f"
        error err
          text err.message size=14 color="#aa2c20"
        empty
          text "That plan is gone." size=18 color="#171512"
        ready rows
          each ev in rows key=ev._id
            row gap=34 align="center" padding=42 background="#f6a25d" borderWidth=1 borderColor="rgba(23,21,18,0.35)"
              text ev.emoji size=66 background="rgba(255,255,255,0.22)" padding=30 radius=999
              column gap=10 flex=1
                text `${fmtWhen(ev.startsAt)} · HOSTED BY ${ev.hostName}` size=10 color="#473b31"
                text ev.title size=52 weight=800 color="#171512" lineHeight=0.9
                text ev.description size=14 color="#473b31"
              text event.connection size=10 color="#473b31" testId="connection"
            column gap=8 padding=32 borderWidth=1 borderColor="rgba(23,21,18,0.25)"
              text "MEET HERE" size=10 color="#665e54"
              text ev.location size=27 weight=800 color="#171512"
      row align="start" borderWidth=1 borderColor="rgba(23,21,18,0.25)"
        column gap=16 padding=32 flex=2 borderWidth=1 borderColor="rgba(23,21,18,0.18)" testId="wall"
          row align="baseline"
            text "THE WALL" size=10 color="#665e54" flex=1
          async wall
            loading
              text "Loading messages…" size=12 color="#665e54"
            error werr
              text werr.message size=12 color="#aa2c20"
            empty
              text "Quiet so far. Say something." size=13 color="#665e54"
            ready postRows
              column gap=0
                each item in postRows key=item._id
                  row gap=12 paddingTop=14 paddingBottom=14 borderWidth=1 borderColor="rgba(23,21,18,0.12)"
                    text item.authorName size=12 weight=800 color="#171512" width=90
                    text item.message size=13 color="#3f3a34" flex=1
          row gap=8
            input label=`Say something as ${userName}…` value=draft change=setDraft submit=post testId="wall-input" padding=12 flex=1 background="#fffaf2" borderWidth=1 borderColor="rgba(23,21,18,0.3)" color="#171512"
            button press=post testId="wall-send" disabled=!canPost opacity=canPost ? 1 : 0.45 paddingTop=12 paddingBottom=12 paddingLeft=18 paddingRight=18 background="#171512"
              text "Send ↗" size=12 color="#ffffff"
        column gap=14 padding=32 flex=1 testId="guest-list"
          async guests
            loading
              text "Loading guests…" size=12 color="#665e54"
            error gerr
              text gerr.message size=12 color="#aa2c20"
            empty
              text "Nobody yet." size=12 color="#665e54"
            ready guestRows
              column gap=12
                row align="baseline"
                  text "WHO'S IN" size=10 color="#665e54" flex=1
                  text goingCount(guestRows) size=20 weight=800 color="#171512"
                when myStatus(guestRows, userId) == "host"
                  text "You're hosting this one ✦" size=12 color="#171512" background="#dce3bf" padding=12
                else
                  row gap=5
                    button press=respond("going") testId="rsvp-going" padding=9 background=myStatus(guestRows, userId) == "going" ? "#ff4d24" : "transparent" borderWidth=1 borderColor="rgba(23,21,18,0.3)"
                      text "Going" size=10 color=myStatus(guestRows, userId) == "going" ? "#ffffff" : "#171512"
                    button press=respond("maybe") testId="rsvp-maybe" padding=9 background=myStatus(guestRows, userId) == "maybe" ? "#ff4d24" : "transparent" borderWidth=1 borderColor="rgba(23,21,18,0.3)"
                      text "Maybe" size=10 color=myStatus(guestRows, userId) == "maybe" ? "#ffffff" : "#171512"
                    button press=respond("cant") testId="rsvp-cant" padding=9 background=myStatus(guestRows, userId) == "cant" ? "#ff4d24" : "transparent" borderWidth=1 borderColor="rgba(23,21,18,0.3)"
                      text "Can't" size=10 color=myStatus(guestRows, userId) == "cant" ? "#ffffff" : "#171512"
                each guest in guestRows key=guest._id
                  row gap=10 align="center" paddingTop=8 paddingBottom=8 testId=`guest-${guest.userId}`
                    text guest.guestName size=13 weight=700 color="#171512" flex=1
                    text statusLabel(guest.status) size=9 color="#665e54"
