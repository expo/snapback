use listEvents from "./data/provider.generated.ts"
use createEvent from "./data/provider.generated.ts"
use fmtWhen from "./helpers.ts"
use openEvent from "./helpers.ts"
use openCreateRoute from "./helpers.ts"
use openFeed from "./helpers.ts"
use backgroundFor from "./ui.ts"
use textFor from "./ui.ts"
use mutedFor from "./ui.ts"
use accentFor from "./ui.ts"
use surfaceStyle from "./ui.ts"
use fieldStyle from "./ui.ts"
use requiredMessage from "./ui.ts"
use ConnectionBadge from "./connection-badge.contract"

component PartifulFeed
  props
    userName: string = "Someone"
    backendName: string = "backend"
    initialVariant: string = "warm"
    initialCreating: boolean = false
    initialUiState: string = "ready"

  state creating = initialCreating
  state visualVariant = initialVariant
  use createForm = form({ title: "", emoji: "🪩", when: "Next Saturday, 6:00 PM", location: "", description: "" }, { title: value => requiredMessage(value, "Event title"), location: value => requiredMessage(value, "Location") })

  query events = listEvents({})
  mutation createMut = createEvent
  derive canCreate = createForm.canSubmit

  action openCreate writes creating
    creating = true
    openCreateRoute()
  action closeCreate writes creating
    creating = false
    createForm.reset()
    openFeed()
  action toggleVariant writes visualVariant
    visualVariant = visualVariant == "warm" ? "night" : "warm"
  action submit writes creating mutates createMut
    if createForm.submit()
      createMut({ title: createForm.field("title").value.trim(), emoji: createForm.field("emoji").value, description: createForm.field("description").value.trim(), location: createForm.field("location").value.trim(), startsAt: now() + 259200000, hostName: userName, accent: "tangerine" })
      createForm.reset()
      creating = false
  action open(eventId)
    openEvent(eventId)

  contract
    has node testId="feed"
    press button "+ Make something happen" -> openCreate
    press button "Close create event" -> closeCreate
    press button "Toggle color theme" -> toggleVariant
    derive canCreate depends only on createForm
    when events.loading then has node testId="feed-loading"
    when events.error then has node testId="feed-error"
    when events.empty then has node testId="feed-empty"
    when events.ready then has node testId="feed-ready"

  view
    main width="100%" minHeight="100vh" background=backgroundFor(visualVariant) testId="product-shell"
      row align="center" paddingTop=20 paddingBottom=20 paddingLeft=52 paddingRight=52 borderWidth=1 borderColor="rgba(127,120,110,0.35)"
        text "p" size=23 weight=800 color="#ffffff" background=accentFor(visualVariant) paddingLeft=10 paddingRight=10 paddingTop=3 paddingBottom=3 radius=999
        text "  partitime" size=18 weight=800 color=textFor(visualVariant) flex=1
        button press=toggleVariant label="Toggle color theme" testId="theme-toggle" background="transparent" padding=9
          text visualVariant == "warm" ? "Night" : "Warm" size=10 color=textFor(visualVariant)
        text `CONTRACT  ·  ${backendName}` size=10 color=accentFor(visualVariant) testId="matrix-label"
      column gap=20 paddingTop=74 paddingBottom=70 paddingLeft=70 paddingRight=70 borderWidth=1 borderColor="rgba(23,21,18,0.14)"
        text "SAN FRANCISCO · YOUR WEEK AHEAD" size=10 color=mutedFor(visualVariant)
        match size
          case "expanded"
            text "Make a plan worth\nleaving the chat for." headingLevel=1 size=66 weight=800 color=textFor(visualVariant) lineHeight=64 testId="hero-title"
          case "regular"
            text "Make a plan worth leaving the chat for." headingLevel=1 size=48 weight=800 color=textFor(visualVariant) lineHeight=52 testId="hero-title"
          else
            text "Make a plan worth leaving the chat for." headingLevel=1 size=38 weight=800 color=textFor(visualVariant) lineHeight=42 testId="hero-title"
        text "Small gatherings, good people, no algorithmic sludge." size=16 color=mutedFor(visualVariant)
        row gap=18 align="center"
          button press=openCreate label="+ Make something happen" testId="create-event" paddingTop=14 paddingBottom=14 paddingLeft=22 paddingRight=22 radius=999 background=textFor(visualVariant)
            text "+ Make something happen" size=14 weight=700 color=backgroundFor(visualVariant)
          ConnectionBadge(value=events.connection)
      when creating
        stack portalTarget="root" portalLevel=100 portalPresentation="sheet" presence="entered" position="fixed" left=0 top=0 width="100%" height="100%" zIndex=100 testId="create-overlay"
          button press=closeCreate label="Close create event" position="absolute" left=0 top=0 width="100%" height="100%" zIndex=0 background="rgba(0,0,0,0.55)" borderWidth=0 testId="create-backdrop"
          section role="dialog" label="Create an event" labelledBy="create-title-heading" describedBy="create-description-copy" accessibilityModal=true focusTrap=true focusRestore=true dismiss=closeCreate presence="entered" testId="create-panel" zIndex=1 width="100%" maxWidth=720 padding=34 gap=18 style=surfaceStyle(visualVariant, "panel")
            row align="center"
              column gap=6 flex=1
                text "01 · WHAT'S THE PLAN?" size=10 color=mutedFor(visualVariant)
                text "Keep it loose." nativeID="create-title-heading" headingLevel=2 size=27 weight=800 color=textFor(visualVariant)
                text "A title and location are required." nativeID="create-description-copy" size=12 color=mutedFor(visualVariant)
              button press=closeCreate label="Close create event" testId="create-close" background="transparent" padding=10
                text "Close" size=12 color=textFor(visualVariant)
            section role="form" label="Create event" gap=10 testId="create-event-form"
              when createForm.field("title").touched && createForm.field("title").error
                text "Please fix the highlighted event details." role="alert" live="assertive" testId="form-error-summary" size=12 color="#c43b2f"
              row gap=10
                input label="Emoji" value=createForm.field("emoji").value change=createForm.field("emoji").change testId="create-emoji" width=62 padding=12 borderWidth=1 size=22 style=fieldStyle(visualVariant, false)
                input label="Event title" value=createForm.field("title").value change=createForm.field("title").change describedBy=createForm.field("title").error ? "event-title-error" : null testId="event-title" flex=1 padding=12 borderWidth=1 style=fieldStyle(visualVariant, createForm.field("title").error != null)
              when createForm.field("title").touched && createForm.field("title").error
                text createForm.field("title").error nativeID="event-title-error" role="alert" live="polite" testId="event-title-error" size=12 color="#c43b2f"
              input label="When" value=createForm.field("when").value change=createForm.field("when").change testId="event-when" padding=12 borderWidth=1 style=fieldStyle(visualVariant, false)
              input label="Location" value=createForm.field("location").value change=createForm.field("location").change autoComplete="street-address" describedBy=createForm.field("location").error ? "event-location-error" : null testId="event-location" padding=12 borderWidth=1 style=fieldStyle(visualVariant, createForm.field("location").error != null)
              when createForm.field("location").touched && createForm.field("location").error
                text createForm.field("location").error nativeID="event-location-error" role="alert" live="polite" testId="event-location-error" size=12 color="#c43b2f"
              input label="Description" value=createForm.field("description").value change=createForm.field("description").change multiline=true numberOfLines=4 testId="event-description" padding=12 borderWidth=1 style=fieldStyle(visualVariant, false)
              button press=submit label="Send the invite" testId="create-event-submit" disabled=createForm.submitting opacity=canCreate ? 1 : 0.7 paddingTop=13 paddingBottom=13 paddingLeft=20 paddingRight=20 radius=999 background=textFor(visualVariant)
                text "Send the invite ↗" size=14 weight=700 color=backgroundFor(visualVariant)
      column gap=24 padding=54 testId="feed" style=surfaceStyle(visualVariant, "surface")
        row align="baseline"
          text "02 · ON THE HORIZON" headingLevel=2 size=10 color=mutedFor(visualVariant) flex=1
          text backendName size=10 color=accentFor(visualVariant)
        when initialUiState == "feed-loading"
          match size
            case "expanded"
              SkeletonGrid(cols=3, visualVariant=visualVariant)
            case "regular"
              SkeletonGrid(cols=2, visualVariant=visualVariant)
            else
              SkeletonGrid(cols=1, visualVariant=visualVariant)
        else
          when initialUiState == "feed-empty"
            section label="No plans yet" gap=10 minHeight=320 padding=40 testId="feed-empty"
              text "No plans yet." headingLevel=2 size=28 weight=800 color=textFor(visualVariant)
              text "Make something happen when the group chat needs a destination." size=14 color=mutedFor(visualVariant)
          else
            async events
              loading
                match size
                  case "expanded"
                    SkeletonGrid(cols=3, visualVariant=visualVariant)
                  case "regular"
                    SkeletonGrid(cols=2, visualVariant=visualVariant)
                  else
                    SkeletonGrid(cols=1, visualVariant=visualVariant)
              error err
                text err.message size=14 color="#aa2c20" testId="feed-error"
              empty
                section label="No plans yet" gap=10 minHeight=320 padding=40 testId="feed-empty"
                  text "No plans yet." headingLevel=2 size=28 weight=800 color=textFor(visualVariant)
                  text "Make something happen when the group chat needs a destination." size=14 color=mutedFor(visualVariant)
              ready rows
                match size
                  case "expanded"
                    EventGrid(rows=rows, cols=3, visualVariant=visualVariant, open=open)
                  case "regular"
                    EventGrid(rows=rows, cols=2, visualVariant=visualVariant, open=open)
                  else
                    EventGrid(rows=rows, cols=1, visualVariant=visualVariant, open=open)

component EventGrid
  props
    rows: object[]
    cols: number
    visualVariant: string
    open: (id) => void

  view
    grid cols=cols gap=12 testId="feed-ready"
      each event in rows key=event._id
        column gap=18 padding=22 borderWidth=1 testId=`event-card-${event._id}` style=surfaceStyle(visualVariant, "surface")
          text event.emoji size=48 background="#f6a25d" padding=24 radius=4
          column gap=6 flex=1
            text fmtWhen(event.startsAt) size=10 color=accentFor(visualVariant)
            text event.title size=25 weight=800 color=textFor(visualVariant)
            text event.location size=13 color=mutedFor(visualVariant)
            text `HOSTED BY ${event.hostName}` size=9 color=mutedFor(visualVariant)
          button press=open(event._id) label=`View ${event.title}` testId=`open-${event._id}` paddingTop=10 paddingBottom=10 paddingLeft=16 paddingRight=16 radius=999 background=textFor(visualVariant)
            text "View plan →" size=12 weight=700 color=backgroundFor(visualVariant)

component SkeletonGrid
  props
    cols: number
    visualVariant: string

  view
    column width="100%" testId="feed-loading"
      text "Loading the plans…" role="status" live="polite" position="absolute" width=1 height=1 opacity=0 size=1
      grid cols=cols gap=12 width="100%"
        each index in [0, 1, 2] key=index
          column gap=18 minHeight=450 padding=22 borderWidth=1 opacity=0.72 style=surfaceStyle(visualVariant, "surface")
            skeleton width="100%" height=235 radius=4
            skeleton width="84%" height=16 radius=4
            skeleton width="64%" height=16 radius=4
            skeleton width="48%" height=16 radius=4
