{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/partitime-performance-v2-receipt.schema.json",
  "title": "Partitime performance v2 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "protocol",
    "source",
    "environment",
    "valid",
    "invalidReasons",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "partitime.performance-v2-receipt.v1"
    },
    "kind": {
      "enum": [
        "p0a-preregistration",
        "cycle",
        "thresholds",
        "aggregate"
      ]
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "valid": {
      "type": "boolean"
    },
    "invalidReasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invalidReason"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "p0a": {
      "$ref": "#/$defs/p0a"
    },
    "cycle": {
      "$ref": "#/$defs/cycle"
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        },
        "required": [
          "valid"
        ]
      },
      "then": {
        "properties": {
          "environment": {
            "$ref": "#/$defs/qualifiedEnvironment"
          },
          "invalidReasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "invalidReasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "p0a-preregistration"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "p0a"
        ],
        "properties": {
          "p0a": {
            "$ref": "#/$defs/p0a"
          },
          "cycle": false,
          "thresholds": false,
          "aggregate": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cycle"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "cycle"
        ],
        "properties": {
          "p0a": false,
          "cycle": {
            "$ref": "#/$defs/cycle"
          },
          "thresholds": false,
          "aggregate": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "thresholds"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "thresholds"
        ],
        "properties": {
          "p0a": false,
          "cycle": false,
          "thresholds": {
            "$ref": "#/$defs/thresholds"
          },
          "aggregate": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "aggregate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "aggregate"
        ],
        "properties": {
          "p0a": false,
          "cycle": false,
          "thresholds": false,
          "aggregate": {
            "$ref": "#/$defs/aggregate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "p0a-preregistration"
          },
          "valid": {
            "const": true
          }
        },
        "required": [
          "kind",
          "valid"
        ]
      },
      "then": {
        "properties": {
          "p0a": {
            "allOf": [
              {
                "$ref": "#/$defs/p0a"
              },
              {
                "type": "object",
                "required": [
                  "correctnessWitnesses"
                ],
                "properties": {
                  "correctnessWitnesses": true,
                  "protocolFrozenBeforeCollector": {
                    "const": true
                  },
                  "governedSamplesCollected": {
                    "const": false
                  },
                  "authorityBindingsVerified": {
                    "const": 3
                  },
                  "fixtureTreesVerified": {
                    "const": 3
                  },
                  "p0aComplete": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cycle"
          },
          "valid": {
            "const": true
          }
        },
        "required": [
          "kind",
          "valid"
        ]
      },
      "then": {
        "properties": {
          "cycle": {
            "allOf": [
              {
                "$ref": "#/$defs/cycle"
              },
              {
                "type": "object",
                "required": [
                  "regression",
                  "metrics"
                ],
                "properties": {
                  "regression": true,
                  "metrics": true,
                  "observations": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "finiteNonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "metricId": {
      "enum": [
        "totalWarmJsHeapBytesP95",
        "fixedWarmJsHeapBytesP95",
        "memoryPerActiveSubscriptionBytesP95",
        "updateFanoutCountP95",
        "domPatchCountP95"
      ]
    },
    "metricValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalWarmJsHeapBytesP95",
        "fixedWarmJsHeapBytesP95",
        "memoryPerActiveSubscriptionBytesP95",
        "updateFanoutCountP95",
        "domPatchCountP95"
      ],
      "properties": {
        "totalWarmJsHeapBytesP95": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "fixedWarmJsHeapBytesP95": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "memoryPerActiveSubscriptionBytesP95": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "updateFanoutCountP95": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "domPatchCountP95": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "schemaSha256",
        "receiptSchemaSha256",
        "workloadVersion",
        "thresholdFormulaSetId",
        "collectorId"
      ],
      "properties": {
        "id": {
          "const": "partitime-method-rubric-v2"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "receiptSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "workloadVersion": {
          "const": "partitime.web-3x4+apple-native-2x2x4.v2"
        },
        "thresholdFormulaSetId": {
          "const": "partitime-threshold-formulas-v2"
        },
        "collectorId": {
          "const": "partitime-chrome-cdp-memory-and-dom-v2"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapbackRevision",
        "exactRevision",
        "snapbackDirty",
        "exactDirty",
        "packageLockSha256"
      ],
      "properties": {
        "snapbackRevision": {
          "$ref": "#/$defs/gitRevision"
        },
        "exactRevision": {
          "$ref": "#/$defs/gitRevision"
        },
        "snapbackDirty": {
          "type": "boolean"
        },
        "exactDirty": {
          "type": "boolean"
        },
        "packageLockSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osProduct",
        "osVersion",
        "osBuild",
        "cpu",
        "memoryBytes",
        "browserName",
        "browserVersion",
        "bunVersion",
        "acPower",
        "lowPowerMode",
        "externalNetworkRequests"
      ],
      "properties": {
        "osProduct": {
          "type": "string",
          "minLength": 1
        },
        "osVersion": {
          "type": "string",
          "minLength": 1
        },
        "osBuild": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memoryBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "browserName": {
          "type": "string",
          "minLength": 1
        },
        "browserVersion": {
          "type": "string",
          "minLength": 1
        },
        "bunVersion": {
          "type": "string",
          "minLength": 1
        },
        "acPower": {
          "type": "boolean"
        },
        "lowPowerMode": {
          "type": "boolean"
        },
        "externalNetworkRequests": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "qualifiedEnvironment": {
      "allOf": [
        {
          "$ref": "#/$defs/environment"
        },
        {
          "type": "object",
          "properties": {
            "osProduct": {
              "const": "macOS"
            },
            "osVersion": {
              "const": "26.5.2"
            },
            "osBuild": {
              "const": "25F84"
            },
            "cpu": {
              "const": "Apple M5 Max"
            },
            "memoryBytes": {
              "const": 137438953472
            },
            "browserName": {
              "const": "Google Chrome"
            },
            "browserVersion": {
              "const": "150.0.7871.186"
            },
            "bunVersion": {
              "const": "1.3.12"
            },
            "acPower": {
              "const": true
            },
            "lowPowerMode": {
              "const": false
            },
            "externalNetworkRequests": {
              "const": 0
            }
          }
        }
      ]
    },
    "invalidReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^PARTITIME_V2_[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "protocol-constant",
            "authority-amendment",
            "collector",
            "fixture",
            "react-comparator",
            "threshold-set",
            "contract-holdout",
            "invalid-attempt"
          ]
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "arm": {
          "enum": [
            "react:snapback",
            "contract:snapback"
          ]
        }
      }
    },
    "p0a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolFrozenAtRevision",
        "protocolFrozenBeforeCollector",
        "governedSamplesCollected",
        "authorityBindingsVerified",
        "fixtureTreesVerified",
        "collectorSha256",
        "collectorManifest",
        "p0aComplete"
      ],
      "properties": {
        "protocolFrozenAtRevision": {
          "$ref": "#/$defs/gitRevision"
        },
        "protocolFrozenBeforeCollector": {
          "type": "boolean"
        },
        "governedSamplesCollected": {
          "type": "boolean"
        },
        "authorityBindingsVerified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "fixtureTreesVerified": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "collectorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "collectorManifest": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/repoPath"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "correctnessWitnesses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arm",
              "activeSubscriptions",
              "apiMethods",
              "beforeGraceStatus",
              "afterGraceStatus",
              "authoritativeDeliveries",
              "domPatchRecords",
              "heapReadAttempted"
            ],
            "properties": {
              "arm": {
                "enum": [
                  "react:snapback",
                  "contract:snapback"
                ]
              },
              "activeSubscriptions": {
                "const": 8
              },
              "apiMethods": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "enum": [
                    "reset",
                    "awaitStable",
                    "snapshotCounters",
                    "applyCanonicalUpdate"
                  ]
                }
              },
              "beforeGraceStatus": {
                "enum": [
                  "going",
                  "maybe"
                ]
              },
              "afterGraceStatus": {
                "enum": [
                  "going",
                  "maybe"
                ]
              },
              "authoritativeDeliveries": {
                "type": "integer",
                "minimum": 1
              },
              "domPatchRecords": {
                "type": "integer",
                "minimum": 1
              },
              "heapReadAttempted": {
                "const": false
              }
            }
          }
        },
        "p0aComplete": {
          "type": "boolean"
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeSubscriptions",
        "usedSizeBytes"
      ],
      "properties": {
        "activeSubscriptions": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            4,
            8,
            16,
            32
          ]
        },
        "usedSizeBytes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "deliveryCallbacks": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "domPatchRecords": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "arm",
        "attempt",
        "warmup",
        "cycleIndex",
        "schedule",
        "observations"
      ],
      "properties": {
        "phase": {
          "enum": [
            "P0a-pre-fix",
            "P0c-comparator",
            "P0c-holdout"
          ]
        },
        "arm": {
          "enum": [
            "react:snapback",
            "contract:snapback"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "warmup": {
          "type": "boolean"
        },
        "cycleIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "schedule": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              4,
              8,
              16,
              32
            ]
          }
        },
        "observations": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "regression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interceptBytes",
            "slopeBytesPerSubscription",
            "sse",
            "selectedCandidate"
          ],
          "properties": {
            "interceptBytes": {
              "$ref": "#/$defs/finiteNonnegativeNumber"
            },
            "slopeBytesPerSubscription": {
              "$ref": "#/$defs/finiteNonnegativeNumber"
            },
            "sse": {
              "$ref": "#/$defs/finiteNonnegativeNumber"
            },
            "selectedCandidate": {
              "enum": [
                "unconstrained",
                "intercept-zero",
                "slope-zero"
              ]
            }
          }
        },
        "metrics": {
          "$ref": "#/$defs/metricValues"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "comparatorArm",
        "sampleCount",
        "aggregation",
        "comparatorMetrics",
        "targets",
        "thresholdSetId",
        "judgedArmDependencyCount",
        "committedBeforeHoldout"
      ],
      "properties": {
        "phase": {
          "const": "P0c"
        },
        "comparatorArm": {
          "const": "react:snapback"
        },
        "sampleCount": {
          "const": 7
        },
        "aggregation": {
          "const": "nearest-rank-p95"
        },
        "comparatorMetrics": {
          "$ref": "#/$defs/metricValues"
        },
        "targets": {
          "$ref": "#/$defs/metricValues"
        },
        "thresholdSetId": {
          "type": "string",
          "pattern": "^partitime-thresholds-v2-sha256-[a-f0-9]{16}$"
        },
        "judgedArmDependencyCount": {
          "const": 0
        },
        "committedBeforeHoldout": {
          "const": true
        }
      }
    },
    "metricVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actual",
        "target",
        "pass"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/metricId"
        },
        "actual": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "target": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "pass": {
          "type": "boolean"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "thresholdSetId",
        "comparatorSampleCount",
        "holdoutSampleCount",
        "verdicts",
        "pass"
      ],
      "properties": {
        "phase": {
          "const": "P0c"
        },
        "thresholdSetId": {
          "type": "string",
          "pattern": "^partitime-thresholds-v2-sha256-[a-f0-9]{16}$"
        },
        "comparatorSampleCount": {
          "const": 7
        },
        "holdoutSampleCount": {
          "const": 7
        },
        "verdicts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/metricVerdict"
          }
        },
        "pass": {
          "type": "boolean"
        }
      }
    }
  }
}
