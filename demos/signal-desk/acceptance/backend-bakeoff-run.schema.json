{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/backend-bakeoff-run.v2.json",
  "title": "Signal Desk backend bakeoff aggregate receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentSha256", "content"],
  "properties": {
    "schemaVersion": { "const": "snapback.backend-bakeoff-run.v2" },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\\\]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runKind",
        "source",
        "runner",
        "environment",
        "startedAt",
        "finishedAt",
        "durationMs",
        "commands",
        "evidence",
        "identities",
        "summary",
        "nonclaims"
      ],
      "properties": {
        "runKind": { "const": "required-three-backend-local-matrix" },
        "source": { "$ref": "#/$defs/source" },
        "runner": { "$ref": "#/$defs/runner" },
        "environment": { "$ref": "#/$defs/environment" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "commands": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/command" }
        },
        "evidence": { "$ref": "#/$defs/evidenceSet" },
        "identities": { "$ref": "#/$defs/identities" },
        "summary": { "$ref": "#/$defs/summary" },
        "nonclaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree",
        "cleanAtStart",
        "trackedInputs",
        "unchangedAfterCommands",
        "unexpectedPaths"
      ],
      "properties": {
        "revision": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "cleanAtStart": { "const": true },
        "trackedInputs": { "$ref": "#/$defs/fileSet" },
        "unchangedAfterCommands": { "type": "boolean" },
        "unexpectedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "fileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "fileCount", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-git-index-path-mode-object.v1" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "path", "sha256", "commandSetSha256", "schemaPath", "schemaSha256"],
      "properties": {
        "package": { "const": "snapback-backend-bakeoff" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "commandSetSha256": { "$ref": "#/$defs/sha256" },
        "schemaPath": { "$ref": "#/$defs/relativePath" },
        "schemaSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "bun", "platform", "architecture"],
      "properties": {
        "node": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "bun": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
        "platform": { "enum": ["darwin", "linux", "win32"] },
        "architecture": { "enum": ["arm64", "x64"] }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "argv",
        "cwd",
        "timeoutMs",
        "startedAt",
        "finishedAt",
        "durationMs",
        "exitCode",
        "signal",
        "status",
        "stdout",
        "stderr"
      ],
      "properties": {
        "id": {
          "enum": [
            "contract",
            "snapback-comparator",
            "snapback-extras",
            "react",
            "convex",
            "supabase",
            "typecheck",
            "build"
          ]
        },
        "required": { "const": true },
        "argv": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "bun" },
            { "const": "run" },
            { "type": "string", "minLength": 1 }
          ],
          "items": false
        },
        "cwd": { "const": "demos/signal-desk" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "exitCode": {
          "anyOf": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "null" }
          ]
        },
        "signal": {
          "anyOf": [
            { "type": "string", "pattern": "^SIG[A-Z0-9]+$" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["passed", "failed", "timed-out"] },
        "stdout": { "$ref": "#/$defs/log" },
        "stderr": { "$ref": "#/$defs/log" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sourceBytes", "storedBytes", "truncated"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sourceBytes": { "type": "integer", "minimum": 0 },
        "storedBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "truncated": { "type": "boolean" }
      }
    },
    "evidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparator", "reactPresence", "reactQueryGroup"],
      "properties": {
        "comparator": { "$ref": "#/$defs/evidence" },
        "reactPresence": { "$ref": "#/$defs/evidence" },
        "reactQueryGroup": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "available",
        "valid",
        "sourcePath",
        "sourceSha256",
        "path",
        "sha256",
        "schemaVersion",
        "verdict",
        "passed",
        "total",
        "diagnostic"
      ],
      "properties": {
        "required": { "const": true },
        "available": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "sourcePath": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "sourceSha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "path": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "schemaVersion": { "type": ["string", "null"] },
        "verdict": { "enum": ["passed", "failed", "missing", "invalid"] },
        "passed": { "type": ["integer", "null"], "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "diagnostic": { "type": ["string", "null"] }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "artifact", "runtime", "packages", "generatedQueryGroup"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "profileId"],
          "properties": {
            "available": { "type": "boolean" },
            "profileId": { "type": ["string", "null"] }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "appId", "schemaHash", "bundleHash", "inputsHash"],
          "properties": {
            "available": { "type": "boolean" },
            "appId": { "type": ["string", "null"] },
            "schemaHash": { "type": ["string", "null"] },
            "bundleHash": { "type": ["string", "null"] },
            "inputsHash": { "type": ["string", "null"] }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "sha256", "crateVersion", "gitCommit", "gitDirty", "buildProfile"],
          "properties": {
            "available": { "type": "boolean" },
            "sha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "crateVersion": { "type": ["string", "null"] },
            "gitCommit": { "type": ["string", "null"] },
            "gitDirty": { "type": ["boolean", "null"] },
            "buildProfile": { "type": ["string", "null"] }
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparator", "react"],
          "properties": {
            "comparator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cli", "client"],
              "properties": {
                "cli": { "$ref": "#/$defs/nullablePackageIdentity" },
                "client": { "$ref": "#/$defs/nullablePackageIdentity" }
              }
            },
            "react": {
              "type": "object",
              "additionalProperties": false,
              "required": ["client", "react", "contract", "codegen"],
              "properties": {
                "client": { "$ref": "#/$defs/nullablePackageIdentity" },
                "react": { "$ref": "#/$defs/nullablePackageIdentity" },
                "contract": { "$ref": "#/$defs/nullablePackageIdentity" },
                "codegen": { "$ref": "#/$defs/nullablePackageIdentity" }
              }
            }
          }
        },
        "generatedQueryGroup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "id", "definitionHash", "adapterSourceSha256", "compiledBundleSha256"],
          "properties": {
            "available": { "type": "boolean" },
            "id": { "type": ["string", "null"] },
            "definitionHash": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "adapterSourceSha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "compiledBundleSha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "algorithm", "files", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullablePackageIdentity": {
      "anyOf": [
        { "$ref": "#/$defs/packageIdentity" },
        { "type": "null" }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required", "passed", "failed", "timedOut", "evidenceValid"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "required": { "const": 8 },
        "passed": { "type": "integer", "minimum": 0, "maximum": 8 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 8 },
        "timedOut": { "type": "integer", "minimum": 0, "maximum": 8 },
        "evidenceValid": { "type": "boolean" }
      }
    }
  }
}
