{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://snapback.dev/schemas/competitive-checkpoint-metric-events.candidate.v0.schema.json",
  "title": "LLP 0075 candidate metric event ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "protocolVersion",
    "capsuleSha256",
    "runId",
    "executionSequence",
    "arm",
    "sample",
    "agentSessionId",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "snapback.convex-checkpoint-metric-events.candidate.v0"
    },
    "protocolId": {
      "const": "llp-0075-convex-checkpoint-v0"
    },
    "protocolVersion": {
      "const": "v0.4"
    },
    "capsuleSha256": {
      "$ref": "#/definitions/sha256"
    },
    "runId": {
      "$ref": "#/definitions/identifier"
    },
    "executionSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "arm": {
      "enum": [
        "convex",
        "snapback"
      ]
    },
    "sample": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "ordinal"
          ],
          "properties": {
            "phase": {
              "const": "warmup"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "ordinal"
          ],
          "properties": {
            "phase": {
              "const": "timed"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          }
        }
      ]
    },
    "agentSessionId": {
      "$ref": "#/definitions/identifier"
    },
    "events": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100000,
      "items": {
        "$ref": "#/definitions/event"
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "canonicalUint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "wallClock": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sequence",
        "monotonicNs",
        "wallClock"
      ],
      "properties": {
        "kind": {
          "enum": [
            "work-started",
            "command-started",
            "command-finished",
            "milestone-observed",
            "agent-usage",
            "classification",
            "sample-finished"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "monotonicNs": {
          "$ref": "#/definitions/canonicalUint"
        },
        "wallClock": {
          "$ref": "#/definitions/wallClock"
        },
        "commandId": {
          "$ref": "#/definitions/identifier"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "authored": {
          "type": "boolean"
        },
        "wrapper": {
          "type": "string",
          "maxLength": 128
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "milestone": {
          "enum": [
            "first-local-live-row",
            "hosted-live-url"
          ]
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "classification": {
          "enum": [
            "expected-refusal",
            "unexpected-failure",
            "retry",
            "required-skip",
            "human-intervention",
            "unplanned-credential-repair",
            "correctness-failure",
            "security-failure",
            "cleanup-defect",
            "instrument-failure"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,127}$"
        },
        "gateId": {
          "$ref": "#/definitions/identifier"
        },
        "expectedByGateId": {
          "$ref": "#/definitions/identifier"
        },
        "documenter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidenceArtifactSha256": {
          "$ref": "#/definitions/sha256"
        },
        "outcome": {
          "enum": [
            "valid",
            "instrument-invalid"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command-started"
              }
            }
          },
          "then": {
            "required": [
              "commandId",
              "argv",
              "authored"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command-finished"
              }
            }
          },
          "then": {
            "required": [
              "commandId",
              "exitCode",
              "signal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "milestone-observed"
              }
            }
          },
          "then": {
            "required": [
              "milestone",
              "evidenceArtifactSha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent-usage"
              }
            }
          },
          "then": {
            "required": [
              "inputTokens",
              "outputTokens",
              "cachedInputTokens",
              "toolCalls"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "classification"
              }
            }
          },
          "then": {
            "required": [
              "classification",
              "code",
              "evidenceArtifactSha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "expected-refusal"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": [
              "expectedByGateId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "instrument-failure"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": [
              "documenter",
              "rationale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sample-finished"
              }
            }
          },
          "then": {
            "required": [
              "outcome"
            ]
          }
        }
      ]
    }
  }
}
