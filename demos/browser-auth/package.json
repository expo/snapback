{
  "name": "snapback-browser-auth-recipe-demo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node ../../packages/snapback-codegen/index.mjs snapback",
    "witness:browser": "node tests/acceptance/browser-auth.mjs",
    "witness:password": "node tests/acceptance/password-auth.mjs",
    "prove": "bun run generate && bun run witness:browser && bun run witness:password"
  },
  "dependencies": {
    "@expo/snapback-client": "file:../../packages/snapback-client",
    "@expo/snapback-codegen": "file:../../packages/snapback-codegen",
    "@expo/snapback-contract": "file:../../packages/snapback-contract",
    "@expo/snapback-runtime-darwin-arm64": "file:../../packages/snapback-runtime-darwin-arm64",
    "@expo/snapback-runtime-linux-x64": "file:../../packages/snapback-runtime-linux-x64",
    "vite": "8.0.0"
  },
  "devDependencies": {
    "playwright-core": "1.62.0"
  },
  "overrides": {
    "@expo/snapback-client": "file:../../packages/snapback-client",
    "@expo/snapback-codegen": "file:../../packages/snapback-codegen",
    "@expo/snapback-contract": "file:../../packages/snapback-contract",
    "@expo/snapback-runtime-darwin-arm64": "file:../../packages/snapback-runtime-darwin-arm64",
    "@expo/snapback-runtime-linux-x64": "file:../../packages/snapback-runtime-linux-x64"
  }
}
