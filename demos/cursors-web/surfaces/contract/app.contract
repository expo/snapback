// Cursor presence — the Contract surface (ENG-22479; Exact LLP 0284 §5 item 4).
//
// The read side is the proof: client B's cursor reaches client A's
// `ephemeral` BINDING through generated bindings alone — no imperative
// overlay, no poll pump. The binding target is the generated
// webCursors.ephemeral.ts descriptor; entries carry the normative
// EphemeralMapCell shape (key/value/updatedAt/expiresAt/sourceClientId/self)
// and the map's `connection` axis is the transport truth. The WRITE side
// stays mutation-shaped publish glue in main.ts (pointer events are surface
// glue until Exact LLP 0281 lands rated `publish`).

use webCursors from "../../snapback/generated/contract/webCursors.ephemeral.ts"

component CursorRoom
  ephemeral cursors = webCursors({ roomId: "lobby" })

  view
    main background="#05070f" width="100%" minHeight="100vh" testId="cursor-room"
      stack position="relative" width="100%" height="100vh" overflow="hidden" testId="cursor-stage"
        column padding=20 gap=6
          text "Cursor presence — Contract surface" size=18 weight=700 color="#e6e9f2" headingLevel=1
          text `room: lobby · map: ${cursors.status} · connection: ${cursors.connection}` size=12 color="#8b93a7" testId="map-status"
          text `${cursors.entries.length} cursors` size=12 color="#8b93a7" testId="cursor-count"
          text "Move your pointer — other windows in this room see it live." size=12 color="#5f6579"
        each c in cursors.entries key=c.key
          column position="absolute" left=c.value.x top=c.value.y gap=3 align="flex-start" testId=`cursor-${c.key}`
            column width=12 height=12 radius=6 background=c.value.color borderWidth=c.self ? 2 : 0 borderColor="#ffffff"
            text c.value.name size=10 weight=c.self ? 800 : 500 color=c.self ? "#ffffff" : "#c8cede" testId=`cursor-name-${c.key}`
