{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapback.backend-bakeoff.scoring-input.v1",
  "type": "object",
  "required": ["schemaVersion", "ratings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ratings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["categories", "evidence"],
          "properties": {
            "categories": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "stopDefects": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
