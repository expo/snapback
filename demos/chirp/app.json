{
  "expo": {
    "name": "Chirp",
    "slug": "snapback-chirp",
    "scheme": "chirp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapback.chirp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.snapback.chirp",
      "usesCleartextTraffic": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43156224-acdd-4f26-9f8c-c730a46c0d23"
      }
    },
    "owner": "ccheever"
  }
}
