{
  "name": "tandem-snapback-expo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "generate": "node ../../../packages/snapback-codegen/index.mjs snapback",
    "backend": "node scripts/dev-backend.mjs",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "test": "bun run generate && node tests/acceptance/headless.mjs"
  },
  "dependencies": {
    "@expo/snapback-client": "file:../../../packages/snapback-client",
    "@expo/snapback-codegen": "file:../../../packages/snapback-codegen",
    "@expo/snapback-contract": "file:../../../packages/snapback-contract",
    "@expo/snapback-react": "file:../../../packages/snapback-react",
    "expo": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-router": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/snapback-client": "file:../../../packages/snapback-client",
    "@expo/snapback-contract": "file:../../../packages/snapback-contract",
    "@expo/snapback-react": "file:../../../packages/snapback-react"
  }
