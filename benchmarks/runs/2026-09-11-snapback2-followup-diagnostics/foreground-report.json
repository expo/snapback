{
  "scope": "Instrumented foreground sends during and after acquisition; same owner snapshot. No clean latency qualification.",
  "definitions": {
    "durableAdmission": "Matching end event by ID of ledger.enqueue begin with detail.op=messages.send, minus client.mutation begin timestamp, in browser performance clock.",
    "mutationResult": "Legacy result.admission.ms is promise settlement with committed value; its browser start is just before client.mutation.",
    "senderPreview": "First polled thread row containing probe body; all positive first rows carry data-state=queued and Preview. Node elapsed is recorded at loop start, before page.evaluate, so it is an observation bucket, not precise DOM paint.",
    "ownerObservation": "First separate headless same-account alice query returning the probe; Node elapsed is recorded after query. It is owner visibility, not recipient-device delivery.",
    "pollCadence": "Actual loop sleeps250ms after page evaluation and query, so cadence is250ms plus work; legacy control string saying50ms is stale.",
    "censoring": "The three current controls have nominal15s observation windows; exact pending mutation ages at capture are separately retained. Missing outcomes are not zero or completed15s results.",
    "clockDomains": "Enqueue/mutation are browser clock; owner/preview are Node clock from just before page.evaluate dispatch. Do not subtract these to infer precise subphase times.",
    "waitTotals": "Nested/overlapping async span totals cannot be summed."
  },
