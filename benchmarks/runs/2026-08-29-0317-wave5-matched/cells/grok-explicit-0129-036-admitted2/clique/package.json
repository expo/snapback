{
  "name": "clique",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "generate": "snapback generate snapback",
    "dev": "snapback dev snapback --write-env",
    "dev:client": "expo start",
    "dev:supervised": "snapback dev snapback --expo --expo-platform web",
    "dev:native-refusal": "snapback dev snapback --expo --expo-platform ios",
    "start": "expo start",
    "web": "expo start --web",
    "carry:headless": "node carrier.mjs headless",
    "carry:web-browser": "node carrier.mjs web-browser",
    "carry:native-simulator": "node carrier.mjs native-simulator",
    "carry:self-check": "node carrier.mjs --self-check --json",
    "typecheck": "tsc --noEmit",
    "prove": "snapback verify snapback --config ./snapback.verify.config.mjs --receipt ./.snapback/verify-receipt.json --json",
    "test": "node acceptance.mjs",
    "test:static": "node acceptance.static.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "replay": "node scripts/replay-starter.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/snapback-acceptance": "^0.1.29",
    "@expo/snapback-cli": "^0.1.29",
    "@expo/snapback-client": "^0.1.29",
    "@expo/snapback-codegen": "^0.1.29",
    "@expo/snapback-expo": "^0.1.29",
    "@expo/snapback-react": "^0.1.29",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "@snapback-bench/social-ui": "file:./vendor/social-ui"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.3"
  }
}
