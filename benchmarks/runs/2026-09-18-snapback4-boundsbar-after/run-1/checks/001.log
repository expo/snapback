residency (measurements): not measured — no dev store; use check --residency --fixture <fixture-directory> --as <principal>
  query search:
    scan members.byPrincipalRoom first 20 — rule decided by the prefix: no probes
      sort/group/sum/count consume this page, not the whole population
    scan messages.byRoomWords first 256 — rule uniform over the prefix: one verdict
      sort/group/sum/count consume this page, not the whole population
  query following:
    merge posts: lanes ≤ meter
    scan follows.byPair rows ≤ meter (8,192 examined) — rule decided by the prefix: no probes
      sort/group/sum/count consume this page, not the whole population
    scan posts.byAuthorTime first 20 — rule decided by the prefix: no probes
      sort/group/sum/count consume this page, not the whole population
  query roster:
    scan members.byRoomPrincipal first 20 — rule uniform over the prefix: one verdict
      sort/group/sum/count consume this page, not the whole population
  query unread:
    point unreadTotals.byGroup — one row, one rule check
  query trending:
    merge posts: up to 25 lanes
    scan posts.byRank first 10 — rule decided by the prefix: no probes
      sort/group/sum/count consume this page, not the whole population
      filter over ≤ examined ceiling (8192)
  mutation post:
    no explicit reads
    insert posts
