{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/benchmarks/social-messenger/scale-status.v1.json",
  "title": "Detached social-messenger scale replay status",
  "type": "object",
  "required": ["schemaVersion", "runId", "pid", "state", "actions", "updatedAt", "outcomeClass", "receipt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "social-messenger.scale-status.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "pid": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["starting", "running", "succeeded", "failed", "cancelled", "refused"] },
    "actions": {
      "type": "object",
      "required": ["applied", "total", "failed"],
      "additionalProperties": false,
      "properties": {
        "applied": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "outcomeClass": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["application", "platform", "setup", "instrument"] }
      ]
    },
    "receipt": { "type": ["string", "null"] }
  }
}
