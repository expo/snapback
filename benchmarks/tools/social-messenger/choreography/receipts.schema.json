{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/benchmarks/social-messenger/choreography-receipt-0.1.0-p1.json",
  "title": "Social-messenger choreography JSONL receipt",
  "oneOf": [
    { "$ref": "#/$defs/assertionReceipt" },
    { "$ref": "#/$defs/segmentSummary" }
  ],
  "$defs": {
    "segment": {
      "type": "string",
      "enum": ["m1", "m2", "m3", "m4", "m5", "m6"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "timing": {
      "type": "object",
      "required": ["attempt", "pass", "startedAt", "durationMs", "metrics"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "pass": { "type": "boolean" },
        "startedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "note": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "required": ["selection", "selectedAttempt", "reason"],
      "properties": {
        "selection": { "type": "string" },
        "selectedAttempt": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "assertionReceipt": {
      "type": "object",
      "required": [
        "version",
        "runId",
        "recordedAt",
        "type",
        "segment",
        "assertion",
        "implemented",
        "pass",
        "timings",
        "bestOf",
        "details"
      ],
      "properties": {
        "version": { "const": "0.1.0-p1" },
        "runId": { "type": "string", "format": "uuid" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "type": { "const": "assertion" },
        "segment": { "$ref": "#/$defs/segment" },
        "assertion": { "type": "string", "minLength": 1, "not": { "const": "__segment__" } },
        "implemented": { "type": "boolean" },
        "pass": { "type": "boolean" },
        "timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/timing" },
          "maxItems": 3
        },
        "bestOf": { "type": "integer", "enum": [1, 3] },
        "details": { "$ref": "#/$defs/details" }
      },
      "allOf": [
        {
          "if": { "properties": { "implemented": { "const": false } }, "required": ["implemented"] },
          "then": {
            "properties": {
              "pass": { "const": false },
              "timings": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "bestOf": { "const": 3 } }, "required": ["bestOf"] },
          "then": {
            "anyOf": [
              { "properties": { "implemented": { "const": false } } },
              {
                "properties": {
                  "timings": { "type": "array", "minItems": 3, "maxItems": 3 }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "implemented": { "const": true },
              "bestOf": { "const": 1 }
            },
            "required": ["implemented", "bestOf"]
          },
          "then": {
            "properties": {
              "timings": { "type": "array", "minItems": 1, "maxItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "pass": { "const": true } }, "required": ["pass"] },
          "then": {
            "properties": {
              "implemented": { "const": true },
              "timings": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "pass": { "const": true } },
                  "required": ["pass"]
                },
                "minContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "timings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "pass": { "const": false } },
                  "required": ["pass"]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "assertionCounts": {
      "type": "object",
      "required": ["total", "implemented", "passed", "failed", "notImplemented"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "implemented": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "notImplemented": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "suiteStatus": {
      "type": "object",
      "required": ["pass", "receipt"],
      "properties": {
        "pass": { "type": ["boolean", "null"] },
        "receipt": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "pass": { "const": true } }, "required": ["pass"] },
          "then": {
            "properties": {
              "receipt": { "type": "string", "minLength": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "choreographyStatus": {
      "type": "object",
      "required": ["browserPass", "requiredExternal", "externalPass", "pass"],
      "properties": {
        "browserPass": { "type": "boolean" },
        "requiredExternal": {
          "type": "array",
          "items": { "type": "string", "enum": ["ios-simulator-m6"] },
          "uniqueItems": true
        },
        "externalPass": { "type": ["boolean", "null"] },
        "pass": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "segmentSummary": {
      "type": "object",
      "required": [
        "version",
        "runId",
        "recordedAt",
        "type",
        "segment",
        "assertion",
        "implemented",
        "pass",
        "timings",
        "bestOf",
        "details",
        "assertions",
        "suite",
        "choreography",
        "green"
      ],
      "properties": {
        "version": { "const": "0.1.0-p1" },
        "runId": { "type": "string", "format": "uuid" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "type": { "const": "segment-summary" },
        "segment": { "$ref": "#/$defs/segment" },
        "assertion": { "const": "__segment__" },
        "implemented": { "type": "boolean" },
        "pass": { "type": "boolean" },
        "timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/timing" },
          "minItems": 1,
          "maxItems": 1
        },
        "bestOf": { "const": 1 },
        "details": { "$ref": "#/$defs/details" },
        "assertions": { "$ref": "#/$defs/assertionCounts" },
        "suite": { "$ref": "#/$defs/suiteStatus" },
        "choreography": { "$ref": "#/$defs/choreographyStatus" },
        "green": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "suite": {
                "type": "object",
                "properties": { "pass": { "const": true } },
                "required": ["pass"]
              },
              "choreography": {
                "type": "object",
                "properties": { "pass": { "const": true } },
                "required": ["pass"]
              }
            },
            "required": ["suite", "choreography"]
          },
          "then": {
            "properties": {
              "pass": { "const": true },
              "green": { "const": true }
            }
          },
          "else": {
            "properties": {
              "green": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "choreography": {
                "type": "object",
                "properties": { "pass": { "const": true } },
                "required": ["pass"]
              }
            },
            "required": ["choreography"]
          },
          "then": {
            "properties": { "pass": { "const": true } }
          },
          "else": {
            "properties": { "pass": { "const": false } }
          }
        },
        {
          "if": { "properties": { "pass": { "const": true } }, "required": ["pass"] },
          "then": {
            "properties": {
              "timings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "pass": { "const": true } },
                  "required": ["pass"]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
