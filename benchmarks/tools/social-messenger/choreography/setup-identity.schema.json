{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/benchmarks/social-messenger/setup-identity.v1.json",
  "title": "Social-messenger choreography setup identity",
  "type": "object",
  "required": ["schemaVersion", "instrumentPin", "backend", "runtime", "packageClosure", "toolchain", "host"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "social-messenger.setup-identity.v1" },
    "instrumentPin": { "const": "social-messenger@0.3.7-m8" },
    "backend": {
      "type": "object",
      "required": ["kind", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["snapback", "external"] },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["qualifiedBinary", "wrapper"],
      "additionalProperties": false,
      "properties": {
        "qualifiedBinary": { "$ref": "#/$defs/artifactClaim" },
        "wrapper": { "$ref": "#/$defs/artifactClaim" }
      }
    },
    "packageClosure": {
      "type": "object",
      "required": ["mode", "prepack", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["packed", "workspace", "hosted"] },
        "prepack": { "enum": ["verified", "not-applicable"] },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "version", "sha256"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "packed" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "prepack": { "const": "verified" },
              "artifacts": {
                "items": {
                  "properties": {
                    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "toolchain": {
      "type": "object",
      "required": ["node", "bun", "npm", "playwright", "browser"],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "object",
          "required": ["path", "version"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^v[0-9]+\\." }
          }
        },
        "bun": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 },
        "playwright": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "browser": { "enum": ["chromium", "firefox", "webkit"] }
      }
    },
    "host": {
      "type": "object",
      "required": ["id", "platform", "arch"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "artifactClaim": {
      "oneOf": [
        {
          "type": "object",
          "required": ["claimed", "path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "claimed": { "const": true },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "required": ["claimed", "reason"],
          "additionalProperties": false,
          "properties": {
            "claimed": { "const": false },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
