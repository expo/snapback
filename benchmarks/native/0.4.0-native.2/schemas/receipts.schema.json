{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/schemas/benchmarks/social-messenger/choreography-receipt-0.4.0-native.2.json",
  "title": "Social-messenger choreography JSONL receipt",
  "oneOf": [
    { "$ref": "#/$defs/assertionReceipt" },
    { "$ref": "#/$defs/segmentSummary" }
  ],
  "$defs": {
    "segment": {
      "type": "string",
      "enum": ["m1", "m2", "m3", "m4", "m5", "m6", "m7", "m8"]
    },
    "outcomeClass": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["application", "platform", "setup", "instrument"] }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "timing": {
      "type": "object",
      "required": [
        "attempt",
        "pass",
        "startedAt",
        "durationMs",
        "settlementWaitMs",
        "metrics"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
        "pass": { "type": "boolean" },
        "startedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "settlementWaitMs": {
          "type": "number",
          "minimum": 0,
          "description": "Union wall time spent inside instrumented assertion-settlement waits; excludes setup and action execution."
        },
        "metrics": { "$ref": "#/$defs/metrics" },
        "note": { "type": "string" },
        "error": { "type": "string" },
        "outcomeClass": { "$ref": "#/$defs/outcomeClass" }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "required": ["selection", "selectedAttempt", "reason"],
      "properties": {
        "selection": { "type": "string" },
        "selectedAttempt": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
        "reason": { "type": ["string", "null"] },
        "typingObservationBoundaryVersion": { "enum": ["v1", "v2"] }
      },
      "additionalProperties": false
    },
    "assertionReceipt": {
      "type": "object",
      "required": [
        "version",
        "runId",
        "recordedAt",
        "type",
        "segment",
        "assertion",
        "implemented",
        "required",
        "status",
        "pass",
        "timings",
        "bestOf",
        "details"
      ],
      "properties": {
        "version": { "enum": ["0.3.3-m8", "0.3.4-m8", "0.3.6-m8", "0.3.7-m8", "0.4.0-native.1", "0.4.0-native.2"] },
        "runId": { "type": "string", "format": "uuid" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "type": { "const": "assertion" },
        "segment": { "$ref": "#/$defs/segment" },
        "assertion": { "type": "string", "minLength": 1, "not": { "const": "__segment__" } },
        "implemented": { "type": "boolean" },
        "required": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "pass": { "type": ["boolean", "null"] },
        "timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/timing" },
          "maxItems": 3
        },
        "bestOf": { "type": "integer", "enum": [1, 3] },
        "details": { "$ref": "#/$defs/details" },
        "outcomeClass": { "$ref": "#/$defs/outcomeClass" },
        "typingObservationBoundaryVersion": { "enum": ["v1", "v2"] }
      },
      "allOf": [
        {
          "if": { "properties": { "implemented": { "const": false } }, "required": ["implemented"] },
          "then": {
            "properties": {
              "status": { "const": "skipped" },
              "pass": { "const": null },
              "timings": { "type": "array", "maxItems": 0 }
            },
            "required": ["details"]
          }
        },
        {
          "if": { "properties": { "status": { "const": "skipped" } }, "required": ["status"] },
          "then": {
            "properties": {
              "implemented": { "const": false },
              "pass": { "const": null },
              "timings": { "type": "array", "maxItems": 0 },
              "details": {
                "type": "object",
                "properties": { "reason": { "type": "string", "minLength": 1 } },
                "required": ["reason"]
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "implemented": { "const": true },
              "pass": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "implemented": { "const": true },
              "pass": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "bestOf": { "const": 3 } }, "required": ["bestOf"] },
          "then": {
            "anyOf": [
              { "properties": { "implemented": { "const": false } } },
              {
                "properties": {
                  "timings": { "type": "array", "minItems": 3, "maxItems": 3 }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "implemented": { "const": true },
              "bestOf": { "const": 1 }
            },
            "required": ["implemented", "bestOf"]
          },
          "then": {
            "properties": {
              "timings": { "type": "array", "minItems": 1, "maxItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "pass": { "const": true } }, "required": ["pass"] },
          "then": {
            "properties": {
              "implemented": { "const": true },
              "timings": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "pass": { "const": true } },
                  "required": ["pass"]
                },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "pass": { "const": false } }, "required": ["pass"] },
          "then": {
            "properties": {
              "timings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "pass": { "const": false } },
                  "required": ["pass"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.4-m8" },
              "assertion": { "const": "typing-indicator-within-2s-expires-within-5s" }
            },
            "required": ["version", "assertion"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" },
              "details": {
                "required": ["typingObservationBoundaryVersion"],
                "properties": {
                  "typingObservationBoundaryVersion": { "const": "v2" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.6-m8" },
              "assertion": { "const": "typing-indicator-within-2s-expires-within-5s" }
            },
            "required": ["version", "assertion"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" },
              "details": {
                "required": ["typingObservationBoundaryVersion"],
                "properties": {
                  "typingObservationBoundaryVersion": { "const": "v2" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.7-m8" },
              "assertion": { "const": "typing-indicator-within-2s-expires-within-5s" }
            },
            "required": ["version", "assertion"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" },
              "details": {
                "required": ["typingObservationBoundaryVersion"],
                "properties": {
                  "typingObservationBoundaryVersion": { "const": "v2" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "enum": ["0.4.0-native.1", "0.4.0-native.2"] },
              "assertion": { "const": "typing-indicator-within-2s-expires-within-5s" }
            },
            "required": ["version", "assertion"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" },
              "details": {
                "required": ["typingObservationBoundaryVersion"],
                "properties": {
                  "typingObservationBoundaryVersion": { "const": "v2" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.3-m8" },
              "assertion": { "const": "typing-indicator-within-2s-expires-within-5s" }
            },
            "required": ["version", "assertion"]
          },
          "then": {
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v1" },
              "details": {
                "properties": {
                  "typingObservationBoundaryVersion": { "const": "v1" }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "nonGreenCause": {
      "description": "Closed cause of green:false. Optional; default null when omitted. The current emitter always writes it. Lanes MUST copy this field from the segment-summary and must not invent a second green label such as 'functionally green'. Null when green is true.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "enum": [
            "suite-failed",
            "choreography-failed",
            "required-unimplemented",
            "instrument"
          ]
        }
      ]
    },
    "assertionCounts": {
      "type": "object",
      "required": [
        "total",
        "required",
        "implemented",
        "passed",
        "failed",
        "skipped",
        "notImplemented",
        "requiredUnimplemented"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "required": { "type": "integer", "minimum": 0 },
        "implemented": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "notImplemented": { "type": "integer", "minimum": 0 },
        "requiredUnimplemented": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "suiteStatus": {
      "type": "object",
      "required": ["pass", "receipt", "receiptSha256"],
      "properties": {
        "pass": { "type": "boolean" },
        "receipt": { "type": ["string", "null"] },
        "receiptSha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "outcomeClass": { "$ref": "#/$defs/outcomeClass" }
      },
      "allOf": [
        {
          "if": { "properties": { "pass": { "const": true } }, "required": ["pass"] },
          "then": {
            "properties": {
              "receipt": { "type": "string", "minLength": 1 },
              "receiptSha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "choreographyStatus": {
      "type": "object",
      "required": [
        "browserPass",
        "requiredExternal",
        "externalPass",
        "supplementalExternal",
        "pass"
      ],
      "properties": {
        "browserPass": { "type": "boolean" },
        "requiredExternal": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ios-simulator-m6", "ios-simulator-m8"]
          },
          "uniqueItems": true
        },
        "externalPass": { "type": ["boolean", "null"] },
        "supplementalExternal": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pass", "receipt", "status", "reason", "requiredForGreen"],
            "properties": {
              "id": {
                "type": "string",
                "enum": ["ios-simulator-m6", "ios-simulator-m8"]
              },
              "pass": { "type": ["boolean", "null"] },
              "receipt": { "type": ["string", "null"] },
              "status": { "type": "string", "enum": ["passed", "failed", "not-recorded"] },
              "reason": { "type": ["string", "null"] },
              "requiredForGreen": { "const": false }
            },
            "additionalProperties": false
          },
          "maxItems": 1
        },
        "pass": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifactClaim": {
      "oneOf": [
        {
          "type": "object",
          "required": ["claimed", "path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "claimed": { "const": true },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "required": ["claimed", "reason"],
          "additionalProperties": false,
          "properties": {
            "claimed": { "const": false },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "setup": {
      "type": "object",
      "required": ["schemaVersion", "instrumentPin", "backend", "runtime", "packageClosure", "toolchain", "host"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "social-messenger.setup-identity.v1" },
        "instrumentPin": {
          "enum": ["social-messenger@0.3.3-m8", "social-messenger@0.3.4-m8", "social-messenger@0.3.6-m8", "social-messenger@0.3.7-m8", "social-messenger@0.4.0-native.1", "social-messenger@0.4.0-native.2"]
        },
        "backend": {
          "type": "object",
          "required": ["kind", "version"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["snapback", "external"] },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["qualifiedBinary", "wrapper"],
          "additionalProperties": false,
          "properties": {
            "qualifiedBinary": { "$ref": "#/$defs/artifactClaim" },
            "wrapper": { "$ref": "#/$defs/artifactClaim" }
          }
        },
        "packageClosure": {
          "type": "object",
          "required": ["mode", "prepack", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["packed", "workspace", "hosted"] },
            "prepack": { "enum": ["verified", "not-applicable"] },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "version", "sha256"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "sha256": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "packed" } }, "required": ["mode"] },
              "then": {
                "properties": {
                  "prepack": { "const": "verified" },
                  "artifacts": {
                    "items": {
                      "properties": {
                        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "toolchain": {
          "type": "object",
          "required": ["node", "bun", "npm", "playwright", "browser"],
          "additionalProperties": false,
          "properties": {
            "node": {
              "type": "object",
              "required": ["path", "version"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            },
            "bun": { "type": "string", "minLength": 1 },
            "npm": { "type": "string", "minLength": 1 },
            "playwright": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
            "browser": { "enum": ["chromium", "firefox", "webkit"] }
          }
        },
        "host": {
          "type": "object",
          "required": ["id", "platform", "arch"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "segmentSummary": {
      "type": "object",
      "required": [
        "version",
        "runId",
        "recordedAt",
        "type",
        "segment",
        "assertion",
        "implemented",
        "required",
        "status",
        "pass",
        "timings",
        "bestOf",
        "details",
        "assertions",
        "suite",
        "choreography",
        "green"
      ],
      "properties": {
        "version": { "enum": ["0.3.3-m8", "0.3.4-m8", "0.3.6-m8", "0.3.7-m8", "0.4.0-native.1", "0.4.0-native.2"] },
        "runId": { "type": "string", "format": "uuid" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "type": { "const": "segment-summary" },
        "segment": { "$ref": "#/$defs/segment" },
        "assertion": { "const": "__segment__" },
        "implemented": { "type": "boolean" },
        "required": { "const": true },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "pass": { "type": "boolean" },
        "timings": {
          "type": "array",
          "items": { "$ref": "#/$defs/timing" },
          "minItems": 1,
          "maxItems": 1
        },
        "bestOf": { "const": 1 },
        "details": { "$ref": "#/$defs/details" },
        "assertions": { "$ref": "#/$defs/assertionCounts" },
        "suite": { "$ref": "#/$defs/suiteStatus" },
        "choreography": { "$ref": "#/$defs/choreographyStatus" },
        "green": { "type": "boolean" },
        "nonGreenCause": { "$ref": "#/$defs/nonGreenCause" },
        "outcomeClass": { "$ref": "#/$defs/outcomeClass" },
        "setupIdentity": {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "setup": { "$ref": "#/$defs/setup" },
        "typingObservationBoundaryVersion": { "enum": ["v1", "v2"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.4-m8" },
              "segment": { "const": "m3" }
            },
            "required": ["version", "segment"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.6-m8" },
              "segment": { "const": "m3" }
            },
            "required": ["version", "segment"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.7-m8" },
              "segment": { "const": "m3" }
            },
            "required": ["version", "segment"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "enum": ["0.4.0-native.1", "0.4.0-native.2"] },
              "segment": { "const": "m3" }
            },
            "required": ["version", "segment"]
          },
          "then": {
            "required": ["typingObservationBoundaryVersion"],
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v2" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": { "const": "0.3.3-m8" },
              "segment": { "const": "m3" }
            },
            "required": ["version", "segment"]
          },
          "then": {
            "properties": {
              "typingObservationBoundaryVersion": { "const": "v1" }
            }
          }
        },
        {
          "if": {
            "properties": { "version": { "const": "0.3.4-m8" } },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "setup": {
                "properties": {
                  "instrumentPin": { "const": "social-messenger@0.3.4-m8" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "version": { "const": "0.3.6-m8" } },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "setup": {
                "properties": {
                  "instrumentPin": { "const": "social-messenger@0.3.6-m8" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "version": { "const": "0.3.7-m8" } },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "setup": {
                "properties": {
                  "instrumentPin": { "const": "social-messenger@0.3.7-m8" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "version": { "const": "0.4.0-native.1" } },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "setup": {
                "properties": {
                  "instrumentPin": { "const": "social-messenger@0.4.0-native.1" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "version": { "const": "0.4.0-native.2" } },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "setup": {
                "properties": {
                  "instrumentPin": { "const": "social-messenger@0.4.0-native.2" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "version": { "const": "0.3.3-m8" } },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "setup": {
                "properties": {
                  "instrumentPin": { "const": "social-messenger@0.3.3-m8" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "suite": {
                "type": "object",
                "properties": { "pass": { "const": true } },
                "required": ["pass"]
              },
              "choreography": {
                "type": "object",
                "properties": { "pass": { "const": true } },
                "required": ["pass"]
              }
            },
            "required": ["suite", "choreography"]
          },
          "then": {
            "properties": {
