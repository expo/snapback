{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapback.dev/benchmarks/run-record.schema.json",
  "title": "Snapback competitive benchmark — single lane-run record",
  "description": "One lane's run of one brief under the LLP 0186 W1 instrument (see benchmarks/protocol.md). Correction-loop attribution values are a DRAFT until the first instrumented run ratifies the rule; the ratchet reading these records is measurement-only until LLP 0186 OQ1/OQ2 are resolved.",
  "$defs": {
    "scoreEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Paths or stable evidence pointers supporting this score or its unavailability."
    },
    "workroomOutcomeDimensions": {
      "type": "object",
      "required": [
        "o1FunctionalCompleteness",
        "o2CorrectnessUnderGrading",
        "o3TrustBoundaries",
        "o4IntegrationCorrectness",
        "o5PerformanceAtScaleEnvelope"
      ],
      "additionalProperties": false,
      "properties": {
        "o1FunctionalCompleteness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "o2CorrectnessUnderGrading": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "o3TrustBoundaries": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "o4IntegrationCorrectness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "o5PerformanceAtScaleEnvelope": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "workroomOutcome": {
      "type": "object",
      "required": ["grader", "status", "evidence", "dimensions", "combinedTotal"],
      "additionalProperties": false,
      "properties": {
        "grader": {
          "type": "string",
          "minLength": 1,
          "description": "Exact identity of the grader for this lane record; scorer families and effort are preregistered outside this schema."
        },
        "status": { "enum": ["scored", "unavailable"] },
        "evidence": { "$ref": "#/$defs/scoreEvidence" },
        "dimensions": { "$ref": "#/$defs/workroomOutcomeDimensions" },
        "combinedTotal": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "This scorer's outcome contribution plus the shared builder-experience contribution; null when either layer is incomplete."
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "lane",
    "brief",
    "harness",
    "timestamps",
    "firstGreenProofAt",
    "wallClock",
    "tokens",
    "correctionLoops",
    "handAuthoredLoc",
    "diary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "brief": {
            "enum": ["messaging", "messaging-equal-proof-bar"]
          }
        },
        "required": ["brief"]
      },
      "then": {
        "properties": { "rubric": true },
        "required": ["rubric"]
      },
      "else": {
        "if": {
          "properties": { "brief": { "const": "social-messenger" } },
          "required": ["brief"]
        },
        "then": {},
        "else": {
          "if": {
            "properties": { "brief": { "const": "team-workspace" } },
            "required": ["brief"]
          },
          "then": {
            "properties": {
              "workroomScore": true,
              "rubric": false,
              "outcomeRubric": false,
              "invariantPlatformScore": false
            },
            "required": ["workroomScore"]
          },
          "else": {
            "properties": {
              "outcomeRubric": true,
              "invariantPlatformScore": true
            },
            "required": ["outcomeRubric", "invariantPlatformScore"]
          }
        }
      }
    },
    {
      "if": { "required": ["workroomScore"] },
      "then": { "properties": { "brief": { "const": "team-workspace" } } }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Version of this record schema."
    },
    "lane": {
      "description": "Backend lane under test (LLP 0186 W1 lane set).",
      "enum": ["snapback", "convex", "supabase", "pocketbase", "postgres-express"]
    },
    "laneVariant": {
      "description": "Snapback-lane variant per the lanes/ templates; omit for competitor lanes.",
      "enum": ["bare", "skill"]
    },
    "carrier": {
      "description": "Interaction-proof carrier (diary 0068 introduced the native lane).",
      "enum": ["web", "native-simulator"]
    },
    "brief": {
      "description": "Which fixed brief was run, verbatim, from benchmarks/briefs/.",
      "enum": ["messaging", "messaging-equal-proof-bar", "crud", "media", "social-messenger", "team-workspace"]
    },
    "harness": {
      "type": "object",
      "description": "The agent harness configuration; identical across lanes of one comparison set.",
      "required": ["name", "model", "effort"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Agent harness and version, e.g. 'claude-code 2.x', 'codex-cli 1.y'."
        },
        "model": {
          "type": "string",
          "description": "Exact model identifier the harness ran."
        },
        "effort": {
          "type": ["string", "null"],
          "description": "Reasoning-effort / thinking setting where the harness exposes one; null if not applicable."
        },
        "environment": {
          "type": "object",
          "description": "Environment pinning per benchmarks/protocol.md: package names to exact versions (Snapback lane: published @expo/snapback-* versions, npm dist-tag noted), OS, and runtime versions.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["startedAt", "finishedAt"],
      "additionalProperties": false,
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "firstGreenProofAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Epoch timestamp of the lane's first passing acceptance proof; null when the lane never produced green proof."
    },
    "wallClock": {
      "type": "object",
      "description": "Wall-clock accounting in seconds. totalSeconds is authoritative; the phase split is recorded where the transcript supports recovering it, null where it does not. Orientation is measured, not excluded (diary 0058 excluded it, biasing the baseline).",
      "required": ["totalSeconds", "phases"],
      "additionalProperties": false,
      "properties": {
        "totalSeconds": { "type": "number", "minimum": 0 },
        "phases": {
          "type": "object",
          "required": ["orientation", "authoring", "verification", "diagnosis"],
          "additionalProperties": false,
          "properties": {
            "orientation": { "type": ["number", "null"], "minimum": 0 },
            "authoring": { "type": ["number", "null"], "minimum": 0 },
            "replay": { "type": ["number", "null"], "minimum": 0 },
            "m7Session": { "type": ["number", "null"], "minimum": 0 },
            "verification": { "type": ["number", "null"], "minimum": 0 },
            "diagnosis": { "type": ["number", "null"], "minimum": 0 }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Model token usage for the lane. source names the accounting channel per LLP 0186 OQ1 (which harness meter is trustworthy is OPEN); null source with null counts records an un-metered run honestly, as diary 0058 had to. The phase split uses the same boundaries as wallClock.phases.",
      "required": ["input", "output", "source", "phases"],
      "additionalProperties": false,
      "properties": {
        "input": { "type": ["integer", "null"], "minimum": 0 },
        "output": { "type": ["integer", "null"], "minimum": 0 },
        "source": {
          "type": ["string", "null"],
          "description": "Accounting channel, e.g. 'claude-code-session-accounting', 'api-usage-header', 'wrapping-proxy'; null when no per-lane meter existed."
        },
        "phases": {
          "type": "object",
          "required": ["orientation", "authoring", "verification", "diagnosis"],
          "additionalProperties": false,
          "properties": {
            "orientation": { "type": ["integer", "null"], "minimum": 0 },
            "authoring": { "type": ["integer", "null"], "minimum": 0 },
            "replay": { "type": ["integer", "null"], "minimum": 0 },
            "m7Session": { "type": ["integer", "null"], "minimum": 0 },
            "verification": { "type": ["integer", "null"], "minimum": 0 },
            "diagnosis": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "socialMessenger": true,
    "toolUses": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Tool invocations from the harness accounting channel; null when not captured."
    },
    "correctionLoops": {
      "type": "array",
      "description": "Every correction loop in the run: the agent believed a step was done, evidence said otherwise, and it iterated. Attribution rule: benchmarks/protocol.md (DRAFT until ratified at the first instrumented run).",
      "items": {
        "type": "object",
        "required": ["attribution", "summary", "evidence"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "attribution": { "const": "snapback-defect" }
              },
              "required": ["attribution"]
            },
            "then": {
              "properties": { "subAttribution": true },
              "required": ["subAttribution"]
            },
            "else": {
              "properties": { "subAttribution": false }
            }
          }
        ],
        "properties": {
          "attribution": {
            "enum": ["snapback-defect", "agent-error", "environment", "ambiguous"],
            "description": "snapback-defect: platform-under-test defect or doc/type/runtime disagreement (named for the Snapback lane's ratchet but recorded for every lane about its own platform). agent-error: the agent's own authoring mistake. environment: harness/OS/network, not the platform or the agent. ambiguous: could not be attributed under the rule; counts against no one but is reported."
          },
          "subAttribution": {
            "enum": ["defect", "knowledge-gap"],
            "description": "Required only for snapback-defect: defect means platform misbehavior; knowledge-gap means missing or undiscoverable knowledge caused the loop."
          },
          "summary": { "type": "string" },
          "evidence": {
            "type": "string",
            "description": "Pointer to the receipt: an issues/ ticket path, diary anchor, transcript span, or error-code capture."
          },
          "errorCode": {
            "type": ["string", "null"],
            "description": "Stable diagnostic code where one existed (e.g. a SNAPBACK_* code)."
          }
        }
      }
    },
    "handAuthoredLoc": {
      "type": "object",
      "description": "Hand-authored source/test lines, generated artifacts excluded (diary 0058's counting rule). A ceremony proxy only — fairness rules score guarantees, not lines.",
      "required": ["lines", "files"],
      "additionalProperties": false,
      "properties": {
        "lines": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "sharedUiLines": {
          "type": ["integer", "null"],
          "description": "Lines of backend-neutral shared UI, when the comparison set shares a presentation layer (diary 0059 pattern)."
        }
      }
    },
    "rubric": {
      "type": "object",
      "description": "Diary 0058's scoring dimensions and weights, adopted unchanged. Scores are 0-100 per dimension; weightedOverall applies the fixed weights: functionalCompleteness 20%, realtimeTyping 10%, offlineBehavior 20%, imagesAssets 10%, dataModelTypeSafety 10%, dxDocsSetup 15%, testabilityDiagnostics 5%, operationsMaturity 10%.",
      "required": [
        "functionalCompleteness",
        "realtimeTyping",
        "offlineBehavior",
        "imagesAssets",
        "dataModelTypeSafety",
        "dxDocsSetup",
        "testabilityDiagnostics",
        "operationsMaturity",
        "weightedOverall"
      ],
      "additionalProperties": false,
      "properties": {
        "functionalCompleteness": { "type": "number", "minimum": 0, "maximum": 100 },
        "realtimeTyping": { "type": "number", "minimum": 0, "maximum": 100 },
        "offlineBehavior": { "type": "number", "minimum": 0, "maximum": 100 },
        "imagesAssets": { "type": "number", "minimum": 0, "maximum": 100 },
        "dataModelTypeSafety": { "type": "number", "minimum": 0, "maximum": 100 },
        "dxDocsSetup": { "type": "number", "minimum": 0, "maximum": 100 },
        "testabilityDiagnostics": { "type": "number", "minimum": 0, "maximum": 100 },
        "operationsMaturity": { "type": "number", "minimum": 0, "maximum": 100 },
        "weightedOverall": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "outcomeRubric": {
      "type": "object",
      "description": "Scores for the outcome dimensions preregistered with a non-messaging brief. Each free-form dimension and weightedOverall is scored from 0 to 100.",
      "required": ["weightedOverall"],
      "minProperties": 2,
      "properties": {
        "weightedOverall": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "invariantPlatformScore": {
      "type": "object",
      "description": "Invariant platform dimensions used with every non-messaging outcome rubric.",
      "required": ["dx", "diagnostics", "operations"],
      "additionalProperties": false,
      "properties": {
        "dx": { "type": "number", "minimum": 0, "maximum": 100 },
        "diagnostics": { "type": "number", "minimum": 0, "maximum": 100 },
        "operations": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "workroomScore": {
      "type": "object",
      "description": "Workroom's declared two-layer score for one independently built lane: this builder's experience plus this lane's independently graded outcome.",
      "required": ["source", "builder", "outcome"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "benchmarks/briefs/team-workspace.md#scoring" },
        "builder": {
          "type": "object",
          "required": ["evidence", "dimensions", "holisticBeforeTotal"],
          "additionalProperties": false,
          "properties": {
            "evidence": { "$ref": "#/$defs/scoreEvidence" },
            "dimensions": {
              "type": "object",
              "required": [
                "b1SchemaAndDataModel",
                "b2AuthAndTenancyErgonomics",
                "b3ServerFunctionsAndIntegrations",
                "b4BackgroundAndScheduledWork",
                "b5Files",
                "b6Search",
                "b7Reporting",
                "b8Day2Evolution",
                "b9DxDocsSetup",
                "b10Diagnostics"
              ],
              "additionalProperties": false,
              "properties": {
                "b1SchemaAndDataModel": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b2AuthAndTenancyErgonomics": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b3ServerFunctionsAndIntegrations": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b4BackgroundAndScheduledWork": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b5Files": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b6Search": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b7Reporting": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b8Day2Evolution": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b9DxDocsSetup": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
                "b10Diagnostics": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
              }
            },
            "holisticBeforeTotal": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 100,
              "description": "Builder's separate holistic score, recorded before computed totals and never included in them."
            }
          }
        },
        "outcome": { "$ref": "#/$defs/workroomOutcome" }
      }
    },
    "authParity": {
      "type": "object",
      "description": "Fairness rule 1: the lane's auth posture, labeled explicitly.",
      "additionalProperties": false,
      "properties": {
        "posture": {
          "enum": ["none", "test-persona-seam", "sessions", "production-auth"]
        },
        "notes": { "type": "string" }
      }
    },
    "diary": {
      "type": "string",
      "description": "Path to the free-form run diary for this run (diaries/NNNN-*.diary.md or a benchmarks/records/ relative path)."
    },
    "notes": {
      "type": "string",
      "description": "Free-form caveats that don't fit elsewhere (e.g. guarantee differences a score alone would hide)."
    }
  }
}
