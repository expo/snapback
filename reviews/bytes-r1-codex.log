+    else if (value > previous * 1.01) {
+      failedSteps.add(field);
+      refuse(`${field}: ${value} bytes exceeds ${previous} by more than 1%`);
+    } else report(`ok ${field}: ${value} bytes ≤ ${previous} + 1%`);
+  }
