   247	pub fn isolated_compiler(target: &Path) -> PathBuf {
   248	    ensure_package();
   249	    let root = workspace();
   250	    let _lock = PackageLock::acquire(&root);
   251	    let dist = root.join("packages/snapback2/dist");
   252	    let isolated_dist = target.join("dist");
   253	    // Declarations and runners resolve sibling dist leaves, so the package is one fixture unit.
   254	    copy_tree(&dist, &isolated_dist);
   255	    link_typescript(target, &root);
   256	    isolated_dist.join("compiler.mjs")
   257	}
   258	
   259	fn copy_package_fixture(target: &Path) {
   260	    ensure_package();
   261	    let root = workspace();
   262	    let _lock = PackageLock::acquire(&root);
   263	    let dist = root.join("packages/snapback2/dist");
   264	    let isolated_dist = target.join("dist");
   265	    // Snapshot while the publisher is excluded; commands never read the mutable shared dist.
   266	    copy_tree(&dist, &isolated_dist);
   267	    link_typescript(target, &root);
   268	}
   269	
   270	fn link_typescript(target: &Path, root: &Path) {
   271	    // Public arms resolve the one client through the package's self-reference.
   272	    fs::copy(root.join("packages/snapback2/package.json"), target.join("package.json"))
   273	        .expect("copy isolated package exports");
   274	    let modules = target.join("node_modules");
   275	    fs::create_dir_all(&modules).expect("create isolated package node_modules");
   276	    let source = root.join("packages/snapback2/node_modules/typescript");
   277	    let destination = modules.join("typescript");
   278	    #[cfg(unix)]
   279	    std::os::unix::fs::symlink(source, destination).expect("link isolated TypeScript dependency");
   280	    #[cfg(windows)]
   281	    std::os::windows::fs::symlink_dir(source, destination)
   282	        .expect("link isolated TypeScript dependency");
   283	}
   284	
   285	fn copy_tree(source: &Path, target: &Path) {
   286	    fs::create_dir_all(target).expect("create isolated package directory");
   287	    let mut entries = fs::read_dir(source)
   288	        .expect("read package fixture directory")
   289	        .collect::<Result<Vec<_>, _>>()
   290	        .expect("read package fixture entry");
   291	    entries.sort_by_key(|entry| entry.file_name());
   292	    for entry in entries {
   293	        let destination = target.join(entry.file_name());
   294	        if entry.path().is_dir() {
   295	            copy_tree(&entry.path(), &destination);
   296	        } else {
   297	            fs::copy(entry.path(), destination).expect("copy package fixture file");
   298	        }
   299	    }
   300	}
