#!/usr/bin/env bash
# LLP 0032 P3(a): the regen-and-review-manifest gate. Re-runs codegen for every
# committed backend, verifies every ignored cache byte, and diffs only the
# review manifests plus policy-required consumer projections. The admin
# bindings retain their independent committed-tree gate.

set -euo pipefail

usage() {
    printf 'Usage: scripts/check-generated-artifacts [--help]\n'
}

case "${1:-}" in
    --help|-h) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; usage; exit 0 ;;
    '') ;;
    *) printf '[check-generated-artifacts] error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

run() {
    printf '[check-generated-artifacts] $'
    printf ' %q' "$@"
    printf '\n'
    "$@"
}

# The shared policy is also consumed by the agent-safe P-vs-C checker. Keep the
# jobs and their diff-custody roots in one registry so a regenerated backend
# cannot silently fall outside either gate.
CODEGEN_JOBS="$(node scripts/generated-artifact-policy.mjs jobs)"
if [ -z "$CODEGEN_JOBS" ]; then
    echo "[check-generated-artifacts] FAIL: generated-artifact policy returned no codegen jobs" >&2
    exit 1
fi
while IFS=$'\t' read -r outbound_actions target_profile backend_root; do
    codegen=(node packages/snapback-codegen/index.mjs "$backend_root")
    if [ "$target_profile" != "-" ]; then
        codegen+=(--target-profile "$target_profile")
    fi
    if [ "$outbound_actions" = "1" ]; then
        run env SNAPBACK_OUTBOUND_ACTIONS=1 "${codegen[@]}"
    else
        run "${codegen[@]}"
    fi
done <<< "$CODEGEN_JOBS"
run node scripts/check-authorization-review.mjs
run node scripts/check-data-tier-corpus-exemplar.mjs
run node admin-ui/generate-contract-bindings.mjs

REVIEW_ROOTS=()
REVIEW_CACHE_ROOTS="$(node scripts/generated-artifact-policy.mjs review-cache-roots)"
while IFS= read -r generated_root; do
    [ -n "$generated_root" ] || continue
    REVIEW_ROOTS+=("$generated_root")
done <<< "$REVIEW_CACHE_ROOTS"

REVIEW_PATHS=()
REVIEW_OUTPUT="$(node scripts/verify-generated-review-surface.mjs --check-index "${REVIEW_ROOTS[@]}")"
while IFS= read -r path; do
    if [ -n "$path" ]; then
        REVIEW_PATHS+=("$path")
    fi
done <<< "$REVIEW_OUTPUT"
ADMIN_GENERATED_ROOTS="$(node scripts/generated-artifact-policy.mjs admin-generated-roots)"
while IFS= read -r generated_root; do
    [ -n "$generated_root" ] || continue
    REVIEW_PATHS+=("$generated_root")
done <<< "$ADMIN_GENERATED_ROOTS"
# Team Chat and the packaged fixtures commit complete generated closures rather
# than only the review manifest and policy-selected consumer projections.
FULLY_COMMITTED_ROOTS="$(node scripts/generated-artifact-policy.mjs fully-committed-roots)"
while IFS= read -r generated_root; do
    [ -n "$generated_root" ] || continue
    REVIEW_PATHS+=("$generated_root")
done <<< "$FULLY_COMMITTED_ROOTS"

if ! git diff --exit-code -- "${REVIEW_PATHS[@]}"; then
    node scripts/check-authorization-review.mjs --against-git >&2 || true
    echo "[check-generated-artifacts] FAIL: committed review manifests or policy projections are stale" >&2
    exit 1
fi

UNTRACKED="$(git status --porcelain -- "${REVIEW_PATHS[@]}" | grep '^??' || true)"
if [ -n "$UNTRACKED" ]; then
    echo "[check-generated-artifacts] FAIL: codegen produced files that are not committed:" >&2
    echo "$UNTRACKED" >&2
    exit 1
fi

echo "[check-generated-artifacts] ok: review manifests, ignored caches, and committed projections are current"
