#!/usr/bin/env bash
# LLP 0032 P3(a): the regen-and-review-manifest gate. Re-runs codegen for every
# committed backend, verifies every ignored cache byte, and diffs only the
# review manifests plus policy-required consumer projections. The admin
# bindings retain their independent committed-tree gate.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

run() {
    printf '[check-generated-artifacts] $'
    printf ' %q' "$@"
    printf '\n'
    "$@"
}

run node packages/snapback-codegen/index.mjs demos/todo/snapback
run node packages/snapback-codegen/index.mjs demos/todo-v2/snapback
run node packages/snapback-codegen/index.mjs demos/todo-v2/snapback --target-profile remote-service-sqlite-ibex
# All Aboard's committed backend uses real data actions (outbound seam).
run env SNAPBACK_OUTBOUND_ACTIONS=1 node packages/snapback-codegen/index.mjs demos/all-aboard/snapback
run env SNAPBACK_OUTBOUND_ACTIONS=1 node packages/snapback-codegen/index.mjs demos/all-aboard/tests/egress-probe
# LLP 0075's frozen checkpoint also exercises the process-live outbound seam.
run env SNAPBACK_OUTBOUND_ACTIONS=1 node packages/snapback-codegen/index.mjs demos/competitive-checkpoint/snapback
run node packages/snapback-codegen/index.mjs demos/cursors-web/snapback
run node packages/snapback-codegen/index.mjs demos/graffiti/snapback
run node packages/snapback-codegen/index.mjs demos/card-game/snapback
run node packages/snapback-codegen/index.mjs demos/rbac/snapback
run node packages/snapback-codegen/index.mjs demos/shindig/snapback
run node packages/snapback-codegen/index.mjs demos/partiful-matrix/snapback
run node packages/snapback-codegen/index.mjs demos/backend-bakeoff/snapback
run node packages/snapback-codegen/index.mjs demos/catalog-lens/snapback
run node packages/snapback-codegen/index.mjs demos/dispatch-board/snapback
run node packages/snapback-codegen/index.mjs demos/pulse-monitor/snapback
run node packages/snapback-codegen/index.mjs demos/public-dashboard/snapback
run node packages/snapback-codegen/index.mjs demos/access-desk/snapback
run node admin-ui/generate-contract-bindings.mjs

REVIEW_ROOTS=(
    demos/todo/snapback/generated
    demos/todo-v2/snapback/generated
    demos/todo-v2/snapback/generated-remote-service
    demos/all-aboard/snapback/generated
    demos/all-aboard/tests/egress-probe/generated
    demos/competitive-checkpoint/snapback/generated
    demos/cursors-web/snapback/generated
    demos/graffiti/snapback/generated
    demos/card-game/snapback/generated
    demos/rbac/snapback/generated
    demos/shindig/snapback/generated
    demos/partiful-matrix/snapback/generated
    demos/backend-bakeoff/snapback/generated
    demos/catalog-lens/snapback/generated
    demos/dispatch-board/snapback/generated
    demos/pulse-monitor/snapback/generated
    demos/public-dashboard/snapback/generated
    demos/access-desk/snapback/generated
)

REVIEW_PATHS=()
REVIEW_OUTPUT="$(node scripts/verify-generated-review-surface.mjs --check-index "${REVIEW_ROOTS[@]}")"
while IFS= read -r path; do
    if [ -n "$path" ]; then
        REVIEW_PATHS+=("$path")
    fi
done <<< "$REVIEW_OUTPUT"
REVIEW_PATHS+=(admin-ui/generated)

if ! git diff --exit-code -- "${REVIEW_PATHS[@]}"; then
    echo "[check-generated-artifacts] FAIL: committed review manifests or policy projections are stale" >&2
    exit 1
fi

UNTRACKED="$(git status --porcelain -- "${REVIEW_PATHS[@]}" | grep '^??' || true)"
if [ -n "$UNTRACKED" ]; then
    echo "[check-generated-artifacts] FAIL: codegen produced files that are not committed:" >&2
    echo "$UNTRACKED" >&2
    exit 1
fi

echo "[check-generated-artifacts] ok: review manifests, ignored caches, and committed projections are current"
