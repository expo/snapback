#!/usr/bin/env bash

set -euo pipefail

# @ref LLP 0041#runtime-distribution — contributor repair rebuilds the clean
# release source-custody binary and the separate production package closure.

usage() {
  cat <<'EOF'
Usage: scripts/assemble-runtime-package [--help]

Rebuild and assemble the host platform runtime package from a clean Snapback
checkout. This also repairs and qualifies the linked CLI's ordinary release
binary. The public package seal refuses dirty or source-mismatched inputs.
EOF
}

case "${1:-}" in
  '') ;;
  --help|-h) usage; exit 0 ;;
  *)
    printf '[snapback-runtime-assembly] error: unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

log() {
  printf '[snapback-runtime-assembly] %s\n' "$*"
}

fail() {
  printf '[snapback-runtime-assembly] error: %s\n' "$*" >&2
  exit 1
}

dirty="$(git status --porcelain --untracked-files=normal --ignore-submodules=untracked)"
if [ -n "$dirty" ]; then
  fail 'the checkout is dirty; commit or otherwise preserve those changes and rerun from clean HEAD because a dirty binary/admin snapshot cannot receive a runtime package seal'
fi

case "$(uname -s):$(uname -m)" in
  Darwin:arm64)
    runtime_package='packages/snapback-runtime-darwin-arm64'
    ;;
  Linux:x86_64|Linux:amd64)
    runtime_package='packages/snapback-runtime-linux-x64'
    ;;
  *)
    fail "no runtime package assembler exists for $(uname -s)-$(uname -m)"
    ;;
esac

log 'step 1/5: preparing and qualifying the vendored Ibex/Hermes runtime'
if ! scripts/bootstrap-ibex-runtime; then
  fail 'step 1/5 failed: scripts/bootstrap-ibex-runtime did not prepare a qualified runtime'
fi

log 'step 2/5: building and qualifying the clean release source runtime'
if ! cargo build --release --bin snapback; then
  fail 'step 2/5 failed: cargo build --release --bin snapback did not produce the release source runtime'
fi
if [ "$(uname -s)" = 'Linux' ]; then
  mkdir -p target/lib
  cp vendor/ibex/linux/lib/libhermesvm.so target/lib/libhermesvm.so
fi
if ! node packages/snapback-cli/runtime-readiness.mjs issue \
    --root "$ROOT" \
    --binary "$ROOT/target/release/snapback" \
    --issuer source-runtime-repair; then
  fail 'step 2/5 failed: the release source runtime did not qualify or receive its sibling readiness receipt'
fi
if ! node packages/snapback-cli/runtime-readiness.mjs verify \
    --root "$ROOT" \
    --binary "$ROOT/target/release/snapback"; then
  fail 'step 2/5 failed: the release source runtime readiness receipt did not reopen'
fi

log 'step 3/5: building the clean production package binary'
if ! cargo build --profile production --bin snapback; then
  fail 'step 3/5 failed: cargo build --profile production --bin snapback did not produce the production package runtime'
fi

log 'step 4/5: installing the locked admin console dependencies'
if ! bun install --frozen-lockfile --cwd admin-ui; then
  fail 'step 4/5 failed: the locked admin-ui dependency install failed'
fi
log 'step 4/5: building the source-matched admin console snapshot'
if ! bun run --cwd admin-ui build; then
  fail 'step 4/5 failed: the source-matched admin-ui build failed'
fi

log "step 5/5: validating and swapping ${runtime_package}"
if ! node "${runtime_package}/prepare-runtime.mjs" \
    --source-test-staging --strict-clean-release; then
  fail "step 5/5 failed: ${runtime_package} was not assembled; any prior valid assembly was retained"
fi

log "assembled ${runtime_package}"
