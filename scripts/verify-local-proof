#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERIFY_EXACT="${SNAPBACK_VERIFY_EXACT:-auto}"

run() {
    printf '\n[snapback-verify] $'
    printf ' %q' "$@"
    printf '\n'
    "$@"
}

exact_available() {
    command -v bun >/dev/null 2>&1 || return 1
    if [ -n "${SNAPBACK_EXACT_ROOT:-}" ] && [ -d "$SNAPBACK_EXACT_ROOT" ]; then
        return 0
    fi
    [ -d "$ROOT/../exact" ] || [ -d "$ROOT/vendor/exact" ]
}

case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
    darwin)
        export DYLD_FRAMEWORK_PATH="$ROOT/vendor/ibex/ios/Frameworks:$ROOT/vendor/ibex/ios/Frameworks/macosx${DYLD_FRAMEWORK_PATH:+:$DYLD_FRAMEWORK_PATH}"
        ;;
    linux)
        export LD_LIBRARY_PATH="$ROOT/vendor/ibex/linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        ;;
esac

cd "$ROOT"

run ./ref-check --verbose
# LLP 0032 P7: the bring-up doctor's green path (read-only; red paths are
# proven by hand in fresh worktrees).
run scripts/ibex-doctor
# LLP 0032 P3 artifact gates: regen-and-diff staleness + tsc over generated
# types (the Rust-derived schema validation gate runs inside cargo test).
run scripts/check-generated-artifacts
run scripts/check-generated-types
run scripts/check-demo-surfaces
run env SNAPBACK_BOOTSTRAP_CHECK="${SNAPBACK_BOOTSTRAP_CHECK:-0}" scripts/bootstrap-ibex-runtime
run cargo clippy --all-targets -- -D warnings
run cargo test
run node demos/todo/tests/acceptance/headless.mjs
run node demos/todo-v2/tests/acceptance/headless.mjs
run node demos/all-aboard/tests/acceptance/egress.mjs
run node demos/_kit/tests/client-errors.mjs
run node demos/_kit/tests/provenance-unit.mjs
run node demos/_kit/tests/codegen-regressions.mjs
run node demos/_kit/tests/provider-live-conformance.mjs
run node demos/_kit/tests/regression-reconnect-nuke.mjs
run node demos/_kit/tests/regression-fake-live.mjs
run node demos/_kit/tests/regression-handshake-loss.mjs
run node demos/_kit/tests/regression-gc-starvation.mjs
run node demos/_kit/tests/regression-overlay-crossroom.mjs
run node demos/_kit/tests/regression-mixed-transport.mjs
run node demos/_kit/tests/regression-multiplexed-lanes.mjs
run node demos/_kit/tests/regression-midflight-resync.mjs
run node demos/_kit/tests/live-delta-e2e.mjs
run node packages/snapback-contract/index.test.mjs
run node packages/snapback-contract/build-preset.test.mjs
run node packages/snapback-codegen/identifier-validation.test.mjs

if [ "$VERIFY_EXACT" != "0" ]; then
    if exact_available; then
        run bun demos/todo/tests/acceptance/contract.mjs
        run bun demos/todo-v2/tests/acceptance/contract.mjs
        run bun demos/all-aboard/tests/acceptance/contract-live.mjs
        run bun demos/_kit/tests/regression-optimistic-clobber.mjs
        run bun demos/_kit/tests/regression-ephemeral-wiring.mjs
        run bun demos/_kit/tests/regression-multilive-scoped.mjs
        run bash -lc 'cd admin-ui && ./build.sh && npm test'
    elif [ "$VERIFY_EXACT" = "1" ]; then
        printf '[snapback-verify] error: SNAPBACK_VERIFY_EXACT=1 but bun or an Exact checkout is unavailable\n' >&2
        exit 1
    else
        printf '\n[snapback-verify] skipping Exact-dependent Contract/admin checks; set SNAPBACK_VERIFY_EXACT=1 to require them\n'
    fi
fi

printf '\n[snapback-verify] local proof checks complete\n'
