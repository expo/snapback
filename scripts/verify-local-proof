inapplicable_exact_surface_gates() {
    local evidence="$1" gate_id=""
    for gate_id in \
        exact-todo-install \
        exact-todo-v2-install \
        exact-graffiti-install \
        exact-all-aboard-install \
        exact-todo-contract \
        exact-todo-v2-contract \
        exact-graffiti-contract \
        exact-all-aboard-live \
        regression-optimistic-clobber \
        regression-ephemeral-wiring \
        regression-multilive-scoped \
        admin-install \
        admin-acceptance
    do
        inapplicable "$gate_id" exact-surface-enabled "$evidence"
    done
}

