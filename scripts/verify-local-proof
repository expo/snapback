#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERIFY_EXACT="${SNAPBACK_VERIFY_EXACT:-auto}"

run() {
    printf '\n[snapback-verify] $'
    printf ' %q' "$@"
    printf '\n'
    "$@"
}

exact_available() {
    command -v bun >/dev/null 2>&1 || return 1
    [ -f "$ROOT/demos/all-aboard/surfaces/contract/node_modules/@exact/contract/package.json" ] ||
        [ -f "$ROOT/demos/cursors-web/surfaces/contract/node_modules/@exact/contract/package.json" ]
}

stamp_snapback_build_identity() {
    local commit status
    commit="$(git rev-parse HEAD 2>/dev/null || true)"
    unset SNAPBACK_BUILD_GIT_COMMIT
    export SNAPBACK_BUILD_GIT_DIRTY=true
    if [ -n "$commit" ]; then
        export SNAPBACK_BUILD_GIT_COMMIT="$commit"
        if status="$(git status --porcelain 2>/dev/null)" && [ -z "$status" ]; then
            export SNAPBACK_BUILD_GIT_DIRTY=false
        fi
    fi
}

case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
    darwin)
        export DYLD_FRAMEWORK_PATH="$ROOT/vendor/ibex/ios/Frameworks:$ROOT/vendor/ibex/ios/Frameworks/macosx${DYLD_FRAMEWORK_PATH:+:$DYLD_FRAMEWORK_PATH}"
        ;;
    linux)
        export LD_LIBRARY_PATH="$ROOT/vendor/ibex/linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        ;;
esac

cd "$ROOT"

run ./ref-check --verbose
run python3 tests/ref_check_v0.py
run node tests/demo_setup_v0.mjs
run node tests/allowlist_install_v0.mjs
run node tests/ci_workflows_v0.mjs
run node tests/cargo_target_headroom_v0.mjs
run node scripts/check-package-test-inventory.mjs
# LLP 0032 P7: the bring-up doctor's green path (read-only; red paths are
# proven by hand in fresh worktrees).
run scripts/ibex-doctor
# LLP 0032 P3 artifact gates: regen-and-diff staleness + tsc over generated
# types (the Rust-derived schema validation gate runs inside cargo test).
run scripts/check-generated-artifacts
run scripts/check-generated-types
run scripts/check-demo-surfaces
# ENG-22543 (Diary 0011 flip-condition 2): production-build every REQUIRED demo
# web surface so a dev-green/ship-broken surface can't recur silently. Registry
# surfaces build here unconditionally from their committed registry locks; no
# sibling Exact checkout or source-asset bridge participates.
run node scripts/check-required-surface-builds.mjs
run node tests/required_surface_builds_v0.mjs
run node demos/_kit/tests/server-process-lifecycle.mjs
# @ref LLP 0010#native-runtime-bootstrap — prepare native artifacts here, then
# stamp every subsequent Snapback Cargo unit with the checkout identity that
# acceptance will verify.
run env SNAPBACK_BOOTSTRAP_CHECK="${SNAPBACK_BOOTSTRAP_CHECK:-0}" scripts/bootstrap-ibex-runtime
run node scripts/check-toolchain-authority.mjs
stamp_snapback_build_identity
run cargo clippy --all-targets -- -D warnings
# ENG-24383: the vendored Ibex runtime is part of Snapback's executable
# dependency graph. Keep its PEM-parser migration closed by failing on both
# vulnerabilities and packages RustSec has marked unmaintained.
run cargo audit --deny unmaintained
run cargo test
# ENG-24378 clean-runner follow-up: clippy/test and the normal executable use
# distinct large vendored-Ibex native archives. Reclaim completed workspace test
# artifacts before constructing the acceptance binary instead of risking an
# archiver crash at peak disk usage. Preserve dependency artifacts when that
# leaves at least 8 GiB for the native archive and link; otherwise clean the
# whole test profile. Keep local developer caches intact.
case "${CI:-}" in
true|TRUE|True|1|yes|YES|on|ON)
    run cargo clean --profile test -p snapback
    if ! cleanup_decision="$(node scripts/cargo-target-headroom.mjs --cleanup-decision)"; then
        cleanup_decision="unknown"
    fi
    case "$cleanup_decision" in
        clean)
            run cargo clean --profile test
            ;;
        preserve)
            ;;
        *)
            printf '[snapback-verify] unable to measure CI disk headroom; cleaning the test profile\n'
            run cargo clean --profile test
            ;;
    esac
    ;;
esac
# cargo test builds test harnesses, not the normal server executable. Build it
# visibly and outside the 60 s runtime-ready deadline; startServer's cargo run
# sees the same identity stamp and measures startup rather than a cold link.
run cargo build --locked --bin snapback
run node demos/todo/tests/acceptance/headless.mjs
run node demos/todo-v2/tests/acceptance/headless.mjs
run node demos/all-aboard/tests/acceptance/egress.mjs
run node demos/all-aboard/tests/acceptance/startup-timing.test.mjs
run node demos/_kit/tests/auth-handshake.mjs
run node demos/_kit/tests/auth-coordinator-client.mjs
run node demos/_kit/tests/auth-invalidation-client.mjs
run node demos/_kit/tests/client-errors.mjs
run node demos/_kit/tests/live-wire-schema.mjs
run node demos/_kit/tests/provenance-unit.mjs
run node demos/_kit/tests/codegen-regressions.mjs
run node demos/_kit/tests/exact-resolver-packages.mjs
run node demos/_kit/tests/provider-live-conformance.mjs
run node demos/_kit/tests/regression-reconnect-nuke.mjs
run node demos/_kit/tests/regression-fake-live.mjs
run node demos/_kit/tests/regression-handshake-loss.mjs
run node demos/_kit/tests/regression-gc-starvation.mjs
run node demos/_kit/tests/regression-overlay-crossroom.mjs
run node demos/_kit/tests/regression-mixed-transport.mjs
run node demos/_kit/tests/regression-multiplexed-lanes.mjs
run node demos/_kit/tests/regression-midflight-resync.mjs
run node demos/_kit/tests/live-delta-e2e.mjs
# Package-owned test commands are the inventory authority. The preceding
# inventory gate proves every maintained test file is declared, so this cannot
# silently regress to a hand-picked subset (ENG-24502).
run bun run --cwd packages/snapback-contract test
run bun run --cwd packages/snapback-codegen test
# LLP 0040/0049: run the explicit inventory of every non-remote Cloudflare
# regression. The runner pins suite IDs, the expected check count, completion
# evidence, and a classification for every file so coverage cannot disappear
# through a rename or an unreferenced standalone script.
run node cloudflare/test/local-suite.mjs

if [ "$VERIFY_EXACT" != "0" ]; then
    if exact_available; then
        # Every acceptance caller resolves Exact only from its own lock-owned
        # surface tree. A clean canonical runner must install each one instead
        # of inheriting another demo's successful install (ENG-24502).
        run bun install --frozen-lockfile --cwd demos/todo/surfaces/contract
        run bun install --frozen-lockfile --cwd demos/todo-v2/surfaces/contract
        run bun install --frozen-lockfile --cwd demos/graffiti/surfaces/contract
        run bun install --frozen-lockfile --cwd demos/all-aboard/surfaces/contract
        run bun demos/todo/tests/acceptance/contract.mjs
        run bun demos/todo-v2/tests/acceptance/contract.mjs
        run bun demos/graffiti/tests/acceptance/contract.mjs
        run bun demos/all-aboard/tests/acceptance/contract-live.mjs
        run bun demos/_kit/tests/regression-optimistic-clobber.mjs
        run bun demos/_kit/tests/regression-ephemeral-wiring.mjs
        run bun demos/_kit/tests/regression-multilive-scoped.mjs
        run bun install --frozen-lockfile --cwd admin-ui
        # ENG-24575: production dependency vulnerabilities are a required
        # proof gate, not an optional local command that CI can forget to run.
        run bash -lc 'cd admin-ui && ./build.sh && bun run test && bun run audit:production'
    elif [ "$VERIFY_EXACT" = "1" ]; then
        printf '[snapback-verify] error: SNAPBACK_VERIFY_EXACT=1 but bun or installed Exact packages are unavailable\n' >&2
        exit 1
    else
        printf '\n[snapback-verify] skipping Exact-dependent Contract/admin checks; set SNAPBACK_VERIFY_EXACT=1 to require them\n'
    fi
fi

printf '\n[snapback-verify] local proof checks complete\n'
