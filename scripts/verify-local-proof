#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The public entry layer owns selection and completion supervision. It prepares
# the selector artifacts before launching the proof body, then derives the
# completion receipt itself from that exact selected set and the final JSONL.
PROOF_RUNNER_SELECTION_ONLY="${PROOF_RUNNER_SELECTION_ONLY:-0}"
if [ "$PROOF_RUNNER_SELECTION_ONLY" = "1" ] \
    && [ "${PROOF_RUNNER_SUPERVISED:-0}" != "1" ]; then
    printf '[snapback-proof] selection-only mode is parent-private\n' >&2
    exit 2
fi
if [ "${PROOF_RUNNER_SUPERVISED:-0}" != "1" ] \
    && [ "$PROOF_RUNNER_SELECTION_ONLY" != "1" ]; then
    if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
        PROOF_RUNNER_SUPERVISED=1 PROOF_RUNNER_SELECTION_ONLY=1 \
            /bin/bash "$ROOT/scripts/verify-local-proof" "$1"
        exit $?
    fi
    # shellcheck source=scripts/lib/proof-runner.sh
    source "$ROOT/scripts/lib/proof-runner.sh"
    mkdir -p "$ROOT/target/proof"
    parent_results="${SNAPBACK_PROOF_RESULTS:-$ROOT/target/proof/local-proof-results.jsonl}"
    SNAPBACK_PROOF_COMPLETION_RECEIPT="${SNAPBACK_PROOF_COMPLETION_RECEIPT:-$ROOT/target/proof/local-proof-completion.json}"
    # Invalidate the retained pair before selection. The scheduled consumer
    # still runs after selector failures, so no prior invocation may remain
    # available for it to mistake for this one.
    proof_runner_invalidate_retained_evidence \
        "$SNAPBACK_PROOF_COMPLETION_RECEIPT" "$parent_results" || exit $?
    parent_selected="${SNAPBACK_PROOF_SELECTED_GATES:-$ROOT/target/proof/local-proof-selected-gates.$$.txt}"
    parent_selection_metadata="$(mktemp "$ROOT/target/proof/.local-proof-supervision-selection.XXXXXX")" \
        || exit 2
    proof_supervisor_status=0
    env \
        PROOF_RUNNER_SUPERVISED=1 \
        PROOF_RUNNER_SELECTION_ONLY=1 \
        PROOF_RUNNER_SELECTION_METADATA_PATH="$parent_selection_metadata" \
        SNAPBACK_PROOF_RESULTS="$parent_results" \
        SNAPBACK_PROOF_SELECTED_GATES="$parent_selected" \
        /bin/bash "$ROOT/scripts/verify-local-proof" "$@" \
        || proof_supervisor_status=$?
    if [ "$proof_supervisor_status" -ne 0 ]; then
        rm -f -- "$parent_selection_metadata"
        exit "$proof_supervisor_status"
    fi
    parent_selected_count="$(node -e '
const value = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
process.stdout.write(String(value.selectedGateCount));
' "$parent_selection_metadata")" || {
        rm -f -- "$parent_selection_metadata"
        exit 2
    }
    parent_selected_digest="$(node -e '
const value = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
process.stdout.write(value.selectedGateDigest);
' "$parent_selection_metadata")" || {
        rm -f -- "$parent_selection_metadata"
        exit 2
    }
    rm -f -- "$parent_selection_metadata"
    parent_selected_snapshot="$(proof_selected_snapshot_path "$parent_results")" || exit 2
    proof_supervisor_status=0
    proof_runner_supervise local-proof "$parent_results" "$parent_selected_snapshot" \
        "$parent_selected_count" "$parent_selected_digest" -- \
        env \
            SNAPBACK_PROOF_RESULTS="$parent_results" \
            SNAPBACK_PROOF_SELECTED_GATES="$parent_selected" \
            /bin/bash "$ROOT/scripts/verify-local-proof" "$@" \
        || proof_supervisor_status=$?
    exit "$proof_supervisor_status"
fi
if [ "$PROOF_RUNNER_SELECTION_ONLY" != "1" ] \
    && ! { [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; } \
    && { [ -z "${PROOF_RUNNER_COMPLETION_FD:-}" ] \
        || [ -z "${PROOF_RUNNER_PHASE_PATH:-}" ] \
        || [ -z "${PROOF_RUNNER_RUN_ID:-}" ]; }; then
    printf '[snapback-proof] supervised proof body is missing its completion handshake\n' >&2
    exit 2
fi
unset PROOF_RUNNER_SUPERVISED

VERIFY_EXACT="${SNAPBACK_VERIFY_EXACT:-auto}"
case "$VERIFY_EXACT" in
    0|1|auto) ;;
    *)
        printf '[snapback-verify] SNAPBACK_VERIFY_EXACT must be 0, 1, or auto (got %s)\n' \
            "$VERIFY_EXACT" >&2
        exit 2
        ;;
esac

usage() {
    cat <<'EOF'
Usage: scripts/verify-local-proof [OPTIONS]

Options:
  --complete                 Run the complete canonical gate inventory (default).
  --affected REV             Run gates selected by changes since Git revision REV.
  --gate ID                  Re-run one gate and its prerequisite closure.
  --selection-receipt FILE   Reopen an exact selector receipt for the current HEAD.
  --keep-going               Continue independent gates after a root failure.
  --help, -h                 Show this help without running proof selection.

SNAPBACK_PROOF_KEEP_GOING=1 is the environment equivalent of --keep-going.
SNAPBACK_PROOF_RESULTS sets the gate-result JSONL output path.
SNAPBACK_PROOF_GATE_TIMEOUT_SECONDS overrides every gate's wall-clock cap
(canonical positive decimal seconds, maximum 536870911; default 3600). Gates
may declare --timeout-seconds with the same syntax.
SNAPBACK_PROOF_GATE_TERM_GRACE_SECONDS controls TERM-to-KILL grace (default 5).
SNAPBACK_PROOF_COMPLETION_RECEIPT sets the retained, parent-derived completion receipt.
EOF
}

# Default is fail-fast (a normal local run stops at the first broken gate).
# --keep-going / SNAPBACK_PROOF_KEEP_GOING=1 continues independent gates while
# transitive dependents become BLOCKED, so one failed producer cannot turn into
# dozens of repeated server-start timeouts (LLP 0175 D1).
KEEP_GOING=0
PROOF_CADENCE="complete"
PROOF_BASE_REVISION=""
PROOF_SELECTION_RECEIPT=""
PROOF_GATE_ID=""
PROOF_COMPLETE_EXPLICIT=0
case "${SNAPBACK_PROOF_KEEP_GOING:-}" in
    1|true|TRUE|yes|on) KEEP_GOING=1 ;;
esac
while [ "$#" -gt 0 ]; do
    case "$1" in
        --keep-going)
            KEEP_GOING=1
            shift
            ;;
        --complete)
            PROOF_CADENCE="complete"
            PROOF_COMPLETE_EXPLICIT=1
            shift
            ;;
        --affected)
            [ "$#" -ge 2 ] || {
                printf '[snapback-verify] --affected requires a Git base revision\n' >&2
                exit 2
            }
            PROOF_CADENCE="affected"
            PROOF_BASE_REVISION="$2"
            shift 2
            ;;
        --selection-receipt)
            [ "$#" -ge 2 ] || {
                printf '[snapback-verify] --selection-receipt requires a path\n' >&2
                exit 2
            }
            PROOF_SELECTION_RECEIPT="$2"
            shift 2
            ;;
        --gate)
            [ "$#" -ge 2 ] || {
                printf '[snapback-verify] --gate requires a gate id\n' >&2
                usage >&2
                exit 2
            }
            PROOF_GATE_ID="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf '[snapback-verify] unknown argument: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -n "$PROOF_SELECTION_RECEIPT" ] && [ -n "$PROOF_BASE_REVISION" ]; then
    printf '[snapback-verify] --selection-receipt and --affected are mutually exclusive\n' >&2
    exit 2
fi
if [ -n "$PROOF_GATE_ID" ] && {
    [ -n "$PROOF_SELECTION_RECEIPT" ] || [ -n "$PROOF_BASE_REVISION" ] ||
        [ "$PROOF_COMPLETE_EXPLICIT" -eq 1 ];
}; then
    printf '[snapback-verify] --gate is mutually exclusive with --complete, --affected, and --selection-receipt\n' >&2
    exit 2
fi

PROOF_SELECTION_RESULTS="${SNAPBACK_PROOF_SELECTION_RESULTS:-$ROOT/target/proof/local-proof-selection.json}"
PROOF_SELECTED_GATES="${SNAPBACK_PROOF_SELECTED_GATES:-$ROOT/target/proof/local-proof-selected-gates.$$.txt}"
mkdir -p "$ROOT/target/proof"
mkdir -p "$(dirname "$PROOF_SELECTED_GATES")"
if [ -n "$PROOF_GATE_ID" ]; then
    PROOF_CADENCE="gate $PROOF_GATE_ID"
    selection_metadata="$(node "$ROOT/scripts/select-local-proof.mjs" gate \
        --id "$PROOF_GATE_ID" --output "$PROOF_SELECTED_GATES")"
elif [ -n "$PROOF_SELECTION_RECEIPT" ]; then
    node "$ROOT/scripts/select-local-proof.mjs" validate "$PROOF_SELECTION_RECEIPT"
    PROOF_CADENCE="$(node -e \
        'process.stdout.write(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).cadence)' \
        "$PROOF_SELECTION_RECEIPT")"
else
    selection_args=(
        plan
        --cadence "$PROOF_CADENCE"
        --head HEAD
        --output "$PROOF_SELECTION_RESULTS"
    )
    if [ "$PROOF_CADENCE" = "affected" ]; then
        selection_args+=(--base "$PROOF_BASE_REVISION")
    fi
    node "$ROOT/scripts/select-local-proof.mjs" "${selection_args[@]}"
    PROOF_SELECTION_RECEIPT="$PROOF_SELECTION_RESULTS"
fi
if [ -z "$PROOF_GATE_ID" ]; then
    selection_metadata="$(node "$ROOT/scripts/select-local-proof.mjs" materialize \
        --receipt "$PROOF_SELECTION_RECEIPT" --output "$PROOF_SELECTED_GATES")"
fi
PROOF_SELECTED_COUNT="$(node -e \
    'process.stdout.write(String(JSON.parse(process.argv[1]).selectedGateCount))' \
    "$selection_metadata")"
PROOF_SELECTED_DIGEST="$(node -e \
    'process.stdout.write(JSON.parse(process.argv[1]).selectedGateDigest)' \
    "$selection_metadata")"

if [ "$PROOF_RUNNER_SELECTION_ONLY" = "1" ]; then
    if [ -z "${PROOF_RUNNER_SELECTION_METADATA_PATH:-}" ]; then
        printf '[snapback-proof] selection-only mode requires a private metadata path\n' >&2
        exit 2
    fi
    node -e '
const { writeFileSync } = require("node:fs");
const [path, count, digest] = process.argv.slice(1);
writeFileSync(path, `${JSON.stringify({ selectedGateCount: Number(count), selectedGateDigest: digest })}\n`);
' "$PROOF_RUNNER_SELECTION_METADATA_PATH" "$PROOF_SELECTED_COUNT" \
        "$PROOF_SELECTED_DIGEST"
    exit 0
fi

# @ref LLP 0175#d1--make-keep-going-dependency-aware — named gates retain
# structured timings and distinguish root FAIL from transitive BLOCKED.
# shellcheck source=scripts/lib/proof-runner.sh
source "$ROOT/scripts/lib/proof-runner.sh"
PROOF_RESULTS="${SNAPBACK_PROOF_RESULTS:-$ROOT/target/proof/local-proof-results.jsonl}"
# @ref LLP 0189#decision — D-1 signatures belong to the authoritative
# complete cadence; affected landing receipts do not pay the capture cost.
if [ "$PROOF_CADENCE" = "complete" ]; then
    export SNAPBACK_PROOF_CAPTURE_FAILURE_SIGNATURES=1
fi
proof_runner_init local-proof "$PROOF_RESULTS" "$KEEP_GOING" "$PROOF_SELECTED_GATES" \
    "$PROOF_SELECTED_COUNT" "$PROOF_SELECTED_DIGEST"

# Host/policy inapplicability is a closed inventory separate from cadence
# NOT_SELECTED. The proof runner validates every evidence object with the same
# helper as the battery and matches it to runner-observed host/policy facts.
proof_runner_declare_inapplicable cargo-test-profile-clean ci-only
proof_runner_declare_inapplicable cargo-test-profile-clean cargo-clean-required
proof_runner_declare_inapplicable runtime-package-stage linux-host
proof_runner_declare_inapplicable swift-client swift-toolchain
proof_runner_declare_inapplicable exact-todo-install exact-surface-enabled
proof_runner_declare_inapplicable exact-todo-v2-install exact-surface-enabled
proof_runner_declare_inapplicable exact-graffiti-install exact-surface-enabled
proof_runner_declare_inapplicable exact-all-aboard-install exact-surface-enabled
proof_runner_declare_inapplicable exact-todo-contract exact-surface-enabled
proof_runner_declare_inapplicable exact-todo-v2-contract exact-surface-enabled
proof_runner_declare_inapplicable exact-graffiti-contract exact-surface-enabled
proof_runner_declare_inapplicable exact-all-aboard-live exact-surface-enabled
proof_runner_declare_inapplicable regression-optimistic-clobber exact-surface-enabled
proof_runner_declare_inapplicable regression-ephemeral-wiring exact-surface-enabled
proof_runner_declare_inapplicable regression-multilive-scoped exact-surface-enabled
proof_runner_declare_inapplicable admin-install exact-surface-enabled
proof_runner_declare_inapplicable admin-acceptance exact-surface-enabled
proof_runner_declare_inapplicable exact-dependencies-required exact-dependencies-sentinel-needed

run() {
    local gate_id="$1"
    if proof_selected_gate_index "$gate_id" >/dev/null 2>&1; then
        proof_gate "$@"
    else
        proof_not_selected "$gate_id" "not selected by $PROOF_CADENCE proof policy"
    fi
}

inapplicable() {
    local gate_id="$1" predicate="$2" evidence="$3"
    if proof_selected_gate_index "$gate_id" >/dev/null 2>&1; then
        proof_inapplicable "$gate_id" "$predicate" "$evidence"
    else
        proof_not_selected "$gate_id" "not selected by $PROOF_CADENCE proof policy"
    fi
}

finish() {
    proof_runner_finish
}

exact_available() {
    command -v bun >/dev/null 2>&1 || return 1
    # Required CI mode owns the frozen surface installs below. Do not require
    # their ignored node_modules outputs to exist before those producer gates
    # get a chance to run on a clean checkout.
    if [ "$VERIFY_EXACT" = "1" ]; then
        return 0
    fi
    [ -f "$ROOT/demos/all-aboard/surfaces/contract/node_modules/@exact/contract/package.json" ] ||
        [ -f "$ROOT/demos/cursors-web/surfaces/contract/node_modules/@exact/contract/package.json" ]
}

# The dirty fact is scoped to the runtime binary's input set (shared
# definition: scripts/runtime-build-inputs.txt), not the whole tree, so
# demo/guide-authoring/LLP/issue edits do not disqualify a prepared binary or
# force identity-consuming crates to recompile
# (issues/closed/20260805-whole-tree-dirty-flag-forces-runtime-rebuild.md).
# A missing definition file falls back to whole-tree status (conservative).
stamp_snapback_build_identity() {
    local commit status inputs_file line
    local -a input_pathspecs=()
    commit="$(git rev-parse HEAD 2>/dev/null || true)"
    unset SNAPBACK_BUILD_GIT_COMMIT
    export SNAPBACK_BUILD_GIT_DIRTY=true
    if [ -n "$commit" ]; then
        export SNAPBACK_BUILD_GIT_COMMIT="$commit"
        inputs_file="$ROOT/scripts/runtime-build-inputs.txt"
        if [ -f "$inputs_file" ]; then
            while IFS= read -r line; do
                case "$line" in ''|\#*) continue ;; esac
                input_pathspecs+=("$line")
            done <"$inputs_file"
        fi
        if [ "${#input_pathspecs[@]}" -gt 0 ]; then
            status="$(git status --porcelain --ignore-submodules=untracked -- "${input_pathspecs[@]}" 2>/dev/null)" || status="(git status failed)"
        else
            status="$(git status --porcelain 2>/dev/null)" || status="(git status failed)"
        fi
        if [ -z "$status" ]; then
            export SNAPBACK_BUILD_GIT_DIRTY=false
        else
            printf '[local-proof] runtime input set is dirty; builds are stamped SNAPBACK_BUILD_GIT_DIRTY=true by:\n%s\n' "$status" >&2
        fi
    fi
}

PROOF_HOST_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$PROOF_HOST_OS" in
    darwin)
        export DYLD_FRAMEWORK_PATH="$ROOT/vendor/ibex/ios/Frameworks:$ROOT/vendor/ibex/ios/Frameworks/macosx${DYLD_FRAMEWORK_PATH:+:$DYLD_FRAMEWORK_PATH}"
        ;;
    linux)
        export LD_LIBRARY_PATH="$ROOT/vendor/ibex/linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        ;;
esac

cd "$ROOT"

run ref-check -- ./ref-check --verbose
run ref-check-fixtures -- python3 tests/ref_check_v0.py
run allowlist-install-fixtures -- node tests/allowlist_install_v0.mjs
run action-fetch-fence-fixtures -- node --test tests/action_fetch_fence_v0.mjs
run harness-envelope-fixtures -- node --test packages/snapback-harness/envelope.test.mjs
run ci-workflow-fixtures -- node tests/ci_workflows_v0.mjs
run cargo-headroom-fixtures -- node tests/cargo_target_headroom_v0.mjs
run runtime-link-fixtures -- node --test tests/runtime_link_smoke_v0.mjs
run runtime-readiness-fixtures -- node --test tests/runtime_readiness_receipt_v0.mjs
run proof-runner-fixtures -- node --test tests/proof_runner_v0.mjs
run local-proof-inventory -- node --test tests/local_proof_inventory_v0.mjs
run affected-selector-fixtures -- node --test tests/local_proof_selection_v0.mjs
run path-migration-stragglers -- node scripts/check-path-migration-stragglers.mjs
run path-migration-straggler-fixtures -- node --test tests/path_migration_stragglers_v0.mjs
run workspace-graph -- node scripts/check-workspace-graph.mjs
run security-gate-fixtures -- node --test tests/security_gates_v1.mjs
run cross-crate-path-includes -- node scripts/check-cross-crate-path-includes.mjs
run kernel-raw-sql-api -- node scripts/check-kernel-raw-sql-api.mjs
run security-boundaries -- node scripts/check-security-boundaries.mjs
run workspace-graph-fixtures -- node --test tests/workspace_graph_v1.mjs
run rustfmt -- node scripts/check-rustfmt.mjs
run authoring-profile-branches -- node scripts/check-authoring-profile-branches.mjs
run package-test-inventory -- node scripts/check-package-test-inventory.mjs
# @ref LLP 0276#scripts — the Phase 0 scripts-test inventory is a cheap
# fail-closed join between every root scripts/*.test.mjs file and its runner.
run scripts-test-inventory -- node scripts/check-scripts-test-inventory.mjs
run diary-identity -- node scripts/check-diary-identity.mjs --strict
# Root production dependencies include the published workspace closure. This
# gate is deliberately independent of the separately selected admin-ui audit.
run js-production-audit -- node scripts/check-js-production-audit.mjs
# @ref LLP 0134#9-acceptance — closed maturity records and the pushed-range
# transition pin are checked before generated artifacts or native builds.
run capability-maturity-fixtures -- node tests/capability-maturity.test.mjs
run capability-maturity -- node scripts/check-capability-maturity.mjs
# @ref LLP 0162#8-capability-honesty — the agent-safe publication transition
# is valid only when its P-vs-C path history, implementation-tree digest, and
# exact evidence bytes pass the source-owned checker. Keep both the checker's
# adversarial self-tests and the live records in the canonical proof.
run agent-safe-publication-fixtures -- node --test tests/agent_safe_publication_checker_v1.mjs
run agent-safe-publication -- node scripts/check-agent-safe-publication.mjs
# @ref LLP 0145#phase-a--establish-a-size-ratchet — reproduce every shipped
# client profile/subpath closure and fail on growth beyond the frozen first run.
run client-bundle-metrology -- node scripts/client-bundle-metrology.mjs --check
# RN carrier conformance (issues/20260803-rn-carrier-bricked-tosorted-
# registration-ledger.md): the shipped @expo/snapback-client and
# @expo/snapback-react runtime graphs execute on static Hermes, which lacks
# the ES2023+ array/grouping intrinsics node has; ban them statically.
run hermes-intrinsics -- node scripts/check-hermes-intrinsics.mjs
# @ref LLP 0115#cv-1-prove-the-public-external-packagestarter-loop — CV-1 named
# gap 4 (the `@expo/snapback-client/online` TS7016 class): every published subpath
# must resolve declarations under the `types` condition, compile for an
# external nodenext consumer, and match its module's runtime export surface.
run package-export-types -- node scripts/check-package-export-types.mjs
run package-export-types-fixtures -- node --test scripts/check-package-export-types.test.mjs
run package-readme-funnel -- node --test scripts/package-readme-funnel.test.mjs
run relation-activity-publication -- node tests/conformance/relation-activity-publication-v1.mjs
run sequence-allocation-publication -- node tests/conformance/sequence-allocation-publication-v1.mjs
run local-store-publication -- node tests/conformance/local-persistent-store-publication-v1.mjs
run snapshot-batch-parity -- node tests/conformance/snapshot-batch-sbsb1-parity-v1.mjs
run snapshot-batch-v2-parity -- node tests/conformance/snapshot-batch-sbsb2-parity-v1.mjs
# @ref LLP 0157#move-1-workload-exit-llp-0155-normative-transcription — the
# fresh provider-native workload witness remains source-bound and preserves
# its qualification-binary edge through tracked runtime-readiness evidence.
run fleet-observatory-move1-receipt -- node tests/acceptance/fleet-observatory-move1-v1.mjs --check --require-qualified
run runtime-package-authority-fixtures -- node --test scripts/runtime-package-authority.test.mjs scripts/binary-size-metrology.test.mjs
run qualified-staging-ledger-fixtures -- node --test scripts/qualified-staging-ledger-check.test.mjs
run publication-store-qualification-fixtures -- node --test scripts/publication-store-qualification-gate.test.mjs
run published-closure-boot-smoke-fixtures -- node --test scripts/published-closure-boot-smoke.test.mjs
run fastpath-release-fixtures -- node --test scripts/snapback-fastpath-release.test.mjs
run hermes-carrier-staging-fixtures -- node --test scripts/stage-linux-hermes-release.test.mjs
run package-cold-install-fixtures -- node --test scripts/snapback-package-cold-install.test.mjs
run local-source-package-closure -- node --test scripts/local-source-package-closure.test.mjs
run template-portfolio-qualification-fixtures -- node --test scripts/template-portfolio-qualification-lib.test.mjs
run template-portfolio-self-check -- node scripts/template-registry-canary.mjs --self-check
# @ref LLP 0196#program — the published-registry half of template freshness
# is report-only and therefore belongs to LLP 0189's scheduled complete battery,
# not to the affected landing or pre-release blocking paths.
run template-registry-canary -- node scripts/template-registry-canary.mjs --receipt target/proof/template-registry-canary.json
run result-transform-ship-gate -- node tests/conformance/result-transform-ship-gate-v1.mjs --check
# @ref LLP 0041#unreviewed-post-round-correction-publication-lease-and-rollback
# — candidate publication and default-tag promotion are separate operations;
# the latter is full-vector guarded and reverse-rolls back without clobbering
# a concurrent release.
run promotion-fixtures -- node --test scripts/snapback-promotion-core.test.mjs
run latest-proof-plan-generator-fixtures -- node --test scripts/snapback-generate-latest-proof-plan.test.mjs
run prior-vector-observer-fixtures -- node --test scripts/snapback-observe-prior-vector.test.mjs
# @ref LLP 0041#nine-package-candidate-promotion--2026-07-28 — the final
# latest-root proof collector admits only the exact correlated GitHub-hosted
# macOS/Linux run and hands the promoter two reopenable receipt files.
run github-latest-proof-fixtures -- node --test scripts/snapback-github-latest-proof.test.mjs
# @ref LLP 0063#sequence — keep the final two-repository revision-set
# collector's self-reference, path-custody, and tamper-failure rules in the
# ordinary local proof even while its cumulative claim remains red.
run revision-set-fixtures -- node --test demos/partiful-matrix/tests/acceptance/final-immutable-revision-set.test.mjs
# LLP 0032 P3 artifact gate: regenerate and verify the ignored cache before
# the guide reads generated snippet sources. The guide's fresh-tree contract
# requires this ordering (LLP 0061 §3); review manifests and policy-required
# committed projections still fail closed on any diff.
run generated-artifacts -- scripts/check-generated-artifacts
# The isolated committed-history fixtures copy generated Guide inputs into
# their disposable clones. Those inputs are intentionally ignored, so a clean
# runner must execute the canonical producer before the fixtures classify
# missing dependencies versus stale records.
run drift-prone-gate-fixtures --requires generated-artifacts -- node --test tests/drift_prone_gates_v0.mjs
# @ref LLP 0061#3-verification-snippets-that-ran — published-closure fixtures
# keep released, unreleased, stale-fence, banner, and record failures executable.
run guide-published-closure-fixtures -- node --test scripts/guide-published-closure.test.mjs
run guide-shell-command-fixtures -- node --test scripts/check-guide-shell-commands.test.mjs
# LLP 0061: guide corpus — snippet transclusion-match, capability-index joins,
# manifest staleness. Docs-only fast path: node scripts/check-guide.mjs.
run guide --requires generated-artifacts -- node scripts/check-guide.mjs
# LLP 0184 Phase 1: the ControlCatalogV1 compiler is the checked join of the
# LLP 0031/0024 registries, CLI/MCP/AdminClient declarations, and the
# hosted-adapter manifest (§Design/2, §3, §3a). --check fails on any stale
# committed catalog or an incomplete domain/parity join (rules 1-11); it does
# not require a fresh cargo build (packages/snapback-cli/control-plane-
# registry.json is itself drift-gated separately by
# `cargo test --test control_catalog_registry_export`, run alongside other
# Rust suites, not by this docs/JS-only step).
run control-catalog -- node scripts/generate-control-catalog.mjs --check
