# ENG-24378 clean-runner follow-up: clippy/test and the normal executable use
# distinct large vendored-Ibex native archives. Reclaim completed workspace test
# artifacts before constructing the acceptance binary instead of risking an
# archiver crash at peak disk usage. Preserve dependency artifacts when that
# leaves at least 8 GiB for the native archive and link; otherwise clean the
# whole test profile. Keep local developer caches intact.
case "${CI:-}" in
true|TRUE|True|1|yes|YES|on|ON)
    if ! cleanup_decision="$(node scripts/cargo-target-headroom.mjs --cleanup-decision)"; then
        cleanup_decision="unknown"
    fi
    case "$cleanup_decision" in
        clean)
            run cargo-test-profile-clean -- cargo clean --profile test
            ;;
        preserve)
            PROOF_CARGO_CLEANUP_DECISION="preserve"
            inapplicable cargo-test-profile-clean cargo-clean-required \
                '{"ci":true,"cleanupDecision":"preserve"}'
            ;;
        *)
            printf '[snapback-verify] unable to measure CI disk headroom; cleaning the test profile\n'
            run cargo-test-profile-clean -- cargo clean --profile test
            ;;
    esac
    ;;
*)
    inapplicable cargo-test-profile-clean ci-only '{"ci":false}'
    ;;
esac
# cargo test builds test harnesses, not the normal server executable. A restored
# Cargo cache can retain the root build-script output from the pre-proof
# bootstrap even after stamp_snapback_build_identity establishes the final
# clean identity. Remove only the root package's completed artifacts so
# crates/snapback/build.rs must replay that deterministic stamp; dependency and vendored-Ibex
# artifacts remain warm. Then build visibly and outside the 60 s runtime-ready
# deadline, so startServer measures startup rather than a cold link.
build_current_binary() {
    case "${SNAPBACK_BUILD_GIT_COMMIT:-}" in
        '')
            printf 'SNAPBACK_BUILD_IDENTITY_MISMATCH: final build has no commit stamp\n' >&2
            return 1
            ;;
    esac
    case "${SNAPBACK_BUILD_GIT_DIRTY:-}" in
        true|false) ;;
        *)
            printf 'SNAPBACK_BUILD_IDENTITY_MISMATCH: final build has no boolean dirty stamp\n' >&2
            return 1
            ;;
    esac
    cargo clean -p snapback || return $?
    env \
        SNAPBACK_BUILD_GIT_COMMIT="$SNAPBACK_BUILD_GIT_COMMIT" \
        SNAPBACK_BUILD_GIT_DIRTY="$SNAPBACK_BUILD_GIT_DIRTY" \
        cargo build --locked --bin snapback || return $?
    local identity_json
    identity_json="$("$ROOT/target/debug/snapback" build-identity)" || return $?
    node -e '
const identity = JSON.parse(process.argv[1])?.binary;
const expectedCommit = process.argv[2];
const expectedDirty = process.argv[3] === "true";
if (identity?.gitCommit !== expectedCommit || identity?.gitDirty !== expectedDirty) {
  console.error("SNAPBACK_BUILD_IDENTITY_MISMATCH: final binary did not retain the deterministic proof stamp", {
    expected: { gitCommit: expectedCommit, gitDirty: expectedDirty },
    actual: identity ?? null,
  });
  process.exit(1);
}
' "$identity_json" "$SNAPBACK_BUILD_GIT_COMMIT" "$SNAPBACK_BUILD_GIT_DIRTY" || return $?
}
run current-binary-build --requires native-runtime-bootstrap -- build_current_binary
# The early bootstrap proves its own authoritative binary. Cargo tests and the
# measured cleanup policy may change the later target closure, so qualify the
# final acceptance binary directly:
# create/destroy the restricted no-eval handler VM the server uses per
# invocation, and persist the digest-bound readiness receipt the harness
# rungs and doctor re-verify (LLP 0115 CV-3). A stale Hermes-framework/binary
# pairing fails here in milliseconds instead of as
# SNAPBACK_RUNTIME_CREATE_FAILED inside the first JS acceptance suite
# (issues/closed/20260730-bootstrap-smoke-does-not-create-armed-handler-vm.md).
run current-binary-readiness --requires current-binary-build -- \
    node packages/snapback-cli/runtime-readiness.mjs issue \
    --binary "$ROOT/target/debug/snapback" --root "$ROOT" --issuer verify-local-proof
