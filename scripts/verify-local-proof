        run regression-ephemeral-wiring --requires current-binary-readiness -- bun demos/_kit/tests/regression-ephemeral-wiring.mjs
        run regression-multilive-scoped --requires current-binary-readiness -- bun demos/_kit/tests/regression-multilive-scoped.mjs
        run admin-install -- bun install --frozen-lockfile --cwd admin-ui
        # ENG-24575: production dependency vulnerabilities are a required
        # proof gate, not an optional local command that CI can forget to run.
        run admin-acceptance --requires admin-install,browser-availability -- \
            bash -lc 'cd admin-ui && ./build.sh && bun run test && bun run test:browser-security && bun run audit:production'
        inapplicable exact-dependencies-required exact-dependencies-sentinel-needed \
            "$exact_evidence"
    elif [ "$VERIFY_EXACT" = "1" ]; then
        exact_evidence='{"verifyExact":"1","exactAvailable":false}'
        inapplicable_exact_surface_gates "$exact_evidence"
        run exact-dependencies-required -- bash -c \
            'printf "SNAPBACK_VERIFY_EXACT=1 but bun or installed Exact packages are unavailable\\n" >&2; exit 1'
    else
        exact_evidence='{"verifyExact":"auto","exactAvailable":false}'
        inapplicable_exact_surface_gates "$exact_evidence"
        inapplicable exact-dependencies-required exact-dependencies-sentinel-needed \
            "$exact_evidence"
    fi
else
    exact_evidence='{"verifyExact":"0","exactAvailable":null}'
    inapplicable_exact_surface_gates "$exact_evidence"
    inapplicable exact-dependencies-required exact-dependencies-sentinel-needed \
        "$exact_evidence"
fi

finish
printf '\n[snapback-verify] local proof checks complete\n'
