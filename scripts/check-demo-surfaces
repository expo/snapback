#!/usr/bin/env bash
# LLP 0032 S4 (graduated with P6): no demo page may perform a destructive
# backend operation on load. Boot semantics are LLP 0034 D4 — inspect-first
# conditional provisioning and seed-if-empty are allowed; reset (and any
# legacy /admin/* call) from a surface is not. The destructive path lives in
# scripts/demo-setup and the snapback CLI.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# client.reset() / app/reset / legacy root /admin/ calls in surface SOURCE —
# build output (dist/) and generated bindings are swept by their own gates.
PATTERN='client\.reset\(|\.reset\(\)\s*;?\s*//.*backend|app/reset|"/admin/|'"'"'/admin/'

FILES=()
while IFS= read -r -d '' file; do
    FILES+=("$file")
done < <(
    find demos -path '*/surfaces/*' -type f \
        \( -name '*.ts' -o -name '*.tsx' -o -name '*.mjs' -o -name '*.js' \) \
        ! -path '*/node_modules/*' \
        ! -path '*/dist/*' \
        ! -path '*/generated/*' \
        -print0
)

if [ "${#FILES[@]}" -eq 0 ]; then
    echo "[check-demo-surfaces] FAIL: no demo surface source files were scanned" >&2
    exit 1
fi

set +e
MATCHES="$(grep -InE "$PATTERN" -- "${FILES[@]}")"
STATUS=$?
set -e

if [ "$STATUS" -gt 1 ]; then
    echo "[check-demo-surfaces] FAIL: grep failed while scanning demo surfaces" >&2
    exit "$STATUS"
fi

if [ -n "$MATCHES" ]; then
    echo "[check-demo-surfaces] FAIL: destructive backend operations in demo surfaces:" >&2
    echo "$MATCHES" >&2
    exit 1
fi

echo "[check-demo-surfaces] ok: no destructive backend operations in demo surfaces"
