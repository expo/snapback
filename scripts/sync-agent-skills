#!/usr/bin/env bash
set -euo pipefail

fetch=1
quiet=0
refusals=0

for arg in "$@"; do
  case "$arg" in
    --no-fetch)
      fetch=0
      ;;
    --quiet)
      quiet=1
      ;;
    *)
      printf 'usage: %s [--no-fetch] [--quiet]\n' "$0" >&2
      exit 2
      ;;
  esac
done

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [ "$fetch" -eq 1 ]; then
  git submodule update --init --remote vendor/llp vendor/cdcstack vendor/ccheever-skills
else
  git submodule update --init vendor/llp vendor/cdcstack vendor/ccheever-skills
fi

link() {
  local target="$1"
  local path="$2"
  mkdir -p "$(dirname "$path")"
  if [ -L "$path" ]; then
    rm -f "$path"
  elif [ -d "$path" ]; then
    if ! rmdir "$path" 2>/dev/null; then
      printf 'warning: refusing to replace populated skill directory %s; leaving it unchanged\n' \
        "$path" >&2
      refusals=$((refusals + 1))
      return 0
    fi
  elif [ -e "$path" ]; then
    printf 'warning: refusing to replace non-symlink skill path %s; leaving it unchanged\n' \
      "$path" >&2
    refusals=$((refusals + 1))
    return 0
  fi
  ln -s "$target" "$path"
}

mkdir -p skills

# Prune symlinks into the vendored skill repos whose target no longer exists,
# so upstream skill removals don't leave dead entries in the aggregate.
for existing in skills/*; do
  [ -L "$existing" ] || continue
  case "$(readlink "$existing")" in
    ../vendor/llp/skills/*|../vendor/cdcstack/skills/*|../vendor/ccheever-skills/*)
      [ -e "$existing" ] || rm -f "$existing"
      ;;
  esac
done

# Mirror every skill vendor/llp ships (a skill = a directory with SKILL.md),
# not a frozen list — a vendored-llp bump that adds skills must not require a
# matching edit here to become visible to agents.
for dir in vendor/llp/skills/*/; do
  skill="$(basename "$dir")"
  [ -f "$dir/SKILL.md" ] || continue
  link "../vendor/llp/skills/$skill" "skills/$skill"
done
# cdcstack ships its own repository guidance (style) alongside the
# working-posture skills; only the latter apply here, so this is a list.
for skill in orchestrate panel; do
  link "../vendor/cdcstack/skills/$skill" "skills/$skill"
done
link "../vendor/ccheever-skills/cdc-linear-do" "skills/cdc-linear-do"

link ../skills .agents/skills
link ../skills .claude/skills
link ../skills .cursor/skills
link ../skills .pi/skills
link ../skills .opencode/skills

# vendor/ibex is deliberately NOT auto-initialized here. Unlike vendor/llp,
# vendor/cdcstack and vendor/ccheever-skills (small skill repos), it is a full Ibex runtime checkout
# (tens of MB plus history) that most Snapback work — docs, demos, JavaScript —
# never needs, so cloning it on every checkout/worktree-add would be a
# disproportionate cost. scripts/bootstrap-ibex-runtime initializes it safely on
# demand, resolving the submodule state before writing artifacts (ENG-22595).
# But leaving a fresh worktree with vendor/ibex silently uninitialized is the
# wedge trap: print a one-line hint (to stderr, even when --quiet) so an operator
# knows the remaining runtime step, instead of discovering it as a native build
# failure (ENG-22659).
ibex_status="$(git submodule status -- vendor/ibex 2>/dev/null || true)"
if [ ! -f vendor/ibex/Cargo.toml ] && printf '%s' "$ibex_status" | grep -q '^-'; then
  printf 'note: vendor/ibex runtime submodule is not initialized; run scripts/bootstrap-ibex-runtime before cargo build/test/run (it initializes the submodule and prepares Hermes artifacts).\n' >&2
fi

hooks_path="$(git config --get core.hooksPath 2>/dev/null || true)"
if [ "$hooks_path" != ".githooks" ]; then
  printf 'note: tracked Git hooks are not active (core.hooksPath=%s); run git config core.hooksPath .githooks.\n' \
    "${hooks_path:-unset}" >&2
fi

if [ "$refusals" -gt 0 ]; then
  printf 'PARTIAL: agent skill sync refused %d path(s); resolve the warnings above and re-run scripts/sync-agent-skills.\n' \
    "$refusals" >&2
  exit 1
fi

if [ "$quiet" -eq 0 ]; then
  printf 'Synced agent skills from vendor/llp, vendor/cdcstack and vendor/ccheever-skills.\n'
fi
