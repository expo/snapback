#!/usr/bin/env bash
# Assert the Cloudflare deploy configs' compatibility pins match the
# single-sourced packages/snapback-harness/compat.json, and that neither the
# harness nor the deploy configs carry a nodejs_compat* flag (LLP 0048
# §Single-sourced runtime flags — the twin's workerd config and LLP 0040's
# deploy config are generated from one source; Node compatibility surface
# would silently re-widen the handler-visible dialect).
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
compat="$repo_root/packages/snapback-harness/compat.json"

expected_date=$(node -e "console.log(require('$compat').compatibilityDate)")
expected_flags=$(node -e "console.log(JSON.stringify(require('$compat').compatibilityFlags || []))")

fail=0

tracked_tool_caches="$(git -C "$repo_root" ls-files | grep -E '(^|/)\.wrangler/' || true)"
if [[ -n "$tracked_tool_caches" ]]; then
  echo "REFUSED: tracked Wrangler tool cache paths are local metadata, not source:" >&2
  echo "$tracked_tool_caches" >&2
  fail=1
fi
for config in \
  "$repo_root/cloudflare/wrangler.jsonc" \
  "$repo_root/cloudflare/wrangler.handler.jsonc" \
  "$repo_root/cloudflare/wrangler.all-aboard.jsonc" \
  "$repo_root/cloudflare/wrangler.all-aboard.handler.jsonc" \
  "$repo_root/cloudflare/wrangler.all-aboard.action-handler.jsonc"; do
  # Strip // comments so JSON parses.
  actual=$(node -e "
    const fs=require('fs');
    const raw=fs.readFileSync('$config','utf8').replace(/^\s*\/\/.*$/gm,'');
    const cfg=JSON.parse(raw);
    const flags=cfg.compatibility_flags||[];
    if(flags.some(f=>f.startsWith('nodejs_compat'))){
      console.error('REFUSED: $config carries a nodejs_compat flag'); process.exit(3);
    }
    console.log(JSON.stringify({date: cfg.compatibility_date, flags}));
  ")
  actual_date=$(node -e "console.log(JSON.parse(process.argv[1]).date)" "$actual")
  actual_flags=$(node -e "console.log(JSON.stringify(JSON.parse(process.argv[1]).flags))" "$actual")
  if [[ "$actual_date" != "$expected_date" ]]; then
    echo "MISMATCH: $config compatibility_date=$actual_date, expected $expected_date" >&2
    fail=1
  fi
  if [[ "$actual_flags" != "$expected_flags" ]]; then
    echo "MISMATCH: $config compatibility_flags=$actual_flags, expected $expected_flags" >&2
    fail=1
  fi
done

if ! node "$repo_root/cloudflare/scripts/generate-deployment-identity.mjs" --check; then
  echo "MISMATCH: Cloudflare deployment identities are stale" >&2
  fail=1
fi

if grep -Eq "compatibilityDate:[[:space:]]*['\"][0-9]{4}-[0-9]{2}-[0-9]{2}['\"]" "$repo_root/cloudflare/test/harness.mjs"; then
  echo "MISMATCH: cloudflare/test/harness.mjs hardcodes a compatibilityDate instead of compat.json" >&2
  fail=1
fi

if [[ "$fail" -ne 0 ]]; then
  echo "cf-check-compat: deploy config drifted from the single-sourced compat.json" >&2
  exit 1
fi
echo "cf-check-compat: compat pins match ($expected_date flags=$expected_flags), no nodejs_compat flags"
