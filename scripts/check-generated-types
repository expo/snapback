#!/usr/bin/env bash
# LLP 0032 P3(b): tsc --noEmit over every generated api declaration pair plus
# the typed consumer fixture, so emitted-invalid-TypeScript (the S5.D2 class)
# and runtime/declaration resolution drift cannot land. TypeScript is an exact
# root workspace dependency so this gate never consults the registry or an
# ambient npm cache while proving committed output.

set -euo pipefail

usage() {
    printf 'Usage: scripts/check-generated-types [--help]\n'
}

case "${1:-}" in
    --help|-h) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; usage; exit 0 ;;
    '') ;;
    *) printf '[check-generated-types] error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

EXPECTED_VERSION="$(node -p "JSON.parse(require('fs').readFileSync('package.json', 'utf8')).devDependencies.typescript")"
if ! [[ "$EXPECTED_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf '[check-generated-types] error: root TypeScript must be an exact version, found %q\n' "$EXPECTED_VERSION" >&2
    exit 1
fi

# The override is a regression-test seam for the fail-closed missing-install
# path. It can only narrow this proof to another already-installed tree; the
# gate never invokes a package runner or registry fallback.
NODE_MODULES="${SNAPBACK_TYPESCRIPT_NODE_MODULES:-$ROOT/node_modules}"
TSC="$NODE_MODULES/.bin/tsc"
TYPESCRIPT_MANIFEST="$NODE_MODULES/typescript/package.json"
if [ ! -x "$TSC" ] || [ ! -f "$TYPESCRIPT_MANIFEST" ]; then
    printf '[check-generated-types] error: locked TypeScript %s is not installed; run `bun install --frozen-lockfile`\n' "$EXPECTED_VERSION" >&2
    exit 1
fi
ACTUAL_VERSION="$(node -p "JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8')).version" "$TYPESCRIPT_MANIFEST")"
if [ "$ACTUAL_VERSION" != "$EXPECTED_VERSION" ]; then
    printf '[check-generated-types] error: installed TypeScript %s does not match package.json %s; run `bun install --frozen-lockfile`\n' "$ACTUAL_VERSION" "$EXPECTED_VERSION" >&2
    exit 1
fi

# Generated projections are ignored cache materializations. Regenerate before
# compiling so this proof works from a cold clone and cannot consume stale
# checked-in declarations.
node packages/snapback-codegen/index.mjs demos/todo/snapback >/dev/null
node packages/snapback-codegen/index.mjs demos/todo-v2/snapback >/dev/null
SNAPBACK_OUTBOUND_ACTIONS=1 node packages/snapback-codegen/index.mjs demos/all-aboard/snapback >/dev/null
SNAPBACK_OUTBOUND_ACTIONS=1 node packages/snapback-codegen/index.mjs demos/all-aboard/tests/egress-probe >/dev/null
node packages/snapback-codegen/index.mjs demos/cursors-web/snapback >/dev/null
node packages/snapback-codegen/index.mjs demos/graffiti/snapback >/dev/null
node packages/snapback-codegen/index.mjs demos/card-game/snapback >/dev/null
node packages/snapback-codegen/index.mjs demos/rbac/snapback >/dev/null

API_DECLARATIONS=(
    demos/todo/snapback/generated/api.d.ts
    demos/todo-v2/snapback/generated/api.d.ts
    demos/all-aboard/snapback/generated/api.d.ts
    demos/all-aboard/tests/egress-probe/generated/api.d.ts
    demos/cursors-web/snapback/generated/api.d.ts
    demos/graffiti/snapback/generated/api.d.ts
    demos/card-game/snapback/generated/api.d.ts
    demos/rbac/snapback/generated/api.d.ts
    demos/catalog-lens/snapback/generated/api.d.ts
    demos/dispatch-board/snapback/generated/api.d.ts
    demos/pulse-monitor/snapback/generated/api.d.ts
    demos/public-dashboard/snapback/generated/api.d.ts
    demos/access-desk/snapback/generated/api.d.ts
)
for declaration in "${API_DECLARATIONS[@]}"; do
    API_DECLARATIONS+=("${declaration%.d.ts}.d.mts")
done

"$TSC" \
    --noEmit \
    --strict \
    --target es2022 \
    --module esnext \
    --moduleResolution bundler \
    "${API_DECLARATIONS[@]}" \
    demos/_kit/tests/typed-consumer-fixture.ts

echo "[check-generated-types] ok: generated .d.ts/.d.mts pairs + relative .mjs consumer fixture compile clean"
