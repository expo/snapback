#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/bootstrap-ibex-runtime [--help]
       scripts/bootstrap-ibex-runtime --probe-hermes-library PATH

Prepare the vendored Ibex/Hermes runtime, build and launch Snapback, and issue
a digest-bound runtime-readiness receipt.

Environment:
  SNAPBACK_IBEX_CHECKOUT  Reuse a compatible prepared Ibex checkout.
  SNAPBACK_BOOTSTRAP_CHECK=0  Skip the final link/launch qualification check.
EOF
}

PROBE_ONLY_LIBRARY=""
case "${1:-}" in
    --help|-h)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        usage
        exit 0
        ;;
    --probe-hermes-library)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        PROBE_ONLY_LIBRARY="$2"
        ;;
    '') ;;
    *)
        printf '[snapback-bootstrap] error: unknown argument: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENDOR_IBEX="$ROOT/vendor/ibex"
DEFAULT_PEER_IBEX="$(cd "$ROOT/.." && pwd)/ibex"
PEER_IBEX="${SNAPBACK_IBEX_CHECKOUT:-$DEFAULT_PEER_IBEX}"
TARGET_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH_RAW="$(uname -m)"

case "$ARCH_RAW" in
    arm64|aarch64) HERMES_ARCH="arm64" ;;
    x86_64|amd64) HERMES_ARCH="x64" ;;
    *) HERMES_ARCH="$ARCH_RAW" ;;
esac

RUN_CHECK="${SNAPBACK_BOOTSTRAP_CHECK:-1}"

log() {
    printf '[snapback-bootstrap] %s\n' "$*"
}

report_binary_size() {
    local binary="$1"
    if ! command -v node >/dev/null 2>&1; then
        log "binary size check skipped: active node is unavailable"
        return 0
    fi
    if node "$ROOT/scripts/binary-size-metrology.mjs" check "$binary"; then
        return 0
    else
        local status="$?"
        log "binary size check reported a non-blocking failure (exit $status)"
    fi
}

fail() {
    printf '[snapback-bootstrap] error: %s\n' "$*" >&2
    exit 1
}

copy_dir_contents() {
    local src="$1"
    local dst="$2"

    mkdir -p "$dst"
    if command -v rsync >/dev/null 2>&1; then
        # rsync -a preserves SOURCE mtimes, so a refreshed artifact could land
        # looking older than the last cargo build and never trigger the
        # rerun-if-changed relink — leaving a green launch smoke over a binary
        # whose glue mismatches the new framework (armed handler-VM refusal at
        # first JS invocation). Itemize the transfer and bump the mtime of
        # every file rsync actually changed so cargo relinks before the
        # qualification probe runs; an unchanged tree stays a fast no-op.
        rsync -a --out-format='%n' "$src/" "$dst/" | while IFS= read -r entry; do
            if [ -f "$dst/$entry" ]; then
                touch "$dst/$entry"
            fi
        done
    else
        cp -R "$src/." "$dst/"
    fi
}

has_tool() {
    local base="$1"
    local tool="$2"
    shift 2

    local candidate
    for candidate in "$@"; do
        if [ -f "$base/tools/hermes/$candidate" ]; then
            return 0
        fi
    done

    log "$tool missing under $base/tools/hermes"
    return 1
}

has_macos_framework() {
    local base="$1"
    local frameworks="$base/ios/Frameworks"
    local candidate

    for candidate in \
        "$frameworks/hermes.framework/hermes" \
        "$frameworks/hermes.framework/Versions/Current/hermes" \
        "$frameworks/hermes.framework/Versions/1/hermes" \
        "$frameworks/hermes.framework/Versions/0/hermes" \
        "$frameworks/macosx/hermes.framework/hermes" \
        "$frameworks/macosx/hermes.framework/Versions/Current/hermes" \
        "$frameworks/macosx/hermes.framework/Versions/1/hermes" \
        "$frameworks/macosx/hermes.framework/Versions/0/hermes" \
        "$frameworks/hermesvm.framework/hermesvm" \
        "$frameworks/hermesvm.framework/Versions/Current/hermesvm" \
        "$frameworks/hermesvm.framework/Versions/1/hermesvm" \
        "$frameworks/hermesvm.framework/Versions/0/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermes.framework/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermes.framework/Versions/Current/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermesvm.framework/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermesvm.framework/Versions/Current/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64/hermes.framework/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64/hermes.framework/Versions/Current/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64/hermesvm.framework/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64/hermesvm.framework/Versions/Current/hermesvm"
    do
        if [ -f "$candidate" ]; then
            return 0
        fi
    done

    log "macOS Hermes framework missing under $frameworks"
    return 1
}

has_darwin_artifacts() {
    local base="$1"
    local frameworks="$base/ios/Frameworks"

    [ -f "$frameworks/hermes-headers/hermes/hermes.h" ] || {
        log "Hermes headers missing under $frameworks/hermes-headers"
        return 1
    }
    [ -f "$frameworks/hermes-headers/jsi/jsi.h" ] || {
        log "JSI headers missing under $frameworks/hermes-headers"
        return 1
    }
    has_macos_framework "$base" || return 1
    has_tool "$base" "hermesc" "hermesc-macos-$HERMES_ARCH" "hermesc" || return 1
}

has_linux_artifacts() {
    local base="$1"

    [ -f "$base/linux/hermes-headers/hermes/hermes.h" ] || {
        log "Linux Hermes headers missing under $base/linux/hermes-headers/hermes"
        return 1
    }
    [ -f "$base/linux/hermes-headers/jsi/jsi.h" ] || {
        log "Linux JSI headers missing under $base/linux/hermes-headers/jsi"
        return 1
    }
    [ -d "$base/linux/lib" ] || {
        log "Linux Hermes lib dir missing under $base/linux/lib"
        return 1
    }
    find "$base/linux/lib" -name 'libhermesvm*' -print -quit | grep -q . || {
        log "libhermesvm missing under $base/linux/lib"
        return 1
    }
    has_tool "$base" "hermesc" "hermesc-linux-$HERMES_ARCH" "hermesc" || return 1
}

has_target_artifacts() {
    local base="$1"

    case "$TARGET_OS" in
        darwin) has_darwin_artifacts "$base" ;;
        linux) has_linux_artifacts "$base" ;;
        *)
            fail "SNAPBACK_IBEX_HOST_UNSUPPORTED: unsupported bootstrap host '$TARGET_OS'; use vendor/ibex platform setup directly"
            ;;
    esac
}

runtime_library_for_base() {
    local base="$1"
    local candidate

    case "$TARGET_OS" in
        darwin)
            for candidate in \
                "$base/ios/Frameworks/hermesvm.framework/hermesvm" \
                "$base/ios/Frameworks/hermesvm.framework/Versions/Current/hermesvm" \
                "$base/ios/Frameworks/hermesvm.framework/Versions/1/hermesvm" \
                "$base/ios/Frameworks/hermesvm.framework/Versions/0/hermesvm" \
                "$base/ios/Frameworks/hermes.xcframework/macos-arm64_x86_64/hermesvm.framework/hermesvm" \
                "$base/ios/Frameworks/hermes.xcframework/macos-arm64/hermesvm.framework/hermesvm" \
                "$base/ios/Frameworks/hermes.framework/hermes" \
                "$base/ios/Frameworks/hermes.framework/Versions/Current/hermes" \
                "$base/ios/Frameworks/hermes.framework/Versions/1/hermes" \
                "$base/ios/Frameworks/hermes.framework/Versions/0/hermes" \
                "$base/ios/Frameworks/macosx/hermes.framework/hermes" \
                "$base/ios/Frameworks/macosx/hermes.framework/Versions/Current/hermes" \
                "$base/ios/Frameworks/hermes.xcframework/macos-arm64_x86_64/hermes.framework/hermes" \
                "$base/ios/Frameworks/hermes.xcframework/macos-arm64/hermes.framework/hermes"
            do
                if [ -f "$candidate" ]; then
                    printf '%s\n' "$candidate"
                    return 0
                fi
            done
            ;;
        linux)
            candidate="$(find "$base/linux/lib" -type f \
                \( -name 'libhermesvm.so' -o -name 'libhermesvm.so.*' -o -name 'libhermesvm.dylib' \) \
                -print -quit 2>/dev/null || true)"
            if [ -n "$candidate" ]; then
                printf '%s\n' "$candidate"
                return 0
            fi
            ;;
    esac
    return 1
}

probe_hermes_library() {
    local library="$1"
    local probe_error

    if ! probe_error="$(python3 - "$library" <<'PY' 2>&1
import ctypes
import sys

try:
    ctypes.CDLL(sys.argv[1], mode=ctypes.RTLD_LOCAL)
except OSError as error:
    print(error, file=sys.stderr)
    raise SystemExit(1)
PY
)"; then
        log "Hermes loader-resolution probe failed for $library"
        [ -z "$probe_error" ] || log "dlopen error: $probe_error"
        return 1
    fi
}

probe_target_artifacts() {
    local base="$1"
    local library
    library="$(runtime_library_for_base "$base")" || return 1
    probe_hermes_library "$library"
}

artifact_stamp_path() {
    local base="$1"
    case "$TARGET_OS" in
        darwin) printf '%s\n' "$base/ios/Frameworks/.snapback-ibex-gitlink" ;;
        linux) printf '%s\n' "$base/linux/lib/.snapback-ibex-gitlink" ;;
    esac
}

expected_ibex_gitlink() {
    git -C "$ROOT" rev-parse HEAD:vendor/ibex 2>/dev/null
}

has_matching_artifact_stamp() {
    local base="$1"
    local stamp expected observed
    stamp="$(artifact_stamp_path "$base")"
    expected="$(expected_ibex_gitlink)" || return 1
    observed="$(sed -n '1p' "$stamp" 2>/dev/null || true)"
    if [ "$observed" = "$expected" ]; then
        return 0
    fi
    log "Hermes artifact gitlink stamp mismatch under $base"
    log "expected vendor/ibex gitlink: $expected"
    log "observed artifact gitlink: ${observed:-<missing>}"
    return 1
}

artifact_stamp_is_missing() {
    local base="$1"
    [ ! -s "$(artifact_stamp_path "$base")" ]
}

artifact_source_matches_pin() {
    local base="$1"
    local expected observed
    expected="$(expected_ibex_gitlink)" || return 1
    observed="$(git -C "$base" rev-parse HEAD 2>/dev/null || true)"
    [ "$observed" = "$expected" ]
}

write_artifact_stamp() {
    local base="$1"
    local stamp expected temporary
    stamp="$(artifact_stamp_path "$base")"
    expected="$(expected_ibex_gitlink)" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: could not resolve the vendor/ibex gitlink for the artifact provenance stamp"
    temporary="$stamp.tmp.$$"
    mkdir -p "$(dirname "$stamp")"
    printf '%s\n' "$expected" >"$temporary"
    mv "$temporary" "$stamp"
    log "stamped Hermes artifacts with vendor/ibex gitlink $expected"
}

if [ -n "$PROBE_ONLY_LIBRARY" ]; then
    probe_hermes_library "$PROBE_ONLY_LIBRARY" \
        || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: Hermes runtime library exists but dlopen could not resolve it: $PROBE_ONLY_LIBRARY"
    log "Hermes loader-resolution probe passed for $PROBE_ONLY_LIBRARY"
    exit 0
fi

# @ref LLP 0010#native-runtime-bootstrap -- a structurally complete sibling
# artifact set is reusable only when its authority-bound source-cache key
# matches the vendored Ibex revision. Ibex build.rs remains the authoritative
# full-digest validator; this prefilter prevents a known-incompatible peer from
# displacing the vendored download/build fallback.
reviewed_source_profile_cache_keys() (
    [ -f "$VENDOR_IBEX/scripts/hermes-version.sh" ] || return 1

    # vendor/ibex/build.rs reconstructs the checked-in defaults, not caller overrides.
    unset IBEX_HERMES_VERSION IBEX_HERMES_SOURCE_REF \
        IBEX_HERMES_SOURCE_COMMIT IBEX_HERMES_BUILD_REF
    # shellcheck source=/dev/null
    source "$VENDOR_IBEX/scripts/hermes-version.sh"

    local version_key="${IBEX_HERMES_SOURCE_COMMIT:0:12}"
    case "$TARGET_OS" in
        darwin)
            ibex_hermes_apple_source_cache_key "$version_key" "-debug"
            ibex_hermes_apple_source_cache_key "$version_key" ""
            ;;
        linux)
            ibex_hermes_linux_source_cache_key "$version_key"
            ;;
    esac
)

has_matching_profile_receipt() {
    local base="$1"
    local receipt=""
    case "$TARGET_OS" in
        darwin) receipt="$base/ios/Frameworks/hermes-profile-provenance.json" ;;
        linux) receipt="$base/linux/lib/hermes-profile-provenance.json" ;;
    esac

    [ -f "$receipt" ] || {
        log "Hermes profile provenance receipt missing at $receipt"
        return 1
    }

    local expected_keys observed_key expected_key
    if ! expected_keys="$(reviewed_source_profile_cache_keys)"; then
        log "could not reconstruct the vendored Ibex reviewed Hermes profile keys"
        return 1
    fi
    observed_key="$(sed -n 's/^[[:space:]]*"cacheKey": "\([^"]*\)",[[:space:]]*$/\1/p' "$receipt")"
    while IFS= read -r expected_key; do
        if [ -n "$expected_key" ] && [ "$observed_key" = "$expected_key" ]; then
            return 0
        fi
    done <<<"$expected_keys"

    log "Hermes profile provenance under $base does not match the vendored Ibex profile authorities"
    log "observed profile cache key: ${observed_key:-<missing>}"
    return 1
}

has_compatible_target_artifacts() {
    local base="$1"
    has_target_artifacts "$base" && has_matching_profile_receipt "$base"
}

copy_peer_artifacts() {
    [ -d "$PEER_IBEX" ] || return 1
    has_compatible_target_artifacts "$PEER_IBEX" || return 1
    if artifact_stamp_is_missing "$PEER_IBEX"; then
        artifact_source_matches_pin "$PEER_IBEX" || {
            log "unstamped sibling artifacts do not come from the vendor/ibex gitlink"
            return 1
        }
    elif ! has_matching_artifact_stamp "$PEER_IBEX"; then
        log "sibling artifacts are not bound to the vendor/ibex gitlink"
        return 1
    fi
    probe_target_artifacts "$PEER_IBEX" || return 1

    log "copying prebuilt Ibex/Hermes artifacts from $PEER_IBEX"
    case "$TARGET_OS" in
        darwin)
            copy_dir_contents "$PEER_IBEX/ios/Frameworks" "$VENDOR_IBEX/ios/Frameworks"
            copy_dir_contents "$PEER_IBEX/tools/hermes" "$VENDOR_IBEX/tools/hermes"
            ;;
        linux)
            copy_dir_contents "$PEER_IBEX/linux" "$VENDOR_IBEX/linux"
            copy_dir_contents "$PEER_IBEX/tools/hermes" "$VENDOR_IBEX/tools/hermes"
            ;;
    esac
}

link_peer_cli() {
    local peer_bin=""
    if [ -x "$PEER_IBEX/target/debug/ibex" ]; then
        peer_bin="$PEER_IBEX/target/debug/ibex"
    elif [ -x "$PEER_IBEX/target/release/ibex" ]; then
        peer_bin="$PEER_IBEX/target/release/ibex"
    fi

    local target_bin="$VENDOR_IBEX/target/debug/ibex"
    if [ -n "$peer_bin" ] && [ -L "$target_bin" ] && [ ! -e "$target_bin" ]; then
        rm "$target_bin"
        log "removed dangling vendored Ibex CLI symlink at $target_bin"
    fi
    if [ -n "$peer_bin" ] && [ ! -e "$target_bin" ]; then
        mkdir -p "$VENDOR_IBEX/target/debug"
        ln -s "$peer_bin" "$target_bin"
        log "linked vendored Ibex CLI to $peer_bin"
    fi
}

# Uncommitted state within the runtime binary's input set (shared definition:
# scripts/runtime-build-inputs.txt — sources, manifests, vendored runtime,
# embedded corpora). Empty output means the input set is clean; edits outside
# it (demos, LLPs, issues, diaries) do not count, so they no longer force a
# rebuild of a prepared binary
# (issues/closed/20260805-whole-tree-dirty-flag-forces-runtime-rebuild.md).
# A missing definition file falls back to whole-tree status (conservative).
runtime_input_set_status() {
    local inputs_file="$ROOT/scripts/runtime-build-inputs.txt" line
    local -a input_pathspecs=()
    if [ -f "$inputs_file" ]; then
        while IFS= read -r line; do
            case "$line" in ''|\#*) continue ;; esac
            input_pathspecs+=("$line")
        done <"$inputs_file"
    fi
    if [ "${#input_pathspecs[@]}" -gt 0 ]; then
        git -C "$ROOT" status --porcelain --ignore-submodules=untracked -- "${input_pathspecs[@]}"
    else
        git -C "$ROOT" status --porcelain --ignore-submodules=untracked
    fi
}

reuse_authoritative_runtime_receipt() {
    # @ref LLP 0175#d32-reuse-one-bootstrapreadiness-result — on a clean exact
    # checkout, a digest-coherent receipt for this revision and the current
    # restricted-handler-VM probe is the result the expensive link/qualify
    # producer would recreate. A dirty runtime input set rebuilds because a
    # commit identity alone cannot prove which uncommitted input bytes
    # produced the binary; edits outside the input set cannot change the
    # binary's bytes and do not forfeit reuse.
    local binary="$ROOT/target/debug/snapback"
    [ -x "$binary" ] || return 1
    local input_status line
    input_status="$(runtime_input_set_status 2>/dev/null)" || return 1
    if [ -n "$input_status" ]; then
        log "runtime input set is dirty; receipt reuse forfeited, revalidating with a real build. Dirty input paths:"
        while IFS= read -r line; do
            log "  $line"
        done <<<"$input_status"
        return 1
    fi

    local current_commit readiness_json readiness_commit readiness_dirty readiness_profile
    current_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)" || return 1
    if ! readiness_json="$(node "$ROOT/packages/snapback-cli/runtime-readiness.mjs" verify \
        --binary "$binary" --root "$ROOT" --json)"; then
        return 1
    fi
    readiness_commit="$(printf '%s' "$readiness_json" | python3 -c \
        'import json,sys; print((json.load(sys.stdin).get("receipt") or {}).get("buildIdentity",{}).get("gitCommit") or "")')"
    readiness_dirty="$(printf '%s' "$readiness_json" | python3 -c \
        'import json,sys; print(str((json.load(sys.stdin).get("receipt") or {}).get("buildIdentity",{}).get("gitDirty", True)).lower())')"
    readiness_profile="$(printf '%s' "$readiness_json" | python3 -c \
        'import json,sys; print((json.load(sys.stdin).get("receipt") or {}).get("buildIdentity",{}).get("buildProfile") or "")')"
    [ "$readiness_commit" = "$current_commit" ] || return 1
    [ "$readiness_dirty" = "false" ] || return 1
    [ "$readiness_profile" = "debug" ] || return 1
}

reuse_prepared_runtime_receipt() {
    # @ref LLP 0232#d-2-prepared-execution-and-rebase-stable-records -- a detached gate may consume the invoking
    # environment's qualified binary only after the ordinary readiness
    # verifier reopens binary/Hermes digests and the prepared-runtime verifier
    # proves source, qualification, toolchain, platform, and environment
    # closure equality. Any miss is deliberately non-fatal and falls through
    # to the unchanged cold link + qualification producer below.
    local prepared_root="${SNAPBACK_PREPARED_RUNTIME_ROOT:-}"
    [ -n "$prepared_root" ] || return 1
    local binary="${SNAPBACK_PREPARED_RUNTIME_BINARY:-$prepared_root/target/debug/snapback}"
    [ -x "$binary" ] || {
        log "prepared runtime reuse miss: candidate binary is absent at $binary"
        return 1
    }
    local verdict reason message
    verdict="$(node "$ROOT/packages/snapback-cli/prepared-runtime-reuse.mjs" verify \
        --root "$ROOT" --binary "$binary" --json 2>/dev/null)" || {
        reason="$(printf '%s' "$verdict" | python3 -c \
            'import json,sys; print(json.load(sys.stdin).get("reason") or "verification-failed")' 2>/dev/null || printf 'verification-failed')"
        message="$(printf '%s' "$verdict" | python3 -c \
            'import json,sys; print(json.load(sys.stdin).get("message") or "prepared receipt verification failed")' 2>/dev/null || printf 'prepared receipt verification failed')"
        log "prepared runtime reuse miss ($reason): $message; falling back to cold bootstrap"
        return 1
    }
    log "reusing closure-identical prepared runtime readiness receipt from $binary"
}

# @ref LLP 0010#native-runtime-bootstrap -- vendor/ibex is a git submodule;
# resolve its checkout state BEFORE writing any artifacts into the path.
# Running this script ahead of `git submodule update --init` used to wedge
# fresh worktrees (ENG-22595): artifacts landed in the empty gitlink path and
# the later submodule clone refused ("destination path ... already exists and
# is not an empty directory").
ensure_vendor_ibex_checkout() {
    # Populated checkout (submodule initialized, or a non-git source export
    # that vendors the Ibex sources directly): nothing to do. This
    # deliberately also tolerates sources copied in over an uninitialized
    # gitlink — builds work, and scripts/ibex-doctor flags the git state.
    if [ -f "$VENDOR_IBEX/Cargo.toml" ]; then
        return 0
    fi

    local status
    status="$(git -C "$ROOT" submodule status -- vendor/ibex 2>/dev/null || true)"

    if [ -z "$status" ]; then
        fail "SNAPBACK_IBEX_SOURCE_MISSING: $VENDOR_IBEX has no Cargo.toml and this tree does not know vendor/ibex as a git submodule; re-fetch a complete Snapback source tree (git clone, then git submodule update --init --recursive)"
    fi

    case "$status" in
        -*)
            # Gitlink recorded but the submodule worktree was never
            # initialized (git submodule status prefixes these with '-').
            local stray=0
            if [ -d "$VENDOR_IBEX" ] && [ -n "$(ls -A "$VENDOR_IBEX" 2>/dev/null)" ]; then
                # Stray files already occupy the uninitialized path (for
                # example an older bootstrap wrote artifacts here). A fresh
                # clone refuses over a non-empty directory, but a retained
                # submodule gitdir (rm -rf'd checkout in a
                # previously-initialized worktree) checks out fine over
                # untracked artifacts — so attempt the init and refuse only
                # if git itself cannot complete it. Never delete the files.
                stray=1
                log "vendor/ibex submodule is not initialized and the directory already has content; attempting: git submodule update --init --recursive -- vendor/ibex"
            else
                log "vendor/ibex submodule is not initialized; running: git submodule update --init --recursive -- vendor/ibex"
            fi
            if ! git -C "$ROOT" submodule update --init --recursive -- vendor/ibex; then
                if [ "$stray" = "1" ]; then
                    printf '[snapback-bootstrap] error: SNAPBACK_IBEX_SUBMODULE_WEDGED: git could not initialize the vendor/ibex submodule over the existing directory contents (see the git error above)\n' >&2
                    printf '[snapback-bootstrap] the stray contents are usually regenerable bootstrap artifacts (ios/, linux/, tools/, target/); recover with:\n' >&2
                    printf '[snapback-bootstrap]   mv %q %q\n' "$VENDOR_IBEX" "$VENDOR_IBEX.wedged.$(date +%Y%m%d%H%M%S)" >&2
                    printf '[snapback-bootstrap]   git -C %q submodule update --init --recursive -- vendor/ibex\n' "$ROOT" >&2
                    printf '[snapback-bootstrap]   %q\n' "$ROOT/scripts/bootstrap-ibex-runtime" >&2
                    printf '[snapback-bootstrap] (scripts/ibex-doctor re-checks this state)\n' >&2
                    exit 1
                fi
                fail "SNAPBACK_IBEX_SUBMODULE_INIT_FAILED: git submodule update --init --recursive -- vendor/ibex failed; fix the error above (network/credentials) and re-run this script"
            fi
            ;;
    esac

    [ -f "$VENDOR_IBEX/Cargo.toml" ] || fail "SNAPBACK_IBEX_SUBMODULE_BROKEN: vendor/ibex is initialized but $VENDOR_IBEX/Cargo.toml is still missing; try: git -C $ROOT submodule update --force --checkout --recursive -- vendor/ibex"
}

ensure_vendor_ibex_checkout

# @ref LLP 0010#native-runtime-bootstrap -- Snapback agents should consume
# prepared Ibex/Hermes artifacts before attempting a native Hermes build.
if has_compatible_target_artifacts "$VENDOR_IBEX"; then
    if artifact_stamp_is_missing "$VENDOR_IBEX"; then
        # One-time adoption for artifact sets prepared before the gitlink stamp
        # existed. The checked-out Ibex source must itself equal the
        # superproject pin, and the dlopen probe still runs before the stamp
        # lands. A present-but-stale stamp must never take this adoption path.
        artifact_source_matches_pin "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: unstamped Hermes artifacts do not come from the vendor/ibex gitlink pinned by this Snapback revision; run scripts/ibex-doctor, move the stale prepared artifact directory aside, and re-run this bootstrap"
        probe_target_artifacts "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: prepared Hermes files exist under $VENDOR_IBEX, but dlopen cannot resolve the runtime library or one of its dependencies; run scripts/ibex-doctor for the loader error, then re-prepare artifacts for this host"
        write_artifact_stamp "$VENDOR_IBEX"
        log "adopted compatible pre-stamp vendored Ibex/Hermes artifacts"
    else
        has_matching_artifact_stamp "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: prepared Hermes artifacts are stamped for a different vendor/ibex gitlink; run scripts/ibex-doctor, move the stale prepared artifact directory aside, and re-run this bootstrap"
        probe_target_artifacts "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: prepared Hermes files exist under $VENDOR_IBEX, but dlopen cannot resolve the runtime library or one of its dependencies; run scripts/ibex-doctor for the loader error, then re-prepare artifacts for this host"
        log "vendored Ibex/Hermes artifacts are already usable"
    fi
else
    if copy_peer_artifacts; then
        log "installed prebuilt artifacts from sibling Ibex checkout"
    else
        log "no complete compatible sibling Ibex artifact set found at $PEER_IBEX"
        log "running vendored Ibex Hermes bootstrap; this may download or build native artifacts"
        # @ref LLP 0010#native-runtime-bootstrap -- coded failure so agents and
        # scripts/ibex-doctor can match on a stable code, not on prose.
        "$VENDOR_IBEX/scripts/download-hermes.sh" || fail "SNAPBACK_IBEX_HERMES_DOWNLOAD_FAILED: vendor/ibex/scripts/download-hermes.sh failed and no compatible sibling Ibex artifacts were available; fix the download error above (network/toolchain) or set SNAPBACK_IBEX_CHECKOUT=/path/to/ibex to reuse a compatible prepared checkout"
    fi
    has_compatible_target_artifacts "$VENDOR_IBEX" || fail "SNAPBACK_CAPABILITY_IBEX_HERMES_MISSING: prepared Ibex/Hermes artifacts are incomplete or profile-incompatible under $VENDOR_IBEX after copy/download; run scripts/ibex-doctor for a read-only diagnosis, or set SNAPBACK_IBEX_CHECKOUT=/path/to/ibex to reuse a complete compatible prepared checkout"
    probe_target_artifacts "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: prepared Hermes files exist under $VENDOR_IBEX, but dlopen cannot resolve the runtime library or one of its dependencies; run scripts/ibex-doctor for the loader error, then re-prepare artifacts for this host"
    write_artifact_stamp "$VENDOR_IBEX"
fi

# @ref LLP 0010#native-runtime-bootstrap -- reuse the shared Hermes-artifacts
# code (also emitted by scripts/ibex-doctor and demos/_kit/server-process.mjs)
# so bootstrap, doctor, and the demo runner all report one code for this state.
has_compatible_target_artifacts "$VENDOR_IBEX" || fail "SNAPBACK_CAPABILITY_IBEX_HERMES_MISSING: prepared Ibex/Hermes artifacts are incomplete or profile-incompatible under $VENDOR_IBEX after copy/download; run scripts/ibex-doctor for a read-only diagnosis, or set SNAPBACK_IBEX_CHECKOUT=/path/to/ibex to reuse a complete compatible prepared checkout"
has_matching_artifact_stamp "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: prepared Hermes artifacts are not stamped for the vendor/ibex gitlink pinned by this Snapback revision; re-run scripts/bootstrap-ibex-runtime to prepare and stamp the current artifacts"
probe_target_artifacts "$VENDOR_IBEX" || fail "SNAPBACK_IBEX_HERMES_ARTIFACTS_UNUSABLE: prepared Hermes files exist under $VENDOR_IBEX, but dlopen cannot resolve the runtime library or one of its dependencies; run scripts/ibex-doctor for the loader error, then re-prepare artifacts for this host"

# The CLI is an independent optional capability. Link it even when the Hermes
# artifacts were already prepared, since that fast path does not call
# copy_peer_artifacts (ENG-25178).
link_peer_cli

if [ "$RUN_CHECK" != "0" ]; then
    if [ -n "${SNAPBACK_PREPARED_RUNTIME_ROOT:-}" ]; then
        if reuse_prepared_runtime_receipt; then
            report_binary_size "${SNAPBACK_PREPARED_RUNTIME_BINARY:-$SNAPBACK_PREPARED_RUNTIME_ROOT/target/debug/snapback}"
            log "Ibex runtime bootstrap complete"
            exit 0
        fi
        # A proposed prepared-runtime mismatch is required to take the cold
        # producer below. Do not let the older exact-revision shortcut turn a
        # qualification/source/toolchain/platform miss back into reuse.
    elif reuse_authoritative_runtime_receipt; then
        log "reusing exact current-revision runtime readiness receipt; link and qualification are already authoritative"
        report_binary_size "$ROOT/target/debug/snapback"
        log "Ibex runtime bootstrap complete"
        exit 0
    fi
    # @ref LLP 0010#native-runtime-bootstrap -- validate with a real link + launch,
    # not just `cargo check`. cargo check never links or loads hermesvm.framework,
    # so it could not catch the missing-LC_RPATH launch wedge that made a fresh
    # worktree's first `cargo run` crash (ENG-22664). Build the binary (real link)
    # and, on macOS, launch it with DYLD_* scrubbed to mirror the SIP-stripped
    # environment of a protected process tree; the framework must load from the
    # LC_RPATH baked in by crates/snapback/build.rs. Artifacts were verified above, so a failure
    # here is a Snapback/vendored-runtime compile/link or runtime-load problem,
    # not a missing artifact.
    log "validating Snapback native runtime: exact cargo link + launch smoke"
    probe_status=0
    probe_json="$(node "$ROOT/scripts/runtime-link-smoke.mjs" \
        --json --target-dir "$ROOT/target" --keep-target)" || probe_status=$?
    if ! printf '%s' "$probe_json" | python3 -c 'import json,sys; json.load(sys.stdin)' >/dev/null 2>&1; then
        fail "SNAPBACK_IBEX_RUNTIME_LINK_PROBE_FAILED: exact-link helper exited $probe_status without a structured report; run node $ROOT/scripts/runtime-link-smoke.mjs for the underlying failure"
    fi
    recovery_record="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["recovery"], separators=(",",":")))')"
    log "runtime recovery record: $recovery_record"
    if [ "$probe_status" -ne 0 ]; then
        probe_code="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["diagnostic"]["code"])')"
        probe_message="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["diagnostic"]["message"])')"
        fail "$probe_code: $probe_message"
    fi
    log "exact link + launch + handler-VM qualification smoke passed with dynamic-loader overrides scrubbed"
    report_binary_size "$ROOT/target/debug/snapback"
fi

log "Ibex runtime bootstrap complete"
