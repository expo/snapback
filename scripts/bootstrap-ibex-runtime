#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENDOR_IBEX="$ROOT/vendor/ibex"
DEFAULT_PEER_IBEX="$(cd "$ROOT/.." && pwd)/ibex"
PEER_IBEX="${SNAPBACK_IBEX_CHECKOUT:-$DEFAULT_PEER_IBEX}"
TARGET_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH_RAW="$(uname -m)"

case "$ARCH_RAW" in
    arm64|aarch64) HERMES_ARCH="arm64" ;;
    x86_64|amd64) HERMES_ARCH="x64" ;;
    *) HERMES_ARCH="$ARCH_RAW" ;;
esac

RUN_CHECK="${SNAPBACK_BOOTSTRAP_CHECK:-1}"

log() {
    printf '[snapback-bootstrap] %s\n' "$*"
}

fail() {
    printf '[snapback-bootstrap] error: %s\n' "$*" >&2
    exit 1
}

copy_dir_contents() {
    local src="$1"
    local dst="$2"

    mkdir -p "$dst"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a "$src/" "$dst/"
    else
        cp -R "$src/." "$dst/"
    fi
}

has_tool() {
    local base="$1"
    local tool="$2"
    shift 2

    local candidate
    for candidate in "$@"; do
        if [ -f "$base/tools/hermes/$candidate" ]; then
            return 0
        fi
    done

    log "$tool missing under $base/tools/hermes"
    return 1
}

has_macos_framework() {
    local base="$1"
    local frameworks="$base/ios/Frameworks"
    local candidate

    for candidate in \
        "$frameworks/hermes.framework/hermes" \
        "$frameworks/hermes.framework/Versions/Current/hermes" \
        "$frameworks/hermes.framework/Versions/1/hermes" \
        "$frameworks/hermes.framework/Versions/0/hermes" \
        "$frameworks/macosx/hermes.framework/hermes" \
        "$frameworks/macosx/hermes.framework/Versions/Current/hermes" \
        "$frameworks/macosx/hermes.framework/Versions/1/hermes" \
        "$frameworks/macosx/hermes.framework/Versions/0/hermes" \
        "$frameworks/hermesvm.framework/hermesvm" \
        "$frameworks/hermesvm.framework/Versions/Current/hermesvm" \
        "$frameworks/hermesvm.framework/Versions/1/hermesvm" \
        "$frameworks/hermesvm.framework/Versions/0/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermes.framework/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermes.framework/Versions/Current/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermesvm.framework/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermesvm.framework/Versions/Current/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64/hermes.framework/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64/hermes.framework/Versions/Current/hermes" \
        "$frameworks/hermes.xcframework/macos-arm64/hermesvm.framework/hermesvm" \
        "$frameworks/hermes.xcframework/macos-arm64/hermesvm.framework/Versions/Current/hermesvm"
    do
        if [ -f "$candidate" ]; then
            return 0
        fi
    done

    log "macOS Hermes framework missing under $frameworks"
    return 1
}

has_darwin_artifacts() {
    local base="$1"
    local frameworks="$base/ios/Frameworks"

    [ -f "$frameworks/hermes-headers/hermes/hermes.h" ] || {
        log "Hermes headers missing under $frameworks/hermes-headers"
        return 1
    }
    [ -f "$frameworks/hermes-headers/jsi/jsi.h" ] || {
        log "JSI headers missing under $frameworks/hermes-headers"
        return 1
    }
    has_macos_framework "$base" || return 1
    has_tool "$base" "hermesc" "hermesc-macos-$HERMES_ARCH" "hermesc" || return 1
}

has_linux_artifacts() {
    local base="$1"

    [ -f "$base/linux/hermes-headers/hermes/hermes.h" ] || {
        log "Linux Hermes headers missing under $base/linux/hermes-headers/hermes"
        return 1
    }
    [ -f "$base/linux/hermes-headers/jsi/jsi.h" ] || {
        log "Linux JSI headers missing under $base/linux/hermes-headers/jsi"
        return 1
    }
    [ -d "$base/linux/lib" ] || {
        log "Linux Hermes lib dir missing under $base/linux/lib"
        return 1
    }
    find "$base/linux/lib" -name 'libhermesvm*' -print -quit | grep -q . || {
        log "libhermesvm missing under $base/linux/lib"
        return 1
    }
    has_tool "$base" "hermesc" "hermesc-linux-$HERMES_ARCH" "hermesc" || return 1
}

has_target_artifacts() {
    local base="$1"

    case "$TARGET_OS" in
        darwin) has_darwin_artifacts "$base" ;;
        linux) has_linux_artifacts "$base" ;;
        *)
            fail "unsupported bootstrap host '$TARGET_OS'; use vendor/ibex platform setup directly"
            ;;
    esac
}

copy_peer_artifacts() {
    [ -d "$PEER_IBEX" ] || return 1
    has_target_artifacts "$PEER_IBEX" || return 1

    log "copying prebuilt Ibex/Hermes artifacts from $PEER_IBEX"
    case "$TARGET_OS" in
        darwin)
            copy_dir_contents "$PEER_IBEX/ios/Frameworks" "$VENDOR_IBEX/ios/Frameworks"
            copy_dir_contents "$PEER_IBEX/tools/hermes" "$VENDOR_IBEX/tools/hermes"
            ;;
        linux)
            copy_dir_contents "$PEER_IBEX/linux" "$VENDOR_IBEX/linux"
            copy_dir_contents "$PEER_IBEX/tools/hermes" "$VENDOR_IBEX/tools/hermes"
            ;;
    esac

    local peer_bin=""
    if [ -x "$PEER_IBEX/target/debug/ibex" ]; then
        peer_bin="$PEER_IBEX/target/debug/ibex"
    elif [ -x "$PEER_IBEX/target/release/ibex" ]; then
        peer_bin="$PEER_IBEX/target/release/ibex"
    fi

    if [ -n "$peer_bin" ] && [ ! -e "$VENDOR_IBEX/target/debug/ibex" ]; then
        mkdir -p "$VENDOR_IBEX/target/debug"
        ln -s "$peer_bin" "$VENDOR_IBEX/target/debug/ibex"
        log "linked vendored Ibex CLI to $peer_bin"
    fi
}

# @ref LLP 0010#native-runtime-bootstrap -- vendor/ibex is a git submodule;
# resolve its checkout state BEFORE writing any artifacts into the path.
# Running this script ahead of `git submodule update --init` used to wedge
# fresh worktrees (ENG-22595): artifacts landed in the empty gitlink path and
# the later submodule clone refused ("destination path ... already exists and
# is not an empty directory").
ensure_vendor_ibex_checkout() {
    # Populated checkout (submodule initialized, or a non-git source export
    # that vendors the Ibex sources directly): nothing to do. This
    # deliberately also tolerates sources copied in over an uninitialized
    # gitlink — builds work, and scripts/ibex-doctor flags the git state.
    if [ -f "$VENDOR_IBEX/Cargo.toml" ]; then
        return 0
    fi

    local status
    status="$(git -C "$ROOT" submodule status -- vendor/ibex 2>/dev/null || true)"

    if [ -z "$status" ]; then
        fail "SNAPBACK_IBEX_SOURCE_MISSING: $VENDOR_IBEX has no Cargo.toml and this tree does not know vendor/ibex as a git submodule; re-fetch a complete Snapback source tree (git clone, then git submodule update --init --recursive)"
    fi

    case "$status" in
        -*)
            # Gitlink recorded but the submodule worktree was never
            # initialized (git submodule status prefixes these with '-').
            local stray=0
            if [ -d "$VENDOR_IBEX" ] && [ -n "$(ls -A "$VENDOR_IBEX" 2>/dev/null)" ]; then
                # Stray files already occupy the uninitialized path (for
                # example an older bootstrap wrote artifacts here). A fresh
                # clone refuses over a non-empty directory, but a retained
                # submodule gitdir (rm -rf'd checkout in a
                # previously-initialized worktree) checks out fine over
                # untracked artifacts — so attempt the init and refuse only
                # if git itself cannot complete it. Never delete the files.
                stray=1
                log "vendor/ibex submodule is not initialized and the directory already has content; attempting: git submodule update --init --recursive -- vendor/ibex"
            else
                log "vendor/ibex submodule is not initialized; running: git submodule update --init --recursive -- vendor/ibex"
            fi
            if ! git -C "$ROOT" submodule update --init --recursive -- vendor/ibex; then
                if [ "$stray" = "1" ]; then
                    printf '[snapback-bootstrap] error: SNAPBACK_IBEX_SUBMODULE_WEDGED: git could not initialize the vendor/ibex submodule over the existing directory contents (see the git error above)\n' >&2
                    printf '[snapback-bootstrap] the stray contents are usually regenerable bootstrap artifacts (ios/, linux/, tools/, target/); recover with:\n' >&2
                    printf '[snapback-bootstrap]   mv %q %q\n' "$VENDOR_IBEX" "$VENDOR_IBEX.wedged.$(date +%Y%m%d%H%M%S)" >&2
                    printf '[snapback-bootstrap]   git -C %q submodule update --init --recursive -- vendor/ibex\n' "$ROOT" >&2
                    printf '[snapback-bootstrap]   %q\n' "$ROOT/scripts/bootstrap-ibex-runtime" >&2
                    printf '[snapback-bootstrap] (scripts/ibex-doctor re-checks this state)\n' >&2
                    exit 1
                fi
                fail "SNAPBACK_IBEX_SUBMODULE_INIT_FAILED: git submodule update --init --recursive -- vendor/ibex failed; fix the error above (network/credentials) and re-run this script"
            fi
            ;;
    esac

    [ -f "$VENDOR_IBEX/Cargo.toml" ] || fail "SNAPBACK_IBEX_SUBMODULE_BROKEN: vendor/ibex is initialized but $VENDOR_IBEX/Cargo.toml is still missing; try: git -C $ROOT submodule update --force --checkout --recursive -- vendor/ibex"
}

ensure_vendor_ibex_checkout

# @ref LLP 0010#native-runtime-bootstrap -- Snapback agents should consume
# prepared Ibex/Hermes artifacts before attempting a native Hermes build.
if has_target_artifacts "$VENDOR_IBEX"; then
    log "vendored Ibex/Hermes artifacts are already usable"
else
    if copy_peer_artifacts; then
        log "installed prebuilt artifacts from sibling Ibex checkout"
    else
        log "no complete sibling Ibex artifact set found at $PEER_IBEX"
        log "running vendored Ibex Hermes bootstrap; this may download or build native artifacts"
        "$VENDOR_IBEX/scripts/download-hermes.sh"
    fi
fi

has_target_artifacts "$VENDOR_IBEX" || fail "Ibex/Hermes artifacts are still incomplete"

if [ "$RUN_CHECK" != "0" ]; then
    log "validating Snapback Rust build with cargo check"
    (cd "$ROOT" && cargo check -q)
fi

log "Ibex runtime bootstrap complete"
