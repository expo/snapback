#!/usr/bin/env bash
#
# ibex-doctor — read-only diagnosis of the vendor/ibex runtime checkout.
#
# Classifies the states an operator actually hits bringing up a fresh clone or
# worktree (ENG-22595), with a stable code, a severity, and the exact recovery
# commands. Never writes to the tree; scripts/bootstrap-ibex-runtime is the
# authoritative fixer for artifact problems.
#
# The codes here match the codes scripts/bootstrap-ibex-runtime fails with, for
# both the submodule paths (ENG-22595) and the non-submodule artifact/host paths
# (ENG-22660): SNAPBACK_CAPABILITY_IBEX_HERMES_MISSING for incomplete prepared
# Hermes artifacts and SNAPBACK_IBEX_HOST_UNSUPPORTED for an unsupported host. A
# compile/link failure past a healthy artifact set is bootstrap's
# SNAPBACK_IBEX_CARGO_BUILD_FAILED, and a binary that links but cannot load
# hermesvm.framework at launch (missing LC_RPATH) is
# SNAPBACK_IBEX_RUNTIME_LOAD_FAILED. The exact-link smoke below stays read-only
# by using an automatically removed temporary Cargo target, but it now does
# reproduce both classes before reporting a healthy checkout.
#
# Exit status: 0 when vendor/ibex is healthy enough to bootstrap/build,
# 1 when any error-severity finding is reported.
#
# @ref LLP 0010#diagnostic-shape -- findings reuse that section's stable-code
# + severity + suggested-next-checks vocabulary, but as human-readable text
# lines plus an exit status, not the machine-readable diagnostic object it
# specifies for product surfaces.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENDOR_IBEX="$ROOT/vendor/ibex"
TARGET_OS="$(uname -s | tr '[:upper:]' '[:lower:]')"

# --json (LLP 0032 P7): emit a structured report instead of text lines.
JSON_MODE=0
if [ "${1:-}" = "--json" ]; then
    JSON_MODE=1
fi

FINDINGS=0
JSON_CHECKS=""
RUNTIME_RECOVERY_JSON="null"

json_escape() {
    printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null \
        || printf '"%s"' "$(printf '%s' "$1" | sed 's/"/\\"/g')"
}

json_append() {
    # json_append <severity> <code> <message>
    local entry
    entry="{\"severity\":$(json_escape "$1"),\"code\":$(json_escape "$2"),\"message\":$(json_escape "$3")}"
    if [ -n "$JSON_CHECKS" ]; then
        JSON_CHECKS="$JSON_CHECKS,$entry"
    else
        JSON_CHECKS="$entry"
    fi
}

report() {
    # report <severity> <code> <message>
    local severity="$1" code="$2" message="$3"
    if [ "$JSON_MODE" = 1 ]; then
        json_append "$severity" "$code" "$message"
    else
        printf '[ibex-doctor] %s %s: %s\n' "$severity" "$code" "$message"
    fi
    if [ "$severity" = "ERROR" ]; then
        FINDINGS=$((FINDINGS + 1))
    fi
}

hint() {
    if [ "$JSON_MODE" = 1 ]; then
        json_append "FIX" "remediation" "$*"
    else
        printf '[ibex-doctor]   fix: %s\n' "$*"
    fi
}

note() {
    if [ "$JSON_MODE" = 1 ]; then
        json_append "NOTE" "note" "$*"
    else
        printf '[ibex-doctor] %s\n' "$*"
    fi
}

# --- 1. Submodule checkout state (the ENG-22595 wedge lives here) -----------

submodule_status="$(git -C "$ROOT" submodule status -- vendor/ibex 2>/dev/null || true)"

if [ -f "$VENDOR_IBEX/Cargo.toml" ]; then
    note "OK vendor/ibex sources are present ($VENDOR_IBEX/Cargo.toml)"
    case "$submodule_status" in
        -*)
            # Sources are present (e.g. a sibling ../ibex checkout copied in
            # by hand) but the gitlink was never initialized in this
            # worktree: cargo may build, yet `git submodule update --init`
            # still hits the ENG-22595 failure unless a retained submodule
            # gitdir can be reused.
            report ERROR SNAPBACK_IBEX_SUBMODULE_WEDGED \
                "vendor/ibex holds Ibex sources but the submodule is not initialized in this worktree; builds may work (the bootstrap tolerates a populated dir), but git submodule update --init can fail permanently over the existing contents"
            hint "git -C $ROOT submodule update --init --recursive -- vendor/ibex  # succeeds only if git can check out over the existing contents"
            hint "if the init fails: mv $VENDOR_IBEX $VENDOR_IBEX.wedged.\$(date +%Y%m%d%H%M%S), re-run the init, then $ROOT/scripts/bootstrap-ibex-runtime  # the moved-aside copy keeps any local edits"
            ;;
        +*)
            report WARN SNAPBACK_IBEX_SUBMODULE_DRIFT \
                "vendor/ibex checkout does not match the commit this Snapback revision pins"
            hint "git -C $ROOT submodule update --recursive -- vendor/ibex  # if the drift is not intentional"
            ;;
        U*)
            report ERROR SNAPBACK_IBEX_SUBMODULE_CONFLICT \
                "vendor/ibex has unresolved merge conflicts"
            hint "resolve the submodule conflict, then: git -C $ROOT submodule update --recursive -- vendor/ibex"
            ;;
    esac
elif [ -z "$submodule_status" ]; then
    report ERROR SNAPBACK_IBEX_SOURCE_MISSING \
        "vendor/ibex has no Cargo.toml and this tree does not know it as a git submodule"
    hint "re-fetch a complete Snapback source tree: git clone <snapback>, then git submodule update --init --recursive"
else
    case "$submodule_status" in
        -*)
            if [ -d "$VENDOR_IBEX" ] && [ -n "$(ls -A "$VENDOR_IBEX" 2>/dev/null)" ]; then
                # The ENG-22595 wedge: gitlink never initialized, but stray
                # files (typically bootstrap artifacts: ios/, linux/, tools/,
                # target/) occupy the path. A fresh clone refuses over the
                # non-empty directory; a retained submodule gitdir can still
                # check out over untracked artifacts, so try the init first.
                report ERROR SNAPBACK_IBEX_SUBMODULE_WEDGED \
                    "vendor/ibex is an uninitialized submodule but the directory is not empty; git submodule update --init fails here unless a retained submodule gitdir can be reused"
                hint "$ROOT/scripts/bootstrap-ibex-runtime  # attempts the init and prints recovery steps if git cannot complete it"
                hint "if the init fails: mv $VENDOR_IBEX $VENDOR_IBEX.wedged.\$(date +%Y%m%d%H%M%S), then git -C $ROOT submodule update --init --recursive -- vendor/ibex, then re-run the bootstrap"
            else
                report ERROR SNAPBACK_IBEX_SUBMODULE_UNINITIALIZED \
                    "vendor/ibex submodule has not been initialized in this worktree"
                hint "git -C $ROOT submodule update --init --recursive  # or just run scripts/bootstrap-ibex-runtime, which now does this"
            fi
            ;;
        *)
            report ERROR SNAPBACK_IBEX_SUBMODULE_BROKEN \
                "vendor/ibex is initialized but $VENDOR_IBEX/Cargo.toml is missing"
            hint "git -C $ROOT submodule update --force --checkout --recursive -- vendor/ibex"
            ;;
    esac
fi

# --- 2. Prepared Hermes artifacts (coarse; bootstrap validates fully) --------

if [ -f "$VENDOR_IBEX/Cargo.toml" ]; then
    artifacts_ok=1
    case "$TARGET_OS" in
        darwin)
            [ -f "$VENDOR_IBEX/ios/Frameworks/hermes-headers/hermes/hermes.h" ] || artifacts_ok=0
            find "$VENDOR_IBEX/tools/hermes" -name 'hermesc*' -print -quit 2>/dev/null | grep -q . || artifacts_ok=0
            ;;
        linux)
            [ -f "$VENDOR_IBEX/linux/hermes-headers/hermes/hermes.h" ] || artifacts_ok=0
            find "$VENDOR_IBEX/linux/lib" -name 'libhermesvm*' -print -quit 2>/dev/null | grep -q . || artifacts_ok=0
            ;;
        *)
            report WARN SNAPBACK_IBEX_HOST_UNSUPPORTED \
                "no doctor artifact probe for host '$TARGET_OS'; use vendor/ibex platform setup directly"
            artifacts_ok=1
            ;;
    esac

    if [ "$artifacts_ok" = "1" ]; then
        note "OK prepared Hermes artifacts look present for $TARGET_OS (bootstrap validates the full set)"
    else
        report ERROR SNAPBACK_CAPABILITY_IBEX_HERMES_MISSING \
            "prepared Hermes headers/tools are missing under vendor/ibex; cargo will fail with native Hermes errors"
        hint "$ROOT/scripts/bootstrap-ibex-runtime  # set SNAPBACK_IBEX_CHECKOUT=/path/to/ibex if the prepared checkout is not ../ibex"
    fi

    # macOS runtime framework (LLP 0032 P7: the launch-SIGABRT shape is a
    # missing hermesvm/hermes framework, distinct from missing headers). The
    # candidate list matches scripts/bootstrap-ibex-runtime's
    # has_macos_framework; bootstrap remains the authoritative validator.
    if [ "$TARGET_OS" = "darwin" ]; then
        frameworks="$VENDOR_IBEX/ios/Frameworks"
        framework_ok=0
        for candidate in \
            "$frameworks/hermes.framework/hermes" \
            "$frameworks/hermes.framework/Versions/Current/hermes" \
            "$frameworks/macosx/hermes.framework/hermes" \
            "$frameworks/macosx/hermes.framework/Versions/Current/hermes" \
            "$frameworks/hermesvm.framework/hermesvm" \
            "$frameworks/hermesvm.framework/Versions/Current/hermesvm" \
            "$frameworks/hermes.xcframework/macos-arm64_x86_64/hermesvm.framework/hermesvm" \
            "$frameworks/hermes.xcframework/macos-arm64/hermesvm.framework/hermesvm"
        do
            if [ -f "$candidate" ]; then framework_ok=1; break; fi
        done
        if [ "$framework_ok" = "1" ]; then
            note "OK macOS Hermes runtime framework present under ios/Frameworks"
        else
            report ERROR SNAPBACK_CAPABILITY_IBEX_HERMES_MISSING \
                "no macOS Hermes runtime framework under $frameworks — binaries build-fail or SIGABRT loading hermesvm at launch"
            hint "$ROOT/scripts/bootstrap-ibex-runtime  # installs the framework and bakes the LC_RPATH (ENG-22664)"
        fi
    fi
fi

# --- 3. Runtime library path (the spawned-process dyld SIGABRT shape) --------

if [ "$TARGET_OS" = "darwin" ]; then
    # macOS SIP strips DYLD_* variables when execution crosses a protected
    # binary (/bin/bash included), so this doctor can NEVER observe the
    # caller's DYLD_FRAMEWORK_PATH — the very mechanism behind the "exported
    # it and the spawned server still SIGABRTs" diary confusion. Since
    # ENG-22664 the bootstrap bakes the LC_RPATH into built binaries, so
    # DYLD_FRAMEWORK_PATH is only needed for binaries built before that or
    # built outside the bootstrap; this stays standing guidance, not an
    # observation.
    note "INFO DYLD guidance: if a test-spawned server SIGABRTs loading Hermes, re-run $ROOT/scripts/bootstrap-ibex-runtime (bakes LC_RPATH); SIP strips DYLD_* so the doctor cannot verify your shell's value"
elif [ "$TARGET_OS" = "linux" ]; then
    LIB_DIR="$VENDOR_IBEX/linux/lib"
    case ":${LD_LIBRARY_PATH:-}:" in
        *":$LIB_DIR:"*)
            note "OK LD_LIBRARY_PATH includes the vendored Hermes libs"
            ;;
        *)
            report WARN SNAPBACK_IBEX_LD_LIBRARY_PATH \
                "LD_LIBRARY_PATH does not include $LIB_DIR — spawned server binaries may fail to load libhermesvm (scripts/verify-local-proof sets this automatically)"
            hint "export LD_LIBRARY_PATH=\"$LIB_DIR\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}\""
            ;;
    esac
fi

# --- 4. Vendored Ibex CLI (optional capability; the server reports the gap) --

if [ -x "$VENDOR_IBEX/target/debug/ibex" ] || [ -x "$VENDOR_IBEX/target/release/ibex" ]; then
    note "OK vendored Ibex CLI present"
else
    report WARN SNAPBACK_IBEX_CLI_MISSING \
        "vendored Ibex CLI not built — the server runs, reporting the ibex_cli capability gap"
    hint "$ROOT/scripts/bootstrap-ibex-runtime  # links the sibling checkout's CLI when one exists"
fi

# --- 5. Toolchain -------------------------------------------------------------

if command -v cargo >/dev/null 2>&1; then
    note "OK cargo present ($(cargo --version 2>/dev/null | head -1))"
else
    report ERROR SNAPBACK_TOOLCHAIN_CARGO_MISSING "cargo not found"
    hint "install Rust via rustup (https://rustup.rs)"
fi

if command -v node >/dev/null 2>&1; then
    note "OK node present ($(node --version 2>/dev/null))"
else
    report ERROR SNAPBACK_TOOLCHAIN_NODE_MISSING "node not found (the demo acceptance suites need node >= 22)"
    hint "install Node 22+"
fi

if command -v bun >/dev/null 2>&1; then
    note "OK bun present ($(bun --version 2>/dev/null))"
else
    report WARN SNAPBACK_TOOLCHAIN_BUN_MISSING "bun not found — only the Exact-dependent Contract suites need it"
    hint "install bun (https://bun.sh)"
fi

# --- 6. Exact current-checkout link + launch ----------------------------------

# @ref LLP 0010#native-runtime-bootstrap -- presence is only a precondition:
# prove that this checkout's final binary target links and launches. The helper
# owns a temporary Cargo target and removes it after success, failure, signal,
# or timeout, preserving doctor's read-only repository contract.
if [ "$FINDINGS" -eq 0 ] && command -v cargo >/dev/null 2>&1 && command -v node >/dev/null 2>&1; then
    probe_status=0
    probe_json="$(node "$ROOT/scripts/runtime-link-smoke.mjs" --json)" || probe_status=$?
    if printf '%s' "$probe_json" | python3 -c 'import json,sys; json.load(sys.stdin)' >/dev/null 2>&1; then
        RUNTIME_RECOVERY_JSON="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["recovery"], separators=(",",":")))')"
        probe_code="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["diagnostic"]["code"])')"
        probe_message="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["diagnostic"]["message"])')"
        if [ "$probe_status" -eq 0 ]; then
            note "OK $probe_code: $probe_message"
        else
            report ERROR "$probe_code" "$probe_message"
            missing_symbols="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(", ".join(json.load(sys.stdin)["diagnostic"].get("details",{}).get("missingSymbols",[])))')"
            [ -z "$missing_symbols" ] || note "missing symbols: $missing_symbols"
            hint "$ROOT/scripts/bootstrap-ibex-runtime"
            override="$(printf '%s' "$probe_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["recovery"].get("recovery",{}).get("overrideCommand") or "")')"
            [ -z "$override" ] || hint "$override  # explicit stale-binary escape; identity remains classified"
        fi
        if [ "$JSON_MODE" != 1 ]; then
            note "runtime recovery record: $RUNTIME_RECOVERY_JSON"
        fi
    else
        report ERROR SNAPBACK_IBEX_RUNTIME_LINK_PROBE_FAILED \
            "the exact-link helper failed without a structured report (exit $probe_status)"
        hint "node $ROOT/scripts/runtime-link-smoke.mjs"
    fi
fi

# --- 7. Served-binary readiness receipt (read-only; LLP 0115 CV-3) -----------

# The exact-link probe above proves the CHECKOUT can produce a good binary; it
# is structurally blind to a stale SERVED binary. The persisted readiness
# receipt (`<binary>.runtime-readiness.json`, issued at bootstrap/qualify
# time) closes that gap: verify digest coherence between the served binary,
# the current Hermes artifacts, and the recorded qualification — read-only,
# never re-qualifying or writing anything.
if command -v node >/dev/null 2>&1; then
    SERVED_BINARY="${SNAPBACK_SERVER_BINARY:-$ROOT/target/debug/snapback}"
    if [ -f "$SERVED_BINARY" ]; then
        receipt_status=0
        receipt_json="$(node "$ROOT/packages/snapback-cli/runtime-readiness.mjs" verify \
            --binary "$SERVED_BINARY" --root "$ROOT" --json)" || receipt_status=$?
        if printf '%s' "$receipt_json" | python3 -c 'import json,sys; json.load(sys.stdin)' >/dev/null 2>&1; then
            receipt_reason="$(printf '%s' "$receipt_json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("reason") or "unknown")')"
            if [ "$receipt_status" -eq 0 ]; then
                note "OK served binary readiness receipt is digest-coherent ($SERVED_BINARY)"
            else
                receipt_message="$(printf '%s' "$receipt_json" | python3 -c 'import json,sys; print((json.load(sys.stdin).get("diagnostic") or {}).get("message") or "")')"
                report ERROR SNAPBACK_IBEX_RUNTIME_RECEIPT_INVALID \
                    "readiness receipt $receipt_reason for the served binary $SERVED_BINARY: $receipt_message"
                hint "node $ROOT/packages/snapback-cli/runtime-readiness.mjs issue --binary $SERVED_BINARY  # re-qualify and reissue in milliseconds"
                hint "$ROOT/scripts/bootstrap-ibex-runtime  # full repair: refresh artifacts, relink, qualify, reissue"
            fi
        else
            report ERROR SNAPBACK_IBEX_RUNTIME_RECEIPT_INVALID \
                "the readiness receipt verifier failed without a structured report (exit $receipt_status)"
            hint "node $ROOT/packages/snapback-cli/runtime-readiness.mjs verify --binary $SERVED_BINARY"
        fi
    else
        note "INFO no served snapback binary at $SERVED_BINARY yet; scripts/bootstrap-ibex-runtime issues its readiness receipt at build time"
    fi
fi

# --- Verdict -----------------------------------------------------------------

if [ "$JSON_MODE" = 1 ]; then
    OK_VALUE=true
    [ "$FINDINGS" -gt 0 ] && OK_VALUE=false
    printf '{"schemaVersion":"snapback.v0","resultKind":"ibexDoctorReport","os":"%s","ok":%s,"errorFindings":%s,"checks":[%s],"runtimeRecovery":%s}\n' \
        "$TARGET_OS" "$OK_VALUE" "$FINDINGS" "$JSON_CHECKS" "$RUNTIME_RECOVERY_JSON"
    [ "$FINDINGS" -eq 0 ] && exit 0
    exit 1
fi

if [ "$FINDINGS" -eq 0 ]; then
    note "vendor/ibex is healthy"
    exit 0
fi

note "$FINDINGS error finding(s); apply the fixes above, then re-run scripts/ibex-doctor"
exit 1
