#!/usr/bin/env bash

set -euo pipefail

check_current_repo() {
    local config_status
    local origin_url

    # actions/checkout v7 stores its HTTP header in a separate
    # $RUNNER_TEMP/git-credentials-*.config and connects that file through
    # repository-local include/includeIf entries. `--local` alone does not
    # follow those entries; make inclusion explicit and ask Git for names only
    # so a future diagnostic change cannot expose a header value.
    #
    # @ref LLP 0010#ci-and-review-gates — checkout authority must be gone
    #   before any repository-owned proof code executes.
    if git config --local --includes --name-only --get-regexp '^http\..*\.extraheader$' \
        >/dev/null 2>&1; then
        printf '[checkout-credentials] error: checkout left an HTTP authorization header in a repository config\n' >&2
        exit 1
    else
        config_status=$?
        if [ "$config_status" -ne 1 ]; then
            printf '[checkout-credentials] error: could not inspect the effective repository config for checkout credentials\n' >&2
            exit 1
        fi
    fi

    origin_url="$(git remote get-url origin 2>/dev/null || true)"
    case "$origin_url" in
        *x-access-token*|*oauth2*|*github_pat_*)
            printf '[checkout-credentials] error: a repository origin URL contains embedded credentials\n' >&2
            exit 1
            ;;
    esac
}

check_current_repo

if [ "${1:-}" != "--current-only" ]; then
    SNAPBACK_CREDENTIAL_CHECK_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    export SNAPBACK_CREDENTIAL_CHECK_SCRIPT
    if ! git submodule foreach --quiet --recursive '"$SNAPBACK_CREDENTIAL_CHECK_SCRIPT" --current-only'; then
        exit 1
    fi
fi

printf '[checkout-credentials] PASS: no persisted checkout credential in the repository or initialized submodules\n'
