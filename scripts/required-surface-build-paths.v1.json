{
  "schemaVersion": "snapback.required-surface-build-paths.v1",
  "fixedPaths": [
    ".github/workflows/required-surface-builds.yml",
    ".node-version",
    "bun.lock",
    "package.json",
    "demos/*/demo.snapback.json",
    "demos/_kit/client.mjs",
    "demos/_kit/define.mjs",
    "demos/_kit/target-origin.mjs",
    "packages/*/package.json",
    "packages/snapback-acceptance/*.mjs",
    "!packages/snapback-acceptance/*.fixture.mjs",
    "!packages/snapback-acceptance/*.test.mjs",
    "packages/snapback-cli/*.mjs",
    "!packages/snapback-cli/*.test.mjs",
    "packages/snapback-client/*.mjs",
    "!packages/snapback-client/*.fixture.mjs",
    "!packages/snapback-client/*.test.mjs",
    "packages/snapback-client/internal/*.mjs",
    "packages/snapback-codegen/*.json",
    "packages/snapback-codegen/*.mjs",
    "!packages/snapback-codegen/*.test.mjs",
    "packages/snapback-codegen/runtime-artifacts/**",
    "packages/snapback-contract/*.mjs",
    "!packages/snapback-contract/*.test.mjs",
    "packages/snapback-vite/*.json",
    "packages/snapback-vite/*.mjs",
    "!packages/snapback-vite/*.test.mjs",
    "scripts/check-artifact-path-hygiene.mjs",
    "scripts/check-checkout-credentials",
    "scripts/check-required-surface-builds.mjs",
    "scripts/lib/process-tree.mjs",
    "scripts/require-bun-package-manager.mjs",
    "scripts/required-surface-build-paths.v1.json",
    "targets/cloudflare/client-options.mjs"
  ],
  "requiredSurfacePaths": [
    "demos/all-aboard/snapback/**",
    "demos/all-aboard/surfaces/contract/**",
    "demos/cursors-web/snapback/**",
    "demos/cursors-web/surfaces/contract/**",
    "demos/pointing-room/snapback/**",
    "demos/pointing-room/surfaces/contract/**"
  ]
}
