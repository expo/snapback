#!/usr/bin/env bash

set -euo pipefail

PROOF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROOF_MODE="${1:---check}"
PROOF_RECEIPT="${SNAPBACK_TELEMETRY_PHASE1_RECEIPT:-$PROOF_ROOT/tests/acceptance/telemetry-phase1-evidence.v1.json}"

# @ref LLP 0010#native-runtime-bootstrap — Cargo test harnesses link the
# vendored engine too; give them the same supported loader environment as the
# canonical local proof before the coded bootstrap validates the real binary.
case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
    darwin)
        export DYLD_FRAMEWORK_PATH="$PROOF_ROOT/vendor/ibex/ios/Frameworks:$PROOF_ROOT/vendor/ibex/ios/Frameworks/macosx${DYLD_FRAMEWORK_PATH:+:$DYLD_FRAMEWORK_PATH}"
        ;;
    linux)
        export LD_LIBRARY_PATH="$PROOF_ROOT/vendor/ibex/linux/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        ;;
esac

prepare_rust_test_fixtures() {
    # @ref LLP 0032#phase-5--product-boundary-and-dx — P3's generated-artifact
    # contract: Rust unit fixtures include these ignored caches at compile
    # time, so a fresh proof must materialize them before invoking Cargo.
    node "$PROOF_ROOT/packages/snapback-codegen/index.mjs" \
        "$PROOF_ROOT/demos/todo/snapback"
    node "$PROOF_ROOT/packages/snapback-codegen/index.mjs" \
        "$PROOF_ROOT/demos/rbac/snapback"
    if ! git diff --quiet -- \
        demos/todo/snapback/generated \
        demos/rbac/snapback/generated \
        || ! git diff --cached --quiet -- \
            demos/todo/snapback/generated \
            demos/rbac/snapback/generated; then
        printf 'SNAPBACK_TELEMETRY_PHASE1_GENERATED_FIXTURE_DRIFT\n' >&2
        exit 1
    fi
}

case "$PROOF_MODE" in
    --check)
        # Rolling main may advance forever. This proves the retained receipt
        # historically and reports CURRENT/LAGGING/OVERDUE separately; only a
        # divergent receipt fails the ordinary merge lane.
        exec node "$PROOF_ROOT/scripts/telemetry-phase1-evidence.mjs" assess "$PROOF_RECEIPT"
        ;;
    --history)
        exec node "$PROOF_ROOT/scripts/telemetry-phase1-evidence.mjs" validate-history "$PROOF_RECEIPT"
        ;;
    --require-current)
        # This is the exact-source boundary release and capability-promotion
        # boundary used by snapback-publish.mjs and snapback-promote.mjs.
        if [ "$#" -gt 2 ]; then
            printf 'usage: scripts/verify-telemetry-phase1-proof --require-current [<sha>]\n' >&2
            exit 2
        fi
        if [ "$#" -eq 2 ]; then
            exec node "$PROOF_ROOT/scripts/telemetry-phase1-evidence.mjs" \
                require-current "$PROOF_RECEIPT" --at "$2"
        fi
        exec node "$PROOF_ROOT/scripts/telemetry-phase1-evidence.mjs" require-current "$PROOF_RECEIPT"
        ;;
    --smoke)
        cd "$PROOF_ROOT"
        prepare_rust_test_fixtures
        scripts/bootstrap-ibex-runtime
        node --check scripts/telemetry-phase1-idle-proof.mjs
        cargo test --locked -p snapback --features telemetry-phase1-proof --lib \
            telemetry::phase1_bench::tests::phase1_benchmark_smoke_exercises_every_gate \
            -- --exact
        ;;
    --full)
        cd "$PROOF_ROOT"
        if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
            printf 'SNAPBACK_TELEMETRY_PHASE1_CLEAN_CHECKOUT_REQUIRED\n' >&2
            exit 1
        fi
        PROOF_REVISION="$(git rev-parse HEAD)"
        prepare_rust_test_fixtures
        scripts/bootstrap-ibex-runtime
        cargo test --locked -p snapback --features telemetry-phase1-proof --lib \
            telemetry::phase1_bench::tests::phase1_benchmark_smoke_exercises_every_gate \
            -- --exact
        cargo build --locked --release -p snapback --features telemetry-phase1-proof \
            --bin snapback --bin snapback-telemetry-bench
        node packages/snapback-cli/runtime-readiness.mjs issue \
            --binary "$PROOF_ROOT/target/release/snapback" \
            --root "$PROOF_ROOT" --issuer telemetry-phase1-proof
        PROOF_TMP="$(mktemp -d "${TMPDIR:-/tmp}/snapback-telemetry-phase1.XXXXXX")"
        trap 'rm -rf "$PROOF_TMP"' EXIT
        "$PROOF_ROOT/target/release/snapback-telemetry-bench" > "$PROOF_TMP/benchmark.json"
        SNAPBACK_SERVER_BINARY="$PROOF_ROOT/target/release/snapback" \
            SNAPBACK_TELEMETRY_EXPECTED_COMMIT="$PROOF_REVISION" \
            node "$PROOF_ROOT/scripts/telemetry-phase1-idle-proof.mjs" > "$PROOF_TMP/idle.json"
        node "$PROOF_ROOT/scripts/telemetry-phase1-evidence.mjs" compose \
            --benchmark "$PROOF_TMP/benchmark.json" \
            --idle "$PROOF_TMP/idle.json" \
            --output "$PROOF_RECEIPT"
        ;;
    *)
        printf 'usage: scripts/verify-telemetry-phase1-proof [--check|--history|--require-current [<sha>]|--smoke|--full]\n' >&2
        exit 2
        ;;
esac
